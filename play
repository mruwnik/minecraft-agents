#!/bin/bash
# Start a Claude Code session as a Minecraft agent, creating the agent first if needed.
#   ./play --world <world>              a new agent with a drawn name, in that world (a folder under state/worlds/)
#   ./play --world <world> Aviendha     that agent of that world (created if it doesn't exist there yet)
#   ./play --world <world> Aviendha --model sonnet   extra arguments go to `claude`
set -euo pipefail
here="$(dirname "$(readlink -f "$0")")"
if [ "${1:-}" != "--world" ] || [ -z "${2:-}" ]; then
  echo "missing --world <world>: the world the body plays in (a folder under state/worlds/)" >&2
  echo "usage: ./play --world <world> [Name] [claude arguments...]" >&2
  exit 2
fi
world="$2"
shift 2
name="${1:-}"
[ $# -gt 0 ] && shift
if [ -z "$name" ] || [ ! -f "$here/state/worlds/$world/agents/$name/config.json" ]; then
  created="$(node "$here/tools/new-agent.mjs" $name --world "$world")"
  echo "$created"
  name="$(sed -n 's/^created state\/worlds\/[A-Za-z0-9_-]*\/agents\/\([A-Za-z0-9_]*\).*/\1/p' <<<"$created")"
  if grep -q "NOT WHITELISTED" <<<"$created"; then
    echo "Press Enter when the whitelist command has been run."
    read -r
  fi
fi
cd "$here/state/worlds/$world/agents/$name"
exec claude "$@" "You are $name. Read BRIEFING.md in this folder, then ../../../../../harness/claude-code.md, ../../../../../AGENT_GUIDE.md, ../../WORLD.md and journal.md, in that order. Start your body with ./start as a background command unless ./mc state already answers ok, wait for events by blocking on ./mc wait as the guide says (the Monitor tail from the harness notes is your fallback, since this is a session of its own), say hello in chat, and play. Keep going on your own; write your journal before you stop."
