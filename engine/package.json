{
  "name": "minecraft-agents-engine",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "npm run test:cljs && npm run test:js",
    "test:cljs": "shadow-cljs compile test && node --max-old-space-size=4096 out/test.cjs",
    "test:js": "node --test 'js/**/*.test.mjs' 'test/tools/**/*.test.mjs'",
    "record:planner-bench": "shadow-cljs compile planner-record && node out/planner-record.cjs",
    "build": "shadow-cljs compile body",
    "body": "shadow-cljs compile body && node --max-semi-space-size=4 out/body.cjs",
    "test:agent-tools": "npm --prefix ../dashboard run build-agent-tools && node --test 'test/tools/**/*.test.mjs'"
  },
  "devDependencies": {
    "shadow-cljs": "3.5.4",
    "source-map-support": "^0.5.21"
  }
}
