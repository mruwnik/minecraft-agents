{
  "name": "minecraft-agents-engine",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "npm run test:cljs && npm run test:js",
    "test:cljs": "shadow-cljs compile test && node out/test.cjs",
    "test:js": "node --test 'js/**/*.test.mjs' 'tools/**/*.test.mjs'",
    "build": "shadow-cljs compile body",
    "body": "shadow-cljs compile body && node out/body.cjs"
  },
  "devDependencies": {
    "shadow-cljs": "3.5.4",
    "source-map-support": "^0.5.21"
  }
}
