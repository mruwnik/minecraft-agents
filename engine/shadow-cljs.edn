;; shadow-cljs builds for the body engine. See README.md.
;; Both builds run from `compile` (never :advanced), so externs inference is off.
{:source-paths ["src" "test"]
 :dependencies []
 :builds
 {:body {:target :node-script
         :main engine.main/main
         :output-to "out/body.cjs"
         :output-dir "out/body"
         :build-hooks [(engine.build-hooks/add-job-namespaces)]
         :compiler-options {:infer-externs false}}
  :migrate {:target :node-script
            :main engine.migrate-cli/main
            :output-to "out/migrate.cjs"
            :output-dir "out/migrate"
            :compiler-options {:infer-externs false}}
  :test {:target :node-test
         :output-to "out/test.cjs"
         :output-dir "out/test"
         :ns-regexp "-test$"
         :autorun false
         :build-hooks [(engine.build-hooks/add-job-namespaces)]
         :compiler-options {:infer-externs false}}
  ;; The language benchmark (bench-lang/): the ClojureScript port of the path planner's search as a library the JS
  ;; harness loads. planner-bench is compiled like :body (`shadow-cljs compile planner-bench`); planner-bench-release is
  ;; the same code under :advanced (`shadow-cljs release planner-bench-release`).
  :planner-bench {:target :node-library
                  :exports {:planTuned engine.path.planner-tuned/plan
                            :createSearchTuned engine.path.planner-tuned/create-search
                            :MOVE engine.path.planner-tuned/MOVE
                            :DEFAULT_COSTS engine.path.planner-tuned/DEFAULT-COSTS}
                  :output-to "out/planner-bench.cjs"
                  :output-dir "out/planner-bench"
                  :compiler-options {:infer-externs false}}
  :planner-bench-release {:target :node-library
                          :exports {:planTuned engine.path.planner-tuned/plan
                                    :createSearchTuned engine.path.planner-tuned/create-search
                                    :MOVE engine.path.planner-tuned/MOVE
                                    :DEFAULT_COSTS engine.path.planner-tuned/DEFAULT-COSTS}
                          :output-to "out/planner-bench-release.cjs"
                          :output-dir "out/planner-bench-release"
                          :compiler-options {:infer-externs :auto}}}}
