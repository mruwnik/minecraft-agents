;; shadow-cljs builds for the body engine. See README.md.
;; Both builds run from `compile` (never :advanced), so externs inference is off.
;; Idle servers return heap and malloc memory (measured 1.75 GB -> ~0.6-0.8 GB); compile times unchanged. Not TieredStopAtLevel=1 (2.5x slower).
{:jvm-opts ["-Xmx1G" "-XX:G1PeriodicGCInterval=20000" "-XX:MinHeapFreeRatio=10" "-XX:MaxHeapFreeRatio=30" "-XX:TrimNativeHeapInterval=10000"]
 :source-paths ["src" "test" "test-support"]
 :dependencies []
 :builds
 {:body {:target :node-script
         :main engine.main/main
         :output-to "out/body.cjs"
         :output-dir "out/body"
         :build-hooks [(engine.build-hooks/add-job-namespaces)]
         :compiler-options {:infer-externs false}}
  :test {:target :node-test
         :output-to "out/test.cjs"
         :output-dir "out/test"
         :ns-regexp "-test$"
         :autorun false
         :build-hooks [(engine.build-hooks/add-job-namespaces)]
         :compiler-options {:infer-externs false}}
  ;; Opt-in: the planner's recorded pins (planner-*-golden namespaces), run when planner code changes: `tools/test-engine --golden`.
  :test-golden {:target :node-test
                :output-to "out/test-golden.cjs"
                :output-dir "out/test-golden"
                :ns-regexp "-golden$|^engine\\.timing-test$"
                :autorun false
                :build-hooks [(engine.build-hooks/add-job-namespaces)]
                :compiler-options {:infer-externs false}}
  ;; Re-records test/planner-bench.json (`npm run record:planner-bench`).
  :planner-record {:target :node-script
                   :main engine.planner-record/main
                   :output-to "out/planner-record.cjs"
                   :output-dir "out/planner-record"
                   :compiler-options {:infer-externs false}}
  ;; The planner bench harness (bench-lang/): the ClojureScript path planner as a library the JS harness loads. planner-bench is compiled like :body (`shadow-cljs compile planner-bench`); planner-bench-release is
  ;; the same code under :advanced (`shadow-cljs release planner-bench-release`).
  :planner-bench {:target :node-library
                  :exports {:planTuned engine.path.planner-tuned/plan
                            :createSearchTuned engine.path.planner-tuned/create-search
                            :MOVE engine.path.planner-tuned/MOVE
                            :DEFAULT_COSTS engine.path.planner-tuned/DEFAULT-COSTS}
                  :output-to "out/planner-bench.cjs"
                  :output-dir "out/planner-bench"
                  :compiler-options {:infer-externs false}}
  ;; The search bench (bench-lang/search.mjs): the job-side reach searches as a library over a recorded world.
  :search-bench {:target :node-library
                 :exports {:walkableWay engine.search-bench/walkable-way
                           :enclosed engine.search-bench/enclosed
                           :nearestDanger engine.search-bench/nearest-danger
                           :dangers engine.search-bench/dangers}
                 :output-to "out/search-bench.cjs"
                 :output-dir "out/search-bench"
                 :compiler-options {:infer-externs false}}
  ;; The go-to bench (bench-lang/goto.mjs): go-to's round planning over the planner bench's courses.
  :goto-bench {:target :node-library
               :exports {:simulate engine.goto-bench/simulate}
               :output-to "out/goto-bench.cjs"
               :output-dir "out/goto-bench"
               :compiler-options {:infer-externs false}}
  :planner-bench-release {:target :node-library
                          :exports {:planTuned engine.path.planner-tuned/plan
                                    :createSearchTuned engine.path.planner-tuned/create-search
                                    :MOVE engine.path.planner-tuned/MOVE
                                    :DEFAULT_COSTS engine.path.planner-tuned/DEFAULT-COSTS}
                          :output-to "out/planner-bench-release.cjs"
                          :output-dir "out/planner-bench-release"
                          :compiler-options {:infer-externs :auto}}}}
