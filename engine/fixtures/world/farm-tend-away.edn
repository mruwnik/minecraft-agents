;; Card 43f765ae: a standing (repeat) farm.tend with no other job listed never waits :away, far below its field or on it (tend does not walk to an unseen field; farm.maintain does).
;; Field on a stone platform x 6..20, z 12..22, y 0..11: farmland y 11, wheat y 12, water beside.
;; Should-succeed: body 12 below the field (no :away wait); body on the field (wheat cut). Should-fail: none.
{:defaults
 {:tags [:farm :tend :jobs]
  :time :any
  :plot {:height 18}
  :blocks [[:fill [6 0 12] [20 10 22] "stone"]
           [:fill [10 11 16] [13 11 16] "farmland[moisture=7]"] [:fill [10 11 17] [13 11 17] "water"]
           [:fill [6 11 12] [20 11 15] "stone"] [:fill [6 11 18] [20 11 22] "stone"]
           [:fill [6 11 16] [9 11 17] "stone"] [:fill [14 11 16] [20 11 17] "stone"]
           [:set [10 12 16] "wheat[age=7]"] [:set [13 12 16] "wheat[age=7]"]]
  :body {:effects [["resistance" 600 4]] :settle-s 2}
  :limit-s 100}
 :cases
 [{:name "body-far-below-the-field-does-not-wait-away"
   :body {:at [3.5 0 16.5]}
   :act [[:http :submit (repeat (jobs.farm.tend {:area {:min #xyz [10 11 16] :max #xyz [13 12 16]}})) [] {:ok true}]]
   :expect [{:event {:source :job :kind :waiting :data {:reason :resting}} :within-s 40}
            {:no-event {:source :job :kind :waiting :data {:reason :away}} :for-s 30}]
   :limit-s 60}
  {:name "body-on-the-field-cuts-the-wheat"
   :body {:at [11.5 12 15.5]}
   :act [[:http :submit (repeat (jobs.farm.tend {:area {:min #xyz [10 11 16] :max #xyz [13 12 16]}})) [] {:ok true}]]
   :expect [{:no-event {:source :job :kind :waiting :data {:reason :away}} :for-s 30}]
   :after [[:not-block [10 12 16] "wheat[age=7]"]]
   :limit-s 90}]}
