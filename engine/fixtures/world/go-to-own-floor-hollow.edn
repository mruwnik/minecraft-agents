;; Card 8cd37950 (S21): a body in an old stair hollow under its house floor; every way up cuts the floor of the plan that
;; holds the goal. Bedrock x 0..12, y 0..3, z 0..12 with stone x 3..7, z 3..7 under the hut; ground y 4 stone; hut oak
;; planks x 2..8, y 4..7, z 2..8 (floor y 4, inside x 3..7 y 5..6, roof y 7), door gap [8 5 5]/[8 6 5]; hollow [5 1..3 5].
{:defaults
 {:tags [:movement :go-to :places]
  :time :any
  :plot {:height 12 :light :lit}
  :blocks [[:fill [0 0 0] [12 3 12] "bedrock"] [:fill [3 0 3] [7 3 7] "stone"] [:fill [0 4 0] [12 4 12] "stone"]
           [:fill [2 4 2] [8 7 8] "oak_planks"] [:fill [3 5 3] [7 6 7] "air"] [:fill [8 5 5] [8 6 5] "air"]
           [:fill [5 1 5] [5 3 5] "air"]]
  :body {:at [5.5 1 5.5] :settle-s 2 :effects [["resistance" 600 4]] :inventory [["stone_pickaxe" 1]]}
  :act [[:job (jobs.movement.go-to {:worth 1200 :pos #at [5 5 5] :range 1})]]
  :limit-s 150}
 :cases
 [;; should-succeed: the floor of its own plan is cut, priced at the dig and the put-back
  {:name "cuts-up-through-its-own-floor"
   :plans [{:id "home" :metadata {:by "$body"} :parts [{:id "shell" :box [#at [2 4 2] #at [8 7 8]] :want "oak_planks"}]}]
   :expect [{:event {:source :job :kind :completed :context {:chain [[:any]]} :data {:arrived true}} :within-s 140 :of-job true}
            {:event {:source :job :kind :go-to.dug-own-build} :within-s 140 :of-job true}]
   :after [[:body-near [5.5 5 5.5] 2]]}
  ;; should-stop: the same house planned by another is refused, and the give-up names its plan
  {:name "another-s-floor-is-refused-by-name"
   :plans [{:id "home" :metadata {:by "SomeoneElse"} :parts [{:id "shell" :box [#at [2 4 2] #at [8 7 8]] :want "oak_planks"}]}]
   :expect [{:event {:source :job :kind :stopped :data {:arrived false :escalation {:why :zone :plans ["$plan:home"]}}} :within-s 140 :of-job true}]
   :after [[:block [5 4 5] "oak_planks"]]}]}
