;; jobs.survival.shut-in :for :night: a well (one cell, or two side by side) ringed four high under a roof is no shelter until the cell over the head is
;; filled (a spider climbs in, a skeleton shoots down); the walls way roofs it, and fills the second cell. Dark plot, so the clock does not matter.
{:defaults
 {:tags [:survival :cornered]
  :time :any
  :plot {:height 20}
  :register []
  :body {:at [16.5 0 16.5] :inventory [["cobblestone" 8]]}}
 :cases
 [{:name "open-topped-well-gets-its-roof"
   :blocks [[:fill [15 0 15] [17 3 17] "stone"] [:fill [16 0 16] [16 3 16] "air"] [:fill [8 6 8] [24 6 24] "stone"]]
   :act [[:job (jobs.survival.shut-in {:ways #{:walls} :for :night})]]
   :expect [{:event {:source :job :kind :completed} :within-s 60 :of-job true}]
   :after [[:block [16 2 16] "cobblestone"]]
   :limit-s 80}
  {:name "two-cell-well-is-cut-to-one-and-roofed"
   :blocks [[:fill [15 0 15] [18 3 17] "stone"] [:fill [16 0 16] [17 3 16] "air"] [:fill [8 6 8] [24 6 24] "stone"]]
   :act [[:job (jobs.survival.shut-in {:ways #{:walls} :for :night})]]
   :expect [{:event {:source :job :kind :completed} :within-s 60 :of-job true}]
   :after [[:block [16 2 16] "cobblestone"] [:block [17 0 16] "cobblestone"] [:block [17 1 16] "cobblestone"]]
   :limit-s 80}]}
