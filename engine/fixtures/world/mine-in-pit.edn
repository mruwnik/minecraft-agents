;; Card b7d6e88b: mine in a pit (stone cells beside the floor under solid ceilings) walks to each dug cell's drop and ends
;; honestly. Stone mass x 8..24, z 8..24, y -1..5; the body stands in a 1-wide shaft [16 0..5 16].
;; Should-succeed: 6 cobblestone mined from the shaft walls, the mine ends with got >= 6. Should-fail: asking 45 from ~5 seen stone with
;; no tunnel and no descent ends :stopped, never :completed.
{:defaults
 {:tags [:mine :jobs]
  :time :any
  :plot {:height 12}
  :blocks [[:fill [8 -1 8] [24 5 24] "stone"] [:fill [16 0 16] [16 5 16] "air"]]
  :body {:at [16.5 0 16.5] :inventory [["stone_pickaxe" 1]] :effects [["resistance" 600 4]]}
  :limit-s 120}
 :cases
 [{:name "pit-wall-stone-mined-and-collected"
   :act [[:job (jobs.gather.mine {:torches false :block "stone" :item "cobblestone" :count 6 :tunnel-length 4 :radius 6})]]
   :expect [{:event {:source :job :kind #{:completed :stopped} :data {:got [:>= 6]}} :within-s 110 :of-job true}]
   :after [[:item "cobblestone" [:>= 6]]]}
  {:name "forty-five-from-a-few-stones-stops-never-completes"
   :blocks [[:fill [8 -1 8] [24 -1 24] "dirt"] [:fill [8 0 8] [24 5 24] "air"] [:fill [14 0 14] [18 0 14] "stone"]]
   :act [[:job (jobs.gather.mine {:torches false :block "stone" :count 45 :tunnel-length 0 :descend-limit 0 :radius 6})]]
   :expect [{:event {:source :job :kind :stopped} :within-s 100 :of-job true}
            {:no-event {:source :job :kind :completed} :for-s 30 :until {:source :job :kind :stopped}}]
   :after [[:item "cobblestone" [:< 45]]]}
  ;; card 3177e78a (a): obtain stone_sword from a pit does not loop dig-under-feet / step-aside; it mines, crafts and ends
  {:name "obtain-stone-sword-from-a-pit-ends"
   :body {:inventory [["wooden_pickaxe" 1] ["stick" 2] ["crafting_table" 1]]}
   :act [[:job (jobs.items.obtain {:item "stone_sword" :count 1 :explore false})]]
   :expect [{:event {:source :job :kind :completed} :within-s 150 :of-job true}]
   :after [[:item "stone_sword" 1]]
   :limit-s 170}]}
