;; jobs.items.get-kit: cards f0118847 (items are made in order; iron is sourced only when the next missing item needs it),
;; 9d844aa3 (carried raw iron is smelted when the mine finds no ore), 71a675d6 (carried ingots are never crafted into nuggets),
;; 89e23248 (the home chest is not emptied, the hut's furnace and bed are not dug up), a094008f (the list in order, armour worn).
;; The body carries 3 cooked beef where mining or smelting is ahead (:food false: no food child runs).
;; Open plot, body at [16.5 0 12.5] looking south (yaw 0); the table stands at [16 0 18].
;; Should-succeed: stone sword and pickaxe made with no iron seen, then the job stops no-source for the iron; a pickaxe smelted from
;; carried raw iron; sword and shovel from 3 ingots without nuggets; the home chest and hut blocks untouched; helmet crafted and worn.
;; Should-fail: iron first in the list with no iron seen stops no-source at once and makes no stone tool.
{:defaults
 {:tags [:items :get-kit :jobs]
  :plot {:height 12 :floor "grass_block"}
  :blocks [[:set [16 0 18] "crafting_table"]]
  :body {:at [16.5 0 12.5] :settle-s 2 :effects [["resistance" 600 4]]}
  :limit-s 150}
 :cases
 [{:name "stone-tools-first-then-no-source-for-iron"
   :blocks [[:fill [8 4 21] [10 5 23] "oak_leaves[persistent=true]"] [:fill [9 0 22] [9 4 22] "oak_log"]
            [:fill [10 4 21] [12 5 23] "oak_leaves[persistent=true]"] [:fill [11 0 22] [11 4 22] "oak_log"]
            [:fill [20 0 22] [22 1 23] "stone"]]
   :body {:inventory [["cooked_beef" 3]]}
   :act [[:rcon "execute as $BODY at @s run tp @s ~ ~ ~ 0 10"] [:until-facing {:yaw 0 :pitch 10} 10]
         [:job (jobs.items.get-kit {:items ["stone_sword" "stone_pickaxe" "iron_pickaxe"] :explore false :food false})]]
   :expect [{:event {:source :job :kind :stopped :data {:reason :no-source}} :within-s 290 :of-job true}]
   :after [[:item "stone_sword" 1] [:item "stone_pickaxe" 1] [:item "iron_pickaxe" 0]]
   :limit-s 300}
  {:name "iron-first-with-no-iron-seen-stops-at-once"
   :blocks [[:fill [8 4 21] [10 5 23] "oak_leaves[persistent=true]"] [:fill [9 0 22] [9 4 22] "oak_log"]
            [:fill [20 0 22] [22 1 23] "stone"]]
   :body {:inventory [["cooked_beef" 3] ["wooden_sword" 1]]}
   :act [[:rcon "execute as $BODY at @s run tp @s ~ ~ ~ 0 10"] [:until-facing {:yaw 0 :pitch 10} 10]
         [:job (jobs.items.get-kit {:items ["iron_pickaxe" "stone_sword"] :explore false :food false})]]
   :expect [{:event {:source :job :kind :stopped :data {:reason :no-source}} :within-s 60 :of-job true}
            {:no-event {:source :job :kind :completed} :for-s 20 :of-job true :until {:source :job :kind :stopped}}]
   :after [[:item "stone_sword" 0] [:item "iron_pickaxe" 0]]
   :limit-s 80}
  {:name "carried-raw-iron-smelted-when-no-ore-is-seen"
   :blocks [[:set [20 0 14] "furnace[facing=west]"]]
   :body {:inventory [["raw_iron" 3] ["coal" 3] ["stick" 2] ["stone_pickaxe" 1] ["stone_sword" 1] ["cooked_beef" 3]]}
   :act [[:job (jobs.items.get-kit {:items ["iron_pickaxe"] :explore false :food false})]]
   :expect [{:event {:source :job :kind :completed} :within-s 140 :of-job true}]
   :after [[:item "iron_pickaxe" 1] [:item "iron_nugget" 0]]}
  {:name "carried-ingots-make-sword-and-shovel-never-nuggets"
   :body {:inventory [["iron_ingot" 3] ["stick" 6] ["stone_pickaxe" 1] ["cooked_beef" 3]]}
   :act [[:job (jobs.items.get-kit {:items ["iron_sword" "iron_shovel" "iron_axe"] :explore false :food false})]]
   :expect [{:event {:source :job :kind :stopped :data {:reason :no-source}} :within-s 100 :of-job true}]
   :after [[:item "iron_sword" 1] [:item "iron_shovel" 1] [:item "iron_nugget" 0]]
   :limit-s 120}
  {:name "home-chest-and-hut-blocks-stay"
   :blocks [[:set [20 0 14] "chest[facing=west]{Items:[{Slot:0b,id:\"minecraft:wheat_seeds\",count:64},{Slot:1b,id:\"minecraft:poppy\",count:30},{Slot:2b,id:\"minecraft:dirt\",count:64}]}"]
            [:set [20 0 20] "furnace[facing=west]"] [:set [12 0 20] "red_bed[facing=east,part=foot]"] [:set [13 0 20] "red_bed[facing=east,part=head]"]]
   :memory [{:kind :chest :data {:pos #xyz [20 0 14]} :policy {:cap 1 :ttl :forever}}]
   :body {:inventory [["oak_planks" 6] ["cobblestone" 3]]}
   :act [[:job (jobs.items.get-kit {:items ["stone_pickaxe"] :explore false :food false})]]
   :expect [{:event {:source :job :kind :completed} :within-s 100 :of-job true}]
   :after [[:item "stone_pickaxe" 1] [:item "wheat_seeds" 0] [:item "poppy" 0] [:item "dirt" 0]
           [:block [20 0 14] "chest"] [:block [20 0 20] "furnace"] [:block [12 0 20] "red_bed"] [:block [13 0 20] "red_bed"]]
   :limit-s 120}
  {:name "armour-crafted-in-order-and-worn"
   :body {:inventory [["iron_ingot" 5]]}
   :act [[:job (jobs.items.get-kit {:items ["iron_helmet"] :wear true :explore false :food false})]]
   :expect [{:event {:source :job :kind :child_ended :data {:slot :wear :ending {:kind :done :data {:worn [:any]}}}} :within-s 100 :of-job true}
            {:event {:source :job :kind :completed} :within-s 100 :of-job true}]
   :after [[:item "iron_helmet" 0]]
   :limit-s 120}
  ;; card a1a67cc5 (fix 75f53a09 of 9d844aa3): raw iron smelting on thin fuel (planks only): the kit waits out the cook and finishes, never "stopped: cooking"
  {:name "raw-iron-on-plank-fuel-waits-for-the-cook"
   :blocks [[:set [20 0 14] "furnace[facing=west]"]]
   :body {:inventory [["raw_iron" 3] ["oak_planks" 3] ["stick" 2] ["stone_pickaxe" 1] ["stone_sword" 1] ["cooked_beef" 3]]}
   :act [[:job (jobs.items.get-kit {:items ["iron_pickaxe"] :explore false :food false})]]
   :expect [{:event {:source :job :kind :completed} :within-s 200 :of-job true}
            {:no-event {:source :job :kind :stopped} :for-s 200 :of-job true :until {:source :job :kind :completed}}]
   :after [[:item "iron_pickaxe" 1]]
   :limit-s 220}
  ;; card 175bf093: iron ore seen about 20 blocks off, no raw iron carried: the kit goes to the ore and mines it, not "stopped no-source". Three ore blocks (a pickaxe takes 3 ingots) and a carried table, so nothing else is short once they are mined
  {:name "seen-iron-ore-is-mined-not-no-source"
   :plot {:height 12 :floor "grass_block" :length 64 :width 32}
   :blocks [[:fill [36 -1 14] [40 3 18] "stone"] [:set [36 0 16] "iron_ore"] [:set [36 1 16] "iron_ore"] [:set [36 2 16] "iron_ore"]]
   :body {:at [16.5 0 16.5] :inventory [["stone_pickaxe" 1] ["stone_sword" 1] ["stick" 2] ["cooked_beef" 3] ["cobblestone" 8] ["coal" 4] ["crafting_table" 1]]}
   :act [[:job (jobs.items.get-kit {:items ["iron_pickaxe"] :explore false :food false})]]
   :expect [{:no-event {:source :job :kind :stopped :data {:reason :no-source}} :for-s 150 :of-job true}]
   :after [[:not-block [36 0 16] "iron_ore"]]
   :limit-s 160}
  ;; card 148a1078: the gather mine for an unseen ore cannot stock torches itself; obtain makes them from the carried coal first
  {:name "torches-are-made-before-the-mine-goes-down-for-unseen-iron"
   :time :any
   :plot {:height 12 :floor "grass_block" :length 64 :width 32}
   :blocks [[:fill [20 -1 14] [30 3 24] "stone"]]
   :body {:at [16.5 0 16.5] :inventory [["stone_pickaxe" 1] ["stone_sword" 1] ["stick" 2] ["cooked_beef" 3] ["coal" 2] ["crafting_table" 1]]}
   :act [[:job (jobs.items.get-kit {:items ["iron_pickaxe"] :explore true :food false})]]
   :expect [{:event {:source :job :kind :torch.stocked} :within-s 90 :of-job true}
            {:no-event {:source :job :kind :stopped :data {:reason :no-torches}} :for-s 60 :of-job true}]
   :limit-s 100}
  ;; card d3311e20: no iron in sight, a stone pickaxe and torches carried, under rock: the kit stairs down and tunnels for the ore, never "gathering ended :none-seen"
  {:name "unseen-iron-underground-is-dug-for-not-none-seen"
   :time :any
   :plot {:height 12 :floor "grass_block"}
   :blocks [[:fill [4 -16 12] [31 3 20] "stone"] [:fill [16 0 16] [16 1 16] "air"]
            [:set [8 0 16] "iron_ore"] [:set [8 1 16] "iron_ore"] [:set [9 0 16] "iron_ore"] [:set [9 1 16] "iron_ore"] [:set [24 0 16] "iron_ore"] [:set [24 1 16] "iron_ore"] [:set [25 0 16] "iron_ore"] [:set [25 1 16] "iron_ore"]]
   :body {:at [16.5 0 16.5] :yaw 270 :inventory [["stone_pickaxe" 1] ["stone_sword" 1] ["stick" 2] ["cooked_beef" 3] ["torch" 16] ["cobblestone" 8] ["coal" 4] ["crafting_table" 1]] :effects [["resistance" 900 4]]}
   :act [[:job (jobs.items.get-kit {:items ["iron_pickaxe"] :explore true :food false})]]
   :expect [{:event {:source :job :kind :completed} :within-s 380 :of-job true}]
   :after [[:item "iron_pickaxe" 1]]
   :limit-s 400}
  ;; card fc0d4f6f: get-kit writes the kit reserve entries and the mine under it keeps them on its trip deposit (the raw iron stays in the bag, the junk goes in the chest)
  {:name "kit-trip-deposit-keeps-the-raw-iron"
   :plot {:height 12 :floor "grass_block" :length 64 :width 32}
   :blocks [[:set [20 0 12] "chest[facing=west]"] [:fill [36 -1 14] [40 3 18] "stone"] [:set [36 0 16] "iron_ore"] [:set [36 1 16] "iron_ore"]]
   :memory [{:kind :chest :data {:pos #xyz [20 0 12]} :policy {:cap 1 :ttl :forever}}]
   :body {:at [16.5 0 16.5] :inventory [["stone_pickaxe" 1] ["stone_sword" 1] ["stick" 2] ["cooked_beef" 3] ["cobblestone" 8] ["coal" 4] ["crafting_table" 1] ["raw_iron" 1] ["dirt" 1] ["sand" 1] ["gravel" 1] ["tuff" 1] ["andesite" 1] ["diorite" 1] ["granite" 1] ["netherrack" 1] ["deepslate" 1] ["calcite" 1] ["coarse_dirt" 1] ["red_sand" 1] ["clay_ball" 1] ["flint" 1] ["feather" 1] ["bone" 1] ["string" 1] ["gunpowder" 1] ["spider_eye" 1] ["leather" 1] ["paper" 1] ["sugar" 1] ["slime_ball" 1] ["ink_sac" 1]]}
   :act [[:job (jobs.items.get-kit {:items ["iron_pickaxe"] :explore false :food false})]]
   :expect [{:event {:source :job :kind :trip.deposited :data {:result {:moved [:any]}}} :within-s 120}
            {:event {:source :job :kind :completed} :within-s 200 :of-job true}]
   :after [[:item "iron_pickaxe" 1] [:not-block [20 0 12] "chest{Items:[{id:\"minecraft:raw_iron\"}]}"]]
   :limit-s 220}]}
