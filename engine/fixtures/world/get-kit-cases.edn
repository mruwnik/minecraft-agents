;; jobs.items.get-kit: cards f0118847 (items are made in order; iron is sourced only when the next missing item needs it),
;; 9d844aa3 (carried raw iron is smelted when the mine finds no ore), 71a675d6 (carried ingots are never crafted into nuggets),
;; 89e23248 (the home chest is not emptied, the hut's furnace and bed are not dug up), a094008f (the list in order, armour worn).
;; The body carries 3 cooked beef where mining or smelting is ahead (:food false: no food child runs).
;; Open plot, body at [16.5 0 12.5] looking south (yaw 0); the table stands at [16 0 18].
;; Should-succeed: stone sword and pickaxe made with no iron seen, then the job stops no-source for the iron; a pickaxe smelted from
;; carried raw iron; sword and shovel from 3 ingots without nuggets; the home chest and hut blocks untouched; helmet crafted and worn.
;; A stone pickaxe is crafted from carried logs and cobblestone (planks, sticks, then the pickaxe).
;; A pickaxe with 1 use left does not count as had: a fresh one is crafted beside it.
;; Iron first with no iron seen: :partial-first false stops no-source at once and makes no stone tool; the default makes the stone sword, then stops.
{:defaults
 {:tags [:items :get-kit :jobs]
  :plot {:height 12 :floor "grass_block"}
  :blocks [[:set [16 0 18] "crafting_table"]]
  :body {:at [16.5 0 12.5] :settle-s 2 :effects [["resistance" 600 4]]}
  :limit-s 150}
 :cases
 [{:name "stone-tools-first-then-no-source-for-iron"
   :blocks [[:fill [8 4 21] [10 5 23] "oak_leaves[persistent=true]"] [:fill [9 0 22] [9 4 22] "oak_log"]
            [:fill [10 4 21] [12 5 23] "oak_leaves[persistent=true]"] [:fill [11 0 22] [11 4 22] "oak_log"]
            [:fill [20 0 22] [22 1 23] "stone"]]
   :body {:inventory [["cooked_beef" 3]]}
   :act [[:rcon "execute as $BODY at @s run tp @s ~ ~ ~ 0 10"] [:until-facing {:yaw 0 :pitch 10} 10]
         [:job (jobs.items.get-kit {:items ["stone_sword" "stone_pickaxe" "iron_pickaxe"] :explore false :food false})]]
   :expect [{:event {:source :job :kind :stopped :data {:reason :no-source}} :within-s 290 :of-job true}]
   :after [[:item "stone_sword" 1] [:item "stone_pickaxe" 1] [:item "iron_pickaxe" 0]]
   :limit-s 300}
  {:name "iron-first-with-no-iron-seen-stops-at-once"
   :blocks [[:fill [8 4 21] [10 5 23] "oak_leaves[persistent=true]"] [:fill [9 0 22] [9 4 22] "oak_log"]
            [:fill [20 0 22] [22 1 23] "stone"]]
   :body {:inventory [["cooked_beef" 3] ["wooden_sword" 1]]}
   :act [[:rcon "execute as $BODY at @s run tp @s ~ ~ ~ 0 10"] [:until-facing {:yaw 0 :pitch 10} 10]
         [:job (jobs.items.get-kit {:items ["iron_pickaxe" "stone_sword"] :partial-first false :explore false :food false})]]
   :expect [{:event {:source :job :kind :stopped :data {:reason :no-source}} :within-s 60 :of-job true}
            {:no-event {:source :job :kind :completed} :for-s 20 :of-job true :until {:source :job :kind :stopped}}]
   :after [[:item "stone_sword" 0] [:item "iron_pickaxe" 0]]
   :limit-s 80}
  ;; card 9a979620: the no-source stop names its next calls: the mine for the unseen raw iron, then the kit again
  {:name "no-source-names-the-mine-then-the-kit-again"
   :time :any
   :body {:inventory [["cooked_beef" 3] ["wooden_sword" 1]]}
   :act [[:job (jobs.items.get-kit {:items ["iron_pickaxe"] :explore false :food false})]]
   :expect [{:event {:source :job :kind :stopped
                     :data {:reason :no-source
                            :next [:has {:job "jobs.gather.mine" :args {:item "raw_iron"}}]}} :within-s 60 :of-job true}
            {:event {:source :job :kind :stopped :data {:next [:has {:job "jobs.items.get-kit" :again true}]}} :within-s 60 :of-job true}]
   :after [[:item "iron_pickaxe" 0]]
   :limit-s 80}
  {:name "partial-first-makes-the-stone-sword-then-stops-at-the-iron"
   :blocks [[:fill [8 4 21] [10 5 23] "oak_leaves[persistent=true]"] [:fill [9 0 22] [9 4 22] "oak_log"]
            [:fill [20 0 22] [22 1 23] "stone"]]
   :body {:inventory [["cooked_beef" 3] ["wooden_sword" 1]]}
   :act [[:rcon "execute as $BODY at @s run tp @s ~ ~ ~ 0 10"] [:until-facing {:yaw 0 :pitch 10} 10]
         [:job (jobs.items.get-kit {:items ["iron_pickaxe" "stone_sword"] :explore false :food false})]]
   :expect [{:event {:source :job :kind :stopped :data {:reason :no-source}} :within-s 200 :of-job true}]
   :after [[:item "stone_sword" 1] [:item "iron_pickaxe" 0]]
   :limit-s 220}
  {:name "carried-raw-iron-smelted-when-no-ore-is-seen"
   :blocks [[:set [20 0 14] "furnace[facing=west]"]]
   :body {:inventory [["raw_iron" 3] ["coal" 3] ["stick" 2] ["stone_pickaxe" 1] ["stone_sword" 1] ["cooked_beef" 3]]}
   :act [[:job (jobs.items.get-kit {:items ["iron_pickaxe"] :explore false :food false})]]
   :expect [{:event {:source :job :kind :completed} :within-s 140 :of-job true}]
   :after [[:item "iron_pickaxe" 1] [:item "iron_nugget" 0]]}
  {:name "carried-ingots-make-sword-and-shovel-never-nuggets"
   :body {:inventory [["iron_ingot" 3] ["stick" 6] ["stone_pickaxe" 1] ["cooked_beef" 3]]}
   :act [[:job (jobs.items.get-kit {:items ["iron_sword" "iron_shovel" "iron_axe"] :explore false :food false})]]
   :expect [{:event {:source :job :kind :stopped :data {:reason :no-source}} :within-s 100 :of-job true}]
   :after [[:item "iron_sword" 1] [:item "iron_shovel" 1] [:item "iron_nugget" 0]]
   :limit-s 120}
  {:name "worn-out-pickaxe-does-not-count-and-a-fresh-one-is-made"
   :body {:inventory [["iron_pickaxe[damage=249]" 1] ["iron_ingot" 3] ["stick" 2] ["cooked_beef" 3]]}
   :act [[:job (jobs.items.get-kit {:items ["iron_pickaxe"] :explore false :food false})]]
   :expect [{:event {:source :job :kind :completed} :within-s 100 :of-job true}]
   :after [[:item "iron_pickaxe" 2] [:item "iron_ingot" 0]]
   :limit-s 120}
  ;; a spent pickaxe in a kit with armour: the fresh one is made and the rest of the kit goes on (leggings, boots made and worn)
  {:name "worn-out-pickaxe-in-a-kit-with-armour-still-finishes-the-armour"
   :body {:inventory [["iron_pickaxe[damage=249]" 1] ["iron_ingot" 14] ["stick" 2] ["cooked_beef" 3]]}
   :act [[:job (jobs.items.get-kit {:items ["iron_pickaxe" "iron_leggings" "iron_boots"] :wear true :explore false :food false})]]
   :expect [{:event {:source :job :kind :completed} :within-s 150 :of-job true}]
   :after [[:item "iron_pickaxe" 2] [:item "iron_ingot" 0]]
   :limit-s 170}
  {:name "stone-pickaxe-from-carried-logs-chains-planks-and-sticks"
   :body {:inventory [["oak_log" 6] ["cobblestone" 5] ["cooked_beef" 3]]}
   :act [[:job (jobs.items.get-kit {:items ["stone_pickaxe"] :explore false :food false})]]
   :expect [{:event {:source :job :kind :completed} :within-s 100 :of-job true}]
   :after [[:item "stone_pickaxe" 1]]
   :limit-s 120}
  {:name "home-chest-and-hut-blocks-stay"
   :blocks [[:set [20 0 14] "chest[facing=west]{Items:[{Slot:0b,id:\"minecraft:wheat_seeds\",count:64},{Slot:1b,id:\"minecraft:poppy\",count:30},{Slot:2b,id:\"minecraft:dirt\",count:64}]}"]
            [:set [20 0 20] "furnace[facing=west]"] [:set [12 0 20] "red_bed[facing=east,part=foot]"] [:set [13 0 20] "red_bed[facing=east,part=head]"]]
   :memory [{:kind :chest :data {:pos #xyz [20 0 14]} :policy {:cap 1 :ttl :forever}}]
   :body {:inventory [["oak_planks" 6] ["cobblestone" 3]]}
   :act [[:job (jobs.items.get-kit {:items ["stone_pickaxe"] :explore false :food false})]]
   :expect [{:event {:source :job :kind :completed} :within-s 100 :of-job true}]
   :after [[:item "stone_pickaxe" 1] [:item "wheat_seeds" 0] [:item "poppy" 0] [:item "dirt" 0]
           [:block [20 0 14] "chest"] [:block [20 0 20] "furnace"] [:block [12 0 20] "red_bed"] [:block [13 0 20] "red_bed"]]
   :limit-s 120}
  {:name "armour-crafted-in-order-and-worn"
   :body {:inventory [["iron_ingot" 5]]}
   :act [[:job (jobs.items.get-kit {:items ["iron_helmet"] :wear true :explore false :food false})]]
   :expect [{:event {:source :job :kind :child_ended :data {:slot :wear :ending {:kind :done :data {:worn [:any]}}}} :within-s 100 :of-job true}
            {:event {:source :job :kind :completed} :within-s 100 :of-job true}]
   :after [[:item "iron_helmet" 0]]
   :limit-s 120}
  ;; card 0bd50e60: 10 ingots cover helmet (5) and boots (4) but not the chestplate (8): both are made and worn before the kit stops for the missing iron
  {:name "carried-ingots-make-and-wear-covered-pieces-before-fetching-more"
   :body {:inventory [["iron_ingot" 10] ["cooked_beef" 3]]}
   :act [[:job (jobs.items.get-kit {:items ["iron_helmet" "iron_chestplate" "iron_boots"] :wear true :explore false :food false})]]
   :expect [{:event {:source :job :kind :child_ended :data {:slot :wear :ending {:kind :done :data {:worn [:any]}}}} :within-s 100 :of-job true}
            {:event {:source :job :kind :stopped :data {:reason :no-source :item "iron_chestplate"}} :within-s 160 :of-job true}]
   :after [[:item "iron_helmet" 0] [:item "iron_boots" 0] [:item "iron_chestplate" 0] [:item "iron_ingot" 1]]
   :limit-s 180}
  ;; card 876e53b2: 5 raw iron cover the helmet (the chestplate needs 8): the kit smelts and wears it before it stops for the missing iron
  {:name "carried-raw-iron-makes-and-wears-the-covered-piece-before-the-stop"
   :blocks [[:set [20 0 14] "furnace[facing=west]"]]
   :body {:inventory [["raw_iron" 5] ["coal" 3] ["cooked_beef" 3]]}
   :act [[:job (jobs.items.get-kit {:items ["iron_helmet" "iron_chestplate"] :wear true :explore false :food false})]]
   :expect [{:event {:source :job :kind :stopped :data {:reason :no-source :item "iron_ingot"}} :within-s 220 :of-job true}]
   :after [[:item "iron_helmet" 0] [:item "iron_chestplate" 0]]
   :limit-s 240}
  ;; card a1a67cc5 (fix 75f53a09 of 9d844aa3): raw iron smelting on thin fuel (planks only): the kit waits out the cook and finishes, never "stopped: cooking"
  {:name "raw-iron-on-plank-fuel-waits-for-the-cook"
   :blocks [[:set [20 0 14] "furnace[facing=west]"]]
   :body {:inventory [["raw_iron" 3] ["oak_planks" 3] ["stick" 2] ["stone_pickaxe" 1] ["stone_sword" 1] ["cooked_beef" 3]]}
   :act [[:job (jobs.items.get-kit {:items ["iron_pickaxe"] :explore false :food false})]]
   :expect [{:event {:source :job :kind :completed} :within-s 200 :of-job true}
            {:no-event {:source :job :kind :stopped} :for-s 200 :of-job true :until {:source :job :kind :completed}}]
   :after [[:item "iron_pickaxe" 1]]
   :limit-s 220}
  ;; card 175bf093: iron ore seen about 20 blocks off, no raw iron carried: the kit goes to the ore and mines it, not "stopped no-source". Three ore blocks (a pickaxe takes 3 ingots) and a carried table, so nothing else is short once they are mined
  {:name "seen-iron-ore-is-mined-not-no-source"
   :plot {:height 12 :floor "grass_block" :length 64 :width 32}
   :blocks [[:fill [36 -1 14] [40 3 18] "stone"] [:set [36 0 16] "iron_ore"] [:set [36 1 16] "iron_ore"] [:set [36 2 16] "iron_ore"]]
   :body {:at [16.5 0 16.5] :inventory [["stone_pickaxe" 1] ["stone_sword" 1] ["stick" 2] ["cooked_beef" 3] ["cobblestone" 8] ["coal" 4] ["crafting_table" 1]]}
   :act [[:job (jobs.items.get-kit {:items ["iron_pickaxe"] :explore false :food false})]]
   :expect [{:no-event {:source :job :kind :stopped :data {:reason :no-source}} :for-s 150 :of-job true}]
   :after [[:not-block [36 0 16] "iron_ore"]]
   :limit-s 160}
  ;; card 148a1078: the gather mine for an unseen ore cannot stock torches itself; obtain makes them from the carried coal first
  {:name "torches-are-made-before-the-mine-goes-down-for-unseen-iron"
   :time :any
   :plot {:height 12 :floor "grass_block" :length 64 :width 32}
   :blocks [[:fill [20 -1 14] [30 3 24] "stone"]]
   :body {:at [16.5 0 16.5] :inventory [["stone_pickaxe" 1] ["stone_sword" 1] ["stick" 2] ["cooked_beef" 3] ["coal" 2] ["crafting_table" 1]]}
   :act [[:job (jobs.items.get-kit {:items ["iron_pickaxe"] :explore true :food false})]]
   :expect [{:event {:source :job :kind :torch.stocked} :within-s 90 :of-job true}
            {:no-event {:source :job :kind :stopped :data {:reason :no-torches}} :for-s 60 :of-job true}]
   :limit-s 100}
  ;; card d3311e20: no iron in sight, a stone pickaxe and torches carried, under rock: the kit stairs down and tunnels for the ore, never "gathering ended :none-seen"
  {:name "unseen-iron-underground-is-dug-for-not-none-seen"
   :time :any
   :plot {:height 12 :floor "grass_block"}
   :blocks [[:fill [4 -16 12] [31 3 20] "stone"] [:fill [16 0 16] [16 1 16] "air"]
            [:set [8 0 16] "iron_ore"] [:set [8 1 16] "iron_ore"] [:set [9 0 16] "iron_ore"] [:set [9 1 16] "iron_ore"] [:set [24 0 16] "iron_ore"] [:set [24 1 16] "iron_ore"] [:set [25 0 16] "iron_ore"] [:set [25 1 16] "iron_ore"]]
   :body {:at [16.5 0 16.5] :yaw 270 :inventory [["stone_pickaxe" 1] ["stone_sword" 1] ["stick" 2] ["cooked_beef" 3] ["torch" 16] ["cobblestone" 8] ["coal" 4] ["crafting_table" 1]] :effects [["resistance" 900 4]]}
   :act [[:job (jobs.items.get-kit {:items ["iron_pickaxe"] :explore true :food false})]]
   :expect [{:event {:source :job :kind :completed} :within-s 380 :of-job true}]
   :after [[:item "iron_pickaxe" 1]]
   :limit-s 400}
  ;; card 876e53b2: a mine that finds no iron ends its try; the kit runs the bill again (kit.retry) instead of stopping at the first end
  {:name "a-mine-that-ends-without-iron-is-tried-again"
   :time :any
   :plot {:height 12 :floor "grass_block"}
   :blocks [[:fill [4 -8 12] [31 3 20] "stone"] [:fill [16 0 16] [16 1 16] "air"]]
   :body {:at [16.5 0 16.5] :yaw 270 :inventory [["stone_pickaxe" 1] ["stone_sword" 1] ["stick" 2] ["cooked_beef" 3] ["torch" 16] ["cobblestone" 8] ["coal" 4] ["crafting_table" 1]] :effects [["resistance" 900 4]]}
   :act [[:job (jobs.items.get-kit {:items ["iron_pickaxe"] :explore true :food false})]]
   :expect [{:event {:source :job :kind :kit.retry} :within-s 500 :of-job true}]
   :limit-s 520}
  ;; card 1b97f7b8: shut in a closed lit stone pocket with raw iron, coal, cobblestone and planks but no furnace or table (8 planks: table 4 + sticks 2): the kit places its own and smelts and crafts, never "no source ... have 0"
  {:name "raw-iron-in-a-closed-pocket-is-smelted-with-its-own-furnace"
   :time :any
   :plot {:height 12 :floor "grass_block"}
   :blocks [[:fill [12 -16 12] [20 3 20] "stone"] [:fill [15 0 15] [17 2 17] "air"] [:set [16 3 16] "glowstone"]]
   :body {:at [16.5 0 16.5] :inventory [["raw_iron" 11] ["coal" 4] ["cobblestone" 16] ["oak_planks" 8] ["stone_pickaxe" 1] ["cooked_beef" 3]] :effects [["resistance" 900 4]]}
   :act [[:job (jobs.items.get-kit {:items ["iron_pickaxe"] :explore false :food false})]]
   :expect [{:event {:source :job :kind :completed} :within-s 200 :of-job true}
            {:no-event {:source :job :kind :stopped :data {:reason :no-source}} :for-s 150 :of-job true :until {:source :job :kind :completed}}]
   :after [[:item "iron_pickaxe" 1]]
   :limit-s 230}
  ;; card 1b97f7b8: shut in a lit bedrock pocket (no way out) with three iron ore in the wall and no raw iron carried: the gathering ends after mining them, and the kit smelts and crafts the pickaxe the 3 ingots cover before it stops for the helmet's iron
  {:name "iron-mined-in-a-sealed-pocket-is-smelted-before-the-kit-stops"
   :time :any
   :plot {:height 12 :floor "grass_block"}
   :blocks [[:fill [12 -16 12] [20 4 20] "bedrock"] [:fill [14 0 14] [18 2 18] "air"] [:set [16 3 16] "glowstone"]
            [:set [13 0 16] "iron_ore"] [:set [13 1 16] "iron_ore"] [:set [13 0 17] "iron_ore"]]
   :body {:at [16.5 0 16.5] :yaw 90 :inventory [["coal" 4] ["cobblestone" 16] ["oak_planks" 8] ["stone_pickaxe" 1] ["stone_sword" 1] ["stick" 2] ["cooked_beef" 3]] :effects [["resistance" 900 4]]}
   :act [[:job (jobs.items.get-kit {:items ["iron_pickaxe" "iron_helmet"] :explore false :food false})]]
   :expect [{:event {:source :job :kind :stopped :data {:reason :no-source}} :within-s 330 :of-job true}]
   :after [[:item "iron_pickaxe" 1]]
   :limit-s 350}
  ;; card ac825512: the nearer ore stands against water seen through glass; the kit takes the dry ore farther along the wall and finishes, never "stopped: flooded"
  {:name "flooded-ore-is-left-for-the-dry-ore"
   :time :any
   :plot {:height 12 :floor "grass_block"}
   :blocks [[:fill [4 -16 12] [31 3 20] "stone"] [:fill [12 0 12] [20 2 18] "air"]
            [:fill [11 0 17] [11 1 17] "water"] [:fill [12 0 17] [12 1 17] "glass"] [:set [11 0 16] "iron_ore"] [:set [11 1 16] "iron_ore"] [:set [11 0 13] "iron_ore"]
            [:set [14 3 14] "glowstone"] [:set [18 3 14] "glowstone"] [:set [14 3 18] "glowstone"] [:set [18 3 18] "glowstone"]]
   :body {:at [14.5 0 16.5] :yaw 270 :inventory [["stone_pickaxe" 1] ["stone_sword" 1] ["stick" 2] ["cooked_beef" 3] ["torch" 16] ["cobblestone" 8] ["coal" 4] ["crafting_table" 1] ["furnace" 1]] :effects [["resistance" 900 4]]}
   :act [[:job (jobs.items.get-kit {:items ["iron_shovel"] :explore false :food false})]]
   :expect [{:event {:source :job :kind :completed} :within-s 240 :of-job true}
            {:no-event {:source :job :kind :stopped :data {:reason :no-source}} :for-s 200 :of-job true :until {:source :job :kind :completed}}]
   :after [[:item "iron_shovel" 1] [:not-block [11 0 13] "iron_ore"]]
   :limit-s 260}
  ;; card ac825512: a pool sunk in the floor lies between the body and the nearer ore; the dig must not swim the head under and the kit takes the dry ore farther along the wall
  {:name "ore-beside-a-floor-pool-is-left-for-the-dry-ore"
   :time :any
   :plot {:height 12 :floor "grass_block"}
   :blocks [[:fill [4 -16 12] [31 3 20] "stone"] [:fill [12 0 12] [28 2 18] "air"]
            [:fill [12 -2 12] [15 -1 18] "water"] [:set [11 0 16] "iron_ore"] [:set [11 1 16] "iron_ore"] [:set [29 0 16] "iron_ore"]
            [:set [14 3 14] "glowstone"] [:set [18 3 14] "glowstone"] [:set [14 3 18] "glowstone"] [:set [22 3 14] "glowstone"] [:set [26 3 18] "glowstone"] [:set [22 3 18] "glowstone"] [:set [26 3 14] "glowstone"] [:set [18 3 18] "glowstone"]]
   :body {:at [18.5 0 16.5] :yaw 270 :inventory [["stone_pickaxe" 1] ["stone_sword" 1] ["stick" 2] ["cooked_beef" 3] ["torch" 16] ["cobblestone" 8] ["coal" 4] ["crafting_table" 1] ["furnace" 1]] :effects [["resistance" 900 4]]}
   :act [[:job (jobs.items.get-kit {:items ["iron_shovel"] :explore false :food false})]]
   :expect [{:event {:source :job :kind :completed} :within-s 240 :of-job true}
            {:no-event {:source :job :kind :stopped :data {:reason :no-source}} :for-s 200 :of-job true :until {:source :job :kind :completed}}]
   :after [[:item "iron_shovel" 1]]
   :limit-s 260}
  ;; card fc0d4f6f: get-kit writes the kit reserve entries and the mine under it keeps them on its trip deposit (the raw iron stays in the bag, the junk goes in the chest)
  {:name "kit-trip-deposit-keeps-the-raw-iron"
   :plot {:height 12 :floor "grass_block" :length 64 :width 32}
   :blocks [[:set [20 0 12] "chest[facing=west]"] [:fill [36 -1 14] [40 3 18] "stone"] [:set [36 0 16] "iron_ore"] [:set [36 1 16] "iron_ore"]]
   :memory [{:kind :chest :data {:pos #xyz [20 0 12]} :policy {:cap 1 :ttl :forever}}]
   :body {:at [16.5 0 16.5] :inventory [["stone_pickaxe" 1] ["stone_sword" 1] ["stick" 2] ["cooked_beef" 3] ["cobblestone" 8] ["coal" 4] ["crafting_table" 1] ["raw_iron" 1] ["dirt" 1] ["sand" 1] ["gravel" 1] ["tuff" 1] ["andesite" 1] ["diorite" 1] ["granite" 1] ["netherrack" 1] ["deepslate" 1] ["calcite" 1] ["coarse_dirt" 1] ["red_sand" 1] ["clay_ball" 1] ["flint" 1] ["feather" 1] ["bone" 1] ["string" 1] ["gunpowder" 1] ["spider_eye" 1] ["leather" 1] ["paper" 1] ["sugar" 1] ["slime_ball" 1] ["ink_sac" 1]]}
   :act [[:job (jobs.items.get-kit {:items ["iron_pickaxe"] :explore false :food false})]]
   :expect [{:event {:source :job :kind :trip.deposited :data {:result {:free [:>= 12]}}} :within-s 120}
            {:event {:source :job :kind :completed} :within-s 200 :of-job true}]
   :after [[:item "iron_pickaxe" 1] [:not-block [20 0 12] "chest{Items:[{id:\"minecraft:raw_iron\"}]}"]]
   :limit-s 220}
  ;; 3eb9bfcf: an unarmed body does not set out while a hostile is known within 40 blocks (a husk 12 away, NoAI): the job waits :hostile-near and makes no sword.
  ;; Should-fail partner: stone-tools-first-then-no-source-for-iron (no hostile: the sword is made).
  {:name "unarmed-waits-while-a-hostile-is-known-near"
   :blocks [[:fill [20 0 22] [22 1 23] "stone"]]
   :body {:inventory [["cooked_beef" 3]]}
   :act [[:summon "husk" [28.5 0 12.5] "{UUID:[I;2006103,2,1,1],NoAI:1b,equipment:{head:{id:\"minecraft:iron_helmet\",count:1}}}"]
         [:job (jobs.items.get-kit {:items ["stone_sword"] :explore false :food false})]]
   :expect [{:event {:source :job :kind :waiting :data {:reason :hostile-near}} :within-s 30 :of-job true}
            {:no-event {:source :job :kind :completed} :for-s 25 :of-job true}]
