;; Card 1ef2a5ef: a body shut in its own dirt room (an own plan's shell) set in bedrock (never dug), its goal a sealed 1x2
;; pocket in the bedrock. The rock beyond the walls is unseen from inside, so each way out cuts own wall cells and stops at
;; bedrock. Its own holes are not put back while it is still shut in (the next way would cut them again): never cut, put
;; back and cut again, at most one go-to.restored in the call (5 before the fix in the unit twin). The call ends, a failure with its reason.
;; Bedrock x 10..26, y 0..9, z 10..26; the shell x 14..18, y 1..5, z 14..18, hollow (inside x 15..17, y 2..4); goal pocket [20 2..3 18].
{:name "shut-in-own-room-in-bedrock-cuts-each-own-cell-once"
 :tags [:movement :go-to :access]
 :time :any
 :plot {:height 14}
 :blocks [[:fill [10 0 10] [26 9 26] "bedrock"]
          [:fill [14 1 14] [18 5 18] "dirt" :hollow]
          [:fill [20 2 18] [20 3 18] "air"]]
 :plans [{:id "room" :metadata {:by "$body"} :parts [{:id "shell" :box [#at [14 1 14] #at [18 5 18]] :want "dirt"}]}]
 :body {:at [17.5 2 15.5] :settle-s 2 :effects [["resistance" 600 4]]
        :inventory [["dirt" 8] ["stone_pickaxe" 1] ["stone_shovel" 1]]}
 :limit-s 300
 :act [[:job (jobs.movement.go-to {:worth 1200 :pos #at [20 2 18] :range 0})]]
 :expect [{:event {:source :job :kind :stopped :context {:chain [[:any]]} :data {:arrived false :reason :unreachable}} :within-s 290 :of-job true}
          {:count-event {:source :job :kind :go-to.restored} :for-s 290 :at-most 1}]}
