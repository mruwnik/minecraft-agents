;; Card 1c48eb3f: a body 3 steps down a stair cut from the top of a stone mass, where sky light reaches round the corner but stone is over it, is not above ground:
;; mining there at night does not wait for light. Night: run with --allow-time --time-log <shared time log>.
{:defaults
 {:tags [:mine :jobs :night]
  :time :night :time-why :night-light
  :plot {:height 31}
  :blocks [[:fill [2 0 8] [30 28 24] "stone"] [:fill [5 28 16] [5 30 16] "air"] [:fill [6 27 16] [6 29 16] "air"] [:fill [7 26 16] [7 28 16] "air"] [:fill [7 29 16] [7 30 16] "stone"]]
  :body {:at [7.5 26 16.5] :effects [["resistance" 600 4]] :inventory [["stone_pickaxe" 1]]}}
 :cases
 [{:name "mine-cobblestone-down-a-stair-does-not-wait-for-light"
   :act [[:job (jobs.gather.mine {:item "cobblestone" :count 3 :here true :torches false})]]
   :expect [{:no-event {:source :job :kind :waiting :data {:reason :dark}} :for-s 20}
            {:event {:source :job :kind #{:completed :stopped} :data {:got [:>= 3]}} :within-s 120 :of-job true}]
   :after [[:item "cobblestone" [:>= 3]]]
   :limit-s 140}]}
