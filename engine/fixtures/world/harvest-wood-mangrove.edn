;; Card 2f9da188: a felled mangrove tree is replanted with a mangrove_propagule (trees/sapling-of: mangrove's sapling is the propagule,
;; crimson and warped trees use their fungus), where it was left owed before. The propagule is carried; the grass floor takes it.
;; Should-succeed: harvest-wood on a mangrove log column replants the propagule. Should-fail: no propagule carried leaves the
;; replant owed (the ending carries :replant-owed, :ways #{:carried}: leaves may drop a propagule) and plants nothing.
{:defaults
 {:tags [:forestry :harvest-wood :mangrove]
  :plot {:height 10 :floor "grass_block"}
  :blocks [[:fill [16 0 16] [16 3 16] "mangrove_log"]
           [:fill [14 3 14] [18 4 18] "mangrove_leaves[persistent=true]"]
           [:set [16 3 16] "mangrove_log"]]
  :body {:at [10.5 0 16.5] :settle-s 2 :effects [["resistance" 600 4]]}
  :limit-s 120}
 :cases
 [{:name "propagule-replanted"
   :body {:inventory [["iron_axe" 1] ["mangrove_propagule" 1]]}
   :act [[:job (jobs.forestry.harvest-wood {:radius 32})]]
   :expect [{:event {:source :job :kind :completed} :within-s 100 :of-job true}
            {:no-event {:source :job :kind :failed} :for-s 100 :until {:source :job :kind :completed}}]
   :after [[:block [16 0 16] "mangrove_propagule"] [:not-block [16 1 16] "mangrove_log"]]}
  {:name "no-propagule-leaves-the-replant-owed"
   :body {:inventory [["iron_axe" 1]]}
   :act [[:job (jobs.forestry.harvest-wood {:radius 32 :ways #{:carried}})]]
   :expect [{:event {:source :job :kind :completed :data {:replant-owed 1}} :within-s 100 :of-job true}]
   :after [[:not-block [16 0 16] "mangrove_propagule"]]}
  {:name "stray-item-in-radius-not-taken"
   :body {:inventory [["iron_axe" 1] ["mangrove_propagule" 1]]}
   :act [[:summon "item" [3.5 0 16.5] "{Item:{id:\"minecraft:red_bed\",count:1}}"]
         [:job (jobs.forestry.harvest-wood {:radius 32})]]
   :expect [{:event {:source :job :kind :completed} :within-s 100 :of-job true}]
   :after [[:item "red_bed" 0] [:block [16 0 16] "mangrove_propagule"]]}]}
