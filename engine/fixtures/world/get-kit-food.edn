;; items.get-kit and food (cards b6cb0a1a, d73dfc80, b3381afe, 3bd5a3eb). `(get-kit {:items ["iron_pickaxe"] :explore false})`
;; with no iron near: mining/smelting is ahead, so a get-food child with :carry stocks the pack first.
;; Should-succeed: 3 cows near, a sword: a cow is hunted before any mining (food.killed); no sword but cobblestone, sticks and a table:
;; a stone sword is made first; fed (food 20), with bread carried or with an empty pack, and no animals anywhere: kit.no-food warns and the kit goes on (no :no-food stop);
;; 12 bread and a chest of bread it booked 4 blocks off: no food child for the whole kit (7 pieces, about 840 s: the trip's tail past
;; 60 points saves less than the fetch costs); 5 bread and that chest: the kit's time needs more, taken from the chest.
;; A hungry body (bar under 7 after eating its little bread) with no animals stops :no-food. A hurt body (1.5 hp) with a fair bar and nothing to eat stops :no-food too.
;; Cows 17 blocks east, behind a body facing west (past the 16-block hearing): found by the look round.
;; Should-fail: 5 bread with no home food still tops up (kit.no-food); a starving body (food 0) with no food anywhere stops :no-food before any mining; :food false runs no food child; no stop :needs-food.
{:defaults
 {:time :any
  :tags [:items :get-kit :food]
  :plot {:height 6}
  :body {:at [4.5 0 16.5] :inventory [["iron_sword" 1]] :settle-s 2}
  :limit-s 120}
 :cases
 [{:name "cows-near-are-hunted-for-the-pack-before-the-work"
   :act [[:summon "cow" [10.5 0 16.5] "{NoAI:1b}"] [:summon "cow" [11.5 0 16.5] "{NoAI:1b}"] [:summon "cow" [10.5 0 18.5] "{NoAI:1b}"]
         [:job (jobs.items.get-kit {:items ["iron_pickaxe"] :explore false})]]
   :expect [{:event {:source :job :kind :food.killed} :within-s 100}]}
  {:name "cows-behind-past-hearing-are-found-by-looking-round"
   :body {:at [4.5 0 16.5] :yaw 90 :inventory [["iron_sword" 1]] :settle-s 2}
   :act [[:summon "cow" [21.5 0 16.5] "{NoAI:1b}"] [:summon "cow" [22.5 0 16.5] "{NoAI:1b}"] [:summon "cow" [21.5 0 18.5] "{NoAI:1b}"]
         [:job (jobs.items.get-kit {:items ["iron_pickaxe"] :explore false})]]
   :expect [{:event {:source :job :kind :food.killed} :within-s 100}]}
  {:name "fed-with-no-animals-warns-and-goes-on"
   :body {:inventory [["iron_sword" 1] ["bread" 2]]}
   :act [[:job (jobs.items.get-kit {:items ["iron_pickaxe"] :explore false})]]
   :expect [{:event {:source :job :kind :kit.no-food :level :warn} :within-s 60 :of-job true}
            {:no-event {:source :job :kind :stopped :data {:reason :no-food}} :for-s 40 :until {:source :job :kind :kit.no-food}}]}
  {:name "twelve-loaves-and-a-stocked-chest-at-home-carry-the-whole-kits-trip"
   ;; the 7 pieces missing quote 840 s, open-ended (kit-carry): running out costs the food short at the field's price, and past 60 points that tail saves less than the chest's fetch, so no get-food child
   :body {:inventory [["iron_sword" 1] ["bread" 12]]}
   :blocks [[:set [8 0 16] "chest{Items:[{Slot:0b,id:\"minecraft:bread\",count:40}]}"]]
   :memory [{:kind :fetch/stock :data {:pos #at [8 0 16] :items {"bread" 40}} :policy {:cap 64 :ttl :forever}}]
   :act [[:job (jobs.items.get-kit {:explore false})]]
   :expect [{:event {:source :job :kind :stopped :data {:reason :no-source}} :within-s 60 :of-job true}
            {:no-event {:source :job :kind :kit.no-food} :for-s 60 :until {:source :job :kind :stopped}}]
   :after [[:item "bread" 12]]}
  {:name "five-loaves-and-a-stocked-chest-at-home-take-bread-for-the-kits-trip"
   ;; 25 points are under the whole kit's priced trip: get-food takes bread from the chest
   :body {:inventory [["iron_sword" 1] ["bread" 5]]}
   :blocks [[:set [8 0 16] "chest{Items:[{Slot:0b,id:\"minecraft:bread\",count:40}]}"]]
   :memory [{:kind :fetch/stock :data {:pos #at [8 0 16] :items {"bread" 40}} :policy {:cap 64 :ttl :forever}}]
   :act [[:job (jobs.items.get-kit {:explore false})]]
   :expect [{:event {:source :job :kind :food.took-from-chest} :within-s 60}
            {:event {:source :job :kind :stopped :data {:reason :no-source}} :within-s 90 :of-job true}]
   :after [[:item "bread" [:>= 9]]]}
  {:name "five-loaves-and-no-home-food-still-top-up"
   :body {:inventory [["iron_sword" 1] ["bread" 5]]}
   :act [[:job (jobs.items.get-kit {:items ["iron_pickaxe"] :explore false})]]
   :expect [{:event {:source :job :kind :kit.no-food :level :warn} :within-s 60 :of-job true}]}
  {:name "fed-with-an-empty-pack-and-no-animals-goes-on"
   :act [[:job (jobs.items.get-kit {:items ["iron_pickaxe"] :explore false})]]
   :expect [{:event {:source :job :kind :kit.no-food :level :warn} :within-s 60 :of-job true}
            {:no-event {:source :job :kind :stopped :data {:reason :no-food}} :for-s 40 :until {:source :job :kind :kit.no-food}}]}
  {:name "thin-stomach-with-a-little-bread-and-no-animals-stops-before-mining"
   :body {:inventory [["iron_sword" 1] ["bread" 1]]}
   ;; 12 s drains the bar and the setup's saturation to 0 (4 s left it at 20 live, not hungry): the bread brings it to 5, still hungry
   :act [[:rcon "effect give $BODY minecraft:hunger 12 255 true"] [:until-effect-gone "hunger" 30]
         [:job (jobs.items.get-kit {:items ["iron_pickaxe"] :explore false})]]
   :expect [{:event {:source :job :kind :kit.no-food :level :warn} :within-s 100 :of-job true}
            {:event {:source :job :kind :stopped :data {:reason :no-food}} :within-s 30 :of-job true}]}
  {:name "starving-with-no-food-warns-and-stops-before-mining"
   :act [[:rcon "effect give $BODY minecraft:hunger 12 255 true"] [:until-effect-gone "hunger" 30]
         [:job (jobs.items.get-kit {:items ["iron_pickaxe"] :explore false})]]
   :expect [{:event {:source :job :kind :kit.no-food :level :warn} :within-s 100 :of-job true}
            {:event {:source :job :kind :stopped :data {:reason :no-food}} :within-s 30 :of-job true}]}
  {:name "unarmed-body-makes-a-stone-sword-before-the-work"
   :body {:inventory [["cobblestone" 3] ["stick" 2] ["crafting_table" 1] ["bread" 12]]}
   :act [[:job (jobs.items.get-kit {:items ["iron_pickaxe"] :explore false})]]
   :expect [{:event {:source :job :kind :stopped :data {:reason :no-source}} :within-s 90 :of-job true}]
   :after [[:item "stone_sword" 1]]}
  {:name "food-false-runs-no-food-child"
   :act [[:job (jobs.items.get-kit {:items ["iron_pickaxe"] :explore false :food false})]]
   :expect [{:event {:source :job :kind :stopped :data {:reason :no-source}} :within-s 60 :of-job true}
            {:no-event {:source :job :kind :kit.no-food} :for-s 30 :until {:source :job :kind :stopped}}]}
  {:name "hurt-foodless-body-underground-is-not-held-for-health"
   ;; 1.5 hp, food under 18, nothing to eat, in a sealed dark rock pocket: no heal can come, so no :low-health wait; the kit looks for food / stops.
   :plot {:height 12}
   :blocks [[:fill [2 0 8] [30 9 24] "stone"] [:fill [14 3 16] [18 4 16] "air"]]
   :body {:at [16.5 3 16.5] :inventory [["iron_sword" 1]] :effects [["hunger" 120 255]]}
   :act [[:wait-s 6]
         [:rcon "damage $BODY 18.5 minecraft:generic"]
         [:job (jobs.items.get-kit {:items ["iron_pickaxe"] :explore false})]]
   :expect [{:event {:source :job :kind :kit.no-food :level :warn} :within-s 60 :of-job true}
            {:no-event {:source :job :kind :waiting :data {:reason :low-health}} :for-s 40 :of-job true :from-event {:source :job :kind :kit.no-food}}]}
  {:name "hurt-body-with-a-fair-bar-and-no-food-stops-before-mining"
   ;; 3 hp (too hurt for a mine's work: under 3.8 hp fed), a bar under 18, nothing to eat, sealed rock: no heal can come, so the kit stops :no-food instead of mining on.
   :time :any
   :plot {:height 12}
   :blocks [[:fill [2 0 8] [30 9 24] "stone"] [:fill [14 3 16] [18 4 16] "air"]]
   :body {:at [16.5 3 16.5] :inventory [["iron_sword" 1]] :effects [["hunger" 4 255]]}
   :act [[:wait-s 6]
         [:rcon "damage $BODY 18.5 minecraft:generic"]
         [:job (jobs.items.get-kit {:items ["iron_pickaxe"] :explore false})]]
   :expect [{:event {:source :job :kind :stopped :data {:reason :no-food}} :within-s 90 :of-job true}]}]}
