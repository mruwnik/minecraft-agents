;; card f56b7410: gather.make-obsidian with no lava in sight walks to the lava body memory :breach-behind remembers (cells a sealed mine
;; breach showed), digs the seal from 2+ blocks off, sees the lava and makes obsidian. Remembered lava is stale: if it is gone, the job ends :no-lava.
;; Wall x 25 (seal [25 0 16]) shuts a stone block with a cavity x 26-29; lava [27 -1 16] sunk in the floor, the breach is 2 high (y 1 open, the seal at y 0).
{:defaults
 {:tags [:gather :obsidian :jobs]
  :time :day
  :plot {:height 12 :floor "grass_block"}
  :body {:at [16.5 0 16.5] :yaw 270 :settle-s 2 :inventory [["diamond_pickaxe" 1] ["water_bucket" 1]]
         :effects [["resistance" 600 4] ["fire_resistance" 600 0]]}
  :limit-s 130}
 :cases
 [{:name "remembered-breach-lava-is-reached-and-made-obsidian"
   :blocks [[:fill [25 0 14] [30 3 18] "stone"] [:fill [26 0 15] [29 2 17] "air"] [:set [25 1 16] "air"] [:set [27 -1 16] "lava"]]
   :memory [{:kind :breach-behind
             :data {:dim "overworld" :at #at [25 0 16] :names ["lava"] :cells [#at [27 -1 16]] :lava [#at [27 -1 16]] :seals [#at [25 0 16]]}}]
   :act [[:job (jobs.gather.make-obsidian {:count 1})]]
   :expect [{:event {:source :job :kind :completed} :within-s 120 :of-job true}]
   :after [[:item "obsidian" [:>= 1]]]}
  {:name "stale-breach-lava-gone-ends-no-lava"
   :blocks [[:fill [25 0 14] [30 3 18] "stone"] [:fill [26 0 15] [29 2 17] "air"] [:set [25 1 16] "air"]]
   :memory [{:kind :breach-behind
             :data {:dim "overworld" :at #at [25 0 16] :names ["lava"] :cells [#at [27 -1 16]] :lava [#at [27 -1 16]] :seals [#at [25 0 16]]}}]
   :act [[:job (jobs.gather.make-obsidian {:count 1})]]
   :expect [{:event {:source :job :kind :stopped :data {:reason :no-lava}} :within-s 90 :of-job true}]
   :after [[:item "obsidian" 0]]
   :limit-s 110}]}
