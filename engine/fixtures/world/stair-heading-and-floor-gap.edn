;; jobs.access.stair defaults and floor gaps (cards b21f992b, 80dde49e, 65ac2209): a call with no :heading digs the way the body
;; faces (it used to stop :bad-args); a flat run whose floor has a one-cell gap fills it from a neighbour (bridge!) and goes on;
;; a stair down over a cave bridges against a seen wall, or with nothing to place against bridges flat ahead to the far side (or stops :no-support-floor when no far side is near).
;; Stone mass x 2..30, z 8..24, y 0..9 (surface y 10).
{:defaults
 {:tags [:access :mine] :time :any
  :plot {:height 24}
  :blocks [[:fill [2 0 8] [30 9 24] "stone"]]
  :body {:at [10.5 10 16.5] :yaw 270 :inventory [["iron_pickaxe" 1] ["cobblestone" 8] ["torch" 8]] :effects [["resistance" 600 4]]}
  :limit-s 150}
 :cases
 [{:name "stair-without-heading-digs-the-way-the-body-faces"
   :act [[:job (jobs.access.stair {:dir :down :steps 4})]]
   :expect [{:event {:source :job :kind :completed :data {:steps 4}} :within-s 120 :of-job true}
            {:no-event {:source :job :kind :child_ended :data {:ending {:data {:reason :bad-args}}}} :for-s 120 :until {:source :job :kind :completed}}]
   :after [[:body-near [14.5 6 16.5] 2.5]]}
  {:name "level-run-bridges-a-floor-gap"
   :blocks [[:fill [10 8 16] [20 9 16] "air"] [:set [14 7 16] "air"]]
   :body {:at [10.5 8 16.5]}
   :act [[:job (jobs.access.stair {:dir :level :heading :east :steps 8})]]
   :expect [{:event {:source :job :kind :completed :data {:steps 8}} :within-s 120 :of-job true}
            {:no-event {:source :job :kind :stopped} :for-s 120 :until {:source :job :kind :completed}}]
   :after [[:not-block [14 7 16] "air"] [:body-near [18.5 8 16.5] 2.5]]}
  ;; should-fail (card 4567b3f9): a cave (x 10..14, y 4..8) opens straight under the first step; the floor [11 8 16] and the cell under it have no
  ;; neighbour the body can see (the underside of the cut cell is refused with the eye above it, the cave cells further back are hidden), so the
  ;; stair stops :no-support-floor before any step and shuts the cut cell
  {:name "stair-down-into-a-cave-with-no-visible-support-stops-at-the-first-floor"
   :blocks [[:fill [10 4 15] [14 8 17] "air"]]
   :body {:inventory [["iron_pickaxe" 1] ["cobblestone" 16]]}
   :act [[:job (jobs.access.stair {:dir :down :heading :east :steps 4})]]
   :expect [{:event {:source :job :kind :stopped :data {:reason :no-support-floor :steps 0}} :within-s 120 :of-job true}]
   :after [[:block [11 8 16] "air"] [:not-block [11 9 16] "air"]]}
  ;; the body stands on a ledge (x 10, y 9) with a void under it (x 7..13, y 0..8) and a trench ahead (x 11..13, y 9): the first floor has no neighbour to
  ;; place against and nothing solid within the bridge depth; the stair lays two flat blocks over the trench, then places the next floor against the far wall (x 14) and cuts on
  {:name "stair-down-on-a-ledge-over-a-void-bridges-flat-then-goes-on"
   :blocks [[:fill [7 0 8] [13 8 24] "air"] [:fill [11 9 8] [13 9 24] "air"]]
   :body {:inventory [["iron_pickaxe" 1] ["cobblestone" 16]]}
   :act [[:job (jobs.access.stair {:dir :down :heading :east :steps 4})]]
   :expect [{:event {:source :job :kind :completed :data {:steps 4}} :within-s 150 :of-job true}
            {:no-event {:source :job :kind :stopped} :for-s 150 :until {:source :job :kind :completed}}]
   :after [[:not-block [11 9 16] "air"] [:not-block [12 9 16] "air"] [:body-near [16.5 6 16.5] 2.5]]}
  ;; a cave (x 10..14, y 4..8, z 16..17) with its side wall at z 15 in sight of every floor: the stair places each missing floor against that wall and goes on
  {:name "stair-down-over-a-cave-bridges-the-floor-against-a-seen-side-wall"
   :blocks [[:fill [10 4 16] [14 8 17] "air"]]
   :body {:inventory [["iron_pickaxe" 1] ["cobblestone" 16]]}
   :act [[:job (jobs.access.stair {:dir :down :heading :east :steps 4})]]
   :expect [{:event {:source :job :kind :completed :data {:steps 4}} :within-s 120 :of-job true}
            {:no-event {:source :job :kind :stopped} :for-s 120 :until {:source :job :kind :completed}}]
   :after [[:not-block [11 8 16] "air"] [:body-near [14.5 5 16.5] 2.5]]}
  ;; should-fail (card 94cba87f): the cave (x 12..30, y 0..6) opens under the floor of step 3 (x 13) and runs on east, so no stone shows at
  ;; its end; its only solid cell in line, [11 6 16], lies under the stone floor of step 2 and cannot be seen from the shaft, so no cell can be aimed at:
  ;; the stair stops :no-support-floor and shuts the cut cell over the floor
  {:name "stair-down-over-a-cave-whose-only-support-is-hidden-under-the-floor-above-stops"
   :blocks [[:fill [12 0 12] [30 6 20] "air"]]
   :body {:inventory [["iron_pickaxe" 1] ["cobblestone" 16]]}
   :act [[:job (jobs.access.stair {:dir :down :heading :east :steps 4})]]
   :expect [{:event {:source :job :kind :stopped :data {:reason :no-support-floor :steps 2}} :within-s 120 :of-job true}]
   :after [[:block [13 6 16] "air"] [:not-block [13 7 16] "air"]]}
  ;; should-fail: a cave under the very first floor and no block carried: the stair stops :no-floor, :filler :none
  {:name "stair-down-over-a-cave-with-no-block-stops-no-floor"
   :blocks [[:fill [11 0 12] [20 8 20] "air"]]
   :body {:inventory [["iron_pickaxe" 1]]}
   :act [[:job (jobs.access.stair {:dir :down :heading :east :steps 4})]]
   :expect [{:event {:source :job :kind :stopped :data {:reason :no-floor :filler :none}} :within-s 90 :of-job true}]
   :after [[:block [11 8 16] "air"]]}
  ;; a stair up whose second floor [12 6 16] is air with air under it (a cave pocket x 12, y 5..6, side walls in sight): with :ways #{:carried} and
  ;; cobblestone and dirt carried it places a carried block against the wall and climbs on, not :no-support-floor "nothing to place"
  {:name "stair-up-over-a-missing-floor-places-a-carried-block"
   :blocks [[:fill [10 5 16] [10 6 16] "air"] [:fill [12 5 16] [12 6 16] "air"]]
   :body {:at [10.5 5 16.5] :inventory [["iron_pickaxe" 1] ["cobblestone" 16] ["dirt" 8]]}
   :act [[:job (jobs.access.stair {:dir :up :heading :east :steps 4 :ways #{:carried}})]]
   :expect [{:event {:source :job :kind :completed :data {:steps 4}} :within-s 120 :of-job true}
            {:no-event {:source :job :kind :stopped} :for-s 120 :until {:source :job :kind :completed}}]
   :after [[:not-block [12 6 16] "air"] [:body-near [14.5 9 16.5] 2.5]]}
  ;; a stair up into open air (x 12..16, y 5..12, z 13..19 all air): the only solid cell near the second floor [12 6 16] is the first floor
  ;; [11 5 16], diagonal to it; with :ways #{:carried} the stair places the cell under the floor against that one, then the floor on it, and climbs on
  {:name "stair-up-into-open-air-with-no-side-wall-bridges-from-the-previous-floor"
   :blocks [[:fill [10 5 16] [10 6 16] "air"] [:fill [12 5 13] [16 12 19] "air"]]
   :body {:at [10.5 5 16.5] :inventory [["iron_pickaxe" 1] ["cobblestone" 16]]}
   :act [[:job (jobs.access.stair {:dir :up :heading :east :steps 4 :ways #{:carried}})]]
   :expect [{:event {:source :job :kind :completed :data {:steps 4}} :within-s 120 :of-job true}
            {:no-event {:source :job :kind :stopped} :for-s 120 :until {:source :job :kind :completed}}]
   :after [[:not-block [12 6 16] "air"] [:not-block [13 7 16] "air"] [:not-block [14 8 16] "air"] [:body-near [14.5 9 16.5] 2.5]]}
  ;; a stair up from the stone top over open air: each floor is placed at the body's own height beside it, so the body steps to the middle
  ;; of its cell first (its box at x .77 reached into the floor cell and the server refused the block)
  {:name "stair-up-in-open-air-centres-before-placing-the-floor"
   :act [[:job (jobs.access.stair {:dir :up :heading :east :steps 3})]]
   :expect [{:event {:source :job :kind :completed :data {:steps 3}} :within-s 120 :of-job true}
            {:no-event {:source :job :kind :stopped} :for-s 120 :until {:source :job :kind :completed}}]
   :after [[:not-block [11 10 16] "air"] [:not-block [12 11 16] "air"]]}]}
