;; jobs.village.offers reads the same way and buys nothing. jobs.village.trade with no :villager given opens the nearest adult villager in sight and, when it shows no offers (a jobless
;; one), goes on to the next, as a player would. NoAI villagers. Should-succeed: a jobless villager stands nearer than a farmer with
;; one offer (1 emerald for 6 bread); the farmer sells. Should-fail: only a jobless villager in sight ends stopped :no-offers.
{:defaults
 {:tags [:village :trade :jobs]
  :plot {:floor "grass_block" :height 8}
  :body {:at [10.5 0 16.5] :yaw 270 :settle-s 2 :inventory [["emerald" 8]] :effects [["resistance" 600 4]]}
  :limit-s 90}
 :cases
 [{:name "jobless-nearer-farmer-sells"
   :act [[:summon "villager" [13.5 0 16.5] "{NoAI:1b}"]
         [:summon "villager" [17.5 0 16.5] "{NoAI:1b,VillagerData:{profession:\"minecraft:farmer\",level:2,type:\"minecraft:plains\"},Xp:20,Offers:{Recipes:[{buy:{id:\"minecraft:emerald\",count:1},sell:{id:\"minecraft:bread\",count:6},maxUses:12,xp:1}]}}"]
         [:job (jobs.village.trade {:buy "bread" :count 6})]]
   :expect [{:event {:source :job :kind :completed :data {:bought 6}} :within-s 80 :of-job true}]
   :after [[:item "bread" 6] [:item "emerald" 7]]}
  {:name "offers-reads-and-buys-nothing"
   :act [[:summon "villager" [13.5 0 16.5] "{NoAI:1b}"]
         [:summon "villager" [17.5 0 16.5] "{NoAI:1b,VillagerData:{profession:\"minecraft:farmer\",level:2,type:\"minecraft:plains\"},Xp:20,Offers:{Recipes:[{buy:{id:\"minecraft:emerald\",count:1},sell:{id:\"minecraft:bread\",count:6},maxUses:12,xp:1}]}}"]
         [:job (jobs.village.offers {})]]
   :expect [{:event {:source :job :kind :trade.offers :data {:profession "farmer"}} :within-s 60 :of-job true}
            {:event {:source :job :kind :completed :data {:profession "farmer"}} :within-s 80 :of-job true}]
   :after [[:item "bread" 0] [:item "emerald" 8]]}
  {:name "only-a-jobless-villager-has-no-offers"
   :act [[:summon "villager" [13.5 0 16.5] "{NoAI:1b}"]
         [:job (jobs.village.trade {:buy "bread" :count 6})]]
   :expect [{:event {:source :job :kind :stopped :data {:reason :no-offers}} :within-s 80 :of-job true}]
   :after [[:item "bread" 0] [:item "emerald" 8]]}
  {:name "librarian-offers-name-the-books-enchantment"
   :act [[:summon "villager" [13.5 0 16.5] "{NoAI:1b,VillagerData:{profession:\"minecraft:librarian\",level:1,type:\"minecraft:plains\"},Xp:1,Offers:{Recipes:[{buy:{id:\"minecraft:emerald\",count:20},sell:{id:\"minecraft:enchanted_book\",count:1,components:{\"minecraft:stored_enchantments\":{\"minecraft:mending\":1}}},maxUses:12,xp:1}]}}"]
         [:job (jobs.village.trade {:buy "enchanted_book" :spend {:items {"emerald" 0}}})]]
   :expect [{:event {:source :job :kind :trade.offers :data {:profession "librarian" :enchants ["mending 1"]}} :within-s 60 :of-job true}
            {:event {:source :job :kind :stopped :data {:reason :price}} :within-s 80 :of-job true}]
   :after [[:item "emerald" 8]]}]}
