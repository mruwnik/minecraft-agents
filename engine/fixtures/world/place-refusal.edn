;; A place the server refuses (a sheep standing in the cell) ends the primitive with :failed and the refusal facts (card b3598176).
{:defaults
 {:tags [:blocks :jobs]
  :body {:at [16.5 0 16.5] :inventory [["dirt" 8]]}
  :limit-s 40}
 :cases
 [{:name "sheep-in-cell"
   :blocks [[:set [18 0 16] "stone"]]
   :act [[:summon "sheep" [18.5 0 17.5] "{NoAI:1b}"]
         [:job (jobs.blocks.place {:pos #at [18 0 17] :item "dirt"})]]
   :expect [{:event {:source :job :kind :blocks.place.done :data {:placed false :reason :failed}} :within-s 30 :of-job true}]
   :after [[:block [18 0 17] "air"] [:item "dirt" 8]]}]}
