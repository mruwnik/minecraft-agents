;; Where a flight on open ground leans and ends. Cards 04d4e8e6 (a goal given up is retried once :goal-off lapses, 30 s),
;; 64fbe13b (a goal straight up a column is :steep: no leg to it), 7be9ca17 and 05029ce5 (no step ends within 12 of a recent
;; death while other ground is open), 0a13d0b1 (a dry end beats a swim), 5dd53314 (a flight that gains does not turn to the
;; cornered options), 8f903b78 (an end go-to refused as not standable, here the void north of a drop edge, is not retried for the rest of the flight). Zombies are helmeted; the chasing ones have AI and slowness so the unarmed body (resistance) gains.
{:defaults
 {:tags [:hostile :survival :flee]
  :time :any
  :mobs :keep
  :register [{:trigger :suffocating}
             {:trigger :hostile-near}]
  :body {:at [16.5 0 16.5] :effects [["resistance" 900 4]]}
  :limit-s 90}
 :cases
 [{:name "goal-given-up-is-tried-again-after-30-s"
   :plot {:height 12 :length 64 :width 32 :light :sky}
   :body {:at [8.5 0 16.5]}
   :memory [{:kind :goal-off :age-s 12 :data {:goal #at [56 0 16] :why :lost-ground} :policy {:cap 4 :ttl 30000}}]
   :act [[:job (jobs.movement.go-to {:pos #at [56 0 16] :range 2})]
         [:await {:source :job :kind :planned} 20]
         [:summon "zombie" [12.5 0 16.5] "{equipment:{head:{id:\"minecraft:iron_helmet\",count:1}},active_effects:[{id:\"minecraft:slowness\",amplifier:0b,duration:2400}]}"]]
   :expect [{:event {:source :job :kind :retreat.choice :data {:goal-why :given-up}} :within-s 25}
            {:event {:source :job :kind :retreat.choice :data {:lean [:near #at [56 0 16] 1.5]}} :within-s 80}]}
  {:name "goal-straight-up-a-column-is-steep-no-leg"
   :blocks [[:fill [19 0 15] [21 29 17] "stone"]]
   :plot {:height 31 :light :sky}
   :act [[:job (jobs.movement.go-to {:pos #at [20 30 16] :range 1})]
         [:await {:source :job :kind :planned} 30]
         [:summon "zombie" [11.5 0 16.5] "{NoAI:1b,equipment:{head:{id:\"minecraft:iron_helmet\",count:1}}}"]]
   :expect [{:event {:source :job :kind :retreat.choice :data {:goal-why :steep}} :within-s 30}
            {:no-event {:source :job :kind :retreat.target :data {:target [:near #at [20 30 16] 3]}} :for-s 40}]
   :limit-s 60}
  {:name "flight-keeps-away-from-a-recent-death"
   :body {:yaw 90}
   :memory [{:kind :died :age-s 60 :data {:pos #xyz [26 0 16]}}
            {:kind :respawned :age-s 50 :data {}}]
   :act [[:summon "zombie" [11.5 0 16.5] "{NoAI:1b,equipment:{head:{id:\"minecraft:iron_helmet\",count:1}}}"]]
   :expect [{:event {:source :job :kind :retreat.target} :within-s 20}
            {:no-event {:source :job :kind :retreat.target :data {:target [:near #at [26 0 16] 11.5]}} :for-s 15}]
   :limit-s 60}
  {:name "dry-end-beats-a-swim-across-the-pond"
   :plot {:light :sky}
   :blocks [[:fill [0 0 0] [31 1 31] "stone"] [:fill [19 1 6] [30 1 26] "water"]]
   :body {:at [16.5 2 16.5]}
   :act [[:summon "zombie" [11.5 2 16.5] "{NoAI:1b,equipment:{head:{id:\"minecraft:iron_helmet\",count:1}}}"]]
   :expect [{:event {:source :job :kind :retreat.target} :within-s 20}
            {:no-event {:source :job :kind :retreat.target :data {:target [:near #at [25 1 16] 6]}} :for-s 40}]
   :limit-s 60}
  {:name "gaining-flight-never-turns-to-the-cornered-options"
   ;; long enough that the flight ends by outrunning the zombie before the far wall pins the body in a corner
   :plot {:height 12 :length 256 :width 32}
   ;; no blocks carried: with some, a lone melee mob close by is pillared against before any flee step (early refuge)
   :body {:at [12.5 0 16.5] :inventory []}
   :act [[:summon "zombie" [6.5 0 16.5] "{equipment:{head:{id:\"minecraft:iron_helmet\",count:1}},active_effects:[{id:\"minecraft:slowness\",amplifier:1b,duration:2400}]}"]]
   :expect [{:count-event {:source :job :kind :retreat.target} :for-s 70 :at-least 3}
            {:no-event {:source :job :kind #{:retreat_sealed :retreat_blocked}} :for-s 70}]
   :limit-s 80}
  {:name "lone-zombie-with-blocks-pillars-before-any-flee-step"
   :plot {:height 12 :length 64 :width 32}
   :body {:at [12.5 0 16.5] :inventory [["dirt" 20]]}
   :act [[:summon "zombie" [6.5 0 16.5] "{NoAI:1b,equipment:{head:{id:\"minecraft:iron_helmet\",count:1}}}"]]
   :expect [{:event {:source :job :kind :child_ended :data {:slot :pillar :status :done}} :within-s 30}
            {:no-event {:source :job :kind :retreat.target} :for-s 30 :until {:source :job :kind :child_ended :data {:slot :pillar :status :done}}}]
   :limit-s 45}
  {:name "refused-end-at-a-drop-edge-is-not-retried"
   :plot {:height 12 :light :sky}
   :blocks [[:fill [0 -1 0] [31 -1 12] "air"]]
   :body {:at [16.5 0 14.5]}
   :act [[:summon "zombie" [16.5 0 22.5] "{NoAI:1b,equipment:{head:{id:\"minecraft:iron_helmet\",count:1}}}"]]
   :expect [{:event {:source :job :kind :retreat.target} :within-s 20}
            {:count-event {:source :job :kind :retreat.target} :for-s 40 :at-least 1 :at-most 12}]
   :limit-s 60}]}
