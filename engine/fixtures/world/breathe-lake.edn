;; Breathe in a big lake (cards b78e70b7, fdf7c948): the body is put in water 40 blocks from an open east bank (walls of stone, 2 above the water, on
;; the other sides, 28+ away), its air runs out, the breathe reflex fires. It swims/go-tos to the bank in one run and the reflex ends cleared. In the second case
;; no land is inside the shrunk bounds (:search-radius 16 :swim-range 40; the walls are 28+ away): swim legs, then the reflex ends stopped :no_land_in_range, the body stays within
;; 40 blocks of its start and never drowns (health stays above 0: the case lasts the limit). Plot 100 x 64, the basin water 3 deep (y 0..3).
{:defaults
 {:tags [:survival :water] :time :any
  :plot {:height 10 :length 100 :width 64}
  :blocks [[:fill [0 0 0] [49 3 63] "stone"]
           [:fill [50 0 0] [99 3 63] "stone"]
           [:fill [0 4 0] [99 5 3] "stone"]
           [:fill [0 4 60] [99 5 63] "stone"]
           [:fill [0 4 0] [3 5 63] "stone"]
           [:fill [4 0 4] [49 3 59] "water"]
           [:fill [50 0 4] [69 3 59] "water"]]
  :limit-s 150}
 :cases
 [{:name "open-lake-bank-40-away-lands"
   :register [{:trigger :suffocating :persistence :cooldown :cooldown-s 2 :args {:min-oxygen 12}
               :job (jobs.survival.breathe {:min-oxygen 12})}]
   :body {:at [30.5 2 32.5] :settle-s 1}
   :expect [{:event {:source :reflex :kind :fired} :within-s 30}
            {:event {:source :reflex :kind :ended :data {:outcome :done :how :cleared}} :within-s 120}
            {:no-event {:source :job :kind :stopped} :until {:source :reflex :kind :ended} :for-s 120}]
   :after [[:body-near [75.5 4 32.5] 14]]}
  {:name "no-land-in-range-stops-clean"
   :blocks [[:fill [70 4 4] [99 5 59] "stone"]
            [:fill [70 0 4] [99 3 59] "stone"]
            [:fill [70 0 4] [96 3 59] "water"]]
   :register [{:trigger :suffocating :persistence :cooldown :cooldown-s 2
               :args {:min-oxygen 12} :job (jobs.survival.breathe {:min-oxygen 12 :search-radius 16 :swim-range 40})}]
   :body {:at [45.5 2 32.5] :settle-s 1}
   :expect [{:event {:source :reflex :kind :fired} :within-s 30}
            {:event {:source :reflex :kind :ended :data {:outcome :stopped :reason :no_land_in_range}} :within-s 140}
            {:no-event {:source :job :level :warn :kind #{:unreachable :refused}} :until {:source :reflex :kind :ended} :for-s 140}
            {:no-event {:source :body :kind :died} :until {:source :reflex :kind :ended} :for-s 140}]
   :after [[:body-near [45.5 3.5 32.5] 40]]}
  ;; a refire within 5 minutes of the stop (the body sinks, its air drops) starts from the remembered spot and stops at once: no new leg
  {:name "refire-after-stop-makes-no-new-legs"
   :limit-s 230
   :blocks [[:fill [70 4 4] [99 5 59] "stone"]
            [:fill [70 0 4] [99 3 59] "stone"]
            [:fill [70 0 4] [96 3 59] "water"]]
   :register [{:trigger :suffocating :persistence :cooldown :cooldown-s 2
               :args {:min-oxygen 12} :job (jobs.survival.breathe {:min-oxygen 12 :search-radius 16 :swim-range 40})}]
   :body {:at [45.5 2 32.5] :settle-s 1}
   :act [[:await {:source :reflex :kind :ended :data {:outcome :stopped :reason :no_land_in_range}} 140]
         [:wait-s 5]]
   :expect [{:event {:source :job :level :warn :kind :stopped :data {:reason :no_land_in_range}} :within-s 140}
            {:no-event {:source :job :kind :child_started :data {:slot :leg}} :from-s 60 :for-s 150}]
   :after [[:body-near [45.5 3.5 32.5] 40]]}]}
