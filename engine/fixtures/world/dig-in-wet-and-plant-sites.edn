;; Card d3a6426a: dig-in site checks. Water-ish blocks beside the descent cell, or water at the body, refuse the pit
;; (dig_in_failed, ground intact); a plant beside the start is no roof support, so the pit goes 3 deep and is roofed in the
;; ground layer. Dirt pad y -6..-1 under the body (the plot floor is over void). Night: --allow-time --time-log <shared log>.
{:defaults
 {:tags [:night :survival :dig-in]
  :time :night
  :blocks [[:fill [8 -6 8] [24 -1 24] "dirt"]
           [:set [4 0 4] "torch"] [:set [4 0 28] "torch"] [:set [28 0 4] "torch"] [:set [28 0 28] "torch"]
           [:set [16 0 4] "torch"] [:set [16 0 28] "torch"] [:set [4 0 16] "torch"] [:set [28 0 16] "torch"]]
  :body {:at [16.5 0 16.5] :effects [["resistance" 600 4]]}}
 :cases
 [{:name "water-beside-descent-cell-refuses"
   :blocks [[:set [17 -1 16] "water"]]
   :act [[:job (jobs.survival.dig-in {})]]
   :expect [{:event {:source :job :kind :dig_in_failed :message [:contains "beside the descent cell"]} :within-s 30 :of-job true}
            {:no-event {:source :job :kind :dig-in.sealed} :for-s 30 :until {:source :job :kind :dig_in_failed :message [:contains "beside the descent cell"]}}]
   :after [[:block [16 -1 16] "dirt"]]
   :limit-s 40}
  {:name "waterlogged-slab-beside-descent-cell-refuses"
   :blocks [[:set [17 -1 16] "oak_slab[waterlogged=true]"]]
   :act [[:job (jobs.survival.dig-in {})]]
   :expect [{:event {:source :job :kind :dig_in_failed :message [:contains "beside the descent cell"]} :within-s 30 :of-job true}
            {:no-event {:source :job :kind :dig-in.sealed} :for-s 30 :until {:source :job :kind :dig_in_failed :message [:contains "beside the descent cell"]}}]
   :after [[:block [16 -1 16] "dirt"]]
   :limit-s 40}
  {:name "seagrass-beside-descent-cell-refuses"
   :blocks [[:set [17 -1 16] "seagrass"]]
   :act [[:job (jobs.survival.dig-in {})]]
   :expect [{:event {:source :job :kind :dig_in_failed :message [:contains "beside the descent cell"]} :within-s 30 :of-job true}
            {:no-event {:source :job :kind :dig-in.sealed} :for-s 30 :until {:source :job :kind :dig_in_failed :message [:contains "beside the descent cell"]}}]
   :after [[:block [16 -1 16] "dirt"]]
   :limit-s 40}
  {:name "water-in-feet-cell-refuses"
   :blocks [[:set [16 0 16] "water"]]
   :act [[:job (jobs.survival.dig-in {})]]
   :expect [{:event {:source :job :kind :dig_in_failed :message [:contains "where the body stands"]} :within-s 30 :of-job true}
            {:no-event {:source :job :kind :dig-in.sealed} :for-s 30 :until {:source :job :kind :dig_in_failed :message [:contains "where the body stands"]}}]
   :after [[:block [16 -1 16] "dirt"]]
   :limit-s 40}
  {:name "water-above-roof-cell-refuses"
   :blocks [[:set [17 0 16] "stone"] [:set [16 1 16] "water"]]
   :act [[:job (jobs.survival.dig-in {})]]
   :expect [{:event {:source :job :kind :dig_in_failed :message [:contains "not digging"]} :within-s 30 :of-job true}
            {:no-event {:source :job :kind :dig-in.sealed} :for-s 30 :until {:source :job :kind :dig_in_failed :message [:contains "not digging"]}}]
   :after [[:block [16 -1 16] "dirt"]]
   :limit-s 40}
  {:name "poppy-beside-start-digs-3-deep-and-seals"
   :blocks [[:set [17 0 16] "poppy"]]
   :act [[:job (jobs.survival.dig-in {})]]
   :expect [{:event {:source :job :kind :dig-in.sealed} :within-s 60 :of-job true}
            {:no-event {:source :job :kind :dig_in_failed} :for-s 60 :until {:source :job :kind :dig-in.sealed}}]
   :after [[:not-block [16 -2 16] "dirt"]]
   :limit-s 80}
  {:name "flat-dirt-no-plant-seals"
   :act [[:job (jobs.survival.dig-in {})]]
   :expect [{:event {:source :job :kind :dig-in.sealed} :within-s 60 :of-job true}
            {:no-event {:source :job :kind :dig_in_failed} :for-s 60 :until {:source :job :kind :dig-in.sealed}}]
   :limit-s 80}]}
