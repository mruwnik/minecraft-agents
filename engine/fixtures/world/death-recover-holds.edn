;; Cards f4d5f362 (ef1e288b, 11c0004f): after a death the errand reflexes (hungry, ...) hold off for jobs.lib.body/recovery-hold-s while the :died
;; reflex recovers the pile, whatever the register order (here :hungry before :died); the pile is fetched at once, dark or not (Q367).
;; Pile: 24 raw_iron at [26 0 26], where the body dies; it respawns at [4 0 4]. The hunger effect leaves food 8 (hungry would fire).
{:defaults
 {:tags [:survival :death :jobs]
  :time :any
  :body {:at [26.5 0 26.5] :spawnpoint [4 0 4] :effects [["resistance" 600 4]]
         :inventory [["raw_iron" 24]]}
  :limit-s 120}
 :cases
 [{:name "hungry-before-died-waits-for-the-recovery"
   :register [{:trigger :hungry :persistence :cooldown :cooldown-s 30 :job (jobs.survival.get-food {})}
              {:trigger :died :persistence :cooldown :cooldown-s 30 :args {}}]
   :act [[:kill-body]
         [:await {:source :body :kind :respawned} 30]
         [:rcon "effect give $BODY minecraft:hunger 5 255 true"]
         [:wait-s 40]] ; hungry is due the whole time; it may fire only once the recovery has ended
   :expect [{:event {:source :reflex :kind :fired :context {:reflex-id :died}} :within-s 40}
            {:no-event {:source :reflex :kind :fired :context {:reflex-id :hungry}} :for-s 60 :until {:source :reflex :kind :ended :context {:reflex-id :died}}}
            {:event {:source :reflex :kind :fired :context {:reflex-id :hungry}} :within-s 40}]
   :after [[:item "raw_iron" 24]]}
  ;; 7d64af0a: a hostile in sight at the respawn is due too, listed after :died as in the scenarios; the corpse's pile is recovered first
  {:name "hostile-due-at-respawn-died-fires-first"
   :register [{:trigger :died :persistence :cooldown :cooldown-s 30 :args {}}
              {:trigger :hostile-near :args {:radius 8 :ranged-radius 16}
               :job (jobs.survival.respond-to-hostile)}]
   :act [[:summon "zombie" [8.5 0 4.5] "{NoAI:1b,equipment:{head:{id:\"minecraft:iron_helmet\",count:1}}}"]
         [:kill-body]
         [:await {:source :body :kind :respawned} 30]]
   :expect [{:event {:source :reflex :kind :fired :context {:reflex-id :died}} :within-s 40}
            {:no-event {:source :reflex :kind :fired :context {:reflex-id :hostile-near}} :for-s 30 :until {:source :reflex :kind :fired :context {:reflex-id :died}}}]}
  ;; Q367: the pile despawns 5 min after the death, so a body shut in a hut at night walks out through the door and fetches it; it never waits for the light
  {:name "hut-pile-is-fetched-at-night"
   :time :night-exclusive
   :blocks [[:fill [2 0 2] [8 3 8] "stone" :hollow] [:fill [3 0 3] [7 2 7] "air"] [:set [3 1 3] "torch"] [:set [7 1 7] "torch"]
            [:set [5 0 2] "oak_door[facing=south,half=lower]"] [:set [5 1 2] "oak_door[facing=south,half=upper]"]
            [:set [26 1 26] "torch"] [:set [20 0 20] "torch"]]
   :register [{:trigger :died :persistence :cooldown :cooldown-s 30 :args {}}]
   :body {:spawnpoint [5 0 5]}
   :act [[:time-set 21500]
         [:wait-s 1]
         [:kill-body]]
   :expect [{:event {:source :job :kind :recover-drops.decided :data {:decision :collected}} :within-s 160}
            {:no-event {:source :reflex :kind :held :data {:reason :exposed}} :for-s 160 :until {:source :job :kind :recover-drops.decided}}]
   :after [[:item "raw_iron" 24]]
   :limit-s 200}]}
