;; Card fe612df0 (d71f9264): open ground hidden behind a 5-high wall is guessed by the measured sky prior under the seen sky over the
;; wall (base-rates/sky-under, about 0.65 lit by day), not as five rock guesses in a row (about 0.06). Open sky plot, so the case needs the clock.
;; Should-succeed: by day a probe for the spot just behind the wall starts with a status whose tag is not :exposed (the spot reads lit, or at least worth a look).
;; Should-fail: at night the same probe's status is tagged :exposed (dark).
;; Needs time: run with --allow-time --time-log <the shared time log>.
{:defaults
 {:tags [:readiness :light]
  :plot {:height 8 :light :sky}
  :blocks [[:fill [10 0 12] [10 4 20] "stone"]]
  :body {:at [6.5 0 16.5] :settle-s 2}
  :limit-s 120}
 :cases
 [{:name "a-spot-behind-a-wall-by-day-is-looked-at-then-starts"
   :time :day :time-why :sunlit-ground
   :act [[:job (jobs.debug.ready-probe {:at #at [11 0 16] :stay-s 30})]]
   :expect [{:event {:source :job :kind :job.ready-probe} :within-s 90 :of-job true}
            {:no-event {:source :job :kind :job.ready-probe :data {:status [:has #{:exposed "exposed"}]}} :for-s 20 :of-job true}]}
  {:name "a-spot-behind-a-wall-at-night-reads-exposed"
   :time :night :time-why :night-light
   :act [[:job (jobs.debug.ready-probe {:at #at [11 0 16] :stay-s 30})]]
   :expect [{:event {:source :job :kind :job.ready-probe :data {:status [:has #{:exposed "exposed"}]}} :within-s 60 :of-job true}]
   :limit-s 100}]}
