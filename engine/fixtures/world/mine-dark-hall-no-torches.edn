;; Card 501dad7f: a dig beside the body in a wide dark hall is refused its dark (:exposed) when it hangs no torches, and goes ahead when
;; its own torches cost less than the exposure (ready/dark-near-ok, cost/dark-or-lit). Hall x 5..40, z 4..28, y 0..1, unlit; the body in a
;; 1-cell alcove at [4 0 16] facing west at iron ore in the wall [3 1 16]. Stone mass x 2..44, z 2..30, y 0..6.
;; Should-succeed: torches carried, the ore is dug. Should-fail: no torches and no gather in the call's ways, nothing is dug.
{:defaults
 {:tags [:mine :torch :jobs] :time :any
  :plot {:light :dark :height 12 :length 48 :width 34}
  :blocks [[:fill [2 0 2] [44 6 30] "stone"] [:fill [5 0 4] [40 1 28] "air"] [:fill [4 0 16] [4 1 16] "air"]
           [:set [3 1 16] "iron_ore"]]
  :body {:at [4.5 0 16.5] :yaw 90 :inventory [["stone_pickaxe" 1] ["cobblestone" 16]] :effects [["resistance" 600 4]]}
  :limit-s 120}
 :cases
 [{:name "torches-carried-dig-the-ore-beside-the-body"
   :body {:inventory [["stone_pickaxe" 1] ["cobblestone" 16] ["torch" 8]]}
   :act [[:job (jobs.gather.mine {:block "iron_ore" :level false :count 1 :radius 4 :mend false})]]
   :expect [{:event {:source :job :kind #{:completed :stopped} :data {:got #{1 2}}} :within-s 110 :of-job true}]
   :after [[:item "raw_iron" [:>= 1]]]}
  {:name "no-torches-no-gather-is-refused-the-dark"
   :act [[:job (jobs.gather.mine {:block "iron_ore" :level false :count 1 :radius 4 :mend false :ways #{:seen :carried}})]]
   :expect [{:event {:source :job :data {:reason :exposed}} :within-s 60 :of-job true}]
   :after [[:block [3 1 16] "iron_ore"] [:item "raw_iron" [:= 0]]]}]}
