;; go-to's quote (cards b34b1359, ee7d7b5e, 6a1a0fc3, 4b8bb3de): the dry run follows the body's fall policy like go-to.
;; A 5 high platform, the body on top, the goal on the floor past its edge, no other way down: feather falling IV finds the
;; 5 block drop (0.96 hp), plain boots do not (2 hp over :spend {:health 1.5}; the default budget at full health would pay it): found false. The body never moves.
{:defaults
 {:tags [:movement] :time :any
  :plot {:height 14}
  :blocks [[:fill [0 0 0] [31 9 0] "stone"] [:fill [0 0 31] [31 9 31] "stone"] [:fill [0 0 0] [0 9 31] "stone"] [:fill [31 0 0] [31 9 31] "stone"]
           [:fill [1 0 1] [15 4 30] "stone"]]
  :body {:at [8.5 5 16.5]}
  :limit-s 40}
 :cases
 [{:name "quote-finds-a-5-drop-with-feather-falling"
   :body {:at [8.5 5 16.5] :yaw 270} ; facing the edge: the planner takes cells it has not seen for open, so it must see the drop
   :act [[:rcon "item replace entity $BODY armor.feet with minecraft:diamond_boots[enchantments={feather_falling:4}]"] [:until [:cli "observe" ["$body" "--world" "$world" "equipment" "--raw"] {:equipment {:feet {:name "diamond_boots"}}}] 10]
         [:until [:cli "quote" ["$body" "--world" "$world" "jobs.movement.go-to" {:pos #at [22 0 16] :range 1 :spend {:health 1.5}}] {:ok true :quote {:route {:found true}}}] 30]]
   :expect [{:no-event {:level :error} :for-s 2}]
   :after [[:body-near [8.5 5 16.5] 1]]}
  {:name "quote-finds-no-5-drop-in-plain-boots"
   :act [[:rcon "item replace entity $BODY armor.feet with minecraft:diamond_boots"] [:until [:cli "observe" ["$body" "--world" "$world" "equipment" "--raw"] {:equipment {:feet {:name "diamond_boots"}}}] 10]
         [:cli "quote" ["$body" "--world" "$world" "jobs.movement.go-to" {:pos #at [22 0 16] :range 1 :spend {:health 1.5}}] {:ok true :quote {:route {:found false}}}]]
   :expect [{:no-event {:level :error} :for-s 2}]
   :after [[:body-near [8.5 5 16.5] 1]]}]}
