;; Card 7616f6fc: jobs.build.from-plan raises a temporary pillar (jobs.access.pillar, ledgered) to place wall rows no ground stand
;; reaches, with its base outside every footprint, and jobs.access.cleanup takes it back.
;; tall-wall-from-a-pillar: a 3 x 9 stone wall (y 0..8 at z 20; ground reaches y 5) is built complete and the pillar's dirt is back in the bag.
;; every-base-refused: another body's plan footprint (above the grass: its floor stays a stand) rings the wall to radius 5, so no pillar base is allowed: the rows in reach are
;; built, the rest is refused (the ending is :refused) and nothing is placed outside the wall.
;; wall-on-an-island-from-a-bridge-row: a 3 cell wall on a stone island (roofed, so no stand beside it) in a ravine 20 deep; the bank is 5 away,
;; out of reach, and no ground is in pillar range, so from-plan lays a bridge row from the bank, builds the wall and takes the row back.
;; roof-hole-of-a-sealed-room: the one missing roof cell of a closed stone room; the only ground stand lies inside the sealed room, so the place walk ends no path:
;; from-plan then stands the body on a pillar outside instead of giving the cell up.
{:defaults
 {:tags [:build :access :zones]
  :plot {:height 24 :floor "grass_block"}
  :plans [{:id "wall" :metadata {:by "$body"}
           :parts [{:id "w" :box [#at [15 0 20] #at [17 8 20]] :want "stone"}]}]
  :body {:at [16.5 0 12.5] :yaw 0 :inventory [["stone" 27] ["dirt" 8]] :effects [["resistance" 600 4]]}
  :limit-s 330}
 :cases
 [{:name "tall-wall-from-a-pillar"
   :act [[:job (jobs.build.from-plan {:plan "$plan:wall"})]]
   :expect [{:event {:source :job :kind :completed :data {:missing []}} :within-s 300 :of-job true}]
   :after [[:block [15 8 20] "stone"] [:block [17 8 20] "stone"] [:item "dirt" 8]]}
  {:name "every-base-refused"
   :plans [{:id "wall" :metadata {:by "$body"}
            :parts [{:id "w" :box [#at [15 0 20] #at [17 8 20]] :want "stone"}]}
           {:id "ring" :metadata {:by "SomeoneElse"}
            :parts [{:id "n" :box [#at [10 0 15] #at [22 1 19]] :want "dirt"}
                    {:id "s" :box [#at [10 0 21] #at [22 1 25]] :want "dirt"}
                    {:id "w" :box [#at [10 0 20] #at [14 1 20]] :want "dirt"}
                    {:id "e" :box [#at [18 0 20] #at [22 1 20]] :want "dirt"}]}]
   :act [[:job (jobs.build.from-plan {:plan "$plan:wall"})]]
   :expect [{:event {:source :job :kind :stopped :data {:reason :refused}} :within-s 120 :of-job true}]
   :after [[:block [16 5 20] "stone"] [:not-block [16 8 20] "stone"] [:item "dirt" 8]]
   :limit-s 150}
  {:name "long-wall-from-a-bridge-row"
   :plans [{:id "wall" :metadata {:by "$body"}
            :parts [{:id "w" :box [#at [10 0 20] #at [21 8 20]] :want "stone"}]}]
   :body {:at [11.5 0 12.5] :inventory [["stone" 108] ["dirt" 20]]}
   :act [[:job (jobs.build.from-plan {:plan "$plan:wall"})]]
   :expect [{:event {:source :job :kind :completed :data {:missing []}} :within-s 420 :of-job true}]
   :after [[:block [10 8 20] "stone"] [:block [21 8 20] "stone"] [:block [15 8 20] "stone"] [:item "dirt" 20]]
   :limit-s 450}
  {:name "roof-hole-of-a-sealed-room"
   :plans [{:id "roof" :metadata {:by "$body"}
            :parts [{:id "r" :box [#at [17 4 22] #at [17 4 22]] :want "stone"}]}]
   :blocks [[:fill [15 0 20] [19 4 24] "stone"]
            [:fill [16 1 21] [18 3 23] "air"]
            [:set [17 4 22] "air"]]
   :body {:at [16.5 0 14.5] :inventory [["stone" 4] ["dirt" 8]]}
   :act [[:job (jobs.build.from-plan {:plan "$plan:roof"})]]
   :expect [{:event {:source :job :kind :completed :data {:missing []}} :within-s 200 :of-job true}]
   :after [[:block [17 4 22] "stone"]]
   :limit-s 230}
  {:name "wall-on-an-island-from-a-bridge-row"
   :plans [{:id "wall" :metadata {:by "$body"}
            :parts [{:id "w" :box [#at [15 0 20] #at [17 0 20]] :want "stone"}]}]
   :blocks [[:fill [8 -20 16] [24 -1 25] "air"]
            [:fill [15 -1 20] [17 -1 20] "stone"]
            [:fill [15 1 20] [17 1 20] "stone"]]
   :body {:at [16.5 0 12.5] :inventory [["stone" 6] ["dirt" 10]]}
   :act [[:job (jobs.build.from-plan {:plan "$plan:wall"})]]
   :expect [{:event {:source :job :kind :completed :data {:missing []}} :within-s 240 :of-job true}]
   :after [[:block [15 0 20] "stone"] [:block [16 0 20] "stone"] [:block [17 0 20] "stone"]
           [:not-block [16 -1 16] "dirt"] [:not-block [16 -1 17] "dirt"] [:item "dirt" [:>= 6]]]
   :limit-s 270}]}
