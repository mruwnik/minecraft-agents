;; Cards bf6983ae (b3f7422e2, aa19c55a0): go-to's cave-dip rule: a body walking its level corridor to a ladder shaft (goal 18 above the corridor)
;; needs no stair and does not dive. The re-plan round a zombie on the walk is unit-tested (engine.go-to-depth-test): live it is not
;; repeatable (the lane is unseen from the corridor; the body fights, digs round or gives up by timing).
;; Stone mass x 2..61, y 0..29, z 2..29 (surface feet y 30). Corridor y 12..13 along z 16, x 4..60; ladder shaft at x 60 up to the surface;
;; lane z 18: a stair down from the corridor at x 30 to y 3 (x 31..39), level x 40..50, a stair up to the corridor at x 59.
{:defaults
 {:tags [:movement :go-to]
  :time :any
  :plot {:length 64 :height 31}
  :settings {:jobs.movement.go-to.tuning/climb-dip 8}
  :blocks [[:fill [2 0 2] [61 29 15] "stone"]
           [:fill [2 0 16] [61 29 29] "stone"]
           [:fill [4 12 16] [60 13 16] "air"]
           [:fill [60 14 16] [60 29 16] "air"]
           [:fill [60 12 16] [60 29 16] "ladder[facing=west]"]
           [:fill [30 12 17] [30 13 17] "air"] [:fill [30 12 18] [30 14 18] "air"]
           [:fill [31 11 18] [31 13 18] "air"]
           [:fill [32 10 18] [32 12 18] "air"]
           [:fill [33 9 18] [33 11 18] "air"]
           [:fill [34 8 18] [34 10 18] "air"]
           [:fill [35 7 18] [35 9 18] "air"]
           [:fill [36 6 18] [36 8 18] "air"]
           [:fill [37 5 18] [37 7 18] "air"]
           [:fill [38 4 18] [38 6 18] "air"]
           [:fill [39 3 18] [39 5 18] "air"]
           [:fill [40 3 18] [50 5 18] "air"]
           [:fill [51 4 18] [51 6 18] "air"]
           [:fill [52 5 18] [52 7 18] "air"]
           [:fill [53 6 18] [53 8 18] "air"]
