;; jobs.blocks.place on an occupied cell ends at once :occupied with the block name (card 91cf85a9); a free cell is
;; placed; a block in the head cell hurts as "suffocation".
{:defaults
 {:tags [:blocks :jobs]
  :body {:at [16.5 0 16.5] :inventory [["cobblestone" 8]]}
  :limit-s 40}
 :cases
 [{:name "occupied-stone"
   :blocks [[:set [18 0 16] "stone"]]
   :act [[:job (jobs.blocks.place {:pos #at [18 0 16] :item "cobblestone"})]]
   :expect [{:event {:source :job :kind :blocks.place.done :data {:placed false :reason :occupied :block "stone"}} :within-s 10 :of-job true}]
   :after [[:block [18 0 16] "stone"] [:item "cobblestone" 8]]}
  {:name "occupied-grass-block"
   :blocks [[:set [18 0 16] "grass_block"]]
   :act [[:job (jobs.blocks.place {:pos #at [18 0 16] :item "cobblestone"})]]
   :expect [{:event {:source :job :kind :blocks.place.done :data {:placed false :reason :occupied :block "grass_block"}} :within-s 10 :of-job true}]
   :after [[:block [18 0 16] "grass_block"] [:item "cobblestone" 8]]}
  {:name "occupied-oak-leaves"
   :blocks [[:set [18 0 16] "oak_leaves"]]
   :act [[:job (jobs.blocks.place {:pos #at [18 0 16] :item "cobblestone"})]]
   :expect [{:event {:source :job :kind :blocks.place.done :data {:placed false :reason :occupied :block "oak_leaves"}} :within-s 10 :of-job true}]
   :after [[:block [18 0 16] "oak_leaves"] [:item "cobblestone" 8]]}
  {:name "free-cell-a"
   :act [[:job (jobs.blocks.place {:pos #at [18 0 18] :item "cobblestone"})]]
   :expect [{:event {:source :job :kind :blocks.place.done :data {:placed true :reason :placed}} :within-s 30 :of-job true}]
   :after [[:block [18 0 18] "cobblestone"] [:item "cobblestone" 7]]}
  {:name "free-cell-b"
   :act [[:job (jobs.blocks.place {:pos #at [14 0 14] :item "cobblestone"})]]
   :expect [{:event {:source :job :kind :blocks.place.done :data {:placed true :reason :placed}} :within-s 30 :of-job true}]
   :after [[:block [14 0 14] "cobblestone"] [:item "cobblestone" 7]]}
  {:name "head-block-suffocation"
   :act [[:rcon "execute at $BODY run setblock ~ ~1 ~ stone"] [:wait-s 4] [:rcon "execute at $BODY run setblock ~ ~1 ~ air"]]
   :expect [{:event {:source :body :kind :hurt :data {:causes ["suffocation"]}} :within-s 15}]
   :after [[:block [16 1 16] "air"]]}]}
