;; items.get-tool with no block, item or kind ends impossible :bad-args; the :stopped event's cause names the missing arg.
{:defaults
 {:tags [:fetch :jobs]
  :time :any
  :plot {:height 12}
  :body {:at [16.5 0 16.5] :settle-s 3}
  :limit-s 40}
 :cases
 [{:name "no-args-a"
   :act [[:job (jobs.items.get-tool {})]]
   :expect [{:event {:source :job :kind :stopped :data {:status :stopped :kind :impossible :reason :bad-args :cause {:why [:contains ":block"]}}} :within-s 20 :of-job true}
            {:no-event {:source :job :kind :completed} :for-s 20 :until {:source :job :kind :stopped :data {:status :stopped :kind :impossible :reason :bad-args :cause {:why [:contains ":block"]}}}}]}]}
