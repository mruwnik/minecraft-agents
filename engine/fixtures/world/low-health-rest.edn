;; Card bcaa14c7: a body too hurt for risky work (under 6 hp when fed) rests until an hp is not worth its wait (15) (shut in, holding :healing, a bite of carried bread while food is
;; under 20) before its queued walk goes on. Food under 18 is got first (here bread lying near); short of blocks for the
;; walls it digs more (the dirt row at x 3). Should-fail: with no food anywhere the rest ends :no-food, the trigger does not
;; fire again within its retry time and the walk runs. On bedrock with no blocks the shut-in fails; a zombie seen in a glass box
;; then keeps the body from calm, and the rest goes for food at once instead of waiting in the open: bread in view is fetched and
;; the body heals where it stands (should-succeed); with none it ends :no-food (should-fail).
{:defaults
 {:tags [:survival :readiness]
  :time :any
  :plot {:height 8 :floor "stone" :light :lit}
  :register [{:trigger :low-health}]
  :body {:at [6.5 0 16.5]}
  :limit-s 200}
 :cases
 [{:name "hurt-fed-body-rests-before-its-walk"
   :body {:inventory [["dirt" 32] ["bread" 8]]}
   :act [[:rcon "damage $BODY 16 minecraft:generic"]
         [:job (jobs.movement.go-to {:pos #at [22 0 16] :range 1})]]
   :expect [{:event {:source :reflex :kind :fired :context {:reflex-id :low-health}} :within-s 10}
            {:no-event {:source :job :kind :rest.unsheltered} :for-s 30 :until {:source :reflex :kind :ended :context {:reflex-id :low-health}}}
            {:no-event {:source :job :kind :completed :data {:arrived true}} :for-s 120 :until {:source :reflex :kind :ended :context {:reflex-id :low-health}}}
            {:event {:source :reflex :kind :ended :context {:reflex-id :low-health} :data {:kind :done}} :within-s 150}
            {:event {:source :job :kind :completed :data {:arrived true}} :within-s 190 :of-job true}]
   :after [[:body-near [22.5 0 16.5] 2]]}
  {:name "hurt-fed-body-short-of-blocks-digs-more-then-shuts-in"
   :blocks [[:fill [3 0 14] [3 1 18] "dirt"]]
   :body {:inventory [["dirt" 16] ["bread" 8]]}
   :act [[:rcon "damage $BODY 16 minecraft:generic"]
         [:job (jobs.movement.go-to {:pos #at [22 0 16] :range 1})]]
   :expect [{:event {:source :reflex :kind :fired :context {:reflex-id :low-health}} :within-s 10}
            {:no-event {:source :job :kind :rest.unsheltered} :for-s 150 :until {:source :reflex :kind :ended :context {:reflex-id :low-health}}}
            {:event {:source :reflex :kind :ended :context {:reflex-id :low-health} :data {:kind :done}} :within-s 170}
            {:event {:source :job :kind :completed :data {:arrived true}} :within-s 210 :of-job true}]
   :after [[:body-near [22.5 0 16.5] 2]]
   :limit-s 230}
  {:name "hurt-hungry-body-picks-up-food-then-rests"
   :body {:inventory [["dirt" 32]] :effects [["hunger" 120 49]]}
   :act [[:until-rcon "data get entity $BODY foodLevel" "data: (1[0-7])$" 60]
         [:rcon "effect clear $BODY minecraft:hunger"]
         [:summon "item" [10.5 0 16.5] "{Item:{id:\"minecraft:bread\",count:8}}"]
         [:rcon "damage $BODY 15 minecraft:generic"]
         [:job (jobs.movement.go-to {:pos #at [22 0 16] :range 1})]]
   :expect [{:event {:source :reflex :kind :fired :context {:reflex-id :low-health}} :within-s 75}
            {:no-event {:source :job :kind :completed :data {:arrived true}} :for-s 180 :until {:source :reflex :kind :ended :context {:reflex-id :low-health}}}
            {:event {:source :reflex :kind :ended :context {:reflex-id :low-health} :data {:kind :done}} :within-s 230}
            {:event {:source :job :kind :completed :data {:arrived true}} :within-s 270 :of-job true}]
   :after [[:body-near [22.5 0 16.5] 2]]
   :limit-s 290}
  {:name "hurt-hungry-body-with-no-food-gives-up-and-walks-on"
   :time :day :time-why :dawn-decision :plot {:light :sky}
   :body {:inventory [["dirt" 32]] :effects [["hunger" 120 49]]}
   :act [[:until-rcon "data get entity $BODY foodLevel" "data: (1[0-7])$" 60]
         [:rcon "effect clear $BODY minecraft:hunger"]
         [:rcon "damage $BODY 15 minecraft:generic"]
         [:job (jobs.movement.go-to {:pos #at [22 0 16] :range 1})]]
   :expect [{:event {:source :reflex :kind :ended :context {:reflex-id :low-health} :data {:kind :nothing-possible}} :within-s 260}
            {:count-event {:source :reflex :kind :fired :context {:reflex-id :low-health}} :for-s 300 :at-most 1}
            {:event {:source :job :kind :completed :data {:arrived true}} :within-s 300 :of-job true}]
   :after [[:body-near [22.5 0 16.5] 2]]
   :limit-s 320}
  {:name "unsheltered-hurt-hungry-body-with-zombie-in-view-fetches-food-and-heals"
   :plot {:floor "bedrock"}
   :blocks [[:fill [15 -1 14] [19 3 18] "glass" :hollow]]
   :body {:inventory [] :effects [["hunger" 120 49]]}
   :act [[:summon "zombie" [17.5 0 16.5] "{NoAI:1b,equipment:{head:{id:\"minecraft:iron_helmet\",count:1}}}"]
         [:until-rcon "data get entity $BODY foodLevel" "data: (1[0-7])$" 60]
         [:rcon "effect clear $BODY minecraft:hunger"]
         [:summon "item" [6.5 0 10.5] "{Item:{id:\"minecraft:bread\",count:8}}"]
         [:rcon "damage $BODY 15 minecraft:generic"]]
   :expect [{:event {:source :reflex :kind :fired :context {:reflex-id :low-health}} :within-s 75}
            {:event {:source :job :kind :rest.unsheltered} :within-s 120}
            {:event {:source :reflex :kind :ended :context {:reflex-id :low-health} :data {:kind :done}} :within-s 230}]
   :after [[:entities "type=zombie,tag=wt" [[15 0 14] [19 3 18]] 1]]
   :limit-s 250}
  {:name "unsheltered-hurt-hungry-body-with-zombie-in-view-and-no-food-ends-no-food"
   :plot {:floor "bedrock"}
   :blocks [[:fill [15 -1 14] [19 3 18] "glass" :hollow]]
   :body {:inventory [] :effects [["hunger" 120 49]]}
   :act [[:summon "zombie" [17.5 0 16.5] "{NoAI:1b,equipment:{head:{id:\"minecraft:iron_helmet\",count:1}}}"]
         [:until-rcon "data get entity $BODY foodLevel" "data: (1[0-7])$" 60]
         [:rcon "effect clear $BODY minecraft:hunger"]
         [:rcon "damage $BODY 15 minecraft:generic"]]
   :expect [{:event {:source :job :kind :rest.unsheltered} :within-s 120}
            {:event {:source :reflex :kind :ended :context {:reflex-id :low-health} :data {:kind :nothing-possible}} :within-s 150}]
   :limit-s 170}]}
