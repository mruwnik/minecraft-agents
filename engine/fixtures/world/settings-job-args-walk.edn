;; Card dc655af5 (settings C2 65273969): the body's settings reach a call that leaves the arg out. Geometry of go-to-drop-budget: a stone block
;; y 0..9 under the body (feet y 10), the goal on the floor east of its edge: a drop of 10, which the default budget (7 hp at full health) allows.
;; Should-succeed: an explicit :floor {:health 1} beats the :engine.settings/job-args overlay of :floor {:health 14}.
;; Should-fail (unarrived, no drop taken): the overlay alone; the walk setting jobs.lib.walk.world/min-health 14 alone.
{:defaults
 {:tags [:movement :settings]
  :time :any
  :plot {:height 16}
  :blocks [[:fill [0 0 0] [31 12 0] "stone"] [:fill [0 0 31] [31 12 31] "stone"] [:fill [0 0 0] [0 12 31] "stone"] [:fill [31 0 0] [31 12 31] "stone"]
           [:fill [1 0 1] [15 9 30] "stone"]]
  :body {:at [8.5 10 16.5]}
  :limit-s 90}
 :cases
 [{:name "job-args-overlay-sets-the-floor-of-a-call-without-it"
   :settings {:engine.settings/job-args {jobs.movement.go-to {:floor {:health 14}}}}
   :act [[:job (jobs.movement.go-to {:pos #at [22 0 16] :range 1 :ways #{:walk :clear-seal}})]]
   :expect [{:event {:source :job :kind :result :data {:arrived false}} :within-s 60 :of-job true}
            {:no-event {:source :body :kind :hurt :data {:causes [:not ["suffocation"]]}} :for-s 60 :until {:source :job :kind :result}}]
   :after [[:body-far [22.5 0 16.5] 4]]}
  {:name "explicit-arg-beats-the-job-args-overlay"
   :settings {:engine.settings/job-args {jobs.movement.go-to {:floor {:health 14}}}}
   :act [[:job (jobs.movement.go-to {:pos #at [22 0 16] :range 1 :ways #{:walk :clear-seal} :floor {:health 1}})]]
   :expect [{:event {:source :job :kind :result :data {:arrived true}} :within-s 60 :of-job true}]
   :after [[:body-near [22.5 0 16.5] 2]]}
  {:name "walk-world-min-health-setting-sets-the-floor"
   :settings {:jobs.lib.walk.world/min-health 14}
   :act [[:job (jobs.movement.go-to {:pos #at [22 0 16] :range 1 :ways #{:walk :clear-seal}})]]
   :expect [{:event {:source :job :kind :result :data {:arrived false}} :within-s 60 :of-job true}
            {:no-event {:source :body :kind :hurt :data {:causes [:not ["suffocation"]]}} :for-s 60 :until {:source :job :kind :result}}]
   :after [[:body-far [22.5 0 16.5] 4]]}]}
