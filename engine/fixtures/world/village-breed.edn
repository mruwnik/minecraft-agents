;; jobs.village.breed (card bd3f06ad): feed two adult villagers (fixed UUIDs, NoAI so they stay) and count births.
;; Live-only facts: NoAI villagers may not breed (breeding needs AI and a free bed), so the births case may need AI villagers with beds built in the plot.
{:defaults
 {:tags [:village :jobs]
  :plot {:floor "grass_block"}
  :body {:at [10.5 0 16.5] :yaw 270 :inventory [["bread" 8]]}
  :limit-s 240}
 :cases
 [;; should succeed: target already met by the villagers in sight, so the call ends done :already and nothing is fed
  {:name "met-target-feeds-nothing"
   :act [[:summon "villager" [16.5 0 16.5] "{NoAI:1b,UUID:[I;20264,7,1,1]}"]
         [:summon "villager" [16.5 0 18.5] "{NoAI:1b,UUID:[I;20264,7,1,2]}"]
         [:job (jobs.village.breed {:target 2})]]
   :expect [{:event {:source :job :kind :completed :data {:kind :done :cause :already}} :within-s 30 :of-job true}]
   :after [[:item "bread" 8]]}
  ;; should succeed: two fed adults make a child (needs AI villagers, CanPickUpLoot:1b so they take the bread; each claims a bed and the child needs a third, free one)
  {:name "pair-with-beds-breeds"
   :time :day :time-why :villager-schedule
   :body {:inventory [["bread" 16]]}
   :blocks [[:set [14 0 14] "red_bed[part=foot,facing=north]"] [:set [14 0 13] "red_bed[part=head,facing=north]"] [:set [18 0 14] "red_bed[part=foot,facing=north]"] [:set [18 0 13] "red_bed[part=head,facing=north]"] [:set [22 0 14] "red_bed[part=foot,facing=north]"] [:set [22 0 13] "red_bed[part=head,facing=north]"]]
   :act [[:summon "villager" [16.5 0 16.5] "{CanPickUpLoot:1b,UUID:[I;20264,7,2,1]}"]
         [:summon "villager" [16.5 0 18.5] "{CanPickUpLoot:1b,UUID:[I;20264,7,2,2]}"]
         [:job (jobs.village.breed {:target 3 :settings {:jobs.village.breed/wait-s 60}})]]
   :limit-s 330
   :expect [{:event {:source :job :kind :completed} :within-s 300 :of-job true}]}
  ;; should fail: a single adult has nobody to pair with; a start condition: the call queued by the agent stays listed and waits on :no-pair
  {:name "one-adult-is-no-pair"
   :act [[:summon "villager" [16.5 0 16.5] "{NoAI:1b,UUID:[I;20264,7,3,1]}"]
         [:job (jobs.village.breed {:target 3})]]
   :expect [{:event {:source :job :kind :waiting :data {:reason :no-pair}} :within-s 30 :of-job true}]
   :after [[:item "bread" 8]]}
  ;; should fail: NoAI villagers never breed, so the attempt ends without a birth; no bed is in sight, so the three carried beds are put down first
  {:name "noai-pair-no-births"
   :body {:inventory [["bread" 8] ["red_bed" 3]]}
   :act [[:summon "villager" [16.5 0 16.5] "{NoAI:1b,UUID:[I;20264,7,4,1]}"]
         [:summon "villager" [16.5 0 18.5] "{NoAI:1b,UUID:[I;20264,7,4,2]}"]
         [:job (jobs.village.breed {:target 3 :settings {:jobs.village.breed/wait-s 20}})]]
   :expect [{:event {:source :job :kind :stopped :data {:reason :no-births}} :within-s 200 :of-job true}]}
  ;; should fail: two villagers and no free bed in sight, none carried, no fetch: a start condition, the call waits on :no-bed
  {:name "no-free-bed-waits"
   :body {:inventory [["bread" 8]]}
   :act [[:summon "villager" [16.5 0 16.5] "{NoAI:1b,UUID:[I;20264,7,5,1]}"]
         [:summon "villager" [16.5 0 18.5] "{NoAI:1b,UUID:[I;20264,7,5,2]}"]
         [:job (jobs.village.breed {:target 3 :ways #{:carried}})]]
   :expect [{:event {:source :job :kind :waiting :data {:reason :no-bed}} :within-s 30 :of-job true}]}]}
