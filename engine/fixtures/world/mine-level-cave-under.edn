;; jobs.gather.mine, a tunnel at the start height east (:level false) with a cave cell two under its second cell
;; ([18 -2 16], under the floor): a level step does not judge the cell under its floor, so the tunnel runs its length
;; and the run does not turn (no :cave-below stop).
;; Stone mass x 2..30, z 8..24, y -6..6; body in a 1x2 cell at [16 0 16] facing east.
{:defaults
 {:tags [:mine :jobs] :time :any
  :plot {:height 12}
  :blocks [[:fill [2 -6 8] [30 6 24] "stone"] [:fill [16 0 16] [16 1 16] "air"] [:set [18 -2 16] "air"]]
  :body {:at [16.5 0 16.5] :inventory [["stone_pickaxe" 1]] :effects [["resistance" 600 4]]}
  :act [[:job (jobs.gather.mine {:block "iron_ore" :level false :count 1 :direction :east :tunnel-length 4})]]
  :limit-s 110}
 :cases
 [{:name "cave-two-under-the-tunnel-floor-is-no-stop"
   :expect [{:event {:source :job :kind :mine.tunnel-end :data {:reason :tunnel-length}} :within-s 90 :of-job true}
            {:no-event {:source :job :kind :mine.turned} :for-s 90 :of-job true
             :until {:source :job :kind #{:completed :stopped}}}
            {:no-event {:source :job :kind :mine.tunnel-end :data {:reason :cave-below}} :for-s 90 :of-job true
             :until {:source :job :kind #{:completed :stopped}}}]
   :after [[:block [18 -2 16] "air"] [:not-block [20 0 16] "stone"]]}
  ;; card 3e9ab9fc: the strip tunnel meets a floor gap (the floor cells under [18 0 16] and [19 0 16] are air over the cave): with a
  ;; building block carried it bridges the gap and runs on; with none (and nothing mined to carry) it ends :no-floor, the gap left open
  {:name "floor-gap-is-bridged-with-a-carried-block"
   :blocks [[:fill [18 -1 16] [19 -1 16] "air"]]
   :body {:inventory [["stone_pickaxe" 1] ["cobblestone" 8]]}
   :expect [{:event {:source :job :kind :mine.tunnel-end :data {:reason :tunnel-length}} :within-s 100 :of-job true}
            {:no-event {:source :job :kind :mine.tunnel-end :data {:reason :no-floor}} :for-s 100 :until {:source :job :kind :mine.tunnel-end}}]
   :after [[:block [18 -1 16] "cobblestone"] [:not-block [20 0 16] "stone"]]}
  ;; the tunnel's own cells are glass (drops nothing): mined stone would drop cobblestone, which the tunnel bridges with
  {:name "floor-gap-with-no-block-ends-no-floor"
   :blocks [[:fill [17 0 16] [21 1 16] "glass"] [:fill [18 -1 16] [19 -1 16] "air"]]
   :expect [{:event {:source :job :kind :mine.tunnel-end :data {:reason :no-floor}} :within-s 100 :of-job true}]
   :after [[:block [18 -1 16] "air"]]}]}
