;; Card 45038295 (items.obtain :craft source, jobs.items.recipes). Flat open plot, nothing to gather. A table the body
;; has seen stands 2 east of it in the "seen-table" cases (the body looks east, yaw 270).
{:defaults
 {:tags [:fetch :crafting]
  :time :any
  :plot {:height 12}
  :body {:at [16.5 0 16.5] :settle-s 3}
  :act [[:rcon "kill @e[type=item,$BOX]"]]
  :limit-s 90}
 :cases
 [{:name "logs-make-pick-and-table"
   :body {:inventory [["oak_log" 12]]}
   :act [[:job (jobs.items.get-tool {:kind "pickaxe"})]]
   :expect [{:event {:source :job :kind :completed} :within-s 60 :of-job true}]
   :after [[:item "wooden_pickaxe" 1] [:item "crafting_table" 0]
           [:entities "type=item" [[0 -1 0] [32 5 32]] 0]]}
  {:name "logs-make-pick-and-table-stone-pick-name"
   :body {:inventory [["oak_log" 12]]}
   :act [[:job (jobs.items.get-tool {:item "wooden_pickaxe"})]]
   :expect [{:event {:source :job :kind :completed} :within-s 60 :of-job true}]
   :after [[:item "wooden_pickaxe" 1]]}
  {:name "seen-table-planks-sticks"
   :blocks [[:set [19 0 16] "crafting_table"]]
   :body {:inventory [["oak_planks" 3] ["stick" 2]]}
   :act [[:rcon "execute as $BODY at @s run tp @s ~ ~ ~ 270 0"] [:wait-s 2]
         [:job (jobs.items.get-tool {:kind "pickaxe"})]]
   :expect [{:event {:source :job :kind :completed} :within-s 60 :of-job true}]
   :after [[:item "wooden_pickaxe" 1] [:item "crafting_table" 0] [:item "oak_planks" 0] [:item "stick" 0]]}
  {:name "seen-table-logs-no-second-table"
   :blocks [[:set [19 0 16] "crafting_table"]]
   :body {:inventory [["oak_log" 2]]}
   :act [[:rcon "execute as $BODY at @s run tp @s ~ ~ ~ 270 0"] [:wait-s 2]
         [:job (jobs.items.get-tool {:kind "pickaxe"})]]
   :expect [{:event {:source :job :kind :completed} :within-s 60 :of-job true}]
   :after [[:item "wooden_pickaxe" 1] [:item "crafting_table" 0]]}
  {:name "dig-fetch-from-logs"
   :blocks [[:set [18 0 19] "stone"]]
   :body {:inventory [["oak_log" 12]]}
   :act [[:job (jobs.blocks.dig {:pos #at [18 0 19] :fetch true})]]
   :expect [{:event {:source :job :kind :completed} :within-s 80 :of-job true}]
   :after [[:block [18 0 19] "air"] [:item "wooden_pickaxe" 1] [:item "cobblestone" 1]]}
  {:name "only-dirt-waits-no-source"
   :body {:inventory [["dirt" 20]]}
   :act [[:job (jobs.items.get-tool {:kind "pickaxe"})]]
   :expect [{:event {:source :job :kind :waiting :data {:reason :no-source :why [:contains "no seen chest"]}} :within-s 20 :of-job true}
            {:no-event {:source :job :kind :completed} :for-s 20 :until {:source :job :kind :waiting :data {:reason :no-source :why [:contains "no seen chest"]}}}]
   :after [[:item "wooden_pickaxe" 0] [:item "dirt" 20]]}
  {:name "only-dirt-pick-by-item"
   :body {:inventory [["dirt" 5]]}
   :act [[:job (jobs.items.get-tool {:item "wooden_pickaxe"})]]
   :expect [{:event {:source :job :kind :waiting :data {:reason :no-source :why [:contains "no seen chest"]}} :within-s 20 :of-job true}
            {:no-event {:source :job :kind :completed} :for-s 20 :until {:source :job :kind :waiting :data {:reason :no-source :why [:contains "no seen chest"]}}}]
   :after [[:item "wooden_pickaxe" 0]]}
  {:name "two-logs-no-source"
   :body {:inventory [["oak_log" 2]]}
   :act [[:job (jobs.items.get-tool {:kind "pickaxe"})]]
   :expect [{:event {:source :job :kind :waiting :data {:reason :no-source :why [:contains "no seen chest"]}} :within-s 40 :of-job true}
            {:no-event {:source :job :kind :completed} :for-s 40 :until {:source :job :kind :waiting :data {:reason :no-source :why [:contains "no seen chest"]}}}]
   :after [[:item "wooden_pickaxe" 0]]}
  {:name "stone-pick-no-cobble"
   ;; dirt over bedrock: the chain crafts a wooden pickaxe, gather's stair finds no stone (mine.no-stone-found) three times
   ;; and the job ends :stopped :no-source; stone anywhere in view would be mined for cobblestone instead (fetch by default)
   :plot {:height 12 :floor "dirt"}
   :blocks [[:fill [0 -2 0] [32 -2 32] "bedrock"]]
   :body {:inventory [["oak_log" 12] ["stick" 4]]}
   :act [[:job (jobs.items.get-tool {:item "stone_pickaxe"})]]
   :limit-s 150
   :expect [{:event {:source :job :level :warn :kind :stopped :data {:reason :no-source}} :within-s 140 :of-job true}]
   :after [[:item "stone_pickaxe" 0]]},
  {:name "deepslate-cave-stone-pick"
   ;; card fd6e381b: no stone seen, deepslate seen: the stone pickaxe is made from cobbled_deepslate
   :blocks [[:fill [20 0 15] [24 3 17] "deepslate"]]
   :body {:inventory [["wooden_pickaxe" 1] ["stick" 4] ["oak_planks" 8]]}
   :act [[:rcon "execute as $BODY at @s run tp @s ~ ~ ~ 270 0"] [:wait-s 2]
         [:job (jobs.items.get-tool {:item "stone_pickaxe"})]]
   :limit-s 150
   :expect [{:event {:source :job :kind :completed} :within-s 140 :of-job true}]
   :after [[:item "stone_pickaxe" 1]]}
  {:name "stone-and-deepslate-mines-stone"
   ;; card fd6e381b: with both seen the commonest material, cobblestone, is mined
   :blocks [[:fill [20 0 15] [22 3 17] "stone"] [:fill [24 0 15] [26 3 17] "deepslate"]]
   :body {:inventory [["wooden_pickaxe" 1] ["stick" 4] ["oak_planks" 8]]}
   :act [[:rcon "execute as $BODY at @s run tp @s ~ ~ ~ 270 0"] [:wait-s 2]
         [:job (jobs.items.get-tool {:item "stone_pickaxe"})]]
   :limit-s 150
   :expect [{:event {:source :job :kind :completed} :within-s 140 :of-job true}]
   :after [[:item "stone_pickaxe" 1] [:item "cobbled_deepslate" 0]]}
  {:name "no-material-seen-waits-no-source"
   ;; card fd6e381b should-fail: no cobblestone/deepslate/blackstone seen: waits :no-source naming cobblestone
   :body {:inventory [["wooden_pickaxe" 1] ["stick" 4] ["oak_planks" 8]]}
   :act [[:job (jobs.items.get-tool {:item "stone_pickaxe"})]]
   :expect [{:event {:source :job :kind :waiting :data {:reason :no-source :why [:contains "cobblestone"]}} :within-s 30 :of-job true}
            {:no-event {:source :job :kind :completed} :for-s 20 :until {:source :job :kind :waiting :data {:reason :no-source}}}]
   :after [[:item "stone_pickaxe" 0]]}]}
