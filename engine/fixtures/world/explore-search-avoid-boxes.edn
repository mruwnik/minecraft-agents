;; Card 5f990d4e: jobs.explore.search :avoid-boxes [[x z] [x z]] corners (a pen is one box, not 91 columns): blocks in the box do not
;; count as found; entities are not filtered by it. Two emerald blocks, one inside the box x 14..20, z 14..20 at [18 0 18] and one
;; outside it at [16 0 28], both within :scan-radius of the body at [16.5 0 24.5]; a cow stands inside the box.
;; Should-succeed: :count 2 with no box finds both; a cow inside the box is still found. Should-fail: :count 2 with the box finds only one,
;; so the search ends stopped (nothing more within its small reach).
{:defaults
 {:tags [:explore :search]
  :plot {:height 8 :floor "stone"}
  :blocks [[:set [18 0 18] "emerald_block"] [:set [16 0 28] "emerald_block"]]
  :body {:at [16.5 0 24.5] :settle-s 2 :effects [["resistance" 600 4]]}
  :limit-s 70}
 :cases
 [{:name "without-a-box-both-emeralds-count"
   :act [[:job (jobs.explore.search {:target "emerald_block" :count 2 :scan-radius 16 :max-distance 8 :spacing 8 :settings {:jobs.explore.search/max-legs 2} :use-notes false})]]
   :expect [{:event {:source :job :kind :completed :data {:reason :found}} :within-s 60 :of-job true}]}
  {:name "the-emerald-inside-the-box-does-not-count"
   :act [[:job (jobs.explore.search {:target "emerald_block" :count 2 :scan-radius 16 :max-distance 8 :spacing 8 :settings {:jobs.explore.search/max-legs 2} :use-notes false
                                     :avoid-boxes [[#at [14 14] #at [20 20]]]})]]
   :expect [{:event {:source :job :kind :stopped} :within-s 60 :of-job true}
            {:no-event {:source :job :kind :completed} :for-s 60 :of-job true :until {:source :job :kind :stopped}}]}
  {:name "a-cow-inside-the-box-is-still-found"
   :act [[:summon "cow" [17.5 0 17.5] "{NoAI:1b}"]
         [:job (jobs.explore.search {:target "cow" :scan-radius 16 :max-distance 8 :spacing 8 :settings {:jobs.explore.search/max-legs 2} :use-notes false
                                     :avoid-boxes [[#at [14 14] #at [20 20]]]})]]
   :expect [{:event {:source :job :kind :completed :data {:reason :found}} :within-s 60 :of-job true}]}]}
