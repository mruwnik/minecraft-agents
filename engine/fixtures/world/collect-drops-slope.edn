;; Card 2329b1bb: a drop 2 or more blocks below the feet on seen open ground is walked to (go-to prices the fall), not left
;; :too-deep; only an item in a hole the caller dug (:holes) keeps the strict one-block rule. High platform x 8..14 (top cell y 2,
;; the body at y 3); the drop lies on the ground at (22 0 16), 3 below the feet, far enough past the slope's last step (17..18,
;; top y 1) that the line from the eye clears it (at 20 it was hidden, and nothing seen was left to collect).
{:defaults
 {:tags [:forestry :collect-drops :movement]
  :time :any
  :plot {:height 12}
  :blocks [[:fill [8 0 8] [14 2 24] "stone"]]
  :body {:at [12.5 3 16.5] :effects [["resistance" 600 4]]}
  :limit-s 90}
 :cases
 [{:name "drop-3-down-a-slope-collected"
   :blocks [[:fill [15 0 8] [16 1 24] "stone"] [:fill [17 0 8] [18 0 24] "stone"]]
   :act [[:summon "item" [22.5 0 16.5] "{Item:{id:\"minecraft:cobblestone\",count:1}}"]
         [:job (jobs.items.collect-drops {:radius 12})]]
   :expect [{:event {:source :job :kind :completed :data {:status :completed}} :within-s 80 :of-job true}
            {:no-event {:source :job :level :debug :kind :collect-drops.left} :for-s 60 :until {:source :job :kind :completed}}]
   :after [[:item "cobblestone" 1]]}
  {:name "drop-3-down-a-cliff-collected"
   :act [[:summon "item" [20.5 0 16.5] "{Item:{id:\"minecraft:cobblestone\",count:1}}"]
         [:job (jobs.items.collect-drops {:radius 12})]]
   :expect [{:event {:source :job :kind :completed :data {:status :completed}} :within-s 80 :of-job true}]
   :after [[:item "cobblestone" 1]]}
  ;; should stay: the same drop named as lying in a dug hole is 3 down, so it is left
  {:name "drop-in-a-dug-hole-3-down-left"
   :act [[:summon "item" [20.5 0 16.5] "{Item:{id:\"minecraft:cobblestone\",count:1}}"]
         [:job (jobs.items.collect-drops {:radius 12 :holes [#at [20 0 16]]})]]
   :expect [{:event {:source :job :level :debug :kind :collect-drops.left :data {:reason :too-deep}} :within-s 60 :of-job true}]
   :after [[:item "cobblestone" 0] [:body-far [20.5 0 16.5] 3]]}]}
