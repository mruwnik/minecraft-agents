;; Card cbc5e195. Stone mass x 8..24, z 8..24, y 0..9; the body stands on top (feet y 10). Without a pickaxe
;; jobs.access.tunnel's stair child declines (:no-tool). As the manual root the tunnel stops condition-failed :no-tool and
;; runs no more rounds (a listed job would park instead). Round counts are judged by :round numbers of the job's own events.
{:defaults
 {:tags [:access :mining]
  :plot {:height 20}
  :blocks [[:fill [8 0 8] [24 9 24] "stone"]]
  :body {:at [16.5 10 16.5] :effects [["resistance" 600 4]]}}
 :cases
 [{:name "tunnel-no-pickaxe-stops-no-tool"
   :body {:inventory [["torch" 8] ["cobblestone" 8]]}
   :act [[:job (jobs.access.tunnel {:target #at [16 6 20] :max-length 12 :keep true :by-hand false})]
         [:await {:source :job :kind :stopped :data {:kind :condition-failed :reason :no-tool}} 40]]
   :expect [{:event {:source :job :kind :stopped :data {:kind :condition-failed :reason :no-tool}} :within-s 40 :of-job true}
            {:no-event {:source :job :kind :round_started :round [:> 6]} :for-s 20 :of-job true}
            {:no-event {:source :job :kind :tunnel.done} :for-s 20 :of-job true}]
   :limit-s 70}
  ;; leave-tunnel inside a tunnel whose stair is filled: the walk to the entry fails, the way out is its own stair up
  ;; (the escape), which declines without a pickaxe (:no-tool; :fetch false, as a failed fetch digs by hand); the job (run as the manual root) stops condition-failed :no-tool.
  {:name "leave-tunnel-no-pickaxe-stops-no-tool"
   :blocks [[:fill [12 9 20] [16 7 20] "air"] [:fill [13 8 20] [15 6 20] "air"] [:fill [12 10 20] [16 8 20] "air"]
            [:fill [13 8 20] [13 9 20] "stone"]]
   :body {:at [15.5 6 20.5] :inventory [["cobblestone" 4]]}
   :act [[:job (jobs.access.leave-tunnel {:fetch false :tunnel {:line {:entry #at [11 10 20] :heading :east :dir :down :steps 4 :run 0
                                                          :stand #at [15 6 20] :target #at [16 6 20]}
                                                   :dug [{:cell #at [12 9 20] :block "stone"} {:cell #at [13 9 20] :block "stone"}
                                                         {:cell #at [13 8 20] :block "stone"} {:cell #at [14 9 20] :block "stone"}
                                                         {:cell #at [14 8 20] :block "stone"} {:cell #at [14 7 20] :block "stone"}
                                                         {:cell #at [15 8 20] :block "stone"} {:cell #at [15 7 20] :block "stone"}
                                                         {:cell #at [15 6 20] :block "stone"}]
                                                   :torches []}})]
         [:await {:source :job :kind :stopped :data {:kind :condition-failed :reason :no-tool}} 90]]
   :expect [{:event {:source :job :kind :stopped :data {:kind :condition-failed :reason :no-tool}} :within-s 90 :of-job true}
            {:no-event {:source :job :kind :round_started :round [:> 8]} :for-s 20 :of-job true}
            {:no-event {:source :job :kind :leave-tunnel.escape} :for-s 20 :of-job true}]
   :limit-s 120}
  ;; the control: a toggle that can never succeed is NOT parked for ever; its own decline ends the herd (:gate-stuck: the cow is in the pen, the body cannot get out; a few
  ;; rounds). Once the cow is released inside the pen the gate is swapped for a closed iron door, which ignores a hand (toggle
  ;; :needs-redstone); swapped earlier it hid the cow behind it and the herd ended :lost before any toggle.
  {:name "herd-stuck-gate-ends-through-its-own-give-up"
   :tags [:herd :animals]
   :plot {:floor "grass_block" :height 16}
   :blocks [[:fill [8 0 8] [24 9 24] "air"]
            [:fill [18 0 13] [24 0 19] "oak_fence"] [:fill [19 0 14] [23 0 18] "air"]
            [:set [18 0 16] "oak_fence_gate[facing=east,open=false]"]]
   :body {:at [12.5 0 16.5] :inventory [["lead" 4]]}
   :act [[:summon "cow" [10.5 0 18.5]]
         [:job (jobs.animals.herd {:mob "cow" :box {:min #xyz [19 0 14] :max #xyz [23 0 18]} :target 1})]
         [:await {:source :job :kind :child_ended :data {:slot :unleash}} 90]
         [:rcon "execute positioned $X $Y $Z run setblock ~18 ~ ~16 iron_door[facing=east,half=lower,open=false]"]
         [:rcon "execute positioned $X $Y $Z run setblock ~18 ~1 ~16 iron_door[facing=east,half=upper,open=false]"]]
   :expect [{:event {:source :job :kind :completed :data {:reason :gate-stuck :inside 1}} :within-s 120 :of-job true}
            {:no-event {:source :job :kind :round_started :round [:> 20]} :for-s 120 :until {:source :job :kind :completed} :of-job true}]
   :limit-s 140}]}
