;; Card 7ca8a28b: an armed, unarmoured body cornered by melee mobs it cannot outfight pillars up when a second of pillar
;; costs fewer blows than the fight; one zombie it beats is still fought. A 1-wide slot open to the sky (stone walls
;; 2 high, z 15 and 17, closed at x 9), the body at its end with a wooden axe and dirt, active helmeted zombies along it.
;; Should-succeed: four zombies, a pillar, no death. Should-fail (no pillar): one zombie, fought and killed.
{:defaults
 {:tags [:hostile :survival :cornered]
  :time :any
  :plot {:height 16}
  :register [{:trigger :hostile-near}]
  :blocks [[:fill [9 0 15] [17 1 15] "stone"] [:fill [9 0 17] [17 1 17] "stone"] [:fill [9 0 16] [9 1 16] "stone"]]
  :body {:at [10.5 0 16.5] :inventory [["wooden_axe" 1] ["dirt" 20]]}
  :limit-s 70}
 :cases
 [{:name "four-zombies-it-cannot-beat-are-pillared-from"
   :act [[:summon "zombie" [12.5 0 16.5] "{equipment:{head:{id:\"minecraft:iron_helmet\",count:1}}}"]
         [:summon "zombie" [13.5 0 16.5] "{equipment:{head:{id:\"minecraft:iron_helmet\",count:1}}}"]
         [:summon "zombie" [14.5 0 16.5] "{equipment:{head:{id:\"minecraft:iron_helmet\",count:1}}}"]
         [:summon "zombie" [15.5 0 16.5] "{equipment:{head:{id:\"minecraft:iron_helmet\",count:1}}}"]]
   :expect [{:event {:source :job :kind :child_ended :data {:slot :pillar :status :done}} :within-s 40}
            {:no-event {:source :body :kind :died} :for-s 45}]}
  {:name "one-zombie-it-beats-is-fought"
   :act [[:summon "zombie" [12.5 0 16.5] "{equipment:{head:{id:\"minecraft:iron_helmet\",count:1}}}"]]
   :expect [{:no-event {:source :job :kind :child_ended :data {:slot :pillar :status :done}} :for-s 40}]
   :after [[:entities "type=zombie,tag=wt" [[2 0 10] [30 4 22]] 0]]}]}
