;; Card 8a148153: crops the body cut and replanted in another's field (harvest with :ignore-zones?) are cells its own replant already
;; restored: restore-broken lists them in its :cells and ends without :not-restored.
;; Two ripe carrot cells in a field of another's zone and plan; the body carries 5 carrots.
;; Should-succeed: harvest cuts and replants 2, restore-broken then restores both. Should-fail: no tidy.not-restored.
;; Unsure (60%): that harvest books its zone digs in the tidy ledger the way the unit test fakes it.
{:defaults
 {:tags [:farm :harvest :tidy :restore-broken :jobs]
  :time :any
  :body {:at [10.5 0 14.5] :effects [["resistance" 600 4]]}
  :limit-s 150}
 :cases
 [{:name "replanted-cells-count-as-restored"
   :blocks [[:fill [10 -1 16] [11 -1 16] "farmland[moisture=7]"] [:fill [10 -2 17] [11 -2 17] "stone"] [:fill [10 -1 17] [11 -1 17] "water"]
            [:set [10 0 16] "carrots[age=7]"] [:set [11 0 16] "carrots[age=7]"]]
   :zones [{:name "yard" :min [8 -2 14] :max [14 4 19] :owner "Other" :allow #{}}]
   :plans [{:id "field" :metadata {:by "Other"}
            :parts [{:id "row" :box [#at [10 0 16] #at [11 0 16]] :want {:crop "carrots"}}]}]
   :body {:inventory [["carrot" 5] ["stone_pickaxe" 1]]}
   :act [[:job (jobs.farm.harvest {:area {:plan "$plan:field"} :ignore-zones? true})]
         [:await {:source :job :kind #{:completed :stopped} :data {:cut 2 :replanted 2}} 80]
         [:job (jobs.survival.restore-broken {})]]
   :expect [{:event {:source :job :kind #{:completed :stopped} :data {:cut 2 :replanted 2}} :within-s 80}
            {:event {:source :job :kind :completed :data {:cells [:any]}} :within-s 130}
            {:no-event {:source :job :kind :stopped :data {:not-restored [:any]}} :for-s 120 :until {:source :job :kind :completed :data {:cells [:any]}}}]
   :after [[:block [10 0 16] "carrots[age=0]"] [:block [11 0 16] "carrots[age=0]"]]}]}
