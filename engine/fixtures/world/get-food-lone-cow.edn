;; Card fe000369: a single wild cow is no breeding pair, so a hungry body with nothing to eat hunts it (get-food-last-pair.edn: two are kept).
;; Hunger is drained by RCON (food 9-10), hp 15; only a sword.
{:defaults
 {:tags [:survival :get-food :animals]
  :plot {:height 6}
  :body {:at [4.5 0 16.5] :inventory [["iron_sword" 1]] :settle-s 2}
  :limit-s 100}
 :cases
 [{:name "a-lone-cow-is-hunted"
   :time :any
   :act [[:rcon "effect give $BODY minecraft:hunger 5 243 true"] [:until-effect-gone "hunger" 30]
         [:rcon "damage $BODY 5 minecraft:generic"]
         [:summon "cow" [24.5 0 24.5] "{NoAI:1b}"]
         [:job (jobs.survival.get-food {})]]
   :expect [{:event {:source :job :kind :food.killed} :within-s 90}]}]}
