;; Card 650aad09: jobs.farm.tend in plan mode replants the cell it just harvested even below the food reserve (harvest :replant true,
;; :replant-bare false); cells that were already bare stay unsown below the reserve (20 carrots = 60 points; 12 carried plus the drops
;; of one plant stay under it). Plan row: 4 carrot cells [10..13 0 16] on farmland at y -1 (water beside), only [10 0 16] is ripe.
;; Floor y -1 is the ground layer; no hoe, so the till step is skipped.
;; Should-succeed: the ripe cell is cut and replanted (carrots[age=0]), harvest summary cut 1 replanted 1. Should-fail (control): the three
;; bare cells stay bare below the reserve. Card b969dd9c: with a log and leaves on two cells, tend reports them blocked and sows the other two.
{:defaults
 {:tags [:farm :tend :food-reserve :jobs]
  :time :any
  :blocks [[:fill [10 -1 16] [13 -1 16] "farmland[moisture=7]"] [:fill [10 -2 17] [13 -2 17] "stone"] [:fill [10 -1 17] [13 -1 17] "water"]
           [:set [10 0 16] "carrots[age=7]"]]
  :plans [{:id "field" :metadata {:by "$body"}
           :parts [{:id "row" :box [#at [10 0 16] #at [13 0 16]] :want {:crop "carrots"}}]}]
  :body {:at [10.5 0 14.5] :effects [["resistance" 600 4]] :inventory [["carrot" 12]]}
  :limit-s 120}
 :cases
 [{:name "just-harvested-cell-replanted-below-the-reserve"
   :act [[:job (jobs.farm.tend {:area {:plan "$plan:field"}})]]
   :expect [{:event {:source :job :kind #{:completed :stopped} :data {:steps {:harvest {:cut 1 :replanted 1}}}} :within-s 100 :of-job true}]
   :after [[:block [10 0 16] "carrots[age=0]"] [:block [11 0 16] "air"] [:block [12 0 16] "air"] [:block [13 0 16] "air"]]}
  ;; a tree standing on crop cells is reported (:field :blocked) while the free cells are sown; tend never digs it
  {:name "crop-cells-filled-by-a-tree-are-reported-blocked-and-the-rest-sown"
   :blocks [[:set [10 0 16] "oak_log"] [:set [11 0 16] "oak_leaves"]]
   :body {:inventory [["carrot" 40]]}
   :act [[:job (jobs.farm.tend {:area {:plan "$plan:field"}})]]
   :expect [{:event {:source :job :kind #{:completed :stopped} :data {:steps {:plant {:planted 2}} :field {:blocked [:any]}}} :within-s 100 :of-job true}]
   :after [[:block [10 0 16] "oak_log"] [:block [11 0 16] "oak_leaves"] [:block [12 0 16] "carrots[age=0]"] [:block [13 0 16] "carrots[age=0]"]]}
  ;; maintain clears a tree standing on its own plan cells itself (a tidy step), then sows them
  {:name "maintain-clears-a-tree-on-its-crop-cells-then-sows-them"
   :blocks [[:set [10 0 16] "oak_log"] [:set [11 0 16] "oak_leaves"]]
   :body {:inventory [["carrot" 40] ["stone_hoe" 1]]}
   :act [[:job (jobs.farm.maintain {:area {:plan "$plan:field"} :irrigate false})]]
   :expect [{:event {:source :job :kind #{:completed :stopped} :data {:steps {:tidy {:dug [:>= 1]}}}} :within-s 110 :of-job true}]
   :after [[:block [10 0 16] "carrots[age=0]"] [:block [11 0 16] "carrots[age=0]"]]}
  ;; the plan names the soil under the crop cells as dirt (a soil part): maintain still tills it and sows
  {:name "maintain-tills-the-dirt-a-plan-names-under-its-crop-cells"
   :blocks [[:fill [10 -1 16] [13 -1 16] "dirt"] [:fill [10 -2 17] [13 -2 17] "stone"] [:fill [10 -1 17] [13 -1 17] "water"]
            [:set [10 0 16] "air"]]
   :plans [{:id "field" :metadata {:by "$body"}
            :parts [{:id "soil" :box [#at [10 -1 16] #at [13 -1 16]] :want "dirt"}
                    {:id "row" :box [#at [10 0 16] #at [13 0 16]] :want {:crop "carrots"}}]}]
   :body {:inventory [["carrot" 40] ["stone_hoe" 1]]}
   :act [[:job (jobs.farm.maintain {:area {:plan "$plan:field" :part "row"} :irrigate false})]]
   :expect [{:event {:source :job :kind #{:completed :stopped} :data {:steps {:tend {:field {:crops 4 :untilled 0}}}}} :within-s 110 :of-job true}]
   :after [[:block [10 -1 16] "farmland"] [:block [10 0 16] "carrots[age=0]"] [:block [13 0 16] "carrots[age=0]"]]}]}
