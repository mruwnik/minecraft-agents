;; Card 68a0d04f: retreat's pillar step is refused where a mob could climb 1 block steps to stand beside the pillar's top
;; (retreat-pillar/climbable-top?): the cornered body then falls back to another refuge instead of pillaring beside a slope.
;; The same stone yard as retreat-pillar.edn (x 14..18, z 14..18, y 0..2, interior 3x3, open top), three NoAI helmeted zombies on
;; the west, north and south sides of the body, a stone block east of it. Case ledge: the east side is a 2 high ledge (reached by a
;; 1 high step at the north east corner), so a zombie could walk up beside the pillar top. Case low-bump: the east block is 1 high.
{:defaults
 {:tags [:hostile :survival :cornered]
  :time :any
  :plot {:height 16}
  :register [{:trigger :hostile-near}]
  :blocks [[:fill [14 0 14] [18 2 18] "stone" :hollow] [:fill [15 0 15] [17 2 17] "air"]]
  :body {:at [16.5 0 16.5] :effects [["resistance" 600 4]] :inventory [["dirt" 12]]}
  :act [[:summon "zombie" [15.5 0 16.5] "{NoAI:1b,equipment:{head:{id:\"minecraft:iron_helmet\",count:1}}}"]
        [:summon "zombie" [16.5 0 15.5] "{NoAI:1b,equipment:{head:{id:\"minecraft:iron_helmet\",count:1}}}"]
        [:summon "zombie" [16.5 0 17.5] "{NoAI:1b,equipment:{head:{id:\"minecraft:iron_helmet\",count:1}}}"]]
  :limit-s 90}
 :cases
 [{:name "low-bump-beside-still-pillars-up"
   :blocks [[:set [17 0 16] "stone"]]
   :expect [{:event {:source :job :kind :child_ended :data {:slot :pillar :status :done}} :within-s 60}]
   :after [[:body-near [16.5 3 16.5] 2]]}
  {:name "climbable-ledge-beside-builds-no-pillar"
   :blocks [[:fill [14 3 14] [18 4 18] "stone" :hollow] [:set [17 0 15] "stone"] [:fill [17 0 16] [17 1 16] "stone"]]
   :expect [{:event {:source :reflex :kind :fired :context {:reflex-id :hostile-near}} :within-s 15}
            {:no-event {:source :job :kind :child_ended :data {:slot :pillar :status :done}} :for-s 50}]
   :after [[:not-block [16 0 16] "dirt"]]}]}
