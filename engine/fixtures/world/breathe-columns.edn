;; Breathe in water columns (cards f9cf9494, aef12976, 94eea0ca, 8d927d51 swim up; f303ad2d, 27fe2fc6, 8842e30c magma (drag) bubble columns): stone mass, 1x1 water columns,
;; the body is put at a column's foot, its air runs out, the breathe reflex fires.
;; Should-succeed: deep-open-column (28 deep, several swims of the 3 s bound, none counted a failed try); dark-sealed-column (the air pocket above is sealed and dark, the body swims up
;; the own column unseen); deep-dirt-cap (swim up 12 cells to a dirt cap, dig it with a shovel); magma-neighbour (the capped own column is dug, the neighbour column over magma that reaches air is never entered);
;; go-air-routes-round-magma (a seen air pocket behind a drag column in a 3 wide tunnel is gone to round it).
;; Should-fail: deep-dirt-cap-bare-handed-is-not-dug (the same cap bare-handed: a floating dig takes longer than the air left, so none is started: stops :no-air, cap :too-slow, cap kept); magma-between-is-not-crossed (planks cap, the only air column lies behind a drag column: stops :no-air, never crosses).
;; too-slow-cap-over-lava-moves-to-the-still-pool: bare-handed, the column floor is lava; with the air left it swims to the still pool beside (stone floor) and stops there.
;; Live risk: magma over water makes a bubble column only after a block update; the magma cases check the stop or the dug cap, not the column state.
{:defaults
 {:tags [:survival :water] :time :any
  :plot {:height 12}
  :register [{:trigger :suffocating :persistence :cooldown :cooldown-s 2 :args {}
              :job (jobs.survival.breathe)}]
  :blocks [[:fill [0 0 0] [31 8 31] "stone"]]
  :body {:effects [["resistance" 600 4]] :settle-s 1}
  :limit-s 70}
 :cases
 [{:name "deep-open-column"
   :plot {:height 31}
   :blocks [[:fill [0 9 0] [31 29 31] "stone"]
            [:fill [16 0 16] [16 27 16] "water"]
            [:fill [16 28 16] [16 29 16] "air"]]
   :body {:at [16.5 1 16.5]}
   :limit-s 120
   :expect [{:event {:source :reflex :kind :fired} :within-s 30}
            {:event {:source :reflex :kind :ended :data {:how :cleared}} :within-s 100}
            {:no-event {:source :job :kind :stopped :data {:reason :no-air}} :for-s 100 :until {:source :reflex :kind :ended}}]
   :after [[:body-near [16.5 28 16.5] 3]]}
  {:name "dark-sealed-column"
   :plot {:height 16}
   :blocks [[:fill [0 9 0] [31 13 31] "stone"]
            [:fill [16 0 16] [16 9 16] "water"]
            [:fill [16 10 16] [16 12 16] "air"]]
   :body {:at [16.5 1 16.5]}
   :expect [{:event {:source :reflex :kind :fired} :within-s 30}
            {:event {:source :reflex :kind :ended :data {:how :cleared}} :within-s 60}
            {:no-event {:source :job :kind :stopped :data {:reason :no-air}} :for-s 60 :until {:source :reflex :kind :ended}}]
   :after [[:body-near [16.5 11 16.5] 3]]}
  {:name "deep-dirt-cap"
   :plot {:height 18}
   :blocks [[:fill [0 9 0] [31 14 31] "stone"]
            [:fill [16 0 16] [16 11 16] "water"]
            [:set [16 12 16] "dirt"]
            [:fill [16 13 16] [16 14 16] "air"]]
   :body {:at [16.5 1 16.5] :inventory [["iron_shovel" 1]]}
   :expect [{:event {:source :reflex :kind :fired} :within-s 30}
            {:no-event {:source :job :kind :stopped :data {:reason :no-air}} :for-s 25}]
   :after [[:not-block [16 12 16] "dirt"] [:body-near [16.5 12.5 16.5] 3]]}
  {:name "deep-dirt-cap-bare-handed-is-not-dug"
   :plot {:height 18}
   :blocks [[:fill [0 9 0] [31 14 31] "stone"]
            [:fill [16 0 16] [16 11 16] "water"]
            [:set [16 12 16] "dirt"]
            [:fill [16 13 16] [16 14 16] "air"]
            [:set [15 10 16] "glowstone"]]
   :body {:at [16.5 1 16.5]}
   :expect [{:event {:source :reflex :kind :fired} :within-s 30}
            {:event {:source :job :kind :stopped :data {:reason :no-air :cap :too-slow}} :within-s 60}]
   :after [[:block [16 12 16] "dirt"]]}
  {:name "too-slow-cap-over-lava-moves-to-the-still-pool"
   :plot {:height 18}
   :blocks [[:fill [0 9 0] [31 14 31] "stone"]
            [:set [16 0 16] "lava"]
            [:fill [16 1 16] [16 11 16] "water"]
            [:set [16 12 16] "dirt"]
            [:fill [16 13 16] [16 14 16] "air"]
            [:fill [17 1 16] [17 3 16] "water"]
            [:set [15 10 16] "glowstone"]]
   :body {:at [16.5 3 16.5]}
   :expect [{:event {:source :reflex :kind :fired} :within-s 30}
            {:event {:source :job :kind :stopped :data {:reason :no-air :cap :too-slow}} :within-s 60}]
   :after [[:body-near [17.5 2 16.5] 2] [:block [16 12 16] "dirt"]]}
  {:name "magma-neighbour-is-not-entered"
   :blocks [[:fill [16 0 16] [16 3 16] "water"]
            [:set [16 4 16] "dirt"]
            [:fill [16 5 16] [16 8 16] "air"]
            [:set [17 -1 16] "magma_block"]
            [:fill [17 0 16] [17 3 16] "water"]
            [:fill [17 4 16] [17 8 16] "air"]]
   :body {:at [16.5 1 16.5]}
   :expect [{:event {:source :reflex :kind :fired} :within-s 30}
            {:no-event {:source :job :kind :stopped :data {:reason :no-air}} :for-s 40 :until {:source :reflex :kind :ended}}
            {:no-event {:source :body :kind :died} :for-s 40 :until {:source :reflex :kind :ended}}]
   :after [[:not-block [16 4 16] "dirt"] [:body-near [16.5 3 16.5] 3]]}
  {:name "magma-between-is-not-crossed"
   :blocks [[:fill [14 0 16] [16 3 16] "water"]
            [:set [14 4 16] "oak_planks"]
            [:fill [14 5 16] [14 8 16] "air"]
            [:set [15 -1 16] "magma_block"]
            [:fill [16 4 16] [16 8 16] "air"]]
   :body {:at [14.5 1 16.5]}
   :expect [{:event {:source :reflex :kind :fired} :within-s 30}
            {:event {:source :job :kind :stopped :data {:reason :no-air :cap :not-natural}} :within-s 60}
            {:no-event {:source :body :kind :died} :for-s 60}]
   :after [[:block [14 4 16] "oak_planks"] [:body-far [16.5 2 16.5] 1.2]]}
  {:name "go-air-routes-round-magma"
   :blocks [[:fill [4 0 15] [24 3 17] "water"]
            [:fill [18 3 15] [21 3 17] "air"]
            [:set [12 -1 16] "magma_block"]
            [:set [19 4 16] "glowstone"]]
   ;; the pocket (x 18..21) is 12+ from the body: past the default air-radius setting 8
   :register [{:trigger :suffocating :persistence :cooldown :cooldown-s 2 :args {}
               :job (jobs.survival.breathe {:settings {:jobs.survival.breathe.air/air-radius 16}})}]
   :body {:at [6.5 1 16.5] :yaw 270}
   :expect [{:event {:source :reflex :kind :fired} :within-s 30}
            {:event {:source :job :kind :child_started :data {:slot :air}} :within-s 40}
            {:no-event {:source :job :kind :stopped :data {:reason :no-air}} :for-s 40 :until {:source :reflex :kind :ended}}
            {:no-event {:source :body :kind :died} :for-s 40}]
   :after [[:body-near [19.5 3 16.5] 4]]}]}
