;; Card e51c5646 (32afe9b3): a queued log-out takes the body from the firing needs-weapon reflex (default level, no :level on the row) and its cooldown rests: the reflex does not refire and the log-out runs.
;; Log-out needs night: run with --allow-time --time-log <file>.
{:defaults
 {:tags [:night :survival :needs-weapon]
  :time :night :time-why :sleep
  :plot {:height 8}
  :register [{:trigger :needs-weapon}]
  :blocks [[:set [4 0 4] "torch"] [:set [4 0 28] "torch"] [:set [28 0 4] "torch"] [:set [28 0 28] "torch"]]
  :body {:at [16.5 0 16.5] :spawnpoint [4 0 4]}
  :limit-s 120}
 :cases
 [{:name "queued-log-out-starts-from-a-cut-needs-weapon-without-refire"
   :act [[:wait-s 6]
         [:http :submit (jobs.survival.log-out {:offline-ms 3000 :news-ms 500}) [] {:ok true}]
         [:until [:cli "jobs" ["$body" "--world" "$world" "list"] {:total 0}] 90]]
   :expect [{:event {:source :reflex :kind :fired :context {:reflex-id :needs-weapon}} :within-s 20}
            {:event {:source :job :kind :completed :data {:name "jobs.survival.log-out"}} :within-s 90}
            {:count-event {:source :reflex :kind :fired :context {:reflex-id :needs-weapon}} :for-s 90 :at-most 1}]}]}
