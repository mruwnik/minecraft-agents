;; jobs.survival.shut-in (night) on open ground without the usual materials (cards 0392fef7, f3e41d66, hand-tested in 0b0a8242):
;; a pickaxe carried but not held is equipped before the digs and the pit is roofed with the dug stone; no pickaxe and
;; no blocks on stone fails with a reason and digs nothing; a 1-thick floor over a void is not dug through.
;; Run directly (not through the shelter job: that logs the body out for the night whenever another player is online).
{:defaults
 {:tags [:survival :shut-in]
  :time :any
  :blocks [[:set [4 0 4] "torch"] [:set [4 0 28] "torch"] [:set [28 0 4] "torch"] [:set [28 0 28] "torch"]
           [:set [16 0 4] "torch"] [:set [16 0 28] "torch"] [:set [4 0 16] "torch"] [:set [28 0 16] "torch"]]
  :body {:at [16.5 0 16.5] :effects [["resistance" 600 4]]}}
 :cases
 [{:name "pickaxe-carried-is-equipped-then-digs-and-seals"
   ;; a thick stone pad under the plot floor (the floor is one block over void; shut-in will not dig through it)
   :blocks [[:fill [2 -6 2] [9 -1 9] "stone"]]
   :body {:at [5.5 0 5.5] :inventory [["stick" 1] ["stone_pickaxe" 1]]}
   :plot {:height 12 :light :sky}
   :act [[:job (jobs.survival.shut-in {:ways #{:room :walls :pit} :for :night})]]
   ;; no equip is asked when the pooled body's held slot already holds the pickaxe: the stone it digs and the roof it places
   ;; from the dug cobblestone show the pickaxe was in hand
   :expect [{:event {:source :job :kind :shut-in.sealed} :within-s 60 :of-job true}
            {:no-event {:source :job :kind :stopped :data {:reason :no-way}} :for-s 60 :until {:source :job :kind :shut-in.sealed}}]
   :limit-s 70}
  {:name "no-pickaxe-no-blocks-fails-without-digging"
   :blocks [[:fill [12 -6 12] [20 -1 20] "stone"]]
   :body {:at [16.5 0 16.5]}
   :act [[:job (jobs.survival.shut-in {:ways #{:room :walls :pit} :for :night})]]
   :expect [{:event {:source :job :kind :stopped :data {:reason :no-way}} :within-s 20 :of-job true}
            {:no-event {:source :action :kind :started :data {:name "dig"}} :for-s 20 :until {:source :job :kind :stopped :data {:reason :no-way}}}]
   :after [[:block [16 -1 16] "stone"]]
   :limit-s 30}
  {:name "one-thick-floor-over-void-is-not-dug-through"
   :blocks [[:fill [20 5 20] [30 5 30] "stone"]]
   :body {:at [25.5 6 25.5] :inventory [["stone_pickaxe" 1]]}
   :plot {:height 12}
   :act [[:job (jobs.survival.shut-in {:ways #{:room :walls :pit} :for :night})]]
   ;; the zigzag pit may dig the side cell at floor level (it cannot see under a block); it never digs the cell under the feet
   :expect [{:event {:source :job :kind :stopped :data {:reason :no-way}} :within-s 20 :of-job true}]
   :after [[:block [25 5 25] "stone"] [:body-near [25.5 6 25.5] 1.5]]
   :limit-s 30}]}
