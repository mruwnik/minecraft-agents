;; jobs.blocks.dig :on-fluid and jobs.gather.mine :wet (card d5e3748c): stone beside a water source (a one-cell
;; pocket at [19 0 16], walled on four sides and open on top; every stone cell touches it), a dry stone at [14 0 16]; bedrock floor so mine sees only that stone.
;; The dig cases stand on a two-stone pillar at [17 0 16] (eye 3.6): sight is one ray to a cell's centre, and from a lower eye that ray to the water
;; clips the target stone, so the water reads unseen, and an unseen cell reads as stone.
{:defaults
 {:tags [:blocks :mine :jobs] :time :any
  :plot {:height 8 :floor "bedrock"}
  :blocks [[:set [18 0 16] "stone"] [:set [20 0 16] "stone"]
           [:set [19 0 15] "stone"] [:set [19 0 17] "stone"] [:set [19 0 16] "water"]]
  :body {:at [16.5 0 16.5] :inventory [["iron_pickaxe" 1]]}}
 :cases
 [{:name "default-waits-on-hazard"
   :blocks [[:set [17 0 16] "stone"] [:set [17 1 16] "stone"]]
   :body {:at [17.5 2 16.5]}
   :act [[:job (jobs.blocks.dig {:pos #at [18 0 16]})]]
   ;; waits when the water was already seen at the start, else the round looks first and ends :stopped on the same hazard
   :expect [{:event {:source :job :kind #{:waiting :stopped} :data {:reason :hazard}} :within-s 30 :of-job true}
            {:no-event {:source :job :kind :completed} :for-s 30}]
   :after [[:block [18 0 16] "stone"]]}
  {:name "fail-ends-at-once-with-hint"
   :blocks [[:set [17 0 16] "stone"] [:set [17 1 16] "stone"]]
   :body {:at [17.5 2 16.5]}
   :act [[:job (jobs.blocks.dig {:pos #at [18 0 16] :on-fluid :fail})]]
   :expect [{:event {:source :job :kind :stopped :data {:dug false :reason :fluid-adjacent}} :within-s 30 :of-job true}]
   :after [[:block [18 0 16] "stone"]]}
  {:name "fail-with-accept-digs"
   :blocks [[:set [17 0 16] "stone"] [:set [17 1 16] "stone"]]
   :body {:at [17.5 2 16.5]}
   :act [[:job (jobs.blocks.dig {:pos #at [18 0 16] :on-fluid :fail :accept #{:fluid-adjacent}})]]
   :expect [{:event {:source :job :kind :completed :data {:dug true :reason :dug}} :within-s 60 :of-job true}]
   ;; the cell fills with water and the drop lies 2 below the pillar top, so the body rightly leaves it (collect-drops :too-deep)
   :after [[:block [18 0 16] "water"]]}
  {:name "fail-on-dry-block-digs"
   :blocks [[:set [14 0 16] "stone"]]
   :act [[:job (jobs.blocks.dig {:pos #at [14 0 16] :on-fluid :fail})]]
   :expect [{:event {:source :job :kind :completed :data {:dug true :reason :dug}} :within-s 60 :of-job true}]
   :after [[:block [14 0 16] "air"] [:item "cobblestone" [:>= 1]]]}
  {:name "mine-only-wet-stone-says-wet-skipped"
   :act [[:job (jobs.gather.mine {:block "stone" :count 1 :tunnel-length 0 :radius 8})]]
   :expect [{:event {:source :job :kind #{:completed :stopped} :data {:got 0 :reason :wet :wet-skipped [:>= 1]}} :within-s 90 :of-job true}]
   :after [[:block [18 0 16] "stone"]]
   :limit-s 100}
  {:name "mine-wet-stone-no-descent-says-wet-skipped"
   :act [[:job (jobs.gather.mine {:block "stone" :count 1 :tunnel-length 0 :descend-limit 0 :radius 8})]]
   :expect [{:event {:source :job :kind #{:completed :stopped} :data {:got 0 :reason :wet :wet-skipped [:>= 1]}} :within-s 60 :of-job true}]
   :after [[:block [18 0 16] "stone"]]
   :limit-s 70}
  {:name "mine-wet-stone-tunnel-4-says-wet-skipped"
   :body {:yaw 270}
   :act [[:job (jobs.gather.mine {:block "stone" :count 1 :tunnel-length 4 :radius 8})]]
   :expect [{:event {:source :job :kind #{:completed :stopped} :data {:got 0 :reason :wet :wet-skipped [:>= 1]}} :within-s 120 :of-job true}]
   :after [[:block [18 0 16] "stone"]]
   :limit-s 140}
  {:name "mine-wet-true-digs"
   :act [[:job (jobs.gather.mine {:block "stone" :count 1 :tunnel-length 0 :wet true :radius 8})]]
   :expect [{:event {:source :job :kind #{:completed :stopped} :data {:got [:>= 1]}} :within-s 120 :of-job true}]
   :after [[:item "cobblestone" [:>= 1]]]
   :limit-s 140}
  {:name "mine-dry-stone-beside-wet-digs-dry"
   :blocks [[:set [14 0 16] "stone"]]
   :act [[:job (jobs.gather.mine {:block "stone" :count 1 :tunnel-length 0 :radius 8})]]
   :expect [{:event {:source :job :kind #{:completed :stopped} :data {:got [:>= 1]}} :within-s 120 :of-job true}]
   :after [[:not-block [14 0 16] "stone"] [:item "cobblestone" [:>= 1]]]
   :limit-s 140}]}
