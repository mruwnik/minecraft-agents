;; go-to with water (cards b3779e96, 33c42823, 46a889ba, a9a464b5, 6130511f): a lake 21 x 25, 5 deep, its east bank level with the water (stand y 5, x >= 25); the deep lake is 15 deep.
;; Should-succeed: lake-floor-start-walks-to-the-bank (from the lake floor to the bank 11 blocks off: surfaces, walks, arrives, no hurt); water-goal-leaves-the-water (a goal in the water
;; with range 3 ends on the bank); unseen-lake-column-aims-at-the-surface (a column goal [x z] in a deep lake the body has not seen: it ends on the surface, not the seabed);
;; dark-shaft-go-to-swims-up (the body has been under water ~6 s in a sealed, dark 1x1 shaft, the goal is the air pocket above: a blind swim up arrives, no :why :air).
;; submerged-tunnel-is-swum (an 18 cell tunnel two high is swum at ~3.9 b/s: out within 11 s, no hurt).
;; Live risk: the unseen-column case depends on the body not seeing the lake from the bank (it faces away); the dark shaft pocket is only dark when the roof really seals it.
{:defaults
 {:tags [:movement :water :air] :time :any
  :limit-s 120}
 :cases
 [{:name "lake-floor-start-walks-to-the-bank"
   :plot {:height 12 :length 48 :width 32}
   :blocks [[:fill [0 0 0] [47 4 31] "stone"]
            [:fill [4 0 4] [24 4 28] "water"]]
   :body {:at [6.5 0 16.5] :settle-s 1}
   :act [[:job (jobs.movement.go-to {:pos #at [36 5 16] :range 2 :ways #{:walk :dig} :may-dig #{:own}})]]
   :expect [{:event {:source :job :kind :completed :data {:arrived true}} :within-s 90 :of-job true}
            {:no-event {:source :body :kind :hurt} :for-s 90 :until {:source :job :kind #{:completed :stopped}}}]
   :after [[:body-near [36.5 5 16.5] 3]]}
  {:name "water-goal-leaves-the-water"
   :plot {:height 12 :length 48 :width 32}
   :blocks [[:fill [0 0 0] [47 4 31] "stone"]
            [:fill [4 0 4] [24 4 28] "water"]]
   :body {:at [30.5 5 16.5] :yaw 90 :settle-s 1}
   :act [[:job (jobs.movement.go-to {:pos #at [23 4 16] :range 3 :ways #{:walk :dig} :may-dig #{:own}})]]
   :expect [{:event {:source :job :kind :completed :data {:arrived true}} :within-s 60 :of-job true}
            {:no-event {:source :body :kind :hurt} :for-s 60 :until {:source :job :kind #{:completed :stopped}}}]
   :after [[:body-near [26.5 5 16.5] 2.6]]}
  {:name "unseen-lake-column-aims-at-the-surface"
   :plot {:height 20 :length 48 :width 32}
   :blocks [[:fill [0 0 0] [47 14 31] "stone"]
            [:fill [4 0 4] [24 14 28] "water"]]
   :body {:at [30.5 15 16.5] :yaw 270 :settle-s 1}
   :act [[:job (jobs.movement.go-to {:pos #at [14 16] :range 1 :ways #{:walk :dig} :may-dig #{:own}})]]
   :expect [{:event {:source :job :kind :completed :data {:arrived true}} :within-s 100 :of-job true}
            {:no-event {:source :body :kind :hurt} :for-s 100 :until {:source :job :kind #{:completed :stopped}}}]
   :after [[:body-near [14.5 15 16.5] 3]]}
  {:name "dark-shaft-go-to-swims-up"
   :plot {:height 16}
   :blocks [[:fill [0 0 0] [31 13 31] "stone"]
            [:fill [16 0 16] [16 9 16] "water"]
            [:fill [16 10 16] [16 12 16] "air"]]
   :body {:at [16.5 1 16.5] :settle-s 1 :effects [["resistance" 600 4]]}
   :act [[:until-rcon "data get entity $BODY Air" "data: ([0-9]{1,2}|1[0-9]{2}|2[0-4][0-9])s" 15]
         [:job (jobs.movement.go-to {:pos #at [16 11 16] :range 1 :ways #{:walk :dig} :may-dig #{:own}})]]
   :expect [{:event {:source :job :kind :completed :data {:arrived true}} :within-s 60 :of-job true}
            {:no-event {:source :job :kind #{:completed :stopped} :data {:why :air}} :for-s 60 :until {:source :job :kind #{:completed :stopped}}}]
   :after [[:body-near [16.5 11 16.5] 4]]}
  ;; card 33b39e3a: a body pressed on a bank face at a power of two (plot x or z 16 here; the plot origin is a multiple of 16) in water
  ;; 1 deep climbs out: it arrives, no walker fault. East bank face at x 16 (the pool x 6..15, z 8..24, 1 deep); north bank face at z 16.
  {:name "shallow-pool-pressed-on-the-east-bank-face-climbs-out"
   :blocks [[:fill [16 0 8] [30 0 24] "stone"] [:fill [6 0 8] [15 0 24] "water"]]
   :body {:at [15.69 0 16.5] :settle-s 2}
   :act [[:job (jobs.movement.go-to {:pos #at [24 1 16] :range 1 :ways #{:walk :dig} :may-dig #{:own}})]]
   :expect [{:event {:source :job :kind :completed :data {:arrived true}} :within-s 60 :of-job true}
            {:no-event {:source :job :kind :walker-fault} :for-s 60 :until {:source :job :kind #{:completed :stopped}}}]
   :after [[:body-near [24.5 1 16.5] 3]]}
  {:name "shallow-pool-pressed-on-the-north-bank-face-climbs-out"
   :blocks [[:fill [8 0 0] [24 0 15] "stone"] [:fill [8 0 16] [24 0 24] "water"]]
   :body {:at [16.5 0 16.31] :settle-s 2}
   :act [[:job (jobs.movement.go-to {:pos #at [16 1 8] :range 1 :ways #{:walk :dig} :may-dig #{:own}})]]
   :expect [{:event {:source :job :kind :completed :data {:arrived true}} :within-s 60 :of-job true}
            {:no-event {:source :job :kind :walker-fault} :for-s 60 :until {:source :job :kind #{:completed :stopped}}}]
   :after [[:body-near [16.5 1 8.5] 3]]}
  ;; card f4668a26: a submerged 2-high tunnel (18 cells, the only way past the ridge) is swum, not paddled: a swim (sprint, eyes
  ;; under) is ~3.9 b/s, so up the far shaft and out within 11 s; a paddle takes 9 s for the tunnel alone (live, 1.4 s a cell: drowns)
  {:name "submerged-tunnel-is-swum"
   :plot {:height 12 :length 32 :width 64}
   :blocks [[:fill [0 0 0] [31 5 63] "stone"]
            [:fill [4 0 8] [4 5 8] "water"] [:fill [5 0 8] [22 1 8] "water"] [:fill [23 0 8] [23 5 8] "water"]
            [:fill [11 6 0] [11 9 63] "bedrock"]]
   :body {:at [4.5 0 8.5]}
   :act [[:job (jobs.movement.go-to {:pos #at [24 6 8] :range 1 :ways #{:walk :dig} :may-dig #{:own}})]]
   :expect [{:event {:source :job :kind :completed :data {:arrived true}} :within-s 11 :of-job true}
            {:no-event {:source :body :kind :hurt} :for-s 11 :until {:source :job :kind #{:completed :stopped}}}]
   :after [[:body-near [24.5 6 8.5] 3]]}]}
