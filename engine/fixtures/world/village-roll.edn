;; jobs.village.roll (card 5aff1cbf): re-roll an untraded villager's offers by breaking and placing its workstation (lectern at
;; 16 0 16). Live-only facts: whether an AI librarian claims the lectern placed again (day only), loses the profession when it
;; is broken, and whether the trade primitive reads fresh offers each time. Offers do not name an enchantment, so :want is
;; "enchanted_book" (a first-tier librarian may or may not offer one: the roll ends found or no-match after ::max-rolls).
;; roll-three-times-in-one-call: three rerolls in one call (no villager offers a netherite ingot), then no-match.
;; Should-succeed: roll-librarian (day, AI villager beside the lectern; needs a pickaxe/axe-free dig: a lectern breaks by hand).
;; Should-fail: nitwit, absent villager, a villager of another block cell, a cell that stays unseen (ends :cell-unseen, no endless wait).
;; Unseen-cell cases: the body at [8.5 0 16.5] faces west (yaw 90), the lectern is 7 blocks behind it, so it starts unseen; the roll
;; looks first (roll-cell-behind-the-body-is-looked-at); a lectern sealed in obsidian stays unseen (roll-cell-sealed-away-ends-cell-unseen).
{:defaults
 {:tags [:village :jobs]
  :time :day :time-why :villager-schedule
  :plot {:floor "grass_block"}
  :blocks [[:fill [16 0 16] [16 0 16] "lectern"]]
  :body {:at [14.5 0 16.5] :yaw 270}
  :limit-s 240}
 :cases
 [{:name "roll-librarian"
   :act [[:summon "villager" [16.5 1 17.5] "{UUID:[I;20260,7,5,1],VillagerData:{profession:\"minecraft:librarian\",level:1,type:\"minecraft:plains\"}}"]
         [:job (jobs.village.roll {:villager "00004f24-0000-0007-0000-000500000001" :pos #at [16 0 16] :profession "librarian" :want "enchanted_book" :settings {:jobs.village.roll/max-rolls 12}})]]
   :expect [{:event {:source :job :kind :completed} :within-s 220 :of-job true}]
   :after [[:block [16 0 16] "lectern"]]}
  {:name "roll-with-carried-ways-places-the-workstation-it-broke"
   :act [[:summon "villager" [16.5 1 17.5] "{UUID:[I;20260,7,5,13],VillagerData:{profession:\"minecraft:librarian\",level:1,type:\"minecraft:plains\"}}"]
         [:job (jobs.village.roll {:villager "00004f24-0000-0007-0000-00050000000d" :pos #at [16 0 16] :profession "librarian" :want "enchanted_book" :ways #{:carried} :settings {:jobs.village.roll/max-rolls 12}})]]
   :expect [{:event {:source :job :kind :completed} :within-s 220 :of-job true}]
   :after [[:block [16 0 16] "lectern"]]}
  {:name "roll-with-a-book-map-stops-on-any-listed-book"
   :act [[:summon "villager" [16.5 1 17.5] "{UUID:[I;20260,7,5,12],VillagerData:{profession:\"minecraft:librarian\",level:1,type:\"minecraft:plains\"}}"]
         [:job (jobs.village.roll {:villager "00004f24-0000-0007-0000-00050000000c" :pos #at [16 0 16] :profession "librarian" :want nil :enchant {"mending" 1 "unbreaking" 1 "protection" 1 "sharpness" 1 "efficiency" 1 "knockback" 1 "silk_touch" 1 "fortune" 1 "looting" 1 "power" 1 "feather_falling" 1 "respiration" 1 "aqua_affinity" 1 "thorns" 1 "depth_strider" 1 "frost_walker" 1 "fire_protection" 1 "blast_protection" 1 "projectile_protection" 1 "sweeping_edge" 1 "fire_aspect" 1 "punch" 1 "flame" 1 "infinity" 1 "luck_of_the_sea" 1 "lure" 1 "loyalty" 1 "impaling" 1 "riptide" 1 "channeling" 1 "multishot" 1 "piercing" 1 "quick_charge" 1 "soul_speed" 1 "swift_sneak" 1 "smite" 1 "bane_of_arthropods" 1 "binding_curse" 1 "vanishing_curse" 1} :settings {:jobs.village.roll/max-rolls 12}})]]
   :expect [{:event {:source :job :kind :completed} :within-s 220 :of-job true}]
   :after [[:block [16 0 16] "lectern"]]}
  {:name "roll-three-times-in-one-call"
   :act [[:summon "villager" [16.5 1 17.5] "{UUID:[I;20260,7,5,9],VillagerData:{profession:\"minecraft:librarian\",level:1,type:\"minecraft:plains\"}}"]
         [:job (jobs.village.roll {:villager "00004f24-0000-0007-0000-000500000009" :pos #at [16 0 16] :profession "librarian" :want "netherite_ingot" :settings {:jobs.village.roll/max-rolls 3}})]]
   :expect [{:event {:source :job :kind :stopped :data {:reason :no-match}} :within-s 230 :of-job true}]
   :after [[:block [16 0 16] "lectern"]]}
  {:name "roll-sealed-cell-from-the-corridor-never-digs-a-wall"
   :plot {:floor "grass_block" :height 8}
   :blocks [[:fill [11 -1 15] [14 2 17] "stone" :hollow] [:fill [14 -1 12] [21 2 20] "stone" :hollow]
            [:set [14 0 16] "air"] [:set [14 1 16] "air"] [:set [13 0 16] "lectern"]]
   :body {:at [15.5 0 16.5] :yaw 90 :settle-s 2}
   :act [[:summon "villager" [12.5 0 16.5] "{UUID:[I;20260,7,5,10],VillagerData:{profession:\"minecraft:librarian\",level:1,type:\"minecraft:plains\"}}"]
         [:wait-s 2]
         [:job (jobs.village.roll {:villager "00004f24-0000-0007-0000-00050000000a" :pos #at [13 0 16] :profession "librarian" :want "netherite_ingot" :settings {:jobs.village.roll/max-rolls 3}})]]
   :expect [{:event {:source :job :kind :stopped :data {:reason :no-match}} :within-s 230 :of-job true}]
   :after [[:block [13 0 16] "lectern"] [:block [13 1 15] "stone"] [:block [13 1 17] "stone"] [:block [12 1 15] "stone"]
           [:block [12 1 17] "stone"] [:block [13 2 16] "stone"] [:block [11 0 16] "stone"] [:block [11 1 16] "stone"]]}
  {:name "roll-through-the-lectern-and-top-slab-gap"
   :time :day :time-why :villager-schedule
   :plot {:floor "grass_block" :height 8}
   :blocks [[:fill [15 -1 15] [17 3 17] "stone" :hollow]
            [:fill [13 -1 14] [15 3 18] "stone" :hollow]
            [:set [17 0 16] "lectern[facing=east]"]
            [:set [17 1 16] "bamboo_slab[type=top]"]
            [:set [15 1 16] "andesite"]
            [:set [15 0 16] "air"]
            [:fill [14 0 18] [14 1 18] "air"]]
   :body {:at [18.5 0 16.5] :yaw 90 :settle-s 2}
   :act [[:summon "villager" [16.4 0 16.5] "{UUID:[I;20260,7,5,11],VillagerData:{profession:\"minecraft:librarian\",level:1,type:\"minecraft:plains\"}}"]
         [:wait-s 2]
         [:job (jobs.village.roll {:villager "00004f24-0000-0007-0000-00050000000b" :pos #at [17 0 16] :profession "librarian" :want "netherite_ingot" :settings {:jobs.village.roll/max-rolls 3}})]]
   :expect [{:event {:source :job :kind :roll.offers} :within-s 60 :of-job true}
            {:event {:source :job :kind :stopped :data {:reason :no-match}} :within-s 230 :of-job true}]
   :after [[:block [17 0 16] "lectern"] [:entities "type=villager" [[16 0 16] [16 2 16]] 1]]}
  {:name "roll-lectern-drop-slid-over-ice-never-opens-the-cell"
   :time :day :time-why :villager-schedule
   :plot {:floor "grass_block" :height 8}
   :blocks [[:fill [15 -1 15] [17 3 17] "stone" :hollow]
            [:fill [13 -1 14] [15 3 18] "stone" :hollow]
            [:set [17 0 16] "lectern[facing=east]"]
            [:set [17 1 16] "bamboo_slab[type=top]"]
            [:set [17 -1 16] "blue_ice"]]
   :body {:at [18.5 0 16.5] :yaw 90 :settle-s 2}
   :act [[:summon "villager" [16.4 0 16.5] "{UUID:[I;20260,7,5,14],VillagerData:{profession:\"minecraft:librarian\",level:1,type:\"minecraft:plains\"}}"]
         [:wait-s 2]
         [:job (jobs.village.roll {:villager "00004f24-0000-0007-0000-00050000000e" :pos #at [17 0 16] :profession "librarian" :want "netherite_ingot" :settings {:jobs.village.roll/max-rolls 3}})]]
   :expect [{:event {:source :job :kind :roll.offers} :within-s 60 :of-job true}
            {:event {:source :job :kind :stopped} :within-s 230 :of-job true}]
   :after [[:block [17 1 16] "bamboo_slab[type=top]"] [:entities "type=villager" [[16 0 16] [16 2 16]] 1]]}
  {:name "roll-goes-on-with-a-zombie-only-heard-behind-the-wall"
   :time :day :time-why :villager-schedule
   :plot {:floor "grass_block" :height 8}
   :mobs :keep
   :blocks [[:fill [12 -1 12] [20 3 20] "stone" :hollow] [:fill [13 0 13] [19 2 19] "air"]
            [:set [13 1 13] "torch"] [:set [19 1 19] "torch"] [:set [16 0 16] "lectern"]]
   :body {:at [14.5 0 16.5] :yaw 270 :settle-s 2}
   :act [[:summon "villager" [16.5 0 17.5] "{UUID:[I;20260,7,5,16],VillagerData:{profession:\"minecraft:librarian\",level:1,type:\"minecraft:plains\"}}"]
         [:summon "zombie" [24.5 0 16.5] "{NoAI:1b,equipment:{head:{id:\"minecraft:iron_helmet\",count:1}}}"]
         [:wait-s 3]
         [:job (jobs.village.roll {:villager "00004f24-0000-0007-0000-000500000011" :pos #at [16 0 16] :profession "librarian" :want "netherite_ingot" :settings {:jobs.village.roll/max-rolls 3}})]]
   :expect [{:event {:source :job :kind :roll.offers} :within-s 60 :of-job true}
            {:event {:source :job :kind :stopped :data {:reason :no-match}} :within-s 230 :of-job true}
            {:no-event {:source :job :kind :waiting :data {:reason :hostile-near}} :for-s 60 :until {:source :job :kind :stopped}}]
   :after [[:block [16 0 16] "lectern"]]}
  {:name "nitwit-cannot-be-rolled"
   :act [[:summon "villager" [16.5 1 17.5] "{NoAI:1b,UUID:[I;20260,7,5,2],VillagerData:{profession:\"minecraft:nitwit\",level:1,type:\"minecraft:plains\"}}"]
         [:job (jobs.village.roll {:villager "00004f24-0000-0007-0000-000500000002" :pos #at [16 0 16] :profession "librarian" :want "enchanted_book"})]]
   :expect [{:event {:source :job :kind :stopped :data {:kind :impossible :reason :nitwit}} :within-s 40 :of-job true}]
   :after [[:block [16 0 16] "lectern"]]}
  {:name "level-2-librarian-is-locked-without-a-dig"
   :act [[:summon "villager" [16.5 1 17.5] "{NoAI:1b,Xp:10,UUID:[I;20260,7,5,15],VillagerData:{profession:\"minecraft:librarian\",level:2,type:\"minecraft:plains\"}}"]
         [:job (jobs.village.roll {:villager "00004f24-0000-0007-0000-000500000010" :pos #at [16 0 16] :profession "librarian" :want "enchanted_book"})]]
   :expect [{:event {:source :job :kind :stopped :data {:reason :locked}} :within-s 40 :of-job true}]
   :after [[:block [16 0 16] "lectern"]]}
  {:name "absent-villager-is-gone"
   :act [[:job (jobs.village.roll {:villager "00004f24-0000-0007-0000-000500000003" :pos #at [16 0 16] :profession "librarian" :want "enchanted_book"})]]
   :expect [{:event {:source :job :kind :stopped :data {:reason :gone}} :within-s 30 :of-job true}]
   :after [[:block [16 0 16] "lectern"]]}
  {:name "other-block-on-the-cell-waits-occupied"
   :blocks [[:fill [16 0 16] [16 0 16] "stone"]]
   :act [[:summon "villager" [16.5 1 17.5] "{NoAI:1b,UUID:[I;20260,7,5,4],VillagerData:{profession:\"minecraft:librarian\",level:1,type:\"minecraft:plains\"}}"]
         [:job (jobs.village.roll {:villager "00004f24-0000-0007-0000-000500000004" :pos #at [16 0 16] :profession "librarian" :want "enchanted_book"})]]
   :expect [{:event {:source :job :kind :waiting :data {:reason :occupied}} :within-s 40 :of-job true}]}
  {:name "roll-at-night-names-the-villager-and-the-reason"
   :time :night :time-why :villager-schedule
   :act [[:summon "villager" [16.5 1 17.5] "{NoAI:1b,UUID:[I;20260,7,5,7],VillagerData:{profession:\"minecraft:none\",level:1,type:\"minecraft:plains\"}}"]
         [:job (jobs.village.roll {:pos #at [16 0 16] :profession "librarian" :want "enchanted_book"})]]
   :expect [{:event {:source :job :kind :roll.villager :data {:villager "00004f24-0000-0007-0000-000500000007"}} :within-s 40 :of-job true}
            {:no-event {:source :job :kind :stopped} :for-s 30}]
   :after [[:block [16 0 16] "lectern"]]}
  {:name "roll-villager-behind-the-body-is-looked-for-not-gone"
   :body {:at [14.5 0 16.5] :yaw 90}
   :act [[:summon "villager" [16.5 1 17.5] "{NoAI:1b,UUID:[I;20260,7,5,8],VillagerData:{profession:\"minecraft:none\",level:1,type:\"minecraft:plains\"}}"]
         [:wait-s 2]
         [:job (jobs.village.roll {:pos #at [16 0 16] :profession "librarian" :want "enchanted_book"})]]
   :expect [{:event {:source :job :kind :roll.villager :data {:villager "00004f24-0000-0007-0000-000500000008"}} :within-s 40 :of-job true}
            {:no-event {:source :job :kind :stopped :data {:reason :gone}} :for-s 30}]
   :after [[:block [16 0 16] "lectern"]]}
  {:name "roll-cell-behind-the-body-is-looked-at"
   :body {:at [8.5 0 16.5] :yaw 90}
   :act [[:summon "villager" [16.5 1 17.5] "{UUID:[I;20260,7,5,5],VillagerData:{profession:\"minecraft:librarian\",level:1,type:\"minecraft:plains\"}}"]
         [:wait-s 3]
         [:job (jobs.village.roll {:villager "00004f24-0000-0007-0000-000500000005" :pos #at [16 0 16] :profession "librarian" :want "enchanted_book" :settings {:jobs.village.roll/max-rolls 12}})]]
   :expect [{:event {:source :job :kind :completed} :within-s 220 :of-job true}
            {:no-event {:source :job :kind :waiting :data {:reason :cell-unseen}} :for-s 220 :until {:source :job :kind :completed}}]
   :after [[:block [16 0 16] "lectern"]]}
  {:name "roll-cell-sealed-away-ends-cell-unseen"
   :blocks [[:fill [15 0 15] [17 1 17] "obsidian"] [:set [16 0 16] "lectern"]]
   :body {:at [8.5 0 16.5] :yaw 90}
   :act [[:summon "villager" [12.5 0 17.5] "{NoAI:1b,UUID:[I;20260,7,5,6],VillagerData:{profession:\"minecraft:librarian\",level:1,type:\"minecraft:plains\"}}"]
         [:wait-s 2]
         [:job (jobs.village.roll {:villager "00004f24-0000-0007-0000-000500000006" :pos #at [16 0 16] :profession "librarian" :want "enchanted_book"})]]
   :expect [{:event {:source :job :kind :stopped :data {:kind :condition-failed :reason :cell-unseen}} :within-s 120 :of-job true}
            {:no-event {:source :job :kind :completed} :for-s 20}]
   :after [[:block [16 0 16] "lectern"]]}]}
