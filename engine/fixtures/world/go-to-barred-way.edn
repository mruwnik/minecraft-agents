;; Card b10c0b4f: go-to walks to no door spot or wall spot when :dig is not an allowed way. A body in a 9x9 stone room (x 12..20, z 12..20,
;; hand-diggable; the goal outside is unseen, so :safe? is overridden to keep the real clock out) with :ways #{:walk} walks its partial path to the wall nearest the goal (within budget) and gives up there (arrived false,
;; nothing dug); with :dig allowed it walks to the wall and clears its way out.
{:defaults
 {:tags [:movement :access :go-to]
  :time :any
  :plot {:height 8}
  :blocks [[:fill [12 -1 12] [20 3 20] "stone" :hollow] [:fill [13 0 13] [19 2 19] "air"]]
  :body {:at [16.5 0 16.5] :settle-s 2 :effects [["resistance" 600 4]] :inventory [["stone_pickaxe" 1]]}
  :limit-s 150}
 :cases
  [{:name "walk-only-room-walks-to-the-wall-and-gives-up"
   :act [[:job (jobs.movement.go-to {:pos #at [26 0 16] :range 1 :checks {:safe? (not (threatened))} :ways #{:walk}})]]
   :expect [{:event {:source :job :kind :stopped :data {:arrived false}} :within-s 40 :of-job true}
            {:no-event {:source :action :kind :done :data {:name "dig"}} :for-s 40 :until {:source :job :kind :stopped :data {:arrived false}}}]
   :after [[:block [20 0 16] "stone"] [:body-near [19.5 0 16.5] 1.5]]
   :limit-s 60}
  {:name "clear-path-allowed-walks-to-the-wall-and-clears-it"
   :act [[:job (jobs.movement.go-to {:pos #at [26 0 16] :range 1 :checks {:safe? (not (threatened))} :ways #{:walk :dig}})]]
   :expect [{:event {:source :job :kind :completed :data {:arrived true}} :within-s 140 :of-job true}]
   :after [[:body-near [26.5 0 16.5] 2]]}]}
