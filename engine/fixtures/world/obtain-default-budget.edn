;; A root obtain's default :spend :job-time (fetch-time/items-s) is priced from its args alone, so it does not cover the walk to a far
;; source or a search: an agent quotes first (./bin/quote) and passes :spend. Bare body at [16.5 0 12.5] facing south (+z); an oak tree at z 52.
;; Should-fail: 4 oak planks under :spend {:job-time 8}, less than the walk to the tree, stop :limit-reached with none made.
{:defaults
 {:tags [:items :obtain :budget :jobs]
  :plot {:height 12 :floor "grass_block" :isolate true :length 32 :width 64}
  :blocks [[:fill [15 4 51] [17 5 53] "oak_leaves[persistent=true]"] [:fill [16 0 52] [16 4 52] "oak_log"]]
  :body {:at [16.5 0 12.5] :settle-s 2 :effects [["resistance" 600 4]]}
  :act [[:rcon "execute as $BODY at @s run tp @s ~ ~ ~ 0 10"] [:until-facing {:yaw 0 :pitch 10} 10]]
  :limit-s 150}
 :cases
 [{:name "four-planks-under-a-budget-shorter-than-the-walk-reach-the-limit"
   :act [[:job (jobs.items.obtain {:worth 2000 :item "oak_planks" :count 4 :explore false :spend {:job-time 8}})]]
   :expect [{:event {:source :job :kind :stopped :data {:kind :limit-reached}} :within-s 60 :of-job true}]
   :after [[:item "oak_planks" 0]]}]}
