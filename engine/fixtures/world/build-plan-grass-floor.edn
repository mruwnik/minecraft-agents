;; Card 496670d7: a built floor of grass where the plan says dirt counts as built, and the floor under a standing door of the plan is never dug.
;; Case 1: grass floor, door and chest of the plan stand: nothing is dug, the build is done.
;; Case 2: the floor want is {:block "dirt" :exact true}: the open grass cells are dug and filled with dirt, the one under the door stays.
{:defaults
 {:tags [:build] :time :any
  :plot {:height 8}
  :body {:at [16.5 0 16.5] :settle-s 2 :effects [["resistance" 600 4]] :inventory [["dirt" 12]]}
  :blocks [[:fill [19 -1 15] [21 -1 17] "grass_block"] [:set [20 -1 18] "grass_block"]
           [:set [20 0 18] "oak_door[facing=south,half=lower,hinge=left,open=false]"]
           [:set [20 1 18] "oak_door[facing=south,half=upper,hinge=left,open=false]"]]
  :limit-s 120}
 :cases
 [{:name "grass-floor-counts-as-dirt-and-the-door-stays"
   :blocks [[:set [19 0 15] "chest[facing=south]"]]
   :plans [{:id "hut" :metadata {:by "$body"}
            :parts [{:id "floor" :box [#at [19 -1 15] #at [21 -1 17]] :want "dirt"}
                    {:id "sill" :cells [#at [20 -1 18]] :want "dirt"}
                    {:id "door" :cells [#at [20 0 18]] :want {:block "oak_door" :facing :south :half :lower}}
                    {:id "door-top" :cells [#at [20 1 18]] :want {:block "oak_door" :facing :south :half :upper}}
                    {:id "chest" :cells [#at [19 0 15]] :want "chest"}]}]
   :act [[:job (jobs.build.from-plan {:plan "$plan:hut"})]]
   :expect [{:event {:source :job :kind :completed :data {:kind :done}} :within-s 90 :of-job true}
            {:no-event {:source :action :kind :started :data {:name "dig"}} :for-s 90 :until {:source :job :kind #{:completed :stopped}}}]
   :after [[:block [20 0 18] "oak_door"] [:block [20 -1 18] "grass_block"] [:block [19 0 15] "chest"]]}
  {:name "exact-dirt-floor-is-dug-but-not-under-the-door"
   :plans [{:id "hut" :metadata {:by "$body"}
            :parts [{:id "floor" :box [#at [19 -1 15] #at [21 -1 17]] :want {:block "dirt" :exact true}}
                    {:id "sill" :cells [#at [20 -1 18]] :want {:block "dirt" :exact true}}
                    {:id "door" :cells [#at [20 0 18]] :want {:block "oak_door" :facing :south :half :lower}}
                    {:id "door-top" :cells [#at [20 1 18]] :want {:block "oak_door" :facing :south :half :upper}}]}]
   :act [[:job (jobs.build.from-plan {:plan "$plan:hut"})]]
   :expect [{:event {:source :action :kind :started :data {:name "dig"}} :within-s 60}
            {:event {:source :job :kind #{:completed :stopped}} :within-s 110 :of-job true}]
   :after [[:block [20 0 18] "oak_door"] [:block [20 -1 18] "grass_block"] [:block [21 -1 16] "dirt"]]}]}
