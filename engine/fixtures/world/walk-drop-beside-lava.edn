;; Card 50474488: a walk never takes a drop whose landing has lava orthogonally beside it, whatever else it priced (a body fell from such a drop into the lava).
;; A 2 high platform at x 8..10; the only way down is east onto the ground cell [11 0 16], lava on its north side, stone on the south; the goal is the next cell east.
;; Should-fail (old code): the walk drops and arrives. Should-succeed: no drop, the body stays on the platform and go-to gives up.
{:defaults
 {:tags [:go-to :walk :lava :jobs]
  :time :any
  :plot {:height 12}
  :blocks [[:fill [0 0 0] [31 5 0] "stone"] [:fill [0 0 31] [31 5 31] "stone"]
           [:fill [0 0 0] [0 5 31] "stone"] [:fill [31 0 0] [31 5 31] "stone"]
           [:fill [8 0 14] [8 5 18] "stone"] [:fill [8 0 14] [31 5 14] "stone"] [:fill [8 0 18] [31 5 18] "stone"]
           [:fill [9 0 15] [10 1 17] "stone"] [:fill [11 0 15] [20 0 15] "lava"] [:fill [11 0 17] [20 0 17] "stone"]]
  :body {:at [9.5 2 16.5] :inventory [["iron_pickaxe" 1] ["iron_sword" 1]]}
  :limit-s 90}
 :cases
 [{:name "drop-onto-a-cell-beside-lava-is-not-taken"
   :act [[:job (jobs.movement.go-to {:pos #at [12 0 16] :range 0 :ways #{:walk}})]]
   :expect [{:event {:source :job :kind :stopped :data {:arrived false}} :within-s 70 :of-job true}]
   :after [[:body-near [9.5 2 16.5] 2]]}
  {:name "drop-onto-a-cell-with-no-lava-is-taken"
   :blocks [[:fill [11 0 15] [20 0 15] "stone"]]
   :act [[:job (jobs.movement.go-to {:pos #at [12 0 16] :range 0 :ways #{:walk}})]]
   :expect [{:event {:source :job :kind :completed :data {:arrived true}} :within-s 70 :of-job true}]
   :after [[:body-near [12.5 0 16.5] 1.5]]}]}
