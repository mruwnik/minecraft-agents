;; jobs.survival.dig-niche (card 7838c2f3): a niche cut into a hillside for the night. A stone hill face at x 22..30 with
;; a pickaxe: sealed. Should-fail, each with the ending {:reason :no-site}: flat ground, a sand hill (falls), a
;; 3-wide hill with water beside the cut; a stone hill with no pickaxe and :fetch false fails :no-tool. Night: run with --allow-time --time-log <shared time log>.
{:defaults
 {:tags [:night :survival]
  :time :night
  :plot {:height 20}
  :register []
  :body {:at [16.5 0 16.5] :effects [["resistance" 600 4]] :inventory [["iron_pickaxe" 1]]}}
 :cases
 [{:name "stone-hill-seals"
   :blocks [[:fill [22 0 8] [30 4 24] "stone"]]
   :act [[:job (jobs.survival.dig-niche {})]]
   :expect [{:event {:source :job :kind :completed} :within-s 90 :of-job true}
            {:no-event {:source :job :kind :stopped} :for-s 90 :until {:source :job :kind :completed}}]
   :limit-s 120}
  {:name "flat-ground-no-site"
   :act [[:job (jobs.survival.dig-niche {})]]
   :expect [{:event {:source :job :kind :stopped :data {:reason :no-site}} :within-s 30 :of-job true}]
   :limit-s 45}
  {:name "sand-hill-no-site"
   :blocks [[:fill [22 0 8] [30 4 24] "sand"]]
   :act [[:job (jobs.survival.dig-niche {})]]
   :expect [{:event {:source :job :kind :stopped :data {:reason :no-site}} :within-s 30 :of-job true}]
   :limit-s 45}
  {:name "water-beside-the-cut-no-site"
   :blocks [[:fill [22 0 15] [30 4 17] "stone"] [:set [23 0 15] "water"]]
   :act [[:job (jobs.survival.dig-niche {})]]
   :expect [{:event {:source :job :kind :stopped :data {:reason :no-site}} :within-s 30 :of-job true}]
   :limit-s 45}
  {:name "stone-without-pickaxe-no-tool"
   :blocks [[:fill [22 0 8] [30 4 24] "stone"]]
   :body {:inventory []}
   :act [[:job (jobs.survival.dig-niche {:fetch false})]]
   :expect [{:event {:source :job :kind :stopped :data {:reason :no-tool}} :within-s 30 :of-job true}]
   :limit-s 45}
  ;; card 6fa0c797: the hill is the footprint of a plan this body made: no niche is cut in it
  {:name "hill-in-the-bodys-own-plan-is-refused"
   :blocks [[:fill [22 0 8] [30 4 24] "stone"]]
   :plans [{:id "hut" :metadata {:by "$body"} :parts [{:id "hill" :box [#at [22 0 8] #at [30 4 24]] :want [:any "stone"]}]}]
   :act [[:job (jobs.survival.dig-niche {})]]
   :expect [{:event {:source :job :kind :stopped :data {:reason :refused}} :within-s 30 :of-job true}]
   :after [[:block [22 0 16] "stone"] [:block [23 0 16] "stone"]]
   :limit-s 45}]}
