;; jobs.farm.till with no hoe: the hoe is fetched (jobs.lib.need); a failed fetch ends the call :stopped :tool (not :completed).
;; Should-fail: no hoe and no chest in view: the fetch finds nothing, the job ends :stopped :tool, nothing tilled.
;; Should-succeed: a seen chest holds a hoe: it is fetched and the 9 grass cells are tilled.
;; The floor is grass (floor y -1 is the ground layer); the 3x3 square is centred at [16 -1 16].
{:defaults
 {:tags [:farm :till :fetch :jobs]
  :time :any
  :plot {:height 16 :floor "grass_block"}
  :body {:at [16.5 0 12.5] :effects [["resistance" 600 4]]}
  :limit-s 90}
 :cases
 [{:name "no-hoe-and-no-chest-stops-tool"
   :act [[:job (jobs.farm.till {:area {:pos #xyz [16 -1 16] :radius 1}})]]
   :expect [{:event {:source :job :kind :stopped :data {:reason :tool}} :within-s 60 :of-job true}
            {:no-event {:source :job :kind :completed} :for-s 60 :until {:source :job :kind :stopped :data {:reason :tool}} :of-job true}]
   :after [[:block [16 -1 16] "grass_block"]]}
  {:name "hoe-in-a-seen-chest-is-fetched-and-tills"
   :blocks [[:set [18 0 12] "chest{Items:[{Slot:0b,id:\"minecraft:stone_hoe\",count:1}]}"]]
   :act [[:job (jobs.farm.till {:area {:pos #xyz [16 -1 16] :radius 1} :ignore-zones? true})]]
   :expect [{:event {:source :job :kind :completed :data {:tilled 9}} :within-s 80 :of-job true}]
   :after [[:block [15 -1 15] "farmland"] [:block [17 -1 17] "farmland"] [:item "stone_hoe" 1]]}
  ;; an empty pack (after a death) and the only trees 28 blocks off, out of sight: it walks there, fells logs, crafts a wooden hoe
  {:name "empty-pack-fetches-a-hoe-from-trees-out-of-sight"
   :time :any
   :plot {:length 80 :width 32 :height 10 :floor "grass_block"}
   :blocks [[:fill [56 0 12] [56 3 12] "oak_log"] [:fill [55 4 11] [57 4 13] "oak_leaves[persistent=true]"]
            [:fill [56 0 18] [56 3 18] "oak_log"] [:fill [55 4 17] [57 4 19] "oak_leaves[persistent=true]"]]
   :act [[:job (jobs.farm.till {:area {:pos #xyz [16 -1 16] :radius 1} :ignore-zones? true})]]
   :expect [{:event {:source :job :kind :completed :data {:tilled 9}} :within-s 280 :of-job true}]
   :after [[:item "wooden_hoe" 1]]
   :limit-s 300}]}
