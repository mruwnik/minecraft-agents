;; Card b40b4dea: go-to escalation. A body shut in (a pit, a sealed room) whose search runs out of land makes a way:
;; pillar (pit + enough blocks), clear-path (a wall up to 3 thick toward the goal), stair up; then it puts back what
;; stair or clear-path dug. :escalate false, bedrock, or open ground never change the world.
;; Card 30615854: it digs only natural terrain outside others' zones, a door or gate beside the enclosure is its way
;; out (no escalation), and a cut escalation's holes stay in the :tidy ledger (restore-broken puts them back).
;; Pit mass: stone x 10..22, z 10..22, y 0..3 (top feet y 4), a 1x1 shaft at x 16, z 16 from y 0 up.
{:defaults
 {:tags [:movement :access]
  :plot {:height 12}
  :blocks [[:fill [10 0 10] [22 3 22] "stone"] [:fill [16 0 16] [16 3 16] "air"]]
  :body {:at [16.5 0 16.5]}
  :limit-s 150}
 :cases
 [{:name "pit-pillar-arrives"
   :body {:inventory [["dirt" 8]]}
   :act [[:job (jobs.movement.go-to {:pos #at [20 4 16] :range 1})]]
   :expect [{:event {:source :job :kind :go-to.escalated :data {:step :pillar}} :within-s 60 :of-job true}
            {:event {:source :job :kind :result :data {:arrived true}} :within-s 120 :of-job true}]
   :after [[:body-near [20.5 4 16.5] 2]]}
  {:name "pit-stair-arrives-and-leaves-holes-for-restore-broken"
   :body {:inventory [["stone_pickaxe" 1]]}
   :act [[:job (jobs.movement.go-to {:pos #at [20 4 16] :range 1})]]
   :expect [{:event {:source :job :kind :go-to.escalated :data {:step :stair}} :within-s 60 :of-job true}
            {:event {:source :job :kind :go-to.restore-skipped} :within-s 120 :of-job true}
            {:event {:source :job :kind :result :data {:arrived true}} :within-s 140 :of-job true}]
   :after [[:block [17 1 16] "air"] [:body-near [20.5 4 16.5] 2]]}
  {:name "sealed-room-clear-path-arrives-and-shuts-the-door"
   ;; a hollow stone room x 12..20, z 12..20, y 0..3 on a stone platform x 8..26 (y -1 is the plot floor), the
   ;; body inside at feet y 1; the goal outside to the east
   :blocks [[:fill [10 0 10] [22 3 22] "air"] [:fill [8 0 8] [26 0 26] "stone"]
            [:fill [12 0 12] [20 3 20] "stone" :hollow]]
   :body {:at [16.5 1 16.5] :inventory [["stone_pickaxe" 1]]}
   :act [[:job (jobs.movement.go-to {:pos #at [24 1 16] :range 1})]]
   :expect [{:event {:source :job :kind :go-to.escalated :data {:step :clear-path}} :within-s 60 :of-job true}
            {:event {:source :job :kind :go-to.restored} :within-s 120 :of-job true}
            {:event {:source :job :kind :result :data {:arrived true}} :within-s 140 :of-job true}]
   :after [[:not-block [20 1 16] "air"] [:not-block [20 2 16] "air"] [:body-near [24.5 1 16.5] 2]]}
  {:name "built-wall-room-is-never-dug"
   ;; the same room of oak planks: a build, never dug; go-to gives up with :escalation {:step :none :why :no-dig}
   :blocks [[:fill [10 0 10] [22 3 22] "air"] [:fill [8 0 8] [26 0 26] "stone"]
            [:fill [12 0 12] [20 3 20] "oak_planks" :hollow]]
   :body {:at [16.5 1 16.5] :inventory [["stone_pickaxe" 1] ["iron_axe" 1] ["dirt" 8]]}
   :act [[:job (jobs.movement.go-to {:pos #at [24 1 16] :range 1})]]
   :expect [{:event {:source :job :kind :result :data {:arrived false :escalation {:step :none :why :no-dig}}} :within-s 90 :of-job true}
            {:no-event {:source :job :kind :go-to.escalated :data {:step :clear-path}} :for-s 90 :until {:source :job :kind :result :data {:arrived false :escalation {:step :none :why :no-dig}}}}
            {:no-event {:source :job :kind :go-to.escalated :data {:step :stair}} :for-s 90 :until {:source :job :kind :result :data {:arrived false :escalation {:step :none :why :no-dig}}}}
            {:no-event {:source :action :kind :done :data {:name "dig"}} :for-s 90 :until {:source :job :kind :result :data {:arrived false :escalation {:step :none :why :no-dig}}}}]
   :after [[:block [20 1 16] "oak_planks"] [:block [20 2 16] "oak_planks"]]}
  {:name "walled-yard-iron-door-in-line-digs-out"
   ;; a stone-walled yard (no roof), a shut iron door in the east wall straight toward the goal: an iron door is a wall,
   ;; not an exit, so the body must dig out (never give up, never end :stuck without escalating)
   :blocks [[:fill [10 0 10] [22 3 22] "air"] [:fill [8 0 8] [26 0 26] "stone"]
            [:fill [12 1 12] [20 3 20] "stone" :outline] [:fill [13 1 13] [19 3 19] "air"]
            [:set [20 1 16] "iron_door[facing=east,half=lower]"] [:set [20 2 16] "iron_door[facing=east,half=upper]"]]
   :body {:at [16.5 1 16.5] :inventory [["stone_pickaxe" 1] ["dirt" 8]]}
   :act [[:job (jobs.movement.go-to {:pos #at [24 1 16] :range 1})]]
   :expect [{:event {:source :job :kind :go-to.escalated} :within-s 60 :of-job true}
            {:event {:source :job :kind :result :data {:arrived true}} :within-s 140 :of-job true}
            {:no-event {:source :job :kind :result :data {:escalation {:why :no-dig}}} :for-s 140 :until {:source :job :kind :result :data {:arrived true}}}]
   :after [[:body-near [24.5 1 16.5] 2] [:block [20 1 16] "iron_door"]]}
  {:name "walled-yard-iron-door-beside-digs-natural-wall"
   ;; the iron door is in the north wall, off the line to the goal: the stone wall east is dug
   :blocks [[:fill [10 0 10] [22 3 22] "air"] [:fill [8 0 8] [26 0 26] "stone"]
            [:fill [12 1 12] [20 3 20] "stone" :outline] [:fill [13 1 13] [19 3 19] "air"]
            [:set [16 1 12] "iron_door[facing=north,half=lower]"] [:set [16 2 12] "iron_door[facing=north,half=upper]"]]
   :body {:at [16.5 1 16.5] :inventory [["stone_pickaxe" 1] ["dirt" 8]]}
   :act [[:job (jobs.movement.go-to {:pos #at [24 1 16] :range 1})]]
   :expect [{:event {:source :job :kind :go-to.escalated} :within-s 60 :of-job true}
            {:event {:source :job :kind :result :data {:arrived true}} :within-s 140 :of-job true}
            {:no-event {:source :job :kind :result :data {:escalation {:why :no-dig}}} :for-s 140 :until {:source :job :kind :result :data {:arrived true}}}]
   :after [[:body-near [24.5 1 16.5] 2] [:block [16 1 12] "iron_door"]]}
  {:name "oak-door-with-doors-never-digs"
   ;; stone room, an oak door in the east wall and :doors :never (a wall for the walk): the room is dug out, no :no-dig
   :blocks [[:fill [10 0 10] [22 3 22] "air"] [:fill [8 0 8] [26 0 26] "stone"]
            [:fill [12 0 12] [20 3 20] "stone" :hollow]
            [:set [20 1 16] "oak_door[facing=east,half=lower]"] [:set [20 2 16] "oak_door[facing=east,half=upper]"]]
   :body {:at [16.5 1 16.5] :inventory [["stone_pickaxe" 1]]}
   :act [[:job (jobs.movement.go-to {:pos #at [24 1 16] :range 1 :doors :never})]]
   :expect [{:event {:source :job :kind :go-to.escalated} :within-s 60 :of-job true}
            {:event {:source :job :kind :result :data {:arrived true}} :within-s 140 :of-job true}
            {:no-event {:source :job :kind :result :data {:escalation {:why :no-dig}}} :for-s 140 :until {:source :job :kind :result :data {:arrived true}}}]
   :after [[:body-near [24.5 1 16.5] 2]]}
  {:name "cobblestone-wall-room-is-never-dug"
   :blocks [[:fill [10 0 10] [22 3 22] "air"] [:fill [8 0 8] [26 0 26] "stone"]
            [:fill [12 0 12] [20 3 20] "cobblestone" :hollow]]
   :body {:at [16.5 1 16.5] :inventory [["stone_pickaxe" 1] ["dirt" 8]]}
   :act [[:job (jobs.movement.go-to {:pos #at [24 1 16] :range 1})]]
   :expect [{:event {:source :job :kind :result :data {:arrived false :escalation {:step :none :why :no-dig}}} :within-s 90 :of-job true}
            {:no-event {:source :job :kind :go-to.escalated :data {:step :clear-path}} :for-s 90 :until {:source :job :kind :result :data {:arrived false :escalation {:step :none :why :no-dig}}}}
            {:no-event {:source :action :kind :done :data {:name "dig"}} :for-s 90 :until {:source :job :kind :result :data {:arrived false :escalation {:step :none :why :no-dig}}}}]
   :after [[:block [20 1 16] "cobblestone"] [:block [20 2 16] "cobblestone"]]}
  {:name "oak-log-wall-room-is-never-dug"
   :blocks [[:fill [10 0 10] [22 3 22] "air"] [:fill [8 0 8] [26 0 26] "stone"]
            [:fill [12 0 12] [20 3 20] "oak_log" :hollow]]
   :body {:at [16.5 1 16.5] :inventory [["stone_pickaxe" 1] ["iron_axe" 1] ["dirt" 8]]}
   :act [[:job (jobs.movement.go-to {:pos #at [24 1 16] :range 1})]]
   :expect [{:event {:source :job :kind :result :data {:arrived false :escalation {:step :none :why :no-dig}}} :within-s 90 :of-job true}
            {:no-event {:source :job :kind :go-to.escalated :data {:step :clear-path}} :for-s 90 :until {:source :job :kind :result :data {:arrived false :escalation {:step :none :why :no-dig}}}}
            {:no-event {:source :action :kind :done :data {:name "dig"}} :for-s 90 :until {:source :job :kind :result :data {:arrived false :escalation {:step :none :why :no-dig}}}}]
   :after [[:block [20 1 16] "oak_log"] [:block [20 2 16] "oak_log"]]}
  {:name "pillar-refused-by-others-plan-stairs-out-and-leaves-holes"
   ;; another plan's footprint holds the shaft cells above the floor: the pillar's places are refused, so the body stairs
   ;; out east and its holes stay for restore-broken
   :plans [{:id "other" :parts [{:id "shaft" :cells [#at [16 0 16] #at [16 1 16] #at [16 2 16] #at [16 3 16]] :want [:any "cobblestone"]}]}]
   :body {:inventory [["dirt" 8] ["stone_pickaxe" 1]]}
   :act [[:job (jobs.movement.go-to {:pos #at [20 4 16] :range 1})]]
   :expect [{:event {:source :job :kind :go-to.escalated :data {:step :stair}} :within-s 90 :of-job true}
            {:event {:source :job :kind :go-to.restore-skipped} :within-s 140 :of-job true}
            {:event {:source :job :kind :result :data {:arrived true}} :within-s 160 :of-job true}]
   :after [[:block [17 1 16] "air"] [:body-near [20.5 4 16.5] 2]]
   :limit-s 200}
  {:name "stair-wall-in-others-plan-is-never-dug"
   ;; natural stone, but another plan's footprint covers the whole east side of the shaft: nothing may be dug
   :plans [{:id "other" :parts [{:id "wall" :cells [#at [17 0 16] #at [17 1 16] #at [17 2 16] #at [17 3 16]
                                                     #at [15 0 16] #at [15 1 16] #at [15 2 16] #at [15 3 16]
                                                     #at [16 0 17] #at [16 1 17] #at [16 2 17] #at [16 3 17]
                                                     #at [16 0 15] #at [16 1 15] #at [16 2 15] #at [16 3 15]]
                                           :want [:any "stone"]}]}]
   :body {:inventory [["stone_pickaxe" 1]]}
   :act [[:job (jobs.movement.go-to {:pos #at [20 4 16] :range 1})]]
   :expect [{:event {:source :job :kind :result :data {:arrived false :escalation {:step :none :why :no-dig}}} :within-s 90 :of-job true}
            {:no-event {:source :action :kind :done :data {:name "dig"}} :for-s 90 :until {:source :job :kind :result :data {:arrived false :escalation {:step :none :why :no-dig}}}}]
   :after [[:block [17 1 16] "stone"] [:body-near [16.5 0 16.5] 1]]}
  {:name "trapped-again-digs-its-own-cobble"
   ;; the first stair out is put back with cobblestone (what stone drops); the body is moved into the shaft again and the
   ;; second go-to digs those own cobble cells (not natural, but go-to put them there)
   :body {:inventory [["stone_pickaxe" 1]]}
   :act [[:job (jobs.movement.go-to {:pos #at [20 4 16] :range 1})]
         [:await {:source :job :kind :result :data {:arrived true}} 150]
         [:wait-s 15]
         [:rcon "execute positioned $X $Y $Z run tp $BODY ~16 ~ ~16"]
         [:wait-s 3]
         [:job (jobs.movement.go-to {:pos #at [20 4 17] :range 1})]
         [:wait-s 60]]
   :expect [{:event {:source :job :kind :go-to.restored} :within-s 150 :of-job true}]
   :after [[:body-near [20.5 4 17.5] 2]]
   :limit-s 300}
  {:name "own-shelter-does-not-dig"
   :time :night
   ;; dig-in seals the body in a pit; a go-to from inside its own shelter gives up instead of digging out
   :plot {:height 20}
   :blocks [[:fill [8 0 8] [24 9 24] "dirt"]]
   :body {:at [16.5 10 16.5] :effects [["resistance" 600 4]] :inventory [["stone_pickaxe" 1] ["iron_shovel" 1]]}
   :act [[:job (jobs.survival.dig-in {})]
         [:await {:source :job :kind :dig-in.sealed} 90]
         [:job (jobs.movement.go-to {:pos #at [22 10 16] :range 1})]]
   :expect [{:event {:source :job :kind :result :data {:arrived false}} :within-s 120 :of-job true}
            {:no-event {:source :job :kind :go-to.escalated} :for-s 120 :until {:source :job :kind :result :data {:arrived false}}}]
   :limit-s 160}
  {:name "stair-cut-short-keeps-its-holes-in-the-ledger"
   ;; the body dies after the first stair step: the job is cancelled, nothing is refilled under it, and the dug cells
   ;; stay as :tidy entries with :escalation true (check worlds/.../memory.edn) for restore-broken
   :body {:inventory [["stone_pickaxe" 1]]}
   :act [[:job (jobs.movement.go-to {:pos #at [20 4 16] :range 1})]
         [:await {:source :job :kind :stair.step} 60]
         [:kill-body]]
   :expect [{:event {:source :job :kind :go-to.escalated :data {:step :stair}} :within-s 60 :of-job true}
            {:no-event {:source :job :kind :go-to.restored} :for-s 20}]
   :after [[:block [17 1 16] "air"] [:block [17 2 16] "air"]]}
  {:name "escalate-false-gives-up-unchanged"
   :body {:inventory [["dirt" 8] ["stone_pickaxe" 1]]}
   :act [[:job (jobs.movement.go-to {:pos #at [20 4 16] :range 1 :escalate false})]]
   :expect [{:event {:source :job :kind :result :data {:arrived false :reason :unreachable}} :within-s 60 :of-job true}
            {:no-event {:source :job :kind :go-to.escalated} :for-s 60 :until {:source :job :kind :result :data {:arrived false :reason :unreachable}}}]
   :after [[:block [16 0 16] "air"] [:block [17 1 16] "stone"] [:body-near [16.5 0 16.5] 1]]}
  {:name "bedrock-pit-gives-up-with-a-reason"
   :blocks [[:fill [14 0 14] [18 3 18] "bedrock"] [:fill [16 0 16] [16 3 16] "air"]]
   :body {:inventory [["stone_pickaxe" 1]]}
   :act [[:job (jobs.movement.go-to {:pos #at [20 4 16] :range 1})]]
   :expect [{:event {:source :job :kind :result :data {:arrived false :escalation {:step :none}}} :within-s 60 :of-job true}
            {:no-event {:source :action :kind :done :data {:name "dig"}} :for-s 60 :until {:source :job :kind :result :data {:arrived false :escalation {:step :none}}}}]}
  {:name "open-ground-tower-never-escalates"
   ;; open plot, a 5-high stone column whose top no walk reaches: the body is not shut in, so nothing is built or dug
   :blocks [[:fill [10 0 10] [22 3 22] "air"] [:fill [24 0 16] [24 4 16] "stone"]]
   :body {:inventory [["dirt" 8] ["stone_pickaxe" 1]]}
   :act [[:job (jobs.movement.go-to {:pos #at [24 5 16] :range 0})]]
   :expect [{:event {:source :job :kind :result :data {:arrived false}} :within-s 60 :of-job true}
            {:no-event {:source :job :kind :go-to.escalated} :for-s 60 :until {:source :job :kind :result :data {:arrived false}}}]}]}
