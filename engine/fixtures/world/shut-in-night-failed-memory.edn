;; jobs.survival.shut-in :for :night, :shut-in-failed memory across cases that keep the body's memory (card 79be43a4; see the README
;; row of jobs.survival.shut-in: a way that failed on a site leaves {:pos :way :reason} (none for a lack of blocks or of a tool, the
;; quote says so), and that way is dropped while one lies within 8 blocks). The cases share one plot (plots are leased first-free, so
;; run this file alone with --first-plot set high, e.g. 300, to keep positions the same) and run in order: c1 writes a reasoned
;; (:no-floor) entry, c2 (a second register group: the body is restarted, its memory seeded with the same entry) drops the pit, c3
;; elsewhere on the plot (> 8 blocks) is not blocked. The 10 minute expiry is not run.
{:defaults
 {:tags [:survival :shut-in :memory]
  :time :any
  :keep-memory true
  :blocks [[:set [4 0 4] "torch"] [:set [4 0 28] "torch"] [:set [28 0 28] "torch"] [:set [28 0 4] "torch"]
           [:set [16 0 4] "torch"] [:set [16 0 28] "torch"] [:set [4 0 16] "torch"] [:set [28 0 16] "torch"]
           [:fill [2 -6 2] [9 -1 9] "stone"] [:fill [20 5 20] [30 5 30] "stone"]]
  :plot {:height 12}
  :body {:at [5.5 0 5.5] :effects [["resistance" 600 4]]}}
 :cases
 [{:name "c1-no-floor-entry-written"
   :keep-memory false
   :body {:at [25.5 6 25.5] :inventory [["stone_pickaxe" 1]]}
   :act [[:job (jobs.survival.shut-in {:ways #{:room :walls :pit} :for :night})]]
   :expect [{:event {:source :job :kind :stopped :data {:reason :no-way}} :within-s 30 :of-job true}]
   :after [[:block [25 5 25] "stone"]]
   :limit-s 40}
  {:name "c2-reasoned-entry-drops-the-pit-after-restart"
   ;; seeds its own entry (the one c1 writes), so it does not depend on the case before it
   :keep-memory false
   :memory [{:kind :shut-in-failed :data {:pos #xyz [25 6 25] :way :pit :reason :no-floor}}]
   :register [{:trigger :hostile-near :args {:radius 8 :ranged-radius 16}
               :job (jobs.survival.respond-to-hostile)}]
   :body {:at [25.5 6 25.5] :inventory [["stone_pickaxe" 1] ["cobblestone" 16]]}
   :act [[:job (jobs.survival.shut-in {:ways #{:pit} :for :night})]]
   :expect [{:event {:source :job :kind :stopped :data {:reason :no-way}} :within-s 30 :of-job true}
            {:no-event {:source :action :kind :started :data {:name "dig"}} :for-s 30 :until {:source :job :kind :stopped :data {:reason :no-way}}}]
   :after [[:block [25 5 25] "stone"]]
   :limit-s 40}
  {:name "c3-entry-elsewhere-does-not-block"
   :register [{:trigger :hostile-near :args {:radius 8 :ranged-radius 16}
               :job (jobs.survival.respond-to-hostile)}]
   :body {:at [5.5 0 5.5] :inventory [["stone_pickaxe" 1]]}
   :act [[:job (jobs.survival.shut-in {:ways #{:room :walls :pit} :for :night})]]
   ;; the pit under the stone mass is roofed by the mass itself: nothing is placed, so no shut-in.sealed
   :expect [{:event {:source :job :kind :completed :data {:name "jobs.survival.shut-in"}} :within-s 60 :of-job true}
            {:no-event {:source :job :kind :stopped :data {:reason :no-way}} :for-s 20 :until {:source :job :kind :completed :data {:name "jobs.survival.shut-in"}}}]
   :limit-s 70}]}
