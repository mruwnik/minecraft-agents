;; Card 253377a0: a flight from a ranged mob takes cover. A NoAI skeleton (it never shoots) 6 east of the body.
;; leaf-cover: an oak_leaves wall at x 14, z 18..23 south-west of the body; the step 30 degrees south of due west ends at
;; [11 0 19], behind the leaves (they stop arrows); it keeps to their shadow (x 5..11, z 19..22) until out of line 4 s.
;; open-runs: no leaves, the flight runs due west along z 16 until 16 from the skeleton, out of that shadow.
;; low-health-seals: ::hide-health 20 via :settings (every health counts as low) in the open with cobblestone: it seals in where it stands.
;; pond-goes-round: a pond (x 6..13, z 12..21, 2 deep) straight away west, dry ground north and south: the flight
;; goes round it, never into the water (a swim is slow; the death this card came from).
{:defaults
 {:tags [:hostile :survival]
  :time :any
  :mobs :keep
  :body {:at [16.5 0 16.5] :effects [["resistance" 600 4]]}
  :limit-s 60}
 :cases
 [{:name "leaf-cover"
   :blocks [[:fill [14 0 18] [14 2 23] "oak_leaves[persistent=true]"]]
   :act [[:summon "skeleton" [22.5 0 16.5] "{NoAI:1b,equipment:{head:{id:\"minecraft:iron_helmet\",count:1}}}"]
         [:job (jobs.survival.respond-to-hostile {})]]
   :expect [{:event {:source :job :kind :completed} :within-s 40 :of-job true}]
   :after [[:body-near [8.5 0 20.5] 4.5]]}
  {:name "open-runs"
   :act [[:summon "skeleton" [22.5 0 16.5] "{NoAI:1b,equipment:{head:{id:\"minecraft:iron_helmet\",count:1}}}"]
         [:job (jobs.survival.respond-to-hostile {})]]
   :expect [{:event {:source :job :kind :completed} :within-s 40 :of-job true}]
   :after [[:body-far [8.5 0 20.5] 4.5]]}
  {:name "low-health-seals"
   :plot {:light :sky}
   :body {:inventory [["cobblestone" 20]]}
   :act [[:summon "skeleton" [22.5 0 16.5] "{NoAI:1b,equipment:{head:{id:\"minecraft:iron_helmet\",count:1}}}"]
         [:job (jobs.survival.respond-to-hostile {:settings {:jobs.survival.respond.state/hide-health 20}})]]
   :expect [{:event {:source :job :kind :retreat_sealed} :within-s 30}]
   :after [[:body-near [16.5 0 16.5] 1.5]]}
  {:name "pond-goes-round"
   :blocks [[:fill [5 -3 11] [14 -1 22] "stone"]
            [:fill [6 -2 12] [13 -1 21] "water"]]
   :act [[:summon "skeleton" [22.5 0 16.5] "{NoAI:1b,equipment:{head:{id:\"minecraft:iron_helmet\",count:1}}}"]
         [:job (jobs.survival.respond-to-hostile {})]]
   :expect [{:event {:source :job :kind :completed} :within-s 40 :of-job true}]
   :after [[:body-far [10 0 16.5] 5.5]]}]}
