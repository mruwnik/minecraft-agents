;; Rounds migration of leave-vehicle (card 8aa49e24): one run each, never :continue.
;; Card 94c0f053: darkness of the body's own cell holds nothing aboard: leave-vehicle binds no exposure check.
;; Should-succeed: leave-vehicle gets off a boat on land (completed, landed :dry), twice (boat, minecart), and on an unlit plot.
{:defaults
 {:tags [:survival :leave-vehicle] :time :any
  :plot {:height 8 :floor "stone"}
  :body {:at [10.5 0 16.5]}
  :limit-s 90}
 :cases
 [{:name "leave-boat-on-land"
   :act [[:summon "oak_boat" [10.5 0 16.5] "{}"]
         [:rcon "execute at $BODY run ride $BODY mount @e[type=oak_boat,tag=wt,$BOX,limit=1]"]
         [:job (jobs.movement.leave-vehicle {})]]
   :expect [{:event {:source :job :kind :completed :data {:landed :dry}} :within-s 40 :of-job true}
            {:no-event {:source :job :kind :stopped :data {:reason :dismount-failed}} :for-s 40 :until {:source :job :kind :completed :data {:landed :dry}} :of-job true}]}
  {:name "leave-minecart-on-land"
   :act [[:summon "minecart" [10.5 0 16.5] "{}"]
         [:rcon "execute at $BODY run ride $BODY mount @e[type=minecart,tag=wt,$BOX,limit=1]"]
         [:job (jobs.movement.leave-vehicle {})]]
   :expect [{:event {:source :job :kind :completed :data {:landed :dry}} :within-s 40 :of-job true}
            {:no-event {:source :job :kind :stopped :data {:reason :dismount-failed}} :for-s 40 :until {:source :job :kind :completed :data {:landed :dry}} :of-job true}]}
  {:name "leave-boat-on-dark-land"
   :plot {:height 8 :floor "stone" :light :dark}
   :act [[:summon "oak_boat" [10.5 0 16.5] "{}"]
         [:rcon "execute at $BODY run ride $BODY mount @e[type=oak_boat,tag=wt,$BOX,limit=1]"]
         [:job (jobs.movement.leave-vehicle {})]]
   :expect [{:event {:source :job :kind :completed :data {:landed :dry}} :within-s 40 :of-job true}
            {:no-event {:source :job :kind :waiting} :for-s 40 :until {:source :job :kind :completed :data {:landed :dry}} :of-job true}]}]}
