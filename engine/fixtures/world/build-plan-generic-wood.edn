;; Cards a3fe349e (generic wood names), f5c60c61 (an oak plank fetch fells oak, not whatever log is nearest): jobs.build.from-plan.
;; A plan want of `planks` (also `logs`, `wooden_stairs` ...) is met by any species; one species is chosen per plan (the one carried most) and the
;; result says which (:wood). A species name (oak_planks) stays exact.
;; Should-succeed: planks wanted, birch_planks carried: built in birch, nothing fetched; oak_planks wanted with a birch log column nearer and an oak
;; column farther: the oak is felled, the birch column stands.
;; 20 plank cells need 5 logs: two 4-log trees are felled (8 logs), the two farther trees stand.
;; Should-fail: oak_planks wanted, only birch_planks carried, :ways #{:carried}: waits :no-items needing oak_planks, nothing placed (a look at the unseen cells comes first).
{:defaults
 {:tags [:build :fetch] :time :any
  :plot {:height 8}
  :body {:at [16.5 0 16.5] :settle-s 2 :effects [["resistance" 600 4]]}
  :limit-s 150}
 :cases
 [{:name "generic-planks-are-built-in-the-carried-species"
   :body {:inventory [["birch_planks" 4]]}
   :plans [{:id "floor" :metadata {:by "$body"} :parts [{:id "p" :cells [#at [14 0 14] #at [15 0 14]] :want "planks"}]}]
   :act [[:job (jobs.build.from-plan {:plan "$plan:floor"})]]
   :expect [{:event {:source :job :kind :completed :data {:missing []}} :within-s 100 :of-job true}
            {:no-event {:source :job :kind :child_started :data {:slot :need}} :for-s 60 :until {:source :job :kind :completed}}]
   :after [[:block [14 0 14] "birch_planks"] [:block [15 0 14] "birch_planks"] [:item "birch_planks" 2]]}
  {:name "species-name-stays-exact-and-stops-short"
   :body {:inventory [["birch_planks" 4]]}
   :plans [{:id "floor" :metadata {:by "$body"} :parts [{:id "p" :cells [#at [14 0 14] #at [15 0 14]] :want "oak_planks"}]}]
   :act [[:job (jobs.build.from-plan {:plan "$plan:floor" :ways #{:carried}})]]
   :expect [{:event {:source :job :kind :waiting :data {:reason :no-items :needs #{{"oak_planks" 2} {:oak_planks 2}}}} :within-s 40 :of-job true}
            {:no-event {:source :job :kind :child_started :data {:slot :need}} :for-s 30}]
   :after [[:not-block [14 0 14] "birch_planks"] [:not-block [14 0 14] "oak_planks"] [:item "birch_planks" 4]]
   :limit-s 60}
  {:name "oak-planks-fetch-fells-oak-and-spares-the-nearer-birch"
   :blocks [[:fill [19 0 16] [19 3 16] "birch_log"] [:set [19 4 16] "birch_leaves[persistent=true]"]
            [:fill [24 0 14] [24 3 14] "oak_log"] [:set [24 4 14] "oak_leaves[persistent=true]"]]
   :plans [{:id "floor" :metadata {:by "$body"} :parts [{:id "p" :cells [#at [14 0 14] #at [15 0 14]] :want "oak_planks"}]}]
   :act [[:job (jobs.build.from-plan {:plan "$plan:floor"})]]
   :expect [{:event {:source :job :kind :child_started :data {:slot :need}} :within-s 30 :of-job true}
            {:event {:source :job :kind :completed :data {:missing []}} :within-s 140 :of-job true}]
   :after [[:block [14 0 14] "oak_planks"] [:block [15 0 14] "oak_planks"] [:block [19 0 16] "birch_log"] [:block [19 3 16] "birch_log"]]}
  {:name "plank-floor-fells-only-the-trees-it-needs"
   :blocks [[:fill [20 0 16] [20 3 16] "oak_log"] [:set [20 4 16] "oak_leaves[persistent=true]"]
            [:fill [23 0 16] [23 3 16] "oak_log"] [:set [23 4 16] "oak_leaves[persistent=true]"]
            [:fill [26 0 16] [26 3 16] "oak_log"] [:set [26 4 16] "oak_leaves[persistent=true]"]
            [:fill [29 0 16] [29 3 16] "oak_log"] [:set [29 4 16] "oak_leaves[persistent=true]"]]
   :plans [{:id "floor" :metadata {:by "$body"} :parts [{:id "p" :cells [#at [6 0 10] #at [6 0 11] #at [6 0 12] #at [6 0 13] #at [7 0 10] #at [7 0 11] #at [7 0 12] #at [7 0 13] #at [8 0 10] #at [8 0 11] #at [8 0 12] #at [8 0 13] #at [9 0 10] #at [9 0 11] #at [9 0 12] #at [9 0 13] #at [10 0 10] #at [10 0 11] #at [10 0 12] #at [10 0 13]] :want "oak_planks"}]}]
   :act [[:job (jobs.build.from-plan {:plan "$plan:floor"})]]
   :expect [{:event {:source :job :kind :completed :data {:missing []}} :within-s 200 :of-job true}]
   :after [[:block [6 0 10] "oak_planks"] [:block [10 0 13] "oak_planks"] [:block [26 0 16] "oak_log"] [:block [29 0 16] "oak_log"]]
   :limit-s 220}]}
