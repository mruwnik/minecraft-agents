;; Cards a50ce32a/1b7f6a3e (mine :shaft: a declared mineshaft is descended and branched from), 644a840a (its cells stay open: the
;; mine's own tidy and mend do not refill them), e609bad0 (no usable shaft: the stair is suggested, :shaft :required refuses).
;; Soil 4 deep over stone (the plot walled in dirt so neighbours' stone is not walked to); body at [16.5 0 16.5] with a stone pickaxe.
;; A mineshaft plan "s" by the body: stair from [16 0 16] east down to y -4 (4 steps; the stone starts at y -5).
;; Should-succeed: with the plan the run says "via shaft s", the stair cells stay air; without it the end text suggests plans.mjs mineshaft.
;; Cards 1b7f6a3e/5ee1bdc0: foreign-zone shaft unused (used with :ignore-zones?), unreachable top, a stair that stops is marked failed.
;; Should-fail: :shaft :required with no plan ends :no-shaft, got 0, nothing dug.
{:defaults
 {:tags [:mine :mineshaft :stair :jobs] :time :any
  :plot {:height 12 :floor "dirt"}
  :blocks [[:fill [0 -9 0] [31 -5 31] "stone"] [:fill [0 -4 0] [31 -1 31] "dirt"] [:fill [0 -4 0] [31 6 0] "dirt"] [:fill [0 -4 31] [31 6 31] "dirt"]
           [:fill [0 -4 0] [0 6 31] "dirt"] [:fill [31 -4 0] [31 6 31] "dirt"]]
  :body {:at [16.5 0 16.5] :effects [["resistance" 600 4]] :inventory [["stone_pickaxe" 1]]}
  :limit-s 150}
 :cases
 [{:name "declared-shaft-is-descended-and-its-cells-stay-open"
   :plans [{:id "s" :kind :mineshaft :metadata {:by "$body"}
            :parts [{:id "stair" :stair {:from #at [16 0 16] :heading :east :to-y #y -4} :want :clear}]}]
   :act [[:job (jobs.gather.mine {:torch-interval 0 :block "stone" :count 4 :direction :east :tunnel-length 8 :radius 8})]]
   :expect [{:event {:source :job :kind :mine.shaft :data {:shaft [:contains "-s"] :branch 1}} :within-s 100 :of-job true}
            {:event {:source :job :kind #{:completed :stopped} :data {:got [:>= 4] :text [:contains "via shaft test-"]}} :within-s 130 :of-job true}]
   :after [[:not-block [17 -1 16] "dirt"] [:not-block [19 -3 16] "dirt"] [:item "cobblestone" [:>= 4]]]}
  {:name "no-shaft-stair-is-cut-and-declaring-it-is-suggested"
   :act [[:job (jobs.gather.mine {:torch-interval 0 :block "stone" :count 4 :direction :east :tunnel-length 8 :radius 8})]]
   :expect [{:event {:source :job :kind #{:completed :stopped} :data {:got [:>= 4] :shaft-suggest {:to-y [:any]} :text [:contains "plans.mjs mineshaft"]}} :within-s 130 :of-job true}]
   :after [[:item "cobblestone" [:>= 4]]]}
  {:name "shaft-required-without-a-shaft-digs-nothing"
   :act [[:job (jobs.gather.mine {:torch-interval 0 :block "stone" :count 4 :direction :east :tunnel-length 8 :radius 8 :shaft :required})]]
   :expect [{:event {:source :job :kind #{:completed :stopped} :data {:got 0 :reason :no-shaft}} :within-s 60 :of-job true}]
   :after [[:block [17 -1 16] "dirt"] [:block [16 -1 16] "dirt"] [:item "cobblestone" 0]]}
  ;; Card 65ac2209: a body standing on a step of a half-dug shaft (steps 1-2 cut) continues the stair from there: 2 steps, not 4 from the top.
  {:name "half-dug-shaft-continued-from-the-step-the-body-stands-on"
   :blocks [[:fill [17 -1 16] [17 1 16] "air"] [:fill [18 -2 16] [18 0 16] "air"]]
   :body {:at [18.5 -2 16.5]}
   :plans [{:id "s" :kind :mineshaft :metadata {:by "$body"}
            :parts [{:id "stair" :stair {:from #at [16 0 16] :heading :east :to-y #y -4} :want :clear}]}]
   :act [[:job (jobs.gather.mine {:torch-interval 0 :block "stone" :count 4 :direction :east :tunnel-length 8 :radius 8})]]
   :expect [{:event {:source :job :kind #{:completed :stopped} :data {:got [:>= 4] :text [:contains "-s (stair 2 steps"]}} :within-s 130 :of-job true}]
   :after [[:item "cobblestone" [:>= 4]]]}
  ;; Card a50ce32a: a shaft whose top cannot be reached ends mine.no-shaft :unreachable and the usual descent goes on.
  {:name "unreachable-shaft-top-ends-no-shaft-and-the-usual-descent-follows"
   :blocks [[:fill [5 0 5] [7 1 7] "bedrock"] [:fill [6 0 6] [6 1 6] "air"] [:set [6 2 6] "bedrock"]]
   :plans [{:id "s" :kind :mineshaft :metadata {:by "$body"}
            :parts [{:id "stair" :stair {:from #at [6 0 6] :heading :east :to-y #y -4} :want :clear}]}]
   :act [[:job (jobs.gather.mine {:torch-interval 0 :block "stone" :count 4 :direction :east :tunnel-length 8 :radius 8})]]
   :expect [{:event {:source :job :kind :mine.no-shaft :data {:reason :unreachable}} :within-s 120 :of-job true}
            {:event {:source :job :kind #{:completed :stopped} :data {:got [:>= 4]}} :within-s 180 :of-job true}]
   :after [[:block [6 0 6] "air"] [:item "cobblestone" [:>= 4]]]
   :limit-s 200}
  ;; Card 5ee1bdc0: an older own stair declared as a shaft that stops (bedrock in its first step) is marked failed; mine does not walk
  ;; into it again and descends the usual way (north from the shaft top).
  {:name "older-stair-that-stops-is-marked-failed-and-the-descent-goes-on"
   :blocks [[:set [7 -1 6] "bedrock"] [:set [7 -2 6] "bedrock"]]
   :plans [{:id "s" :kind :mineshaft :metadata {:by "$body"}
            :parts [{:id "stair" :stair {:from #at [6 0 6] :heading :east :to-y #y -4} :want :clear}]}]
   :act [[:job (jobs.gather.mine {:torch-interval 0 :block "stone" :count 4 :direction :north :tunnel-length 8 :radius 8})]]
   :expect [{:event {:source :job :kind :mine.no-shaft :data {:shaft [:contains "-s"]}} :within-s 120 :of-job true}
            {:event {:source :job :kind #{:completed :stopped} :data {:got [:>= 4]}} :within-s 180 :of-job true}]
   :after [[:block [7 -1 6] "bedrock"] [:item "cobblestone" [:>= 4]]]
   :limit-s 200}
  ;; Card 1b7f6a3e: a shaft whose top lies in another's zone is not used (social rule); :ignore-zones? uses it.
  {:name "shaft-in-a-foreign-zone-is-not-used"
   :zones [{:name "z" :min [4 -4 4] :max [10 6 10] :owner "Other"}]
   :plans [{:id "s" :kind :mineshaft :metadata {:by "SomeoneElse"}
            :parts [{:id "stair" :stair {:from #at [6 0 6] :heading :east :to-y #y -4} :want :clear}]}]
   :act [[:job (jobs.gather.mine {:torch-interval 0 :block "stone" :count 4 :direction :east :tunnel-length 8 :radius 8})]]
   :expect [{:event {:source :job :kind :mine.no-shaft :message [:contains "mine uses no mineshaft"]} :within-s 100 :of-job true}
            {:event {:source :job :kind #{:completed :stopped} :data {:got [:>= 4]}} :within-s 180 :of-job true}]
   :after [[:block [7 -1 6] "dirt"] [:item "cobblestone" [:>= 4]]]
   :limit-s 200}
  {:name "shaft-in-a-foreign-zone-is-used-with-ignore-zones"
   :zones [{:name "z" :min [4 -4 4] :max [10 6 10] :owner "Other"}]
   :plans [{:id "s" :kind :mineshaft :metadata {:by "SomeoneElse"}
            :parts [{:id "stair" :stair {:from #at [6 0 6] :heading :east :to-y #y -4} :want :clear}]}]
   :act [[:job (jobs.gather.mine {:torch-interval 0 :block "stone" :count 4 :direction :east :tunnel-length 8 :radius 8 :ignore-zones? true})]]
   :expect [{:event {:source :job :kind #{:completed :stopped} :data {:got [:>= 4] :text [:contains "via shaft test-"]}} :within-s 180 :of-job true}]
   :after [[:not-block [7 -1 6] "dirt"] [:item "cobblestone" [:>= 4]]]
   :limit-s 200}]}
