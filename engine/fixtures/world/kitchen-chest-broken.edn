;; Card ff4f9ae7: the kitchen asks can-run? between steps; a chest cell the body has seen hold another block ends the pass never :chest-gone.
;; Furnace at [20 0 14] (facing west), chest at [12 0 18], both in view of the body at [16.5 0 16.5]; it carries 1 raw beef and 2 coal.
;; Should-succeed: with the chest intact the pass smelts the beef and stores it (completed).
;; Should-fail: the chest is broken to air once the smelt child has started; the step after it ends the pass :chest-gone, nothing stored.
{:defaults
 {:tags [:items :kitchen :storage :jobs]
  :time :any
  :plot {:height 8}
  :blocks [[:set [20 0 14] "furnace[facing=west]"] [:set [12 0 18] "chest[facing=east]"]]
  :body {:at [16.5 0 16.5] :yaw 270 :inventory [["beef" 1] ["coal" 2]] :effects [["resistance" 600 4]] :settle-s 2}
  :limit-s 150}
 :cases
 [{:name "intact-chest-completes-the-pass"
   :act [[:job (jobs.items.kitchen {:furnace #xyz [20 0 14] :chest #xyz [12 0 18] :stock {"cooked_beef" 1} :ways #{:carried}})]]
   :expect [{:event {:source :job :kind :completed} :within-s 130 :of-job true}]
   :after [[:item "cooked_beef" 0]]}
  {:name "chest-broken-mid-pass-ends-chest-gone"
   :act [[:job (jobs.items.kitchen {:furnace #xyz [20 0 14] :chest #xyz [12 0 18] :stock {"cooked_beef" 1} :ways #{:carried}})]
         [:await {:source :job :kind :child_started :data {:slot :smelt-beef}} 60]
         [:rcon "execute positioned $X $Y $Z run setblock ~12 ~ ~18 air"]]
   :expect [{:event {:source :job :kind :stopped :data {:reason :chest-gone}} :within-s 130 :of-job true}
            {:no-event {:source :job :kind :completed} :for-s 20 :of-job true :until {:source :job :kind :stopped}}]
   :after [[:not-block [12 0 18] "chest"] [:item "cooked_beef" [:>= 1]]]}]}
