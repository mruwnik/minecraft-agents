;; Card 6a1a0fc3: how far a go-to drops follows the body's fall enchantments and health (jobs.lib.cost/fall-profile).
;; A platform N high fills x 1..15 of the plot, the body on top at x 8.5, the goal on the floor east of its edge, walls all round.
;; The cases cap the walk's :max-damage (default budget at full health is 7 hp, which pays for a 6 drop): 1.5 hp for feather falling IV, which takes a 4 or 5 block drop, not 6 (1.56 hp); 0.5 hp for plain boots, which take 3 at most; at health 2 go-to goes over its budget (given floor 1), then takes the 4 drop.
;; The ramp cases have steps down at z 28..30 (x 13..15), so a body that will not drop walks round.
{:defaults
 {:tags [:movement] :time :any
  :plot {:height 14}
  :blocks [[:fill [0 0 0] [31 9 0] "stone"] [:fill [0 0 31] [31 9 31] "stone"] [:fill [0 0 0] [0 9 31] "stone"] [:fill [31 0 0] [31 9 31] "stone"]]
  :body {:at [8.5 4 16.5]}
  :limit-s 90}
 :cases
 [{:name "feather-falling-iv-takes-a-5-drop"
   :body {:at [8.5 5 16.5]}
   :blocks [[:fill [1 0 1] [15 4 30] "stone"]]
   :act [[:rcon "item replace entity $BODY armor.feet with minecraft:diamond_boots[enchantments={feather_falling:4}]"] [:until [:cli "observe" ["$body" "--world" "$world" "equipment" "--raw"] {:equipment {:feet {:name "diamond_boots"}}}] 10]
         [:job (jobs.movement.go-to {:pos #at [22 0 16] :range 1 :ways #{:walk :clear-seal} :spend {:health 1.5}})]]
   :expect [{:event {:source :job :kind :completed :data {:arrived true}} :within-s 60 :of-job true}]
   :after [[:body-near [22.5 0 16.5] 2]]}
  {:name "feather-falling-iv-refuses-a-6-drop"
   :body {:at [8.5 6 16.5]}
   :blocks [[:fill [1 0 1] [15 5 30] "stone"]]
   :act [[:rcon "item replace entity $BODY armor.feet with minecraft:diamond_boots[enchantments={feather_falling:4}]"] [:until [:cli "observe" ["$body" "--world" "$world" "equipment" "--raw"] {:equipment {:feet {:name "diamond_boots"}}}] 10]
         [:job (jobs.movement.go-to {:pos #at [22 0 16] :range 1 :ways #{:walk :clear-seal} :spend {:health 1.5}})]]
   :expect [{:event {:source :job :kind :stopped :data {:arrived false}} :within-s 60 :of-job true}
            {:no-event {:source :body :kind :hurt :data {:causes ["fall"]}} :for-s 30 :until {:source :job :kind #{:completed :stopped}}}]
   :after [[:body-far [22.5 0 16.5] 4]]}
  {:name "plain-boots-refuse-a-4-drop"
   :blocks [[:fill [1 0 1] [15 3 30] "stone"]]
   :act [[:rcon "item replace entity $BODY armor.feet with minecraft:diamond_boots"] [:until [:cli "observe" ["$body" "--world" "$world" "equipment" "--raw"] {:equipment {:feet {:name "diamond_boots"}}}] 10]
         [:job (jobs.movement.go-to {:pos #at [22 0 16] :range 1 :ways #{:walk :clear-seal} :spend {:health 0.5}})]]
   :expect [{:event {:source :job :kind :stopped :data {:arrived false}} :within-s 60 :of-job true}
            {:no-event {:source :body :kind :hurt :data {:causes ["fall"]}} :for-s 30 :until {:source :job :kind #{:completed :stopped}}}]
   :after [[:body-far [22.5 0 16.5] 4]]}
  {:name "plain-boots-walk-round-a-4-drop-by-the-ramp"
   :blocks [[:fill [1 0 1] [15 3 30] "stone"] [:fill [13 3 28] [15 3 30] "air"] [:fill [14 2 28] [15 2 30] "air"] [:fill [15 1 28] [15 1 30] "air"]]
   :act [[:rcon "item replace entity $BODY armor.feet with minecraft:diamond_boots"] [:until [:cli "observe" ["$body" "--world" "$world" "equipment" "--raw"] {:equipment {:feet {:name "diamond_boots"}}}] 10]
         [:job (jobs.movement.go-to {:pos #at [22 0 16] :range 1 :ways #{:walk :clear-seal} :spend {:health 0.5}})]]
   :expect [{:event {:source :job :kind :completed :data {:arrived true}} :within-s 80 :of-job true}
            {:no-event {:source :body :kind :hurt :data {:causes ["fall"]}} :for-s 80 :until {:source :job :kind #{:completed :stopped}}}]
   :after [[:body-near [22.5 0 16.5] 2]]}
  {:name "feather-falling-iv-low-health-still-arrives-over-the-4-drop"
   ;; one 18 hp magic damage (no armour or invulnerability-frame discount, unlike two instant_damage effects) leaves 2 hp, under the walk's floor: the planner refuses the drop, so with a given :floor {:health 1} go-to goes over its budget
   ;; (all but 1 hp, go-to.health), and a 4 drop with feather falling IV costs 0.5 hp, so it arrives
   :blocks [[:fill [1 0 1] [15 3 30] "stone"]]
   :act [[:rcon "item replace entity $BODY armor.feet with minecraft:diamond_boots[enchantments={feather_falling:4}]"]
         [:rcon "damage $BODY 18 minecraft:magic"] [:until-rcon "data get entity $BODY Health" "data: [0-3]\\." 5]
         [:job (jobs.movement.go-to {:pos #at [22 0 16] :range 1 :ways #{:walk :clear-seal} :floor {:health 1}})]]
   :expect [{:event {:source :job :kind :completed :data {:arrived true}} :within-s 80 :of-job true}]
   :after [[:body-near [22.5 0 16.5] 2]]}]}
