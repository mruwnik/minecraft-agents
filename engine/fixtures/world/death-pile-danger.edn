;; jobs.survival.recover-drops owns the danger it priced (card 417e96f3): a zombie without AI stands by the respawn point,
;; priced cheap (:danger-overrides 0.01: the unarmed respawned body multiplies a zombie's price by its fist factor, 1 would be dearer than the pile); the trip goes past it with no :danger decline and collects the pile.
{:defaults
 {:tags [:survival :death :jobs]
  :body {:at [26.5 0 26.5] :spawnpoint [4 0 4] :effects [["resistance" 600 4]]
         :inventory [["raw_iron" 24] ["cobblestone" 64] ["cobblestone" 36]]}
  :mobs :keep
  :act [[:kill-body]
        [:await {:source :body :kind :respawned} 30]
        [:until [:memory {:entries {:deaths [{:data {:pos [:any]}}]}}] 15]
        [:summon "zombie" [8.5 0 4.5] "{NoAI:1b}"]
        [:until-seen {:entity "zombie"} 10]
        [:job (jobs.survival.recover-drops {:danger-overrides {"zombie" 0.01}})]]
  :limit-s 150}
 :cases
 [{:name "zombie-near-is-priced-and-the-pile-fetched"
   :expect [{:event {:source :job :kind :child_started :data {:slot :go}} :within-s 60}
            {:no-event {:source :job :kind :stopped :data {:reason :danger}} :for-s 130 :until {:source :job :kind :completed :data {:decision :collected}}}
            {:event {:source :job :kind :completed :data {:decision :collected}} :within-s 130}]
   :after [[:item "raw_iron" 24]]}]}
