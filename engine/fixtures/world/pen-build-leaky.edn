;; Card eda1e677 (carded 8e79cb89): jobs.build.pen with a plan whose fence ring has a gap (cell [10 0 12] is not in the plan, and
;; nothing is placed that the plan does not ask for) ends (with :ways #{:build}, no patch) nothing-possible :leak (data :closed? false), the stopped event's data names the leak
;; (:reason :leak), and no :completed. The ring has a gate at [14 0 12]: the body ends inside it and walks out by the gate (a gateless ring stops :inside). Should-succeed: the full ring closes (:completed, closed). Should-fail: the gap.
{:defaults
 {:tags [:build :pen] :time :any
  :plot {:height 8 :floor "stone"}
  :body {:at [12.5 0 12.5] :settle-s 2 :inventory [["oak_fence" 16] ["oak_fence_gate" 1]] :effects [["resistance" 600 4]]}
  :limit-s 90}
 :cases
 [{:name "full-ring-closes"
   :plans [{:id "ring" :metadata {:by "$body"}
            :parts [{:id "n" :box [#at [10 0 10] #at [14 0 10]] :want "oak_fence"}
                    {:id "s" :box [#at [10 0 14] #at [14 0 14]] :want "oak_fence"}
                    {:id "w" :box [#at [10 0 11] #at [10 0 13]] :want "oak_fence"}
                    {:id "e1" :box [#at [14 0 11] #at [14 0 11]] :want "oak_fence"}
                    {:id "g" :box [#at [14 0 12] #at [14 0 12]] :want "oak_fence_gate"}
                    {:id "e2" :box [#at [14 0 13] #at [14 0 13]] :want "oak_fence"}]}]
   :act [[:job (jobs.build.pen {:plan "$plan:ring" :ways #{:carried :patch}})]]
   :expect [{:event {:source :job :kind :completed} :within-s 80 :of-job true}
            {:no-event {:source :job :kind :stopped :data {:kind :nothing-possible}} :for-s 80 :until {:source :job :kind :completed}}]
   :after [[:block [10 0 12] "oak_fence"]]}
  {:name "ring-with-a-gap-is-leaky"
   :plans [{:id "ring" :metadata {:by "$body"}
            :parts [{:id "n" :box [#at [10 0 10] #at [14 0 10]] :want "oak_fence"}
                    {:id "s" :box [#at [10 0 14] #at [14 0 14]] :want "oak_fence"}
                    {:id "w1" :box [#at [10 0 11] #at [10 0 11]] :want "oak_fence"}
                    {:id "w2" :box [#at [10 0 13] #at [10 0 13]] :want "oak_fence"}
                    {:id "e1" :box [#at [14 0 11] #at [14 0 11]] :want "oak_fence"}
                    {:id "g" :box [#at [14 0 12] #at [14 0 12]] :want "oak_fence_gate"}
                    {:id "e2" :box [#at [14 0 13] #at [14 0 13]] :want "oak_fence"}]}]
   :act [[:job (jobs.build.pen {:plan "$plan:ring" :ways #{:build}})]]
   :expect [{:event {:source :job :kind :stopped :data {:kind :nothing-possible :reason :leak}} :within-s 80 :of-job true}
            {:no-event {:source :job :kind :completed} :for-s 80 :until {:source :job :kind :stopped}}]
   :after [[:not-block [10 0 12] "oak_fence"] [:item "oak_fence" 2]]}
  ;; Card 3f51b63a: the same ring left to the default ways has the gap patched with a fence of the plan's kind.
  {:name "ring-with-a-gap-is-patched"
   :plans [{:id "ring" :metadata {:by "$body"}
            :parts [{:id "n" :box [#at [10 0 10] #at [14 0 10]] :want "oak_fence"}
                    {:id "s" :box [#at [10 0 14] #at [14 0 14]] :want "oak_fence"}
                    {:id "w1" :box [#at [10 0 11] #at [10 0 11]] :want "oak_fence"}
                    {:id "w2" :box [#at [10 0 13] #at [10 0 13]] :want "oak_fence"}
                    {:id "e1" :box [#at [14 0 11] #at [14 0 11]] :want "oak_fence"}
                    {:id "g" :box [#at [14 0 12] #at [14 0 12]] :want "oak_fence_gate"}
                    {:id "e2" :box [#at [14 0 13] #at [14 0 13]] :want "oak_fence"}]}]
   :act [[:job (jobs.build.pen {:plan "$plan:ring" :ways #{:carried :patch}})]]
   :expect [{:event {:source :job :kind :completed} :within-s 90 :of-job true}]
   :after [[:block [10 0 12] "oak_fence"]]}
  ;; Card 3f51b63a (f449d14b): a tree inside the ring (leaves reach the fence tops) is cleared first; the pen closes and the ground stays.
  {:name "a-tree-inside-the-ring-is-cleared"
   :blocks [[:fill [11 0 13] [11 1 13] "oak_log"] [:fill [11 1 12] [11 1 12] "oak_leaves"] [:fill [10 1 13] [10 1 13] "oak_leaves"] [:fill [11 2 13] [11 2 13] "oak_leaves"]]
   :plans [{:id "ring" :metadata {:by "$body"}
            :parts [{:id "n" :box [#at [10 0 10] #at [14 0 10]] :want "oak_fence"}
                    {:id "s" :box [#at [10 0 14] #at [14 0 14]] :want "oak_fence"}
                    {:id "w" :box [#at [10 0 11] #at [10 0 13]] :want "oak_fence"}
                    {:id "e1" :box [#at [14 0 11] #at [14 0 11]] :want "oak_fence"}
                    {:id "g" :box [#at [14 0 12] #at [14 0 12]] :want "oak_fence_gate"}
                    {:id "e2" :box [#at [14 0 13] #at [14 0 13]] :want "oak_fence"}]}]
   :act [[:job (jobs.build.pen {:plan "$plan:ring" :ways #{:carried :patch}})]]
   :expect [{:event {:source :job :kind :completed} :within-s 80 :of-job true}]
   :after [[:not-block [11 0 13] "oak_log"] [:not-block [11 1 12] "oak_leaves"] [:block [10 0 12] "oak_fence"]]}
  ;; Card f84912c5: with the fences carried (8, the ring needs 7 and a gate) the pen is placed from the bag at once; nothing is fetched
  ;; or searched for first (no obtain.exploring).
  {:name "carried-fences-are-placed-before-any-fetch"
   :body {:at [11.5 0 11.5] :inventory [["oak_fence" 8] ["oak_fence_gate" 1]]}
   :plans [{:id "ring" :metadata {:by "$body"}
            :parts [{:id "n" :box [#at [10 0 10] #at [12 0 10]] :want "oak_fence"}
                    {:id "s" :box [#at [10 0 12] #at [12 0 12]] :want "oak_fence"}
                    {:id "w" :box [#at [10 0 11] #at [10 0 11]] :want "oak_fence"}
                    {:id "g" :box [#at [12 0 11] #at [12 0 11]] :want "oak_fence_gate"}]}]
   :act [[:job (jobs.build.pen {:plan "$plan:ring"})]]
   :expect [{:event {:source :job :kind :completed} :within-s 80 :of-job true}
            {:no-event {:source :job :kind :obtain.exploring} :for-s 80 :until {:source :job :kind :completed}}]
   :after [[:block [10 0 11] "oak_fence"] [:block [12 0 11] "oak_fence_gate"]]}]}
