;; A villager the body saw stays listed where it was seen when a wall goes up and only its sound is left (:remembered,
;; with :pos), not turned into a position-less :heard row. Should-succeed.
{:defaults
 {:tags [:village :sensing :agent-tools]
  :time :any
  :plot {:floor "grass_block" :height 8}
  :body {:at [10.5 0 16.5] :yaw 270 :settle-s 2}
  :limit-s 90}
 :cases
 [{:name "walled-off-villager-stays-remembered-at-its-place"
   :act [[:summon "villager" [16.5 0 16.5] "{NoAI:1b}"]
         [:until [:cli "entities" ["$body" "--world" "$world" "--type" "villager"] {:items [:has {:sense :seen}]}] 30]
         [:rcon "execute at $BODY run fill ~3 ~ ~-4 ~3 ~3 ~4 stone"]
         [:wait-s 6]
         [:until [:cli "entities" ["$body" "--world" "$world" "--type" "villager"] {:items [:has {:sense :remembered}]}] 20]]
   :expect [{:no-event {:level :error} :for-s 3}]
   :after [[:body-near [10.5 0 16.5] 4]]}]}
