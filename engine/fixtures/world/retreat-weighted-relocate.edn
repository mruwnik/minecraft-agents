;; Card c98846e6 (commit 986e9a7e): retreat flees from the weighted set of dangers (1/distance), leans to a home only
;; within :home-range (64), and night walks to a pit site within 16 blocks when dig-in refused for hollow ground
;; (shut-in.relocated, up to its site limit: a one-thick floor looks solid), then holds exposed (shelter.exposed). Mobs are NoAI and helmeted (they never hurt, no sun burn).
;; Night: the relocation cases need --allow-time --time-log <the shared time log>; the two flee cases run at any hour (east-west is a 64-wide dark cell: the flight prefers lit ground when the body is buried, so it goes 25 blocks). The flee cases seed a :home 1000 blocks east (unloaded).
;; Every flight and relocation must stay on the plot grid: a plot can sit at the grid's edge, past which there is no floor.
;; east-west: the zombies stand 2 north of the body, so the flight goes south (into the grid), never north off it.
;; hollow-floor: the hollow starts at x 10, so the first relocation (9 west, x 7) is solid ground inside the plot.
;; hollow-floor-2: from x 20 the relocations go x 11 (hollow, fails) then x 2: solid and one block in from the plot edge (the cell past the edge is air, which a pit with no blocks cannot wall).
{:defaults
 {:tags [:night :survival :retreat] :time :night
  :plot {:height 12}
  :blocks [[:set [4 0 4] "torch"] [:set [4 0 28] "torch"] [:set [28 0 4] "torch"] [:set [28 0 28] "torch"]
           [:set [16 0 4] "torch"] [:set [16 0 28] "torch"] [:set [4 0 16] "torch"] [:set [28 0 16] "torch"]]
  :body {:at [16.5 0 16.5] :settle-s 3}}
 :cases
 [{:name "flee-two-zombies-east-west"
   :time :any
   :plot {:width 64 :light :dark}
   :register [{:trigger :hostile-near :args {:radius 8 :ranged-radius 16}
               :job (jobs.survival.respond-to-hostile {:radius 8 :ranged-radius 16})}]
   :memory [{:kind :home :data {:pos #xyz [21000 150 20016]}}]
   :act [[:summon "zombie" [10.5 0 14.5] "{NoAI:1b,equipment:{head:{id:\"minecraft:iron_helmet\",count:1}}}"]
         [:summon "zombie" [23.5 0 14.5] "{NoAI:1b,equipment:{head:{id:\"minecraft:iron_helmet\",count:1}}}"]
         [:wait-s 25]] ; hold: the flight takes this long to show its distance
   :expect [{:event {:source :reflex :kind :fired :context {:reflex-id :hostile-near}} :within-s 10}
            {:no-event {:kind :failed} :for-s 20}]
   :after [[:body-far [16.5 0 16.5] 25]]
   :limit-s 50}
  {:name "flee-two-zombies-north-south-east-ahead"
   :time :any
   :register [{:trigger :hostile-near :args {:radius 8 :ranged-radius 16}
               :job (jobs.survival.respond-to-hostile {:radius 8 :ranged-radius 16})}]
   :memory [{:kind :home :data {:pos #xyz [21000 150 20016]}}]
   :act [[:summon "zombie" [16.5 0 11.5] "{NoAI:1b,equipment:{head:{id:\"minecraft:iron_helmet\",count:1}}}"]
         [:summon "zombie" [20.5 0 24.5] "{NoAI:1b,equipment:{head:{id:\"minecraft:iron_helmet\",count:1}}}"]
         [:wait-s 25]] ; hold: the flight takes this long to show its distance
   :expect [{:event {:source :reflex :kind :fired :context {:reflex-id :hostile-near}} :within-s 10}
            {:no-event {:kind :failed} :for-s 20}]
   :after [[:body-far [16.5 0 16.5] 15]]
   :limit-s 50}
  {:name "hollow-floor-relocates-and-digs-in"
   :blocks [[:fill [0 -8 0] [31 -1 31] "stone"] [:fill [10 -3 6] [26 -2 26] "air"]]
   :body {:inventory [["stone_pickaxe" 1] ["cobblestone" 8]] :effects [["resistance" 600 4]]}
   :act [[:job (jobs.survival.night {})]]
   :expect [{:event {:source :job :kind :shut-in.relocated} :within-s 60 :of-job true}
            {:event {:source :job :kind :shut-in.sealed} :within-s 120 :of-job true}]
   :limit-s 150}
  {:name "hollow-floor-relocates-and-digs-in-2"
   :blocks [[:fill [0 -8 0] [31 -1 31] "stone"] [:fill [8 -3 4] [28 -2 28] "air"]]
   :body {:at [20.5 0 14.5] :inventory [["stone_pickaxe" 1]] :effects [["resistance" 600 4]]}
   :act [[:job (jobs.survival.night {})]]
   :expect [{:event {:source :job :kind :shut-in.relocated} :within-s 60 :of-job true}
            {:event {:source :job :kind :shut-in.sealed} :within-s 120 :of-job true}]
   :limit-s 150}
  {:name "no-pit-site-holds-exposed"
   :blocks [[:fill [0 -8 0] [31 -2 31] "air"]]
   :body {:inventory [["stone_pickaxe" 1]] :effects [["resistance" 600 4]]}
   :act [[:job (jobs.survival.night {:settings {:jobs.survival.night.sites/flee-radius 0}})]]
   :expect [{:event {:source :job :kind :shelter.exposed} :within-s 60 :of-job true}
            {:no-event {:source :job :kind :shut-in.relocated :data {:sites [[:any] [:any] [:any] [:any]]}} :for-s 60}
            {:no-event {:source :job :kind :completed} :for-s 60}]
   :limit-s 90}]}
