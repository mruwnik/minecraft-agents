;; survival.get-food and the :hungry trigger at hp 2 (fragile: health 6 or less) with no food carried: walks to known food are priced by go-to's start check
;; (a body that cannot heal may spend all but 1 hp); only a search of unknown ground waits for light with no hostile known near.
;; Hunger is drained by RCON (food 9-10), then `damage` sets hp 2.
;; Should-succeed: a known chest of bread 24 blocks off: walked to and eaten from; raw beef is eaten raw with no furnace walk or dig; a cow 8 blocks off is hunted.
{:defaults
 {:tags [:survival :hungry :get-food :fragile]
  :time :any
  :plot {:height 6}
  :register [{:trigger :hostile-near :args {:radius 8 :ranged-radius 16}
              :job (jobs.survival.respond-to-hostile)}
             {:trigger :hungry :persistence :cooldown :cooldown-s 30 :job (jobs.survival.get-food {:carry 0})}]
  :body {:at [4.5 0 16.5] :yaw 270 :settle-s 2}
  :act [[:rcon "effect give $BODY minecraft:hunger 5 243 true"] [:until-effect-gone "hunger" 30]
        [:rcon "damage $BODY 18 minecraft:generic"]]
  :limit-s 90}
 :cases
 [{:name "walks-to-the-known-chest-and-eats"
   :blocks [[:set [28 0 16] "chest{Items:[{Slot:0b,id:\"minecraft:bread\",count:8}]}"]]
   :memory [{:kind :food-source :data {:pos #xyz [28 0 16] :kind :chest}}]
   :expect [{:event {:source :reflex :kind :ended :context {:reflex-id :hungry} :data {:outcome :done}} :within-s 80}]
   :after [[:body-near [27.5 0 16.5] 3] [:item "bread" [:>= 1]]]}
  {:name "raw-beef-is-eaten-instead-of-a-walk-to-a-known-furnace"
   :blocks [[:set [28 0 16] "furnace[facing=west]"]]
   :memory [{:kind :furnace :data {:pos #xyz [28 0 16]} :policy {:cap 1 :ttl :forever}}]
   :body {:inventory [["beef" 5] ["coal" 2]]}
   :register [{:trigger :hostile-near :args {:radius 8 :ranged-radius 16}
               :job (jobs.survival.respond-to-hostile)}]
   :act [[:job (jobs.survival.get-food {:carry 0 :explore false})]]
   :expect [{:no-event {:source :job :kind :child_started :data {:slot :cook}} :for-s 40}]
   :after [[:item "beef" [:<= 2]] [:body-far [28.5 0 16.5] 6]]}
  {:name "raw-beef-is-eaten-instead-of-mining-for-a-furnace"
   :blocks [[:fill [8 0 14] [12 2 18] "stone"]]
   :body {:inventory [["beef" 5] ["wooden_pickaxe" 1]]}
   :register [{:trigger :hostile-near :args {:radius 8 :ranged-radius 16}
               :job (jobs.survival.respond-to-hostile)}]
   :act [[:job (jobs.survival.get-food {:carry 0 :explore false})]]
   :expect [{:no-event {:source :job :kind :child_started :data {:slot :cook}} :for-s 40}]
   :after [[:item "beef" [:<= 2]] [:body-near [4.5 0 16.5] 4]]}
  {:name "hungry-body-with-nothing-to-eat-hunts-the-cow-nearby"
   :body {:inventory [["iron_sword" 1]]}
   :act [[:summon "cow" [12.5 0 16.5] "{NoAI:1b}"] [:until-seen {:entity "cow"} 10]
         [:job (jobs.survival.get-food {})]]
   :expect [{:event {:source :job :kind :food.killed} :within-s 70}]}]}
