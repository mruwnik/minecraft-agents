;; survival.get-food and the :hungry trigger at hp 2 (fragile: health 6 or less) with no food carried: it walks out only on a calm
;; day (not at night, past the dawn grace, no hostile known within 40) and never past a known hostile that would likely kill it.
;; The body faces east (yaw 270): the creepers are summoned east of it and a silent one is seen only in its view cone.
;; Hunger is drained by RCON (food 9-10), then `damage` sets hp 2.
;; Should-succeed: a calm day, a known chest of bread 24 blocks off: walked to and eaten from; raw beef is cooked at a known furnace
;; 24 blocks off.
;; Should-fail: at night the trigger never fires; a creeper known on the route stops get-food condition-failed :too-dangerous with
;; the body staying put; a creeper by the furnace makes it eat the raw beef instead of cooking (no cooking).
{:defaults
 {:tags [:survival :hungry :get-food :fragile]
  :time :day
  :plot {:height 6}
  :register [{:trigger :hostile-near :args {:radius 8 :ranged-radius 16}
              :job (jobs.survival.respond-to-hostile {:radius 8 :ranged-radius 16})}
             {:trigger :hungry :persistence :cooldown :cooldown-s 30 :job (jobs.survival.get-food {})}]
  :body {:at [4.5 0 16.5] :yaw 270 :settle-s 2}
  :act [[:rcon "effect give $BODY minecraft:hunger 5 243 true"] [:until-effect-gone "hunger" 30]
        [:rcon "damage $BODY 18 minecraft:generic"]]
  :limit-s 90}
 :cases
 [{:name "night-hungry-waits-for-a-calm-day"
   :time :night
   :blocks [[:set [28 0 16] "chest{Items:[{Slot:0b,id:\"minecraft:bread\",count:8}]}"]]
   :memory [{:kind :food-source :data {:pos #xyz [28 0 16] :kind :chest}}]
   :expect [{:no-event {:source :reflex :kind :fired :context {:reflex-id :hungry}} :for-s 40}]
   :after [[:body-near [4.5 0 16.5] 4] [:item "bread" 0]]}
  {:name "calm-day-walks-to-the-known-chest-and-eats"
   :blocks [[:set [28 0 16] "chest{Items:[{Slot:0b,id:\"minecraft:bread\",count:8}]}"]]
   :memory [{:kind :food-source :data {:pos #xyz [28 0 16] :kind :chest}}]
   :expect [{:event {:source :reflex :kind :ended :context {:reflex-id :hungry} :data {:outcome :done}} :within-s 80}]
   :after [[:body-near [27.5 0 16.5] 3] [:item "bread" [:>= 1]]]}
  {:name "creeper-by-the-route-is-too-dangerous"
   :blocks [[:set [28 0 16] "chest{Items:[{Slot:0b,id:\"minecraft:bread\",count:8}]}"]]
   :memory [{:kind :food-source :data {:pos #xyz [28 0 16] :kind :chest}}]
   :register [{:trigger :hostile-near :args {:radius 8 :ranged-radius 16}
               :job (jobs.survival.respond-to-hostile {:radius 8 :ranged-radius 16})}]
   :act [[:summon "creeper" [16.5 0 16.5] "{NoAI:1b,Silent:1b}"] [:wait-s 2]
         [:job (jobs.survival.get-food {})]]
   :expect [{:event {:source :job :kind :stopped :data {:kind :condition-failed :reason :too-dangerous}} :within-s 60 :of-job true}]
   :after [[:body-near [4.5 0 16.5] 4] [:item "bread" 0]]}
  {:name "raw-beef-is-cooked-at-the-furnace-on-a-calm-day"
   :blocks [[:set [28 0 16] "furnace[facing=west]"]]
   :memory [{:kind :furnace :data {:pos #xyz [28 0 16]} :policy {:cap 1 :ttl :forever}}]
   :body {:inventory [["beef" 2] ["coal" 2]]}
   :expect [{:event {:source :job :kind :child_ended :data {:slot :cook :ending {:kind :done}}} :within-s 80}]}
  {:name "creeper-by-the-furnace-eats-the-beef-raw"
   :blocks [[:set [28 0 16] "furnace[facing=west]"]]
   :memory [{:kind :furnace :data {:pos #xyz [28 0 16]} :policy {:cap 1 :ttl :forever}}]
   :body {:inventory [["beef" 2] ["coal" 2]]}
   ;; the job is submitted below, after the damage: the hungry trigger would fire at food 8, before the damage lands, and call it as a healthy body; the 2 s wait lets the body see the hp 2 and the creeper before the call
   :register [{:trigger :hostile-near :args {:radius 8 :ranged-radius 16}
               :job (jobs.survival.respond-to-hostile {:radius 8 :ranged-radius 16})}]
   :act [[:summon "creeper" [26.5 0 18.5] "{NoAI:1b,Silent:1b}"] [:wait-s 2]
         [:job (jobs.survival.get-food {})]]
   :expect [{:no-event {:source :job :kind :child_ended :data {:slot :cook :ending {:kind :done}}} :for-s 40}]
   :after [[:item "beef" [:<= 1]] [:body-near [4.5 0 16.5] 6]]}]}
