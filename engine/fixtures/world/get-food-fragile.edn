;; survival.get-food and the :hungry trigger at hp 2 (fragile: health 6 or less) with no food carried: in the dark or with a hostile known near
;; it walks only to food within 16 blocks, and never past a known hostile that would likely kill it.
;; The body faces east (yaw 270): the creepers are summoned east of it and a silent one is seen only in its view cone.
;; Hunger is drained by RCON (food 9-10), then `damage` sets hp 2.
;; Should-succeed: a calm day, a known chest of bread 24 blocks off: walked to and eaten from; raw beef is eaten raw with no furnace walk or dig; a cow 8 blocks off is hunted.
;; Should-fail: at night the 24-block chest is out of its walk (:too-dangerous, body stays); a creeper known on the route ends a get-food call condition-failed :too-dangerous with the body staying put.
{:defaults
 {:tags [:survival :hungry :get-food :fragile]
  :time :day :time-why :dawn-decision
  :plot {:height 6}
  :register [{:trigger :hostile-near :args {:radius 8 :ranged-radius 16}
              :job (jobs.survival.respond-to-hostile)}
             {:trigger :hungry :persistence :cooldown :cooldown-s 30 :job (jobs.survival.get-food {})}]
  :body {:at [4.5 0 16.5] :yaw 270 :settle-s 2}
  :act [[:rcon "effect give $BODY minecraft:hunger 5 243 true"] [:until-effect-gone "hunger" 30]
        [:rcon "damage $BODY 18 minecraft:generic"]]
  :limit-s 90}
 :cases
 [{:name "night-hungry-does-not-walk-to-a-far-chest"
   :time :night
   :blocks [[:set [28 0 16] "chest{Items:[{Slot:0b,id:\"minecraft:bread\",count:8}]}"]]
   :memory [{:kind :food-source :data {:pos #xyz [28 0 16] :kind :chest}}]
   :expect [{:event {:source :job :kind :stopped :data {:reason :too-dangerous}} :within-s 40}]
   :after [[:body-near [4.5 0 16.5] 4] [:item "bread" 0]]}
  {:name "calm-day-walks-to-the-known-chest-and-eats"
   :blocks [[:set [28 0 16] "chest{Items:[{Slot:0b,id:\"minecraft:bread\",count:8}]}"]]
   :memory [{:kind :food-source :data {:pos #xyz [28 0 16] :kind :chest}}]
   :expect [{:event {:source :reflex :kind :ended :context {:reflex-id :hungry} :data {:outcome :done}} :within-s 80}]
   :after [[:body-near [27.5 0 16.5] 3] [:item "bread" [:>= 1]]]}
  {:name "creeper-by-the-route-is-too-dangerous"
   :blocks [[:set [28 0 16] "chest{Items:[{Slot:0b,id:\"minecraft:bread\",count:8}]}"]]
   :memory [{:kind :food-source :data {:pos #xyz [28 0 16] :kind :chest}}]
   :register [{:trigger :hostile-near :args {:radius 8 :ranged-radius 16}
               :job (jobs.survival.respond-to-hostile)}]
   :act [[:summon "creeper" [16.5 0 16.5] "{NoAI:1b,Silent:1b}"] [:until-seen {:entity "creeper"} 10]
         [:job (jobs.survival.get-food {})]]
   ;; called by hand or by the hungry reflex, the call ends condition-failed :too-dangerous
   :expect [{:event {:source :job :kind :stopped :data {:reason :too-dangerous}} :within-s 60 :of-job true}]
   :after [[:body-near [4.5 0 16.5] 4] [:item "bread" 0]]}
  {:name "raw-beef-is-eaten-instead-of-a-walk-to-a-known-furnace"
   :blocks [[:set [28 0 16] "furnace[facing=west]"]]
   :memory [{:kind :furnace :data {:pos #xyz [28 0 16]} :policy {:cap 1 :ttl :forever}}]
   :body {:inventory [["beef" 5] ["coal" 2]]}
   :register [{:trigger :hostile-near :args {:radius 8 :ranged-radius 16}
               :job (jobs.survival.respond-to-hostile)}]
   :act [[:job (jobs.survival.get-food {:carry 0 :explore false})]]
   :expect [{:no-event {:source :job :kind :child_started :data {:slot :cook}} :for-s 40}]
   :after [[:item "beef" [:<= 2]] [:body-far [28.5 0 16.5] 6]]}
  {:name "raw-beef-is-eaten-instead-of-mining-for-a-furnace"
   :blocks [[:fill [8 0 14] [12 2 18] "stone"]]
   :body {:inventory [["beef" 5] ["wooden_pickaxe" 1]]}
   :register [{:trigger :hostile-near :args {:radius 8 :ranged-radius 16}
               :job (jobs.survival.respond-to-hostile)}]
   :act [[:job (jobs.survival.get-food {:carry 0 :explore false})]]
   :expect [{:no-event {:source :job :kind :child_started :data {:slot :cook}} :for-s 40}]
   :after [[:item "beef" [:<= 2]] [:body-near [4.5 0 16.5] 4]]}
  {:name "hungry-body-with-nothing-to-eat-hunts-the-cow-nearby"
   :body {:inventory [["iron_sword" 1]]}
   :act [[:summon "cow" [12.5 0 16.5] "{NoAI:1b}"] [:until-seen {:entity "cow"} 10]
         [:job (jobs.survival.get-food {})]]
   :expect [{:event {:source :job :kind :food.killed} :within-s 70}]}]}
