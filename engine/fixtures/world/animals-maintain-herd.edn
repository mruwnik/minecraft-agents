;; Card ae6272fc (D33): animals.maintain with fewer than 2 adults in the box asks herd for a pair before breeding.
;; Pen: oak fence ring x 18..24, z 13..19, inside 19..23 x 14..18, gate west at [18 0 16] (as herd-lure.edn). One cow inside, one outside the gate.
;; Should-succeed: the second cow is brought in and maintain ends done with 2 adults.
{:defaults
 {:tags [:animals :herd :jobs]
  :time :any
  :plot {:floor "grass_block"}
  :blocks [[:fill [18 0 13] [24 0 19] "oak_fence"]
           [:fill [19 0 14] [23 0 18] "air"]
           [:set [18 0 16] "oak_fence_gate[facing=east,open=false]"]]
  :body {:at [12.5 0 16.5] :yaw 270 :inventory [["wheat" 4]] :effects [["resistance" 900 4]]}
  :limit-s 300}
 :cases
 [{:name "one-adult-in-the-pen-gets-a-second-brought"
   :act [[:summon "cow" [21.5 0 16.5]]
         [:summon "cow" [10.5 0 18.5]]
         [:job (jobs.animals.maintain {:worth 1200 :mob "cow" :target 2 :box {:min #xyz [19 0 14] :max #xyz [23 0 18]}})]]
   :expect [{:event {:source :job :kind :completed :data {:kind :done :adults 2}} :within-s 240 :of-job true}]
   :after [[:entities "type=cow,tag=wt" [[19 0 14] [23 1 18]] 2]
           [:block [18 0 16] "oak_fence_gate[open=false]"]]}
  ;; Card 964be2d5: a box pen (no :plan) whose gate stands open with both cows inside and the body outside is shut by the mend.
  {:name "box-pen-open-gate-is-shut"
   :blocks [[:set [18 0 16] "oak_fence_gate[facing=east,open=true]"]]
   :act [[:summon "cow" [21.5 0 16.5]]
         [:summon "cow" [21.5 0 15.5]]
         [:job (jobs.animals.maintain {:worth 1200 :mob "cow" :target 2 :box {:min #xyz [19 0 14] :max #xyz [23 0 18]}})]]
   :expect [{:event {:source :job :kind :completed :data {:kind :done}} :within-s 240 :of-job true}]
   :after [[:block [18 0 16] "oak_fence_gate[open=false]"]]}
  ;; Card 1abc02fa: a plan pen's fence cell [18 0 14] broken in the body's view is mended by the :mend step (build.repair).
  ;; Old code called build.pen over the whole plan; the pin is the step's {:broken []} summary, which build.repair gives.
  {:name "plan-pen-fence-cell-broken-in-view-is-mended"
   :blocks [[:set [18 0 14] "air"]]
   :plans [{:id "pen" :metadata {:by "$body"}
            :parts [{:id "fence" :outline [#at [18 0 13] #at [24 0 19]] :want "oak_fence"}
                    {:id "gate" :cells [#at [18 0 16]] :want "oak_fence_gate"}
                    {:id "cows" :box [#at [19 0 14] #at [23 0 18]] :want "air" :herd {:mob "cow" :target 2}}]}]
   :body {:inventory [["wheat" 4] ["oak_fence" 2]]}
   :act [[:summon "cow" [21.5 0 16.5]]
         [:summon "cow" [21.5 0 15.5]]
         [:job (jobs.animals.maintain {:worth 1200 :plan "$plan:pen" :part "cows"})]]
   :expect [{:event {:source :job :kind :completed :data {:kind :done :steps {:mend {:broken []}}}} :within-s 240 :of-job true}]
   :after [[:block [18 0 14] "oak_fence"] [:entities "type=cow,tag=wt" [[19 0 14] [23 1 18]] 2]]}]}
