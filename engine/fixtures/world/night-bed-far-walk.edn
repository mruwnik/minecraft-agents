;; Card e9c70623 (Wicken #147): the night walked the body 564 blocks over dark open ground to its spawn bed. night/bed-walk-price
;; prices staying put as exposed at most for the time to shelter where it stands (shut-in's quote, bed-down/dig-in-time-s), not the whole walk.
;; Overdue (max-days-awake 0): the bed 294 blocks off. At 114 blocks walk and stay hp priced within a second of each other, so a partial quote flipped it.
;; Should-succeed: night.bed-walk-unsafe, no sleep, the body shelters near its start. Should-fail: it walks to the bed and sleeps.
;; Needs the night (bed use is decided by the clock).
{:defaults
 {:tags [:night :survival :bed]
  :time :night :time-why :sleep
  :plot {:light :sky :length 320 :width 16 :height 6}
  :body {:at [6.5 0 6.5] :effects [["resistance" 600 4]] :settle-s 3 :inventory [["cobblestone" 32]]}
  :limit-s 130}
 :cases
 [{:name "a-bed-294-blocks-over-dark-open-ground-is-not-walked-to"
   :blocks [[:set [300 0 6] "red_bed[facing=east,part=foot]"] [:set [301 0 6] "red_bed[facing=east,part=head]"]]
   :memory [{:kind :bed :data {:pos #xyz [300 0 6]} :policy {:cap 1 :ttl :forever}}]
   :act [[:job (jobs.survival.night {:worth 1200 :ways #{:bed :shelter} :settings {:jobs.lib.shelter.beds/max-days-awake 0}})]]
   :expect [{:event {:source :job :kind :night.bed-walk-unsafe} :within-s 40}
            {:no-event {:source :action :kind :done :data {:name "sleep"}} :for-s 100}]
   :after [[:body-near [6.5 0 6.5] 4]]}]}
