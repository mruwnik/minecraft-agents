;; Cards e9da64ac, b0bc6582, 2fc5602d, fe0a38bd: the default :needs-bed trigger fires jobs.items.obtain with its own :any-of (it ended bad-args
;; with no args), and a register that names :needs-bed reaches the body. The respawn bed the body remembers (:spawn-bed at [8 0 16]) is
;; gone (a newer :spawn-reset; the trigger does not look at the cell itself), so the trigger holds by day; wool, planks and a crafting table beside the body make the bed.
;; Should-succeed: the reflex fires, obtain does not stop bad-args, the body ends with a bed. Should-fail: a body that still sees its
;; remembered spawn bed does not fire it. The errand holds only in the last 6000 ticks before dusk, so the firing cases set the time to 9000 once registered (the early-day hold is pinned in needs-bed-test: the clock at the start is not fixed, so no case can register before it).
{:defaults
 {:tags [:survival :triggers :items]
  :plot {:height 6}
  :time :day :time-why :sleep
  :register [{:trigger :needs-bed}]
  :body {:at [16.5 0 16.5] :settle-s 2 :effects [["resistance" 600 4]]}
  :limit-s 90}
 :cases
 [{:name "lost-spawn-bed-fetches-a-bed"
   :memory [{:kind :spawn-bed :data {:pos #xyz [8 0 16]} :age-s 60}
            {:kind :spawn-reset :data {:pos #xyz [8 0 16]} :age-s 30}]
   :blocks [[:set [20 0 16] "crafting_table"]]
   :body {:inventory [["white_wool" 3] ["oak_planks" 3]]}
   :act [[:time-set 9000]]
   :expect [{:event {:source :reflex :kind :fired :context {:reflex-id :needs-bed}} :within-s 30}
            {:no-event {:source :job :kind :stopped :data {:reason :bad-args}} :for-s 60 :until {:source :reflex :kind :ended}}
            {:event {:source :reflex :kind :ended :data {:how :cleared}} :within-s 80}]
   :after [[:item "white_bed" [:>= 1]]]}
  ;; e2a8cdfc: any colour of wool makes a bed (3 of one colour); no white wool is needed
  {:name "lost-spawn-bed-red-wool-makes-a-red-bed"
   :memory [{:kind :spawn-bed :data {:pos #xyz [8 0 16]} :age-s 60}
            {:kind :spawn-reset :data {:pos #xyz [8 0 16]} :age-s 30}]
   :blocks [[:set [20 0 16] "crafting_table"]]
   :body {:inventory [["red_wool" 3] ["oak_planks" 3]]}
   :act [[:time-set 9000]]
   :expect [{:event {:source :reflex :kind :fired :context {:reflex-id :needs-bed}} :within-s 30}
            {:event {:source :reflex :kind :ended :data {:how :cleared}} :within-s 80}]
   :after [[:item "red_bed" [:>= 1]] [:item "white_bed" 0]]}
  ;; d2a66a22, 1c50b7f5: one wool, planks, no sheep and no shears: no bed can be made here, so the obtain searches, as far as a bed is
  ;; worth to a body with no respawn (a priced obtain: each walk priced against what is left of that, which reaches past the plot, so its no-source end is not waited for); needs the dusk window (time-set 9000)
  {:name "no-wool-source-searches-as-far-as-a-bed-is-worth"
   :memory [{:kind :spawn-bed :data {:pos #xyz [8 0 16]} :age-s 60}
            {:kind :spawn-reset :data {:pos #xyz [8 0 16]} :age-s 30}]
   :blocks [[:set [20 0 16] "crafting_table"]]
   :body {:inventory [["white_wool" 1] ["oak_planks" 3]]}
   :act [[:time-set 9000]]
   :expect [{:event {:source :reflex :kind :fired :context {:reflex-id :needs-bed}} :within-s 30}
            {:event {:source :job :kind :obtain.exploring} :within-s 60}
            {:no-event {:source :job :kind :stopped :data {:cause {:reason :no-source}}} :for-s 60}]
   :after [[:item "white_bed" 0]]}
  ;; d2a66a22: the same body on land a look noted as searched in vain for sheep 128 blocks round (no sheep in sight, 1 wool): no way to
  ;; the wool pays, so the errand does not fire (should-fail of no-wool-source-searches-as-far-as-a-bed-is-worth)
  {:name "land-searched-in-vain-for-sheep-does-not-fire"
   :memory [{:kind :spawn-bed :data {:pos #xyz [8 0 16]} :age-s 60}
            {:kind :spawn-reset :data {:pos #xyz [8 0 16]} :age-s 30}]
   :blocks [[:set [20 0 16] "crafting_table"]]
   :body {:inventory [["white_wool" 1] ["oak_planks" 3]]}
   :act [[:job (jobs.explore.search {:target "sheep" :scan-radius 128 :settings {:jobs.explore.search/max-legs 0}})]
         [:await {:source :job :kind :stopped :data {:why :legs}} 30]
         [:time-set 9000]]
   :expect [{:no-event {:source :reflex :kind :fired :context {:reflex-id :needs-bed}} :for-s 30}]
   :after [[:item "white_bed" 0]]
   :limit-s 60}
  ;; 4c9581e2 (Bramble): the same land, then one white sheep in sight, no shears: a hunt takes the lone one, 1 + 1 wool is short of
  ;; 3, so the errand still does not fire (under the sky, so the sheep is seen)
  {:name "one-sheep-and-one-wool-on-land-searched-in-vain-does-not-fire"
   :plot {:height 6 :light :sky}
   :memory [{:kind :spawn-bed :data {:pos #xyz [8 0 16]} :age-s 60}
            {:kind :spawn-reset :data {:pos #xyz [8 0 16]} :age-s 30}]
   :blocks [[:set [20 0 16] "crafting_table"]]
   :body {:inventory [["white_wool" 1] ["oak_planks" 3]]}
   :act [[:job (jobs.explore.search {:target "sheep" :scan-radius 128 :settings {:jobs.explore.search/max-legs 0}})]
         [:await {:source :job :kind :stopped :data {:why :legs}} 30]
         [:summon "sheep" [22.5 0 16.5] "{NoAI:1b,Color:0b}"]
         [:time-set 9000]]
   :expect [{:no-event {:source :reflex :kind :fired :context {:reflex-id :needs-bed}} :for-s 30}]
   :after [[:item "white_bed" 0]]
   :limit-s 60}
  ;; 1c50b7f5: a listed from-plan whose plan has a bed brings one, so the errand waits for it (should-fail of lost-spawn-bed-fetches-a-bed).
  {:name "listed-plan-with-a-bed-is-waited-for"
   :memory [{:kind :spawn-bed :data {:pos #xyz [8 0 16]} :age-s 60}
            {:kind :spawn-reset :data {:pos #xyz [8 0 16]} :age-s 30}]
   :plans [{:id "hut" :metadata {:by "$body"}
            :parts [{:id "bed-foot" :cells [#at [17 0 19]] :want {:block "bed" :facing :south :part :foot}}
                    {:id "bed-head" :cells [#at [17 0 20]] :want {:block "bed" :facing :south :part :head}}]}]
   :blocks [[:set [20 0 16] "crafting_table"]]
   :body {:inventory [["white_wool" 3] ["oak_planks" 3]]}
   :act [[:job (jobs.build.from-plan {:plan "$plan:hut"})] [:time-set 9000]]
   :expect [{:event {:source :job :kind :queued :data {:name "jobs.build.from-plan"}} :within-s 10}
            {:no-event {:source :reflex :kind :fired :context {:reflex-id :needs-bed}} :for-s 40}]
   :limit-s 60}
  ;; c4083a57: should-fire of listed-plan-with-a-bed-is-waited-for: the from-plan waits behind a job that may run past dusk, so the bed is fetched now.
  {:name "plan-with-a-bed-behind-a-long-job-is-not-waited-for"
   :memory [{:kind :spawn-bed :data {:pos #xyz [8 0 16]} :age-s 60}
            {:kind :spawn-reset :data {:pos #xyz [8 0 16]} :age-s 30}]
   :plans [{:id "hut" :metadata {:by "$body"}
            :parts [{:id "bed-foot" :cells [#at [17 0 19]] :want {:block "bed" :facing :south :part :foot}}
                    {:id "bed-head" :cells [#at [17 0 20]] :want {:block "bed" :facing :south :part :head}}]}]
   :blocks [[:set [20 0 16] "crafting_table"]]
   :body {:inventory [["white_wool" 3] ["oak_planks" 3]]}
   :act [[:job (jobs.time.noop {:seconds 120 :why :idle})] [:job (jobs.build.from-plan {:plan "$plan:hut"})] [:time-set 9000]]
   :expect [{:event {:source :job :kind :queued :data {:name "jobs.build.from-plan"}} :within-s 10}
            {:event {:source :reflex :kind :fired :context {:reflex-id :needs-bed}} :within-s 40}]
   :limit-s 60}
  {:name "standing-spawn-bed-does-not-fire"
   :memory [{:kind :spawn-bed :data {:pos #xyz [8 0 16]} :age-s 60}]
   :blocks [[:set [8 0 16] "red_bed[facing=east,part=foot]"] [:set [9 0 16] "red_bed[facing=east,part=head]"]]
   :body {:inventory [["white_wool" 3] ["oak_planks" 3]]}
   :expect [{:no-event {:source :reflex :kind :fired :context {:reflex-id :needs-bed}} :for-s 20}]
   :after [[:block [8 0 16] "red_bed"] [:item "white_bed" 0]]
   :limit-s 40}
  ;; fe0a38bd: no respawn bed at all, never slept, first memory 4 in-game days old (a day is 20 min): overdue, so by day it makes a bed
  {:name "never-slept-for-days-fetches-a-bed"
   :memory [{:kind :food-source :data {:pos #xyz [4 0 4]} :age-s 4800 :policy {:cap 5 :ttl :forever}}]
   :blocks [[:set [20 0 16] "crafting_table"]]
   :body {:inventory [["white_wool" 3] ["oak_planks" 3]]}
   :act [[:time-set 9000]]
   :expect [{:event {:source :reflex :kind :fired :context {:reflex-id :needs-bed}} :within-s 30}
            {:event {:source :reflex :kind :ended :data {:how :cleared}} :within-s 80}]
   :after [[:item "white_bed" [:>= 1]]]}
  {:name "never-slept-but-only-minutes-old-does-not-fire"
   :memory [{:kind :food-source :data {:pos #xyz [4 0 4]} :age-s 60 :policy {:cap 5 :ttl :forever}}]
   :blocks [[:set [20 0 16] "crafting_table"]]
   :body {:inventory [["white_wool" 3] ["oak_planks" 3]]}
   :expect [{:no-event {:source :reflex :kind :fired :context {:reflex-id :needs-bed}} :for-s 20}]
   :after [[:item "white_bed" 0]]
   :limit-s 40}]}
