;; make-room throws plain junk blocks (granite, tuff, gravel, sand) before coal, raw copper and diamond (card 3133211e):
;; 34 stacks, no chest -> junk tossed in one run (cobbled deepslate / dirt stay: building-block floor), ores kept,
;; make-room.done lists :tossed; with a remembered :chest place it deposits instead; a big bag of junk only (the farm
;; observation: tossed stacks re-picked, no done). Card 5420805e: one run is one whole attempt.
{:defaults
 {:tags [:make-room :jobs]
  :time :any
  :body {:at [16.5 0 16.5] :effects [["resistance" 600 4]]}}
 :cases
 [{:name "no-chest-junk-goes-ores-stay"
   :body {:inventory [["cobbled_deepslate" 64] ["granite" 64] ["tuff" 20] ["coal" 30] ["raw_copper" 12] ["diamond" 3] ["wooden_pickaxe" 1] ["stone_pickaxe" 1] ["iron_pickaxe" 1] ["golden_pickaxe" 1] ["diamond_pickaxe" 1] ["netherite_pickaxe" 1] ["wooden_axe" 1] ["stone_axe" 1] ["iron_axe" 1] ["golden_axe" 1] ["diamond_axe" 1] ["netherite_axe" 1] ["wooden_shovel" 1] ["stone_shovel" 1] ["iron_shovel" 1] ["golden_shovel" 1] ["diamond_shovel" 1] ["netherite_shovel" 1] ["wooden_hoe" 1] ["stone_hoe" 1] ["iron_hoe" 1] ["golden_hoe" 1] ["diamond_hoe" 1] ["netherite_hoe" 1] ["wooden_sword" 1] ["stone_sword" 1] ["iron_sword" 1] ["golden_sword" 1]]}
   :act [[:job (jobs.storage.make-room {:free 4})]]
   :expect [{:event {:source :job :kind :make-room.tossed :data {:item "granite" :junk true}} :within-s 60 :of-job true}
            {:event {:source :job :kind :make-room.done :data {:tossed [{:item "granite" :count 64} {:item "tuff" :count 20}]}} :within-s 90 :of-job true}
            {:no-event {:source :job :kind :make-room.tossed :data {:item "cobbled_deepslate"}} :for-s 90 :until {:source :job :kind :make-room.done :data {:tossed [{:item "granite" :count 64} {:item "tuff" :count 20}]}}}
            {:no-event {:source :job :kind :make-room.tossed :data {:item "coal"}} :for-s 90 :until {:source :job :kind :make-room.done :data {:tossed [{:item "granite" :count 64} {:item "tuff" :count 20}]}}}]
   :after [[:item "coal" 30] [:item "raw_copper" 12] [:item "diamond" 3] [:item "cobbled_deepslate" 64] [:item "tuff" 0]]
   :limit-s 100}
  {:name "no-chest-more-junk-then-tuff-ores-stay"
   :body {:inventory [["dirt" 64] ["gravel" 64] ["sand" 64] ["tuff" 20] ["coal" 30] ["raw_copper" 12] ["diamond" 3] ["wooden_pickaxe" 1] ["stone_pickaxe" 1] ["iron_pickaxe" 1] ["golden_pickaxe" 1] ["diamond_pickaxe" 1] ["netherite_pickaxe" 1] ["wooden_axe" 1] ["stone_axe" 1] ["iron_axe" 1] ["golden_axe" 1] ["diamond_axe" 1] ["netherite_axe" 1] ["wooden_shovel" 1] ["stone_shovel" 1] ["iron_shovel" 1] ["golden_shovel" 1] ["diamond_shovel" 1] ["netherite_shovel" 1] ["wooden_hoe" 1] ["stone_hoe" 1] ["iron_hoe" 1] ["golden_hoe" 1] ["diamond_hoe" 1] ["netherite_hoe" 1] ["wooden_sword" 1] ["stone_sword" 1] ["iron_sword" 1]]}
   :act [[:job (jobs.storage.make-room {:free 5})]]
   :expect [{:event {:source :job :kind :make-room.done :data {:tossed [:any :any :any]}} :within-s 120 :of-job true}
            {:no-event {:source :job :kind :make-room.tossed :data {:item "coal"}} :for-s 120 :until {:source :job :kind :make-room.done :data {:tossed [:any :any :any]}}}
            {:no-event {:source :job :kind :make-room.tossed :data {:item "raw_copper"}} :for-s 120 :until {:source :job :kind :make-room.done :data {:tossed [:any :any :any]}}}]
   :after [[:item "coal" 30] [:item "raw_copper" 12] [:item "diamond" 3] [:item "tuff" 0]]
   :limit-s 130}
  {:name "chest-known-deposits-instead-of-tossing"
   :blocks [[:set [20 0 16] "chest[facing=west]"]]
   :memory [{:kind :chest :data {:pos #xyz [20 0 16]} :policy {:cap 1 :ttl :forever}}]
   :body {:inventory [["cobbled_deepslate" 64] ["granite" 64] ["tuff" 20] ["coal" 30] ["raw_copper" 12] ["diamond" 3] ["wooden_pickaxe" 1] ["stone_pickaxe" 1] ["iron_pickaxe" 1] ["golden_pickaxe" 1] ["diamond_pickaxe" 1] ["netherite_pickaxe" 1] ["wooden_axe" 1] ["stone_axe" 1] ["iron_axe" 1] ["golden_axe" 1] ["diamond_axe" 1] ["netherite_axe" 1] ["wooden_shovel" 1] ["stone_shovel" 1] ["iron_shovel" 1] ["golden_shovel" 1] ["diamond_shovel" 1] ["netherite_shovel" 1] ["wooden_hoe" 1] ["stone_hoe" 1] ["iron_hoe" 1] ["golden_hoe" 1] ["diamond_hoe" 1] ["netherite_hoe" 1] ["wooden_sword" 1] ["stone_sword" 1] ["iron_sword" 1] ["golden_sword" 1]]}
   :act [[:job (jobs.storage.make-room {:free 4})]]
   :expect [{:event {:source :job :kind :make-room.done} :within-s 90 :of-job true}
            {:no-event {:source :job :kind :make-room.tossed} :for-s 10 :until {:source :job :kind :make-room.done}}]
   :limit-s 100}
  {:name "bag-of-junk-only-done-is-emitted"
   :body {:inventory [["dirt" 640] ["gravel" 640] ["sand" 640] ["andesite" 384]]}
   :act [[:job (jobs.storage.make-room {:free 12})]]
   :expect [{:event {:source :job :kind :make-room.done} :within-s 150 :of-job true}]
   :limit-s 160}]}
