;; Card 8ec7c584: jobs.movement.ride-rail boards a cart at the line's near end, starts it with the rider's forward input (the
;; ends are two plain rails, then a lit launch group 4..7 and 26..29; no powered rail beside a buffer), rides, gets off and
;; takes its cart back. The line x 2..31 on z 16 is laid by :blocks as its plan wants (buffers 1 and 32, torches 5 and 28 on z 15).
;; Should-succeed: ride-a-built-line-in-a-carried-cart (completed, the body at the far end, the cart item back): the cart
;; must start from rest on the plain end rails, so only a forward input that pushes it passes (a stall ends :stalled).
;; Should-fail: a-line-with-a-gap-is-not-ridden (a rail cell 15 is air: waits :not-sound, no cart is put down).
{:defaults
 {:tags [:rail :transport :movement :jobs] :time :any
  :plot {:height 8 :length 40 :width 32}
  :plans [{:id "line" :metadata {:by "$body"}
           :parts [{:id "rails" :cells [#at [2 0 16] #at [3 0 16] #at [8 0 16] #at [9 0 16] #at [10 0 16] #at [11 0 16] #at [12 0 16] #at [13 0 16] #at [14 0 16] #at [15 0 16] #at [16 0 16] #at [17 0 16] #at [18 0 16] #at [19 0 16] #at [20 0 16] #at [21 0 16] #at [22 0 16] #at [23 0 16] #at [24 0 16] #at [25 0 16] #at [30 0 16] #at [31 0 16]] :want {:block "rail" :shape :east_west}}
                   {:id "powered" :cells [#at [4 0 16] #at [5 0 16] #at [6 0 16] #at [7 0 16] #at [26 0 16] #at [27 0 16] #at [28 0 16] #at [29 0 16]] :want {:block "powered_rail" :shape :east_west :powered true}}
                   {:id "power" :cells [#at [5 0 15] #at [28 0 15]] :want "redstone_torch"}
                   {:id "buffers" :cells [#at [1 0 16] #at [32 0 16]] :want [:any "cobblestone" "dirt" "stone"]}]}]
  :blocks [[:fill [1 0 16] [1 0 16] "cobblestone"] [:fill [32 0 16] [32 0 16] "cobblestone"]
           [:fill [2 0 16] [31 0 16] "rail[shape=east_west]"]
           [:fill [4 0 16] [7 0 16] "powered_rail[shape=east_west,powered=true]"]
           [:fill [26 0 16] [29 0 16] "powered_rail[shape=east_west,powered=true]"]
           [:fill [5 0 15] [5 0 15] "redstone_torch"] [:fill [28 0 15] [28 0 15] "redstone_torch"]]
  :body {:at [3.5 0 18.5] :yaw 0 :inventory [["minecart" 1]]}
  :limit-s 120}
 :cases
 [{:name "ride-a-built-line-in-a-carried-cart"
   :act [[:job (jobs.movement.ride-rail {:worth 1200 :plan "$plan:line"})]]
   :expect [{:event {:source :job :kind :completed} :within-s 100 :of-job true}
            {:no-event {:source :job :kind :stopped} :for-s 100 :until {:source :job :kind :completed}}]
   :after [[:body-near [31.5 0 16.5] 3] [:item "minecart" 1]]}
  {:name "a-line-with-a-gap-is-not-ridden"
   :blocks [[:fill [15 0 16] [15 0 16] "air"]]
   :act [[:job (jobs.movement.ride-rail {:worth 1200 :plan "$plan:line"})]]
   :expect [{:event {:source :job :kind :waiting :data {:reason :not-sound}} :within-s 20 :of-job true}]
   :after [[:item "minecart" 1] [:body-near [3.5 0 18.5] 2]]
   :limit-s 40}]}
