;; A stocked pen's gate and the walks that cross it (cards 7579203a, 17ee078f, 73a4a955, d9680b11). Pen: oak fence ring x 18..26, z 11..21,
;; inside 19..25 x 12..20, gate on the west side at [18 0 16]; two cows inside (they wander, the fence holds them).
;; The pen is big enough that its middle is out of reach (4.5 cells) from every cell outside the fence.
;; Should-succeed: go-to out of the pen with wheat in the bag (put away before the gate click) or without: gate shut behind, both cows stay;
;; go-to away from an open stocked gate warns go-to.pen-gate-open; blocks.place deep in the pen declines with blocks.pen-kept-out,
;; places with the enter-pens setting (gate shut behind the body); use-on at the gate from outside clicks it without entering.
;; Should-fail (no warn / declined): a goal beside the open gate; use-on deep in the pen (blocks.pen-kept-out, the lever unpowered).
{:defaults
 {:tags [:animals :pen-gate :movement]
  :time :any
  :plot {:floor "grass_block"}
  :blocks [[:fill [18 0 11] [26 0 21] "oak_fence"]
           [:fill [19 0 12] [25 0 20] "air"]
           [:set [18 0 16] "oak_fence_gate[facing=east,open=false]"]]
  :body {:at [12.5 0 16.5] :inventory [["cobblestone" 4]] :effects [["resistance" 900 4]]}
  :act [[:summon "cow" [20.5 0 14.5]] [:summon "cow" [21.5 0 17.5]]
        [:rcon "kill @e[type=zombie,$BOX]"] [:rcon "kill @e[type=skeleton,$BOX]"] [:rcon "kill @e[type=spider,$BOX]"] [:rcon "kill @e[type=creeper,$BOX]"]
        [:until-seen {:entity "cow" :min 2} 10]]
  :limit-s 120}
 :cases
 [{:name "go-to-out-of-the-pen-with-wheat-cows-stay"
   :body {:at [20.5 0 16.5] :inventory [["wheat" 8]]}
   :act [[:job (jobs.movement.go-to {:pos #at [10 0 16] :range 1})]]
   :expect [{:event {:source :job :kind :completed :data {:arrived true}} :within-s 90 :of-job true}]
   :after [[:body-near [10.5 0 16.5] 2.5] [:block [18 0 16] "oak_fence_gate[open=false]"] [:item "wheat" 8]
           [:entities "type=cow,tag=wt" [[19 0 12] [25 1 20]] 2]]}
  {:name "go-to-out-of-the-pen-no-bait-cows-stay"
   :body {:at [20.5 0 16.5]}
   :act [[:job (jobs.movement.go-to {:pos #at [10 0 16] :range 1})]]
   :expect [{:event {:source :job :kind :completed :data {:arrived true}} :within-s 90 :of-job true}]
   :after [[:body-near [10.5 0 16.5] 2.5] [:block [18 0 16] "oak_fence_gate[open=false]"]
           [:entities "type=cow,tag=wt" [[19 0 12] [25 1 20]] 2]]}
  {:name "go-to-away-from-an-open-stocked-gate-warns"
   :blocks [[:set [18 0 16] "oak_fence_gate[facing=east,open=true]"]]
   :body {:at [14.5 0 16.5] :yaw 270}
   :act [[:job (jobs.movement.go-to {:pos #at [14 0 4] :range 1})]]
   :expect [{:event {:source :job :kind :go-to.pen-gate-open :level :warn} :within-s 40}]}
  {:name "go-to-beside-an-open-stocked-gate-no-warn"
   :blocks [[:set [18 0 16] "oak_fence_gate[facing=east,open=true]"]]
   :body {:at [14.5 0 16.5]}
   :act [[:job (jobs.movement.go-to {:pos #at [16 0 16] :range 1})]]
   :expect [{:event {:source :job :kind :completed :data {:arrived true}} :within-s 40 :of-job true}
            {:no-event {:source :job :kind :go-to.pen-gate-open} :for-s 40 :until {:source :job :kind #{:completed :stopped}}}]}
  {:name "place-deep-in-the-pen-declines-naming-the-pen"
   :act [[:job (jobs.blocks.place {:pos #at [22 0 16] :item "cobblestone"})]]
   :expect [{:event {:source :job :kind :blocks.pen-kept-out :level :warn} :within-s 80}]
   :after [[:not-block [22 0 16] "cobblestone"] [:block [18 0 16] "oak_fence_gate[open=false]"]
           [:entities "type=cow,tag=wt" [[19 0 12] [25 1 20]] 2]]}
  {:name "place-deep-in-the-pen-with-enter-pens-walks-in"
   :act [[:job (jobs.blocks.place {:pos #at [22 0 16] :item "cobblestone" :settings {:jobs.lib.blocks/enter-pens true}})]]
   :expect [{:event {:source :job :kind :completed :data {:placed true}} :within-s 100 :of-job true}]
   :after [[:block [22 0 16] "cobblestone"] [:block [18 0 16] "oak_fence_gate[open=false]"]
           [:entities "type=cow,tag=wt" [[19 0 12] [25 1 20]] 2]]}
  {:name "use-on-the-gate-from-outside-does-not-enter"
   :act [[:job (jobs.items.use {:on #at [18 0 16]})]]
   :expect [{:event {:source :job :kind :completed :data {:used true}} :within-s 60 :of-job true}]
   :after [[:block [18 0 16] "oak_fence_gate[open=true]"] [:body-far [21.5 0 16.5] 3]]}
  {:name "use-on-deep-in-the-pen-declines-naming-the-pen"
   :blocks [[:set [22 0 16] "lever[face=floor,facing=north,powered=false]"]]
   :act [[:job (jobs.items.use {:on #at [22 0 16]})]]
   :expect [{:event {:source :job :kind :blocks.pen-kept-out :level :warn} :within-s 100}]
   :after [[:block [22 0 16] "lever[powered=false]"] [:block [18 0 16] "oak_fence_gate[open=false]"]
           [:entities "type=cow,tag=wt" [[19 0 12] [25 1 20]] 2]]
   :limit-s 140}]}
