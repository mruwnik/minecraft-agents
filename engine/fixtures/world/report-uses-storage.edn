;; Card 338d63a3: a job's report :uses counts what the acts moved, not the whole bag (a short inventory view after a chest transfer was once booked as used).
;; Chest at [20 0 16] (empty, remembered). Should-succeed: deposit/make-room complete and the report's :uses has the stored item.
;; Should-fail: :uses lists a tool the job never moved.
{:defaults
 {:tags [:make-room :storage :jobs] :time :any :plot {:height 8}
  :blocks [[:set [20 0 16] "chest[facing=west]"]]
  :memory [{:kind :chest :data {:pos #xyz [20 0 16]} :policy {:cap 1 :ttl :forever}}]
  :body {:at [16.5 0 16.5] :effects [["resistance" 600 4]]}
  :limit-s 120}
 :cases
 [{:name "deposit-report-uses-only-what-went-into-the-chest"
   :body {:inventory [["stone_pickaxe" 1] ["stone_sword" 1] ["dirt" 20]]}
   :act [[:job (jobs.storage.deposit {:chest #xyz [20 0 16]})]]
   :expect [{:event {:source :job :kind :completed :data {:report {:uses {:items {"dirt" 20}}}}} :within-s 60 :of-job true}
            {:no-event {:source :job :kind :completed :data {:report {:uses {:items {"stone_pickaxe" [:any]}}}}} :for-s 60 :until {:source :job :kind :completed}}]
   :after [[:item "dirt" 0] [:item "stone_pickaxe" 1]]}
  {:name "make-room-report-uses-no-tools"
   :body {:inventory [["wooden_pickaxe" 1] ["stone_pickaxe" 1] ["iron_pickaxe" 1] ["golden_pickaxe" 1] ["diamond_pickaxe" 1] ["netherite_pickaxe" 1] ["wooden_axe" 1] ["stone_axe" 1] ["iron_axe" 1] ["golden_axe" 1] ["diamond_axe" 1] ["netherite_axe" 1] ["wooden_shovel" 1] ["stone_shovel" 1] ["iron_shovel" 1] ["golden_shovel" 1] ["diamond_shovel" 1] ["netherite_shovel" 1] ["wooden_hoe" 1] ["stone_hoe" 1] ["iron_hoe" 1] ["golden_hoe" 1] ["diamond_hoe" 1] ["netherite_hoe" 1] ["wooden_sword" 1] ["stone_sword" 1] ["iron_sword" 1] ["golden_sword" 1] ["diamond_sword" 1] ["netherite_sword" 1] ["bucket" 1] ["water_bucket" 1] ["lava_bucket" 1] ["cobblestone" 64] ["diamond" 5]]}
   :act [[:job (jobs.storage.make-room {:free 2})]]
   :expect [{:event {:source :job :kind :completed} :within-s 90 :of-job true}
            {:no-event {:source :job :kind :completed :data {:report {:uses {:items {"stone_pickaxe" [:any]}}}}} :for-s 90 :until {:source :job :kind :completed}}]
   :after [[:item "stone_pickaxe" 1]]
   :limit-s 120}]}
