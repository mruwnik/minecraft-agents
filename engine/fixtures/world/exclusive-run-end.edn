;; Card 78971640: an exclusive run is one call: it ends (completed, refusal) and leaves the list, and does not run again.
;; A body-driving job (world.mjs submit dig of an air cell, --exclusive) ends :already-clear; `jobs list` is then empty (nothing parked or re-rolled). The same for a refused job
;; (equip of an item not carried: its fetch need fails, so the run ends with a :job :stopped event). The :error and :cut endings need a throwing round or a cut call: engine/test/engine/exclusive_test.cljs only.
{:defaults
 {:tags [:scheduler :tool] :time :any
  :plot {:height 8}
  :body {:at [4.5 0 16.5]}
  :limit-s 60}
 :cases
 [{:name "done-exclusive-run-leaves-the-list"
   :act [[:cli "world" ["$body" "submit" "dig" #at [8 0 8] "--who" "wt" "--exclusive" "--world" "$world"] {:ok true}]
         [:until [:cli "jobs" ["$body" "--world" "$world" "list"] {:total 0}] 20]
         ;; absence needs a window: the list must still be empty after it (a re-queued job would show)
         [:wait-s 6]
         [:cli "jobs" ["$body" "--world" "$world" "list"] {:total 0}]]
   :expect [{:event {:source :job :kind :completed :data {:dug false}} :within-s 20}]}
  {:name "refused-exclusive-run-leaves-the-list"
   :act [[:cli "world" ["$body" "submit" "equip" "diamond_sword" "--who" "wt" "--exclusive" "--world" "$world"] {:ok true}]
         [:until [:cli "jobs" ["$body" "--world" "$world" "list"] {:total 0}] 20]]
   :expect [{:event {:source :job :kind :stopped :data {:status :stopped}} :within-s 20}]}]}
