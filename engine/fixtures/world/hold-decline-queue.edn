;; Card 5068421a: a --hold job that declines ends stopped at once instead of waiting, so the job queued behind it gets its round:
;; combat.hunt with no cow in range stops :too-few, build.from-plan on a plan with no cell to build stops :plan-trouble.
;; Should-succeed: both held jobs stop and the go-to listed behind arrives. Should-fail: no waiting event for either.
{:defaults
 {:tags [:scheduler :combat :build] :time :any
  :plot {:height 8}
  :body {:at [4.5 0 16.5] :settle-s 2 :inventory [["iron_sword" 1]]}
  :limit-s 70}
 :cases
 [{:name "held-hunt-with-no-cow-stops-too-few-and-the-next-job-runs"
   :act [[:http :submit (jobs.combat.hunt {:mob "cow" :count 1}) [:hold] {:ok true}]
         [:job (jobs.movement.go-to {:pos #at [24 0 16] :range 1})]]
   :expect [{:event {:source :job :kind :stopped :data {:reason :too-few}} :within-s 30}
            {:event {:source :job :kind :result :data {:arrived true}} :within-s 60 :of-job true}
            {:no-event {:source :job :kind :waiting :data {:reason :too-few}} :for-s 30}]
   :after [[:body-near [24.5 0 16.5] 2]]}
  {:name "held-from-plan-with-nothing-to-build-stops-plan-trouble-and-the-next-job-runs"
   :plans [{:id "empty" :metadata {:by "$body"} :parts [{:id "p" :cells [] :want "dirt"}]}]
   :act [[:http :submit (jobs.build.from-plan {:plan "$plan:empty"}) [:hold] {:ok true}]
         [:job (jobs.movement.go-to {:pos #at [24 0 16] :range 1})]]
   :expect [{:event {:source :job :kind :stopped :data {:reason :plan-trouble}} :within-s 30}
            {:event {:source :job :kind :result :data {:arrived true}} :within-s 60 :of-job true}
            {:no-event {:source :job :kind :waiting :data {:reason :plan-trouble}} :for-s 30}]
   :after [[:body-near [24.5 0 16.5] 2]]}]}
