;; jobs.survival.night holds the body at night and lets it out at day (card 79be43a4; the shelter-level hold was not ported in
;; card 8aa80fca). Night case: on open ground with a remembered bed the night job sleeps (a known bed within the default-bed-radius setting
;; comes before log-out and dig-in); the clock is then set to morning (a vanilla skip needs every online player asleep), the body wakes and the job completes.
;; (The release at day and the queued-job hold are the known-failing fixture shelter-night-hold-queued-job.) Day case: a shelter
;; job by day does nothing and ends :done at once. The bed is in a closed hut: the night does not sleep in an open bed (card 4e99ddb0). Night: run with --allow-time --time-log <the shared time log>.
{:defaults
 {:tags [:survival :shelter]
  :blocks [[:set [4 0 4] "torch"] [:set [4 0 28] "torch"] [:set [28 0 4] "torch"] [:set [28 0 28] "torch"]
           [:set [16 0 4] "torch"] [:set [16 0 28] "torch"] [:set [4 0 16] "torch"] [:set [28 0 16] "torch"]]
  :body {:at [16.5 0 16.5] :effects [["resistance" 600 4]]}}
 :cases
 [{:name "night-sleeps-wakes-and-completes"
   :time :night-exclusive
   :tags [:night]
   :blocks [[:fill [8 0 8] [16 3 16] "stone" :hollow] [:fill [9 0 9] [15 2 15] "air"]
            [:set [9 1 9] "torch"] [:set [15 1 15] "torch"]
            [:set [10 0 12] "red_bed[facing=east,part=foot]"] [:set [11 0 12] "red_bed[facing=east,part=head]"]]
   :body {:at [13.5 0 13.5]}
   :act [[:job (jobs.memory.set-place {:name :bed :pos #at [10 0 12]})]
         [:job (jobs.survival.night {})]
         [:await {:source :action :kind :done :data {:name "sleep" :status "sleeping"}} 60]
         [:time-set 1000]]
   :expect [{:event {:source :action :kind :done :data {:name "sleep" :status "sleeping"}} :within-s 60}
            {:event {:source :body :kind :woke} :within-s 60}
            {:event {:source :job :kind :completed :data {:name "jobs.survival.night"}} :within-s 60}]
   :after [[:body-near [10.5 0 12.5] 3]]
   :limit-s 100}
  {:name "day-shelter-does-nothing"
   :time :day :time-why :dawn-decision
   :act [[:job (jobs.survival.night {})]]
   :expect [{:event {:source :job :kind #{:completed :declined :waiting}} :within-s 20 :of-job true}
            {:no-event {:source :action :kind :started :data {:name "place"}} :for-s 20 :until {:source :job :kind #{:completed :declined :waiting}}}]
   ;; no :after body check: another runner's night set while the job is parked would make it log the body out
   :limit-s 40}]}
