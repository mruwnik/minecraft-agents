;; The `entities` tool lists a villager with its :profession (a villager with no job: "unemployed"), so an agent can tell a farmer
;; from an unemployed villager or a nitwit. NoAI villagers keep the profession they are summoned with.
{:defaults
 {:tags [:village :sensing :agent-tools]
  :time :any
  :plot {:floor "grass_block" :height 8}
  :body {:at [10.5 0 16.5] :yaw 270 :settle-s 2}
  :limit-s 60}
 :cases
 [{:name "farmer-is-listed-as-a-farmer"
   :act [[:summon "villager" [16.5 0 16.5] "{NoAI:1b,VillagerData:{profession:\"minecraft:farmer\",level:2,type:\"minecraft:plains\"}}"]
         [:until [:cli "entities" ["$body" "--world" "$world" "--type" "villager"] {:items [:has {:profession "farmer"}]}] 30]]
   :expect [{:no-event {:level :error} :for-s 3}]
   :after [[:body-near [10.5 0 16.5] 4]]}
  {:name "unemployed-villager-is-listed-as-unemployed"
   :act [[:summon "villager" [16.5 0 16.5] "{NoAI:1b}"]
         [:until [:cli "entities" ["$body" "--world" "$world" "--type" "villager"] {:items [:has {:profession "unemployed"}]}] 30]]
   :expect [{:no-event {:level :error} :for-s 3}]
   :after [[:body-near [10.5 0 16.5] 4]]}
  {:name "nitwit-is-listed-as-a-nitwit"
   :act [[:summon "villager" [16.5 0 16.5] "{NoAI:1b,VillagerData:{profession:\"minecraft:nitwit\",level:1,type:\"minecraft:plains\"}}"]
         [:until [:cli "entities" ["$body" "--world" "$world" "--type" "villager"] {:items [:has {:profession "nitwit"}]}] 30]]
   :expect [{:no-event {:level :error} :for-s 3}]
   :after [[:body-near [10.5 0 16.5] 4]]}]}
