;; Card 2e405a35 (D9): the :stuck-underground trigger walks an idle body that sits 6 or more blocks under its home out of its hole. A stone mass x 0..31
;; z 8..24, y 0..11 with an air room around the body at [16 0 16] and a ramp of open cells up to the surface (y 12) at x 30; the home is a torch on the surface.
;; Should-succeed: no job for :idle-s 20, buried, home 12 above: the trigger fires go-home once and the body ends within 5 of the home.
;; Should-fail: a home only 4 above never fires it.
{:defaults
 {:tags [:survival :stuck-underground] :time :any
  :plot {:light :dark :height 16}
  :blocks [[:fill [0 0 8] [31 11 24] "stone"] [:fill [14 0 14] [18 2 18] "air"]
            [:fill [19 0 16] [19 2 16] "air"]
            [:fill [20 1 16] [20 3 16] "air"]
            [:fill [21 2 16] [21 4 16] "air"]
            [:fill [22 3 16] [22 5 16] "air"]
            [:fill [23 4 16] [23 6 16] "air"]
            [:fill [24 5 16] [24 7 16] "air"]
            [:fill [25 6 16] [25 8 16] "air"]
            [:fill [26 7 16] [26 9 16] "air"]
            [:fill [27 8 16] [27 10 16] "air"]
            [:fill [28 9 16] [28 11 16] "air"]
            [:fill [29 10 16] [29 12 16] "air"]
            [:fill [30 11 16] [30 13 16] "air"]]
  :body {:at [16.5 0 16.5] :effects [["resistance" 600 4]]}
  :register [{:trigger :stuck-underground :why "a short idle time so the case fits its window" :args {:idle-s 20}}]
  :limit-s 150}
 :cases
 [{:name "idle-body-twelve-under-its-home-walks-out"
   :blocks [[:set [31 12 16] "torch"]]
   :act [[:job (jobs.memory.set-place {:name :home :pos #at [31 12 16]}) [:now]]]
   :expect [{:count-event {:source :reflex :kind :fired :context {:reflex-id :stuck-underground}} :for-s 100 :at-least 1 :at-most 1}
            {:event {:source :reflex :kind :ended :context {:reflex-id :stuck-underground}} :within-s 140}]
   :after [[:body-near [31.5 12 16.5] 5]]}
  {:name "home-only-four-above-never-fires"
   :act [[:job (jobs.memory.set-place {:name :home :pos #at [16 4 16]}) [:now]]]
   :expect [{:no-event {:source :reflex :kind :fired :context {:reflex-id :stuck-underground}} :for-s 40}]
   :after [[:body-near [16.5 0 16.5] 3]]
   :limit-s 60}]}
