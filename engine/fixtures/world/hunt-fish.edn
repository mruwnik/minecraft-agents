;; Fish are huntable (card c327b8b3): combat.hunt of salmon from the bank of a one-deep pool kills a NoAI salmon and takes its drop.
;; Should-succeed: hunt salmon count 1. Should-fail: hunt of an item no mob drops stops :bad-args.
{:defaults
 {:tags [:animals :hunt :water]
  :time :any
  :plot {:height 6}
  :blocks [[:fill [8 -3 15] [12 -1 19] "water"]]
  :body {:at [4.5 0 17.5] :inventory [["iron_sword" 1]] :settle-s 2}
  :limit-s 100}
 :cases
 [{:name "hunt-salmon-from-the-bank"
   :act [[:summon "salmon" [10.5 -1.5 17.5] "{NoAI:1b}"] [:wait-s 5]
         [:job (jobs.combat.hunt {:item "salmon" :count 1 :keep 0})]]
   :expect [{:event {:source :job :kind :completed :data {:name "jobs.combat.hunt"}} :within-s 60}]
   :after [[:item "salmon" [:>= 1]]]}
  {:name "hunt-an-item-no-mob-drops-is-bad-args"
   :act [[:job (jobs.combat.hunt {:item "diamond" :count 1})]]
   :expect [{:event {:source :job :kind :stopped :data {:reason :bad-args}} :within-s 20 :of-job true}]}]}
