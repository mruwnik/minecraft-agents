;; Card e249a2da (jobs.strip.site alone, the corridor part of jobs.strip.all: no base, shears, smelt or haul).
;; Plot 32 x 32, floor stone. A stone mass x 2..30, y 0..4, z 10..22 holds a corridor along x 2..26 (y 0..2, z 15..17; its west end
;; opens to the air at x 1), rails x 3..25 at z 16, two supports (fences + planks) at x 8 and 14, a cobweb at [12 1 16]. A second
;; corridor along z at x 20 (z 11..15, y 0..2, x 19..21) has rails x 20 z 11..15, a support at z 12 and a cobweb at [20 1 13]; it hangs
;; on the main corridor at z 16 and is sealed at [20 0..2 15] when stripped. The site is named by :at, a rail at [10 0 16]; :shaft false
;; walks in from the west mouth.
;; Should-succeed: the strip ends done, rails and cobwebs gone, the branch sealed with cobblestone (the loot stays in the bag).
{:defaults
 {:tags [:strip :site :mineshaft :jobs]
  :time :any
  :plot {:height 8 :floor "stone"}
  :blocks [[:fill [2 0 10] [30 4 22] "stone"] [:fill [2 0 15] [26 2 17] "air"] [:fill [3 0 16] [25 0 16] "rail"] [:set [12 1 16] "cobweb"]
           [:set [8 0 15] "oak_fence"] [:set [8 1 15] "oak_fence"] [:set [8 0 17] "oak_fence"] [:set [8 1 17] "oak_fence"] [:fill [8 2 15] [8 2 17] "oak_planks"]
           [:set [14 0 15] "oak_fence"] [:set [14 1 15] "oak_fence"] [:set [14 0 17] "oak_fence"] [:set [14 1 17] "oak_fence"] [:fill [14 2 15] [14 2 17] "oak_planks"]
           [:fill [19 0 11] [21 2 15] "air"] [:fill [20 0 11] [20 0 15] "rail"] [:set [20 1 13] "cobweb"]
           [:set [19 0 12] "oak_fence"] [:set [19 1 12] "oak_fence"] [:set [21 0 12] "oak_fence"] [:set [21 1 12] "oak_fence"] [:fill [19 2 12] [21 2 12] "oak_planks"]]
  :body {:at [12.5 0 8.5] :yaw 180 :settle-s 2 :effects [["resistance" 600 4]]
         :inventory [["stone_pickaxe" 1] ["stone_axe" 1] ["shears" 1] ["torch" 16] ["bread" 12] ["cobblestone" 64]]}
  :limit-s 700}
 :cases
 [{:name "branch-stripped-and-sealed-leaf-first-without-a-base"
   :act [[:job (jobs.strip.site {:site "wt-mine" :at #at [10 0 16] :shaft false})]]
   :expect [{:event {:source :job :kind :completed :data {:segments [:any] :taken [:any]}} :within-s 650 :of-job true}]
   :after [[:not-block [10 0 16] "rail"] [:not-block [20 0 12] "rail"] [:not-block [12 1 16] "cobweb"] [:not-block [20 1 13] "cobweb"]
           [:block [20 1 15] "cobblestone"]]}]}
