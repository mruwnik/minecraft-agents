;; Card b51baf23: a parched (desert skeleton variant) is a ranged hostile like the skeleton, so respond-to-hostile blocks its arrows
;; with a block in the doorway (see block-arrow-gap-respond.edn for the setup). Body in a 1x1 stone cell at [17 0 16], doorway to the
;; east, a NoAI helmeted parched 10 blocks east. Should-succeed: the gap child ends :done and the body stays in its cell.
{:defaults
 {:tags [:survival :hostile :jobs]
  :time :any
  :mobs :keep
  :plot {:height 8}
  :blocks [[:fill [16 0 15] [18 2 17] "stone"] [:fill [17 0 16] [18 1 16] "air"]]
  :body {:at [17.5 0 16.5] :yaw 270 :inventory [["cobblestone" 10] ["stone_pickaxe" 1]] :effects [["resistance" 600 4]]}
  :limit-s 60}
 :cases
 [{:name "parched-gets-the-doorway-closed"
   :act [[:summon "parched" [27.5 0 16.5] "{NoAI:1b,equipment:{head:{id:\"minecraft:iron_helmet\",count:1}}}"] [:until-seen {:entity "parched"} 10]
         [:job (jobs.survival.respond-to-hostile {})]]
   :expect [{:event {:source :job :kind :child_ended :data {:slot :gap :ending {:kind :done}}} :within-s 40 :of-job true}]
   :after [[:body-near [17.5 0 16.5] 1.5] [:item "cobblestone" [:< 10]]]
   :limit-s 50}]}
