;; Cards 2e426c84 (tunnel-through) and 06598fb2 (pillar): a body shut in a stone room (air x 14..18, z 14..18, y 0..1,
;; roof y 2, rock to y 5) is asked for a block just over the roof. The roof over its head is a build's ceiling: it is
;; neither tunnelled through nor pillared into, the dig ends :unreachable and the roof stays whole. Old code dug the
;; roof cell [16 2 16] (through-cell, then pillar-up!). Should-succeed counterpart: ore in the roof itself is still
;; pillared to (blocks-dig-unseen-and-under-feet/ore-overhead-in-a-shut-room-is-reached-by-pillaring).
{:defaults
 {:tags [:blocks :access] :time :any
  :plot {:height 10}
  :blocks [[:fill [12 0 12] [20 5 20] "stone"] [:fill [14 0 14] [18 1 18] "air"] [:set [13 1 16] "glowstone"]]
  :body {:at [16.5 0 16.5] :inventory [["iron_pickaxe" 1] ["cobblestone" 8]] :effects [["resistance" 600 4]]}
  :expect [{:event {:source :job :kind :stopped :data {:reason :unreachable}} :within-s 80 :of-job true}
           {:no-event {:source :job :kind :completed} :for-s 80 :until {:source :job :kind :stopped}}]
  :after [[:block [16 2 16] "stone"] [:block [15 2 16] "stone"] [:block [17 2 16] "stone"] [:block [16 2 15] "stone"]
          [:block [16 2 17] "stone"] [:item "cobblestone" 8] [:body-near [16.5 0 16.5] 3]]
  :limit-s 100}
 :cases
 [{:name "a-roof-over-the-body-is-not-tunnelled-to-a-block-above"
   :blocks [[:set [16 3 16] "dirt"]]
   :act [[:job (jobs.blocks.dig {:pos #at [16 3 16] :pillar false})]]
   :after [[:block [16 3 16] "dirt"]]}
  {:name "a-pillar-does-not-start-under-a-roof-over-the-body"
   :blocks [[:set [16 4 16] "iron_ore"]]
   :act [[:job (jobs.blocks.dig {:pos #at [16 4 16]})]]
   :after [[:block [16 4 16] "iron_ore"]]}]}
