;; make-room rounds pilot (card 5420805e): a remembered :chest place with no chest block there (chest_missing, place retracted, the
;; junk is tossed instead); a hostile reflex that fires as the run is queued (a cut mid-run is too fast to provoke: a run takes ~0.4 s), then make-room ends done. Neither run
;; may log job.idle or job.yielded. Tossed stacks stay behind (the walk-away is a go-to child).
{:defaults {:tags [:make-room :jobs :rounds] :time :any :mobs :keep :body {:at [16.5 0 16.5] :effects [["resistance" 900 4]]}}
 :cases
 [{:name "remembered-chest-missing-then-tosses"
   :memory [{:kind :chest :data {:pos #xyz [20 0 16]} :policy {:cap 1 :ttl :forever}}]
   :body {:inventory [["gravel" 64] ["sand" 64] ["tuff" 20] ["coal" 30] ["diamond" 3] ["wooden_pickaxe" 1] ["stone_pickaxe" 1] ["iron_pickaxe" 1] ["golden_pickaxe" 1] ["diamond_pickaxe" 1] ["netherite_pickaxe" 1] ["wooden_axe" 1] ["stone_axe" 1] ["iron_axe" 1] ["golden_axe" 1] ["diamond_axe" 1] ["netherite_axe" 1] ["wooden_shovel" 1] ["stone_shovel" 1] ["iron_shovel" 1] ["golden_shovel" 1] ["diamond_shovel" 1] ["netherite_shovel" 1] ["wooden_hoe" 1] ["stone_hoe" 1] ["iron_hoe" 1] ["golden_hoe" 1] ["diamond_hoe" 1] ["netherite_hoe" 1]]}
   :act [[:job (jobs.storage.make-room {:free 9})]]
   :expect [{:event {:source :job :kind :make-room.done :data {:tossed [:any :any]}} :within-s 60 :of-job true}
            {:no-event {:source :job :kind :idle} :for-s 5}
            {:no-event {:source :job :kind :yielded} :for-s 5}
            {:no-event {:source :job :kind :make-room.tossed :data {:item "coal"}} :for-s 5}]
   :after [[:item "gravel" 0] [:item "sand" 0] [:item "coal" 30] [:item "diamond" 3]]
   :limit-s 80}
  {:name "hostile-reflex-first-then-make-room-ends-done"
   :register [{:trigger :hostile-near :args {:radius 8 :ranged-radius 16}
               :job (jobs.survival.respond-to-hostile {:radius 8 :ranged-radius 16})}]
   :body {:inventory [["dirt" 64] ["coarse_dirt" 64] ["cobblestone" 64] ["cobbled_deepslate" 64] ["deepslate" 64] ["stone" 64] ["granite" 64] ["diorite" 64] ["andesite" 64] ["tuff" 64] ["gravel" 64] ["netherrack" 64] ["sand" 64] ["red_sand" 64] ["calcite" 64] ["dripstone_block" 64] ["coal" 30] ["diamond" 3] ["wooden_pickaxe" 1] ["stone_pickaxe" 1] ["iron_pickaxe" 1] ["golden_pickaxe" 1] ["diamond_pickaxe" 1] ["netherite_pickaxe" 1] ["wooden_axe" 1] ["stone_axe" 1] ["iron_axe" 1] ["golden_axe" 1] ["diamond_axe" 1] ["netherite_axe" 1] ["wooden_shovel" 1] ["stone_shovel" 1] ["iron_shovel" 1] ["golden_shovel" 1] ["diamond_shovel" 1] ["netherite_shovel" 1]]}
   :act [[:job (jobs.storage.make-room {:free 6})]
         [:rcon "execute at $BODY run summon zombie ~4 ~ ~ {Tags:[\"wt\"],PersistenceRequired:1b,equipment:{head:{id:\"minecraft:iron_helmet\",count:1}}}"]
         [:await {:source :reflex :kind :fired :context {:reflex-id :hostile-near}} 30]
         [:wait-s 2]
         [:rcon "kill @e[type=zombie,tag=wt,x=$X,y=$Y,z=$Z,distance=..40]"]]
   :expect [{:event {:source :reflex :kind :fired :context {:reflex-id :hostile-near}} :within-s 40}
            {:event {:source :job :kind :make-room.done} :within-s 120 :of-job true}
            {:no-event {:source :job :kind :idle} :for-s 5}]
   :after [[:item "coal" 30] [:item "diamond" 3] [:item "tuff" 0] [:item "calcite" 0] [:item "sand" 0]]
   :limit-s 140}]}
