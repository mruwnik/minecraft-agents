;; jobs.movement.go-to column goals (#at [x z]: y left out), a y off the ground, and the :unknown re-aim of a goal seen in the ground.
;; Plot 90 long, stone floor at y -1; the plateau cases build a 12-high plateau reached by a 1-per-step ramp, so the ground at the
;; goal column is more than 8 above/below the feet (perception is 16 blocks, so the far column is unseen from the start).
;; Should-succeed: column goal, :unknown far plateau/valley column, y 3 off, far plateau column, valley column, y goal inside the far plateau, :unknown goal inside a mound,
;; :unknown block goal with :range 1 (stands beside it), a column in a roofed hut, a 4-high hall or under a chest hung under the roof (its floor),
;; a wall under an eave (the ground beside it), a deck over a ditch (the deck), from a ledge over the column (down to its ground), a doorless hut (dug in to its floor). Should-fail: a column behind a bottomless gap ends :arrived false, bounded.
{:defaults
 {:tags [:movement :go-to :column]
  :time :any
  :plot {:height 16 :length 90 :width 32}
  :body {:at [2.5 0 16.5] :settle-s 2}
  :limit-s 150}
 :cases
 [{:name "column-goal-arrives-on-the-ground"
   :act [[:job (jobs.movement.go-to {:worth 1200 :pos #at [60 16] :range 0})]]
   :expect [{:event {:source :job :kind :completed :data {:arrived true}} :within-s 120 :of-job true}]
   :after [[:body-near [60.5 0 16.5] 2]]}
  {:name "y-off-by-three-arrives"
   :act [[:job (jobs.movement.go-to {:worth 1200 :pos #at [40 3 16] :range 0})]]
   :expect [{:event {:source :job :kind :completed :data {:arrived true}} :within-s 90 :of-job true}]
   :after [[:body-near [40.5 0 16.5] 2]]}
  {:name "far-plateau-column-more-than-8-up-arrives"
   :blocks [[:fill [52 0 0] [80 11 31] "stone"]
            [:fill [40 0 0] [40 0 31] "stone"] [:fill [41 0 0] [41 1 31] "stone"] [:fill [42 0 0] [42 2 31] "stone"]
            [:fill [43 0 0] [43 3 31] "stone"] [:fill [44 0 0] [44 4 31] "stone"] [:fill [45 0 0] [45 5 31] "stone"]
            [:fill [46 0 0] [46 6 31] "stone"] [:fill [47 0 0] [47 7 31] "stone"] [:fill [48 0 0] [48 8 31] "stone"]
            [:fill [49 0 0] [49 9 31] "stone"] [:fill [50 0 0] [50 10 31] "stone"] [:fill [51 0 0] [51 11 31] "stone"]]
   :act [[:job (jobs.movement.go-to {:worth 1200 :pos #at [60 16] :range 0})]]
   :expect [{:event {:source :job :kind :completed :data {:arrived true}} :within-s 140 :of-job true}
            {:no-event {:source :job :kind #{:completed :stopped} :data {:why :goal-not-standable}} :for-s 140 :until {:source :job :kind #{:completed :stopped}}}]
   :after [[:body-near [60.5 12 16.5] 2]]}
  {:name "far-valley-column-more-than-8-down-arrives"
   :blocks [[:fill [0 0 0] [30 11 31] "stone"]
            [:fill [31 0 0] [31 10 31] "stone"] [:fill [32 0 0] [32 9 31] "stone"] [:fill [33 0 0] [33 8 31] "stone"]
            [:fill [34 0 0] [34 7 31] "stone"] [:fill [35 0 0] [35 6 31] "stone"] [:fill [36 0 0] [36 5 31] "stone"]
            [:fill [37 0 0] [37 4 31] "stone"] [:fill [38 0 0] [38 3 31] "stone"] [:fill [39 0 0] [39 2 31] "stone"]
            [:fill [40 0 0] [40 1 31] "stone"] [:fill [41 0 0] [41 0 31] "stone"]]
   :body {:at [2.5 12 16.5]}
   :act [[:job (jobs.movement.go-to {:worth 1200 :pos #at [60 16] :range 0})]]
   :expect [{:event {:source :job :kind :completed :data {:arrived true}} :within-s 140 :of-job true}
            {:no-event {:source :job :kind #{:completed :stopped} :data {:why :goal-not-standable}} :for-s 140 :until {:source :job :kind #{:completed :stopped}}}]
   :after [[:body-near [60.5 0 16.5] 2]]}
  ;; 857a8e16: the unseen column's ground is a slope bumped into cell by cell; the walk looks and aims again, never gives up :unseen-floors
  {:name "unknown-far-plateau-column-is-walked-up-to"
   :blocks [[:fill [52 0 0] [80 11 31] "stone"]
            [:fill [40 0 0] [40 0 31] "stone"] [:fill [41 0 0] [41 1 31] "stone"] [:fill [42 0 0] [42 2 31] "stone"]
            [:fill [43 0 0] [43 3 31] "stone"] [:fill [44 0 0] [44 4 31] "stone"] [:fill [45 0 0] [45 5 31] "stone"]
            [:fill [46 0 0] [46 6 31] "stone"] [:fill [47 0 0] [47 7 31] "stone"] [:fill [48 0 0] [48 8 31] "stone"]
            [:fill [49 0 0] [49 9 31] "stone"] [:fill [50 0 0] [50 10 31] "stone"] [:fill [51 0 0] [51 11 31] "stone"]]
   :act [[:job (jobs.movement.go-to {:worth 1200 :pos #at [60 16] :range 0 :unknown true})]]
   :expect [{:event {:source :job :kind :completed :data {:arrived true}} :within-s 140 :of-job true}
            {:no-event {:source :job :kind #{:completed :stopped} :data {:why :unseen-floors}} :for-s 140 :until {:source :job :kind #{:completed :stopped}}}]
   :after [[:body-near [60.5 12 16.5] 2]]}
  {:name "unknown-far-valley-column-is-walked-down-to"
   :blocks [[:fill [0 0 0] [30 11 31] "stone"]
            [:fill [31 0 0] [31 10 31] "stone"] [:fill [32 0 0] [32 9 31] "stone"] [:fill [33 0 0] [33 8 31] "stone"]
            [:fill [34 0 0] [34 7 31] "stone"] [:fill [35 0 0] [35 6 31] "stone"] [:fill [36 0 0] [36 5 31] "stone"]
            [:fill [37 0 0] [37 4 31] "stone"] [:fill [38 0 0] [38 3 31] "stone"] [:fill [39 0 0] [39 2 31] "stone"]
            [:fill [40 0 0] [40 1 31] "stone"] [:fill [41 0 0] [41 0 31] "stone"]]
   :body {:at [2.5 12 16.5]}
   :act [[:job (jobs.movement.go-to {:worth 1200 :pos #at [60 16] :range 0 :unknown true})]]
   :expect [{:event {:source :job :kind :completed :data {:arrived true}} :within-s 140 :of-job true}
            {:no-event {:source :job :kind #{:completed :stopped} :data {:why :unseen-floors}} :for-s 140 :until {:source :job :kind #{:completed :stopped}}}]
   :after [[:body-near [60.5 0 16.5] 2]]}
  {:name "unknown-y-goal-inside-far-plateau-is-re-aimed-to-its-top"
   :blocks [[:fill [52 0 0] [80 11 31] "stone"]
            [:fill [40 0 0] [40 0 31] "stone"] [:fill [41 0 0] [41 1 31] "stone"] [:fill [42 0 0] [42 2 31] "stone"]
            [:fill [43 0 0] [43 3 31] "stone"] [:fill [44 0 0] [44 4 31] "stone"] [:fill [45 0 0] [45 5 31] "stone"]
            [:fill [46 0 0] [46 6 31] "stone"] [:fill [47 0 0] [47 7 31] "stone"] [:fill [48 0 0] [48 8 31] "stone"]
            [:fill [49 0 0] [49 9 31] "stone"] [:fill [50 0 0] [50 10 31] "stone"] [:fill [51 0 0] [51 11 31] "stone"]]
   :act [[:job (jobs.movement.go-to {:worth 1200 :pos #at [60 8 16] :range 0 :unknown true})]]
   :expect [{:event {:source :job :kind :completed :data {:arrived true}} :within-s 140 :of-job true}
            {:no-event {:source :job :kind #{:completed :stopped} :data {:why :unseen-floor-dark}} :for-s 140 :until {:source :job :kind #{:completed :stopped}}}]
   :after [[:body-near [60.5 12 16.5] 2]]}
  ;; 6b85f599: in the dark the walk's sight gate presses against the mound's wall; it must let go after a few still ticks, replan and arrive
  {:name "unknown-goal-inside-a-mound-in-daylight-arrives-on-top"
   :blocks [[:fill [28 0 14] [32 0 18] "stone"]]
   :act [[:job (jobs.movement.go-to {:worth 1200 :pos #at [30 0 16] :range 0 :unknown true})]]
   :expect [{:event {:source :job :kind :completed :data {:arrived true}} :within-s 90 :of-job true}
            {:no-event {:source :job :kind #{:completed :stopped} :data {:why :unseen-floor-dark}} :for-s 90 :until {:source :job :kind #{:completed :stopped}}}]
   :after [[:body-near [30.5 1 16.5] 1.5]]}
  {:name "unknown-block-goal-with-range-1-stands-beside-it"
   :blocks [[:set [30 0 16] "crafting_table"]]
   :act [[:job (jobs.movement.go-to {:worth 1200 :pos #at [30 0 16] :range 1 :unknown true})]]
   :expect [{:event {:source :job :kind :completed :data {:arrived true}} :within-s 90 :of-job true}]
   :after [[:body-near [30.5 0 16.5] 2.5] [:body-far [30.5 1 16.5] 1.2]]}
  {:name "column-behind-a-bottomless-gap-gives-up-bounded"
   :blocks [[:fill [40 -8 0] [50 -1 31] "air"]]
   :act [[:job (jobs.movement.go-to {:worth 1200 :pos #at [70 16] :range 0})]]
   :expect [{:event {:source :job :kind :stopped :data {:arrived false}} :within-s 140 :of-job true}]
   :after [[:body-far [70.5 0 16.5] 10]]}
  {:name "hill-with-a-cave-below-arrives-on-the-surface"
   ;; card f77bb797 (0511f2d7, 234b3eda6): a column goal over a hill whose inside holds an unseen cave (mouth in its west face) aims at the hill's top,
   ;; not at the cave floor nearest the feet; the body walks the ramp and arrives on the surface (feet y 6)
   :blocks [[:fill [14 0 8] [14 0 24] "stone"] [:fill [15 0 8] [15 1 24] "stone"] [:fill [16 0 8] [16 2 24] "stone"] [:fill [17 0 8] [17 3 24] "stone"] [:fill [18 0 8] [18 4 24] "stone"] [:fill [19 0 8] [19 5 24] "stone"]
            [:fill [20 0 8] [40 5 24] "stone"] [:fill [22 0 14] [36 2 18] "air"] [:fill [20 0 16] [21 1 16] "air"]]
   :act [[:job (jobs.movement.go-to {:worth 1200 :pos #at [30 16] :range 1})]]
   :expect [{:event {:source :job :kind :completed :data {:arrived true}} :within-s 120 :of-job true}]
   :after [[:body-near [30.5 6 16.5] 2.5]]}
  {:name "column-goal-in-a-roofed-hut-arrives-on-its-floor"
   ;; card 74623624: a roof is cover, the plank floor under it is the column's ground; nothing of the hut is dug
   :blocks [[:fill [30 0 14] [34 0 18] "oak_planks"] [:fill [30 1 14] [34 3 18] "cobblestone"] [:fill [30 4 14] [34 4 18] "oak_planks"]
            [:fill [31 1 15] [33 3 17] "air"] [:fill [30 1 16] [30 2 16] "air"]]
   :act [[:job (jobs.movement.go-to {:worth 1200 :pos #at [32 16] :range 0})]]
   :expect [{:event {:source :job :kind :completed :data {:arrived true}} :within-s 120 :of-job true}]
   :after [[:body-near [32.5 1 16.5] 1.5] [:block [32 4 16] "oak_planks"] [:block [34 2 16] "cobblestone"]]}
  {:name "column-goal-on-a-wall-under-an-eave-arrives-beside-it"
   ;; card 74623624 (run 4): the column is a court wall under a slab eave; neither the eave nor the wall top is ground, the ground beside it is
   :blocks [[:fill [30 0 10] [30 0 22] "mossy_cobblestone"] [:fill [30 1 10] [30 1 22] "cobblestone_wall"] [:set [30 2 16] "lantern"]
            [:fill [29 3 10] [31 3 22] "oak_slab"]]
   :act [[:job (jobs.movement.go-to {:worth 1200 :pos #at [30 16] :range 2})]]
   :expect [{:event {:source :job :kind :completed :data {:arrived true}} :within-s 120 :of-job true}]
   :after [[:body-near [30.5 0 16.5] 2.5] [:block [30 1 16] "cobblestone_wall"] [:block [30 3 16] "oak_slab"]]}
  {:name "column-goal-in-a-4-high-hall-arrives-on-its-floor"
   ;; card 1c7aba99: any stand of the column is a goal; the roof loses to the floor through the door, however high the room
   :blocks [[:fill [30 0 14] [34 0 18] "oak_planks"] [:fill [30 1 14] [34 4 18] "cobblestone"] [:fill [30 5 14] [34 5 18] "oak_planks"]
            [:fill [31 1 15] [33 4 17] "air"] [:fill [30 1 16] [30 2 16] "air"]]
   :act [[:job (jobs.movement.go-to {:worth 1200 :pos #at [32 16] :range 0})]]
   :expect [{:event {:source :job :kind :completed :data {:arrived true :why :column}} :within-s 120 :of-job true}
            {:no-event {:source :job :kind :go-to.escalated} :for-s 120 :until {:source :job :kind #{:completed :stopped}}}]
   :after [[:body-near [32.5 1 16.5] 1.5] [:block [32 5 16] "oak_planks"]]}
  {:name "column-goal-under-a-chest-hung-under-the-roof-arrives-on-the-floor"
   ;; card 1c7aba99: a chest in the cell under the roof does not make the roof a stand to walk to
   :blocks [[:fill [30 0 14] [34 0 18] "oak_planks"] [:fill [30 1 14] [34 3 18] "cobblestone"] [:fill [30 4 14] [34 4 18] "oak_planks"]
            [:fill [31 1 15] [33 3 17] "air"] [:fill [30 1 16] [30 2 16] "air"] [:set [32 3 16] "chest"]]
   :act [[:job (jobs.movement.go-to {:worth 1200 :pos #at [32 16] :range 0})]]
   :expect [{:event {:source :job :kind :completed :data {:arrived true :why :column}} :within-s 120 :of-job true}
            {:no-event {:source :job :kind :go-to.escalated} :for-s 120 :until {:source :job :kind #{:completed :stopped}}}]
   :after [[:body-near [32.5 1 16.5] 1.5] [:block [32 4 16] "oak_planks"] [:block [32 3 16] "chest"]]}
  {:name "column-goal-on-a-deck-over-a-ditch-arrives-on-the-deck"
   ;; card 1c7aba99: a 3-high mound climbed by steps, a ditch through it 3 deep, a plank deck over its middle with 2 free cells
   ;; under it; the deck is the cheapest stand of the column, not the ditch floor under it
   :blocks [[:fill [26 0 10] [26 0 22] "stone"] [:fill [27 0 10] [27 1 22] "stone"] [:fill [28 0 10] [36 2 22] "stone"]
            [:fill [31 0 10] [33 2 22] "air"] [:fill [31 2 14] [33 2 18] "oak_planks"]]
   :act [[:job (jobs.movement.go-to {:worth 1200 :pos #at [32 16] :range 0})]]
   :expect [{:event {:source :job :kind :completed :data {:arrived true :why :column}} :within-s 120 :of-job true}]
   :after [[:body-near [32.5 3 16.5] 1.5] [:block [32 2 16] "oak_planks"]]}
  {:name "column-goal-is-not-arrived-at-from-a-ledge-over-it"
   ;; card aa864d25: the ledge top (feet 3) is within range 2 of the column across but above its only stand (feet 0): not there
   :blocks [[:fill [0 0 0] [10 2 31] "stone"]]
   :body {:at [10.5 3 16.5]}
   :act [[:job (jobs.movement.go-to {:worth 1200 :pos #at [12 16] :range 2})]]
   :expect [{:event {:source :job :kind :completed :data {:arrived true :why :column}} :within-s 60 :of-job true}]
   :after [[:body-near [12.5 0 16.5] 2.5]]}
  {:name "column-goal-in-a-doorless-hut-digs-in-to-its-floor"
   ;; card 2574d3a3: no walk reaches the column's floor or roof; the dig route to the floor (one wall cell, its put-back) is cheaper than any way onto the roof
   :blocks [[:fill [30 0 14] [34 0 18] "oak_planks"] [:fill [30 1 14] [34 3 18] "oak_planks"] [:fill [30 4 14] [34 4 18] "oak_planks"]
            [:fill [31 1 15] [33 3 17] "air"]]
   :act [[:job (jobs.movement.go-to {:worth 1200 :pos #at [32 16] :range 0})]]
   :expect [{:event {:source :job :kind :go-to.escalated :data {:step :dig-route}} :within-s 120 :of-job true}
            {:event {:source :job :kind :completed :data {:arrived true :why :column}} :within-s 150 :of-job true}]
   :after [[:body-near [32.5 1 16.5] 1.5] [:block [32 4 16] "oak_planks"]]}]}
