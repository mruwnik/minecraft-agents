;; jobs.movement.go-to column goals (#at [x z]: y left out), a y off the ground, and the :unknown re-aim of a goal seen in the ground.
;; Plot 90 long, stone floor at y -1; the plateau cases build a 12-high plateau reached by a 1-per-step ramp, so the ground at the
;; goal column is more than 8 above/below the feet (perception is 16 blocks, so the far column is unseen from the start).
;; Should-succeed: column goal, y 3 off, far plateau column, valley column, y goal inside the far plateau, :unknown goal inside a mound,
;; :unknown block goal with :range 1 (stands beside it). Should-fail: a column behind a bottomless gap ends :arrived false, bounded.
{:defaults
 {:tags [:movement :go-to :column]
  :time :any
  :plot {:height 16 :length 90 :width 32}
  :body {:at [2.5 0 16.5] :settle-s 2}
  :limit-s 150}
 :cases
 [{:name "column-goal-arrives-on-the-ground"
   :act [[:job (jobs.movement.go-to {:pos #at [60 16] :range 0})]]
   :expect [{:event {:source :job :kind :completed :data {:arrived true}} :within-s 120 :of-job true}]
   :after [[:body-near [60.5 0 16.5] 2]]}
  {:name "y-off-by-three-arrives"
   :act [[:job (jobs.movement.go-to {:pos #at [40 3 16] :range 0})]]
   :expect [{:event {:source :job :kind :completed :data {:arrived true}} :within-s 90 :of-job true}]
   :after [[:body-near [40.5 0 16.5] 2]]}
  {:name "far-plateau-column-more-than-8-up-arrives"
   :blocks [[:fill [52 0 0] [80 11 31] "stone"]
            [:fill [40 0 0] [40 0 31] "stone"] [:fill [41 0 0] [41 1 31] "stone"] [:fill [42 0 0] [42 2 31] "stone"]
            [:fill [43 0 0] [43 3 31] "stone"] [:fill [44 0 0] [44 4 31] "stone"] [:fill [45 0 0] [45 5 31] "stone"]
            [:fill [46 0 0] [46 6 31] "stone"] [:fill [47 0 0] [47 7 31] "stone"] [:fill [48 0 0] [48 8 31] "stone"]
            [:fill [49 0 0] [49 9 31] "stone"] [:fill [50 0 0] [50 10 31] "stone"] [:fill [51 0 0] [51 11 31] "stone"]]
   :act [[:job (jobs.movement.go-to {:pos #at [60 16] :range 0})]]
   :expect [{:event {:source :job :kind :completed :data {:arrived true}} :within-s 140 :of-job true}
            {:no-event {:source :job :kind #{:completed :stopped} :data {:why :goal-not-standable}} :for-s 140 :until {:source :job :kind #{:completed :stopped}}}]
   :after [[:body-near [60.5 12 16.5] 2]]}
  {:name "far-valley-column-more-than-8-down-arrives"
   :blocks [[:fill [0 0 0] [30 11 31] "stone"]
            [:fill [31 0 0] [31 10 31] "stone"] [:fill [32 0 0] [32 9 31] "stone"] [:fill [33 0 0] [33 8 31] "stone"]
            [:fill [34 0 0] [34 7 31] "stone"] [:fill [35 0 0] [35 6 31] "stone"] [:fill [36 0 0] [36 5 31] "stone"]
            [:fill [37 0 0] [37 4 31] "stone"] [:fill [38 0 0] [38 3 31] "stone"] [:fill [39 0 0] [39 2 31] "stone"]
            [:fill [40 0 0] [40 1 31] "stone"] [:fill [41 0 0] [41 0 31] "stone"]]
   :body {:at [2.5 12 16.5]}
   :act [[:job (jobs.movement.go-to {:pos #at [60 16] :range 0})]]
   :expect [{:event {:source :job :kind :completed :data {:arrived true}} :within-s 140 :of-job true}
            {:no-event {:source :job :kind #{:completed :stopped} :data {:why :goal-not-standable}} :for-s 140 :until {:source :job :kind #{:completed :stopped}}}]
   :after [[:body-near [60.5 0 16.5] 2]]}
  {:name "unknown-y-goal-inside-far-plateau-is-re-aimed-to-its-top"
   :blocks [[:fill [52 0 0] [80 11 31] "stone"]
            [:fill [40 0 0] [40 0 31] "stone"] [:fill [41 0 0] [41 1 31] "stone"] [:fill [42 0 0] [42 2 31] "stone"]
            [:fill [43 0 0] [43 3 31] "stone"] [:fill [44 0 0] [44 4 31] "stone"] [:fill [45 0 0] [45 5 31] "stone"]
            [:fill [46 0 0] [46 6 31] "stone"] [:fill [47 0 0] [47 7 31] "stone"] [:fill [48 0 0] [48 8 31] "stone"]
            [:fill [49 0 0] [49 9 31] "stone"] [:fill [50 0 0] [50 10 31] "stone"] [:fill [51 0 0] [51 11 31] "stone"]]
   :act [[:job (jobs.movement.go-to {:pos #at [60 8 16] :range 0 :unknown true})]]
   :expect [{:event {:source :job :kind :completed :data {:arrived true}} :within-s 140 :of-job true}
            {:no-event {:source :job :kind #{:completed :stopped} :data {:why :unseen-floor-dark}} :for-s 140 :until {:source :job :kind #{:completed :stopped}}}]
   :after [[:body-near [60.5 12 16.5] 2]]}
  ;; 6b85f599: in the dark the walk's sight gate presses against the mound's wall; it must let go after a few still ticks, replan and arrive
  {:name "unknown-goal-inside-a-mound-in-daylight-arrives-on-top"
   :blocks [[:fill [28 0 14] [32 0 18] "stone"]]
   :act [[:job (jobs.movement.go-to {:pos #at [30 0 16] :range 0 :unknown true})]]
   :expect [{:event {:source :job :kind :completed :data {:arrived true}} :within-s 90 :of-job true}
            {:no-event {:source :job :kind #{:completed :stopped} :data {:why :unseen-floor-dark}} :for-s 90 :until {:source :job :kind #{:completed :stopped}}}]
   :after [[:body-near [30.5 1 16.5] 1.5]]}
  {:name "unknown-block-goal-with-range-1-stands-beside-it"
   :blocks [[:set [30 0 16] "crafting_table"]]
   :act [[:job (jobs.movement.go-to {:pos #at [30 0 16] :range 1 :unknown true})]]
   :expect [{:event {:source :job :kind :completed :data {:arrived true}} :within-s 90 :of-job true}]
   :after [[:body-near [30.5 0 16.5] 2.5] [:body-far [30.5 1 16.5] 1.2]]}
  {:name "column-behind-a-bottomless-gap-gives-up-bounded"
   :blocks [[:fill [40 -8 0] [50 -1 31] "air"]]
   :act [[:job (jobs.movement.go-to {:pos #at [70 16] :range 0})]]
   :expect [{:event {:source :job :kind :stopped :data {:arrived false}} :within-s 140 :of-job true}]
   :after [[:body-far [70.5 0 16.5] 10]]}
  {:name "hill-with-a-cave-below-arrives-on-the-surface"
   ;; card f77bb797 (0511f2d7, 234b3eda6): a column goal over a hill whose inside holds an unseen cave (mouth in its west face) aims at the hill's top,
   ;; not at the cave floor nearest the feet; the body walks the ramp and arrives on the surface (feet y 6)
   :blocks [[:fill [14 0 8] [14 0 24] "stone"] [:fill [15 0 8] [15 1 24] "stone"] [:fill [16 0 8] [16 2 24] "stone"] [:fill [17 0 8] [17 3 24] "stone"] [:fill [18 0 8] [18 4 24] "stone"] [:fill [19 0 8] [19 5 24] "stone"]
            [:fill [20 0 8] [40 5 24] "stone"] [:fill [22 0 14] [36 2 18] "air"] [:fill [20 0 16] [21 1 16] "air"]]
   :act [[:job (jobs.movement.go-to {:pos #at [30 16] :range 1})]]
   :expect [{:event {:source :job :kind :completed :data {:arrived true}} :within-s 120 :of-job true}]
   :after [[:body-near [30.5 6 16.5] 2.5]]}]}
