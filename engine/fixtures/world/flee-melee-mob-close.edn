;; Card 7a416a5f: a bare body with a melee mob 2 blocks off on open ground walks away: a flight is priced by the blows the
;; race lets the mob land while it is within reach, not blows over the whole flight, so the fist fight (certain death) never wins.
;; An evenly lit underground plot. The zombie is NoAI and helmeted (it never hurts, no sun burn).
;; Should-succeed: the body decides :flee, walks off, and never fights the zombie (still alive).
;; Should-fail (control): an iron-sword body with the zombie beside it kills it (every way is caught, so the flight is cornered
;; and its fight wins).
{:defaults
 {:tags [:hostile :survival :flee]
  :time :any
  :register [{:trigger :hostile-near}]
  :plot {:light :lit}
  :body {:at [16.5 0 16.5] :effects [["resistance" 600 4]]}
  :limit-s 60}
 :cases
 [{:name "bare-body-walks-from-a-zombie-two-blocks-off"
   :act [[:summon "zombie" [18.5 0 16.5] "{NoAI:1b,equipment:{head:{id:\"minecraft:iron_helmet\",count:1}}}"]
         [:await {:source :job :kind :hostile.decided :data {:decision :flee}} 15]
         [:wait-s 8]]
   :expect [{:no-event {:source :job :kind :hostile.decided :data {:decision :fight}} :for-s 20}]
   :after [[:body-far [16.5 0 16.5] 3] [:entities "type=zombie,tag=wt" [[3 -1 3] [30 6 30]] 1]]}
  {:name "armed-body-fights-a-zombie-beside-it"
   :body {:inventory [["iron_sword" 1]]}
   :act [[:summon "zombie" [17.5 0 16.5] "{NoAI:1b,equipment:{head:{id:\"minecraft:iron_helmet\",count:1}}}"]
         [:wait-s 20]]
   :after [[:entities "type=zombie,tag=wt" [[3 -1 3] [30 6 30]] 0]]}]}
