;; Card 410c5e19: go-to's walking damage budget with the default :max-damage. A stone block y 0..9 fills x 1..15 (the body on top at
;; feet y 10, x 8.5), walls all round, the goal on the floor east of its edge at x 22: a drop of 10, which a full-health fed body may
;; take (7 hp of budget). Landings: plain floor, water (no damage), lava (never; the goal is a stone pillar in the lava, so only
;; the landing can refuse). :floor {:health 14} leaves a budget of 5 at full health (regeneration cannot race it), so no drop past 6.
;; The body waits inside the new stone fill before its teleport: the no-hurt checks skip that 1 hp of suffocation.
{:defaults
 {:tags [:movement]
  :time :any
  :plot {:height 16}
  :blocks [[:fill [0 0 0] [31 12 0] "stone"] [:fill [0 0 31] [31 12 31] "stone"] [:fill [0 0 0] [0 12 31] "stone"] [:fill [31 0 0] [31 12 31] "stone"]
           [:fill [1 0 1] [15 9 30] "stone"]]
  :body {:at [8.5 10 16.5]}
  :limit-s 90}
 :cases
 [{:name "default-takes-the-10-drop-onto-floor"
   :act [[:job (jobs.movement.go-to {:pos #at [22 0 16] :range 1 :ways #{:walk :clear-seal}})]]
   :expect [{:event {:source :job :kind :completed :data {:arrived true}} :within-s 60 :of-job true}]
   :after [[:body-near [22.5 0 16.5] 2]]}
  {:name "drop-into-water-takes-no-damage"
   :blocks [[:fill [18 0 12] [26 0 20] "water"]]
   :act [[:job (jobs.movement.go-to {:pos #at [22 0 16] :range 1 :ways #{:walk :clear-seal}})]]
   :expect [{:event {:source :job :kind :completed :data {:arrived true}} :within-s 60 :of-job true}
            {:no-event {:source :body :kind :hurt :data {:causes ["fall"]}} :for-s 60 :until {:source :job :kind #{:completed :stopped}}}]
   :after [[:body-near [22.5 0 16.5] 3]]}
  {:name "lava-landing-is-never-dropped-into"
   :blocks [[:fill [16 0 1] [30 0 30] "lava"] [:fill [22 0 16] [22 0 16] "stone"]]
   :act [[:job (jobs.movement.go-to {:pos #at [22 1 16] :range 1 :ways #{:walk :clear-seal}})]]
   :expect [{:event {:source :job :kind :stopped :data {:arrived false}} :within-s 60 :of-job true}
            {:no-event {:source :body :kind :hurt :data {:causes [:not ["suffocation"]]}} :for-s 60 :until {:source :job :kind #{:completed :stopped}}}]
   :after [[:body-far [22.5 1 16.5] 4]]}
  {:name "min-health-14-does-not-take-the-10-drop"
   :act [[:job (jobs.movement.go-to {:pos #at [22 0 16] :range 1 :ways #{:walk :clear-seal} :floor {:health 14}})]]
   :expect [{:event {:source :job :kind :stopped :data {:arrived false}} :within-s 60 :of-job true}
            {:no-event {:source :body :kind :hurt :data {:causes [:not ["suffocation"]]}} :for-s 60 :until {:source :job :kind #{:completed :stopped}}}]
   :after [[:body-far [22.5 0 16.5] 4]]}
  {:name "max-damage-0-does-not-take-the-10-drop"
   :act [[:job (jobs.movement.go-to {:pos #at [22 0 16] :range 1 :ways #{:walk :clear-seal} :spend {:health 0}})]]
   :expect [{:event {:source :job :kind :stopped :data {:arrived false}} :within-s 60 :of-job true}]
   :after [[:body-far [22.5 0 16.5] 4]]}
  ;; card ad0a3ff7: over the damage budget a walk gives up (:needs-health) unless the caller opts in with :allow-over-budget; the 13 drop (10 hp) is over
  ;; the budget of 7 at full health, the 10 drop above is not
  {:name "default-does-not-take-the-13-drop"
   :plot {:height 18}
   :blocks [[:fill [0 10 0] [31 13 0] "stone"] [:fill [0 10 31] [31 13 31] "stone"] [:fill [0 10 0] [0 13 31] "stone"] [:fill [31 10 0] [31 13 31] "stone"]
            [:fill [1 10 1] [15 12 30] "stone"]]
   :body {:at [8.5 13 16.5]}
   :act [[:job (jobs.movement.go-to {:pos #at [22 0 16] :range 1 :ways #{:walk :clear-seal}})]]
   :expect [{:event {:source :job :kind :stopped :data {:arrived false}} :within-s 60 :of-job true}
            {:no-event {:source :body :kind :hurt :data {:causes [:not ["suffocation"]]}} :for-s 60 :until {:source :job :kind #{:completed :stopped}}}]
   :after [[:body-far [22.5 0 16.5] 4]]}
  {:name "allow-over-budget-takes-the-13-drop"
   :plot {:height 18}
   :blocks [[:fill [0 10 0] [31 13 0] "stone"] [:fill [0 10 31] [31 13 31] "stone"] [:fill [0 10 0] [0 13 31] "stone"] [:fill [31 10 0] [31 13 31] "stone"]
            [:fill [1 10 1] [15 12 30] "stone"]]
   :body {:at [8.5 13 16.5] :effects [["resistance" 600 4]]}
   :act [[:job (jobs.movement.go-to {:pos #at [22 0 16] :range 1 :ways #{:walk :clear-seal} :floor {:health 1}})]]
   :expect [{:event {:source :job :kind :completed :data {:arrived true}} :within-s 60 :of-job true}]
   :after [[:body-near [22.5 0 16.5] 2]]}
  ;; card 555ba3aa: at 4 hp (hunger first, no regeneration) a walk that may go over the budget still takes no drop its fall damage reaches the health on,
  ;; ground or water (the water may not be where it was seen): the 10 drop costs 7 hp, so the body stays on the block.
  {:name "hurt-body-over-budget-does-not-take-the-10-drop-to-ground"
   :act [[:rcon "effect give $BODY minecraft:hunger 5 255 true"] [:until-effect-gone "hunger" 30] [:rcon "damage $BODY 16 minecraft:generic"]
         [:job (jobs.movement.go-to {:pos #at [22 0 16] :range 1 :ways #{:walk :clear-seal} :floor {:health 1}})]]
   :expect [{:event {:source :job :kind :stopped :data {:arrived false}} :within-s 60 :of-job true}
            {:no-event {:source :body :kind :hurt :data {:causes ["fall"]}} :for-s 60 :until {:source :job :kind #{:completed :stopped}}}]
   :after [[:body-far [22.5 0 16.5] 4]]
   :limit-s 150}
  {:name "hurt-body-over-budget-does-not-take-the-10-drop-into-water"
   :blocks [[:fill [18 0 12] [26 0 20] "water"]]
   :act [[:rcon "effect give $BODY minecraft:hunger 5 255 true"] [:until-effect-gone "hunger" 30] [:rcon "damage $BODY 16 minecraft:generic"]
         [:job (jobs.movement.go-to {:pos #at [22 0 16] :range 1 :ways #{:walk :clear-seal} :floor {:health 1}})]]
   :expect [{:event {:source :job :kind :stopped :data {:arrived false}} :within-s 60 :of-job true}
            {:no-event {:source :body :kind :hurt :data {:causes ["fall"]}} :for-s 60 :until {:source :job :kind #{:completed :stopped}}}]
   :after [[:body-far [22.5 0 16.5] 4]]
   :limit-s 150}
  ;; card e753a3ca: a hay bale landing cuts fall damage to a fifth, so the 9 drop (hay top y 1) fits the budget of 5 that the same drop onto stone would not
  {:name "hay-landing-9-drop-at-floor-14-arrives"
   :blocks [[:fill [16 0 12] [26 0 20] "hay_block"]]
   :act [[:job (jobs.movement.go-to {:pos #at [22 1 16] :range 1 :ways #{:walk :clear-seal} :floor {:health 14}})]]
   :expect [{:event {:source :job :kind :completed :data {:arrived true}} :within-s 60 :of-job true}]
   :after [[:body-near [22.5 1 16.5] 2.5]]}]}
