;; Card 398bf704: a body sealed in a room over a dark shaft (the planner refuses the floor it cannot see, so the search ends at the
;; loaded edge, :goal-unloaded, not :start-enclosed) with a goal far off in unloaded land and a pickaxe escalates (digs out) instead of
;; giving up :goal-unloaded. Layout as go-to-own-shelter-dark-shaft: stone block x 10..48 with a sealed room (x 11..13, feet y 3) over a
;; 6-deep dark shaft at x 13; the goal is 1000 blocks west.
;; Should-succeed: the call escalates. Should-fail: it stops :goal-unloaded without escalating.
{:defaults
 {:tags [:movement :go-to]
  :time :any
  :plot {:height 14 :length 64 :light :dark}
  :blocks [[:fill [10 -4 14] [48 8 18] "stone"]
           [:fill [11 3 16] [13 4 16] "air"]
           [:fill [13 -3 16] [13 2 16] "air"]]
  :body {:at [12.5 3 16.5] :settle-s 3 :effects [["resistance" 600 4]] :inventory [["stone_pickaxe" 1] ["dirt" 8]]}
  :limit-s 120}
 :cases
 [{:name "sealed-over-a-dark-shaft-far-unloaded-goal-escalates"
   :act [[:job (jobs.movement.go-to {:pos #at [-1000 3 16] :range 1})]]
   :expect [{:event {:source :job :kind :go-to.escalated} :within-s 90 :of-job true}
            {:no-event {:source :job :kind :stopped :data {:why :goal-unloaded}} :for-s 90 :until {:source :job :kind :go-to.escalated}}]}]}
