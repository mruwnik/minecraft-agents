;; Card c5d2cded part 1: tool wear after digs in jobs.access.cleanup and jobs.forestry.prepare. A pickaxe with 1 durability
;; left (damage=249) breaks in the dig: warn tool.broke then tool.none; a healthy pick gives no tool event; no pick at all
;; Cleanup holds an unarmed body (:fit? is ready/fit-armed) and waits out the night (:safe?), so the cleanup cases carry a sword.
;; gives none either (nothing is dug: prepare and cleanup leave a block that needs a pick). Cleanup digs the cobblestone pillar the same body placed; prepare digs a
;; cobblestone stray in the planned oak cell. Torches keep hostiles away.  Run: node tools/world-test.mjs <file> --match <name> --first-plot N
{:defaults
 {:tags [:tool-wear :cleanup :prepare]
  :blocks [[:set [2 0 2] "torch"] [:set [2 0 30] "torch"] [:set [30 0 2] "torch"] [:set [30 0 30] "torch"]
           [:set [10 0 10] "torch"] [:set [22 0 22] "torch"] [:set [10 0 22] "torch"] [:set [22 0 10] "torch"]]
  :limit-s 90}
 :cases
 [{:name "cleanup-last-durability-pick-breaks"
   :body {:inventory [["iron_pickaxe[damage=249]" 1] ["cobblestone" 4] ["iron_sword" 1]]}
   :act [[:job (jobs.access.pillar {:height 2 :use {:blocks ["cobblestone"]} :ignore-zones? true})]
         [:await {:source :job :kind :completed} 60]
         [:job (jobs.access.cleanup {:job :all :ignore-zones? true})]]
   :expect [{:event {:source :job :kind :tool.broke} :within-s 60}
            {:event {:source :job :kind :tool.none} :within-s 60}]
   :after [[:item "iron_pickaxe" 0]]}
  {:name "cleanup-healthy-pick-no-tool-event"
   :body {:inventory [["iron_pickaxe" 1] ["cobblestone" 4] ["iron_sword" 1]]}
   :act [[:job (jobs.access.pillar {:height 2 :use {:blocks ["cobblestone"]} :ignore-zones? true})]
         [:await {:source :job :kind :completed} 60]
         [:job (jobs.access.cleanup {:job :all :ignore-zones? true})]]
   :expect [{:event {:source :job :kind :completed :data {:open [:any]}} :within-s 60}
            {:no-event {:source :job :kind #{:tool.broke :tool.none :tool.low}} :for-s 60 :until {:source :job :kind :completed :data {:open [:any]}}}]
   :after [[:item "iron_pickaxe" 1]]}
  {:name "cleanup-no-pick-no-tool-event"
   :body {:inventory [["cobblestone" 4] ["iron_sword" 1]]}
   :act [[:job (jobs.access.pillar {:height 2 :use {:blocks ["cobblestone"]} :ignore-zones? true})]
         [:await {:source :job :kind :completed} 60]
         [:job (jobs.access.cleanup {:job :all :ignore-zones? true})]]
   ;; no pick: the cobblestone pillar stays (entries open :no-tool), nothing dug, no tool event
   :expect [{:event {:source :job :kind :stopped :data {:open [:has {:reason :no-tool}]}} :within-s 30}
            {:no-event {:source :job :kind #{:tool.broke :tool.none :tool.low}} :for-s 30 :until {:source :job :kind :stopped}}]
   :after [[:block [16 0 16] "cobblestone"] [:block [16 1 16] "cobblestone"]]}
  {:name "prepare-last-durability-pick-breaks"
   :blocks [[:set [16 0 16] "cobblestone"]]
   :plans [{:id "wood" :parts [{:id "t" :cells [#at [16 0 16]] :want {:tree "oak"}}]}]
   :body {:at [16.5 0 12.5] :inventory [["iron_pickaxe[damage=249]" 1] ["oak_sapling" 1] ["dirt" 2]]}
   :act [[:job (jobs.forestry.prepare {:plan "$plan:wood"})]]
   :expect [{:event {:source :job :kind :tool.broke} :within-s 60}
            {:event {:source :job :kind :tool.none} :within-s 60}]
   :after [[:item "iron_pickaxe" 0]]}
  {:name "prepare-healthy-pick-no-tool-event"
   :blocks [[:set [16 0 16] "cobblestone"]]
   :plans [{:id "wood" :parts [{:id "t" :cells [#at [16 0 16]] :want {:tree "oak"}}]}]
   :body {:at [16.5 0 12.5] :inventory [["iron_pickaxe" 1] ["oak_sapling" 1] ["dirt" 2]]}
   :act [[:job (jobs.forestry.prepare {:plan "$plan:wood"})]]
   :expect [{:event {:source :job :kind :completed} :within-s 60 :of-job true}
            {:no-event {:source :job :kind #{:tool.broke :tool.none :tool.low}} :for-s 60 :until {:source :job :kind :completed} :of-job true}]
   :after [[:item "iron_pickaxe" 1] [:block [16 0 16] "air"]]}
  {:name "prepare-no-pick-digs-by-hand-no-tool-event"
   :blocks [[:set [16 0 16] "cobblestone"]]
   :plans [{:id "wood" :parts [{:id "t" :cells [#at [16 0 16]] :want {:tree "oak"}}]}]
   :body {:at [16.5 0 12.5] :inventory [["oak_sapling" 1] ["dirt" 2]]}
   :act [[:job (jobs.forestry.prepare {:plan "$plan:wood"})]]
   ;; no pick: the cobblestone stray is not dug by hand; the only cell is :no-tool, so prepare waits :cells-no-tool before any round, no tool event, no error
   :expect [{:event {:source :job :kind :waiting :data {:reason :cells-no-tool}} :within-s 30 :of-job true}
            {:no-event {:source :job :kind #{:tool.broke :tool.none :tool.low}} :for-s 20}
            {:no-event {:source :job :kind #{:failed :error}} :for-s 20}]
   :after [[:block [16 0 16] "cobblestone"]]}]}
