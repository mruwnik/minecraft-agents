;; Card 7c28955e: gather.mine reads the faces of a cut cell as the body senses them. Lava (or water) in rock beside the tunnel line, never in
;; view from the tunnel, is not a hazard the miner can know; it digs on; unseen lava is no stop, unseen water that breaks in is plugged and the tunnel stops :fluid-adjacent.
;; Stone mass x 2..30, z 8..30, y 0..6, a 1x2 tunnel cell at the body (x 16..19), iron ore at x 24. Resistance and fire resistance keep the probe alive.
{:defaults
 {:tags [:mine :sensing :jobs] :time :any
  :plot {:height 12}
  :blocks [[:fill [2 0 8] [30 6 30] "stone"] [:fill [16 0 16] [19 1 16] "air"] [:set [24 0 16] "iron_ore"]]
  :body {:at [16.5 0 16.5] :yaw 270 :inventory [["stone_pickaxe" 1] ["cobblestone" 16] ["torch" 8] ["bread" 4]] :effects [["resistance" 600 4] ["fire_resistance" 600 0]]}
  :limit-s 120}
 :cases
 [{:name "lava-pocket-beside-the-line-is-not-known-and-the-mine-goes-on"
   :blocks [[:set [22 0 17] "lava"]]
   :act [[:job (jobs.gather.mine {:torches false :block "iron_ore" :level false :count 1 :direction :east :tunnel-length 8 :radius 16 :mend false})]]
   :expect [{:event {:source :job :kind #{:completed :stopped} :data {:got 1}} :within-s 100 :of-job true}]
   :after [[:item "raw_iron" 1]]}
  {:name "water-pocket-beside-the-line-is-not-known-so-the-cut-is-plugged-not-refused"
   :blocks [[:set [22 0 17] "water"]]
   :act [[:job (jobs.gather.mine {:torches false :block "iron_ore" :level false :count 1 :direction :east :tunnel-length 8 :radius 16 :mend false})]]
   :expect [{:event {:source :job :kind :mine.tunnel-end :data {:reason :fluid-adjacent}} :within-s 100 :of-job true}]}]}
