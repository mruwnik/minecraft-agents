;; Card 260065a8: a held :hostiles attack (:hold true) waits for a mob beyond reach only hold-s (15) without a swing, not 15 s in
;; total. A NoAI zombie stands 6 away (in range, beyond reach: the wait); another is summoned within reach every 5 s for
;; 30 s: the fight keeps swinging past 15 s and does not decline, then declines :hold-timeout once the stream stops.
;; The control has only the far zombie and declines about 15 s after the start. Mobs are NoAI and helmeted.
{:defaults
 {:tags [:hostile :combat]
  :register []
  :body {:at [16.5 0 16.5] :inventory [["iron_sword" 1]] :effects [["resistance" 600 4]]}}
 :cases
 [{:name "stream-of-mobs-keeps-the-held-fight-going"
   :act [[:summon "zombie" [16.5 0 22.5] "{NoAI:1b,equipment:{head:{id:\"minecraft:iron_helmet\",count:1}}}"]
         [:until-seen {:entity "zombie"} 10]
         [:job (jobs.combat.attack {:targets :hostiles :radius 8 :hold true})]
         [:summon "zombie" [18.5 0 16.5] "{NoAI:1b,equipment:{head:{id:\"minecraft:iron_helmet\",count:1}}}"]
         [:wait-s 5]
         [:summon "zombie" [18.5 0 16.5] "{NoAI:1b,equipment:{head:{id:\"minecraft:iron_helmet\",count:1}}}"]
         [:wait-s 5]
         [:summon "zombie" [18.5 0 16.5] "{NoAI:1b,equipment:{head:{id:\"minecraft:iron_helmet\",count:1}}}"]
         [:wait-s 5]
         [:summon "zombie" [18.5 0 16.5] "{NoAI:1b,equipment:{head:{id:\"minecraft:iron_helmet\",count:1}}}"]
         [:wait-s 5]
         [:summon "zombie" [18.5 0 16.5] "{NoAI:1b,equipment:{head:{id:\"minecraft:iron_helmet\",count:1}}}"]
         [:wait-s 5]
         [:summon "zombie" [18.5 0 16.5] "{NoAI:1b,equipment:{head:{id:\"minecraft:iron_helmet\",count:1}}}"]
         [:wait-s 5]]
   :expect [{:event {:source :action :kind :done :data {:name "attack" :status "killed"}} :within-s 35}
            {:no-event {:source :job :kind :stopped} :for-s 30 :of-job true}
            {:event {:source :job :kind :stopped :data {:kind :nothing-possible}} :within-s 60 :of-job true}]
   :after [[:entities "type=zombie,tag=wt" [[0 0 0] [32 4 32]] 1]]
   :limit-s 70}
  {:name "no-mob-comes-the-held-fight-declines-after-hold-s"
   :act [[:summon "zombie" [16.5 0 22.5] "{NoAI:1b,equipment:{head:{id:\"minecraft:iron_helmet\",count:1}}}"]
         [:until-seen {:entity "zombie"} 10]
         [:job (jobs.combat.attack {:targets :hostiles :radius 8 :hold true})]]
   :expect [{:no-event {:source :job :kind :stopped} :for-s 12 :of-job true}
            {:event {:source :job :kind :stopped :data {:kind :nothing-possible}} :within-s 30 :of-job true}]
   :after [[:entities "type=zombie,tag=wt" [[0 0 0] [32 4 32]] 1]]
   :limit-s 45}]}
