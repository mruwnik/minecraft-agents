;; jobs.movement.go-to :unknown in the dark with torches CARRIED (the aid cases leave the off hand free): the dark-floor aid holds a torch in
;; the off hand to see deeper; the stack must come back to the inventory when the call ends (the fixture's :item check counts the
;; inventory, not the off hand), :torches must still see the torches it carries, and a torch left by a cut call is returned
;; at the next call. Same sealed ledge as go-to-torch-fetch.edn: corridor (x 11..13, feet y 3) over a low corridor (x 14..24, feet y -2: a 5-block drop, past what the body sees in the dark).
;; Should-succeed: carried torches light the drop (a shield in the off hand, one torch placed, 3 in the inventory, nothing fetched); without :torches the off-hand
;; torch is back (4 in the inventory); a cancelled call's off-hand torch is back after the next call.
;; Should-fail: a zone over the takeoff cells refuses the torch (none placed): the dark drop is refused, the call ends :unseen-floor-dark. The first case's result also carries :spent (card 99785eb0: the torch placed).
;; The :carried cases put a pickaxe in the main hand and a shield in the off hand: a torch in either hand lets the body see 7 blocks in the dark,
;; and a drop of 5 is then sometimes seen without a placed torch.
{:defaults
 {:tags [:movement :go-to :torch]
  :time :any
  :plot {:height 12 :light :dark}
  :blocks [[:fill [10 -3 14] [26 8 18] "stone"]
           [:fill [11 3 16] [13 4 16] "air"]
           [:fill [14 -2 16] [24 4 16] "air"]]
  :body {:at [11.5 3 16.5] :yaw 270 :settle-s 3 :effects [["resistance" 600 4]] :inventory [["stone_pickaxe" 1] ["torch" 4]]}
  :limit-s 120}
 :cases
 [{:name "carried-torch-lights-the-drop-without-fetching"
   :act [[:rcon "item replace entity $BODY weapon.offhand with shield"] [:rcon "clear $BODY minecraft:torch"] [:rcon "item replace entity $BODY weapon.mainhand with minecraft:stone_pickaxe"] [:rcon "give $BODY minecraft:torch 4"] [:wait-s 2]
         [:job (jobs.movement.go-to {:pos #at [24 -2 16] :range 1 :ways #{:walk :clear-seal} :unknown true :torches :carried :ignore-zones? true})]]
   :expect [{:event {:kind :walk.torch-placed} :within-s 100 :of-job true}
            {:event {:source :job :kind :completed :data {:arrived true :spent [:any]}} :within-s 110 :of-job true}
            {:no-event {:source :job :kind #{:completed :stopped} :data {:torches :none}} :for-s 110 :until {:source :job :kind #{:completed :stopped}}}
            {:no-event {:source :job :kind :go-to.off-hand-kept} :for-s 110 :until {:source :job :kind #{:completed :stopped}}}]
   :after [[:item "torch" 3] [:body-near [24.5 -2 16.5] 3]]}
  {:name "unknown-without-torches-returns-the-off-hand-torch"
   :act [[:job (jobs.movement.go-to {:pos #at [24 -2 16] :range 1 :ways #{:walk :clear-seal} :unknown true :ignore-zones? true})]]
   :expect [{:event {:source :job :kind :go-to.off-hand-torch} :within-s 100 :of-job true}
            {:event {:source :job :kind #{:completed :stopped}} :within-s 110 :of-job true}
            {:no-event {:kind :walk.torch-placed} :for-s 110 :until {:source :job :kind #{:completed :stopped}}}]
   :after [[:item "torch" 4]]}
  {:name "torch-left-by-a-cancelled-call-is-returned-at-the-next-call"
   ;; the first call is cancelled while it runs, once the torch is in the off hand: the await and the cancel fail the case if the call ended first
   :act [[:job (jobs.movement.go-to {:pos #at [24 -2 16] :range 1 :ways #{:walk :clear-seal} :unknown true :ignore-zones? true})]
         [:await {:source :job :kind :go-to.off-hand-torch} 100]
         [:http :cancel "$event-job" {:ok true}]
         [:await {:source :job :kind :cancelled} 10]
         [:job (jobs.movement.go-to {:pos #at [12 3 16] :range 1 :ways #{:walk :clear-seal}})]]
   :expect [{:event {:source :job :kind :cancelled} :within-s 120}
            {:event {:source :job :kind :completed :data {:arrived true}} :within-s 60 :of-job true}]
   :after [[:item "torch" 4]]}
  {:name "zone-over-the-takeoff-refuses-the-torch"
   ;; the feet and head cells of the corridor's end belong to another owner: no torch goes there
   :zones [{:name "takeoff" :min [12 3 16] :max [13 4 16] :owner "Other" :allow #{}}]
   :act [[:rcon "item replace entity $BODY weapon.offhand with shield"] [:rcon "clear $BODY minecraft:torch"] [:rcon "item replace entity $BODY weapon.mainhand with minecraft:stone_pickaxe"] [:rcon "give $BODY minecraft:torch 4"] [:wait-s 2]
         [:job (jobs.movement.go-to {:pos #at [24 -2 16] :range 1 :ways #{:walk :clear-seal} :unknown true :torches :carried})]]
   :expect [{:event {:source :job :kind :stopped :data {:why :unseen-floor-dark}} :within-s 100 :of-job true}
            {:no-event {:kind :walk.torch-placed} :for-s 100 :until {:source :job :kind #{:completed :stopped}}}]
   :after [[:not-block [13 4 16] "wall_torch"] [:not-block [12 4 16] "wall_torch"] [:item "torch" 4]]}]}
