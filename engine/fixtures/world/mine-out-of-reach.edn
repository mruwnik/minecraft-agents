;; jobs.gather.mine and stone it cannot walk to (card 83f5ea6c: a seen target the walk cannot reach is skipped,
;; no failure counted, so it never gives up after 3).
;; Dirt floor, so the only stone is the case's own; body with a stone pickaxe.
;; Case 1: four stones on 7-high bedrock pillars 3 off (inside :radius 10: a stone 8 up and 3 off is 8.1 from the body), no blocks carried: none is taken, mine ends got 0 reporting the ones it saw from where it stands as seen ore out of reach (:unreached), without giving up and without walking off exploring: the body ends within 4 blocks of its start.
{:defaults
 {:tags [:mine :jobs] :time :any
  :plot {:height 12 :floor "dirt"}
  :body {:inventory [["stone_pickaxe" 1]] :effects [["resistance" 600 4]]}
  :limit-s 150}
 :cases
 [{:name "seen-stone-on-pillars-skipped-never-gives-up"
   :blocks [[:fill [13 0 16] [13 6 16] "bedrock"] [:set [13 7 16] "stone"]
            [:fill [19 0 16] [19 6 16] "bedrock"] [:set [19 7 16] "stone"]
            [:fill [16 0 13] [16 6 13] "bedrock"] [:set [16 7 13] "stone"]
            [:fill [16 0 19] [16 6 19] "bedrock"] [:set [16 7 19] "stone"]]
   :body {:at [16.5 0 16.5]}
   :act [[:job (jobs.gather.mine {:torches false :block "stone" :count 3 :radius 10 :ways #{:seen}})]]
   :expect [{:event {:source :job :kind #{:completed :stopped} :data {:got 0 :text [:contains "seen ore out of reach"]}} :within-s 130 :of-job true}
            {:event {:source :job :kind #{:completed :stopped} :data {:unreached [:any]}} :within-s 130 :of-job true}]
   :after [[:block [13 7 16] "stone"] [:block [16 7 19] "stone"] [:body-near [16.5 0 16.5] 4]]}]}
