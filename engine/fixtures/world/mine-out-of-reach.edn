;; jobs.gather.mine and stone it cannot walk to (card 83f5ea6c: a seen target the walk cannot reach is skipped,
;; no failure counted, so it never gives up after 3) and its walk home out of a pit with no diggable wall
;; (card 16b6b93e: the first walk home has no :pillar, the second, :home-last, every way).
;; Dirt floor, so the only stone is the case's own; body with a stone pickaxe.
;; Case 1: four stones on 7-high bedrock pillars 3 off, no blocks carried: none is taken, mine ends got 0 reporting each one as seen ore out of reach (:unreached), without mine.gave-up.
;; Case 2: a 3x3 pit 3 deep, obsidian walls, stone floor; the body starts 4 off its rim, drops in, mines 2, pillars home.
{:defaults
 {:tags [:mine :jobs] :time :any
  :plot {:height 12 :floor "dirt"}
  :body {:inventory [["stone_pickaxe" 1]] :effects [["resistance" 600 4]]}
  :limit-s 150}
 :cases
 [{:name "seen-stone-on-pillars-skipped-never-gives-up"
   :blocks [[:fill [13 0 16] [13 6 16] "bedrock"] [:set [13 7 16] "stone"]
            [:fill [19 0 16] [19 6 16] "bedrock"] [:set [19 7 16] "stone"]
            [:fill [16 0 13] [16 6 13] "bedrock"] [:set [16 7 13] "stone"]
            [:fill [16 0 19] [16 6 19] "bedrock"] [:set [16 7 19] "stone"]]
   :body {:at [16.5 0 16.5]}
   :act [[:job (jobs.gather.mine {:block "stone" :count 3 :radius 8 :tunnel-length 0 :descend-limit 0})]]
   :expect [{:event {:source :job :kind #{:completed :stopped} :data {:got 0 :text [:contains "seen ore out of reach"]}} :within-s 130 :of-job true}
            {:event {:source :job :kind #{:completed :stopped} :data {:unreached [:has #at [13 7 16]]}} :within-s 130 :of-job true}
            {:event {:source :job :kind #{:completed :stopped} :data {:unreached [:has #at [19 7 16]]}} :within-s 130 :of-job true}
            {:event {:source :job :kind #{:completed :stopped} :data {:unreached [:has #at [16 7 13]]}} :within-s 130 :of-job true}
            {:event {:source :job :kind #{:completed :stopped} :data {:unreached [:has #at [16 7 19]]}} :within-s 130 :of-job true}
            {:no-event {:source :job :kind :mine.gave-up} :for-s 130 :until {:source :job :kind #{:completed :stopped}}}]
   :after [[:block [13 7 16] "stone"] [:block [16 7 19] "stone"]]}
  {:name "pit-with-obsidian-walls-pillars-home"
   :blocks [[:fill [14 -5 14] [18 -1 18] "obsidian"] [:fill [15 -3 15] [17 -1 17] "air"] [:fill [15 -4 15] [17 -4 17] "stone"]]
   :body {:at [16.5 0 12.5] :inventory [["stone_pickaxe" 1] ["dirt" 8]]}
   :act [[:job (jobs.gather.mine {:block "stone" :count 2 :radius 10 :tunnel-length 0 :descend-limit 0})]]
   :expect [{:event {:source :job :kind :child_started :data {:slot :home-last}} :within-s 130 :of-job true}
            {:event {:source :job :kind #{:completed :stopped} :data {:got [:>= 2]}} :within-s 140 :of-job true}
            {:no-event {:source :job :kind :mine.not-home} :for-s 140 :until {:source :job :kind #{:completed :stopped}}}]
   :after [[:body-near [16.5 0 12.5] 2]]}]}
