;; Card 417e96f3: recover-drops ranks above flee and backs off from a guard it cannot afford, coming back before the despawn.
;; The body dies at [26 0 26], respawns at [4 0 4]; a zombie with AI (helmet, kept) guards the pile and chases the body,
;; priced far dearer than the pile (:danger-overrides). The trip backs off (decided :skip :retry, hold-s at most the 150 s danger memory),
;; hostile-near takes the body away, the zombie is killed, and the died trigger brings the body back for the pile.
{:defaults
 {:tags [:survival :death :jobs :hostile]
  :register [{:trigger :died :job (jobs.survival.recover-drops {:danger-overrides {"zombie" 1000}})}
             {:trigger :hostile-near :args {:radius 8 :ranged-radius 16}
              :job (jobs.survival.respond-to-hostile)}]
  :body {:at [26.5 0 26.5] :spawnpoint [4 0 4] :effects [["resistance" 600 4]]
         :inventory [["raw_iron" 24] ["cobblestone" 64] ["cobblestone" 36]]}
  :mobs :keep
  :limit-s 280}
 :cases
 [{:name "chased-from-the-pile-backs-off-and-returns-before-despawn"
   :act [[:wait-s 1]
         [:kill-body]
         [:await {:source :body :kind :respawned} 30]
         [:summon "zombie" [24.5 0 24.5] "{PersistenceRequired:1b,equipment:{head:{id:\"minecraft:iron_helmet\",count:1}}}"]
         [:await {:source :job :kind :recover-drops.decided :data {:decision :skip :retry true}} 60]
         [:await {:source :reflex :kind :fired :context {:reflex-id :hostile-near}} 60]
         [:wait-s 3]
         [:rcon "kill @e[type=zombie,tag=wt,$BOX]"]]
   :expect [{:event {:source :job :kind :recover-drops.decided :data {:decision :skip :retry true :hold-s [:<= 150]}} :within-s 60}
            {:event {:source :reflex :kind :fired :context {:reflex-id :hostile-near}} :within-s 90}
            {:event {:source :job :kind :recover-drops.decided :data {:decision :collected}} :within-s 270}]
   :after [[:item "raw_iron" 24]]}]}
