;; Bug (Leo): clear-cells walked into a flooded kill room to reach a cell whose only stand to see it was across the water.
;; Should-fail: a stone cell in the far wall of a room flooded to the ceiling, the tunnel to it dry: the call ends nothing-possible and the body never enters the water.
{:defaults
 {:tags [:build :dig :water]
  :time :any
  :plot {:height 8 :floor "grass_block"}
  :blocks [[:fill [4 0 0] [16 5 20] "stone"] [:fill [10 0 2] [10 1 7] "air"] [:fill [7 0 8] [13 3 14] "water"]]
  :body {:at [10.5 0 3.5] :inventory [["iron_pickaxe" 2]] :effects [["resistance" 900 4]]}
  :limit-s 120}
 :cases
 [{:name "cell-across-a-flooded-room-is-not-swum-to"
   :act [[:job (jobs.blocks.clear-cells {:area {:cells [#at [10 1 15]]} :ignore-zones? true :through false})]]
   :expect [{:event {:source :job :kind :stopped :data {:kind :nothing-possible}} :within-s 90 :of-job true}]
   :after [[:block [10 1 15] "stone"] [:body-near [10.5 0 3.5] 4.5]]}]}
