;; Card 0b9191bc: the mine's walk to a seen target carries the worth of the target's whole touching vein (go-to's :worth), so go-to's dig route
;; prices a wall as the mine's cut does. Iron-bars wall spans the plot (seen through): two thick (x 20..21) in the first two cases, five thick (x 8..12, body at [4.5 0 16.5]) in the sand pair, where one sand is declined and three are dug to.
{:defaults
 {:tags [:mine :jobs] :time :any
  :plot {:light :lit :height 12 :floor "dirt"}
  :body {:at [16.5 0 16.5] :yaw 270 :inventory [["stone_pickaxe" 1]] :effects [["resistance" 600 4]]}
  :blocks [[:fill [20 0 0] [21 12 31] "iron_bars"]]
  :limit-s 200}
 :cases
 [{:name "clay-vein-of-eight-behind-a-two-thick-wall-is-dug-to"
   :blocks [[:fill [24 0 15] [25 1 16] "clay"]]
   :act [[:job (jobs.gather.mine {:torches false :block "clay" :item "clay_ball" :count 1 :radius 12 :ways #{:seen}})]]
   :expect [{:event {:source :job :kind #{:completed :stopped} :data {:got 4}} :within-s 120 :of-job true}]
   :after [[:item "clay_ball" 4] [:not-block [24 0 16] "clay"]]}
  {:name "vein-of-three-sand-behind-a-two-thick-wall-is-dug-to"
   :blocks [[:fill [24 0 16] [26 0 16] "sand"]]
   :act [[:job (jobs.gather.mine {:torches false :block "sand" :count 1 :radius 12 :ways #{:seen}})]]
   :expect [{:event {:source :job :kind #{:completed :stopped} :data {:got 1}} :within-s 120 :of-job true}]
   :after [[:item "sand" 1]]}
  {:name "one-sand-behind-a-five-thick-wall-is-not-worth-the-dig"
   :body {:at [4.5 0 16.5]}
   :blocks [[:fill [8 0 0] [12 12 31] "iron_bars"] [:set [15 0 16] "sand"]]
   :act [[:job (jobs.gather.mine {:torches false :block "sand" :count 1 :radius 24 :ways #{:seen}})]]
   :expect [{:event {:source :job :kind #{:completed :stopped :failed}} :within-s 120 :of-job true}]
   :after [[:item "sand" 0] [:block [8 0 16] "iron_bars"]]}
  {:name "three-sand-behind-the-same-five-thick-wall-are-dug-to"
   :body {:at [4.5 0 16.5]}
   :blocks [[:fill [8 0 0] [12 12 31] "iron_bars"] [:fill [15 0 16] [17 0 16] "sand"]]
   :act [[:job (jobs.gather.mine {:torches false :block "sand" :count 1 :radius 24 :ways #{:seen}})]]
   :expect [{:event {:source :job :kind #{:completed :stopped} :data {:got 1}} :within-s 150 :of-job true}]
   :after [[:item "sand" 1]]}]}
