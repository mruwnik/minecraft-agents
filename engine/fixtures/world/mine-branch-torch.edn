;; Card 152e1d95, 9eed907e (mine branch torches): a dig off the tunnel line hangs a torch of its own only where its cell is dark and no
;; hung torch lights it (jobs.lib.torch-plan); ore within reach from the line gets none. A dark branch is in mine-dark-branch-torch.edn; the hall here is lit.
;; Stone mass x 2..30, z 8..30, y 0..6. The branch dig is only owed once the tunnel exists, so the far ore is out of sight until the tunnel breaks into its lit hall. Torches are carried (8). Not ported: ore straight above the line booking mine.torch-left-out :no-site
;; (needs a vertical shaft the body must pillar up).
;; Should-succeed: ore (a 3x2 face) at the end of a lit 13-long hall that the tunnel (east from x 4) breaks into at x 10 is seen only then, and dug 14 off the dug line: the tunnel's torches are placed, none left out (the hall is lit, so it owes none of its own).
;; Should-fail: ore 3 off the line places no torch.
{:defaults
 {:tags [:mine :torch :jobs] :time :any
  :plot {:light :dark :height 12}
  :blocks [[:fill [2 0 8] [30 6 30] "stone"] [:fill [16 0 16] [16 1 16] "air"]]
  :body {:at [16.5 0 16.5] :yaw 0 :inventory [["stone_pickaxe" 1] ["cobblestone" 16] ["torch" 8]] :effects [["resistance" 600 4]]}
  :limit-s 160}
 :cases
 [{:name "ore-far-off-the-line-in-a-lit-hall-is-dug"
   :blocks [[:fill [4 0 16] [4 1 16] "air"] [:fill [10 0 16] [22 1 16] "air"] [:fill [23 0 15] [23 1 17] "iron_ore"]
            [:set [12 1 15] "wall_torch[facing=south]"] [:set [16 1 15] "wall_torch[facing=south]"] [:set [20 1 15] "wall_torch[facing=south]"]]
   :body {:at [4.5 0 16.5] :yaw 0 :inventory [["stone_pickaxe" 1] ["cobblestone" 16] ["torch" 8]] :effects [["resistance" 600 4]]}
   :act [[:job (jobs.gather.mine {:block "iron_ore" :level false :count 1 :direction :east :tunnel-length 8 :radius 16 :mend false})]]
   :expect [{:event {:source :job :kind #{:completed :stopped} :data {:got #{1 2}}} :within-s 150 :of-job true}
            {:event {:source :action :kind :done :data {:name "place" :status "placed"}} :within-s 150}
            {:no-event {:source :job :kind :mine.torch-left-out} :for-s 150 :until {:source :job :kind #{:completed :stopped}}}]
   :after [[:item "raw_iron" [:>= 1]]]}
  ;; card fd547d80: ore filling the end of a lit 1x2 corridor, 13 cells down, is seen from the line and mined (a single block is seen in
  ;; only ~90% of passes, pinned in corridor-look-test; the 1x2 end cap fills the corridor, so it is hit far more reliably)
  {:name "lone-ore-down-a-lit-corridor-is-found"
   :blocks [[:fill [16 0 17] [16 1 28] "air"] [:fill [16 0 29] [16 1 29] "iron_ore"]
            [:set [15 1 19] "wall_torch[facing=east]"] [:set [15 1 23] "wall_torch[facing=east]"] [:set [15 1 27] "wall_torch[facing=east]"]]
   :act [[:job (jobs.gather.mine {:block "iron_ore" :level false :count 1 :direction :east :tunnel-length 8 :radius 16 :mend false})]]
   :expect [{:event {:source :job :kind #{:completed :stopped} :data {:got #{1 2}}} :within-s 150 :of-job true}]
   :after [[:item "raw_iron" [:>= 1]]]}
  {:name "ore-three-off-the-line-gets-no-torch"
   :blocks [[:fill [16 0 17] [16 1 19] "air"] [:set [16 0 20] "iron_ore"]]
   :act [[:job (jobs.gather.mine {:block "iron_ore" :level false :count 1 :direction :east :tunnel-length 8 :radius 16 :mend false})]]
   :expect [{:event {:source :job :kind #{:completed :stopped} :data {:got 1}} :within-s 100 :of-job true}
            {:no-event {:source :action :kind :started :data {:name "place"}} :for-s 100 :until {:source :job :kind #{:completed :stopped}}}]
   :after [[:item "raw_iron" 1] [:not-block [16 0 20] "iron_ore"]]}]}
