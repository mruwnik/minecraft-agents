;; Card 5f4a3ba0: a body shut in a cave under 8 blocks of rock, empty-handed, with a tree on the surface 12 blocks off. Its first
;; search finds nothing (no sight through rock), so obtain walks to a wall and cuts a stair up (by hand) to the sky, then finds the tree.
;; Tree at x 28, z 16: five logs under a leaf crown. Stone x 0..31, z 0..31, y 0..9 (surface y 10); a 7x2x7 hollow round the body at feet y 0.
;; Untimed: day, because the tree is seen on the surface and the body waits out a dark one.
;; Should-succeed: oak logs carried. Should-fail: none (the dig must not stop :no-source or :no-way-up).
{:defaults
 {:tags [:obtain :explore :mining :no-tool]
  :plot {:height 16 :light :sky}
  :blocks [[:fill [0 0 0] [31 9 31] "stone"] [:fill [13 0 13] [19 1 19] "air"]
           [:fill [27 13 15] [29 15 17] "oak_leaves[persistent=true]"]
           [:fill [28 10 16] [28 14 16] "oak_log"]]
  :body {:at [16.5 0 16.5] :settle-s 2 :effects [["resistance" 600 4]]}
  :limit-s 1000}
 :cases
 [{:name "sealed-cave-stairs-up-then-fells-the-tree"
   :act [[:job (jobs.items.obtain {:item "oak_log" :count 2 :explore true})]]
   :expect [{:event {:source :job :kind :completed} :within-s 950 :of-job true}
            {:no-event {:source :job :kind :stopped :data {:reason :no-source}} :for-s 900 :until {:source :job :kind :completed}}]
   :after [[:item "oak_log" [:>= 2]]]}
  {:name "sealed-cave-stairs-up-with-a-worn-last-pickaxe"
   :tags [:obtain :explore :mining]
   :act [[:rcon "item replace entity $BODY container.0 with minecraft:stone_pickaxe[minecraft:damage=128]"]
         [:job (jobs.items.obtain {:item "oak_log" :count 2 :explore true})]]
   :expect [{:event {:source :job :kind :completed} :within-s 950 :of-job true}
            {:no-event {:source :job :kind :stopped :data {:reason :no-source}} :for-s 900 :until {:source :job :kind :completed}}]
   :after [[:item "oak_log" [:>= 2]]]}]}
