;; Card 073b8e9f: a body at or under :hide-health in a ranged mob's line of fire takes cover where it stands within a few seconds
;; (no long stand 'searching'); a healthy body in the same line walks away and is not sealed in. A NoAI witch (never throws) 6 east
;; of the body on open flat ground, cobblestone carried; damage 60 under Resistance IV (80% off) leaves the low body at 8 hp; Resistance V would make it immune.
{:defaults
 {:tags [:hostile :survival :cornered]
  :time :any
  :mobs :keep
  :body {:at [16.5 0 16.5] :inventory [["cobblestone" 20]] :effects [["resistance" 600 3]]}
  :act [[:summon "witch" [22.5 0 16.5] "{NoAI:1b,equipment:{head:{id:\"minecraft:iron_helmet\",count:1}}}"]]
  :limit-s 60}
 :cases
 [{:name "low-body-in-a-witchs-line-seals-in-at-once"
   :plot {:light :sky}
   :act [[:rcon "damage $BODY 60 minecraft:generic"]
         [:job (jobs.survival.retreat {})]]
   :expect [{:event {:source :job :kind :retreat_sealed} :within-s 12}]
   :after [[:body-near [16.5 0 16.5] 3]]}
  {:name "healthy-body-in-a-witchs-line-walks-away-unsealed"
   :act [[:job (jobs.survival.retreat {})]]
   :expect [{:event {:source :job :kind :completed} :within-s 40 :of-job true}
            {:no-event {:source :job :kind :retreat_sealed} :for-s 40 :until {:source :job :kind :completed}}]
   :after [[:body-far [16.5 0 16.5] 3]]}]}
