;; jobs.blocks.dig and jobs.blocks.place (card 3e96747a, hand-tested in 7cac937b): an idle body, jobs submitted.
{:defaults
 {:tags [:blocks :jobs]
  :body {:at [16.5 0 16.5]}}
 :cases
 [{:name "dig-near-collects"
   :blocks [[:set [18 0 16] "stone"]]
   :body {:inventory [["iron_pickaxe" 1]]}
   :act [[:job (jobs.blocks.dig {:pos #at [18 0 16]})]]
   :expect [{:event {:source :job :kind :completed :data {:reason :dug}} :within-s 60 :of-job true}]
   :after [[:block [18 0 16] "air"] [:item "cobblestone" [:>= 1]]]}
  {:name "dig-says-what-the-cell-holds-after"
   ;; card b60c2e2d: a dug block's result names what the cell now holds (read after the post-dig look)
   :blocks [[:set [18 0 16] "stone"]]
   :body {:inventory [["iron_pickaxe" 1]]}
   :act [[:job (jobs.blocks.dig {:pos #at [18 0 16]})]]
   :expect [{:event {:source :job :kind :completed :data {:reason :dug :now "air" :text [:contains "the cell is now clear"]}} :within-s 60 :of-job true}]
   :after [[:block [18 0 16] "air"]]}
  {:name "dig-far-walks-and-collects"
   :blocks [[:set [26 0 16] "stone"]]
   :body {:inventory [["iron_pickaxe" 1]]}
   :act [[:job (jobs.blocks.dig {:pos #at [26 0 16]})]]
   :expect [{:event {:source :job :kind :completed :data {:reason :dug}} :within-s 90 :of-job true}]
   :after [[:block [26 0 16] "air"] [:item "cobblestone" [:>= 1]]]}
  {:name "dig-without-pickaxe-waits"
   :blocks [[:set [18 0 16] "stone"]]
   :act [[:rcon "execute as $BODY at @s run tp @s ~ ~ ~ -90 0"] [:until-seen {:block "stone"} 10] [:job (jobs.blocks.dig {:pos #at [18 0 16]})]]
   :expect [{:event {:source :job :kind :stopped :data {:reason :no-tool}} :within-s 20 :of-job true}
            {:no-event {:source :job :kind #{:completed :stopped} :data {:dug [:any]}} :for-s 20}]
   :after [[:block [18 0 16] "stone"]]}
  {:name "place-cobblestone"
   :body {:inventory [["cobblestone" 4]]}
   :act [[:job (jobs.blocks.place {:pos #at [18 0 18] :item "cobblestone"})]]
   :expect [{:event {:source :job :kind #{:completed :stopped} :data {:placed [:any]}} :within-s 60 :of-job true}]
   :after [[:block [18 0 18] "cobblestone"] [:item "cobblestone" 3]]}
  {:name "dig-stone-by-hand-when-the-drop-is-not-needed"
   ;; card 21f32f58: :need-drop false digs a block no carried tool harvests (slow, the drop is lost)
   :blocks [[:set [18 0 16] "stone"]]
   :act [[:job (jobs.blocks.dig {:pos #at [18 0 16] :need-drop false})]]
   :expect [{:event {:source :job :kind :completed :data {:reason :dug}} :within-s 60 :of-job true}]
   :after [[:block [18 0 16] "air"] [:item "cobblestone" 0]]
   :limit-s 90}
  {:name "dig-iron-ore-with-a-wooden-pickaxe-waits-for-the-drop"
   :blocks [[:set [18 0 16] "iron_ore"]]
   :body {:inventory [["wooden_pickaxe" 1]]}
   :act [[:rcon "execute as $BODY at @s run tp @s ~ ~ ~ -90 0"] [:until-seen {:block "iron_ore"} 10] [:job (jobs.blocks.dig {:pos #at [18 0 16]})]]
   :expect [{:event {:source :job :kind :stopped :data {:reason :no-tool}} :within-s 20 :of-job true}
            {:no-event {:source :job :kind #{:completed :stopped} :data {:dug [:any]}} :for-s 20}]
   :after [[:block [18 0 16] "iron_ore"]]}]}
