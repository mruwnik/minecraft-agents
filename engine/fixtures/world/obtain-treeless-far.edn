;; The only tree stands 40 blocks east, seen from the start. obtain oak_log with :explore walks to it and fells it as far as the walk
;; is worth (the caller's :worth).
;; Plot 220 x 64, open sky over a glowstone floor (lit at any hour); body at the west end, tree at x 40 z 32.
;; Should-succeed: with a :worth that pays for the walk the log is got; a kit (iron pickaxe, no stone in sight) prices
;; the walk to its pickaxe's logs at the kit's worth, so the tree is felled and the wooden pickaxe for the stone is next. Should-fail: a caller who wants a log for 6 s buys a tree beside the body (priced under 3 s) but not the walk of 40 blocks (12.75 s in the unit scene, margin 6.75 s), so obtain waits :not-worth and does not walk; the near-tree case is the control.
{:defaults
 {:tags [:items :obtain :explore :large :jobs]
  :time :any
  :plot {:height 12 :length 220 :width 64 :floor "glowstone" :light :sky}
  :body {:at [1.5 0 32.5] :yaw 270 :settle-s 2 :inventory [["iron_axe" 1]] :effects [["resistance" 600 4]]}
  :blocks [[:fill [40 0 32] [40 4 32] "oak_log"] [:fill [39 4 31] [41 6 33] "oak_leaves[persistent=true]"]]
  :limit-s 600}
 :cases
 [{:name "dear-tree-far-off-is-found-by-walking-on"
   :act [[:job (jobs.items.obtain {:item "oak_log" :count 1 :ways #{:gather} :explore true :worth 500})]]
   :expect [{:event {:source :job :kind :completed} :within-s 580 :of-job true}]
   :after [[:item "oak_log" 4]]}
  {:name "cheap-tree-far-off-is-not-searched-for"
   :act [[:job (jobs.items.obtain {:worth 6 :item "oak_log" :count 1 :ways #{:gather} :explore true})]]
   :expect [{:event {:source :job :kind :waiting :data {:reason :not-worth}} :within-s 60 :of-job true}
            {:no-event {:source :job :kind #{:completed :stopped}} :of-job true :for-s 30 :until {:source :job :kind :waiting :data {:reason :not-worth}}}]
   :after [[:item "oak_log" 0]]}
  {:name "cheap-tree-beside-the-body-is-felled-at-the-same-worth"
   :blocks [[:fill [5 0 32] [5 4 32] "oak_log"] [:fill [4 4 31] [6 6 33] "oak_leaves[persistent=true]"]]
   :act [[:job (jobs.items.obtain {:worth 6 :item "oak_log" :count 1 :ways #{:gather} :explore true})]]
   :expect [{:event {:source :job :kind :completed} :within-s 120 :of-job true}]
   :after [[:item "oak_log" [:>= 1]]]}
  {:name "kit-with-no-tree-in-sight-walks-to-the-far-tree"
   :body {:inventory [["iron_axe" 1] ["stone_sword" 1]]}
   :act [[:job (jobs.items.get-kit {:worth 1200 :items ["iron_pickaxe"] :food false :wear false})]]
   :expect [{:no-event {:source :job :kind :stopped} :for-s 300 :until {:source :job :kind :obtain.pickaxe :data {:item "cobblestone"}}}
            {:event {:source :job :kind :obtain.pickaxe :data {:item "cobblestone"}} :within-s 320}]
   :after [[:block [40 0 32] "air"]]}]}
