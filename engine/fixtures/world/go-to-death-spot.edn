;; Card 3c3c0523: go-to's plan keeps away from where a mob killed the body lately and the body has not looked since (jobs.lib.threats/death-dangers).
;; Roofed stone block, rooms at x 1..3 and x 27..29 (z 19..21); a direct corridor along z 20 (24 long) with a side alcove at x 15 z 25..27 where
;; the death is remembered (out of the corridor's line of sight, 6 blocks off the corridor), and a detour along z 8 (about 50 long, 18 blocks off the alcove).
;; The quote reports the planned route's :length and walks nowhere: with no death the direct corridor, with the zombie death 60 s old the detour.
{:defaults
 {:tags [:movement :planner :death]
  :time :any
  :plot {:light :lit :height 8}
  :blocks [[:fill [0 0 0] [31 2 31] "stone"]
           [:fill [1 0 19] [3 1 21] "air"] [:fill [27 0 19] [29 1 21] "air"]
           [:fill [4 0 20] [26 1 20] "air"]
           [:fill [15 0 21] [15 1 26] "air"] [:fill [14 0 25] [16 1 27] "air"]
           [:fill [2 0 8] [2 1 18] "air"] [:fill [2 0 8] [28 1 8] "air"] [:fill [28 0 8] [28 1 18] "air"]]
  :body {:at [2.5 0 20.5] :yaw 270 :settle-s 4}
  :limit-s 40}
 :cases
 [{:name "no-death-takes-the-direct-corridor"
   :act [[:until [:cli "quote" ["$body" "--world" "$world" "jobs.movement.go-to" {:pos #at [28 0 20] :range 1}] {:ok true :quote {:route {:found true :length [:< 30]}}}] 30]]
   :after [[:body-near [2.5 0 20.5] 2]]}
  {:name "recent-unseen-zombie-death-takes-the-detour"
   :memory [{:kind :deaths :age-s 60 :data {:pos #xyz [15.5 0 26.5] :cause "zombie"}}]
   :act [[:until [:cli "quote" ["$body" "--world" "$world" "jobs.movement.go-to" {:pos #at [28 0 20] :range 1}] {:ok true :quote {:route {:found true :length [:> 40]}}}] 30]]
   :after [[:body-near [2.5 0 20.5] 2]]}]}
