;; Card cf39523d: survival.get-food never hunts a kind in the ::off-limits setting, wherever it
;; stands and however many there are. Three cows in the open are a surplus by the keep-2 rule alone. Hunger is drained by RCON
;; (food 9-10), hp 15; no food carried, only a sword.
;; Should-succeed: with only sheep off limits one of the three cows is killed (food.killed :rule :surplus), two stay.
;; Should-fail: with cows off limits none is killed (the :no-food ending), all three stay.
{:defaults
 {:tags [:survival :get-food :animals]
  :plot {:height 6}
  :body {:at [4.5 0 16.5] :inventory [["iron_sword" 1]] :settle-s 2}
  :act [[:rcon "effect give $BODY minecraft:hunger 5 243 true"] [:until-effect-gone "hunger" 30]
        [:rcon "damage $BODY 5 minecraft:generic"]
        [:summon "cow" [24.5 0 24.5] "{NoAI:1b}"] [:summon "cow" [25.5 0 24.5] "{NoAI:1b}"] [:summon "cow" [24.5 0 25.5] "{NoAI:1b}"]]
  :limit-s 100}
 :cases
 [{:name "other-kind-off-limits-leaves-the-cow-surplus-huntable"
   :act [[:job (jobs.survival.get-food {:settings {:jobs.lib.animal-spare/off-limits #{"sheep"}}})]]
   :expect [{:event {:source :job :kind :food.killed :data {:rule :surplus}} :within-s 90}]
   :after [[:entities "type=cow,tag=wt" [[0 0 0] [31 3 31]] 2]]}
  {:name "cows-off-limits-are-never-hunted"
   :act [[:job (jobs.survival.get-food {:settings {:jobs.lib.animal-spare/off-limits #{"cow"}}})]]
   :expect [{:event {:source :job :kind :stopped :data {:reason :no-food}} :within-s 90}
            {:no-event {:source :job :kind :food.killed} :for-s 90 :until {:source :job :kind :stopped :data {:reason :no-food}}}]
   :after [[:entities "type=cow,tag=wt" [[0 0 0] [31 3 31]] 3]]}]}
