;; Card 851d797e (Brindle S9): afloat, a zombie only heard was priced as never hit (hostile-fight/heard-afloat?), then fled from at the
;; health its blows left: fight 4385 s vs flee 262 for one zombie, full iron and an iron sword at 20 hp. A land mob heard comes into
;; sight and is fought; only a drowned keeps under the surface. Stone mass x 2..20, z 8..22, y 0..5; a dark pool x 5..7, z 15..17,
;; water y 0..2 (the body floats in it, deep water under it); a dark corridor 1x2 at y 3 runs east from the pool to x 11, then north to
;; z 11: the mob stands round the corner (heard, not seen). Mobs NoAI, helmeted. Should-succeed: the zombie is answered with a fight.
;; Should-fail: the drowned, priced as never hit, is fled from.
{:defaults
 {:tags [:hostile :survival :water]
  :time :any
  :mobs :keep
  :register [{:trigger :hostile-near}]
  :blocks [[:fill [2 0 8] [20 5 22] "stone"]
           [:fill [5 0 15] [7 2 17] "water"]
           [:fill [5 3 15] [7 4 17] "air"]
           [:fill [8 3 16] [11 4 16] "air"]
           [:fill [11 3 11] [11 4 15] "air"]]
  :body {:at [6.5 1 16.5] :inventory [["iron_sword" 1]]}
  :limit-s 40}
 :cases
 [{:name "afloat-armed-body-fights-a-heard-zombie"
   :act [[:rcon "item replace entity $BODY armor.head with minecraft:iron_helmet"]
         [:rcon "item replace entity $BODY armor.chest with minecraft:iron_chestplate"]
         [:rcon "item replace entity $BODY armor.legs with minecraft:iron_leggings"]
         [:rcon "item replace entity $BODY armor.feet with minecraft:iron_boots"]
         [:summon "zombie" [11.5 3 12.5] "{NoAI:1b,equipment:{head:{id:\"minecraft:iron_helmet\",count:1}}}"]]
   :expect [{:event {:source :job :kind :hostile.decided :data {:mob "zombie" :decision :fight}} :within-s 30}]}
  {:name "afloat-armed-body-flees-a-heard-drowned"
   :act [[:rcon "item replace entity $BODY armor.head with minecraft:iron_helmet"]
         [:rcon "item replace entity $BODY armor.chest with minecraft:iron_chestplate"]
         [:rcon "item replace entity $BODY armor.legs with minecraft:iron_leggings"]
         [:rcon "item replace entity $BODY armor.feet with minecraft:iron_boots"]
         [:summon "drowned" [6.5 0 15.5] "{NoAI:1b,equipment:{head:{id:\"minecraft:iron_helmet\",count:1}}}"]]
   :expect [{:event {:source :job :kind :hostile.decided :data {:mob "drowned" :decision :flee}} :within-s 30}]}]}
