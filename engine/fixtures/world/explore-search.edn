;; Card 7ef2db8f: jobs.explore.search reads at most 48 stand cells per step (no runaway read loop) and keeps its sweep going: legs are
;; walked one after another until the target comes into the small scan radius. Long grass plot 64 x 32, body at the west end
;; [8.5 0 16.5], an emerald block 32 east at [40 0 16], :scan-radius 8 so no look sees it from the origin; legs run :outward east.
;; Should-succeed: spacing 8 and the tightest spacing 4 both end search.done :found within the limit, no error and no :runaway.
;; (A ::spacing below 4 is refused: unit-covered.)
{:defaults
 {:tags [:explore :search]
  :plot {:height 8 :floor "grass_block" :length 64 :width 32}
  :blocks [[:set [40 0 16] "emerald_block"]]
  :body {:at [8.5 0 16.5] :settle-s 2 :effects [["resistance" 600 4]]}
  :limit-s 150}
 :cases
 [{:name "legs-walked-until-the-target-is-in-scan-range"
   :act [[:job (jobs.explore.search {:target "emerald_block" :pattern :outward :heading :east :scan-radius 8
                                     :use-notes false :max-distance 60 :settings {:jobs.explore.search/spacing 8 :jobs.explore.search/max-legs 16} :spend {:job-time 130}})]]
   :expect [{:event {:source :job :kind :completed :data {:reason :found}} :within-s 140 :of-job true}
            {:no-event {:source :job :kind :stopped} :for-s 140 :of-job true :until {:source :job :kind :completed}}
            {:no-event {:source :system :kind :error} :for-s 60 :until {:source :job :kind :completed}}]}
  {:name "tightest-spacing-still-ends-found"
   :act [[:job (jobs.explore.search {:target "emerald_block" :pattern :outward :heading :east :scan-radius 8
                                     :use-notes false :max-distance 60 :settings {:jobs.explore.search/spacing 4 :jobs.explore.search/max-legs 24} :spend {:job-time 130}})]]
   :expect [{:event {:source :job :kind :completed :data {:reason :found}} :within-s 140 :of-job true}
            {:no-event {:source :job :kind :stopped} :for-s 140 :of-job true :until {:source :job :kind :completed}}
            {:no-event {:source :system :kind :error} :for-s 60 :until {:source :job :kind :completed}}]}
  ;; cards 3bd5a3eb (192108e0): a body on a leaf canopy 21 above the ground, no target anywhere: a leg whose step toward an unseen column
  ;; cannot be walked drops that column and costs a leg, so the search ends in a bounded number of rounds, never spinning to its time bound
  {:name "canopy-search-with-no-target-ends-instead-of-spinning"
   :plot {:height 31}
   :blocks [[:fill [4 20 4] [28 21 28] "oak_leaves[persistent=true]"]]
   :body {:at [16.5 22 16.5]}
   :act [[:job (jobs.explore.search {:target "emerald_block" :pattern :outward :heading :east :scan-radius 8
                                     :use-notes false :max-distance 24 :settings {:jobs.explore.search/spacing 8 :jobs.explore.search/max-legs 12} :spend {:job-time 130}})]]
   :expect [{:event {:source :job :kind #{:completed :stopped}} :within-s 100 :of-job true}
            {:no-event {:source :job :kind :limit_reached} :for-s 100 :of-job true :until {:source :job :kind #{:completed :stopped}}}
            {:no-event {:source :system :kind :error} :for-s 60}]
   :limit-s 120}
  ;; card ad1a4e62: a target beyond :scan-radius (and :max-distance) is not found, and the ending says how far each look reached,
  ;; so "not found" is not read as "blocks in view were ignored". Emerald 30 east of the body, scan 8, distance bound 10.
  {:name "not-found-text-names-the-look-radius"
   :blocks [[:set [38 0 16] "emerald_block"]]
   :act [[:job (jobs.explore.search {:target "emerald_block" :pattern :outward :heading :east :scan-radius 8
                                     :use-notes false :max-distance 10 :settings {:jobs.explore.search/spacing 8 :jobs.explore.search/max-legs 2} :spend {:job-time 60}})]]
   :expect [{:event {:source :job :kind :stopped :data {:text [:contains "looks of 8 blocks round"]}} :within-s 70 :of-job true}
            {:no-event {:source :job :kind :completed} :for-s 70 :of-job true :until {:source :job :kind :stopped}}]
   :limit-s 80}
  ;; card d5729c6e: an emerald the body saw 20 blocks east (beyond :scan-radius 8, inside :max-distance 30) is found from memory,
  ;; one allowed leg unused: the old search walked its 8-block leg, saw nothing in range and stopped.
  {:name "seen-target-beyond-the-scan-radius-is-found"
   :blocks [[:set [28 0 16] "emerald_block"]]
   :body {:yaw 270}
   :act [[:until-seen {:block "emerald_block"} 15]
         [:job (jobs.explore.search {:target "emerald_block" :pattern :outward :heading :east :scan-radius 8
                                     :use-notes false :max-distance 30 :settings {:jobs.explore.search/spacing 8 :jobs.explore.search/max-legs 1} :spend {:job-time 60}})]]
   :expect [{:event {:source :job :kind :completed :data {:reason :found}} :within-s 70 :of-job true}
            {:no-event {:source :job :kind :stopped} :for-s 70 :of-job true :until {:source :job :kind :completed}}]
   :limit-s 90}
  ;; card bfe3cf4d: :heading accepts the diagonals. Body at [8.5 0 8.5], emerald 16 south-east on both axes, outward legs run :south-east;
  ;; the old search refused the heading at submit and never ended :found.
  {:name "diagonal-heading-south-east-finds-the-target"
   :blocks [[:set [24 0 24] "emerald_block"]]
   :body {:at [8.5 0 8.5]}
   :act [[:job (jobs.explore.search {:target "emerald_block" :pattern :outward :heading :south-east :scan-radius 8
                                     :use-notes false :max-distance 30 :settings {:jobs.explore.search/spacing 8 :jobs.explore.search/max-legs 6} :spend {:job-time 110}})]]
   :expect [{:event {:source :job :kind :completed :data {:reason :found}} :within-s 120 :of-job true}
            {:no-event {:source :system :kind :error} :for-s 60 :until {:source :job :kind :completed}}]
   :limit-s 130}
  ;; card 4df607c2: a target already in sight (ahead or behind) ends the search at the origin with no leg walked. The count of look acts
  ;; (0 here, one per arrival spot otherwise) is a primitive-call count, not an event: pinned by explore-search-test, not here.
  {:name "target-in-sight-ahead-ends-at-the-origin"
   :blocks [[:set [14 0 16] "emerald_block"]]
   :body {:at [8.5 0 16.5] :yaw 270}
   :act [[:job (jobs.explore.search {:target "emerald_block" :scan-radius 16 :use-notes false :spend {:job-time 60}})]]
   :expect [{:event {:source :job :kind :completed :data {:reason :found}} :within-s 40 :of-job true}
            {:no-event {:source :job :kind :stopped} :for-s 40 :of-job true :until {:source :job :kind :completed}}]
   :after [[:body-near [8.5 0 16.5] 2]]
   :limit-s 60}
  {:name "target-behind-the-body-ends-at-the-origin"
   :blocks [[:set [2 0 16] "emerald_block"]]
   :body {:at [8.5 0 16.5] :yaw 270}
   :act [[:job (jobs.explore.search {:target "emerald_block" :scan-radius 16 :use-notes false :spend {:job-time 60}})]]
   :expect [{:event {:source :job :kind :completed :data {:reason :found}} :within-s 40 :of-job true}
            {:no-event {:source :job :kind :stopped} :for-s 40 :of-job true :until {:source :job :kind :completed}}]
   :after [[:body-near [8.5 0 16.5] 2]]
   :limit-s 60}
  ;; card 47a84af2: farm animals live on the surface, so a body sealed under rock climbs out (stair up) and then sees the cow;
  ;; the old search planned legs to cave stands under rock and never went up. Body in a 3x3x2 room in a stone mass 7 high, cow 14 east on the grass.
  {:name "farm-animal-search-from-a-sealed-room-climbs-out-and-finds-the-cow"
   :time :any
   :plot {:height 12}
   :blocks [[:fill [10 0 10] [22 6 22] "stone"] [:fill [15 0 15] [17 1 17] "air"]]
   :body {:at [16.5 0 16.5] :inventory [["iron_pickaxe" 1]]}
   :act [[:summon "cow" [30.5 0 16.5] "{NoAI:1b}"]
         [:job (jobs.explore.search {:target ["cow" "pig" "sheep" "chicken"] :count 1 :scan-radius 32 :use-notes false :spend {:job-time 150}})]]
   :expect [{:event {:source :job :kind :completed :data {:reason :found}} :within-s 160 :of-job true}
            {:no-event {:source :job :kind :stopped} :for-s 160 :of-job true :until {:source :job :kind :completed}}]
   :limit-s 170}]}
