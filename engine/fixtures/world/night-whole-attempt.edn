;; Night as one whole attempt (cards 3df7476d, 65b99a04): one round from the start to the morning leave, every hold
;; declared (job.holding while exposed), a body that digs in ends the night at once (the morning trigger lets it out), a site
;; where dig-in stops is left for another pit site 9+ blocks away, and a night with no site holds exposed and ends nothing-possible :exposed at day. Dirt pad y -6..-1 (the plot floor is over void); the wet-site case
;; covers the whole plot, since sites 9+ away are judged from the surface and dig-in finds the void.
;; jobs.survival.night is submitted in :act. Needs night: --allow-time --time-log <the shared time log>, one case per call.
{:defaults
 {:tags [:night :survival :dig-in]
  :time :night
  :blocks [[:fill [8 -6 8] [24 -1 24] "dirt"]]
  :body {:at [16.5 0 16.5] :effects [["resistance" 600 4]] :settle-s 3}}
 :cases
 [{:name "dug-in-ends-the-night-in-one-round"
   :act [[:job (jobs.survival.night)]
         [:await {:source :job :kind :shut-in.sealed} 60]
         [:wait-s 10]] ; deliberate hold: the sealed body must sit through it with no hold/idle/re-dig before dawn
   :expect [{:event {:source :job :kind :shut-in.sealed} :within-s 60}
            {:no-event {:source :job :kind :holding :data {:reason :sheltered}} :for-s 60 :until {:source :job :kind :completed :data {:name "jobs.survival.night"}}}
            {:no-event {:source :job :kind :idle} :for-s 120 :until {:source :job :kind :completed :data {:name "jobs.survival.night"}}}
            {:event {:source :job :kind :completed :data {:name "jobs.survival.night"}} :within-s 120 :of-job true}]
   :limit-s 140}
  {:name "wet-site-is-left-for-another-pit-site"
   :blocks [[:fill [0 -6 0] [31 -1 31] "dirt"] [:set [17 -1 16] "water"]]
   :act [[:job (jobs.survival.night)]]
   :expect [{:event {:source :job :kind :child_ended :data {:ending {:cause :no-way :data {:text [:contains "; not "]}}}} :within-s 30}
            {:event {:source :job :kind :shut-in.relocated} :within-s 60}
            {:event {:source :job :kind :shut-in.sealed} :within-s 120}
            {:no-event {:source :job :kind :shelter.exposed} :for-s 120 :until {:source :job :kind :shut-in.sealed}}]
   :after [[:block [16 -1 16] "dirt"]]
   :limit-s 140}
  {:name "no-site-holds-exposed-then-stops-at-day"
   :time :night-exclusive
   :blocks [[:fill [8 -6 8] [24 -1 24] "air"] [:fill [12 -1 12] [20 -1 20] "stone"]]
   :act [[:job (jobs.survival.night {:ways #{:bed :shelter}})]
         [:await {:source :job :kind :shelter.exposed} 60]
         [:await {:source :job :kind :holding :data {:reason [:contains "exposed: "]}} 30]
         [:time-set 1000]]
   :expect [{:event {:source :job :kind :shelter.exposed} :within-s 60}
            {:event {:source :job :kind :holding :data {:reason [:contains "exposed: "]}} :within-s 60 :of-job true}
            {:event {:source :job :kind :stopped :data {:kind :nothing-possible :reason :exposed}} :within-s 120 :of-job true}]
   :limit-s 140}
  ;; Card 97fac480 (fix 57d67d3b). Night 1 relocates off a wet start site (a :shut-in-failed entry) and ends roofed; the entries are
  ;; forgotten then, so night 2 (water gone) digs at the start again instead of skipping it: the start's descent cell is dug.
  {:name "failed-site-forgotten-when-the-night-ends-roofed"
   :time :night-exclusive
   :blocks [[:fill [0 -6 0] [31 -1 31] "dirt"] [:set [17 -1 16] "water"]]
   :act [[:job (jobs.survival.night)]
         [:await {:source :job :kind :shut-in.sealed} 150]
         [:await {:source :job :kind :completed :data {:name "jobs.survival.night"}} 120]
         [:rcon "execute positioned $X $Y $Z run setblock ~17 ~-1 ~16 minecraft:dirt"]
         ;; integer execute coordinates are block centres, so ~16 ~ ~16 is the start cell's centre (~16.5 lands on [17 0 17])
         [:rcon "execute positioned $X $Y $Z run tp $BODY ~16 ~ ~16"]
         [:time-set 14000]
         [:job (jobs.survival.night)]
         ;; the expectations below are met by night 1's events, so wait here until night 2 has dug the start cell
         [:until-rcon "execute positioned $X $Y $Z unless block ~16 ~-1 ~16 minecraft:dirt" "passed" 120]]
   :expect [{:event {:source :job :kind :shut-in.relocated} :within-s 150}
            {:event {:source :job :kind :completed :data {:name "jobs.survival.night"}} :within-s 300 :of-job true}]
   :after [[:not-block [16 -1 16] "dirt"]]
   :limit-s 330}
  ;; A hostile reflex cuts the night: a NoAI zombie 6 away fires hostile-near as the night starts, the reflex fights it, and the
  ;; night job resumes, digs in and ends the night.
  {:name "reflex-cut-night-resumes-and-holds"
   :body {:inventory [["iron_sword" 1]]} ; a fist loses to the helmeted zombie (flee), and the flight pillars up with the last dirt
   :register [{:trigger :hostile-near :args {:radius 8 :ranged-radius 16}
               :job (jobs.survival.respond-to-hostile)}]
   :act [[:summon "zombie" [22.5 0 16.5] "{NoAI:1b,equipment:{head:{id:\"minecraft:iron_helmet\",count:1}}}"]
         [:job (jobs.survival.night)]
         [:await {:source :job :kind :shut-in.sealed} 120]]
   :expect [{:event {:source :reflex :kind :fired :context {:reflex-id :hostile-near}} :within-s 30}
            {:event {:source :reflex :kind :ended :context {:reflex-id :hostile-near}} :within-s 90}
            {:event {:source :job :kind :shut-in.sealed} :within-s 120}
            {:no-event {:source :job :kind :shelter.exposed} :for-s 120}
            {:event {:source :job :kind :completed :data {:name "jobs.survival.night"}} :within-s 200 :of-job true}]
   :limit-s 230}
  ;; Card 7647c987: unarmed, a fist loses to the helmeted zombie and the body has only its 3 dirt: the flight digs down (a pit regains
  ;; its blocks) instead of pillaring with the last dirt, so the night's dig-in still seals.
  ;; The NoAI zombie never catches the body: the flight ends keeps-off, far from the plot's edge (a pit at the edge opens onto air), and the night
  ;; digs in there: the whole plot is dirt.
  {:name "reflex-cut-night-unarmed-few-blocks-seals"
   :plot {:length 64 :width 64 :height 6}
   :body {:at [32.5 0 32.5]}
   :blocks [[:fill [0 -6 0] [63 -1 63] "dirt"]]
   :register [{:trigger :hostile-near :args {:radius 8 :ranged-radius 16}
               :job (jobs.survival.respond-to-hostile)}]
   :act [[:summon "zombie" [38.5 0 32.5] "{NoAI:1b,equipment:{head:{id:\"minecraft:iron_helmet\",count:1}}}"]
         [:job (jobs.survival.night)]
         [:await {:source :job :kind :shut-in.sealed} 120]]
   :expect [{:event {:source :reflex :kind :fired :context {:reflex-id :hostile-near}} :within-s 30}
            {:event {:source :job :kind :shut-in.sealed} :within-s 120}
            {:event {:source :job :kind :completed :data {:name "jobs.survival.night"}} :within-s 200 :of-job true}]
   :limit-s 230}
  ;; Card 62278915 (fix b0462852): pit-site? needs ground the carried tools dig. A stone pad and no pickaxe: dig-in refuses at once
  ;; ("cannot harvest stone", no pit dug) and the night holds exposed; the same pad with a stone pickaxe is dug in.
  {:name "stone-pad-no-pickaxe-starts-no-pit"
   :time :night-exclusive
   :blocks [[:fill [8 -6 8] [24 -1 24] "stone"]]
   :act [[:job (jobs.survival.night {:settings {:jobs.survival.night.sites/flee-radius 0}})]
         [:await {:source :job :kind :shelter.exposed} 90]
         [:await {:source :job :kind :holding :data {:reason [:contains "exposed: "]}} 30]
         [:wait-s 10] ; deliberate hold: exposed with no pickaxe, a pit must not start before dawn
         [:time-set 1000]]
   :expect [{:event {:source :job :kind :shelter.exposed} :within-s 90}
            {:no-event {:source :job :kind :shut-in.sealed} :for-s 90 :until {:source :job :kind :stopped :data {:reason :exposed}}}
            {:event {:source :job :kind :stopped :data {:reason :exposed}} :within-s 150 :of-job true}]
   :after [[:block [16 -1 16] "stone"]]
   :limit-s 170}
  {:name "stone-pad-with-pickaxe-digs-in"
   :blocks [[:fill [8 -6 8] [24 -1 24] "stone"]]
   :body {:inventory [["stone_pickaxe" 1]]}
   :act [[:job (jobs.survival.night)]]
   :expect [{:event {:source :job :kind :shut-in.sealed} :within-s 90}
            {:no-event {:source :job :kind :shelter.exposed} :for-s 90 :until {:source :job :kind :shut-in.sealed}}]
   :limit-s 100}
]}
