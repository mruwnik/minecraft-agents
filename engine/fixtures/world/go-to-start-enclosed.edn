;; Card 61a0396f item 5: a body sealed in a 3x3 pen at the plot's west edge (the chunk side; the land west of the plot is
;; unloaded) with a far unloaded goal ends :unreachable :start-enclosed (not :goal-unloaded); an open start with the same
;; goal walks west as far as the floor goes and never reports :start-enclosed. The goal is 1000 blocks west of the plot (#at is plot-relative).
;; Plots float at y 150 over open air (floor y 149, grid from x 20000): west of the grid is a fall far past maxDrop 3, so
;; the open case cannot arrive; with :ways #{:walk :clear-seal} it plans :goal-unloaded and tours the loaded edge of the grid's floors
;; (each walk loads more), so it passes a small :tour-worth to bound the tour (a goal 1000 blocks off is worth a long one). Far-goal arrival on real terrain is not testable on this grid.
{:defaults
 {:tags [:movement :planner]
  :plot {:height 10}
  :body {:at [3.5 0 17.5]}
  :limit-s 90}
 :cases
 [{:name "sealed-pen-far-unloaded-goal-is-start-enclosed"
   :blocks [[:fill [1 -1 16] [5 4 20] "stone" :hollow]]
   :act [[:job (jobs.movement.go-to {:pos #at [-1000 0 17] :range 1 :ways #{:walk :clear-seal}})]]
   :expect [{:event {:source :job :kind :stopped :context {:chain [[:any]]} :data {:arrived false :reason :unreachable :why :start-enclosed}} :within-s 30 :of-job true}
            {:no-event {:source :job :kind :planned :data {:why "goal-unloaded"}} :for-s 30 :until {:source :job :kind :stopped :data {:arrived false :reason :unreachable :why :start-enclosed}}}]
   :after [[:body-near [3.5 0 17.5] 2] [:block [1 0 18] "stone"]]}
  {:name "sealed-pen-with-pickaxe-far-unloaded-goal-escalates"
   ;; card 5a822a99: with escalate on and a pickaxe the pen is dug out; it does not end :start-enclosed
   :blocks [[:fill [1 -1 16] [5 4 20] "stone" :hollow]]
   :body {:at [3.5 0 17.5] :inventory [["stone_pickaxe" 1]]}
   :act [[:job (jobs.movement.go-to {:pos #at [-1000 0 17] :range 1})]]
   :expect [{:event {:source :job :kind :go-to.escalated} :within-s 30 :of-job true}
            {:no-event {:source :job :kind #{:completed :stopped} :data {:why :start-enclosed}} :for-s 20}]}
  {:name "open-field-unloaded-goal-never-start-enclosed"
   ;; the plots' floors run on north and south along the grid's west edge: unbounded, go-to tours that loaded edge for
   ;; many minutes; :tour-worth setting 18 (about 60 blocks) ends it at the end of the first walk that got no nearer
   :act [[:job (jobs.movement.go-to {:pos #at [-1000 0 17] :range 1 :ways #{:walk :clear-seal} :settings {:jobs.lib.cost.value/tour-worth 18}})]]
   :expect [{:event {:source :job :kind :planned :data {:why "goal-unloaded"}} :within-s 60 :of-job true}
            {:event {:source :job :kind :stopped :context {:chain [[:any]]} :data {:arrived false :reason :unreachable :why :explore-spent}} :within-s 75 :of-job true}
            {:no-event {:source :job :kind :planned :data {:why "start-enclosed"}} :for-s 60 :until {:source :job :kind #{:completed :stopped} :data {:why :explore-spent}}}
            {:no-event {:source :job :kind #{:completed :stopped} :data {:why :start-enclosed}} :for-s 60 :until {:source :job :kind #{:completed :stopped} :data {:why :explore-spent}}}]
   :after []}]}
