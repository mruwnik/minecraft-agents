;; jobs.survival.dig-pocket on its own (shut-in step 2): a pocket cut into a hillside. A stone hill face at x 22..30 with
;; a pickaxe: sealed. Should-fail with {:reason :no-site}: flat ground, a sand hill (falls), the body's own plan. A 3x3 hill with
;; water at its core (unseen, so a pocket is started) stops :failed once the dig shows the water; a stone hill with no pickaxe fails :no-tool.
;; Empty-handed on a sand field (night shut-in, ways pit and pocket): the pit has no roof block (sand falls), so it digs a shaft by hand
;; down to the sandstone and pockets into it; with the rock deeper than the shaft goes it says so.
{:defaults
 {:tags [:survival :cornered]
  :time :any
  :plot {:height 20}
  :register []
  :body {:at [16.5 0 16.5] :effects [["resistance" 600 4]] :inventory [["iron_pickaxe" 1]]}}
 :cases
 [{:name "stone-hill-seals"
   :blocks [[:fill [22 0 8] [30 4 24] "stone"]]
   :act [[:job (jobs.survival.dig-pocket {})]]
   :expect [{:event {:source :job :kind :completed} :within-s 90 :of-job true}
            {:no-event {:source :job :kind :stopped} :for-s 90 :until {:source :job :kind :completed}}]
   :limit-s 120}
  {:name "flat-ground-no-site"
   :act [[:job (jobs.survival.dig-pocket {})]]
   :expect [{:event {:source :job :kind :stopped :data {:reason :no-site}} :within-s 30 :of-job true}]
   :limit-s 45}
  {:name "sand-hill-no-site"
   :blocks [[:fill [22 0 8] [30 4 24] "sand"]]
   :act [[:job (jobs.survival.dig-pocket {})]]
   :expect [{:event {:source :job :kind :stopped :data {:reason :no-site}} :within-s 30 :of-job true}]
   :limit-s 45}
  {:name "hidden-water-behind-the-wall-stops-the-pocket"
   :blocks [[:fill [22 0 15] [24 4 17] "stone"] [:set [23 0 16] "water"]]
   :act [[:job (jobs.survival.dig-pocket {})]]
   :expect [{:event {:source :job :kind :stopped :data {:reason :fluid-adjacent}} :within-s 30 :of-job true}]
   :limit-s 45}
  {:name "stone-without-pickaxe-no-tool"
   :blocks [[:fill [22 0 8] [30 4 24] "stone"]]
   :body {:inventory []}
   :act [[:job (jobs.survival.dig-pocket {})]]
   :expect [{:event {:source :job :kind :stopped :data {:reason :no-tool}} :within-s 30 :of-job true}]
   :limit-s 45}
  ;; card 6fa0c797: the hill is the footprint of a plan this body made: no niche is cut in it
  {:name "hill-in-the-bodys-own-plan-is-no-site"
   :blocks [[:fill [22 0 8] [30 4 24] "stone"]]
   :plans [{:id "hut" :metadata {:by "$body"} :parts [{:id "hill" :box [#at [22 0 8] #at [30 4 24]] :want [:any "stone"]}]}]
   :act [[:job (jobs.survival.dig-pocket {})]]
   :expect [{:event {:source :job :kind :stopped :data {:reason :no-site}} :within-s 30 :of-job true}]
   :after [[:block [22 0 16] "stone"] [:block [23 0 16] "stone"]]
   :limit-s 45}
  {:name "night-sand-over-sandstone-sinks-and-pockets"
   :blocks [[:fill [0 0 0] [31 5 31] "sandstone"] [:fill [0 6 0] [31 9 31] "sand"]]
   :body {:at [16.5 10 16.5] :inventory []}
   :act [[:job (jobs.survival.shut-in {:ways #{:room :walls :pit :pocket} :for :night})]]
   :expect [{:event {:source :job :kind :completed} :within-s 150 :of-job true}
            {:no-event {:source :job :kind :stopped} :for-s 150 :until {:source :job :kind :completed}}]
   :after [[:block [16 9 16] "air"]]
   :limit-s 170}
  {:name "night-sand-over-deep-rock-says-no-site"
   :blocks [[:fill [0 0 0] [31 9 31] "sand"]]
   :body {:at [16.5 10 16.5] :inventory []}
   :act [[:job (jobs.survival.shut-in {:ways #{:room :walls :pit :pocket} :for :night})]]
   :expect [{:event {:source :job :kind :stopped :data {:reason :no-way}} :within-s 150 :of-job true}]
   :limit-s 170}]}
