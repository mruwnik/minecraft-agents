;; Card 53d05972 (D19): go-to's ways that change the world are chosen by price when no walk is found, for a free body too.
;; Tunnel: stone mass x 2..30, y -4..3, z 14..18, a 1x2 tunnel along z 16 from x 4 to x 28 cut by a pit x 12..16 (4 deep: too far to drop
;; and climb out). Should-succeed: dirt carried: a 5-block bridge (go-to.escalated :bridge) and the far end is reached; a side tunnel round
;; the pit is walked, nothing placed. Should-fail: :ways #{:walk} stops at the pit edge, the pit stays open.
;; Cave: stone mass x 2..30, y -22..5, z 2..30, the body on top; a pocket 20 below and 18 across is too far for a dug route (16 cells at
;; most), so a stair down is cut (:stair). Should-fail: :may-dig #{:own} cuts nothing natural.
{:defaults
 {:tags [:movement :go-to :access]
  :time :any
  :plot {:height 12}
  :limit-s 200}
 :cases
 [{:name "pit-in-the-tunnel-is-bridged"
   :blocks [[:fill [2 -4 14] [30 3 18] "stone"] [:fill [4 0 16] [28 1 16] "air"] [:fill [12 -4 16] [16 -1 16] "air"]]
   :body {:at [5.5 0 16.5] :settle-s 2 :effects [["resistance" 600 4]] :inventory [["dirt" 9]]}
   :act [[:job (jobs.movement.go-to {:pos #at [27 0 16] :range 0})]]
   :expect [{:event {:source :job :kind :go-to.escalated :data {:step :bridge}} :within-s 60 :of-job true}
            {:event {:source :job :kind :completed :context {:chain [[:any]]} :data {:arrived true}} :within-s 160 :of-job true}]
   :after [[:block [14 -1 16] "dirt"] [:body-near [27.5 0 16.5] 2]]}
  {:name "walk-round-the-pit-is-taken-before-a-bridge"
   :blocks [[:fill [2 -4 14] [30 3 20] "stone"] [:fill [4 0 16] [28 1 16] "air"] [:fill [12 -4 16] [16 -1 16] "air"]
            [:fill [4 0 17] [4 1 17] "air"] [:fill [4 0 18] [28 1 18] "air"] [:fill [28 0 17] [28 1 17] "air"]]
   :body {:at [5.5 0 16.5] :settle-s 2 :effects [["resistance" 600 4]] :inventory [["dirt" 9]]}
   :act [[:job (jobs.movement.go-to {:pos #at [27 0 16] :range 0})]]
   :expect [{:event {:source :job :kind :completed :context {:chain [[:any]]} :data {:arrived true}} :within-s 120 :of-job true}
            {:no-event {:source :job :kind :go-to.escalated} :for-s 120 :until {:source :job :kind :completed :data {:arrived true}}}]
   :after [[:block [14 -1 16] "air"] [:body-near [27.5 0 16.5] 2]]}
  {:name "walk-only-does-not-bridge"
   :blocks [[:fill [2 -4 14] [30 3 18] "stone"] [:fill [4 0 16] [28 1 16] "air"] [:fill [12 -4 16] [16 -1 16] "air"]]
   :body {:at [5.5 0 16.5] :settle-s 2 :effects [["resistance" 600 4]] :inventory [["dirt" 9]]}
   :act [[:job (jobs.movement.go-to {:pos #at [27 0 16] :range 0 :ways #{:walk}})]]
   :expect [{:event {:source :job :kind :stopped :data {:arrived false}} :within-s 90 :of-job true}
            {:no-event {:source :job :kind :go-to.escalated} :for-s 90 :until {:source :job :kind :stopped :data {:arrived false}}}]
   :after [[:block [14 -1 16] "air"] [:body-far [27.5 0 16.5] 8]]
   :limit-s 100}
  {:name "cave-far-below-is-reached-by-a-stair-down"
   :blocks [[:fill [2 -22 2] [30 5 30] "stone"] [:fill [24 -14 16] [24 -13 16] "air"] [:fill [2 8 2] [30 8 30] "light"]]
   :body {:at [6.5 6 16.5] :settle-s 2 :effects [["resistance" 600 4] ["fire_resistance" 600 0]] :inventory [["stone_pickaxe" 1] ["cobblestone" 24]]}
   :act [[:job (jobs.movement.go-to {:pos #at [24 -14 16] :range 0})]]
   :expect [{:event {:source :job :kind :go-to.escalated :data {:step :stair}} :within-s 90 :of-job true}
            {:event {:source :job :kind :completed :context {:chain [[:any]]} :data {:arrived true}} :within-s 380 :of-job true}]
   :after [[:body-near [24.5 -14 16.5] 2]]
   :limit-s 400}
  {:name "own-blocks-only-cuts-no-stair-down"
   :blocks [[:fill [2 -22 2] [30 5 30] "stone"] [:fill [24 -14 16] [24 -13 16] "air"] [:fill [2 8 2] [30 8 30] "light"]]
   :body {:at [6.5 6 16.5] :settle-s 2 :effects [["resistance" 600 4]] :inventory [["stone_pickaxe" 1] ["cobblestone" 24]]}
   :act [[:job (jobs.movement.go-to {:pos #at [24 -14 16] :range 0 :ways #{:walk :dig :stair} :may-dig #{:own}})]]
   :expect [{:event {:source :job :kind :stopped :data {:arrived false}} :within-s 90 :of-job true}
            {:no-event {:source :action :kind :done :data {:name "dig"}} :for-s 90 :until {:source :job :kind :stopped :data {:arrived false}}}]
   :after [[:body-far [24.5 -14 16.5] 8]]
   :limit-s 100}]}
