;; Card 55c62ff3: a pile far below the surface. A dirt mass 20 high (the surface at y 19), a sealed chamber at [24 0 24]..[28 2 28]
;; where the body dies with 24 raw_iron; it respawns on the surface at [2 20 26], 20 down and 24 aside (the plot has a bedrock roof, so the stair starts in the body's own cell: a line needs 21 blocks of run-up).
;; Should-succeed: legs that get no nearer count as blocked, a stair is dug down through the dirt with a pickaxe given after the respawn (the trip never digs by hand) and the pile collected.
;; Should-fail: the same chamber in bedrock: no way down, the trip ends :abandoned instead of bouncing till the pile despawns.
;; A line of glass from the respawn cell to the chamber lets the body see the pile cell at the start (an unseen pile cell at night waits for light, by the clock, and the pile's window runs out first).
;; A glowstone in the chamber corner keeps natural mobs from spawning in the dark pile chamber.
;; Cards a4a4ddab, d54a4e3b: a stone mass and no pickaxe (nothing to fetch it with): abandoned at once; a zombie that appears at the body
;; once the stair is under way is weighed before the next step: the run declines (:danger) instead of digging on.
{:defaults
 {:tags [:survival :death :jobs]
  :plot {:height 24}
  :body {:at [26.5 0 26.5] :spawnpoint [2 20 26] :effects [["resistance" 600 4]]
         :inventory [["raw_iron" 24] ["cobblestone" 64] ["cobblestone" 36]]}
  :act [[:wait-s 1]
        [:kill-body]
        [:await {:source :body :kind :respawned} 30]
        [:until [:memory {:entries {:deaths [{:data {:pos [:any]}}]}}] 15]
        [:job (jobs.survival.recover-drops)]]
  :limit-s 330}
 :cases
 [{:name "deep-pile-stair-down-collects"
   :blocks [[:fill [0 0 0] [31 19 31] "dirt"] [:fill [24 0 24] [28 2 28] "air"] [:fill [24 2 24] [24 2 24] "glowstone"]
            [:fill [4 19 26] [4 19 26] "glass"] [:fill [5 18 26] [5 19 26] "glass"] [:fill [6 17 26] [6 18 26] "glass"] [:fill [7 16 26] [7 17 26] "glass"] [:fill [8 15 26] [8 16 26] "glass"] [:fill [9 15 26] [9 15 26] "glass"] [:fill [10 14 26] [10 15 26] "glass"] [:fill [11 13 26] [11 14 26] "glass"] [:fill [12 12 26] [12 13 26] "glass"] [:fill [13 11 26] [13 12 26] "glass"] [:fill [14 10 26] [14 11 26] "glass"] [:fill [15 9 26] [15 10 26] "glass"] [:fill [16 8 26] [16 9 26] "glass"] [:fill [17 7 26] [17 8 26] "glass"] [:fill [18 7 26] [18 7 26] "glass"] [:fill [19 6 26] [19 7 26] "glass"] [:fill [20 5 26] [20 6 26] "glass"] [:fill [21 4 26] [21 5 26] "glass"] [:fill [22 3 26] [22 4 26] "glass"] [:fill [23 2 26] [23 3 26] "glass"]]
   :act [[:rcon "give $BODY minecraft:iron_pickaxe 1"]]
   :expect [{:event {:source :job :kind :recover-drops.decided :data {:decision :collected}} :within-s 300 :of-job true}]
   :after [[:item "raw_iron" 24]]}
  {:name "sealed-bedrock-pile-ends-abandoned"
   :blocks [[:fill [0 0 0] [31 19 31] "bedrock"] [:fill [24 0 24] [28 2 28] "air"] [:fill [24 2 24] [24 2 24] "glowstone"]]
   :expect [{:event {:source :job :kind :recover-drops.decided :data {:decision :abandoned}} :within-s 300 :of-job true}]
   :after [[:item "raw_iron" 0]]}
  {:name "no-pickaxe-in-stone-ends-abandoned"
   :blocks [[:fill [0 0 0] [31 19 31] "stone"] [:fill [24 0 24] [28 2 28] "air"] [:fill [24 2 24] [24 2 24] "glowstone"]]
   :expect [{:event {:source :job :kind :recover-drops.decided :data {:decision :abandoned}} :within-s 120 :of-job true}
            {:no-event {:source :job :kind :stair.step} :for-s 60}]
   :after [[:item "raw_iron" 0]]
   :limit-s 150}
  {:name "zombie-in-the-stair-declines-for-danger"
   :blocks [[:fill [0 0 0] [31 19 31] "dirt"] [:fill [24 0 24] [28 2 28] "air"] [:fill [24 2 24] [24 2 24] "glowstone"]]
   :act [[:await {:source :job :kind :stair.step} 120]
         [:rcon "execute as $BODY at @s run summon zombie ~ ~ ~ {NoAI:1b,Tags:[\"wt\"],equipment:{head:{id:\"minecraft:iron_helmet\",count:1}}}"]]
   :expect [{:event {:source :job :kind :stopped :data {:reason :danger}} :within-s 150 :of-job true}]
   :limit-s 200}
;; card 5b64bbaa: a pile 19 below on an open 1:1 slope (dirt columns x 0..18, the top falling a block a step) with no tool: the body
  ;; respawns on the top at [0 19 16] and walks down to the pile at the foot [25 0 16]; no stair is dug for a pile a walk reaches
  {:name "open-slope-pile-is-walked-to-with-no-tool"
   :blocks [[:fill [0 0 8] [0 18 24] "dirt"] [:fill [1 0 8] [1 17 24] "dirt"] [:fill [2 0 8] [2 16 24] "dirt"] [:fill [3 0 8] [3 15 24] "dirt"] [:fill [4 0 8] [4 14 24] "dirt"] [:fill [5 0 8] [5 13 24] "dirt"] [:fill [6 0 8] [6 12 24] "dirt"] [:fill [7 0 8] [7 11 24] "dirt"] [:fill [8 0 8] [8 10 24] "dirt"] [:fill [9 0 8] [9 9 24] "dirt"] [:fill [10 0 8] [10 8 24] "dirt"] [:fill [11 0 8] [11 7 24] "dirt"] [:fill [12 0 8] [12 6 24] "dirt"] [:fill [13 0 8] [13 5 24] "dirt"] [:fill [14 0 8] [14 4 24] "dirt"] [:fill [15 0 8] [15 3 24] "dirt"] [:fill [16 0 8] [16 2 24] "dirt"] [:fill [17 0 8] [17 1 24] "dirt"] [:fill [18 0 8] [18 0 24] "dirt"]]
   :body {:at [25.5 0 16.5] :spawnpoint [0 19 16]}
   :expect [{:event {:source :job :kind :recover-drops.decided :data {:decision :collected}} :within-s 300 :of-job true}
            {:no-event {:source :job :kind :stair.step} :for-s 300 :until {:source :job :kind :recover-drops.decided}}]
