;; Card 00c378f4: a fight begun against one zombie goes on when two more zombies are seen far off (they are not in it yet);
;; the old rule turned its back as soon as the known mobs were no longer single. The zombies are NoAI, helmeted, 100 hp so the fight outlasts the window.
{:defaults
 {:tags [:hostile :combat]
  :time :any
  :register [{:trigger :hostile-near :args {:radius 40 :ranged-radius 16}
              :job (jobs.survival.respond-to-hostile)}]
  :body {:at [16.5 0 16.5] :inventory [["stone_sword" 1]]}}
 :cases
 [{:name "begun-fight-goes-on-with-two-zombies-far-off"
   :act [[:summon "zombie" [20.5 0 16.5] "{NoAI:1b,Health:100f,attributes:[{id:\"minecraft:max_health\",base:100}],equipment:{head:{id:\"minecraft:iron_helmet\",count:1}}}"]
         [:await {:source :job :kind :child_started :data {:slot :fight}} 20]
         [:summon "zombie" [16.5 0 40.5] "{NoAI:1b,Health:100f,attributes:[{id:\"minecraft:max_health\",base:100}]}"]
         [:summon "zombie" [16.5 0 44.5] "{NoAI:1b,Health:100f,attributes:[{id:\"minecraft:max_health\",base:100}]}"]]
   :expect [{:event {:source :job :kind :child_started :data {:slot :fight}} :within-s 20}
            {:no-event {:source :job :kind :retreat.target} :for-s 25}]
   :limit-s 60}]}
