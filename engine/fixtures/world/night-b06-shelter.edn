;; Night shelter follow-ups (cards a8fe9e86 1cbf8596 ad2c7c84 1b4b51d6 5a9e8c64 29349f1b ef5a94eb 712a8df7 1fbd292f b0e3b890 33e6bf20
;; 8c5974f7 8e4c3127 629bc2ee fadf9dd7 ba754e77 7cc76257 f6fef9d5 2383463a 87aee1d1): materials taken back at dawn, logs kept out of the walls,
;; supported wall cells, doors shut or given up, the dawn hostile hold, caves and tunnels, a walled home with a carried bed, the
;; dusk walk home, a far bed, the escalation out of a shaft. Needs night/time: --allow-time --time-log <the shared time log>.
;; Resistance 5 (amplifier 4) cancels RCON damage: the two hungry cases drop it so their damage lands. The plot floor is one block over void, so a dirt pad y -6..-1 lets a pit be dug.
{:defaults
 {:tags [:night :survival :dig-in]
  :time :night
  :body {:at [16.5 0 16.5] :effects [["resistance" 600 4]] :settle-s 3}}
 :cases
 [;; a8fe9e86: every shelter block dearer than dirt is dug back by day, not just the valuable ones
  {:name "cobblestone-walls-are-taken-back-at-dawn"
   :time :night-exclusive
   :sleep-skip true
   :body {:inventory [["cobblestone" 24] ["wooden_pickaxe" 1]]}
   :act [[:job (jobs.survival.night)]
         [:await {:source :job :kind :shut-in.sealed} 60]
         [:until [:memory {:entries {:shelter [{:data {:state :built}}]}}] 10]
         [:time-set 1000]
         [:job (jobs.survival.leave-shelter)]]
   :expect [{:event {:source :job :kind :shut-in.sealed} :within-s 60}
            {:event {:source :job :kind :dig-in.took-back} :within-s 150}
            {:event {:source :job :kind :completed :data {:name "jobs.survival.leave-shelter"}} :within-s 200 :of-job true}]
   :after [[:item "cobblestone" [:>= 8]]]
   :limit-s 230}
  ;; no pickaxe and too little cobblestone for walls: a pit plugged with it, punched out by hand at dawn (the cobblestone is lost)
  {:name "pit-is-punched-out-by-hand-without-a-pickaxe"
   :time :night-exclusive
   :sleep-skip true
   :blocks [[:fill [8 -6 8] [24 -1 24] "dirt"]]
   :body {:inventory [["cobblestone" 16]]}
   :act [[:job (jobs.survival.night)]
         [:await {:source :job :kind :shut-in.sealed} 60]
         [:until [:memory {:entries {:shelter [{:data {:state :built}}]}}] 10]
         [:time-set 1000]
         [:job (jobs.survival.leave-shelter)]]
   :expect [{:event {:source :job :kind :shut-in.sealed} :within-s 60}
            {:event {:source :job :kind :dig-in.left} :within-s 120}
            {:no-event {:source :job :kind :dig-in.took-back} :for-s 150}]
   :limit-s 170}
  ;; 1cbf8596, ad2c7c84: logs only, no tool, stone floor: a pit by hand takes longer at night than placing logs that are dug back at dawn, so it walls in at once; the sealed text names them
  {:name "log-walls-are-named-and-taken-back-at-dawn"
   :time :night-exclusive
   :sleep-skip true
   :blocks [[:fill [8 -6 8] [24 -1 24] "stone"]]
   :body {:inventory [["oak_log" 24]]}
   :act [[:job (jobs.survival.night)]
         [:await {:source :job :kind :shut-in.sealed} 60]
         [:until [:memory {:entries {:shelter [{:data {:state :built}}]}}] 10]
         [:time-set 1000]
         [:job (jobs.survival.leave-shelter)]]
   :expect [{:event {:source :job :kind :shut-in.sealed :message [:contains "oak_log"]} :within-s 60}
            {:event {:source :job :kind :dig-in.took-back} :within-s 200}]
   :after [[:item "oak_log" [:>= 8]]]
   :limit-s 280}
  ;; 1b4b51d6, ad2c7c84: logs only, no tool, diggable dirt: a pit by hand, at most one log placed
  {:name "logs-and-no-tool-on-dirt-digs-a-pit-and-keeps-the-logs"
   :time :any
   :blocks [[:fill [8 -6 8] [24 -1 24] "dirt"]]
   :body {:inventory [["oak_log" 12]]}
   :act [[:job (jobs.survival.shut-in {:ways #{:room :walls :pit} :for :night})]]
   :expect [{:event {:source :job :kind :shut-in.sealed} :within-s 90 :of-job true}
            {:no-event {:source :job :kind :stopped :data {:reason :no-way}} :for-s 90 :until {:source :job :kind :shut-in.sealed}}]
   :after [[:item "oak_log" [:>= 11]]]
   :limit-s 100}
  ;; 5a9e8c64: wall cells beside a one-block pillar have nothing to place against until a block goes under them
  {:name "pillar-top-walls-get-support-first"
   :time :any
   :blocks [[:set [16 -1 16] "stone"] [:set [16 0 16] "stone"] [:set [16 1 16] "stone"]]
   :body {:at [16.5 2 16.5] :inventory [["dirt" 24]]}
   :plot {:height 12 :light :dark}
   :act [[:job (jobs.survival.shut-in {:ways #{:room :walls :pit} :for :night})]]
   :expect [{:event {:source :job :kind :shut-in.sealed} :within-s 90 :of-job true}
            {:no-event {:source :job :kind :stopped :data {:reason :no-way}} :for-s 90 :until {:source :job :kind :shut-in.sealed}}]
   :limit-s 100}
  ;; 29349f1b: a hut with an open door: the night job shuts it instead of bunkering inside with it open
  {:name "open-door-of-the-hut-is-shut"
   :blocks [[:fill [8 0 8] [16 3 16] "stone" :hollow] [:fill [9 0 9] [15 2 15] "air"]
            [:set [9 1 9] "torch"] [:set [15 1 15] "torch"]
            [:set [12 0 8] "oak_door[facing=north,half=lower,hinge=left,open=true]"]
            [:set [12 1 8] "oak_door[facing=north,half=upper,hinge=left,open=true]"]]
   :body {:at [13.5 0 13.5] :inventory [["cobblestone" 16]]}
   :act [[:job (jobs.survival.night)]]
   :expect [{:no-event {:source :job :kind :stopped} :for-s 25}
            {:no-event {:source :job :kind :shut-in.sealed} :for-s 25}]
   :after [[:block [12 0 8] "oak_door[open=false]"]]
   :limit-s 40}
  ;; ef5a94eb: an iron door cannot be shut by hand: then the body digs in on its spot, never ends roofed
  {:name "door-that-will-not-shut-digs-in"
   :blocks [[:fill [8 0 8] [16 3 16] "stone" :hollow] [:fill [9 0 9] [15 2 15] "air"]
            [:set [9 1 9] "torch"] [:set [15 1 15] "torch"]
            [:set [12 0 8] "iron_door[facing=north,half=lower,hinge=left,open=true]"]
            [:set [12 1 8] "iron_door[facing=north,half=upper,hinge=left,open=true]"]]
   :body {:at [13.5 0 13.5] :inventory [["cobblestone" 16]]}
   :act [[:job (jobs.survival.night)]]
   :expect [{:event {:source :job :kind :shut-in.sealed} :within-s 150}]
   :limit-s 160}
  ;; 712a8df7: first light with a hostile known near the shelter: the body stays in, and leaves once the mob is gone
  {:name "dawn-with-a-known-hostile-stays-in-until-it-is-gone"
   :time :night-exclusive
   :register [{:trigger :night} {:trigger :dawn}]
   :sleep-skip true
   :body {:inventory [["cobblestone" 24]]}
   :act [[:summon "zombie" [28.5 0 16.5] "{UUID:[I;2006101,1,1,1],NoAI:1b,equipment:{head:{id:\"minecraft:iron_helmet\",count:1}}}"]
         [:await {:source :job :kind :shut-in.sealed} 60]
         [:until [:memory {:entries {:shelter [{:data {:state :built}}]}}] 10]
         [:time-set 23500]
         [:await {:source :job :kind :night.dawn-hold} 60]
         [:wait-s 5]
         [:rcon "kill @e[type=zombie,tag=wt,$BOX]"]]
   :expect [{:event {:source :job :kind :night.dawn-hold} :within-s 120}
            {:event {:source :job :kind :dig-in.left} :within-s 240}]
   :limit-s 260}
  ;; d790ad75: an unarmed body stays in past the plain dawn grace (husks do not burn by day) while a hostile is known near
  {:name "dawn-unarmed-stays-in-past-the-grace-with-a-known-hostile"
   :time :night-exclusive :time-why :dawn-decision
   :register [{:trigger :night} {:trigger :dawn}]
   :sleep-skip true
   :body {:inventory [["cobblestone" 24]]}
   :act [[:summon "zombie" [28.5 0 16.5] "{UUID:[I;2006101,2,1,1],NoAI:1b,equipment:{head:{id:\"minecraft:iron_helmet\",count:1}}}"]
         [:await {:source :job :kind :shut-in.sealed} 60]
         [:until [:memory {:entries {:shelter [{:data {:state :built}}]}}] 10]
         [:time-set 1500]
         [:await {:source :job :kind :night.dawn-hold} 60]
         [:wait-s 5]
         [:rcon "kill @e[type=zombie,tag=wt,$BOX]"]]
   :expect [{:event {:source :job :kind :night.dawn-hold} :within-s 120}
            {:event {:source :job :kind :dig-in.left} :within-s 240}]
   :limit-s 260}
  ;; f6fef9d5: the hold names the failed sites' reasons
  {:name "exposed-hold-names-the-failed-sites"
   :blocks [[:fill [12 -1 12] [20 -1 20] "stone"]]
   :act [[:job (jobs.survival.night {:ways #{:bed :shelter} :settings {:jobs.survival.night.sites/flee-radius 0}})]]
   :expect [{:event {:source :job :kind :shelter.exposed :message [:not [:contains "no site tried"]]} :within-s 90}]
   :limit-s 100}
  ;; 1fbd292f: a wide dark natural cave is no shelter: the body digs in where it stands
  {:name "open-cave-digs-in-where-it-stands"
   :blocks [[:fill [2 0 2] [30 9 30] "stone"] [:fill [4 0 4] [28 6 28] "air"]]
   :plot {:height 12}
   :register [{:trigger :night}]
   :body {:at [16.5 0 16.5] :inventory [["cobblestone" 16]]}
   :expect [{:event {:source :job :kind :shut-in.sealed} :within-s 90}]
   :limit-s 100}
  ;; 1fbd292f, b0e3b890, 49c6d276: in a dark 1-wide tunnel it cut itself the body keeps working; the night reflex does not fire (it saw each wall close up as it cut, a tunnel it never walked is not known shut)
  {:name "own-tunnel-keeps-working-at-night"
   :blocks [[:fill [2 0 2] [30 9 30] "stone"] [:fill [4 0 16] [4 1 16] "air"]]
   :plot {:height 12}
   :register [{:trigger :night}]
   :body {:at [4.5 0 16.5] :inventory [["stone_pickaxe" 1]]}
   :act [[:job (jobs.gather.strip-tunnel {:heading "east" :limit 16 :torches false})]
         [:job (jobs.blocks.dig {:pos #at [21 0 16]})]]
   :expect [{:event {:source :job :kind :completed :data {:name "jobs.blocks.dig"}} :within-s 120 :of-job true}
            {:no-event {:source :reflex :kind :fired :context {:reflex-id :night}} :for-s 120 :until {:source :job :kind :completed :data {:name "jobs.blocks.dig"}}}
            {:no-event {:source :job :kind :shut-in.sealed} :for-s 120 :until {:source :job :kind :completed :data {:name "jobs.blocks.dig"}}}]
   :limit-s 130}
  ;; f7bf9239: underground no sky light reaches the body, so the night reflex does not call a miner out of a big dark cave
  {:name "buried-miner-in-an-open-dark-cave-keeps-working-at-night"
   :time :night :time-why :night-light
   :blocks [[:fill [2 0 2] [42 9 42] "stone"] [:fill [4 0 4] [40 3 40] "air"]]
   :plot {:length 48 :width 48 :height 12}
   :register [{:trigger :night}]
   :body {:at [6.5 0 16.5] :inventory [["stone_pickaxe" 1]]}
   :act [[:job (jobs.blocks.dig {:pos #at [3 0 16]})]]
   :expect [{:event {:source :job :kind :completed :data {:name "jobs.blocks.dig"}} :within-s 60 :of-job true}
            {:no-event {:source :reflex :kind :fired :context {:reflex-id :night}} :for-s 60 :until {:source :job :kind :completed :data {:name "jobs.blocks.dig"}}}]
   :limit-s 70}
  ;; 33e6bf20: a walk inside an open cave is not held as sheltered, even with a dug-in entry left from an earlier night
  {:name "walk-in-an-open-cave-is-not-held"
   :blocks [[:fill [2 0 2] [42 9 42] "stone"] [:fill [4 0 4] [40 6 40] "air"]]
   :plot {:length 48 :width 48 :height 12}
   :memory [{:kind :shelter :data {:pos #xyz [6 0 16]} :policy {:cap 1 :ttl :forever}}]
   :body {:at [6.5 0 16.5]}
   :act [[:job (jobs.movement.go-to {:pos #xyz [26 0 16] :range 1})]]
   :expect [{:event {:source :job :kind :completed :data {:name "jobs.movement.go-to"}} :within-s 90 :of-job true}
            {:no-event {:source :job :kind :waiting :data {:reason :exposed}} :for-s 90 :until {:source :job :kind :completed :data {:name "jobs.movement.go-to"}}}]
   :after [[:body-near [26.5 0 16.5] 2.5]]
   :limit-s 100}
  ;; 33e6bf20: buried at night in a stair tunnel, a walk to a goal further down is no walk out of the shelter
  {:name "buried-walk-down-the-tunnel-is-not-held"
   :blocks [[:fill [6 -1 12] [26 12 20] "stone"]
            [:fill [8 9 16] [8 11 16] "air"] [:fill [9 8 16] [9 10 16] "air"] [:fill [10 7 16] [10 9 16] "air"]
            [:fill [11 6 16] [11 8 16] "air"] [:fill [12 5 16] [12 7 16] "air"] [:fill [13 4 16] [13 6 16] "air"]
            [:fill [14 3 16] [14 5 16] "air"] [:fill [15 2 16] [15 4 16] "air"] [:fill [16 1 16] [16 3 16] "air"]
            [:fill [17 0 16] [17 2 16] "air"]]
   :plot {:height 16}
   :body {:at [8.5 9 16.5]}
   :act [[:job (jobs.movement.go-to {:pos #xyz [17 0 16] :range 1})]]
   :expect [{:event {:source :job :kind :completed :data {:name "jobs.movement.go-to"}} :within-s 60 :of-job true}
            {:no-event {:source :job :kind :waiting :data {:reason :exposed}} :for-s 60 :until {:source :job :kind :completed :data {:name "jobs.movement.go-to"}}}]
   :after [[:body-near [17.5 0 16.5] 2.5]]
   :limit-s 70}
  ;; 33e6bf20, Q380: the same buried body asked to walk up to open ground is held when the walk's risk is too high (here a risk share of 0), with the reason
  {:name "buried-walk-up-to-open-ground-is-held-when-too-risky"
   :time-why :dawn-decision
   :settings {:jobs.movement.go-to.risk/risk-share 0}
   :blocks [[:fill [6 -1 12] [26 8 20] "stone"] [:fill [14 0 16] [15 1 16] "air"]]
   :plot {:height 14}
   :body {:at [14.5 0 16.5]}
   :act [[:job (jobs.movement.go-to {:pos #xyz [20 9 16] :range 1})]]
   :expect [{:event {:source :job :kind :waiting :data {:reason :risky}} :within-s 30 :of-job true}
            {:no-event {:source :job :kind :completed :data {:name "jobs.movement.go-to"}} :for-s 30 :until {:source :job :kind :waiting :data {:reason :risky}}}]
   :after [[:body-near [14.5 0 16.5] 1.5]]
   :limit-s 40}
  ;; Q380: with the default risk the same walk is not held for day: the start check passes it and the walk goes on to dig its stair out
  {:name "buried-walk-up-to-open-ground-is-not-held-when-the-risk-is-acceptable"
   :time-why :dawn-decision
   :blocks [[:fill [6 -1 12] [26 8 20] "stone"] [:fill [14 0 16] [15 1 16] "air"]]
   :plot {:height 14}
   :body {:at [14.5 0 16.5]}
   :act [[:job (jobs.movement.go-to {:pos #xyz [20 9 16] :range 1})]]
   :expect [{:event {:source :job :kind :go-to.escalated} :within-s 40 :of-job true}
            {:no-event {:source :job :kind :waiting :data {:reason #{:risky :exposed}}} :for-s 20 :of-job true}]
   :limit-s 50}
  ;; 122e3c60: a parent job whose walk waits for day in a shelter waits with the walk's reason (job.waiting :exposed), not an unexplained idle
  {:name "buried-from-plan-walk-holds-with-the-night-reason"
   :blocks [[:fill [6 -1 12] [26 8 20] "stone"] [:fill [14 0 16] [15 1 16] "air"]]
   :plot {:height 14}
   :body {:at [14.5 0 16.5] :inventory [["cobblestone" 4]]}
   :plans [{:id "roof" :metadata {:by "$body"} :parts [{:id "p" :cells [#at [20 9 16]] :want "cobblestone"}]}]
   :act [[:job (jobs.build.from-plan {:plan "$plan:roof" :ways #{:carried}})]]
   :expect [{:event {:source :job :kind :waiting :data {:reason :exposed}} :within-s 40 :of-job true}
            {:no-event {:source :job :kind #{:completed :stopped}} :for-s 30 :until {:source :job :kind :waiting :data {:reason :exposed}} :of-job true}]
   :after [[:body-near [14.5 0 16.5] 1.5]]
   :limit-s 50}
  ;; 87aee1d1: a bed in a hut with no door cannot be reached (bedrock walls: go-to digs through any other wall); sleep says why (the body is shut in here, no way out), not a bare "cannot reach"
  {:name "sleep-to-a-walled-in-bed-says-why"
   :blocks [[:fill [8 -1 8] [16 3 16] "bedrock" :hollow] [:fill [9 0 9] [15 2 15] "air"]
            [:set [9 1 9] "torch"] [:set [15 1 15] "torch"]
            [:set [11 0 12] "red_bed[facing=east,part=foot]"] [:set [12 0 12] "red_bed[facing=east,part=head]"]]
   :body {:at [4.5 0 12.5] :inventory [["stone_pickaxe" 1]]}
   :act [[:job (jobs.survival.sleep {:bed #at [11 0 12]})]]
   :expect [{:event {:source :job :kind :bed_unreachable :message [:contains "cannot reach the bed: "]} :within-s 240 :of-job true}
            {:event {:source :job :kind :bed_unreachable :message [:contains "shut in here"]} :within-s 240 :of-job true}
            {:no-event {:source :action :kind :done :data {:name "sleep" :status "sleeping"}} :for-s 30}]
   :after [[:body-far [11.5 0 12.5] 3]]
   :limit-s 250}
  ;; 2383463a: a far flight left a :displaced entry: the bed 100 blocks off (past the 48 default-bed-radius) is walked back to and slept in
  {:name "displaced-body-walks-back-to-a-bed-100-blocks-away"
   :time :night-exclusive
   :plot {:length 120 :width 32}
   :blocks [[:fill [94 0 10] [106 3 22] "stone" :hollow] [:fill [95 0 11] [105 2 21] "air"]
            [:set [95 1 11] "torch"] [:set [105 1 21] "torch"]
            [:set [100 0 10] "oak_door[facing=north,half=lower,hinge=left,open=false]"]
            [:set [100 1 10] "oak_door[facing=north,half=upper,hinge=left,open=false]"]
            [:set [100 0 16] "red_bed[facing=east,part=foot]"] [:set [101 0 16] "red_bed[facing=east,part=head]"]]
   :body {:at [4.5 0 16.5]}
   :memory [{:kind :displaced :data {:from #xyz [100 0 16]} :policy {:cap 1 :ttl 1800000}}]
   :act [[:job (jobs.memory.set-place {:name :bed :pos #at [100 0 16]}) [:now]]
         [:job (jobs.survival.night)]]
   :expect [{:no-event {:source :job :kind :night.bed-too-far} :for-s 60 :until {:source :action :kind :done :data {:name "sleep" :status "sleeping"}}}
            {:event {:source :action :kind :done :data {:name "sleep" :status "sleeping"}} :within-s 150}]
   :limit-s 170}
  ;; 8c5974f7: by day the night reflex does not fire, however often the body stops
  {:name "midday-night-reflex-stays-quiet"
   :time :day :time-why :dawn-decision
   :register [{:trigger :night}]
   :act [[:job (jobs.movement.go-to {:pos #xyz [24 0 16] :range 1})]]
   :expect [{:event {:source :job :kind :completed :data {:name "jobs.movement.go-to"}} :within-s 40 :of-job true}
            {:no-event {:source :reflex :kind :fired :context {:reflex-id :night}} :for-s 40}]
   :limit-s 50}
  ;; 8e4c3127: a small room walled in stone (a bed needs three cells in a row beyond any one-wide gap, which counts as a doorway), a carried bed: go-to digs in, the bed goes down in the room and is slept in, no walk loop
  {:name "walled-in-home-with-a-carried-bed-sleeps"
   :time :night-exclusive
   :blocks [[:fill [10 0 10] [17 3 14] "stone"] [:fill [12 0 11] [15 1 13] "air"]]
   :body {:at [4.5 0 12.5] :inventory [["stone_pickaxe" 1] ["red_bed" 1]]}
   :act [[:job (jobs.memory.set-place {:name :home :pos #at [12 0 12]})]
         [:job (jobs.survival.night)]
         [:await {:source :action :kind :done :data {:name "sleep" :status "sleeping"}} 180]]
   :expect [{:event {:source :job :kind :night.bed-placed} :within-s 180}
            {:event {:source :action :kind :done :data {:name "sleep" :status "sleeping"}} :within-s 180}]
   :limit-s 200}
  ;; 2383463a: a bed 150 blocks off is too far to walk to tonight (no flight): it digs in here
  {:name "bed-150-blocks-away-is-too-far"
   :plot {:length 200 :width 32}
   :blocks [[:set [150 0 16] "red_bed[facing=east,part=foot]"] [:set [151 0 16] "red_bed[facing=east,part=head]"]]
   :body {:at [4.5 0 16.5] :inventory [["cobblestone" 16]]}
   :act [[:job (jobs.memory.set-place {:name :bed :pos #at [150 0 16]}) [:now]]
         [:job (jobs.survival.night)]]
   :expect [{:event {:source :job :kind :night.bed-too-far} :within-s 60}
            {:event {:source :job :kind :shut-in.sealed} :within-s 100}]
   :after [[:body-far [150.5 0 16.5] 100]]
   :limit-s 110}
  ;; 9d3023bc: dug in with the bed 20 blocks off, sleep walks there (go-to prices the route) instead of waiting for day
  {:name "sleep-dug-in-walks-to-a-bed-20-blocks-away"
   :time :night-exclusive :time-why :sleep
   :plot {:length 60 :width 32}
   :blocks [[:set [24 0 16] "red_bed[facing=east,part=foot]"] [:set [25 0 16] "red_bed[facing=east,part=head]"]]
   :body {:at [4.5 0 16.5] :inventory [["cobblestone" 16]]}
   :act [[:job (jobs.survival.shut-in {:ways #{:room :walls :pit} :for :night})]
         [:await {:source :job :kind :shut-in.sealed} 60]
         [:job (jobs.survival.sleep {:bed #at [24 0 16]})]]
   :expect [{:no-event {:source :job :kind #{:waiting :holding} :data {:reason :night-sheltered}} :for-s 30 :until {:source :action :kind :done :data {:name "sleep" :status "sleeping"}}}
            {:event {:source :action :kind :done :data {:name "sleep" :status "sleeping"}} :within-s 110}]
   :limit-s 120}
  ;; ba754e77: a body shut in at the bottom of a 1x1 shaft cuts its own stair up to a goal on the surface
  {:name "shaft-bottom-escalates-up-to-the-surface-goal"
   :time :day :time-why :dawn-decision
   :blocks [[:fill [8 0 8] [24 16 24] "stone"] [:set [16 1 16] "air"] [:set [16 0 16] "air"]]
   :plot {:height 22}
   :body {:at [16.5 0 16.5] :inventory [["stone_pickaxe" 1]]}
   :act [[:job (jobs.movement.go-to {:pos #xyz [16 17 20] :range 1})]]
   :expect [{:event {:source :job :kind :go-to.escalated} :within-s 90}
            {:event {:source :job :kind :completed :data {:name "jobs.movement.go-to"}} :within-s 240 :of-job true}]
   :after [[:body-near [16.5 17 20.5] 3]]
   :limit-s 250}
  {:name "shaft-walled-in-bedrock-gives-up-at-once"
   :time :day :time-why :dawn-decision
   :blocks [[:fill [8 0 8] [24 16 24] "bedrock"] [:set [16 1 16] "air"] [:set [16 0 16] "air"]]
   :plot {:height 22}
   :body {:at [16.5 0 16.5] :inventory [["stone_pickaxe" 1]]}
   :act [[:job (jobs.movement.go-to {:pos #xyz [16 17 20] :range 1})]]
   :expect [{:event {:source :job :kind :stopped} :within-s 60 :of-job true}
            {:no-event {:source :job :kind :completed :data {:name "jobs.movement.go-to"}} :for-s 60 :until {:source :job :kind :stopped}}]
   :after [[:body-near [16.5 0 16.5] 1.5]]
   :limit-s 70}
  ;; 629bc2ee: dusk, a home 66 blocks off: the dusk-home reflex fires and the body walks there
  {:name "dusk-walks-home"
   :time :day :time-why :dawn-decision
   :plot {:length 100 :width 32}
   :register [{:trigger :dusk-home}]
   :blocks [[:set [70 0 16] "torch"]]
   :body {:at [4.5 0 16.5]}
   :act [[:job (jobs.memory.set-place {:name :home :pos #at [70 0 16]}) [:now]]
         [:time-set 12000]]
   :expect [{:event {:source :reflex :kind :fired :context {:reflex-id :dusk-home}} :within-s 60}
            {:event {:source :reflex :kind :ended :context {:reflex-id :dusk-home}} :within-s 120}]
   :after [[:body-near [70.5 0 16.5] 5]]
   :limit-s 130}
  ;; 7cc76257: a roofed body with the night reflex registered still runs an inventory-only job
  {:name "sheltered-body-runs-an-inventory-only-craft"
   :blocks [[:fill [8 0 8] [16 3 16] "stone" :hollow] [:fill [9 0 9] [15 2 15] "air"]
            [:set [9 1 9] "torch"] [:set [15 1 15] "torch"]]
   :register [{:trigger :night}]
   :body {:at [13.5 0 13.5] :inventory [["oak_planks" 4]] :settle-s 2}
   :act [[:job (jobs.items.craft {:item "stick"})]]
   :expect [{:event {:source :job :kind :completed :data {:name "jobs.items.craft"}} :within-s 60 :of-job true}]
   :after [[:item "stick" [:>= 4]]]
   :limit-s 80}
  ;; fe853845: at night in a sealed shelter with nothing to do the night job is done at once (:already); it is never "waiting :not-night"
  {:name "night-job-in-a-sealed-hut-is-done-and-is-not-waiting-not-night"
   :blocks [[:fill [8 0 8] [16 3 16] "stone" :hollow] [:fill [9 0 9] [15 2 15] "air"]
            [:set [9 1 9] "torch"] [:set [15 1 15] "torch"]]
   :body {:at [13.5 0 13.5]}
   :act [[:job (jobs.survival.night)]]
   :expect [{:event {:source :job :kind :completed :data {:name "jobs.survival.night" :cause :already}} :within-s 30 :of-job true}
            {:no-event {:source :job :kind :waiting :data {:reason :not-night}} :for-s 30}]
   :limit-s 40}]}
