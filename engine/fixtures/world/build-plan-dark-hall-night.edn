;; Card ab58ec22 (b37e22cd, 0a82bb14): from-plan in a long dark hall (no dawn lights it; a never-lit cell) at night, no torch carried.
;; Should-succeed: a seen chest of torches is fetched and the far site built. With no source the fetch fails and the build does not fail:
;; a 2-cell job is short work, so its dark stay is cheaper than the dawn wait (stay priced as the job's work seconds) and it is built unlit.
;; Needs night: run with --allow-time --time-log <the shared time log>.
{:defaults
 {:tags [:build :light :night :fetch]
  :time :night :time-why :night-light
  :plot {:height 8 :floor "grass_block" :length 64}
  :blocks [[:fill [0 0 8] [60 3 24] "stone"] [:fill [3 0 12] [58 1 20] "air"]]
  :body {:at [7.5 0 16.5] :effects [["resistance" 600 4]] :inventory [["oak_planks" 6]]}
  :plans [{:id "floor" :metadata {:by "$body"} :parts [{:id "p" :cells [#at [50 0 16] #at [51 0 16]] :want "oak_planks"}]}]
  :limit-s 200}
 :cases
 [{:name "hall-at-night-torches-are-fetched-then-built"
   :blocks [[:set [10 0 19] "chest{Items:[{Slot:0b,id:\"minecraft:torch\",count:8}]}"]]
   :act [[:rcon "execute as $BODY at @s run tp @s ~ ~ ~ 45 20"] [:until-seen {:block "chest"} 10]
         [:job (jobs.build.from-plan {:plan "$plan:floor"})]]
   :expect [{:event {:source :job :kind :child_started :data {:slot :need}} :within-s 60 :of-job true}
            {:event {:source :job :kind :completed :data {:missing []}} :within-s 180 :of-job true}]
   :after [[:block [50 0 16] "oak_planks"] [:block [51 0 16] "oak_planks"]]}
  {:name "hall-at-night-no-source-short-job-builds-unlit-not-failing"
   :act [[:job (jobs.build.from-plan {:plan "$plan:floor"})]]
   :expect [{:event {:source :job :kind :completed :data {:missing []}} :within-s 120 :of-job true}
            {:no-event {:source :job :kind :failed} :for-s 1 :of-job true}
            {:no-event {:source :job :kind :stopped} :for-s 1 :of-job true}]
   :after [[:block [50 0 16] "oak_planks"] [:block [51 0 16] "oak_planks"]]}
 {:name "hall-at-night-no-source-long-job-waits-for-dawn-not-failing"
   :plans [{:id "long" :metadata {:by "$body"} :parts [{:id "p" :cells [#at [20 0 15] #at [21 0 15] #at [22 0 15] #at [23 0 15] #at [24 0 15] #at [25 0 15] #at [26 0 15] #at [27 0 15] #at [28 0 15] #at [29 0 15] #at [30 0 15] #at [31 0 15] #at [32 0 15] #at [33 0 15] #at [34 0 15] #at [35 0 15] #at [36 0 15] #at [37 0 15] #at [38 0 15] #at [39 0 15] #at [20 0 16] #at [21 0 16] #at [22 0 16] #at [23 0 16] #at [24 0 16] #at [25 0 16] #at [26 0 16] #at [27 0 16] #at [28 0 16] #at [29 0 16] #at [30 0 16] #at [31 0 16] #at [32 0 16] #at [33 0 16] #at [34 0 16] #at [35 0 16] #at [36 0 16] #at [37 0 16] #at [38 0 16] #at [39 0 16]] :want "oak_planks"}]}]
   :body {:at [7.5 0 16.5] :effects [["resistance" 600 4]] :inventory [["oak_planks" 40]]}
   :act [[:job (jobs.build.from-plan {:plan "$plan:long" :worth 100})]]
   :expect [{:event {:source :job :kind :waiting :data {:reason :exposed}} :within-s 60 :of-job true}
            {:no-event {:source :job :kind :completed} :for-s 30 :of-job true}
            {:no-event {:source :job :kind :failed} :for-s 1 :of-job true}
            {:no-event {:source :job :kind :stopped} :for-s 1 :of-job true}]
   :after [[:block [30 0 15] "air"] [:block [30 0 16] "air"]]}]}
