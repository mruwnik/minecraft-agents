;; jobs.farm.plant box mode (cards 88da0ba0, ee5eb5b4): a sown cell is walked over (crops have no collision), one run
;; sows one crop (the first pick is kept while carried), no seed ends with :no-seed, a field inside another plan's
;; footprint stays bare. Water beside the farmland (floor y -1 is the ground layer).
{:defaults
 {:tags [:farm :plant :jobs]
  :time :any
  :body {:at [10.5 0 14.5] :effects [["resistance" 600 4]]}}
 :cases
 [{:name "sow-wheat-row-walks-over-sown-cells"
   :blocks [[:fill [10 -1 16] [21 -1 16] "farmland[moisture=7]"] [:fill [10 -2 17] [21 -2 17] "stone"] [:fill [10 -1 17] [21 -1 17] "water"]]
   :body {:inventory [["wheat_seeds" 30]]}
   :act [[:job (jobs.farm.plant {:area {:min #xyz [10 -1 16] :max #xyz [21 -1 16]}})]]
   :expect [{:event {:source :job :kind :completed :data {:planted 12 :status :completed}} :within-s 90 :of-job true}]
   :after [[:block [10 0 16] "wheat"] [:block [21 0 16] "wheat"] [:item "wheat_seeds" 18]]}
  {:name "one-run-one-crop-first-pick-kept"
   ;; carrots count as food: 20 (60 points) stay as the food reserve, only the 5 above it are sown
   :blocks [[:fill [10 -1 16] [21 -1 16] "farmland[moisture=7]"] [:fill [10 -2 17] [21 -2 17] "stone"] [:fill [10 -1 17] [21 -1 17] "water"]]
   :body {:inventory [["wheat_seeds" 7] ["carrot" 25]]}
   :act [[:job (jobs.farm.plant {:area {:min #xyz [10 -1 16] :max #xyz [21 -1 16]}})]]
   :expect [{:event {:source :job :kind :completed :data {:planted 12 :status :completed}} :within-s 90 :of-job true}]
   :after [[:block [16 0 16] "wheat"] [:block [17 0 16] "carrots"] [:block [21 0 16] "carrots"]
           [:item "wheat_seeds" 0] [:item "carrot" 20]]}
  {:name "seed-arg-picks-that-crop"
   :blocks [[:fill [10 -1 16] [13 -1 16] "farmland[moisture=7]"] [:fill [10 -2 17] [13 -2 17] "stone"] [:fill [10 -1 17] [13 -1 17] "water"]]
   :body {:inventory [["carrot" 20] ["wheat_seeds" 5]]}
   :act [[:job (jobs.farm.plant {:area {:min #xyz [10 -1 16] :max #xyz [13 -1 16]} :seed "wheat_seeds"})]]
   :expect [{:event {:source :job :kind :completed :data {:planted 4 :status :completed}} :within-s 60 :of-job true}]
   :after [[:block [10 0 16] "wheat"] [:block [13 0 16] "wheat"] [:item "carrot" 20]]}
  {:name "no-seed-does-not-sow"
   :blocks [[:fill [10 -1 16] [13 -1 16] "farmland[moisture=7]"] [:fill [10 -2 17] [13 -2 17] "stone"] [:fill [10 -1 17] [13 -1 17] "water"]]
   :act [[:job (jobs.farm.plant {:area {:min #xyz [10 -1 16] :max #xyz [13 -1 16]} :ways #{:carried}})]]
   :expect [{:event {:source :job :kind :waiting :data {:reason :need}} :within-s 20 :of-job true}
            {:no-event {:source :job :kind :completed :data {:planted [:>= 1]}} :for-s 20}]
   :after [[:block [10 0 16] "air"] [:block [13 0 16] "air"]]}
  {:name "no-seed-fetches-from-a-seen-chest"
   :body {:yaw 0}
   :blocks [[:fill [10 -1 16] [13 -1 16] "farmland[moisture=7]"] [:fill [10 -2 17] [13 -2 17] "stone"] [:fill [10 -1 17] [13 -1 17] "water"]
            [:set [8 0 16] "chest{Items:[{Slot:0b,id:\"minecraft:wheat_seeds\",count:10}]}"]]
   :act [[:job (jobs.farm.plant {:area {:min #xyz [10 -1 16] :max #xyz [13 -1 16]} :ignore-zones? true})]]
   :expect [{:event {:source :job :kind :completed :data {:planted 4 :status :completed}} :within-s 90 :of-job true}]
   :after [[:block [10 0 16] "wheat"] [:block [13 0 16] "wheat"]]}
  {:name "field-in-a-plan-footprint-stays-bare"
   :blocks [[:fill [10 -1 16] [13 -1 16] "farmland[moisture=7]"] [:fill [10 -2 17] [13 -2 17] "stone"] [:fill [10 -1 17] [13 -1 17] "water"]]
   :plans [{:id "other"
            :parts [{:id "field" :cells [#at [10 0 16] #at [11 0 16] #at [12 0 16] #at [13 0 16]] :want [:any "stone"]}]}]
   :body {:inventory [["wheat_seeds" 10]]}
   :act [[:job (jobs.farm.plant {:area {:min #xyz [10 -1 16] :max #xyz [13 -1 16]}})]]
   :expect [{:event {:source :job :kind :waiting :data {:reason :refused}} :within-s 20 :of-job true}
            {:no-event {:source :job :kind :completed :data {:planted [:>= 1]}} :for-s 20}]
   :after [[:block [10 0 16] "air"] [:item "wheat_seeds" 10]]}
  ;; Card df309ff7: two plans over the same cells. "mine" (the body's) wants wheat on x 10..13, "other" (someone else's)
  ;; claims x 12..15. The shared cells 12, 13 are left bare; the own cells 10, 11 are sown.
  ;; When every cell is shared the job never starts and waits :refused. :ignore-zones? sows the shared cells.
  {:name "overlapping-plans-sow-own-cells"
   :blocks [[:fill [10 -1 16] [15 -1 16] "farmland[moisture=7]"] [:fill [10 -2 17] [15 -2 17] "stone"] [:fill [10 -1 17] [15 -1 17] "water"]]
   :plans [{:id "mine" :metadata {:by "$body"}
            :parts [{:id "p" :cells [#at [10 0 16] #at [11 0 16] #at [12 0 16] #at [13 0 16]] :want {:crop "wheat"}}]}
           {:id "other" :metadata {:by "SomeoneElse"}
            :parts [{:id "p" :cells [#at [12 0 16] #at [13 0 16] #at [14 0 16] #at [15 0 16]] :want {:crop "wheat"}}]}]
   :body {:inventory [["wheat_seeds" 10]]}
   :act [[:job (jobs.farm.plant {:area {:plan "$plan:mine"}})]]
   :expect [{:event {:source :job :kind :completed} :within-s 60 :of-job true}]
   :after [[:block [10 0 16] "wheat"] [:block [11 0 16] "wheat"] [:block [12 0 16] "air"] [:block [13 0 16] "air"]
           [:block [14 0 16] "air"]]}
  {:name "all-cells-shared-with-another-plan-wait-and-never-start"
   :blocks [[:fill [10 -1 16] [11 -1 16] "farmland[moisture=7]"] [:fill [10 -2 17] [11 -2 17] "stone"] [:fill [10 -1 17] [11 -1 17] "water"]]
   :plans [{:id "mine" :metadata {:by "$body"}
            :parts [{:id "p" :cells [#at [10 0 16] #at [11 0 16]] :want {:crop "wheat"}}]}
           {:id "other" :metadata {:by "SomeoneElse"}
            :parts [{:id "p" :cells [#at [10 0 16] #at [11 0 16]] :want {:crop "wheat"}}]}]
   :body {:inventory [["wheat_seeds" 10]]}
   :act [[:job (jobs.farm.plant {:area {:plan "$plan:mine"}})]]
   :expect [{:event {:source :job :kind :waiting :data {:reason :refused}} :within-s 30 :of-job true}
            {:no-event {:source :job :kind :completed :data {:planted [:>= 1]}} :for-s 20}]
   :after [[:block [10 0 16] "air"] [:block [11 0 16] "air"] [:item "wheat_seeds" 10]]}
  {:name "ignore-zones-sows-cells-shared-with-another-plan"
   :blocks [[:fill [10 -1 16] [11 -1 16] "farmland[moisture=7]"] [:fill [10 -2 17] [11 -2 17] "stone"] [:fill [10 -1 17] [11 -1 17] "water"]]
   :plans [{:id "mine" :metadata {:by "$body"}
            :parts [{:id "p" :cells [#at [10 0 16] #at [11 0 16]] :want {:crop "wheat"}}]}
           {:id "other" :metadata {:by "SomeoneElse"}
            :parts [{:id "p" :cells [#at [10 0 16] #at [11 0 16]] :want {:crop "wheat"}}]}]
   :body {:inventory [["wheat_seeds" 10]]}
   :act [[:job (jobs.farm.plant {:area {:plan "$plan:mine"} :ignore-zones? true})]]
   :expect [{:event {:source :job :kind :completed :data {:planted 2 :status :completed}} :within-s 60 :of-job true}
            {:no-event {:source :job :kind :plant.declined} :for-s 20 :until {:source :job :kind :completed}}]
   :after [[:block [10 0 16] "wheat"] [:block [11 0 16] "wheat"]]}
  ;; Card 8e06be86: plan cells whose farmland dried back to dirt are named (:untilled), not "already sown"; two cells still carry wheat
  {:name "plan-over-dried-back-dirt-names-the-untilled-cells"
   :blocks [[:fill [10 -1 16] [11 -1 16] "farmland[moisture=7]"] [:fill [12 -1 16] [13 -1 16] "dirt"] [:fill [10 -2 17] [13 -2 17] "stone"]
            [:fill [10 -1 17] [13 -1 17] "water"] [:fill [10 0 16] [11 0 16] "wheat[age=3]"]]
   :plans [{:id "mine" :metadata {:by "$body"}
            :parts [{:id "p" :cells [#at [10 0 16] #at [11 0 16] #at [12 0 16] #at [13 0 16]] :want {:crop "wheat"}}]}]
   :body {:inventory [["wheat_seeds" 10]]}
   :act [[:job (jobs.farm.plant {:area {:plan "$plan:mine"}})]]
   :expect [{:event {:source :job :kind :waiting :data {:reason :nothing-to-do :untilled 2}} :within-s 30 :of-job true}
            {:no-event {:source :job :kind :completed :data {:status :completed}} :for-s 15}]
   :after [[:block [12 0 16] "air"] [:item "wheat_seeds" 10]]}
  ;; card b22e8b2c: carrots held back by the food reserve (20 carrots) are not "no seed": the run says :food-reserve and fetches nothing
  {:name "carrots-below-the-food-reserve-say-food-reserve"
   :blocks [[:fill [10 -1 16] [13 -1 16] "farmland[moisture=7]"] [:fill [10 -2 17] [13 -2 17] "stone"] [:fill [10 -1 17] [13 -1 17] "water"]]
   :body {:inventory [["carrot" 6]]}
   :act [[:job (jobs.farm.plant {:area {:min #xyz [10 -1 16] :max #xyz [13 -1 16]} :seed "carrot"})]]
   :expect [{:event {:source :job :kind :waiting :data {:reason :food-reserve}} :within-s 40 :of-job true}
            {:no-event {:source :job :kind :child_started :data {:slot :need}} :for-s 20}]
   :after [[:block [10 0 16] "air"] [:item "carrot" 6]]}
  {:name "carrots-above-the-food-reserve-are-sown"
   :blocks [[:fill [10 -1 16] [13 -1 16] "farmland[moisture=7]"] [:fill [10 -2 17] [13 -2 17] "stone"] [:fill [10 -1 17] [13 -1 17] "water"]]
   :body {:inventory [["carrot" 30]]}
   :act [[:job (jobs.farm.plant {:area {:min #xyz [10 -1 16] :max #xyz [13 -1 16]} :seed "carrot"})]]
   :expect [{:event {:source :job :kind :completed :data {:planted [:>= 3]}} :within-s 60 :of-job true}]
   :after [[:block [10 0 16] "carrots"]]}]}
