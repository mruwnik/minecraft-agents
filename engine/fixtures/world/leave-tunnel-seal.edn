;; jobs.access.leave-tunnel of an intact stair-down tunnel the body has looked at: it walks back to the entry and shuts the mouth (the dug
;; cells at the entry's floor that touch open air) with a jobs.blocks.fill-cells child per cell, with no escape stair.
;; Stone mass x 8..24, z 8..24, y 0..9 under open air (:time :any: the run reads no clock); a walkable four-step stair east from the entry [11 10 20].
{:defaults
 {:tags [:access :mining :jobs]
  :time :any
  :plot {:height 20}
  :blocks [[:fill [8 0 8] [24 9 24] "stone"]
           [:set [12 9 20] "air"] [:set [13 9 20] "air"] [:set [13 8 20] "air"] [:set [14 8 20] "air"]
           [:set [14 7 20] "air"] [:set [15 7 20] "air"] [:set [15 6 20] "air"]]
  :body {:at [15.5 6 20.5] :inventory [["cobblestone" 4] ["stone_pickaxe" 1]] :effects [["resistance" 600 4]]}
  :limit-s 200}
 :cases
 [{:name "intact-tunnel-walks-out-and-seals-the-mouth-through-fill-cells"
   :act [[:job (jobs.explore.look {:radius 8 :max-blocks 0 :max-entities 0})]
         [:await {:source :job :kind :completed} 60]
         [:job (jobs.access.leave-tunnel {:tunnel {:line {:entry #at [11 10 20] :heading :east :dir :down :steps 4 :run 0
                                                          :stand #at [15 6 20] :target #at [16 6 20]}
                                                   :dug [{:cell #at [12 9 20] :block "stone"} {:cell #at [13 9 20] :block "stone"}
                                                         {:cell #at [13 8 20] :block "stone"} {:cell #at [14 8 20] :block "stone"}
                                                         {:cell #at [14 7 20] :block "stone"} {:cell #at [15 7 20] :block "stone"}
                                                         {:cell #at [15 6 20] :block "stone"}]
                                                   :torches []}})]]
   :expect [{:event {:source :job :kind :child_ended :data {:slot :fill :ending {:kind :done}}} :within-s 150 :of-job true}
            {:event {:source :job :kind :completed :data {:name "jobs.access.leave-tunnel"}} :within-s 180}
            {:no-event {:source :job :kind :leave-tunnel.escape} :for-s 180 :until {:source :job :kind #{:completed :stopped}} :of-job true}]}]}
