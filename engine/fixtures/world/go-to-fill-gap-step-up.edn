;; A hut doorway whose sill was dug: a 1-cell hole in a tunnel floor with the floor one block higher beyond it (a jump up over a gap, which
;; the walker refuses). go-to fills the hole with a carried block and walks on. Stone mass x 2..30, z 14..18, y -3..3, tunnel 1x2 along z 16
;; from x 4 to x 16 (air y 0..3, high enough for the lifted jump), hole at x 16 (floor y -1, stone under it), then raised floor (stone y 0) and air y 1..4 from x 17 to x 28.
;; Should-succeed: dirt carried: fill-gap, arrived at the far end, the hole holds dirt. Nothing carried: no fill-gap, arrived by hand digging, the hole empty.
{:defaults
 {:tags [:movement :access]
  :time :any
  :plot {:height 10}
  :blocks [[:fill [2 -3 14] [30 5 18] "stone"] [:fill [4 0 16] [16 3 16] "air"] [:fill [17 1 16] [28 4 16] "air"] [:fill [16 -1 16] [16 -1 16] "air"]]
  :body {:at [5.5 0 16.5] :effects [["resistance" 600 4]]}
  :limit-s 120}
 :cases
 [{:name "dirt-carried-fills-the-hole-and-steps-up"
   :body {:inventory [["dirt" 5]]}
   :act [[:job (jobs.movement.go-to {:pos #at [27 1 16] :range 0})]]
   :expect [{:event {:source :job :kind :go-to.escalated :data {:step :fill-gap}} :within-s 60 :of-job true}
            {:event {:source :job :kind :completed :context {:chain [[:any]]} :data {:arrived true}} :within-s 100 :of-job true}]
   :after [[:block [16 -1 16] "dirt"] [:body-near [27.5 1 16.5] 2]]}
  {:name "nothing-to-fill-it-digs-round-and-arrives"
   :act [[:job (jobs.movement.go-to {:pos #at [27 1 16] :range 0})]]
   :expect [{:event {:source :job :kind :completed :context {:chain [[:any]]} :data {:arrived true}} :within-s 240 :of-job true}
            {:no-event {:source :job :kind :go-to.escalated :data {:step :fill-gap}} :for-s 240 :until {:source :job :kind :completed}}]
   :after [[:not-block [16 -1 16] "dirt"] [:body-near [27.5 1 16.5] 2]]
   :limit-s 250}]}
