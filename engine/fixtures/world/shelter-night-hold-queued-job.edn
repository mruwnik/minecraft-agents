;; jobs.survival.night holds a sleeping body (cards 79be43a4, a7a49680): the night job is a holder ((hold ...), as the :night trigger
;; is), so a queued go-to does not run while it is night; once the time is set to day the shelter ends and the go-to then completes.
;; Without hold the list is round-robin and the go-to gets a round between the shelter's rounds, by design.
;; The bed is in a closed hut (an open bed is not slept in, card 4e99ddb0). Night: run with --allow-time --time-log <the shared time log>. Another runner's day set during the 45 s makes the shelter end early (a fail not of the job).
{:defaults
 {:tags [:night :survival :shelter]
  :time :night-exclusive
  :blocks [[:set [4 0 4] "torch"] [:set [4 0 28] "torch"] [:set [28 0 4] "torch"] [:set [28 0 28] "torch"]
           [:set [16 0 4] "torch"] [:set [16 0 28] "torch"] [:set [4 0 16] "torch"] [:set [28 0 16] "torch"]
           [:fill [8 0 8] [16 3 16] "stone" :hollow] [:fill [9 0 9] [15 2 15] "air"]
           [:set [9 1 9] "torch"] [:set [15 1 15] "torch"]
           [:set [10 0 12] "red_bed[facing=east,part=foot]"] [:set [11 0 12] "red_bed[facing=east,part=head]"]]
  :body {:at [13.5 0 13.5] :effects [["resistance" 600 4]]}}
 :cases
 [{:name "queued-go-to-waits-for-day"
   :act [[:job (jobs.memory.set-place {:name :bed :pos #at [10 0 12]})]
         [:job (hold (jobs.survival.night {}))]
         [:await {:source :action :kind :done :data {:name "sleep" :status "sleeping"}} 60]
         [:wait-s 3]
         [:job (jobs.movement.go-to {:pos #xyz [14 0 10] :range 0})]
         [:wait-s 30]
         [:time-set 1000]]
   :expect [{:no-event {:source :job :kind :completed :data {:name "jobs.movement.go-to"}} :for-s 120 :until {:source :job :kind :completed :data {:name "jobs.survival.night"}}}
            {:event {:source :job :kind :completed :data {:name "jobs.movement.go-to"}} :within-s 120 :of-job true}]
   :after [[:body-near [14.5 0 10.5] 1.5]]
   :limit-s 160}
  ;; cards 0b44e1ac, 4252e02e: a queued craft whose table lies outside the hut, and a queued walk from a dug-in body, wait for day
  {:name "queued-craft-with-the-table-outside-waits-for-day"
   :blocks [[:set [20 0 12] "crafting_table"]]
   :body {:inventory [["oak_planks" 3] ["stick" 2]]}
   :act [[:job (jobs.memory.set-place {:name :bed :pos #at [10 0 12]})]
         [:job (hold (jobs.survival.night {}))]
         [:await {:source :action :kind :done :data {:name "sleep" :status "sleeping"}} 60]
         [:wait-s 3]
         [:job (jobs.items.craft {:item "wooden_pickaxe"})]
         [:wait-s 30]
         [:time-set 1000]]
   :expect [{:no-event {:source :job :kind :completed :data {:name "jobs.items.craft"}} :for-s 120 :until {:source :job :kind :completed :data {:name "jobs.survival.night"}}}
            {:event {:source :job :kind :completed :data {:name "jobs.items.craft"}} :within-s 160 :of-job true}]
   :after [[:item "wooden_pickaxe" 1]]
   :limit-s 200}
  {:name "queued-go-to-from-a-dug-in-body-waits-for-day"
   :blocks [[:fill [8 0 8] [16 3 16] "air"]]
   :body {:at [24.5 0 24.5] :inventory [["cobblestone" 16]]}
   :act [[:job (hold (jobs.survival.night {}))]
         [:await {:source :job :kind :dig-in.sealed} 60]
         [:wait-s 3]
         [:job (jobs.movement.go-to {:pos #xyz [24 0 8] :range 0})]
         [:wait-s 30]
         [:time-set 1000]]
   :expect [{:no-event {:source :job :kind :completed :data {:name "jobs.movement.go-to"}} :for-s 120 :until {:source :job :kind :completed :data {:name "jobs.survival.night"}}}
            {:event {:source :job :kind :completed :data {:name "jobs.movement.go-to"}} :within-s 200 :of-job true}]
   :after [[:body-near [24.5 0 8.5] 1.5]]
   :limit-s 240}]}
