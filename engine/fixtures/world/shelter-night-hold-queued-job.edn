;; jobs.survival.night holds a sleeping body (cards 79be43a4, a7a49680): the night job is a holder ((hold ...), as the :night trigger
;; is), so a queued go-to does not run while it is night; once the time is set to day the shelter ends and the go-to then completes.
;; Without hold the list is round-robin and the go-to gets a round between the shelter's rounds, by design.
;; Night: run with --allow-time --time-log <the shared time log>. Another runner's day set during the 45 s makes the shelter end early (a fail not of the job).
{:defaults
 {:tags [:night :survival :shelter]
  :time :night-exclusive
  :blocks [[:set [4 0 4] "torch"] [:set [4 0 28] "torch"] [:set [28 0 4] "torch"] [:set [28 0 28] "torch"]
           [:set [16 0 4] "torch"] [:set [16 0 28] "torch"] [:set [4 0 16] "torch"] [:set [28 0 16] "torch"]
           [:set [20 0 16] "red_bed[facing=east,part=foot]"] [:set [21 0 16] "red_bed[facing=east,part=head]"]]
  :body {:at [16.5 0 16.5] :effects [["resistance" 600 4]]}}
 :cases
 [{:name "queued-go-to-waits-for-day"
   :act [[:job (jobs.memory.set-place {:name :bed :pos #at [20 0 16]})]
         [:job (hold (jobs.survival.night {}))]
         [:await {:source :action :kind :done :data {:name "sleep" :status "sleeping"}} 60]
         [:wait-s 3]
         [:job (jobs.movement.go-to {:pos #xyz [8 0 16] :range 0})]
         [:wait-s 30]
         [:time-set 1000]]
   :expect [{:no-event {:source :job :kind :completed :data {:name "jobs.movement.go-to"}} :for-s 120 :until {:source :job :kind :completed :data {:name "jobs.survival.night"}}}
            {:event {:source :job :kind :completed :data {:name "jobs.movement.go-to"}} :within-s 120 :of-job true}]
   :after [[:body-near [8.5 0 16.5] 1.5]]
   :limit-s 160}]}
