;; Craft with a full pack: card c3193651 (a job that needs a slot makes room itself: tosses stacks worth less than a chest, else puts the rest in a chest
;; deposit puts down beside the body; the recipe's inputs and the chest are never tossed; a pack of tools has nothing to give and stops :full).
;; Open plot, body at [16.5 0 16.5]. 36 stacks: 35 full stacks of one item (a give of 1 each would merge into one slot) and an oak log to craft planks from.
;; Should-succeed: nugget pack crafts after tossing; raw-iron pack crafts after a chest is put down and none of it is tossed.
;; Should-fail: a pack of iron pickaxes stops :full; raw iron and no chest carried ends with the logs and raw iron kept and no chest made.
{:defaults
 {:tags [:items :storage :craft :jobs]
  :time :any
  :plot {:height 8}
  :body {:at [16.5 0 16.5] :yaw 270 :settle-s 2 :effects [["resistance" 600 4]]}
  :limit-s 150}
 :cases
 [{:name "full-pack-of-cheap-bits-tosses-for-the-craft"
   :body {:inventory [["iron_nugget" 64] ["iron_nugget" 64] ["iron_nugget" 64] ["iron_nugget" 64] ["iron_nugget" 64] ["iron_nugget" 64] ["iron_nugget" 64] ["iron_nugget" 64] ["iron_nugget" 64] ["iron_nugget" 64] ["iron_nugget" 64] ["iron_nugget" 64] ["iron_nugget" 64] ["iron_nugget" 64] ["iron_nugget" 64] ["iron_nugget" 64] ["iron_nugget" 64] ["iron_nugget" 64] ["iron_nugget" 64] ["iron_nugget" 64] ["iron_nugget" 64] ["iron_nugget" 64] ["iron_nugget" 64] ["iron_nugget" 64] ["iron_nugget" 64] ["iron_nugget" 64] ["iron_nugget" 64] ["iron_nugget" 64] ["iron_nugget" 64] ["iron_nugget" 64] ["iron_nugget" 64] ["iron_nugget" 64] ["iron_nugget" 64] ["iron_nugget" 64] ["iron_nugget" 64] ["oak_log" 1]]}
   :act [[:job (jobs.items.craft {:item "oak_planks" :count 4})]]
   :expect [{:event {:source :job :kind :completed} :within-s 120 :of-job true}]
   :after [[:item "oak_planks" [:>= 4]]]}
  {:name "full-pack-of-dear-stacks-puts-a-chest-down"
   :body {:inventory [["raw_iron" 64] ["raw_iron" 64] ["raw_iron" 64] ["raw_iron" 64] ["raw_iron" 64] ["raw_iron" 64] ["raw_iron" 64] ["raw_iron" 64] ["raw_iron" 64] ["raw_iron" 64] ["raw_iron" 64] ["raw_iron" 64] ["raw_iron" 64] ["raw_iron" 64] ["raw_iron" 64] ["raw_iron" 64] ["raw_iron" 64] ["raw_iron" 64] ["raw_iron" 64] ["raw_iron" 64] ["raw_iron" 64] ["raw_iron" 64] ["raw_iron" 64] ["raw_iron" 64] ["raw_iron" 64] ["raw_iron" 64] ["raw_iron" 64] ["raw_iron" 64] ["raw_iron" 64] ["raw_iron" 64] ["raw_iron" 64] ["raw_iron" 64] ["raw_iron" 64] ["raw_iron" 64] ["oak_log" 1] ["chest" 1]]}
   :act [[:job (jobs.items.craft {:item "oak_planks" :count 4})]]
   :expect [{:event {:source :job :kind :completed} :within-s 120 :of-job true}
            {:no-event {:source :job :kind :make-room.tossed} :for-s 100 :until {:source :job :kind :completed}}]
   :after [[:item "oak_planks" [:>= 4]] [:item "raw_iron" [:>= 1792]]]}
  {:name "full-pack-of-tools-stops-with-full"
   :body {:inventory [["iron_pickaxe" 1] ["iron_pickaxe" 1] ["iron_pickaxe" 1] ["iron_pickaxe" 1] ["iron_pickaxe" 1] ["iron_pickaxe" 1] ["iron_pickaxe" 1] ["iron_pickaxe" 1] ["iron_pickaxe" 1] ["iron_pickaxe" 1] ["iron_pickaxe" 1] ["iron_pickaxe" 1] ["iron_pickaxe" 1] ["iron_pickaxe" 1] ["iron_pickaxe" 1] ["iron_pickaxe" 1] ["iron_pickaxe" 1] ["iron_pickaxe" 1] ["iron_pickaxe" 1] ["iron_pickaxe" 1] ["iron_pickaxe" 1] ["iron_pickaxe" 1] ["iron_pickaxe" 1] ["iron_pickaxe" 1] ["iron_pickaxe" 1] ["iron_pickaxe" 1] ["iron_pickaxe" 1] ["iron_pickaxe" 1] ["iron_pickaxe" 1] ["iron_pickaxe" 1] ["iron_pickaxe" 1] ["iron_pickaxe" 1] ["iron_pickaxe" 1] ["iron_pickaxe" 1] ["iron_pickaxe" 1] ["oak_log" 1]]}
   :act [[:job (jobs.items.craft {:item "oak_planks" :count 4})]]
   :expect [{:event {:source :job :kind :stopped :data {:cause {:reason :full}}} :within-s 120 :of-job true}]}
  {:name "full-pack-of-dear-stacks-and-no-chest-makes-no-chest-from-the-logs"
   :body {:inventory [["raw_iron" 64] ["raw_iron" 64] ["raw_iron" 64] ["raw_iron" 64] ["raw_iron" 64] ["raw_iron" 64] ["raw_iron" 64] ["raw_iron" 64] ["raw_iron" 64] ["raw_iron" 64] ["raw_iron" 64] ["raw_iron" 64] ["raw_iron" 64] ["raw_iron" 64] ["raw_iron" 64] ["raw_iron" 64] ["raw_iron" 64] ["raw_iron" 64] ["raw_iron" 64] ["raw_iron" 64] ["raw_iron" 64] ["raw_iron" 64] ["raw_iron" 64] ["raw_iron" 64] ["raw_iron" 64] ["raw_iron" 64] ["raw_iron" 64] ["raw_iron" 64] ["raw_iron" 64] ["raw_iron" 64] ["raw_iron" 64] ["raw_iron" 64] ["raw_iron" 64] ["raw_iron" 64] ["raw_iron" 64] ["oak_log" 4]]}
   :act [[:job (jobs.items.craft {:item "oak_planks" :count 4})]]
   :expect [{:event {:source :job :kind :stopped :data {:cause {:reason :full}}} :within-s 120 :of-job true}]
   :after [[:item "oak_log" [:>= 4]] [:item "raw_iron" [:>= 2240]] [:item "chest" [:<= 0]]]}]}
