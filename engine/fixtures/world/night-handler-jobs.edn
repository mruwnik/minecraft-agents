;; One night handler, live cases that fit a fixture (card 3db292e6): jobs.survival.night is submitted as a job in :act (the
;; runner starts the body with its register before the time and the plot are set, so a registered :night trigger fires in the
;; empty air at the stale start position and holds :exposed; the trigger's condition is covered by unit tests). Two-body cases
;; (a sleeping second body: log-out stints, sleep-status count, occupied bed, sleeper behind a wall) are hand-run.
;; Needs night: run with --allow-time --time-log <the shared time log>. Hut: stone shell x 8..16, z 8..16, roof y 3.
{:defaults
 {:tags [:night :survival :sleep]
  :time :night-exclusive
  :blocks [[:fill [8 0 8] [16 3 16] "stone" :hollow] [:fill [9 0 9] [15 2 15] "air"]
           [:set [9 1 9] "torch"] [:set [15 1 15] "torch"]]
  :body {:at [13.5 0 13.5] :effects [["resistance" 600 4]] :settle-s 2}}
 :cases
 [{:name "remembered-bed-out-of-sight-walked-to-and-slept"
   :blocks [[:fill [2 0 2] [28 3 28] "stone" :hollow] [:fill [3 0 3] [27 2 27] "air"]
            [:set [3 1 3] "torch"] [:set [27 1 27] "torch"] [:set [14 1 14] "torch"] [:set [20 1 14] "torch"]
            [:set [16 0 14] "red_bed[facing=east,part=foot]"] [:set [17 0 14] "red_bed[facing=east,part=head]"]]
   :body {:at [6.5 0 14.5]}
   :act [[:job (jobs.memory.set-place {:name :bed :pos #at [16 0 14]}) [:now]]
         [:job (jobs.survival.night)]]
   :expect [{:event {:source :action :kind :done :data {:name "sleep" :status "sleeping"}} :within-s 60}
            {:no-event {:source :action :kind :done :data {:name "place"}} :for-s 60 :until {:source :action :kind :done :data {:name "sleep" :status "sleeping"}}}]
   :after [[:body-near [16.5 0 14.5] 4]]
   :limit-s 80}
  ;; Sleeping in the put-down bed makes it the respawn bed (:spawn-bed), so it stays at day. The spawn point starts elsewhere:
  ;; the server says "Respawn point set" only when it changes, and an earlier case may have slept on this cell.
  {:name "carried-bed-outside-own-zone-slept-in-is-kept-at-day"
   :body {:spawnpoint [2 0 2]}
   :act [[:rcon "give $BODY red_bed 1"]
         [:job (jobs.survival.night)]
         [:await {:source :action :kind :done :data {:name "sleep" :status "sleeping"}} 60]
         [:until-rcon "data get entity $BODY SleepTimer" "data: (6[0-9]|[7-9][0-9]|[0-9]{3})s" 10]
         [:time-set 1000]]
   :expect [{:event {:source :action :kind :done :data {:name "place" :status "placed"}} :within-s 60}
            {:event {:source :action :kind :done :data {:name "sleep" :status "sleeping"}} :within-s 60}
            {:event {:source :job :kind :completed :data {:name "jobs.survival.night"}} :within-s 120 :of-job true}]
   :after [[:item "red_bed" 0] [:memory {:entries {:spawn-bed [{:data {:pos [:any]}}]}}]]
   :limit-s 150}
  {:name "occupied-remembered-bed-is-refused"
   :blocks [[:set [10 0 12] "red_bed[facing=east,part=foot,occupied=true]"] [:set [11 0 12] "red_bed[facing=east,part=head,occupied=true]"]]
   :act [[:job (jobs.memory.set-place {:name :bed :pos #at [10 0 12]}) [:now]]
         [:job (jobs.survival.sleep {:bed #at [10 0 12]})]]
   :expect [{:no-event {:source :action :kind :started :data {:name "sleep"}} :for-s 30}
            {:event {:source :job :kind :holding :data {:reason :bed-occupied}} :within-s 30 :of-job true}]
   :after [[:body-near [13.5 0 13.5] 1.5]]
   :limit-s 50}
  ;; card f2e89864: a stale :bed place far away does not beat the near home and spawn bed: the body sleeps in the hut bed, no night.bed-too-far
  {:name "stale-far-bed-place-with-a-near-spawn-bed-sleeps-in-the-hut"
   :blocks [[:set [10 0 12] "red_bed[facing=east,part=foot]"] [:set [11 0 12] "red_bed[facing=east,part=head]"]]
   :body {:at [13.5 0 13.5] :spawnpoint [10 0 12]}
   :act [[:job (jobs.memory.set-place {:name :bed :pos #at [400 0 400]}) [:now]]
         [:job (jobs.memory.set-place {:name :home :pos #at [13 0 13]}) [:now]]
         [:job (jobs.survival.night)]
         [:await {:source :action :kind :done :data {:name "sleep" :status "sleeping"}} 90]]
   :expect [{:event {:source :action :kind :done :data {:name "sleep" :status "sleeping"}} :within-s 90}
            {:no-event {:source :job :kind :night.bed-too-far} :for-s 90 :until {:source :action :kind :done :data {:name "sleep" :status "sleeping"}}}
            {:no-event {:source :job :kind :shut-in.sealed} :for-s 90 :until {:source :action :kind :done :data {:name "sleep" :status "sleeping"}}}]
   :after [[:body-near [10.5 0 12.5] 4]]
   :limit-s 110}]}
