;; Card a333e337 (5363e675's seeded drop-route): collect-drops :dig to a drop 22 blocks down in stone. A shaft [16 9..29 16] cut from the
;; rim shows the drop at the cave cell [17 8 16] at its foot. Stone mass x 8..24, z 8..24, y 0..29; the body stands beside the shaft on the
;; rim [15.5 30 16.5] with a pickaxe, and first looks down the shaft (:until-seen stone) so the walls and rim are remembered stone and the
;; route is planned through known rock. The search CPU is not an event: the first dig starting within 30 s of the job (a proof of seconds to
;; minutes would not) is the timing check; the whole trip is bounded from speeds: ~44 stair cells of stone at a stone pickaxe's ~0.6 s plus
;; walking is about 60 s, doubled to 120.
;; Should-succeed: a dig starts and the diamonds are collected. Should-fail: the same drop without :dig is left (collect-drops.left :too-deep or
;; :unreachable) and nothing is dug.
{:defaults
 {:tags [:forestry :collect-drops :mining :survival]
  :time :any
  :plot {:height 40}
  :blocks [[:fill [8 0 8] [24 29 24] "stone"] [:fill [16 9 16] [16 29 16] "air"] [:fill [17 8 16] [17 9 16] "air"] [:set [16 8 16] "air"]]
  :body {:at [15.5 30 16.5] :inventory [["stone_pickaxe" 1] ["torch" 16]] :effects [["resistance" 600 4]]}
  :limit-s 240}
 :cases
 [{:name "drop-22-down-is-dug-to-with-dig"
   :act [[:summon "item" [17.5 8.2 16.5] "{Item:{id:\"minecraft:diamond\",count:8}}"]
         [:until-seen {:block "stone" :min 30} 15]
         [:job (jobs.items.collect-drops {:worth 1200 :radius 30 :holes [#at [16 29 16]] :dig true})]]
   :expect [{:event {:source :action :kind :started :data {:name "dig"}} :within-s 30 :of-job true}
            {:event {:source :job :kind :completed} :within-s 120 :of-job true}]
   :after [[:item "diamond" 8]]}
  {:name "drop-22-down-without-dig-is-left"
   :act [[:summon "item" [17.5 8.2 16.5] "{Item:{id:\"minecraft:diamond\",count:8}}"]
         [:until-seen {:block "stone" :min 30} 15]
         [:job (jobs.items.collect-drops {:worth 1200 :radius 30 :holes [#at [16 29 16]]})]]
   :expect [{:event {:source :job :level :debug :kind :collect-drops.left :data {:reason #{:too-deep :unreachable}}} :within-s 60 :of-job true}
            {:event {:source :job :kind #{:completed :stopped}} :within-s 100 :of-job true}
            {:no-event {:source :action :kind :started :data {:name "dig"}} :for-s 90 :until {:source :job :kind #{:completed :stopped}}}]
   :after [[:item "diamond" 0]]
   :limit-s 120}]}
