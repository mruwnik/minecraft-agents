;; Card bc302253: a body shut in its own gateless fence pen with cows (an own plan's area) gets out: no stair steps onto the 1.5-high fence,
;; so go-to digs one fence block, walks out and puts it back (go-to.restored). Fence ring x 20..26, z 10..16; the body in its corner.
;; Should-succeed: arrives at the goal outside, the fence is whole again and both cows stay inside.
{:defaults
 {:tags [:movement :access :animals]
  :time :any
  :plot {:height 8 :floor "grass_block"}
  :blocks [[:fill [20 0 10] [26 0 10] "oak_fence"] [:fill [20 0 16] [26 0 16] "oak_fence"]
           [:fill [20 0 11] [20 0 15] "oak_fence"] [:fill [26 0 11] [26 0 15] "oak_fence"]]
  :plans [{:id "area" :metadata {:by "$body"} :parts [{:id "inside" :box [#at [8 0 8] #at [27 3 21]] :want [:any "air"]}]}]
  :body {:at [21.5 0 11.5] :inventory [["cobblestone" 4]] :effects [["resistance" 600 4]]}
  :limit-s 150}
 :cases
 [{:name "cows-in-the-pen-fence-cut-and-mended"
   :act [[:summon "cow" [23.5 0 13.5] "{PersistenceRequired:1b}"]
         [:summon "cow" [24.5 0 14.5] "{PersistenceRequired:1b}"]
         [:until [:cli "entities" ["$body" "--world" "$world" "--type" "cow"] {:total 2}] 10]
         [:job (jobs.movement.go-to {:pos #at [14 0 13] :range 1})]]
   :expect [{:event {:source :job :kind :go-to.restored} :within-s 120 :of-job true}
            {:event {:source :job :kind :completed :context {:chain [[:any]]} :data {:arrived true}} :within-s 120 :of-job true}]
   :after [[:body-near [14.5 0 13.5] 2] [:block [20 0 11] "oak_fence"] [:block [21 0 10] "oak_fence"] [:entities "type=cow,tag=wt" [[21 0 11] [25 2 15]] 2]]}]}
