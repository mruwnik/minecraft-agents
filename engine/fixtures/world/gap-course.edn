;; Card a3418585: gap jumps over 2 or 3 cells need a sprint (food > 6). One-wide stone strip along x at z 10, pit floor at y -10 (the air is dug explicitly: the terrain under the plot may be solid, which let a body walk down and up across a gap).
;; Food 20 arrives over a 3 or level 2 gap; food <= 6 (hunger effect, then cleared) walks round when a detour exists, else stops
;; without jumping (:gap-sprint / :abilities); a 1 gap is still jumped. gap2-food6-level (no detour): refused like a 3 gap.
{:defaults
 {:tags [:movement]
  :time :any
  :plot {:height 12 :floor "air"}
  :body {:at [6.5 0 10.5]}
  :limit-s 90}
 :cases
 [ {:name "gap3-food20"
   :blocks [[:fill [3 -9 3] [26 -2 17] "air"] [:fill [3 -10 3] [26 -10 17] "stone"] [:fill [4 -1 10] [8 -1 10] "stone"] [:fill [12 -1 10] [16 -1 10] "stone"]]
   :act [[:job (jobs.movement.go-to {:pos #at [15 0 10] :range 0 :escalate false})]]
   :expect [{:event {:source :job :kind :result :context {:chain [[:any]]} :data {:arrived true}} :within-s 60 :of-job true}]
   :after [[:body-near [15.5 0 10.5] 1.5]]}
 {:name "gap2-food20"
   :blocks [[:fill [3 -9 3] [26 -2 17] "air"] [:fill [3 -10 3] [26 -10 17] "stone"] [:fill [4 -1 10] [8 -1 10] "stone"] [:fill [11 -1 10] [15 -1 10] "stone"]]
   :act [[:job (jobs.movement.go-to {:pos #at [14 0 10] :range 0 :escalate false})]]
   :expect [{:event {:source :job :kind :result :context {:chain [[:any]]} :data {:arrived true}} :within-s 60 :of-job true}]
   :after [[:body-near [14.5 0 10.5] 1.5]]}
 {:name "gap1-food20"
   :blocks [[:fill [3 -9 3] [26 -2 17] "air"] [:fill [3 -10 3] [26 -10 17] "stone"] [:fill [4 -1 10] [8 -1 10] "stone"] [:fill [10 -1 10] [14 -1 10] "stone"]]
   :act [[:job (jobs.movement.go-to {:pos #at [13 0 10] :range 0 :escalate false})]]
   :expect [{:event {:source :job :kind :result :context {:chain [[:any]]} :data {:arrived true}} :within-s 60 :of-job true}]
   :after [[:body-near [13.5 0 10.5] 1.5]]}
 {:name "gap3-food6-way-round"
   :blocks [[:fill [3 -9 3] [26 -2 17] "air"] [:fill [3 -10 3] [26 -10 17] "stone"] [:fill [4 -1 10] [8 -1 10] "stone"] [:fill [12 -1 10] [16 -1 10] "stone"] [:fill [8 -1 11] [8 -1 12] "stone"] [:fill [9 -1 12] [12 -1 12] "stone"] [:set [12 -1 11] "stone"]]
   :act [[:rcon "effect give $BODY minecraft:hunger 8 255 true"] [:wait-s 9] [:rcon "effect clear $BODY"] [:job (jobs.movement.go-to {:pos #at [15 0 10] :range 0 :escalate false})]]
   :expect [{:event {:source :job :kind :result :context {:chain [[:any]]} :data {:arrived true}} :within-s 60 :of-job true}]
   :after [[:body-near [15.5 0 10.5] 1.5]]}
 {:name "gap3-food6-no-way-round"
   :blocks [[:fill [3 -9 3] [26 -2 17] "air"] [:fill [3 -10 3] [26 -10 17] "stone"] [:fill [4 -1 10] [8 -1 10] "stone"] [:fill [12 -1 10] [16 -1 10] "stone"]]
   :act [[:rcon "effect give $BODY minecraft:hunger 8 255 true"] [:wait-s 9] [:rcon "effect clear $BODY"] [:job (jobs.movement.go-to {:pos #at [15 0 10] :range 0 :escalate false})]]
   :expect [{:event {:source :job :kind :result :context {:chain [[:any]]} :data {:arrived false}} :within-s 60 :of-job true}]
   :after [[:body-near [7.5 0 10.5] 4]]}
 {:name "gap2-food6-level"
   :blocks [[:fill [3 -9 3] [26 -2 17] "air"] [:fill [3 -10 3] [26 -10 17] "stone"] [:fill [4 -1 10] [8 -1 10] "stone"] [:fill [11 -1 10] [15 -1 10] "stone"]]
   :act [[:rcon "effect give $BODY minecraft:hunger 8 255 true"] [:wait-s 9] [:rcon "effect clear $BODY"] [:job (jobs.movement.go-to {:pos #at [14 0 10] :range 0 :escalate false})]]
   :expect [{:event {:source :job :kind :result :context {:chain [[:any]]} :data {:arrived false}} :within-s 60 :of-job true}]
   :after [[:body-near [7.5 0 10.5] 4]]}
 {:name "gap1-food6"
   :blocks [[:fill [3 -9 3] [26 -2 17] "air"] [:fill [3 -10 3] [26 -10 17] "stone"] [:fill [4 -1 10] [8 -1 10] "stone"] [:fill [10 -1 10] [14 -1 10] "stone"]]
   :act [[:rcon "effect give $BODY minecraft:hunger 8 255 true"] [:wait-s 9] [:rcon "effect clear $BODY"] [:job (jobs.movement.go-to {:pos #at [13 0 10] :range 0 :escalate false})]]
   :expect [{:event {:source :job :kind :result :context {:chain [[:any]]} :data {:arrived true}} :within-s 60 :of-job true}]
   :after [[:body-near [13.5 0 10.5] 1.5]]}]}
