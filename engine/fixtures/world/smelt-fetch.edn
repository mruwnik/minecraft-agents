;; jobs.items.smelt fetches what it lacks and names unsmeltable items: cards 653b6e00 (furnace crafted and placed from a carried
;; table + cobblestone when none is seen), 95dd208b (a product name loads its input, a furnace 10 blocks off is found), 0067c85b
;; (a carried furnace is placed), 456e1e50 (a furnace still cooking an abandoned load is waited for, the output taken, then loaded).
;; Open plot, body at [16.5 0 16.5] looking east (yaw 270).
;; Should-succeed: ingots from a crafted furnace, cooked chicken by product name, ingots from a placed carried furnace, iron after the copper.
;; Cases that need no furnace seen set a small seen-radius and chest-radius: the pool runs neighbouring plots at once and their furnaces and chests are in sight.
;; Should-fail: :ways #{:carried} with no furnace seen gives up no-furnace-seen; a diamond is no input (not-smeltable).
{:defaults
 {:tags [:items :smelt :fetch :jobs]
  :time :any
  :plot {:height 8}
  :body {:at [16.5 0 16.5] :yaw 270 :settle-s 2 :effects [["resistance" 600 4]]}
  :limit-s 150}
 :cases
 [{:name "no-furnace-seen-crafts-and-places-one"
   :settings {:jobs.items.smelt/seen-radius 12 :jobs.lib.stock/chest-radius 12}
   :body {:inventory [["raw_iron" 2] ["coal" 2] ["crafting_table" 1] ["cobblestone" 16]]}
   :act [[:job (jobs.items.smelt {:item "raw_iron" :count 2})]]
   :expect [{:event {:source :job :kind :completed :data {:smelted 2}} :within-s 140 :of-job true}]
   :after [[:item "iron_ingot" 2]]}
  ;; 2d299045: no furnace in sight, none can be made (no cobblestone, no table, no logs): the remembered furnace 36 blocks off is walked to
  {:name "remembered-furnace-beyond-sight-is-walked-to-when-none-can-be-made"
   :plot {:height 8 :length 64 :width 32}
   :settings {:jobs.items.smelt/seen-radius 12 :jobs.lib.stock/chest-radius 12}
   :blocks [[:set [40 0 16] "furnace[facing=west]"]]
   :memory [{:kind :furnace :data {:pos #xyz [40 0 16]} :policy {:cap 1 :ttl :forever}}]
   :body {:at [4.5 0 16.5] :inventory [["raw_iron" 2] ["coal" 2]]}
   :act [[:job (jobs.items.smelt {:item "raw_iron" :count 2})]]
   :expect [{:event {:source :job :kind :completed :data {:smelted 2}} :within-s 140 :of-job true}
            {:no-event {:source :job :kind :stopped :data {:reason :no-furnace-seen}} :for-s 15 :of-job true :until {:source :job :kind :completed}}]
   :after [[:item "iron_ingot" 2]]
   :limit-s 160}
  {:name "carried-only-no-furnace-seen-gives-up"
   :settings {:jobs.items.smelt/seen-radius 12 :jobs.lib.stock/chest-radius 12}
   :body {:inventory [["raw_iron" 2] ["coal" 2] ["crafting_table" 1] ["cobblestone" 16]]}
   :act [[:job (jobs.items.smelt {:item "raw_iron" :count 2 :ways #{:carried}})]]
   :expect [{:event {:source :job :kind :stopped :data {:reason :no-furnace-seen}} :within-s 30 :of-job true}
            {:no-event {:source :job :kind :completed} :for-s 15 :of-job true :until {:source :job :kind :stopped}}]
   :after [[:item "iron_ingot" 0] [:item "raw_iron" 2]]
   :limit-s 50}
  {:name "product-name-cooks-its-input-in-a-furnace-ten-off"
   :blocks [[:set [26 0 16] "furnace[facing=west]"]]
   :body {:inventory [["chicken" 2] ["coal" 2]]}
   :act [[:job (jobs.items.smelt {:item "cooked_chicken" :count 2})]]
   :expect [{:event {:source :job :kind :completed :data {:smelted 2}} :within-s 100 :of-job true}
            {:no-event {:source :job :kind :stopped :data {:reason :no-furnace-seen}} :for-s 15 :of-job true :until {:source :job :kind :completed}}]
   :after [[:item "cooked_chicken" 2]]}
  {:name "diamond-is-no-input"
   :blocks [[:set [26 0 16] "furnace[facing=west]"]]
   :body {:inventory [["diamond" 2] ["coal" 2]]}
   :act [[:job (jobs.items.smelt {:item "diamond"})]]
   :expect [{:event {:source :job :kind :stopped :data {:reason :not-smeltable}} :within-s 30 :of-job true}]
   :after [[:item "diamond" 2]]
   :limit-s 50}
  {:name "carried-furnace-is-placed-and-used"
   :body {:inventory [["furnace" 1] ["raw_iron" 2] ["coal" 2]]}
   :act [[:job (jobs.items.smelt {:item "raw_iron" :count 2})]]
   :expect [{:event {:source :job :kind :completed :data {:smelted 2}} :within-s 140 :of-job true}
            {:no-event {:source :job :kind :stopped :data {:reason :no-furnace-seen}} :for-s 15 :of-job true :until {:source :job :kind :completed}}]
   :after [[:item "iron_ingot" 2]]}
  {:name "carried-furnace-is-put-down-rather-than-walking-to-a-far-seen-one"
   :plot {:height 8 :length 64 :width 32}
   :blocks [[:set [46 0 16] "furnace[facing=west]"]]
   :body {:inventory [["furnace" 1] ["raw_iron" 2] ["coal" 2]]}
   :act [[:job (jobs.items.smelt {:item "raw_iron" :count 2})]]
   :expect [{:event {:source :job :kind :completed :data {:smelted 2}} :within-s 140 :of-job true}]
   :after [[:item "iron_ingot" 2] [:body-near [16.5 0 16.5] 8]]}
  {:name "furnace-still-cooking-copper-is-waited-for-then-iron-loaded"
   :blocks [[:set [20 0 14] "furnace[facing=west,lit=true]{BurnTime:1600s,CookTime:0s,CookTimeTotal:200s,Items:[{Slot:0b,id:\"minecraft:raw_copper\",count:3},{Slot:1b,id:\"minecraft:coal\",count:2}]}"]]
   :body {:inventory [["raw_iron" 2] ["coal" 2]]}
   :act [[:job (jobs.items.smelt {:furnace #xyz [20 0 14] :item "raw_iron" :count 2})]]
   :expect [{:event {:source :job :kind :completed :data {:smelted 2}} :within-s 140 :of-job true}
            {:no-event {:source :job :kind :stopped :data {:reason :furnace-busy}} :for-s 20 :of-job true :until {:source :job :kind :completed}}]
   :after [[:item "iron_ingot" 2] [:item "copper_ingot" 3]]}
  ;; card 8b9e64e4: no coal anywhere, only birch seen/carried: any wood burns
  {:name "carried-birch-logs-are-the-fuel"
   :blocks [[:set [26 0 16] "furnace[facing=west]"]]
   :body {:inventory [["raw_iron" 2] ["birch_log" 4]]}
   :act [[:job (jobs.items.smelt {:item "raw_iron" :count 2})]]
   :expect [{:event {:source :job :kind :completed :data {:smelted 2}} :within-s 140 :of-job true}
            {:no-event {:source :job :kind :stopped :data {:reason :no-fuel}} :for-s 15 :of-job true :until {:source :job :kind :completed}}]
   :after [[:item "iron_ingot" 2]]}
  {:name "birch-planks-from-a-seen-chest-are-the-fuel"
   :blocks [[:set [26 0 16] "furnace[facing=west]"]
            [:set [20 0 12] "chest[facing=south]{Items:[{Slot:0b,id:\"minecraft:birch_planks\",count:8}]}"]]
   :memory [{:kind :chest :data {:pos #xyz [20 0 12]} :policy {:cap 1 :ttl :forever}}]
   :body {:inventory [["raw_iron" 2]]}
   :act [[:job (jobs.items.smelt {:item "raw_iron" :count 2})]]
   :expect [{:event {:source :job :kind :completed :data {:smelted 2}} :within-s 140 :of-job true}]
   :after [[:item "iron_ingot" 2]]}
  ;; card f23d925d: an :item list cooks each raw food named
  {:name "an-item-list-cooks-each-raw-food"
   :blocks [[:set [26 0 16] "furnace[facing=west]"]]
   :body {:inventory [["chicken" 2] ["beef" 2] ["coal" 2]]}
   :act [[:job (jobs.items.smelt {:item ["chicken" "beef"]})]]
   :expect [{:event {:source :job :kind :completed} :within-s 130 :of-job true}]
   :after [[:item "cooked_chicken" 2] [:item "cooked_beef" 2]]
   :limit-s 150}
  ;; card 51c89177: the furnace comes first; when none can be had the logs are still logs (no planks made for fuel first)
  {:name "charcoal-with-no-furnace-to-be-had-leaves-the-logs"
   :settings {:jobs.items.smelt/seen-radius 12 :jobs.lib.stock/chest-radius 12}
   :body {:inventory [["oak_log" 11]]}
   :act [[:job (jobs.items.smelt {:item "charcoal" :count 3 :ways #{:carried :chest}})]]
   :expect [{:event {:source :job :kind :stopped :data {:reason :no-furnace-seen}} :within-s 40 :of-job true}
            {:no-event {:source :job :kind :completed} :for-s 15 :of-job true :until {:source :job :kind :stopped}}]
   :after [[:item "oak_log" 11] [:item "oak_planks" 0] [:item "charcoal" 0]]
   :limit-s 60}
  {:name "charcoal-makes-its-furnace-from-mined-cobble-first"
   :settings {:jobs.items.smelt/seen-radius 12 :jobs.lib.stock/chest-radius 12}
   :blocks [[:fill [22 0 12] [24 2 20] "stone"]]
   :body {:inventory [["oak_log" 11] ["stone_pickaxe" 1] ["crafting_table" 1]]}
   :act [[:job (jobs.items.smelt {:item "charcoal" :count 1})]]
   :expect [{:event {:source :job :kind :completed :data {:smelted 1}} :within-s 200 :of-job true}]
   :after [[:item "charcoal" 1]]
   :limit-s 230}
  ;; card 27f9ef18: a furnace 8 behind the body is not in its first sight; smelt's start check answers :look, the body looks round,
  ;; finds the furnace and uses it, so the carried cobblestone is not made into a second one.
  {:name "furnace-behind-the-body-is-looked-for-and-used-not-made-anew"
   :settings {:jobs.items.smelt/seen-radius 12 :jobs.lib.stock/chest-radius 12}
   :blocks [[:set [8 0 16] "furnace[facing=east]"]]
   :body {:inventory [["raw_iron" 2] ["coal" 2] ["crafting_table" 1] ["cobblestone" 16]]}
   :act [[:job (jobs.items.smelt {:item "raw_iron" :count 2})]]
   :expect [{:event {:source :job :kind :completed :data {:smelted 2}} :within-s 100 :of-job true}]
   :after [[:item "iron_ingot" 2] [:item "cobblestone" 16]]}
 ;; card 60655c1d: at night a seen furnace in the dark 12 blocks off is not walked to; the lit body makes its own from carried cobblestone
  {:name "night-dark-far-furnace-is-passed-over-for-an-own-one"
   :plot {:light :dark}
   :settings {:jobs.items.smelt/seen-radius 16 :jobs.lib.stock/chest-radius 12}
   :blocks [[:set [28 0 16] "furnace[facing=west]"] [:set [14 0 14] "torch"] [:set [14 0 18] "torch"] [:set [18 0 14] "torch"] [:set [18 0 18] "torch"]]
   :body {:inventory [["raw_iron" 2] ["coal" 2] ["crafting_table" 1] ["cobblestone" 16]]}
   :act [[:job (jobs.items.smelt {:item "raw_iron" :count 2})]]
   :expect [{:event {:source :job :kind :completed :data {:smelted 2}} :within-s 140 :of-job true}
            {:no-event {:source :job :kind :waiting :data {:reason :exposed}} :for-s 20 :of-job true :until {:source :job :kind :completed}}]
   :after [[:item "iron_ingot" 2]]}]}
