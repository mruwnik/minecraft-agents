;; Cards 275c66b0 (and 8397ad3f in access-pickaxe-tools.edn): a stair that digs with a full pack supplies its own room. A pack of 35 stacks
;; of junk (tuff, dirt) and the pickaxe: the stair calls make-room (make-room.tossed) and goes on to its 6 steps. Should-fail: a
;; pack of diamonds only has nothing to toss and waits :no-free-slot (does not end); with :make-room false the junk pack waits too, nothing is tossed.
;; Rock x 10..30, z 12..20, y 0..10 (deepslate); the body in a 1x3 cell at [16 0 16] with a stone pickaxe, an open tunnel running west from it (make-room throws nothing walled in).
{:defaults
 {:tags [:access :storage :jobs] :time :any
  :plot {:height 14}
  :blocks [[:fill [10 0 12] [30 10 20] "deepslate"] [:fill [12 0 16] [16 2 16] "air"]]
  :body {:at [16.5 0 16.5] :effects [["resistance" 600 4]]}
  :limit-s 200}
 :cases
 [{:name "full-pack-of-junk-is-made-room-in-and-the-stair-goes-on"
   :body {:inventory [["stone_pickaxe" 1] ["tuff" 64] ["tuff" 64] ["tuff" 64] ["tuff" 64] ["tuff" 64] ["tuff" 64] ["tuff" 64] ["tuff" 64] ["tuff" 64] ["tuff" 64] ["tuff" 64] ["tuff" 64] ["tuff" 64] ["tuff" 64] ["tuff" 64] ["tuff" 64] ["tuff" 64] ["dirt" 64] ["dirt" 64] ["dirt" 64] ["dirt" 64] ["dirt" 64] ["dirt" 64] ["dirt" 64] ["dirt" 64] ["dirt" 64] ["dirt" 64] ["dirt" 64] ["dirt" 64] ["dirt" 64] ["dirt" 64] ["dirt" 64] ["dirt" 64] ["dirt" 64] ["dirt" 64]]}
   :act [[:job (jobs.access.stair {:dir :up :heading :east :steps 6})]]
   :expect [{:event {:source :job :kind :make-room.tossed} :within-s 150 :of-job true}
            {:event {:source :job :kind :completed} :within-s 190 :of-job true}
            {:no-event {:source :job :kind :stopped :data {:kind :condition-failed :reason :no-free-slot}} :for-s 150 :until {:source :job :kind :make-room.tossed}}]
   :after [[:not-block [17 1 16] "deepslate"]]}
  {:name "full-pack-of-diamonds-waits-no-free-slot"
   :body {:inventory [["stone_pickaxe" 1] ["diamond" 64] ["diamond" 64] ["diamond" 64] ["diamond" 64] ["diamond" 64] ["diamond" 64] ["diamond" 64] ["diamond" 64] ["diamond" 64] ["diamond" 64] ["diamond" 64] ["diamond" 64] ["diamond" 64] ["diamond" 64] ["diamond" 64] ["diamond" 64] ["diamond" 64] ["diamond" 64] ["diamond" 64] ["diamond" 64] ["diamond" 64] ["diamond" 64] ["diamond" 64] ["diamond" 64] ["diamond" 64] ["diamond" 64] ["diamond" 64] ["diamond" 64] ["diamond" 64] ["diamond" 64] ["diamond" 64] ["diamond" 64] ["diamond" 64] ["diamond" 64] ["diamond" 64]]}
   :act [[:job (jobs.access.stair {:dir :up :heading :east :steps 6})]]
   :expect [{:no-event {:source :job :kind :stopped} :for-s 100 :of-job true}
            {:no-event {:source :job :kind :make-room.tossed} :for-s 100}]
   :after [[:item "diamond" 2240]]
   :limit-s 130}
  {:name "make-room-false-junk-pack-waits-nothing-tossed"
   :body {:inventory [["stone_pickaxe" 1] ["tuff" 64] ["tuff" 64] ["tuff" 64] ["tuff" 64] ["tuff" 64] ["tuff" 64] ["tuff" 64] ["tuff" 64] ["tuff" 64] ["tuff" 64] ["tuff" 64] ["tuff" 64] ["tuff" 64] ["tuff" 64] ["tuff" 64] ["tuff" 64] ["tuff" 64] ["dirt" 64] ["dirt" 64] ["dirt" 64] ["dirt" 64] ["dirt" 64] ["dirt" 64] ["dirt" 64] ["dirt" 64] ["dirt" 64] ["dirt" 64] ["dirt" 64] ["dirt" 64] ["dirt" 64] ["dirt" 64] ["dirt" 64] ["dirt" 64] ["dirt" 64] ["dirt" 64]]}
   :act [[:job (jobs.access.stair {:dir :up :heading :east :steps 6 :make-room false})]]
   :expect [{:no-event {:source :job :kind :stopped} :for-s 100 :of-job true}
            {:no-event {:source :job :kind :make-room.tossed} :for-s 100}]
   :after [[:item "tuff" 1088]]
   :limit-s 130}]}
