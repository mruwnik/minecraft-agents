;; go-to's :dig-route escalation (cards 13e0e11d, e2810933, 6a8c7e34): a free body on open stone whose goal is a sealed 1x2 pocket 4 below and
;; 3 across, with no door or stair leading down, digs the fewest cells (go-to.escalated :dig-route), looks at each cell before it is dug,
;; plans the route again round what a look shows (a guessed cell that is not rock), seals lava a dug cell lays open, and never digs a cell
;; of another owner's plan (not-diggable, the walls stay).
;; Stone mass x 2..30, z 2..30, y 0..5 under a body on its top at [16.5 6 16.5]; the pocket [19 2 16] [19 3 16] is air inside the mass.
;; The straight route is the shaft [19 5 16] [19 4 16] straight above the pocket.
;; The pocket is never seen from outside the rock, so these cases plan over the world as it is (:unknown false); under the default :unknown go-to re-aims the unseen goal to its column top.
{:defaults
 {:tags [:movement :go-to :access]
  :time :any
  :plot {:height 12}
  :blocks [[:fill [2 0 2] [30 5 30] "stone"] [:fill [19 2 16] [19 3 16] "air"]
           ;; a light layer over the mass: the cell's own is buried, and the body must see lava a dug cell opens
           [:fill [2 8 2] [30 8 30] "light"]]
  :body {:at [16.5 6 16.5] :settle-s 2 :effects [["resistance" 600 4] ["fire_resistance" 600 0]] :inventory [["stone_pickaxe" 1] ["cobblestone" 4]]}
  :limit-s 150}
 :cases
 [{:name "sealed-pocket-below-is-dug-down-to"
   :act [[:job (jobs.movement.go-to {:pos #at [19 2 16] :range 0 :unknown false})]]
   :expect [{:event {:source :job :kind :go-to.escalated :data {:step :dig-route}} :within-s 60 :of-job true}
            {:event {:source :job :kind :completed :context {:chain [[:any]]} :data {:arrived true}} :within-s 140 :of-job true}
            {:no-event {:source :job :kind :go-to.escalation-stopped} :for-s 140 :until {:source :job :kind :completed :data {:arrived true}}}]
   :after [[:body-near [19.5 2 16.5] 1.5]]}
  ;; bedrock buried under the first cell of the shaft shows only once that cell is dug: the route is planned again round it
  {:name "bedrock-in-the-line-is-dug-round"
   :blocks [[:set [19 4 16] "bedrock"]]
   :act [[:job (jobs.movement.go-to {:pos #at [19 2 16] :range 0 :unknown false})]]
   :expect [{:event {:source :job :kind :go-to.escalated :data {:step :dig-route}} :within-s 60 :of-job true}
            {:event {:source :job :kind :completed :context {:chain [[:any]]} :data {:arrived true}} :within-s 140 :of-job true}]
   :after [[:block [19 4 16] "bedrock"] [:body-near [19.5 2 16.5] 1.5]]}
  ;; lava buried beside the dug cells is unseen until a cell is dug: the dig child covers what it opens and the walk goes on. The route among equal-cost
  ;; ones is the planner's pick (it varies with what the body glimpsed), so lava lies beside the one height-4 cell it digs, whichever of x 16..22 that is
  {:name "lava-beside-a-dug-cell-is-sealed"
   :blocks [[:fill [16 4 17] [22 4 17] "lava"]]
   :act [[:job (jobs.movement.go-to {:pos #at [19 2 16] :range 0 :unknown false})]]
   :expect [{:event {:source :job :kind :go-to.escalated :data {:step :dig-route}} :within-s 60 :of-job true}
            {:event {:source :job :kind :blocks.dig.sealed} :within-s 120 :of-job true}
            {:event {:source :job :kind :completed :context {:chain [[:any]]} :data {:arrived true}} :within-s 140 :of-job true}]
   :after [[:body-near [19.5 2 16.5] 1.5]]}
  ;; card d2458f1a: a goal that is stone under stone (a block in a rock wall) with :range 3 is worked from a stand dug within range, the goal itself never dug
  {:name "solid-goal-in-the-rock-is-reached-within-range-not-dug"
   :act [[:job (jobs.movement.go-to {:pos #at [22 1 16] :range 3 :unknown false})]]
   :expect [{:event {:source :job :kind :go-to.escalated :data {:step :dig-route}} :within-s 60 :of-job true}
            {:event {:source :job :kind :completed :context {:chain [[:any]]} :data {:arrived true}} :within-s 140 :of-job true}]
   :after [[:block [22 1 16] "stone"] [:body-near [22.5 1 16.5] 3.6]]}
  ;; should fail: the pocket's floor is lava, so its goal cell is no place to stand: go-to refuses at once (goal-not-standable), digs nothing and never steps in
  {:name "pocket-over-lava-is-refused"
   :blocks [[:set [19 1 16] "lava"]]
   :act [[:job (jobs.movement.go-to {:pos #at [19 2 16] :range 0 :unknown false})]]
   :expect [{:event {:source :job :kind :stopped :context {:chain [[:any]]} :data {:arrived false}} :within-s 60 :of-job true}
            {:no-event {:source :action :kind :done :data {:name "dig"}} :for-s 60 :until {:source :job :kind :stopped :data {:arrived false}}}]
   :after [[:block [19 1 16] "lava"] [:block [19 5 16] "stone"] [:body-far [19.5 3 16.5] 0.9]]
   :limit-s 90}
  ;; under :unknown the pocket (a void floor over lava) is unseen: go-to re-aims the unseen goal cell to its column's surface and ends there; the body never steps into the pocket
  {:name "pocket-over-void-is-never-stepped-in-under-unknown"
   :blocks [[:set [19 1 16] "air"] [:set [19 0 16] "lava"]]
   :act [[:job (jobs.movement.go-to {:pos #at [19 2 16] :range 0 :unknown true})]]
   :expect [{:event {:source :job :kind :completed :context {:chain [[:any]]} :data {:arrived true :re-aimed true}} :within-s 120 :of-job true}]
   :after [[:block [19 0 16] "lava"] [:body-far [19.5 2 16.5] 0.9]]
   :limit-s 150}
  ;; should fail: walk-only, the pocket is walled in (:unknown false: unseen, the pocket would be re-aimed to its column top and arrived at): it walks to the plateau cell nearest it (within budget) and gives up there, digging nothing
  {:name "walk-only-walks-over-the-pocket-and-gives-up"
   :act [[:job (jobs.movement.go-to {:pos #at [19 2 16] :range 0 :unknown false :ways #{:walk}})]]
   :expect [{:event {:source :job :kind :go-to.wall-walk} :within-s 30 :of-job true}
            {:event {:source :job :kind :stopped :context {:chain [[:any]]} :data {:arrived false}} :within-s 60 :of-job true}
            {:no-event {:source :action :kind :done :data {:name "dig"}} :for-s 60 :until {:source :job :kind :stopped :data {:arrived false}}}]
   :after [[:block [19 5 16] "stone"] [:body-near [19.5 6 16.5] 1.5]]
   :limit-s 90}
  ;; the farmland under a planned crop cell is the body's own plan (the plan lists only the crop cell above it): the straight shaft's first cell is never dug, the route goes round it
  {:name "farmland-under-a-planned-crop-is-never-dug"
   :blocks [[:set [19 5 16] "farmland[moisture=7]"] [:set [21 5 16] "water"]]
   :plans [{:id "field" :metadata {:by "$body"} :parts [{:id "wheat" :cells [#at [19 6 16]] :want {:crop "wheat"}}]}]
   :act [[:job (jobs.movement.go-to {:pos #at [19 2 16] :range 0 :unknown false})]]
   :expect [{:event {:source :job :kind :completed :context {:chain [[:any]]} :data {:arrived true}} :within-s 140 :of-job true}]
   :after [[:block [19 5 16] "farmland[moisture=7]"] [:body-near [19.5 2 16.5] 1.5]]}
  ;; should fail: every cell around the pocket is another owner's plan: nothing is dug, the walls stay
  {:name "pocket-walled-by-another-plan-is-never-dug"
   :plans [{:id "other" :metadata {:by "SomeoneElse"}
            :parts [{:id "walls" :box [#at [18 1 15] #at [20 5 17]] :want [:any "stone"]}]}]
   :act [[:job (jobs.movement.go-to {:pos #at [19 2 16] :range 0 :unknown false})]]
   :expect [{:event {:source :job :kind :stopped :context {:chain [[:any]]} :data {:arrived false}} :within-s 100 :of-job true}
            {:no-event {:source :action :kind :done :data {:name "dig"}} :for-s 100 :until {:source :job :kind :stopped :data {:arrived false}}}]
   :after [[:block [19 5 16] "stone"] [:block [18 3 16] "stone"] [:body-far [19.5 2 16.5] 4]]}]}
