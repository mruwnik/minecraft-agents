;; Card 853d6c89: the body's own plan (:metadata :by "$body" = the running body) does not refuse blocks.dig/place; another body's
;; plan still refuses :footprint. Card 6fa0c797: stair and mine spare own-plan cells unless :settings
;; {:jobs.lib.access/spare-own-builds false}; go-to prices them (card 1ac3d50f), warns go-to.dug-own-build per cell and puts them back. Run: node tools/world-test.mjs engine/fixtures/world/own-plan-footprint.edn --body <any probe body>
;; Pit: stone mass x 10..22, z 10..22, y 0..3, 1x1 shaft at [16 y 16]; wall cells of the shaft in a plan.
{:defaults
 {:tags [:build :access] :time :any
  :plot {:height 14}
  :limit-s 200
  :body {:at [16.5 0 16.5] :inventory [["stone_pickaxe" 1]] :effects [["resistance" 600 4]]}}
 :cases
 [{:name "own-plan-dig-and-place-a" :body {:inventory [["stone_pickaxe" 1] ["dirt" 8]]}
   :plans [{:id "w" :metadata {:by "$body"}
            :parts [{:id "w" :cells [#at [20 0 18] #at [20 1 18] #at [21 0 18] #at [21 1 18]] :want [:any "dirt"]}]}]
   :blocks [[:set [20 1 18] "dirt"]]
   :act [[:job (jobs.blocks.dig {:pos #at [20 1 18]})] [:job (jobs.blocks.place {:item "dirt" :pos #at [21 0 18]})]]
   :expect [{:event {:source :job :kind :completed :data {:reason :dug}} :within-s 60 :of-job true}
            {:event {:source :job :kind #{:completed :stopped} :data {:placed [:any]}} :within-s 60 :of-job true}
            {:no-event {:source :job :kind :waiting :data {:reason :not-allowed}} :for-s 60 :until {:source :job :kind #{:completed :stopped} :data {:placed [:any]}}}]
   :after [[:block [20 1 18] "air"] [:block [21 0 18] "dirt"]]
   :limit-s 90}
  {:name "own-plan-dig-and-place-b" :body {:inventory [["stone_pickaxe" 1] ["dirt" 8]]}
   :plans [{:id "w" :metadata {:by "$body"}
            :parts [{:id "w" :cells [#at [12 0 12] #at [12 1 12] #at [13 0 12] #at [14 0 12]] :want [:any "dirt"]}]}]
   :blocks [[:set [12 0 12] "dirt"]]
   :act [[:job (jobs.blocks.place {:item "dirt" :pos #at [13 0 12]})] [:job (jobs.blocks.dig {:pos #at [12 0 12]})]]
   :expect [{:event {:source :job :kind :completed :data {:reason :dug}} :within-s 60 :of-job true}
            {:event {:source :job :kind #{:completed :stopped} :data {:placed [:any]}} :within-s 60 :of-job true}
            {:no-event {:source :job :kind :waiting :data {:reason :not-allowed}} :for-s 60 :until {:source :job :kind #{:completed :stopped} :data {:placed [:any]}}}]
   :after [[:block [12 0 12] "air"] [:block [13 0 12] "dirt"]]
   :limit-s 90}
  {:name "other-plan-dig-refused"
   :plans [{:id "w" :metadata {:by "SomeoneElse"}
            :parts [{:id "w" :cells [#at [20 0 18] #at [20 1 18]] :want [:any "dirt"]}]}]
   :blocks [[:set [20 1 18] "dirt"]]
   :act [[:job (jobs.blocks.dig {:pos #at [20 1 18]})]]
   :expect [{:event {:source :job :kind :waiting :data {:reason :not-allowed}} :within-s 30 :of-job true}
            {:no-event {:source :job :kind #{:completed :stopped} :data {:dug [:any]}} :for-s 30 :until {:source :job :kind :waiting :data {:reason :not-allowed}}}]
   :after [[:block [20 1 18] "dirt"]]
   :limit-s 60}
  {:name "other-plan-place-refused" :body {:inventory [["stone_pickaxe" 1] ["dirt" 8]]}
   :plans [{:id "w" :metadata {:by "SomeoneElse"}
            :parts [{:id "w" :cells [#at [20 0 18]] :want [:any "dirt"]}]}]
   :act [[:job (jobs.blocks.place {:item "dirt" :pos #at [20 0 18]})]]
   :expect [{:event {:source :job :kind :waiting :data {:reason :not-allowed}} :within-s 30 :of-job true}
            {:no-event {:source :job :kind #{:completed :stopped} :data {:placed [:any]}} :for-s 30 :until {:source :job :kind :waiting :data {:reason :not-allowed}}}]
   :after [[:block [20 0 18] "air"]]
   :limit-s 60}
  ;; card 1ac3d50f: a way through the body's own plan is priced, not refused: the shaft walled by its own plan is the only way, so
  ;; go-to climbs out through it, warns go-to.dug-own-build per cell and puts the cells back (cobblestone, the stone's drop)
  {:name "shut-in-own-walls-go-to-climbs-out-and-puts-them-back"
   :plans [{:id "hut" :metadata {:by "$body"}
            :parts [{:id "wall" :cells [#at [17 0 16] #at [17 1 16] #at [17 2 16] #at [17 3 16]
                                        #at [15 0 16] #at [15 1 16] #at [15 2 16] #at [15 3 16]
                                        #at [16 0 17] #at [16 1 17] #at [16 2 17] #at [16 3 17]
                                        #at [16 0 15] #at [16 1 15] #at [16 2 15] #at [16 3 15]]
                    :want [:any "stone"]}]}]
   :blocks [[:fill [10 0 10] [22 3 22] "stone"] [:fill [16 0 16] [16 3 16] "air"]]
   :act [[:job (jobs.movement.go-to {:pos #at [20 4 16] :range 1})]]
   :expect [{:event {:source :job :kind :go-to.dug-own-build} :within-s 120 :of-job true}
            {:event {:source :job :kind :go-to.restored} :within-s 180 :of-job true}
            {:event {:source :job :kind :completed :context {:chain [[:any]]} :data {:arrived true}} :within-s 180 :of-job true}]
   :after [[:body-near [20.5 4 16.5] 2]]
   :limit-s 200}
  ;; card 1ac3d50f: a dirt house of the body's own plan closed round it on open ground: go-to cuts one wall column toward the
  ;; goal (2 own cells, no stair through the roof) and puts both back
  {:name "house-sealed-round-body-cuts-one-column-and-mends-it"
   :plans [{:id "house" :metadata {:by "$body"}
            :parts [{:id "shell" :box [#at [12 0 12] #at [16 2 16]] :want "dirt"}
                    {:id "inside" :box [#at [13 0 13] #at [15 1 15]] :want :clear}]}]
   :blocks [[:fill [12 0 12] [16 2 16] "dirt"] [:fill [13 0 13] [15 1 15] "air"]]
   :body {:at [14.5 0 14.5] :inventory [["stone_pickaxe" 1] ["stone_shovel" 1]]}
   :act [[:job (jobs.movement.go-to {:pos #at [21 0 14] :range 1})]]
   :expect [{:event {:source :job :kind :completed :context {:chain [[:any]]} :data {:arrived true}} :within-s 120 :of-job true}
            {:count-event {:source :job :kind :go-to.dug-own-build} :for-s 120 :at-least 1 :at-most 2}
            {:no-event {:source :job :kind :go-to.escalated :data {:step :stair}} :for-s 120 :until {:source :job :kind :completed :data {:arrived true}}}
            {:event {:source :job :kind :go-to.restored} :within-s 120 :of-job true}]
   :after [[:block [16 0 14] "dirt"] [:block [16 1 14] "dirt"] [:body-near [21.5 0 14.5] 2]]
   :limit-s 150}
  ;; card 1ac3d50f (from cc4785f9): the body in a closed dirt room of its own plan inside glowstone (lit, rock-bound), a one-cell
  ;; void east owed dirt: it tunnels to the void through its own east wall (2 own cells, not the whole wall, no stair), fills the
  ;; void and has the wall whole again
  {:name "own-room-in-rock-tunnels-out-by-one-wall-column"
   :plans [{:id "room" :metadata {:by "$body"}
            :parts [{:id "shell" :box [#at [8 1 8] #at [12 5 12]] :want "dirt"}
                    {:id "inside" :box [#at [9 2 9] #at [11 4 11]] :want :clear}
                    {:id "post" :cells [#at [16 2 10]] :want "dirt"}]}]
   :blocks [[:fill [4 0 4] [20 9 16] "glowstone"] [:fill [8 1 8] [12 5 12] "dirt"] [:fill [9 2 9] [11 4 11] "air"] [:set [16 2 10] "air"]]
   ;; 64 dirt: the shell's edges and corners are unseen from inside, so the plan reckons them owed until it sees them
   :body {:at [10.5 2 10.5] :inventory [["dirt" 64] ["stone_pickaxe" 1] ["stone_shovel" 1]]}
   :act [[:job (jobs.build.from-plan {:plan "$plan:room"})]]
   :expect [{:event {:source :job :kind :completed :data {:kind :done}} :within-s 200 :of-job true}
            {:count-event {:source :job :kind :go-to.dug-own-build} :for-s 200 :at-most 2}
            {:no-event {:source :job :kind :go-to.escalated :data {:step :stair}} :for-s 200 :until {:source :job :kind :completed :data {:kind :done}}}]
   :after [[:block [16 2 10] "dirt"] [:block [12 2 10] "dirt"] [:block [12 3 10] "dirt"] [:block [8 2 10] "dirt"]]
   :limit-s 230}
  {:name "stair-through-own-plan-wall-when-not-spared"
   :plans [{:id "hut" :metadata {:by "$body"}
            :parts [{:id "wall" :cells [#at [17 0 16] #at [17 1 16] #at [17 2 16] #at [17 3 16]] :want [:any "stone"]}]}]
   :blocks [[:fill [10 0 10] [22 3 22] "stone"] [:fill [16 0 16] [16 3 16] "air"]]
   :act [[:job (jobs.access.stair {:dir :up :heading :east :steps 1 :settings {:jobs.lib.access/spare-own-builds false}})]]
   :expect [{:event {:source :job :kind :completed} :within-s 60 :of-job true}]
   :after [[:block [17 1 16] "air"]]
   :limit-s 90}
  {:name "stair-through-own-plan-wall-is-spared-by-default"
   :plans [{:id "hut" :metadata {:by "$body"}
            :parts [{:id "wall" :cells [#at [17 0 16] #at [17 1 16] #at [17 2 16] #at [17 3 16]] :want [:any "stone"]}]}]
   :blocks [[:fill [10 0 10] [22 3 22] "stone"] [:fill [16 0 16] [16 3 16] "air"]]
   :act [[:job (jobs.access.stair {:dir :up :heading :east :steps 1})]]
   :expect [{:event {:source :job :kind :waiting :data {:reason :refused}} :within-s 60 :of-job true}
            {:no-event {:source :job :kind :completed} :for-s 20}]
   :after [[:block [17 1 16] "stone"]]
   :limit-s 90}
  {:name "stair-through-other-plan-wall-refused"
   :plans [{:id "hut" :metadata {:by "SomeoneElse"}
            :parts [{:id "wall" :cells [#at [17 0 16] #at [17 1 16] #at [17 2 16] #at [17 3 16]] :want [:any "stone"]}]}]
   :blocks [[:fill [10 0 10] [22 3 22] "stone"] [:fill [16 0 16] [16 3 16] "air"]]
   :act [[:job (jobs.access.stair {:dir :up :heading :east :steps 1})]]
   :expect [{:event {:source :job :kind :waiting :data {:reason :refused}} :within-s 60 :of-job true}
            {:no-event {:source :job :kind :completed} :for-s 20}]
   :after [[:block [17 1 16] "stone"]]
   :limit-s 90}
  ;; step 2 from (17 1 16) cuts (17 3 16) (18 3 16) (18 2 16); (18 1 16) is the kept floor, never cut
  {:name "stair-other-plan-footprint-mid-run"
   :plans [{:id "hut" :metadata {:by "SomeoneElse"}
            :parts [{:id "wall" :cells [#at [18 2 16]] :want [:any "stone"]}]}]
   :blocks [[:fill [10 0 10] [22 3 22] "stone"] [:fill [16 0 16] [16 3 16] "air"]]
   :act [[:job (jobs.access.stair {:dir :up :heading :east :steps 3})]]
   :expect [{:event {:source :job :kind :stair.step} :within-s 60 :of-job true}
            {:event {:source :job :kind :stopped :data {:reason :footprint}} :within-s 90 :of-job true}]
   :after [[:block [17 1 16] "air"] [:block [18 2 16] "stone"]]
   :limit-s 120}
  {:name "mine-spares-own-plan-cells-by-default-a"
   :plans [{:id "o" :metadata {:by "$body"} :parts [{:id "o" :cells [#at [20 0 16]] :want [:any "iron_ore"]}]}]
   :blocks [[:fill [2 0 8] [30 6 24] "stone"] [:fill [16 0 16] [16 1 16] "air"] [:set [20 0 16] "iron_ore"]]
   :act [[:job (jobs.gather.mine {:torches false :block "iron_ore" :level false :count 1 :direction :east :tunnel-length 8 :radius 8})]]
   :expect [{:event {:source :job :kind #{:completed :stopped} :data {:got 0}} :within-s 100 :of-job true}]
   :after [[:block [20 0 16] "iron_ore"]]
   :limit-s 120}
  {:name "mine-digs-own-plan-cells-when-not-spared-a"
   :plans [{:id "o" :metadata {:by "$body"} :parts [{:id "o" :cells [#at [20 0 16]] :want [:any "iron_ore"]}]}]
   :blocks [[:fill [2 0 8] [30 6 24] "stone"] [:fill [16 0 16] [16 1 16] "air"] [:set [20 0 16] "iron_ore"]]
   :act [[:job (jobs.gather.mine {:torches false :block "iron_ore" :level false :count 1 :direction :east :tunnel-length 8 :settings {:jobs.lib.access/spare-own-builds false} :radius 8})]]
   :expect [{:event {:source :job :kind #{:completed :stopped} :data {:got 1}} :within-s 100 :of-job true}]
   :after [[:item "raw_iron" 1]]
   :limit-s 120}
]}
