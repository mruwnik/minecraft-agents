;; Card 09c21552: lead-to fetches a lead (jobs.items.obtain child) when none is carried. No lead carried, a chest with
;; one 26 blocks east in view, the cow 4 away: the body fetches it, then leads the cow and lets it go. Without a chest
;; anywhere the job ends :no-lead; with :ways #{:carried} it waits instead. A cow already tied at the :fence post ends done :tied.
{:defaults
 {:tags [:animals :jobs :fetch :large]
  :time :any
  :plot {:floor "grass_block" :length 64 :width 32}
  :body {:at [4.5 0 16.5] :yaw 270 :effects [["resistance" 900 4]]}
  :limit-s 150}
 :cases
 [{:name "fetches-the-lead-then-leads"
   :blocks [[:set [30 0 16] "chest[facing=west]{Items:[{Slot:0b,id:\"minecraft:lead\",count:1}]}"]]
   :act [[:summon "cow" [8.5 0 18.5]]
         [:job (jobs.animals.lead-to {:mob "cow" :pos #xyz [14 0 16]})]]
   :expect [{:event {:source :job :kind :completed :data {:reason :unleashed}} :within-s 120 :of-job true}
            {:no-event {:source :job :kind :stopped :data {:reason :timeout}} :for-s 120 :until {:source :job :kind :completed}}]
   :after [[:entities "type=cow,tag=wt" [[8 0 10] [20 2 22]] 1]]}
  {:name "no-lead-anywhere-ends-no-lead"
   :act [[:summon "cow" [8.5 0 18.5]]
         [:job (jobs.animals.lead-to {:mob "cow" :pos #xyz [14 0 16]})]]
   :expect [{:event {:source :job :kind :stopped :data {:reason :no-lead}} :within-s 60 :of-job true}]}
  {:name "fetch-false-without-a-lead-waits"
   :blocks [[:set [30 0 16] "chest[facing=west]{Items:[{Slot:0b,id:\"minecraft:lead\",count:1}]}"]]
   :act [[:summon "cow" [8.5 0 18.5]]
         [:job (jobs.animals.lead-to {:mob "cow" :pos #xyz [14 0 16] :ways #{:carried}})]]
   :expect [{:event {:source :job :kind :waiting :data {:reason :no-lead}} :within-s 40 :of-job true}
            {:no-event {:source :job :kind :child_ended :data {:slot :need}} :for-s 20 :until {:source :job :kind :waiting}}
            {:no-event {:source :job :kind :completed} :for-s 20 :until {:source :job :kind :waiting}}]
   :limit-s 60}
  {:name "cow-already-tied-at-the-fence-ends-tied-without-a-lead"
   :body {:at [4.5 0 16.5] :inventory [["lead" 2]] :effects [["resistance" 900 4]]}
   :blocks [[:set [14 0 16] "oak_fence"]]
   :act [[:summon "cow" [8.5 0 18.5]]
         [:job (jobs.animals.lead-to {:mob "cow" :fence #xyz [14 0 16]})]
         [:await {:source :job :kind :completed :data {:reason :tied}} 120]
         [:job (jobs.animals.lead-to {:mob "cow" :fence #xyz [14 0 16]})]]
   :expect [{:event {:source :job :kind :completed :data {:reason :tied}} :within-s 30 :of-job true}
            {:no-event {:source :job :kind :waiting} :for-s 10 :until {:source :job :kind :completed}}]
   :after [[:item "lead" 1]]
   :limit-s 170}]}
