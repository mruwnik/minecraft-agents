;; Staying put is priced too: a hurt body that cannot heal (hunger, no food) in a dark cave with hostiles about must not wait on go-to's :risky.
;; A dark cave: a stone block x 10..60 with a 3-wide corridor, the body at its west end at 3 hp, two zombies (no AI) in the corridor 8 and 12 blocks east, the goal 30 blocks east.
;; Should-succeed: go-to goes, or stops at once with cause :stranded (staying costs as much as the walk and it cannot heal: the caller seals in or goes to a nearer refuge); which one depends on which zombies it has perceived.
;; Should-fail: go-to waits :risky for ever beside the zombies.
{:defaults
 {:tags [:survival :movement :go-to]
  :time :any
  :plot {:height 12 :length 64 :light :dark}
  :blocks [[:fill [10 -4 14] [60 8 18] "stone"]
           [:fill [11 3 15] [55 4 17] "air"]]
  :body {:at [12.5 3 16.5] :settle-s 3 :effects [["hunger" 300 255]]}
  :limit-s 90}
 :cases
 [{:name "hurt-hungry-body-in-a-dark-cave-with-hostiles-does-not-wait-on-risk"
   :act [[:summon "zombie" [20.5 3 16.5] "{NoAI:1b}"]
         [:summon "zombie" [24.5 3 16.5] "{NoAI:1b}"]
         [:rcon "damage $BODY 17 minecraft:generic"]
         [:wait-s 6]
         [:job (jobs.movement.go-to {:pos #at [42 3 16] :range 1})]]
   :expect [{:event {:source :job :kind :round_started} :within-s 20 :of-job true}
            {:no-event {:source :job :kind :waiting :data {:reason :risky}} :for-s 30 :of-job true}]}]}
