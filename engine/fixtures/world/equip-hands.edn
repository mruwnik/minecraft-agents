;; Cards db7aa152, 76ce6829: jobs.items.equip holds a carried item in the main or off hand (a shield in the off-hand unasked); a missing item waits :no-item, a misspelt one stops impossible :unknown-item.
{:defaults
 {:tags [:items :equip]
  :plot {:height 8}
  ;; the first stack is the one held at start: another item first, so equipping the pickaxe moves it
  :body {:inventory [["stone_axe" 1] ["iron_pickaxe" 1] ["shield" 1]]}
  :limit-s 40}
 :cases
 [{:name "main-hand"
   :act [[:job (jobs.items.equip {:item "iron_pickaxe"})]]
   :expect [{:event {:source :job :kind :completed :data {:item "iron_pickaxe" :slot "hand"}} :within-s 20 :of-job true}]}
  {:name "off-hand-shield"
   :act [[:job (jobs.items.equip {:item "shield" :hand "off"})]]
   :expect [{:event {:source :job :kind :completed :data {:item "shield" :slot "off-hand"}} :within-s 20 :of-job true}]}
  {:name "shield-goes-to-off-hand-unasked"
   :act [[:job (jobs.items.equip {:item "shield"})]]
   :expect [{:event {:source :job :kind :completed :data {:item "shield" :slot "off-hand"}} :within-s 20 :of-job true}]}
  {:name "no-item"
   :act [[:job (jobs.items.equip {:item "diamond_pickaxe" :fetch false})]]
   :expect [{:event {:source :job :kind :waiting :data {:reason :no-item}} :within-s 20 :of-job true}
            {:no-event {:source :job :kind :completed} :for-s 10}]}
  {:name "unknown-item"
   :act [[:job (jobs.items.equip {:item "iron_pickaxx"})]]
   :expect [{:event {:source :job :kind :stopped :data {:kind :impossible :reason :unknown-item}} :within-s 20 :of-job true}]}]}
