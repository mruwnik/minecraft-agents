;; Cards 32c238bd, f7a80e5c: core records every :died in memory.edn :deaths (pos, dimension, cause), also with no triggers registered.
;; two-deaths-two-entries: two kills, two entries. restart-keeps-one-entry: a restart (memory kept) adds no duplicate.
{:defaults
 {:tags [:survival :death :memory]
  :time :any
  :plot {:height 8}
  :body {:at [10.5 0 10.5] :spawnpoint [4 0 4]}
  :limit-s 90}
 :cases
 [{:name "two-deaths-two-entries"
   :act [[:kill-body] [:await {:source :body :kind :respawned} 30]
         [:kill-body] [:await {:source :body :kind :respawned} 30]
         [:until [:memory {:entries {:deaths [{:data {:pos [:any]}} {:data {:pos [:any]}}]}}] 15]]
   :expect [{:event {:source :body :kind :respawned} :within-s 60}]
   :after [[:memory {:entries {:deaths [{:data {:pos [:any]}} {:data {:pos [:any]}}]}}]]}
  {:name "restart-keeps-one-entry"
   :act [[:kill-body] [:await {:source :body :kind :respawned} 30] [:until [:memory {:entries {:deaths [{:data {:pos [:any]}}]}}] 15]
         [:restart-body]]
   :expect [{:event {:source :body :kind :respawned} :within-s 60}]
   :after [[:memory {:entries {:deaths [{:data {:pos [:any]}}]}}]]}]}
