;; Card 4cf0bfb2 (Teasel 10-22 02:49): a mine whose cave holds more hostiles than the kit can fight waits (ready/outmatched) instead of walking among them.
;; Stone mass x 2..30, z 8..24, y 0..6; a cave room x 4..22, z 14..18, y 0..2; iron ore in its east wall at [23 0 16]. Body at the west end;
;; two still zombies 11-12 blocks east, past the hostile-near radius (8), with a way to it.
;; Should-fail: a wooden sword and no armour, the mine waits :outmatched and digs nothing. Should-succeed: the iron kit worn, no :outmatched wait; the hostile-near
;; reflex deals with the zombies and the mine digs the ore.
{:defaults
 {:tags [:mine :hostile :jobs] :time :any
  :plot {:height 12}
  :blocks [[:fill [2 0 8] [30 6 24] "stone"] [:fill [4 0 14] [22 2 18] "air"] [:set [23 0 16] "iron_ore"]]
  :body {:at [5.5 0 16.5] :yaw 270 :effects [["resistance" 600 4]]}
  :limit-s 150}
 :cases
 [{:name "wooden-sword-waits-while-two-zombies-are-in-the-cave"
   :body {:inventory [["stone_pickaxe" 1] ["wooden_sword" 1] ["cobblestone" 16]]}
   :act [[:summon "zombie" [16.5 0 15.5] "{NoAI:1b,equipment:{head:{id:\"minecraft:iron_helmet\",count:1}}}"]
         [:summon "zombie" [17.5 0 17.5] "{NoAI:1b,equipment:{head:{id:\"minecraft:iron_helmet\",count:1}}}"]
         [:wait-s 2]
         [:job (jobs.gather.mine {:torches false :block "iron_ore" :level false :count 1 :tunnel-length 0 :radius 24 :mend false})]]
   :expect [{:event {:source :job :kind :waiting :data {:reason :outmatched}} :within-s 30 :of-job true}
            {:no-event {:source :job :kind #{:completed :stopped}} :of-job true :for-s 40}]
   :after [[:block [23 0 16] "iron_ore"]]
   :limit-s 60}
  {:name "iron-kit-mines-past-the-same-two-zombies"
   :register [{:trigger :hostile-near}]
   :body {:inventory [["stone_pickaxe" 1] ["iron_sword" 1] ["cobblestone" 16]]}
   :act [[:rcon "item replace entity $BODY armor.head with minecraft:iron_helmet"]
         [:rcon "item replace entity $BODY armor.chest with minecraft:iron_chestplate"]
         [:rcon "item replace entity $BODY armor.legs with minecraft:iron_leggings"]
         [:rcon "item replace entity $BODY armor.feet with minecraft:iron_boots"]
         [:summon "zombie" [16.5 0 15.5] "{NoAI:1b,equipment:{head:{id:\"minecraft:iron_helmet\",count:1}}}"]
         [:summon "zombie" [17.5 0 17.5] "{NoAI:1b,equipment:{head:{id:\"minecraft:iron_helmet\",count:1}}}"]
         [:wait-s 2]
         [:job (jobs.gather.mine {:torches false :block "iron_ore" :level false :count 1 :tunnel-length 0 :radius 24 :mend false})]]
   :expect [{:no-event {:source :job :kind :waiting :data {:reason :outmatched}} :of-job true :for-s 30}
            {:event {:source :job :kind #{:completed :stopped} :data {:got 1}} :within-s 190 :of-job true}]
   :after [[:item "raw_iron" [:>= 1]]]
   :limit-s 200}]}
