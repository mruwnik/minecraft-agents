;; jobs.gather.mine and a zone the body owns (cards a96a4b57, 87872c83): before its first dig the body walks to a cell
;; zone-margin (8) outside the own zone (info mine.left-zone), so the base is never cut; a tunnel that meets an own
;; zone ends :own-zone; :ignore-zones? true digs in place. The zone is owned by the probe body ("$body").
;; Stone mass x 2..30, z 8..24, y 0..6 (floor at y -1); body at [16.5 0 16.5] facing east, stone pickaxe.
{:defaults
 {:tags [:mine :jobs :zones] :time :any
  :plot {:height 12}
  :blocks [[:fill [2 0 8] [30 6 24] "stone"]]
  :body {:at [16.5 0 16.5] :inventory [["stone_pickaxe" 1] ["cobblestone" 16]] :effects [["resistance" 600 4]]}}
 :cases
 [{:name "walks-out-of-its-own-zone-before-it-digs"
   ;; an open room around a 7x7 own zone with a plank floor: the body leaves it first, the floor stands
   :blocks [[:fill [4 0 10] [28 3 22] "air"] [:fill [13 -1 13] [19 -1 19] "birch_planks"]]
   :zones [{:name "home" :min [13 -1 13] :max [19 3 19] :owner "$body"}]
   :act [[:job (jobs.gather.mine {:torches false :block "iron_ore" :level false :count 1 :direction :east :tunnel-length 3 :radius 8})]]
   :expect [{:event {:source :job :kind :mine.left-zone} :within-s 60 :of-job true}
            {:event {:source :job :kind #{:completed :stopped}} :within-s 150 :of-job true}]
   :after [[:block [16 -1 16] "birch_planks"] [:block [13 -1 13] "birch_planks"]]
   :limit-s 170}
  {:name "ignore-zones-digs-in-place"
   :blocks [[:fill [16 0 16] [16 1 16] "air"] [:set [20 0 16] "iron_ore"]]
   :zones [{:name "home" :min [14 -1 14] :max [18 3 18] :owner "$body"}]
   :act [[:job (jobs.gather.mine {:torches false :block "iron_ore" :level false :count 1 :direction :east :tunnel-length 8 :radius 8 :ignore-zones? true})]]
   :expect [{:event {:source :job :kind #{:completed :stopped} :data {:got 1}} :within-s 100 :of-job true}
            {:no-event {:source :job :kind :mine.left-zone} :for-s 100 :until {:source :job :kind #{:completed :stopped}}}]
   :after [[:item "raw_iron" 1]]
   :limit-s 120}
  {:name "tunnel-stops-at-the-own-zone"
   :blocks [[:fill [12 0 16] [12 1 16] "air"] [:set [29 0 16] "iron_ore"]]
   :body {:at [12.5 0 16.5]}
   :zones [{:name "home" :min [24 -1 14] :max [28 3 18] :owner "$body"}]
   :act [[:job (jobs.gather.mine {:torches false :block "iron_ore" :level false :count 1 :direction :east :tunnel-length 20 :radius 8})]]
   :expect [{:event {:source :job :kind #{:completed :stopped} :data {:stop :own-zone}} :within-s 120 :of-job true}]
   :after [[:block [24 0 16] "stone"] [:item "raw_iron" 0]]
   :limit-s 140}]}
