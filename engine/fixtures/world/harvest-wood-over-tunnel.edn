;; Card 7b3979e5: harvest-wood fells a tree on the surface although the body has seen an old tunnel under the tree's column (the body's own
;; strip tunnel in the trial). The body starts in the dark tunnel (x 6..28, z 8, y -5..-3) and climbs a dirt stair (x 1..5) to the floor (go-to first, then harvest-wood); the tree
;; stands at [20 0 8] over the tunnel. The ground under a trunk is never seen; the unit test go-to-column-test pins the old pick. Here the tunnel's ceiling is seen (a body sees the roof of a tunnel it walks), so this case would also pass on the old code: it guards the walk up and the felling, not the pick.
{:defaults
 {:tags [:forestry :harvest-wood :tunnel]
  :time :any
  :plot {:height 10 :floor "grass_block" :light :dark}
  :body {:at [8.5 -5 8.5] :settle-s 2 :effects [["resistance" 600 4]]}
  :limit-s 130}
 :cases
 [{:name "tree-over-a-tunnel-is-felled-from-the-surface"
   :blocks [[:fill [6 -5 8] [28 -3 8] "air"]
            [:fill [4 -3 8] [5 -2 8] "air"] [:fill [3 -2 8] [4 -1 8] "air"] [:fill [2 -1 8] [3 1 8] "air"] [:fill [1 0 8] [2 2 8] "air"]
            [:fill [5 -4 8] [5 -2 8] "air"] [:set [5 -5 8] "dirt"] [:set [4 -4 8] "dirt"] [:set [3 -3 8] "dirt"] [:set [2 -2 8] "dirt"]
            [:fill [20 0 8] [20 3 8] "oak_log"] [:fill [18 3 6] [22 4 10] "oak_leaves[persistent=true]"] [:set [20 3 8] "oak_log"]
            [:set [10 -5 8] "torch"] [:set [19 -5 8] "torch"] [:set [22 -5 8] "torch"] [:set [18 0 8] "torch"] [:set [22 0 8] "torch"]]
   :body {:inventory [["iron_axe" 1] ["oak_sapling" 1]]}
   :act [[:job (jobs.movement.go-to {:pos #at [1 0 8]})]
         [:job (jobs.forestry.harvest-wood {:radius 32 :count 2})]]
   :expect [{:no-event {:source :job :kind :stopped} :for-s 100 :until {:source :job :kind :completed :data {:name "jobs.forestry.harvest-wood"}}}
            {:event {:source :job :kind :completed :data {:name "jobs.forestry.harvest-wood"}} :within-s 110}]
   :after [[:item "oak_log" [:>= 2]] [:body-far [20.5 -4 8.5] 3]]}]}
