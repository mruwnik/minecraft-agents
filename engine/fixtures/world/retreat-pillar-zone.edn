;; Card 67b04bdb (owner Q350): the retreat pillar goes through another's area only after every way that keeps off has failed.
;; Same course as retreat-early-pillar (helmeted zombie 7 east, 10 hp, no weapon, dirt carried); a foreign plan footprint
;; stands in for the zone round the pillar column (as in go-to-zone-pit). Should-succeed: ground to dig into beside the
;; footprint: the body digs a pit and never pillars. Should-fail (pillars): with no pickaxe-free dig possible (a bedrock-hard
;; floor) the pillar is the last way and goes up with a trespass warning.
{:defaults
 {:tags [:hostile :survival :cornered :zones]
  :time :any
  :plot {:height 16}
  :plans [{:id "z" :metadata {:by "SomeoneElse"} :parts [{:id "z" :box [#at [10 0 16] #at [10 5 16]] :want "stone"}]}]
  :register [{:trigger :hostile-near :args {:radius 8 :ranged-radius 16}
              :job (jobs.survival.respond-to-hostile)}]
  :body {:at [10.5 0 16.5] :inventory [["dirt" 24]]}
  :act [[:rcon "damage $BODY 10 minecraft:generic"]
        [:summon "zombie" [17.5 0 16.5] "{equipment:{head:{id:\"minecraft:iron_helmet\",count:1}}}"]]
  :limit-s 90}
 :cases
 [{:name "foreign-footprint-on-the-column-with-ground-to-dig-takes-the-pit-not-the-pillar"
   :expect [{:event {:source :job :kind :retreat_sealed} :within-s 40}
            {:no-event {:source :job :kind :child_ended :data {:slot :pillar :status :done}} :for-s 40}]}
  {:name "foreign-footprint-on-the-column-with-nothing-else-left-pillars-and-warns"
   :blocks [[:fill [4 -1 10] [24 -1 22] "bedrock"]]
   :expect [{:event {:source :job :kind :retreat.trespass-last-resort} :within-s 40}
            {:event {:source :job :kind :child_ended :data {:slot :pillar :status :done}} :within-s 40}]
   :after [[:body-near [10.5 3 16.5] 3]]}]}
