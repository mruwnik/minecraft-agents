;; Card d00cfcb6: animals.tend with nothing to do waits :nothing-to-do with the census it counted and why each step was skipped, so a miscount
;; reads differently from a satisfied target. Box x 10..14, z 10..14; two adult cows inside, :target 2.
;; Should-succeed: the wait names {:adults 2 :babies 0 :target 2} and the skipped steps.
{:defaults
 {:tags [:animals :jobs]
  :time :any
  :plot {:floor "grass_block"}
  :blocks [[:fill [9 0 9] [15 0 15] "oak_fence" :hollow]]
  :body {:at [12.5 0 12.5] :yaw 0 :effects [["resistance" 600 4]]}
  :limit-s 60}
 :cases
 [{:name "at-target-waits-with-the-census"
   :act [[:summon "cow" [11.5 0 11.5]]
         [:summon "cow" [13.5 0 13.5]]
         [:job (jobs.animals.tend {:mob "cow" :target 2 :box {:min #xyz [10 0 10] :max #xyz [14 0 14]}})]]
   :expect [{:event {:source :job :kind :waiting :data {:reason :nothing-to-do :adults 2 :babies 0 :target 2 :skipped [:any]}} :within-s 40 :of-job true}]}]}
