;; Card bcf0465d: the :died trigger comes before :night, so a body that respawns at night goes for a valuable pile 31 blocks away
;; before sheltering. Needs night: run with --allow-time. No mobs. Should-succeed: the pile is collected and no dig-in seal is placed
;; until then. (The register starts before the plot is set, so the night trigger may fire once at the stale start; it is cut by :died.)
{:defaults
 {:tags [:survival :death :night :jobs]
  :time :night
  :register [{:trigger :died :persistence :cooldown :cooldown-s 30 :args {}}
             {:trigger :night :persistence :cooldown :cooldown-s 10 :args {:roof-height 4}}]
  :body {:at [26.5 0 26.5] :spawnpoint [4 0 4] :effects [["resistance" 600 4]]
         :inventory [["raw_iron" 24] ["cobblestone" 64] ["cobblestone" 36]]}
  :act [[:kill-body]]
  :limit-s 220}
 :cases
 [{:name "night-respawn-fetches-the-pile-before-sealing-in"
   :expect [{:event {:source :job :kind :recover-drops.decided :data {:decision :collected}} :within-s 200}
            {:no-event {:source :job :kind :shut-in.sealed} :for-s 200 :until {:source :job :kind :recover-drops.decided}}]
   :after [[:item "raw_iron" 24]]}
  {:name "far-pile-in-the-open-waits-for-day-and-shelters"
   ;; card 18d5778f: respawn late at night 136 blocks from the pile with no bed under the open sky: the pile lasts until morning, so
   ;; recover-drops' safe? (the exposure of the pile) holds the died trigger instead of the long night walk, and the night job shelters where the body is;
   ;; the case ends before dawn: after it the held trigger walks to the pile, so no position is checked at the end
   :time :night-exclusive
   :act [[:time-set 21500] [:wait-s 1] [:kill-body]]
   :plot {:length 160 :width 32 :height 10 :floor "dirt"}
   :body {:at [140.5 0 16.5] :spawnpoint [4 0 16]}
   :expect [{:event {:source :reflex :kind :held :data {:reason :exposed}} :within-s 90}
            {:no-event {:source :job :kind :recover-drops.decided :data {:decision :collected}} :for-s 60}]
   :limit-s 100}
  {:name "night-shelter-moves-off-another-players-zone"
   ;; the respawn point lies inside another body's zone: the night job relocates to a free site (shut-in.relocated) before digging in.
   ;; Dirt floor (the stone default has no pit site for a body without a pickaxe) and no :died trigger (it walks the body to the death spot, outside the zone)
   :plot {:length 40 :width 40 :height 10 :floor "dirt"}
   :register [{:trigger :night :persistence :cooldown :cooldown-s 10 :args {:roof-height 4}}]
   :zones [{:name "yard" :min [0 -2 6] :max [10 12 26] :owner "Other"}]
   :body {:at [26.5 0 26.5] :spawnpoint [5 0 16] :inventory []}
   :expect [{:event {:source :job :kind :shut-in.relocated} :within-s 90}]
   :after [[:body-far [5.5 0 16.5] 5]]
   :limit-s 200}]}
