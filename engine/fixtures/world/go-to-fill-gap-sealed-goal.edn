;; A pit (floor y -1). The goal [10 5 10] is the 1-high cell over a sealed 2-high pocket (feet [10 4 10], stone pillar
;; under it, stone walls round it, roof at y 6); its east wall tops a 1-wide stone ledge x 11..13 (top y 5), then an open
;; column x 14, then the body's stone platform x 15..18, z 9..11 (top y 5, feet y 6). go-to plans over what the body has
;; seen (the default read): it looks round from the pit west, south and north of the pocket and from under the open
;; column, then from the platform, so it knows the pocket's shell but not inside it, as in the run that laid 31 blocks
;; one after another over the pit beside a goal no block could join. A lit plot: light enough in the pit to see the shell.
;; Should-fail: a block over the open column joins the ledge to the body but never the pocket: no fill-gap, the cell
;; stays air. Should-succeed: go-to-bridge-door-hole/dirt-carried-bridges-the-hole-before-the-door.
{:defaults
 {:tags [:movement :access]
  :time :any
  :plot {:height 10 :light :lit}
  :blocks [[:fill [9 0 9] [11 6 11] "stone"] [:fill [11 0 10] [13 5 10] "stone"] [:fill [15 0 9] [18 5 11] "stone"]
           [:set [10 4 10] "air"] [:set [10 5 10] "air"] [:set [11 6 10] "air"]]
  :body {:at [16.5 6 10.5] :inventory [["dirt" 9]] :effects [["resistance" 600 4]]}
  :limit-s 300}
 :cases
 [{:name "no-fill-beside-a-sealed-goal"
   :act [[:rcon "execute positioned $X $Y $Z run tp $BODY ~6 ~ ~10 -90 0"] [:until-pos {:x-min 6 :x-max 7 :z-min 10 :z-max 11} 10]
         [:job (jobs.movement.look-around {:worth 1200})] [:await {:source :job :kind :completed} 30]
         [:rcon "execute positioned $X $Y $Z run tp $BODY ~10 ~ ~6 0 0"] [:until-pos {:x-min 10 :x-max 11 :z-min 6 :z-max 7} 10]
         [:job (jobs.movement.look-around {:worth 1200})] [:await {:source :job :kind :completed :after-previous true} 30]
         [:rcon "execute positioned $X $Y $Z run tp $BODY ~10 ~ ~14 180 0"] [:until-pos {:x-min 10 :x-max 11 :z-min 14 :z-max 15} 10]
         [:job (jobs.movement.look-around {:worth 1200})] [:await {:source :job :kind :completed :after-previous true} 30]
         [:rcon "execute positioned $X $Y $Z run tp $BODY ~14 ~ ~10 90 0"] [:until-pos {:x-min 14 :x-max 15 :z-min 10 :z-max 11} 10]
         [:job (jobs.movement.look-around {:worth 1200})] [:await {:source :job :kind :completed :after-previous true} 30]
         [:rcon "execute positioned $X $Y $Z run tp $BODY ~16 ~6 ~10 90 0"] [:until-pos {:x-min 16 :x-max 17 :z-min 10 :z-max 11} 10]
         [:job (jobs.movement.look-around {:worth 1200})] [:await {:source :job :kind :completed :after-previous true} 30]
         [:job (jobs.movement.go-to {:worth 1200 :pos #at [10 5 10] :range 1})]]
   :expect [{:event {:source :job :kind #{:stopped :completed} :data {:name "jobs.movement.go-to"}} :within-s 290 :of-job true}
            {:no-event {:source :job :kind :go-to.escalated :data {:step :fill-gap}} :for-s 290
             :until {:source :job :kind #{:stopped :completed} :data {:name "jobs.movement.go-to"}} :of-job true}]
   :after [[:not-block [14 5 10] "dirt"]]}]}
