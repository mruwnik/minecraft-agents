;; A flight runs into a closed building (jobs.lib.rooms/rooms, owner Q132), not only its own home: cards 1cac54f6 (any closed
;; building), 58b2e704 (flee into the hut by day), a6ca17e9 (home ahead of a chaser, race), 31887403 (home is any cell of the room), 096cba8d (no room within blast reach
;; of a creeper), 659f5e6d (no run into the hut ahead of a creeper). Hut: stone walls x 12..20, z 12..20, roof y 3, interior 7x7, door gap at [16 0 20]/[16 1 20] facing south.
;; The cases that start in the room turn the body through four yaws at two pitches (the sight cone is ~100 x 70 degrees; one look-around glance sees a part of the room only), so the whole room is seen before the body leaves.
;; The :home cases wait for set-place to finish before the mob appears (else the flight starts with no home). The hut-seen case starts facing the door (yaw 180), within 6 blocks of the door side (retreat-home/door-glance-radius): a flight judges only doors the body has seen.
;; Mobs are NoAI and helmeted (they never hurt, no sun burn); the reflex fires on them all the same.
{:defaults
 {:tags [:hostile :survival :flee]
  :time :any
  :mobs :keep
  :register [{:trigger :hostile-near :args {:radius 12 :ranged-radius 16}
              :job (jobs.survival.respond-to-hostile {:settings {:jobs.lib.danger/hostile-radius 12}})}]
  :blocks [[:fill [12 0 12] [20 3 20] "stone" :hollow]
           [:fill [13 0 13] [19 2 19] "air"]
           [:set [16 0 20] "oak_door[facing=south,half=lower,open=true]"]
           [:set [16 1 20] "oak_door[facing=south,half=upper,open=true]"]
           [:set [13 1 13] "torch"] [:set [19 1 13] "torch"] [:set [13 1 19] "torch"] [:set [19 1 19] "torch"]]
  :body {:at [16.5 0 25.5] :effects [["resistance" 600 4]]}
  :limit-s 60}
 :cases
 [{:name "runs-into-a-foreign-closed-building-and-shuts-the-door"
   :body {:at [16.5 0 17.5] :effects [["resistance" 600 4]]}
   :act [[:rcon "execute positioned $X $Y $Z run tp $BODY ~16 ~ ~16"] [:rcon "execute as $BODY at @s run tp @s ~ ~ ~ 0 0"] [:wait-s 2] [:rcon "execute as $BODY at @s run tp @s ~ ~ ~ 90 0"] [:wait-s 2] [:rcon "execute as $BODY at @s run tp @s ~ ~ ~ 180 0"] [:wait-s 2] [:rcon "execute as $BODY at @s run tp @s ~ ~ ~ 270 0"] [:wait-s 2] [:rcon "execute as $BODY at @s run tp @s ~ ~ ~ 0 40"] [:wait-s 2] [:rcon "execute as $BODY at @s run tp @s ~ ~ ~ 90 40"] [:wait-s 2] [:rcon "execute as $BODY at @s run tp @s ~ ~ ~ 180 40"] [:wait-s 2] [:rcon "execute as $BODY at @s run tp @s ~ ~ ~ 270 40"] [:wait-s 2] [:rcon "execute positioned $X $Y $Z run tp $BODY ~16 ~ ~25"] [:until-pos {:x-min 15 :x-max 18 :z-min 24 :z-max 27} 10]
         [:summon "zombie" [16.5 0 31.5] "{NoAI:1b,equipment:{head:{id:\"minecraft:iron_helmet\",count:1}}}"]]
   :expect [{:event {:source :job :kind :retreat.home :data {:own? false}} :within-s 25}
            {:event {:source :job :kind :retreat.door-shut} :within-s 40}]
   :after [[:body-near [16.5 0 16.5] 3.5]]}
  {:name "own-home-ahead-of-a-chaser-beside-the-door"
   :body {:at [16.5 0 17.5] :effects [["resistance" 600 4]]}
   :act [[:rcon "execute positioned $X $Y $Z run tp $BODY ~16 ~ ~16"] [:rcon "execute as $BODY at @s run tp @s ~ ~ ~ 0 0"] [:wait-s 2] [:rcon "execute as $BODY at @s run tp @s ~ ~ ~ 90 0"] [:wait-s 2] [:rcon "execute as $BODY at @s run tp @s ~ ~ ~ 180 0"] [:wait-s 2] [:rcon "execute as $BODY at @s run tp @s ~ ~ ~ 270 0"] [:wait-s 2] [:rcon "execute as $BODY at @s run tp @s ~ ~ ~ 0 40"] [:wait-s 2] [:rcon "execute as $BODY at @s run tp @s ~ ~ ~ 90 40"] [:wait-s 2] [:rcon "execute as $BODY at @s run tp @s ~ ~ ~ 180 40"] [:wait-s 2] [:rcon "execute as $BODY at @s run tp @s ~ ~ ~ 270 40"] [:wait-s 2] [:rcon "execute positioned $X $Y $Z run tp $BODY ~16 ~ ~25"] [:until-pos {:x-min 15 :x-max 18 :z-min 24 :z-max 27} 10]
         [:job (jobs.memory.set-place {:name :home :pos #at [16 0 16]})] [:await {:source :job :kind :completed} 10]
         [:summon "zombie" [22.5 0 22.5] "{NoAI:1b,equipment:{head:{id:\"minecraft:iron_helmet\",count:1}}}"]]
   :expect [{:event {:source :job :kind :retreat.home :data {:own? true}} :within-s 25}
            {:event {:source :job :kind :retreat.door-shut} :within-s 40}]
   :after [[:body-near [16.5 0 16.5] 3.5]]}
  ;; 1b22e0fa: a hut seen only from outside (a cell of the room unseen) is dropped :unseen; the body within a few blocks of its door steps into the doorway, looks at the unseen sides, then the choice leans into the room (the body is already inside, so no retreat.home) and shuts the door. No scan: that look is the only way it sees the room
  {:name "hut-seen-only-from-outside-is-looked-into-from-the-door"
   :body {:at [16.5 0 21.5] :yaw 180 :effects [["resistance" 600 4]]}
   :act [[:wait-s 2] [:summon "zombie" [16.5 0 31.5] "{NoAI:1b,equipment:{head:{id:\"minecraft:iron_helmet\",count:1}}}"]]
   :expect [{:event {:source :job :kind :retreat.choice :data {:lean [:near #at [16 0 17] 3]}} :within-s 25}
            {:event {:source :job :kind :retreat.door-shut} :within-s 40}]
   :after [[:body-near [16.5 0 16.5] 3.5]]}
  ;; card 659f5e6d: a creeper chasing from afar is not led to the door (it would follow and blow the door, chest and bed): no run into the hut
  {:name "creeper-far-behind-the-body-is-not-led-into-the-hut"
   :act [[:summon "creeper" [16.5 0 31.5] "{NoAI:1b,equipment:{head:{id:\"minecraft:iron_helmet\",count:1}}}"]]
   :expect [{:event {:source :job :kind :retreat.target} :within-s 25}
            {:no-event {:source :job :kind :retreat.home} :for-s 30}
            {:no-event {:source :job :kind :retreat.door-shut} :for-s 30}]
   :after [[:body-far [16.5 0 16.5] 3.5]]}
  ;; 31887403: :home in the far corner of the hut, 7 cells from the door: the door is still shut on the way in
  {:name "own-home-in-the-far-corner-still-shuts-the-door"
   :body {:at [16.5 0 17.5] :effects [["resistance" 600 4]]}
   :act [[:rcon "execute positioned $X $Y $Z run tp $BODY ~16 ~ ~16"] [:rcon "execute as $BODY at @s run tp @s ~ ~ ~ 0 0"] [:wait-s 2] [:rcon "execute as $BODY at @s run tp @s ~ ~ ~ 90 0"] [:wait-s 2] [:rcon "execute as $BODY at @s run tp @s ~ ~ ~ 180 0"] [:wait-s 2] [:rcon "execute as $BODY at @s run tp @s ~ ~ ~ 270 0"] [:wait-s 2] [:rcon "execute as $BODY at @s run tp @s ~ ~ ~ 0 40"] [:wait-s 2] [:rcon "execute as $BODY at @s run tp @s ~ ~ ~ 90 40"] [:wait-s 2] [:rcon "execute as $BODY at @s run tp @s ~ ~ ~ 180 40"] [:wait-s 2] [:rcon "execute as $BODY at @s run tp @s ~ ~ ~ 270 40"] [:wait-s 2] [:rcon "execute positioned $X $Y $Z run tp $BODY ~16 ~ ~25"] [:until-pos {:x-min 15 :x-max 18 :z-min 24 :z-max 27} 10]
         [:job (jobs.memory.set-place {:name :home :pos #at [13 0 13]})] [:await {:source :job :kind :completed} 10]
         [:summon "zombie" [22.5 0 22.5] "{NoAI:1b,equipment:{head:{id:\"minecraft:iron_helmet\",count:1}}}"]]
   :expect [{:event {:source :job :kind :retreat.home :data {:own? true}} :within-s 25}
            {:event {:source :job :kind :retreat.door-shut} :within-s 40}]
   :after [[:block [16 0 20] "oak_door[half=lower,open=false]"] [:body-near [16.5 0 16.5] 4.5]]}
  ;; 31887403: already inside the hut, on a cell other than the :home cell: that is at home, the body does not run out again
  {:name "inside-the-room-away-from-the-home-cell-stays-and-shuts-the-door"
   :body {:at [14.5 0 14.5]}
   :act [[:job (jobs.movement.look-around)] [:await {:source :job :kind :completed} 30]
         [:job (jobs.memory.set-place {:name :home :pos #at [18 0 18]})] [:await {:source :job :kind :completed} 10]
         [:summon "zombie" [17.5 0 23.5] "{NoAI:1b,equipment:{head:{id:\"minecraft:iron_helmet\",count:1}}}"]]
   :expect [{:event {:source :job :kind :retreat.door-shut} :within-s 40}]
   :after [[:block [16 0 20] "oak_door[half=lower,open=false]"] [:body-near [16.5 0 16.5] 4.5]]}
  {:name "creeper-beside-the-door-no-room-within-blast-reach"
   :body {:at [8.5 0 24.5] :yaw 270}
   :act [[:summon "creeper" [18.5 0 22.5] "{NoAI:1b,equipment:{head:{id:\"minecraft:iron_helmet\",count:1}}}"]]
   :expect [{:event {:source :job :kind :retreat.target} :within-s 25}
            {:no-event {:source :job :kind :retreat.home} :for-s 30}
            {:no-event {:source :job :kind :retreat.door-shut} :for-s 30}]
   :after [[:body-far [16.5 0 16.5] 5]]}]}
