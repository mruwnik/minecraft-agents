;; go-to's quote (./bin/quote; cards ee7d7b5e, 4b8bb3de): a dry run of go-to. Same plot as doors-go-to: a stone wall across it at x 16
;; with one door in it, the body 6 west, the goal 6 east. The preview plans through the door and opens nothing; with
;; :doors :never the door is a wall, there is no way round, and it says :found false with a reason. The body never moves.
{:defaults
 {:tags [:movement] :time :any
  :plot {:height 8}
  :blocks [[:fill [16 0 0] [16 3 31] "stone"] [:fill [0 0 0] [31 3 0] "stone"] [:fill [0 0 31] [31 3 31] "stone"]
           [:fill [0 0 0] [0 3 31] "stone"] [:fill [31 0 0] [31 3 31] "stone"]
           [:set [16 0 16] "oak_door[facing=east,half=lower,open=false]"] [:set [16 1 16] "oak_door[facing=east,half=upper,open=false]"]]
  :body {:at [10.5 0 16.5]}
  :limit-s 50}
 :cases
 ;; the body turns on the spot first: the planner takes cells it has not seen for open, so the whole wall must have been seen
 [{:name "quote-plans-through-a-door-and-opens-nothing"
   :act [[:rcon "execute as $BODY at @s run tp @s ~ ~ ~ 0 0"] [:wait-s 1] [:rcon "execute as $BODY at @s run tp @s ~ ~ ~ 90 0"] [:wait-s 1] [:rcon "execute as $BODY at @s run tp @s ~ ~ ~ 180 0"] [:wait-s 1] [:rcon "execute as $BODY at @s run tp @s ~ ~ ~ 270 0"] [:wait-s 1]
         [:until [:cli "quote" ["$body" "--world" "$world" "jobs.movement.go-to" {:pos #at [22 0 16] :range 1}] {:ok true :quote {:route {:found true}}}] 30]]
   :expect [{:no-event {:level :error} :for-s 2}]
   :after [[:block [16 0 16] "oak_door[half=lower,open=false]"] [:body-near [10.5 0 16.5] 1]]}
  {:name "quote-with-doors-never-finds-no-way-and-says-why"
   :act [[:rcon "execute as $BODY at @s run tp @s ~ ~ ~ 0 0"] [:wait-s 1] [:rcon "execute as $BODY at @s run tp @s ~ ~ ~ 90 0"] [:wait-s 1] [:rcon "execute as $BODY at @s run tp @s ~ ~ ~ 180 0"] [:wait-s 1] [:rcon "execute as $BODY at @s run tp @s ~ ~ ~ 270 0"] [:wait-s 1]
         [:until [:cli "quote" ["$body" "--world" "$world" "jobs.movement.go-to" {:pos #at [22 0 16] :range 1 :doors :never}] {:ok true :quote {:route {:found false}}}] 30]]
   :expect [{:no-event {:level :error} :for-s 2}]
   :after [[:block [16 0 16] "oak_door[half=lower,open=false]"] [:body-near [10.5 0 16.5] 1]]}]}
