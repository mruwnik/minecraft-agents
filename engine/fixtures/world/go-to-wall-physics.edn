;; go-to walks that press the body against block faces (cards a6b91b12, bad41ce81 and f4b1e2c47): the client box has one half-width for
;; client, planner and executor and no rise-first workaround, so a 1-high wall is climbed from the cell centre and from the face
;; itself, a wall is walked along and rounded at its corner, a ledge is jumped under a 3-high ceiling, and a 1-deep bank is climbed out
;; of the water. Each arrives with no go-to.walker-fault (a rejected position puts the walker off its plan) and no go-to.unstuck.
;; Should-fail: a 2-high wall across the whole plot with :ways #{:walk} is not jumped: the call ends unarrived, the body stays this side.
;; Stone floor at y -1; x 20 is the wall line; the body starts at x 16.5 unless a case says otherwise.
{:defaults
 {:tags [:movement :go-to :physics]
  :time :any
  :plot {:height 8}
  :body {:at [16.5 0 16.5] :settle-s 2 :effects [["resistance" 600 4]]}
  :limit-s 60}
 :cases
 [{:name "one-high-wall-from-the-cell-centre"
   :blocks [[:fill [20 0 0] [20 0 31] "stone"]]
   :act [[:job (jobs.movement.go-to {:pos #at [23 0 16] :range 0})]]
   :expect [{:event {:source :job :kind :result :data {:arrived true}} :within-s 40 :of-job true}
            {:no-event {:source :job :kind :walker-fault} :for-s 40 :of-job true :until {:source :job :kind :result :data {:arrived true}}}
            {:no-event {:source :job :kind :go-to.unstuck} :for-s 40 :of-job true :until {:source :job :kind :result :data {:arrived true}}}]
   :after [[:body-near [23.5 0 16.5] 1.5]]}
  ;; the body's box (half-width .31) touches the wall face at x 20
  {:name "one-high-wall-from-the-face"
   :blocks [[:fill [20 0 0] [20 0 31] "stone"]]
   :body {:at [19.69 0 16.5]}
   :act [[:job (jobs.movement.go-to {:pos #at [23 0 16] :range 0})]]
   :expect [{:event {:source :job :kind :result :data {:arrived true}} :within-s 40 :of-job true}
            {:no-event {:source :job :kind :walker-fault} :for-s 40 :of-job true :until {:source :job :kind :result :data {:arrived true}}}
            {:no-event {:source :job :kind :go-to.unstuck} :for-s 40 :of-job true :until {:source :job :kind :result :data {:arrived true}}}]
   :after [[:body-near [23.5 0 16.5] 1.5]]}
  ;; along a 2-high wall from its face and round its south end
  {:name "round-a-wall-corner-from-the-face"
   :blocks [[:fill [20 0 4] [20 1 20]  "stone"]]
   :body {:at [19.69 0 8.5]}
   :act [[:job (jobs.movement.go-to {:pos #at [22 0 8] :range 0})]]
   :expect [{:event {:source :job :kind :result :data {:arrived true}} :within-s 50 :of-job true}
            {:no-event {:source :job :kind :walker-fault} :for-s 50 :of-job true :until {:source :job :kind :result :data {:arrived true}}}
            {:no-event {:source :job :kind :go-to.unstuck} :for-s 50 :of-job true :until {:source :job :kind :result :data {:arrived true}}}]
   :after [[:body-near [22.5 0 8.5] 1.5]]
   :limit-s 70}
  ;; a ledge one up under a ceiling three above the lower floor (a head bump on the jump up would set the body back)
  {:name "ledge-jump-under-a-low-ceiling"
   :blocks [[:fill [20 0 14] [26 0 18] "stone"] [:fill [14 3 14] [28 3 18] "stone"]]
   :act [[:job (jobs.movement.go-to {:pos #at [24 1 16] :range 0})]]
   :expect [{:event {:source :job :kind :result :data {:arrived true}} :within-s 40 :of-job true}
            {:no-event {:source :job :kind :walker-fault} :for-s 40 :of-job true :until {:source :job :kind :result :data {:arrived true}}}
            {:no-event {:source :job :kind :go-to.unstuck} :for-s 40 :of-job true :until {:source :job :kind :result :data {:arrived true}}}]
   :after [[:body-near [24.5 1 16.5] 1.5]]}
  ;; 1-deep water at x 8..15, the bank at x 16 one block above its surface
  {:name "climb-out-of-one-deep-water-onto-a-bank"
   :blocks [[:fill [8 -2 4] [15 -2 28] "stone"] [:fill [8 -1 4] [15 -1 28] "water"] [:fill [16 0 4] [30 0 28] "stone"]]
   :body {:at [12.5 -1 16.5]}
   :act [[:job (jobs.movement.go-to {:pos #at [18 1 16] :range 0})]]
   :expect [{:event {:source :job :kind :result :data {:arrived true}} :within-s 40 :of-job true}
            {:no-event {:source :job :kind :walker-fault} :for-s 40 :of-job true :until {:source :job :kind :result :data {:arrived true}}}]
   :after [[:body-near [18.5 1 16.5] 1.5]]}
  ;; should fail: a 2-high wall right across the plot is no jump, and with walking only nothing is dug or built;
  ;; the wall closes into a ring on the plot edges so the next plot's floor is no way round
  {:name "two-high-wall-is-not-jumped"
   :blocks [[:fill [20 0 0] [20 1 31] "cobblestone"] [:fill [21 0 0] [31 1 0] "cobblestone"]
            [:fill [21 0 31] [31 1 31] "cobblestone"] [:fill [31 0 1] [31 1 30] "cobblestone"]]
   :act [[:until-seen {:block "cobblestone"} 10] [:job (jobs.movement.go-to {:pos #at [23 0 16] :range 0 :ways #{:walk}})]]
   :expect [{:event {:source :job :kind :result :data {:arrived false}} :within-s 40 :of-job true}
            {:no-event {:source :job :kind :walker-fault} :for-s 40 :of-job true :until {:source :job :kind :result :data {:arrived false}}}]
   :after [[:body-far [23.5 0 16.5] 4] [:block [20 0 16] "cobblestone"] [:block [20 1 16] "cobblestone"]]}]}
