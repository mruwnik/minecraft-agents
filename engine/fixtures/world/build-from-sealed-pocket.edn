;; Card 0e744215: build.from-plan started shut in a sealed pocket under the site (a pickaxe carried) walks with escalation and digs out;
;; its restricted walk ways (never dig through the build) left the body shut in with every cell given up unreachable (fixed by 6f4f6d08).
;; Stone mass x 8..30, z 8..30, y 0..14 (surface feet y 15); pocket x 12 z 20 at y 5..6, sealed; glowstone [19 14 19] lights the site (the plot is underground, dark); site: a dirt ring [18 15 18]-[20 16 20].
{:defaults
 {:tags [:build :movement] :time :any
  :plot {:height 24}
  :limit-s 260
  :blocks [[:fill [8 0 8] [30 14 30] "stone"] [:fill [12 5 20] [12 6 20] "air"] [:fill [19 14 19] [19 14 19] "glowstone"]]
  :body {:at [12.5 5 20.5] :inventory [["dirt" 64] ["stone_pickaxe" 1]] :effects [["resistance" 600 4]] :settle-s 4}}
 :cases
 [{:name "sealed-pocket-start-digs-out-and-builds"
   :plans [{:id "ring" :metadata {:by "$body"}
            :parts [{:id "walls" :outline [#at [18 15 18] #at [20 16 20]] :want "dirt"}]}]
   :act [[:job (jobs.build.from-plan {:plan "$plan:ring"})]]
   :expect [{:event {:source :job :kind :completed :data {:kind :done}} :within-s 240 :of-job true}]
   :after [[:block [18 15 18] "dirt"] [:block [20 16 20] "dirt"] [:block [19 15 20] "dirt"]]}
  {:name "sealed-pocket-walk-only-gives-up-shut-in"
   ;; card cbade1ca: walls behind the body never seen in the dark read as rock to the plans, so the give-up says shut in
   :act [[:job (jobs.movement.go-to {:pos #at [19 15 17] :range 1 :ways #{:walk :clear-seal}})]]
   :expect [{:event {:source :job :kind :stopped :data {:arrived false :shut-in true}} :within-s 90 :of-job true}]
   :after [[:body-near [12.5 5 20.5] 1]]}]}
