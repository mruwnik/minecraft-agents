;; jobs.items.obtain oak_log when the only tree seen cannot be used: cards 131c2afe (the tree is across a drop: the stop names the
;; walk's reason, not a bare "gathering was tried and ended :no-tree"), 3568b8b4 (a body shut in for the night with a tree seen
;; waits :dark; it does not stop no-source).
;; Cut-off case: stone plateaus x 8..15 and x 21..28 (top y 7) with a 5-wide chasm to the floor between; the tree stands on the far one;
;; the body has only an axe (no blocks to bridge, no pickaxe to dig a stair). Night case: a stone room with a glass window east, a tree outside.
;; Should-fail: both end without logs; the first stopped no-source naming "ended :none-seen (", the second only waits.
{:defaults
 {:tags [:items :obtain :fell-tree :jobs]
  :time :day :time-why :dawn-decision
  :plot {:height 18 :floor "grass_block"}
  :body {:at [16.5 0 16.5] :yaw 270 :settle-s 2 :inventory [["iron_axe" 1]] :effects [["resistance" 600 4]]}
  :limit-s 90}
 :cases
 [{:name "only-tree-across-a-drop-stops-naming-the-reason"
   :blocks [[:fill [8 0 8] [15 7 24] "stone"] [:fill [21 0 8] [28 7 24] "stone"]
            [:fill [25 8 16] [25 12 16] "oak_log"] [:fill [24 11 15] [26 13 17] "oak_leaves[persistent=true]"]]
   :body {:at [13.5 8 16.5]}
   :act [[:job (jobs.items.obtain {:item "oak_log" :count 2 :explore false})]]
   :expect [{:event {:source :job :kind :stopped :data {:reason :no-source :why [:contains "ended :none-seen (goal-cut-off)"]}} :within-s 80 :of-job true}]
   :after [[:block [25 8 16] "oak_log"] [:item "oak_log" 0]]}
  {:name "shut-in-at-night-with-a-tree-seen-waits-for-dawn"
   :time :night
   :register []
   :blocks [[:fill [13 0 13] [19 2 19] "stone"] [:fill [14 0 14] [18 1 18] "air"] [:fill [19 0 16] [19 1 16] "glass"]
            [:fill [26 0 16] [26 4 16] "oak_log"] [:fill [25 4 15] [27 5 17] "oak_leaves[persistent=true]"] [:set [26 4 16] "oak_log"]]
   :act [[:job (jobs.items.obtain {:item "oak_log" :count 2 :explore false})]]
   :expect [{:event {:source :job :kind :waiting :data {:reason :dark}} :within-s 40 :of-job true}
            {:no-event {:source :job :kind :stopped :data {:reason :no-source}} :for-s 40}]
   :after [[:block [26 0 16] "oak_log"] [:item "oak_log" 0] [:body-near [16.5 0 16.5] 2]]}]}
