;; Card e7945a33: start-only conditions are checked once, at the start. A hunt whose body is hurt below the risky-job health floor while the walk
;; to the cow goes on waits :low-health (it is a wait, the call goes on); it never ends condition-failed. Cow NoAI 16 blocks off.
;; Should-succeed: waiting :low-health, then the job is still listed and later completes or is still waiting. Should-fail: no stopped event.
{:defaults
 {:tags [:animals :hunt :conditions]
  :time :day
  :plot {:length 48 :width 32 :height 6}
  :body {:at [4.5 0 16.5] :inventory [["iron_sword" 1]] :settle-s 2}
  :limit-s 90}
 :cases
 [{:name "hurt-below-the-floor-mid-walk-waits-low-health-not-condition-failed"
   :act [[:summon "cow" [26.5 0 16.5] "{NoAI:1b}"]
         [:job (jobs.combat.hunt {:mob "cow" :count 1 :keep 0})]
         [:await {:source :job :kind :round_started} 20]
         [:rcon "damage $BODY 16 minecraft:generic"]]
   :expect [{:event {:source :job :kind :waiting :data {:reason :low-health}} :within-s 30 :of-job true}
            {:no-event {:source :job :kind :stopped :data {:kind :condition-failed}} :for-s 30 :of-job true}]
   :limit-s 60}]}
