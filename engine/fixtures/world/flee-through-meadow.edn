;; Card 762c0f6e: a zombie closes on an unarmed body standing at the edge of a meadow (poppies, cornflowers, short grass,
;; with a band of signs on the body's line). Open plot 64 long; mob NoAI with a helmet (no sun burn).
{:defaults
 {:tags [:hostile :survival :flee]
  :time :any
  :mobs :keep
  :plot {:length 64 :width 32 :height 8 :floor "grass_block"}
  :register [{:trigger :hostile-near :why "the mobs stand beyond the default radius" :args {:radius 12 :ranged-radius 20} :job (jobs.survival.respond-to-hostile {:settings {:jobs.lib.danger/hostile-radius 12}})}]
  :limit-s 90}
 :cases
 ;; Card 0b4303a2: on a meadow with real ground under it (three dirt layers over the cell's bedrock shell) the pit is the
 ;; cheapest answer, not the flight: priced at the body's spawn 20 km off (a death ~8900 s), pit 150, flee 1945, fight 8785.
 ;; The flee price is the walk (77 s there and back), ~11% death (the caught prior: 3 of 27 counted zombie flights from
 ;; full health died) and a 60% chance of meeting the zombie again; a pit is quick in dirt and nearly safe.
 [{:name "unarmed-body-digs-a-pit-in-the-meadow"
   :blocks [[:fill [0 0 0] [63 2 31] "dirt"]
            [:fill [0 3 0] [63 3 31] "grass_block"]
            [:fill [4 4 0] [28 4 31] "short_grass"]
            [:fill [6 4 4] [26 4 10] "poppy"]
            [:fill [6 4 22] [26 4 28] "cornflower"]
            [:fill [6 4 13] [26 4 19] "oak_sign"]]
   :body {:at [30.5 4 16.5] :effects [["resistance" 600 3]]}
   :act [[:summon "zombie" [36.5 4 16.5] "{NoAI:1b,equipment:{head:{id:\"minecraft:iron_helmet\",count:1}}}"]]
   :expect [{:event {:source :job :kind :hostile.decided :data {:decision :flee :cover :pit}} :within-s 30}
            {:event {:source :job :kind :retreat_sealed} :within-s 40}
            {:no-event {:source :body :kind :died} :for-s 40}]
   :limit-s 50}]}
