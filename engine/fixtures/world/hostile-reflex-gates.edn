;; Which reflex or fight takes a body with a hostile about. Cards 8e7ff6d6 (set alight by a small fireball beside a NoAI zombie: the
;; burning reflex yields to hostile-near, no extinguish standing still), 4bfba733 (needs-weapon waits 1500 ticks after dawn
;; and while a hostile is known within 40; put after the time set, else it fires in the settle), 55a1871b (the :hostiles attack's :leash: a hostile beyond it is not chased), 57f49df1
;; b74a043c ebac9484 (a provoked enderman, hit by the body through /damage: water first, else a roofed 2-high gap, else a
;; seal; never a fight), e6ba3d48 (a phantom near: seal in, no flight; NoAI, fire resistance for daylight). Mobs helmeted.
{:defaults
 {:tags [:hostile :survival :reflex]
  :time :any
  :mobs :keep
  :register [{:trigger :hostile-near :args {:radius 8 :ranged-radius 16}
              :job (jobs.survival.respond-to-hostile)}]
  :body {:at [16.5 0 16.5]}
  :limit-s 70}
 :cases
  ;; The gate holds only while the zombie is within 8: the flight soon passes 8 and burning rightly fires then, so the window is short.
 [{:name "set-alight-by-a-zombie-hostile-near-keeps-the-body"
   :register [{:trigger :burning :persistence :cooldown :cooldown-s 0 :job (jobs.survival.extinguish {:water-radius 6})}
              {:trigger :hostile-near :args {:radius 8 :ranged-radius 16}
               :job (jobs.survival.respond-to-hostile)}]
   :body {:effects [["resistance" 900 2]]}
   :act [[:summon "zombie" [20.5 0 16.5] "{NoAI:1b,equipment:{head:{id:\"minecraft:iron_helmet\",count:1}}}"]
         [:until-seen {:entity "zombie"} 10]
         [:rcon "execute at $BODY run summon small_fireball ~ ~2.5 ~ {Motion:[0.0,-1.0,0.0],power:[0.0,-0.1,0.0]}"]]
   :expect [{:event {:source :body :kind :hurt :data {:causes [:has "fire"]}} :within-s 30}
            {:event {:source :reflex :kind :fired :context {:reflex-id :hostile-near}} :within-s 15}
            {:no-event {:source :reflex :kind :fired :context {:reflex-id :burning}} :for-s 1.5}]
   :limit-s 50}
  {:name "needs-weapon-waits-the-dawn-grace"
   :time :day :time-why :dawn-decision
   :register []
   :act [[:time-set 23500]
         [:cli "triggers" ["$body" "--world" "$world" "put" "needs-weapon" "--trigger" "needs-weapon" "--persistence" "cooldown" "--cooldown-s" "600" "--job" "(jobs.items.obtain {:any-of [\"stone_sword\" \"wooden_sword\"] :count 1 :explore true})" "--by" "world-test"]]]
   :expect [{:no-event {:source :reflex :kind :fired :context {:reflex-id :needs-weapon}} :for-s 55}
            {:event {:source :reflex :kind :fired :context {:reflex-id :needs-weapon}} :within-s 120}]
   :limit-s 130}
  {:name "needs-weapon-holds-while-a-zombie-is-known"
   :time :day :time-why :dawn-decision
   :register []
   :act [[:summon "zombie" [26.5 0 16.5] "{NoAI:1b,equipment:{head:{id:\"minecraft:iron_helmet\",count:1}}}"]
         [:time-set 23500]
         [:cli "triggers" ["$body" "--world" "$world" "put" "needs-weapon" "--trigger" "needs-weapon" "--persistence" "cooldown" "--cooldown-s" "600" "--job" "(jobs.items.obtain {:any-of [\"stone_sword\" \"wooden_sword\"] :count 1 :explore true})" "--by" "world-test"]]
         [:wait-s 95]
         [:rcon "kill @e[type=zombie,tag=wt,$BOX]"]]
   :expect [{:no-event {:source :reflex :kind :fired :context {:reflex-id :needs-weapon}} :for-s 95}
            {:event {:source :reflex :kind :fired :context {:reflex-id :needs-weapon}} :within-s 170}]
   :limit-s 180}
  {:name "attack-leash-does-not-chase-past-it"
   :register []
   :body {:inventory [["iron_sword" 1]] :effects [["resistance" 600 4]] :yaw 270}
   :act [[:summon "zombie" [22.5 0 16.5] "{NoAI:1b,equipment:{head:{id:\"minecraft:iron_helmet\",count:1}}}"]
         [:until-seen {:entity "zombie"} 10]
         [:job (jobs.combat.attack {:targets :hostiles :radius 8 :settings {:jobs.lib.hostile-fight/leash 3}})]]
   :expect [{:event {:source :job :kind :waiting :data {:reason :no-target}} :within-s 20 :of-job true}
            {:no-event {:source :action :kind :started :data {:name "attack"}} :for-s 20}]
   :after [[:entities "type=zombie,tag=wt" [[0 0 0] [31 6 31]] 1] [:body-near [16.5 0 16.5] 3]]
   :limit-s 30}
  {:name "attack-within-the-leash-kills"
   :register []
   :body {:inventory [["iron_sword" 1]] :effects [["resistance" 600 4]]}
   :act [[:summon "zombie" [22.5 0 16.5] "{NoAI:1b,equipment:{head:{id:\"minecraft:iron_helmet\",count:1}}}"]
         [:until-seen {:entity "zombie"} 10]
         [:job (jobs.combat.attack {:targets :hostiles :radius 8})]]
   :expect [{:event {:source :action :kind :done :data {:name "attack" :status "hit"}} :within-s 20}
            {:event {:source :action :kind :done :data {:name "attack" :status "killed"}} :within-s 20}]
   :after [[:entities "type=zombie,tag=wt" [[0 0 0] [31 6 31]] 0]]
   :limit-s 40}
  {:name "provoked-enderman-no-shelter-body-seals"
   :body {:inventory [["dirt" 20]] :effects [["resistance" 900 4]]}
   :act [[:summon "enderman" [20.5 0 16.5] "{attributes:[{id:\"minecraft:movement_speed\",base:0}]}"]
         [:until-seen {:entity "enderman"} 10]
         [:rcon "damage @e[type=enderman,tag=wt,$BOX,limit=1] 1 minecraft:player_attack by $BODY"]]
   :expect [{:event {:source :job :kind :retreat_sealed} :within-s 40}
            {:no-event {:source :job :kind :child_started :data {:slot :fight}} :for-s 40}]
   :limit-s 50}
  {:name "provoked-enderman-water-near-body-steps-in"
   :blocks [[:fill [19 0 14] [23 0 18] "stone"] [:fill [20 0 15] [22 0 17] "water"]]
   :body {:inventory [["dirt" 20]] :effects [["resistance" 900 4]]}
   :act [[:summon "enderman" [11.5 0 16.5] "{attributes:[{id:\"minecraft:movement_speed\",base:0}]}"]
         [:until-seen {:entity "enderman"} 10]
         [:rcon "damage @e[type=enderman,tag=wt,$BOX,limit=1] 1 minecraft:player_attack by $BODY"]]
   :expect [{:event {:source :reflex :kind :fired :context {:reflex-id :hostile-near}} :within-s 20}
            {:no-event {:source :action :kind :started :data {:name "place"}} :for-s 30}]
   :after [[:body-near [21.5 0 16.5] 2]]
   :limit-s 40}
  {:name "provoked-enderman-roof-gap-body-walks-under"
   :register [{:trigger :hostile-near :args {:radius 16 :ranged-radius 16}
               :job (jobs.survival.respond-to-hostile {:settings {:jobs.lib.danger/hostile-radius 16 :jobs.lib.danger/ranged-radius 16}})}]
   :blocks [[:fill [20 0 14] [20 1 14] "stone"] [:fill [24 0 18] [24 1 18] "stone"] [:fill [20 2 14] [24 2 18] "stone"]]
   :body {:inventory [["dirt" 20]] :effects [["resistance" 900 4]]}
   :act [[:summon "enderman" [11.5 0 16.5] "{attributes:[{id:\"minecraft:movement_speed\",base:0}]}"]
         [:until-seen {:entity "enderman"} 10]
         [:rcon "damage @e[type=enderman,tag=wt,$BOX,limit=1] 1 minecraft:player_attack by $BODY"]]
   :expect [{:event {:source :reflex :kind :fired :context {:reflex-id :hostile-near}} :within-s 20}
            {:event {:source :job :kind :holding :data {:reason "under a roof, out of the enderman's reach"}} :within-s 30}
            {:no-event {:source :action :kind :started :data {:name "place"}} :for-s 30}]
   :limit-s 40}
  ;; card c0e1f21d: the roof gap beside the enderman is no place to run to; the hut 12 blocks the other way is
  {:name "provoked-enderman-far-roof-hut-body-runs-past-the-near-gap"
   :register [{:trigger :hostile-near :args {:radius 16 :ranged-radius 16}
               :job (jobs.survival.respond-to-hostile {:settings {:jobs.lib.danger/hostile-radius 16 :jobs.lib.danger/ranged-radius 16}})}]
   :blocks [[:fill [22 0 14] [22 1 14] "stone"] [:fill [26 0 18] [26 1 18] "stone"] [:fill [22 2 14] [26 2 18] "stone"]
            [:fill [3 0 14] [3 1 14] "stone"] [:fill [7 0 18] [7 1 18] "stone"] [:fill [3 2 14] [7 2 18] "stone"]]
   :body {:inventory [["dirt" 20]] :effects [["resistance" 900 4]]}
   :act [[:summon "enderman" [20.5 0 16.5] "{attributes:[{id:\"minecraft:movement_speed\",base:0}]}"]
         [:until-seen {:entity "enderman"} 10]
         [:rcon "damage @e[type=enderman,tag=wt,$BOX,limit=1] 1 minecraft:player_attack by $BODY"]]
   :expect [{:event {:source :job :kind :holding :data {:reason "under a roof, out of the enderman's reach"}} :within-s 35}
            {:no-event {:source :action :kind :started :data {:name "place"}} :for-s 30}]
   :after [[:body-near [5.5 0 16.5] 2.5]]
   :limit-s 45}
  ;; card 4e2615d0: an angry enderman that never leaves (speed 0) must not hold the body in water for ever: after hold-cap holds the flight moves on to the next options (roof, seal, or none left)
  {:name "staying-enderman-ends-the-water-hold-and-the-flight-ends"
   :settings {:jobs.survival.respond.options/hold-cap 2}
   :blocks [[:fill [14 0 14] [18 0 18] "stone"] [:fill [15 0 15] [17 0 17] "water"]]
   :body {:inventory [["dirt" 20]] :effects [["resistance" 900 4]]}
   :register []
   :act [[:summon "enderman" [20.5 0 16.5] "{attributes:[{id:\"minecraft:movement_speed\",base:0}]}"]
         [:until-seen {:entity "enderman"} 10]
         [:rcon "damage @e[type=enderman,tag=wt,$BOX,limit=1] 1 minecraft:player_attack by $BODY"]
         [:wait-s 1]
         [:job (jobs.survival.respond-to-hostile {})]]
   :expect [{:count-event {:source :job :kind :holding :data {:reason "in water, away from the enderman"}} :for-s 45 :at-least 1 :at-most 6 :of-job true}]
   :limit-s 60}
  ;; card ba8479cc: mobbed by a zombie, a skeleton and an angry enderman in a sealed stone hall with no water and no 2-high gap: the water and roof options find nothing and the flight falls through the options to the fight within seconds instead of holding on a search while hit
  {:name "mobbed-underground-by-enderman-zombie-skeleton-body-falls-back"
   :blocks [[:fill [10 -1 10] [24 3 22] "stone"] [:fill [11 0 11] [23 2 21] "air"] [:set [12 1 12] "torch"] [:set [22 1 20] "torch"]]
   :body {:inventory [["dirt" 20]] :effects [["resistance" 900 4]]}
   :register []
   :act [[:summon "enderman" [20.5 0 16.5] "{attributes:[{id:\"minecraft:movement_speed\",base:0}]}"]
         [:until-seen {:entity "enderman"} 10]
         [:rcon "damage @e[type=enderman,tag=wt,$BOX,limit=1] 1 minecraft:player_attack by $BODY"]
         [:summon "zombie" [18.5 0 16.5] "{equipment:{head:{id:\"minecraft:iron_helmet\",count:1}}}"]
         [:summon "skeleton" [22.5 0 19.5] "{equipment:{head:{id:\"minecraft:iron_helmet\",count:1}}}"]
         [:job (jobs.survival.respond-to-hostile {})]]
   :expect [{:event {:source :action :kind :started :data {:name "attack"}} :within-s 20}
            {:no-event {:source :job :kind :holding :data {:reason "searching"}} :for-s 20}
            {:no-event {:source :body :kind :died} :for-s 40}]
   :limit-s 60}
  ;; card ba8479cc: as above, but a 2-high roof gap seen through glass that no walk reaches: the roof option searches for it and gives up fast. Mobbed by a zombie, a skeleton and an angry enderman in a sealed stone hall with no water and no 2-high gap: the water and roof options find nothing and the flight falls through the options to the fight within seconds instead of holding on a search while hit
  {:name "mobbed-underground-by-enderman-zombie-skeleton-body-with-a-glassed-off-roof-gap-falls-back"
   :blocks [[:fill [10 -1 10] [24 3 22] "stone"] [:fill [11 0 11] [23 2 21] "air"] [:fill [18 0 10] [24 1 14] "glass"] [:fill [19 0 11] [23 1 13] "air"] [:fill [18 2 10] [24 2 14] "stone"] [:set [12 1 12] "torch"] [:set [22 1 20] "torch"]]
   :body {:inventory [["dirt" 20]] :effects [["resistance" 900 4]]}
   :register []
   :act [[:summon "enderman" [20.5 0 16.5] "{attributes:[{id:\"minecraft:movement_speed\",base:0}]}"]
         [:until-seen {:entity "enderman"} 10]
         [:rcon "damage @e[type=enderman,tag=wt,$BOX,limit=1] 1 minecraft:player_attack by $BODY"]
         [:summon "zombie" [18.5 0 16.5] "{equipment:{head:{id:\"minecraft:iron_helmet\",count:1}}}"]
         [:summon "skeleton" [22.5 0 19.5] "{equipment:{head:{id:\"minecraft:iron_helmet\",count:1}}}"]
         [:job (jobs.survival.respond-to-hostile {})]]
   :expect [{:event {:source :action :kind :started :data {:name "attack"}} :within-s 20}
            {:no-event {:source :job :kind :holding :data {:reason "searching"}} :for-s 20}
            {:no-event {:source :body :kind :died} :for-s 40}]
   :limit-s 60}
  {:name "phantom-near-unarmed-body-seals-no-flight"
   :body {:inventory [["cobblestone" 20]] :effects [["resistance" 900 4]]}
   :act [[:summon "phantom" [20.5 0 16.5] "{NoAI:1b,active_effects:[{id:\"minecraft:fire_resistance\",duration:99999}]}"]]
   :expect [{:event {:source :job :kind :hostile.decided :data {:mob "phantom"}} :within-s 20}
            {:event {:source :job :kind :retreat_sealed} :within-s 40}
            {:no-event {:source :job :kind :retreat.target} :for-s 40 :until {:source :job :kind :retreat_sealed}}]
   :after [[:body-near [16.5 0 16.5] 1.5]]
   :limit-s 50}
  ;; Card 3d042f6b: a fight begun with a phantom is not held at 3 hp (it outflies the body, but a roof stops it): flee, seal in.
  ;; The phantom has 100 hp so the fight outlasts the damage; hunger stops regeneration first.
  {:name "phantom-begun-fight-at-low-health-seals"
   :body {:inventory [["stone_sword" 1] ["cobblestone" 20]]}
   :act [[:summon "phantom" [20.5 0 16.5] "{NoAI:1b,Health:100f,attributes:[{id:\"minecraft:max_health\",base:100}],active_effects:[{id:\"minecraft:fire_resistance\",duration:99999}]}"]
         [:await {:source :job :kind :child_started :data {:slot :fight}} 20]
         [:rcon "effect give $BODY minecraft:hunger 5 255 true"] [:until-effect-gone "hunger" 30]
         [:rcon "damage $BODY 17 minecraft:generic"]]
   :expect [{:event {:source :job :kind :child_started :data {:slot :fight}} :within-s 20}
            {:event {:source :job :kind :hostile.decided :data {:mob "phantom" :decision :flee}} :within-s 45}
            {:event {:source :job :kind :retreat_sealed} :within-s 60}
            {:no-event {:source :body :kind :died} :for-s 60}]
   :limit-s 75}]}
