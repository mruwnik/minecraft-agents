;; Card 98767f9a (owner Q350): a cornered body tries every way that keeps off another's area before one that trespasses. With 4 blocks
;; the pillar would leave too few (lean), so the dig-down comes first; the doorway stands on a 5-thick stone slab so a pit fits.
;; Should-succeed: a foreign footprint in the pit column makes the pit a trespass, so the zone-keeping pillar goes up instead and no
;; shut-in.trespass-last-resort is said. Control: without the footprint the pit is tried first (plug-dig).
{:defaults
 {:tags [:hostile :survival :cornered :zones]
  :time :any
  :plot {:height 16}
  :blocks [[:fill [9 0 15] [11 4 19] "stone"] [:fill [9 5 15] [9 6 19] "stone"] [:fill [11 5 15] [11 6 19] "stone"] [:fill [10 5 15] [10 6 15] "stone"]]
  :register [{:trigger :hostile-near}]
  :body {:at [10.5 5 16.5] :inventory [["dirt" 4] ["iron_pickaxe" 1]]}
  :act [[:summon "zombie" [10.5 5 17.5] "{equipment:{head:{id:\"minecraft:iron_helmet\",count:1}}}"]]
  :limit-s 90}
 :cases
 [{:name "footprint-under-the-pit-so-the-pillar-keeps-off-it"
   :plans [{:id "z" :metadata {:by "SomeoneElse"} :parts [{:id "z" :box [#at [10 2 16] #at [10 4 16]] :want "stone"}]}]
   :expect [{:event {:source :job :kind :child_ended :data {:slot :pillar :status :done}} :within-s 60}
            {:no-event {:source :job :kind :shut-in.trespass-last-resort} :for-s 30}]
   :after [[:body-near [10.5 8 16.5] 3]]}
  {:name "no-footprint-digs-down"
   :expect [{:event {:source :job :kind :child_ended :data {:slot :plug-dig}} :within-s 60}]}]}
