;; Bed rule on open ground: an unroofed body at night still fires the :night reflex, skips a bed whose block state says occupied
;; (no sleep call on it, no :bed written). Roofed variant: bed-occupied-rule. A carried bed in the open: night-exposed-bed-retry.
;; The body faces the occupied bed (:yaw 90, west), since it only uses a bed it has seen.
;; Needs night: run with --allow-time --time-log <the shared time log>, one case per call (--match).
{:defaults
 {:tags [:night :survival :sleep]
  :time :night-exclusive
  :register [{:trigger :night}]
  :blocks [[:set [13 0 16] "red_bed[facing=east,part=foot,occupied=true]"] [:set [14 0 16] "red_bed[facing=east,part=head,occupied=true]"]]
  :body {:at [16.5 0 16.5] :yaw 90 :effects [["resistance" 600 4]] :settle-s 3}}
 :cases
 [{:name "occupied-bed-skipped-in-the-open"
   :expect [{:event {:source :reflex :kind :fired :context {:reflex-id :night}} :within-s 40}
            {:no-event {:source :action :kind :started :data {:name "sleep"}} :for-s 40}
            {:no-event {:source :job :kind :place.set :data {:name :bed}} :for-s 40}]
   :after [[:body-near [16.5 0 16.5] 1.5]]
   :limit-s 60}]}
