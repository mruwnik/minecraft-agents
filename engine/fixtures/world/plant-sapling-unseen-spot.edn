;; Card 0be2871a: jobs.forestry.plant-sapling given a spot the body has not seen yet (behind it) looks at the spot and plants, and
;; plants; a spot walled in stone stays unseen: nothing planted, the place child's ending is the job's.
;; Grass plot, body at [16.5 0 20.5] looking south (yaw 0), carrying an oak sapling; the spot [16 0 12] is behind it.
{:defaults
 {:tags [:forestry :plant-sapling :sensing :jobs]
  :plot {:height 10 :floor "grass_block"}
  :body {:at [16.5 0 20.5] :yaw 0 :inventory [["oak_sapling" 2]] :effects [["resistance" 600 4]] :settle-s 2}
  :limit-s 80}
 :cases
 [{:name "spot-behind-the-body-is-looked-at-and-planted"
   :act [[:job (jobs.forestry.plant-sapling {:at #at [16 0 12] :species "oak"})]]
   :expect [{:event {:source :job :kind :completed} :within-s 60 :of-job true}]
   :after [[:block [16 0 12] "oak_sapling"]]}
  {:name "spot-walled-in-stone-is-never-seen-and-not-planted"
   :blocks [[:fill [15 0 11] [17 3 13] "stone" :hollow]]
   :act [[:job (jobs.forestry.plant-sapling {:at #at [16 0 12] :species "oak"})]]
   :expect [{:event {:source :job :kind :stopped} :within-s 60 :of-job true}]
   :after [[:not-block [16 0 12] "oak_sapling"] [:item "oak_sapling" 2]]}]}
