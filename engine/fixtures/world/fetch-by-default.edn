;; Card 88a7e29c: a job that starts without the item it needs fetches it from a chest the body has seen, by default, through its need child.
;; Should-succeed: animals.tend with no wheat carried fetches it for the breed step; leave-tunnel with no block to seal with fetches cobblestone
;; and shuts the mouth (:sealed); apiary.maintain with no shears fetches them and harvests the ripe, smoked hive.
;; Should-fail (control): leave-tunnel with :fetch false leaves the mouth open.
{:defaults
 {:tags [:fetch :jobs]
  :plot {:floor "grass_block" :height 12}
  :body {:at [16.5 0 16.5] :settle-s 2 :effects [["resistance" 600 4]]}
  :limit-s 150}
 :cases
 [{:name "tend-fetches-wheat-for-the-breed-step"
   :tags [:animals :tend]
   :blocks [[:set [14 0 19] "chest{Items:[{Slot:0b,id:\"minecraft:wheat\",count:8}]}"]]
   :act [[:summon "cow" [20.5 0 12.5]] [:summon "cow" [21.5 0 12.5]]
         [:rcon "execute as $BODY at @s run tp @s ~ ~ ~ 0 20"]
         [:job (jobs.animals.tend {:mob "cow" :target 4 :box {:min #xyz [17 0 9] :max #xyz [25 0 16]}})]]
   :expect [{:event {:source :job :kind :child_ended :data {:slot :need :status :done}} :within-s 70 :of-job true}
            {:event {:source :job :kind :completed} :within-s 140 :of-job true}]
   :after [[:item "wheat" [:< 8]]]}
  {:name "leave-tunnel-fetches-blocks-to-seal-the-mouth"
   :tags [:access :mining]
   :time :any
   :plot {:floor "stone" :height 8}
   :blocks [[:fill [13 0 8] [24 4 24] "stone"] [:fill [13 0 20] [22 1 20] "air"]
            [:set [12 0 21] "chest{Items:[{Slot:0b,id:\"minecraft:cobblestone\",count:16}]}"]]
   :body {:at [20.5 0 20.5] :inventory [["stone_pickaxe" 1]]}
   :act [[:job (jobs.access.leave-tunnel {:tunnel {:line {:entry #at [12 0 20] :heading :east :dir :down :steps 0 :run 9
                                                          :stand #at [21 0 20] :target #at [22 0 20]}
                                                   :dug [{:cell #at [13 0 20] :block "stone"} {:cell #at [14 0 20] :block "stone"} {:cell #at [15 0 20] :block "stone"} {:cell #at [13 1 20] :block "stone"} {:cell #at [14 1 20] :block "stone"} {:cell #at [15 1 20] :block "stone"}]
                                                   :torches []}})]]
   :expect [{:event {:source :job :kind :leave-tunnel.done :data {:reason :sealed}} :within-s 140 :of-job true}
            {:no-event {:source :job :kind :leave-tunnel.open} :for-s 140 :until {:source :job :kind :leave-tunnel.done} :of-job true}]}
  {:name "leave-tunnel-fetch-false-leaves-the-mouth-open"
   :tags [:access :mining]
   :time :any
   :plot {:floor "stone" :height 8}
   :blocks [[:fill [13 0 8] [24 4 24] "stone"] [:fill [13 0 20] [22 1 20] "air"]
            [:set [12 0 21] "chest{Items:[{Slot:0b,id:\"minecraft:cobblestone\",count:16}]}"]]
   :body {:at [20.5 0 20.5] :inventory [["stone_pickaxe" 1]]}
   :act [[:job (jobs.access.leave-tunnel {:fetch false :tunnel {:line {:entry #at [12 0 20] :heading :east :dir :down :steps 0 :run 9
                                                          :stand #at [21 0 20] :target #at [22 0 20]}
                                                   :dug [{:cell #at [13 0 20] :block "stone"} {:cell #at [14 0 20] :block "stone"} {:cell #at [15 0 20] :block "stone"} {:cell #at [13 1 20] :block "stone"} {:cell #at [14 1 20] :block "stone"} {:cell #at [15 1 20] :block "stone"}]
                                                   :torches []}})]]
   :expect [{:event {:source :job :kind :leave-tunnel.open} :within-s 140 :of-job true}
            {:no-event {:source :job :kind :leave-tunnel.done} :for-s 140 :until {:source :job :kind :leave-tunnel.open} :of-job true}]}
  {:name "apiary-maintain-fetches-shears-and-harvests"
   :tags [:apiary]
   :plot {:floor "stone" :height 8}
   :blocks [[:set [14 0 10] "campfire[lit=true]"] [:set [14 1 10] "beehive[honey_level=5]"]
            [:set [8 0 13] "chest{Items:[{Slot:0b,id:\"minecraft:shears\",count:1}]}"]]
   :body {:at [6.5 0 16.5] :yaw 180}
   :act [[:job (jobs.apiary.maintain {:radius 20})]]
   :expect [{:event {:source :job :kind :completed} :within-s 130 :of-job true}]
   :after [[:block [14 1 10] "beehive[honey_level=0]"] [:item "honeycomb" [:>= 3]]]}]}
