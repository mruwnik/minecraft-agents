;; The night hold (jobs.survival.night, hungry reflexes cannot reach a held body) eats and cooks: cards 08af40de, d6d5acb3.
;; A walled stone yard x 8..16, z 8..16 with no roof and no bed, the body inside with no tool or block to dig in or build with and hungry by
;; RCON (food 8, hp 15): the night can shelter nowhere (a roofed body with nothing to do ends its night, so the hold needs an exposed
;; one), so it holds exposed, and the hold eats and cooks. Needs night: run with --allow-time --time-log <the shared time log>.
;; Should-succeed: raw beef is smelted at the furnace inside the yard, then eaten (shelter.ate).
;; Should-fail: carrots reserved as bait are not eaten while food is above 3; the body keeps all of them.
{:defaults
 {:tags [:night :survival :get-food :cook]
  :time :night
  :plot {:height 6}
  :blocks [[:fill [8 0 8] [16 3 16] "stone" :hollow] [:fill [9 0 9] [15 2 15] "air"]
           [:set [9 1 9] "torch"] [:set [15 1 15] "torch"] [:fill [8 3 8] [16 3 16] "air"]]
  :body {:at [12.5 0 12.5] :settle-s 2}
  :act [[:rcon "effect give $BODY minecraft:hunger 5 243 true"] [:until-effect-gone "hunger" 30]
        [:rcon "damage $BODY 5 minecraft:generic"]
        [:job (jobs.survival.night {})]]
  :limit-s 120}
 :cases
 [{:name "hold-cooks-beef-at-the-furnace-inside-then-eats"
   :blocks [[:set [10 0 10] "furnace[facing=south]"]]
   :body {:inventory [["beef" 2] ["coal" 2]]}
   :expect [{:event {:source :job :kind :child_ended :data {:slot :cook :ending {:kind :done}}} :within-s 90}
            {:event {:source :job :kind :shelter.ate} :within-s 100}]
   :after [[:item "beef" 0]]}
  ;; 08af40de: a furnace just outside the wall is not a furnace of the shelter: the hold does not walk out to it at night
  {:name "hold-does-not-walk-out-to-a-furnace-beyond-the-wall"
   :blocks [[:set [17 0 13] "furnace[facing=west]"]]
   :body {:inventory [["beef" 2] ["coal" 2]]}
   :expect [{:event {:source :job :kind :holding} :within-s 60 :of-job true}
            {:no-event {:source :job :kind :child_ended :data {:slot :cook :ending {:kind :done}}} :for-s 60}]
   :after [[:body-near [12.5 0 12.5] 4]]
   :limit-s 80}
  {:name "hold-leaves-reserved-bait-carrots-alone"
   :body {:inventory [["carrot" 6]]}
   :memory [{:kind :reserve :data {:id "wt-bait" :item "carrot" :count :all :strength 0.8} :policy {:cap 100 :ttl :forever}}]
   :expect [{:event {:source :job :kind :holding} :within-s 60 :of-job true}
            {:no-event {:source :job :kind :shelter.ate} :for-s 50}]
   :after [[:item "carrot" 6]]
   :limit-s 80}]}
