;; Card 1aed29ba: clear-cells of granite with no pickaxe makes one first (cobblestone + sticks carried, a crafting table beside) and never digs it by hand.
;; Should-succeed: the granite is dug out and the job completes.
{:defaults
 {:tags [:build :dig]
  :time :any
  :plot {:height 14 :floor "grass_block"}
  :blocks [[:fill [2 0 2] [12 3 12] "granite"] [:fill [6 0 3] [6 1 5] "air"] [:set [5 0 3] "crafting_table"]]
  :body {:at [6.5 0 3.5] :effects [["resistance" 900 4]]}
  :limit-s 400}
 :cases
 [{:name "makes-a-pickaxe-before-digging-granite"
   :body {:at [6.5 0 3.5] :inventory [["cobblestone" 5] ["stick" 3]] :effects [["resistance" 900 4]]}
   :act [[:job (jobs.blocks.clear-cells {:area {:min #at [7 0 3] :max #at [8 1 4]}})]]
   :expect [{:event {:source :job :kind :completed :data {:dug 8}} :within-s 300 :of-job true}]
   :after [[:block [7 0 3] "air"] [:block [8 1 4] "air"]]}]}
