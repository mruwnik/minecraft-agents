;; Card 40c6db41: memory.remember, set-place, forget-place and explore.look declare bad arguments as a condition, so the call refuses with the
;; reason named and runs no round. Should-fail: a reserved kind, a position far above the world and an unknown block name each stop or wait with a
;; reason and start no round. Should-succeed: valid args complete; forgetting an unrecorded place ends cleanly.
{:defaults
 {:tags [:conditions :memory :explore :jobs]
  :time :any
  :plot {:height 8}
  :body {:at [16.5 0 16.5] :effects [["resistance" 600 4]] :settle-s 2}
  :limit-s 40}
 :cases
 [{:name "remember-a-reserved-kind-is-refused-without-a-round"
   :act [[:job (jobs.memory.remember {:kind :hurt})]]
   :expect [{:event {:source :job :kind #{:waiting :stopped} :data {:reason [:any]}} :within-s 20 :of-job true}
            {:no-event {:source :job :kind :round_started} :for-s 5 :of-job true}]}
  {:name "set-place-far-above-the-world-is-refused-without-a-round"
   :act [[:job (jobs.memory.set-place {:name :wt-far :pos #at [2 999 3]})]]
   :expect [{:event {:source :job :kind #{:waiting :stopped} :data {:reason [:any]}} :within-s 20 :of-job true}
            {:no-event {:source :job :kind :round_started} :for-s 5 :of-job true}]}
  {:name "look-for-a-bogus-block-name-is-refused-without-a-round"
   :act [[:job (jobs.explore.look {:block-names ["bogus"]})]]
   :expect [{:event {:source :job :kind #{:waiting :stopped} :data {:reason [:any]}} :within-s 20 :of-job true}
            {:no-event {:source :job :kind :round_started} :for-s 5 :of-job true}]}
  {:name "valid-remember-and-look-complete"
   :act [[:job (jobs.memory.remember {:kind :wt-note :data {:n 1}})]
         [:await {:source :job :kind :completed} 20]
         [:job (jobs.explore.look {:block-names ["stone"]})]]
   :expect [{:event {:source :job :kind :completed} :within-s 30 :of-job true}]}
  {:name "forget-place-of-an-unrecorded-name-ends-cleanly"
   :act [[:job (jobs.memory.forget-place {:name :wt-never-set})]]
   :expect [{:event {:source :job :kind :completed} :within-s 20 :of-job true}
            {:no-event {:source :job :kind :failed} :for-s 5 :of-job true}]}]}
