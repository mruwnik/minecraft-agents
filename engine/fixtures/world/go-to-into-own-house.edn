;; Card 7f632862 (Tamsin H11): go-to's goal inside a plan the body made never cuts that plan to get in; its put-back would never
;; be made (the holes stay the stand and the way in). Hut: dirt shell x 2..8, z 2..8, y 0..1, roof y 2 (plan "home", the
;; body's), door gap [2 0 5]/[2 1 5] on the west wall; the body stands in a closet [9 0 5] of a stone block x 9..13, y 0..3,
;; z 2..8, its west side the hut's east wall [8 0 5]/[8 1 5]. Cutting that wall is the cheap way; old go-to took it.
{:defaults
 {:tags [:movement :go-to :places]
  :time :any
  :plot {:height 8 :light :lit}
  :blocks [[:fill [2 0 2] [8 2 8] "dirt"] [:fill [3 0 3] [7 1 7] "air"]
           [:fill [9 0 2] [13 3 8] "stone"] [:fill [9 0 5] [9 1 5] "air"]]
  :plans [{:id "home" :metadata {:by "$body"} :parts [{:id "shell" :box [#at [2 0 2] #at [8 2 8]] :want "dirt"}]}]
  :body {:at [9.5 0 5.5] :settle-s 2 :effects [["resistance" 600 4]] :inventory [["stone_pickaxe" 1]]}
  :limit-s 150}
 :cases
 [;; should-succeed: digs out of the closet through stone and walks in by the door; no cell of the hut is dug
  {:name "goes-round-to-its-door"
   :blocks [[:fill [2 0 5] [2 1 5] "air"]]
   :act [[:job (jobs.movement.go-to {:worth 1200 :pos #at [5 0 5] :range 1})]]
   :expect [{:event {:source :job :kind :completed :context {:chain [[:any]]} :data {:arrived true}} :within-s 140 :of-job true}
            {:no-event {:source :job :kind :go-to.dug-own-build} :for-s 140 :of-job true}]
   :after [[:block [8 0 5] "dirt"] [:block [8 1 5] "dirt"] [:body-near [5.5 0 5.5] 2]]}
  ;; should-stop: a hut with no door is not cut open to get in
  {:name "doorless-own-hut-is-not-cut"
   :act [[:job (jobs.movement.go-to {:worth 1200 :pos #at [5 0 5] :range 1})]]
   :expect [{:event {:source :job :kind :stopped} :within-s 140 :of-job true}
            {:no-event {:source :job :kind :go-to.dug-own-build} :for-s 140 :of-job true}]
   :after [[:block [8 0 5] "dirt"] [:block [8 1 5] "dirt"] [:block [2 0 5] "dirt"]]}]}
