;; Card d00cfcb6: animals.maintain with the herd at target completes :done and reports the census it counted. Box x 10..14, z 10..14; two adult cows inside, :target 2.
;; Should-succeed: the completion names {:adults 2 :babies 0 :target 2}.
;; mends-a-blown-fence-cell: card e43936a3, a planned fence cell seen as air is built again by maintain's first step (body outside the ring, 4 fence carried).
{:defaults
 {:tags [:animals :jobs]
  :time :any
  :plot {:floor "grass_block"}
  :blocks [[:fill [9 0 9] [15 0 15] "oak_fence" :outline]]
  :body {:at [12.5 0 12.5] :yaw 0 :effects [["resistance" 600 4]]}
  :limit-s 60}
 :cases
 [{:name "at-target-waits-with-the-census"
   :act [[:summon "cow" [11.5 0 11.5]]
         [:summon "cow" [13.5 0 13.5]]
         [:job (jobs.animals.maintain {:mob "cow" :target 2 :box {:min #xyz [10 0 10] :max #xyz [14 0 14]}})]]
   :expect [{:event {:source :job :kind :completed :data {:kind :done :adults 2 :babies 0 :target 2}} :within-s 40 :of-job true}]}
  {:name "mends-a-blown-fence-cell"
   :plans [{:id "pen" :metadata {:by "$body"}
            :parts [{:id "fence" :outline [#at [9 0 9] #at [15 0 15]] :want "oak_fence"}
                    {:id "cows" :box [#at [10 0 10] #at [14 0 14]] :want "air" :herd {:mob "cow" :target 0}}]}]
   :blocks [[:fill [9 0 9] [15 0 15] "oak_fence" :outline] [:set [9 0 12] "air"]]
   :body {:at [7.5 0 12.5] :inventory [["oak_fence" 4]] :yaw 270 :effects [["resistance" 600 4]]}
   :act [[:job (jobs.animals.maintain {:plan "$plan:pen" :part "cows"})]]
   :expect [{:event {:source :job :kind :completed :data {:kind :done}} :within-s 90 :of-job true}]
   :after [[:block [9 0 12] "oak_fence"]]}]}
