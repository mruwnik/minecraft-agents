;; Card 617586af: go-to weighs a stair up against a long priced walk. A goal 8+ above the feet, :escalate on and a first plan whose priced cost
;; (dark, danger, tolls) exceeds 3 x 3 s x the stair steps: the stair escalation runs first, once. Stone mass x 2..61, y 0..13; the body at
;; the west end of a 40-cell tunnel (feet y 0), a climbing corridor of 10 steps at its east end, a link and a return corridor (feet y 10, z 16, above the tunnel)
;; to the goal 10 east and 10 above the body. A stair is cut at most 8 steps (escape max-depth), so it ends 2 below the corridor
;; level and the body cuts a second stair from its top (card 2da70080).
;; Foreign zones over the tunnel and the return corridor toll them (the zone-tolls setting, on by default): a walk of about 105 cells against a stair.
;; Should-succeed: the stair is dug (go-to.escalated :stair) and the body arrives. Should-fail (control): :escalate false walks the long way, nothing is dug;
;; the detour floor is raised because most of that way is unseen.
{:defaults
 {:tags [:movement :go-to :planner]
  :time :any
  :plot {:length 64 :height 16}
  :blocks [[:fill [2 0 2] [61 13 29] "stone"]
           [:fill [3 0 16] [44 1 16] "air"] [:set [44 2 16] "air"]
           ;; wall torches light the sealed corridors: unlit cells count as seen only within 4
           [:set [8 1 15] "wall_torch[facing=south]"] [:set [18 1 15] "wall_torch[facing=south]"] [:set [28 1 15] "wall_torch[facing=south]"] [:set [38 1 15] "wall_torch[facing=south]"] [:set [46 3 15] "wall_torch[facing=south]"] [:set [50 7 15] "wall_torch[facing=south]"] [:set [53 10 15] "wall_torch[facing=south]"] [:set [55 11 17] "wall_torch[facing=west]"] [:set [49 11 19] "wall_torch[facing=north]"] [:set [20 11 15] "wall_torch[facing=south]"] [:set [30 11 15] "wall_torch[facing=south]"] [:set [40 11 15] "wall_torch[facing=south]"]]
  :zones [{:name "tunnel" :min [3 0 16] :max [44 0 16] :owner "SomeoneElse"}
          {:name "top" :min [16 10 16] :max [54 10 16] :owner "SomeoneElse"}]
  :body {:at [4.5 0 16.5] :yaw 270 :settle-s 2 :effects [["resistance" 600 4]] :inventory [["stone_pickaxe" 1]]}
  :limit-s 200}
 :cases
 [{:name "stair-up-instead-of-the-long-tolled-walk"
   :blocks [[:fill [45 1 16] [45 3 16] "air"] [:fill [46 2 16] [46 4 16] "air"] [:fill [47 3 16] [47 5 16] "air"] [:fill [48 4 16] [48 6 16] "air"] [:fill [49 5 16] [49 7 16] "air"] [:fill [50 6 16] [50 8 16] "air"] [:fill [51 7 16] [51 9 16] "air"] [:fill [52 8 16] [52 10 16] "air"] [:fill [53 9 16] [53 11 16] "air"] [:fill [54 10 16] [54 11 18] "air"] [:fill [44 10 18] [54 11 18] "air"] [:fill [14 10 16] [44 11 16] "air"] [:fill [44 10 17] [44 11 17] "air"]]
   :act [[:job (jobs.movement.go-to {:pos #at [14 10 16] :range 1})]]
   :expect [{:event {:source :job :kind :go-to.escalated :data {:step :stair}} :within-s 90 :of-job true}
            {:event {:source :job :kind :completed :context {:chain [[:any]]} :data {:arrived true}} :within-s 180 :of-job true}]
   :after [[:body-near [14.5 10 16.5] 2.5]]}
  {:name "escalate-false-walks-the-long-way"
   :blocks [[:fill [45 1 16] [45 3 16] "air"] [:fill [46 2 16] [46 4 16] "air"] [:fill [47 3 16] [47 5 16] "air"] [:fill [48 4 16] [48 6 16] "air"] [:fill [49 5 16] [49 7 16] "air"] [:fill [50 6 16] [50 8 16] "air"] [:fill [51 7 16] [51 9 16] "air"] [:fill [52 8 16] [52 10 16] "air"] [:fill [53 9 16] [53 11 16] "air"] [:fill [54 10 16] [54 11 18] "air"] [:fill [44 10 18] [54 11 18] "air"] [:fill [14 10 16] [44 11 16] "air"] [:fill [44 10 17] [44 11 17] "air"]]
   :act [[:job (jobs.movement.go-to {:pos #at [14 10 16] :range 1 :ways #{:walk :clear-seal} :settings {:jobs.movement.go-to.detour/floor 200}})]]
   :expect [{:event {:source :job :kind :completed :context {:chain [[:any]]} :data {:arrived true}} :within-s 180 :of-job true}
            {:no-event {:source :job :kind :go-to.escalated} :for-s 180 :until {:source :job :kind :completed :data {:arrived true}}}]
   :after [[:body-near [14.5 10 16.5] 2.5]]}]}
