;; Card 617586af: go-to weighs a stair up against a long priced walk. A goal 8+ above the feet, :escalate on and a first plan whose priced cost
;; (dark, danger, tolls) exceeds 3 x 3 s x the stair steps: the stair escalation runs first, once. Stone mass x 2..61, y 0..13; the body at
;; the west end of a 40-cell tunnel (feet y 0), a climbing corridor of 8 steps at its east end, a link and a return corridor (feet y 8, z 24)
;; to the goal 10 east, 8 above and 8 south of the body: the stair the body cuts (8 steps south) ends in the return corridor.
;; Foreign zones over the tunnel and the return corridor toll them (the zone-tolls setting, on by default): a walk of about 95 cells against an 8-step stair.
;; Should-succeed: the stair is dug (go-to.escalated :stair) and the body arrives. Should-fail (control): :escalate false walks the long way, nothing is dug;
;; the detour floor is raised because most of that way is unseen.
{:defaults
 {:tags [:movement :go-to :planner]
  :time :any
  :plot {:length 64 :height 16}
  :blocks [[:fill [2 0 2] [61 13 29] "stone"]
           [:fill [3 0 16] [44 1 16] "air"] [:set [44 2 16] "air"]
           ;; wall torches light the sealed corridors: unlit cells count as seen only within 4
           [:set [8 1 15] "wall_torch[facing=south]"] [:set [18 1 15] "wall_torch[facing=south]"] [:set [28 1 15] "wall_torch[facing=south]"] [:set [38 1 15] "wall_torch[facing=south]"] [:set [46 3 15] "wall_torch[facing=south]"] [:set [50 7 15] "wall_torch[facing=south]"] [:set [51 9 20] "wall_torch[facing=east]"] [:set [20 9 23] "wall_torch[facing=south]"] [:set [30 9 23] "wall_torch[facing=south]"] [:set [40 9 23] "wall_torch[facing=south]"] [:set [50 9 23] "wall_torch[facing=south]"]]
  :zones [{:name "tunnel" :min [3 0 16] :max [44 0 16] :owner "SomeoneElse"}
          {:name "top" :min [16 8 24] :max [52 8 24] :owner "SomeoneElse"}]
  :body {:at [4.5 0 16.5] :yaw 270 :settle-s 2 :effects [["resistance" 600 4]] :inventory [["stone_pickaxe" 1]]}
  :limit-s 200}
 :cases
 [{:name "stair-up-instead-of-the-long-tolled-walk"
   :blocks [[:fill [45 1 16] [45 3 16] "air"] [:fill [46 2 16] [46 4 16] "air"] [:fill [47 3 16] [47 5 16] "air"] [:fill [48 4 16] [48 6 16] "air"] [:fill [49 5 16] [49 7 16] "air"] [:fill [50 6 16] [50 8 16] "air"] [:fill [51 7 16] [51 9 16] "air"] [:fill [52 8 16] [52 10 16] "air"] [:fill [52 8 16] [52 9 24] "air"] [:fill [3 8 24] [52 9 24] "air"]]
   :act [[:job (jobs.movement.go-to {:pos #at [14 8 24] :range 1})]]
   :expect [{:event {:source :job :kind :go-to.escalated :data {:step :stair}} :within-s 90 :of-job true}
            {:event {:source :job :kind :completed :data {:arrived true}} :within-s 180 :of-job true}]
   :after [[:body-near [14.5 8 24.5] 2.5]]}
  {:name "escalate-false-walks-the-long-way"
   :blocks [[:fill [45 1 16] [45 3 16] "air"] [:fill [46 2 16] [46 4 16] "air"] [:fill [47 3 16] [47 5 16] "air"] [:fill [48 4 16] [48 6 16] "air"] [:fill [49 5 16] [49 7 16] "air"] [:fill [50 6 16] [50 8 16] "air"] [:fill [51 7 16] [51 9 16] "air"] [:fill [52 8 16] [52 10 16] "air"] [:fill [52 8 16] [52 9 24] "air"] [:fill [3 8 24] [52 9 24] "air"]]
   :act [[:job (jobs.movement.go-to {:pos #at [14 8 24] :range 1 :ways #{:walk :clear-seal} :settings {:jobs.movement.go-to.detour/floor 200}})]]
   :expect [{:event {:source :job :kind :completed :data {:arrived true}} :within-s 180 :of-job true}
            {:no-event {:source :job :kind :go-to.escalated} :for-s 180 :until {:source :job :kind :completed :data {:arrived true}}}]
   :after [[:body-near [14.5 8 24.5] 2.5]]}]}
