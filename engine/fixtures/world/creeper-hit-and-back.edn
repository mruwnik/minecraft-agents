;; Card a1d61f69 (owner Q375): an armed, healthy body fights a lone creeper hit-and-back (waits for it, hits, steps out of the blast,
;; hits again) instead of fleeing it; an unarmed body still flees, and a flight from a creeper 3 blocks off with its goal at 66 degrees
;; steps away from it (card f989dad2) instead of passing it on a tangent.
;; Closed lit arena: stone shell x 4..28, z 4..28, glowstone roof (light 15, nothing spawns). Creeper with its own AI.
{:defaults
 {:tags [:hostile :survival :combat :creeper]
  :time :any
  :mobs :keep
  :register [{:trigger :hostile-near :args {:radius 8 :ranged-radius 16}
              :job (jobs.survival.respond-to-hostile)}]
  :blocks [[:fill [4 0 4] [28 4 28] "stone" :hollow] [:fill [5 0 5] [27 3 27] "air"] [:fill [5 4 5] [27 4 27] "glowstone"]]
  :body {:at [16.5 0 16.5]}
  :limit-s 60}
 :cases
 [{:name "sword-body-fights-a-lone-creeper-hit-and-back-and-keeps-its-health"
   :body {:inventory [["stone_sword" 1]] :effects []}
   :act [[:summon "creeper" [20.5 0 16.5]]]
   :expect [{:event {:source :job :kind :hostile.decided :data {:mob "creeper" :decision :fight}} :within-s 8}
            {:no-event {:source :job :kind :hostile.decided :data {:decision :flee}} :for-s 25}
            {:no-event {:source :body :kind :hurt :data {:health [:<= 10]}} :for-s 25}]
   :after [[:entities "type=creeper,tag=wt" [[0 0 0] [31 6 31]] 0]]
   :limit-s 45}
  {:name "fist-body-still-flees-a-creeper"
   :act [[:summon "creeper" [20.5 0 16.5]]]
   :expect [{:event {:source :job :kind :hostile.decided :data {:mob "creeper" :decision :flee}} :within-s 8}
            {:no-event {:source :job :kind :child_started :data {:slot :fight}} :for-s 8}]
   :limit-s 30}
  {:name "flight-from-a-near-creeper-steps-away-from-a-goal-on-its-side"
   :act [[:job (jobs.movement.go-to {:pos #at [20 0 25] :range 1})]
         [:wait-s 1]
         [:summon "creeper" [19.5 0 16.5]]]
   :expect [{:event {:source :job :kind :hostile.decided :data {:mob "creeper" :decision :flee}} :within-s 10}
            {:no-event {:source :body :kind :hurt} :for-s 8}]
   :limit-s 40}
  ;; A 1-wide lit tunnel x 9..27 at z 16 (glowstone roof), no resistance: a blast would show.
  {:name "sword-body-at-low-health-flees-a-creeper-in-a-tunnel"
   :blocks [[:fill [8 0 15] [28 3 17] "stone"] [:fill [9 0 16] [27 1 16] "air"] [:fill [9 2 16] [27 2 16] "glowstone"]]
   :body {:at [16.5 0 16.5] :inventory [["stone_sword" 1]]}
   :act [[:rcon "effect give $BODY minecraft:hunger 5 255 true"] [:until-effect-gone "hunger" 30]
         [:rcon "damage $BODY 10 minecraft:generic"]
         [:summon "creeper" [20.5 0 16.5]]]
   :expect [{:event {:source :job :kind :hostile.decided :data {:mob "creeper" :decision :flee}} :within-s 30}
            {:no-event {:source :job :kind :hostile.decided :data {:decision :fight}} :for-s 10}]
   :limit-s 60}
  ;; Dead end at x 9: no open cell to back off to, so no fight even at full health.
  {:name "sword-body-at-a-dead-end-does-not-fight-a-creeper"
   :blocks [[:fill [8 0 15] [28 3 17] "stone"] [:fill [9 0 16] [27 1 16] "air"] [:fill [9 2 16] [27 2 16] "glowstone"]]
   :body {:at [9.5 0 16.5] :inventory [["stone_sword" 1]]}
   :act [[:summon "creeper" [13.5 0 16.5]]]
   :expect [{:event {:source :job :kind :hostile.decided :data {:mob "creeper"}} :within-s 30}
            {:no-event {:source :job :kind :hostile.decided :data {:decision :fight}} :for-s 10}]
   :limit-s 30}]}
