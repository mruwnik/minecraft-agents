;; Card a408e733: jobs.farm.grow makes a field when no crop stands, waits for it and cuts it; a field already growing is waited for,
;; never started again. Lit grass plot, 6 high (a cave with a low ceiling); the water comes from the bucket carried.
;; Should-succeed: with a hoe, seed, a water bucket and bone meal carried the job picks a spot, tills, sows, bone-meals and cuts (wheat carried);
;; with only a hoe it breaks grass for seed first (seed comes by chance, so the field is 2 x 2).
;; A ripe field 14 blocks off (past harvest's 12 round the body) is walked to and cut by obtain's crops way and by grow.
;; A dark cave floor (underground, no sky) with torches carried is lit with torches beside the field, then sown and cut.
;; A ripe crop walled in by bedrock (nobody reaches it) is given up, not retried: the field is made and cut instead.
;; Should-fail: a young crop already standing keeps the job waiting; it sows nothing and makes no second field.
{:defaults
 {:tags [:farm :grow :jobs]
  :time :any
  :plot {:light :lit :floor "grass_block" :height 6}
  :body {:at [16.5 0 16.5] :settle-s 2 :effects [["resistance" 600 4]]
         :inventory [["wooden_hoe" 1] ["wheat_seeds" 9] ["water_bucket" 1] ["bone_meal" 24]]}
  :limit-s 400}
 :cases
 [{:name "no-field-seed-and-bone-meal-grows-and-cuts-wheat"
   :act [[:job (jobs.farm.grow {:count 2 :w 3 :h 3})]]
   :expect [{:event {:source :job :kind :completed :data {:got [:>= 2] :item "wheat"}} :within-s 380 :of-job true}]
   :after [[:item "wheat" [:>= 2]]]}
  {:name "a-dark-cave-floor-is-lit-with-torches-then-sown"
   :plot {:light :dark :floor "grass_block" :height 6}
   :body {:at [16.5 0 16.5] :settle-s 2 :effects [["resistance" 600 4]]
          :inventory [["wooden_hoe" 1] ["wheat_seeds" 9] ["water_bucket" 1] ["bone_meal" 24] ["torch" 8]]}
   :act [[:job (jobs.farm.grow {:count 1 :w 3 :h 3})]]
   :expect [{:event {:source :job :kind :completed :data {:got [:>= 1] :item "wheat"}} :within-s 380 :of-job true}]
   :after [[:item "wheat" [:>= 1]]]
   :limit-s 420}
  {:name "seed-is-broken-out-of-grass-first"
   :body {:at [16.5 0 16.5] :settle-s 2 :effects [["resistance" 600 4]] :inventory [["wooden_hoe" 1] ["water_bucket" 1] ["bone_meal" 24]]}
   :blocks [[:fill [8 0 8] [24 0 24] "short_grass"]]
   :act [[:job (jobs.farm.grow {:count 1 :w 2 :h 2})]]
   :expect [{:event {:source :job :kind :completed :data {:got [:>= 1] :item "wheat"}} :within-s 380 :of-job true}]
   :after [[:item "wheat" [:>= 1]]]
   :limit-s 420}
  {:name "a-growing-field-is-waited-for-not-replaced"
   :body {:at [16.5 0 16.5] :settle-s 2 :effects [["resistance" 600 4]] :inventory [["wooden_hoe" 1] ["wheat_seeds" 9]]}
   :blocks [[:fill [14 -1 14] [15 -1 15] "farmland[moisture=7]"] [:fill [14 0 14] [15 0 15] "wheat[age=1]"]]
   :act [[:job (jobs.farm.grow {:count 2})]]
   :expect [{:no-event {:source :job :kind :completed} :for-s 60}]
   :after [[:item "wheat_seeds" 9] [:block [18 -1 16] "grass_block"]]
   :limit-s 80}
  {:name "obtain-wheat-cuts-a-ripe-field-14-blocks-off"
   :body {:at [16.5 0 16.5] :yaw 90 :settle-s 2 :effects [["resistance" 600 4]] :inventory [["wooden_hoe" 1]]}
   :blocks [[:fill [2 -1 16] [3 -1 16] "farmland[moisture=7]"] [:fill [2 0 16] [3 0 16] "wheat[age=7]"]]
   :act [[:wait-s 4] [:job (jobs.items.obtain {:item "wheat" :count 2 :ways #{:crops}})]]
   :expect [{:event {:source :job :kind :completed} :within-s 120 :of-job true}]
   :after [[:item "wheat" [:>= 2]]]
   :limit-s 140}
  {:name "an-unreachable-ripe-crop-is-given-up-and-a-field-is-made"
   :blocks [[:fill [1 -1 15] [3 1 17] "bedrock"] [:set [2 -1 16] "farmland[moisture=7]"] [:set [2 0 16] "wheat[age=7]"]]
   :act [[:job (jobs.farm.grow {:count 1 :w 2 :h 2})]]
   :expect [{:event {:source :job :kind :completed :data {:got [:>= 1] :item "wheat"}} :within-s 380 :of-job true}]
   :after [[:block [2 0 16] "wheat"] [:item "wheat" [:>= 1]]]
   :limit-s 420}]}
