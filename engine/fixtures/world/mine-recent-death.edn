;; A body that died lately remembers where (memory :deaths) and prices the dig's stay by its killer, who may be back: the stay is priced where the body would stand to dig, the open cell beside the ore.
;; Lit plot, no clock. A spot seen lit since the death is cleared (death-spot/seen-clear?), so the death happens at the end of a 1x2 dead-end corridor of stone [13 0 7..8] the body never sees into (the stone [14 0 7..8] hides it): it stays uncleared.
;; The corridor opens onto [13 0 6], the one open face of the iron ore [12 0 6] (stone round the rest), so a zombie there is two steps from where the ore is dug. The body dies at [13.5 0 8.5] (a NoAI zombie hit), respawns at [16 0 6], in sight of the ore and is given a pickaxe. Each mine is a hand order (:worth 1200).
;; Should-succeed: a second ore at [24 0 6], further off and calm, is mined instead of the near one, which stays: its walk costs less than the stay by the death (targets/calmest!).
;; Should-succeed: with no other ore the near ore is mined: a zombie death is a quick heal if the mob leaves (Q144), so the stay costs far less than a hand order's worth.
;; Should-succeed: a body that died of a fall by the ore mines it (no mob to price).
{:defaults
 {:tags [:mine :death :jobs] :time :any
  :plot {:light :lit :height 12 :floor "dirt" :length 48 :width 48}
  :mobs :keep
  :blocks [[:fill [11 0 5] [14 2 9] "stone"] [:fill [13 0 6] [14 1 6] "air"] [:fill [13 0 7] [13 1 8] "air"]]
  :body {:at [13.5 0 8.5] :spawnpoint [16 0 6] :inventory []}
  :limit-s 240}
 :cases
 [{:name "other-ore-is-mined-not-the-one-where-it-died"
   :blocks [[:set [12 0 6] "iron_ore"] [:set [24 0 6] "iron_ore"]]
   :act [[:summon "zombie" [13.5 0 7.5] "{NoAI:1b,Silent:1b,active_effects:[{id:\"minecraft:fire_resistance\",duration:99999}]}"]
         [:rcon "damage $BODY 100 minecraft:mob_attack by @e[type=zombie,tag=wt,$BOX,limit=1]"]
         [:rcon "kill @e[type=zombie,tag=wt,$BOX]"]
         [:await {:source :body :kind :respawned} 30]
         [:rcon "give $BODY minecraft:stone_pickaxe"]
         [:wait-s 3]
         [:job (jobs.gather.mine {:worth 1200 :torches false :block "iron_ore" :item "raw_iron" :count 1 :radius 45 :ways #{:seen}})]]
   :expect [{:event {:source :job :kind #{:completed :stopped} :data {:got 1}} :within-s 200 :of-job true}]
   :after [[:item "raw_iron" 1] [:block [12 0 6] "iron_ore"] [:not-block [24 0 6] "iron_ore"]]}
  {:name "only-ore-where-it-died-is-mined-at-a-hand-orders-worth"
   :blocks [[:set [12 0 6] "iron_ore"]]
   :act [[:summon "zombie" [13.5 0 7.5] "{NoAI:1b,Silent:1b,active_effects:[{id:\"minecraft:fire_resistance\",duration:99999}]}"]
         [:rcon "damage $BODY 100 minecraft:mob_attack by @e[type=zombie,tag=wt,$BOX,limit=1]"]
         [:rcon "kill @e[type=zombie,tag=wt,$BOX]"]
         [:await {:source :body :kind :respawned} 30]
         [:rcon "give $BODY minecraft:stone_pickaxe"]
         [:wait-s 3]
         [:job (jobs.gather.mine {:worth 1200 :torches false :block "iron_ore" :item "raw_iron" :count 1 :radius 45 :ways #{:seen}})]]
   :expect [{:event {:source :job :kind #{:completed :stopped} :data {:got 1}} :within-s 120 :of-job true}
            {:no-event {:source :job :kind :mine.walk-refused} :for-s 10}]
   :after [[:item "raw_iron" 1] [:not-block [12 0 6] "iron_ore"]]}
  {:name "fall-death-by-the-ore-does-not-hold-the-mine"
   :blocks [[:set [12 0 6] "iron_ore"]]
   :act [[:rcon "damage $BODY 100 minecraft:fall"]
         [:await {:source :body :kind :respawned} 30]
         [:rcon "give $BODY minecraft:stone_pickaxe"]
         [:wait-s 3]
         [:job (jobs.gather.mine {:worth 1200 :torches false :block "iron_ore" :item "raw_iron" :count 1 :radius 45 :ways #{:seen}})]]
   :expect [{:event {:source :job :kind #{:completed :stopped} :data {:got 1}} :within-s 120 :of-job true}
            {:no-event {:source :job :kind :waiting :data {:reason :risky}} :for-s 10}]
   :after [[:item "raw_iron" 1] [:not-block [12 0 6] "iron_ore"]]}]}
