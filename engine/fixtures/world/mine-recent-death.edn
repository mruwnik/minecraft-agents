;; A body that died lately remembers where (memory :deaths) and does not go back to mine there while the memory is fresh.
;; Lit plot, no clock. A spot seen lit since the death is cleared (death-spot/seen-clear?), and any block light above 0 counts as lit, so the death happens in a sealed 1x2 stone pocket at [10 0 6..7] the body never sees into: it stays uncleared. The iron ore [12 0 6] stands against its east wall, seen from the lit side. The body dies at [10.5 0 6.5] (a NoAI zombie hit), respawns at [16 0 6], east of the pocket, in sight of the ore and is given a pickaxe.
;; The item is priced cheap (a dig and a death-side stay are weighed against its worth: a dear iron is worth a short stay by a lately killer). Should-succeed: a second ore at [24 0 6], further off and 13 blocks from the death, is mined instead of the near one, which stays.
;; Should-succeed: a body that died of a fall at the ore mines it (no mob to price).
;; Should-fail: with no other ore the walk to the death-side ore is held :risky (go-to refuses the walk (mine.walk-refused), or mine skips an ore it stands within reach of: near.risky-stay; mine then stops :none), nothing is dug.
{:defaults
 {:tags [:mine :death :jobs] :time :any
  :plot {:light :lit :height 12 :floor "dirt" :length 48 :width 48}
  :mobs :keep
  :settings {:jobs.lib.cost.value/gather-counts {"raw_iron" {:s 8 :got 10} "iron_ore" {:s 8 :got 10}}}
  :blocks [[:fill [9 0 5] [11 2 8] "stone"] [:fill [10 0 6] [10 1 7] "air"]]
  :body {:at [10.5 0 6.5] :spawnpoint [16 0 6] :inventory []}
  :limit-s 240}
 :cases
 [{:name "other-ore-is-mined-not-the-one-where-it-died"
   :blocks [[:set [12 0 6] "iron_ore"] [:set [24 0 6] "iron_ore"]]
   :act [[:summon "zombie" [10.5 0 7.5] "{NoAI:1b,Silent:1b,active_effects:[{id:\"minecraft:fire_resistance\",duration:99999}]}"]
         [:rcon "damage $BODY 100 minecraft:mob_attack by @e[type=zombie,tag=wt,$BOX,limit=1]"]
         [:rcon "kill @e[type=zombie,tag=wt,$BOX]"]
         [:await {:source :body :kind :respawned} 30]
         [:rcon "give $BODY minecraft:stone_pickaxe"]
         [:wait-s 3]
         [:job (jobs.gather.mine {:torches false :block "iron_ore" :item "raw_iron" :count 1 :radius 45 :ways #{:seen}})]]
   :expect [{:event {:source :job :kind #{:completed :stopped} :data {:got 1}} :within-s 200 :of-job true}]
   :after [[:item "raw_iron" 1] [:block [12 0 6] "iron_ore"] [:not-block [24 0 6] "iron_ore"]]}
  {:name "only-ore-where-it-died-is-refused-as-risky"
   :blocks [[:set [12 0 6] "iron_ore"]]
   :act [[:summon "zombie" [10.5 0 7.5] "{NoAI:1b,Silent:1b,active_effects:[{id:\"minecraft:fire_resistance\",duration:99999}]}"]
         [:rcon "damage $BODY 100 minecraft:mob_attack by @e[type=zombie,tag=wt,$BOX,limit=1]"]
         [:rcon "kill @e[type=zombie,tag=wt,$BOX]"]
         [:await {:source :body :kind :respawned} 30]
         [:rcon "give $BODY minecraft:stone_pickaxe"]
         [:wait-s 3]
         [:job (jobs.gather.mine {:torches false :block "iron_ore" :item "raw_iron" :count 1 :radius 45 :ways #{:seen}})]]
   :expect [{:event {:source :job :kind :mine.walk-refused} :within-s 90}
            {:event {:source :job :kind :stopped :data {:reason :none}} :within-s 90 :of-job true}]
   :after [[:block [12 0 6] "iron_ore"]]
   :limit-s 150}
  {:name "fall-death-by-the-ore-does-not-hold-the-mine"
   :blocks [[:set [12 0 6] "iron_ore"]]
   :act [[:rcon "damage $BODY 100 minecraft:fall"]
         [:await {:source :body :kind :respawned} 30]
         [:rcon "give $BODY minecraft:stone_pickaxe"]
         [:wait-s 3]
         [:job (jobs.gather.mine {:torches false :block "iron_ore" :item "raw_iron" :count 1 :radius 45 :ways #{:seen}})]]
   :expect [{:event {:source :job :kind #{:completed :stopped} :data {:got 1}} :within-s 120 :of-job true}
            {:no-event {:source :job :kind :waiting :data {:reason :risky}} :for-s 10}]
   :after [[:item "raw_iron" 1] [:not-block [12 0 6] "iron_ore"]]}]}
