;; Card 681de233: jobs.blocks.place places only from where the eye sees the cell (:see, default true).
;; Stone mass x 10..22, z 10..22, y 0..1 (surface feet y 2); the body stands in a pit [16 0..1 16] with a step out at [15 1 16];
;; the cell to fill [19 2 16] is in reach of the pit floor but the stone at x 17..18 is between the eye and it.
;; Should-succeed: by default it walks out of the pit and places from the surface; with :see false it places from the pit.
;; Should-fail: none (the :see true case judges where the body stood, not a refusal).
{:defaults
 {:tags [:blocks :place]
  :time :any
  :plot {:height 12}
  :blocks [[:fill [10 0 10] [22 1 22] "stone"]
           [:fill [16 0 16] [16 1 16] "air"] [:set [15 1 16] "air"]]
  :body {:at [16.5 0 16.5] :yaw 270 :settle-s 2 :inventory [["cobblestone" 4]] :effects [["resistance" 600 4]]}
  :limit-s 60}
 :cases
 [{:name "hidden-cell-is-placed-from-the-surface-by-default"
   :act [[:job (jobs.blocks.place {:pos #at [19 2 16] :item "cobblestone"})]]
   :expect [{:event {:source :job :kind :completed :data {:placed true :reason :placed}} :within-s 50 :of-job true}]
   :after [[:block [19 2 16] "cobblestone"] [:body-far [16.5 0 16.5] 1.3]]}
  {:name "see-false-places-from-the-pit"
   :act [[:job (jobs.blocks.place {:pos #at [19 2 16] :item "cobblestone" :see false})]]
   :expect [{:event {:source :job :kind :completed :data {:placed true :reason :placed}} :within-s 50 :of-job true}]
   :after [[:block [19 2 16] "cobblestone"] [:body-near [16.5 0 16.5] 0.8]]}]}
