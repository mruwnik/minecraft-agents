;; Card 192dba2d: a big clear-cells box in the body's own plan area must not block the engine's event loop: jobs list keeps answering while it works.
;; Should-succeed: a 6x6x2 stone box inside the body's plan footprint, open air above, is cleared and every jobs list asked meanwhile answers :ok.
;; Card a191ea07: the same with livestock near: a 10x10x2 box two columns from a fenced pen of cows, all in the body's plan; the pen's wall stays.
;; Card 1ddd42d1, should-fail: the same box right against the pen's fence (x 20): a half-dug box column is a step onto the fence top, and the body must not
;; drop into the gateless pen from it.
{:defaults
 {:tags [:build]
  :time :any
  :plot {:height 8 :floor "grass_block"}
  :blocks [[:fill [10 0 10] [15 1 15] "stone"]]
  :plans [{:id "area" :metadata {:by "$body"} :parts [{:id "inside" :box [#at [10 0 10] #at [15 3 15]] :want [:any "air"]}]}]
  :body {:at [8.5 0 15.5] :inventory [["stone_pickaxe" 1]] :effects [["resistance" 600 4]]}
  :limit-s 200}
 :cases
 [{:name "big-own-box-keeps-jobs-list-answering"
   :act [[:job (jobs.blocks.clear-cells {:area {:min #at [10 0 10] :max #at [15 1 15]}})]
         [:wait-s 3]
         [:cli "jobs" ["$body" "--world" "$world" "list"] {:total 1}]
         [:wait-s 3]
         [:cli "jobs" ["$body" "--world" "$world" "list"] {:total 1}]]
   :expect [{:event {:source :job :kind :completed} :within-s 150 :of-job true}]
   :after [[:block [10 0 10] "air"] [:block [15 1 15] "air"]]}
  {:name "big-own-box-beside-a-stocked-pen-keeps-jobs-list-answering"
   :blocks [[:fill [10 0 10] [19 1 19] "stone"] [:fill [22 0 10] [28 0 10] "oak_fence"] [:fill [22 0 16] [28 0 16] "oak_fence"]
            [:fill [22 0 11] [22 0 15] "oak_fence"] [:fill [28 0 11] [28 0 15] "oak_fence"]]
   :plans [{:id "area" :metadata {:by "$body"} :parts [{:id "inside" :box [#at [8 0 8] #at [29 3 21]] :want [:any "air"]}]}]
   :body {:at [8.5 0 15.5] :inventory [["iron_pickaxe" 1]] :effects [["resistance" 900 4] ["haste" 900 2]]}
   :act [[:summon "cow" [24.5 0 13.5] "{PersistenceRequired:1b}"]
         [:summon "cow" [26.5 0 13.5] "{PersistenceRequired:1b}"]
         [:job (jobs.blocks.clear-cells {:area {:min #at [10 0 10] :max #at [19 1 19]}})]
         [:wait-s 3]
         [:cli "jobs" ["$body" "--world" "$world" "list"] {:total 1}]
         [:wait-s 3]
         [:cli "jobs" ["$body" "--world" "$world" "list"] {:total 1}]
         [:wait-s 3]
         [:cli "jobs" ["$body" "--world" "$world" "list"] {:total 1}]]
   :expect [{:event {:source :job :kind :completed :data {:dug 200}} :within-s 420 :of-job true}]
   :after [[:block [10 0 10] "air"] [:block [19 1 19] "air"] [:block [22 0 13] "oak_fence"]]
   :limit-s 480}
  {:name "big-own-box-against-a-stocked-pen-fence-stays-out-of-the-pen"
   :blocks [[:fill [10 0 10] [19 1 19] "stone"] [:fill [20 0 10] [26 0 10] "oak_fence"] [:fill [20 0 16] [26 0 16] "oak_fence"]
            [:fill [20 0 11] [20 0 15] "oak_fence"] [:fill [26 0 11] [26 0 15] "oak_fence"]]
   :plans [{:id "area" :metadata {:by "$body"} :parts [{:id "inside" :box [#at [8 0 8] #at [27 3 21]] :want [:any "air"]}]}]
   :body {:at [8.5 0 15.5] :inventory [["iron_pickaxe" 1]] :effects [["resistance" 900 4] ["haste" 900 2]]}
   :act [[:summon "cow" [22.5 0 13.5] "{PersistenceRequired:1b}"]
         [:summon "cow" [24.5 0 13.5] "{PersistenceRequired:1b}"]
         [:job (jobs.blocks.clear-cells {:area {:min #at [10 0 10] :max #at [19 1 19]}})]]
   :expect [{:event {:source :job :kind :completed :data {:dug 200}} :within-s 420 :of-job true}]
   :after [[:block [10 0 10] "air"] [:block [19 1 19] "air"] [:block [20 0 13] "oak_fence"] [:body-far [23.5 0 13.5] 3]
           [:entities "type=cow,tag=wt" [[21 0 11] [25 2 15]] 2]]
   :limit-s 480}]}
