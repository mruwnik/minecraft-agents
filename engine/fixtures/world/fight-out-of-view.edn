;; Card 36edcede: respond-to-hostile does not end a fight or turn to flight because one danger check came back empty. An armed body whose zombie
;; is hurled out of sight behind a wall for a moment keeps fighting and kills it; a zombie that is really gone (killed) ends the reflex after a look;
;; an unarmed body still flees. AI on, helmets stop sun burn.
;; Body at [16.5 0 12.5] looking south, stone wall x 10..22 at z 18 (3 high), the zombie starts 3 blocks south of the body.
{:defaults
 {:tags [:hostile :survival :combat]
  :time :any
  :mobs :keep
  :register [{:trigger :hostile-near :args {:radius 8 :ranged-radius 16}
              :job (jobs.survival.respond-to-hostile)}]
  :blocks [[:fill [10 0 18] [22 2 18] "stone"]]
  :body {:at [16.5 0 12.5] :yaw 0 :inventory [["iron_sword" 1]] :effects [["resistance" 600 2]]}
  :limit-s 90}
 :cases
 [{:name "zombie-thrown-behind-a-wall-is-still-fought"
   :act [[:summon "zombie" [16.5 0 15.5] "{equipment:{head:{id:\"minecraft:iron_helmet\",count:1}}}"]
         [:await {:source :action :kind :started :data {:name "attack"}} 20]
         [:rcon "execute positioned $X $Y $Z run tp @e[type=zombie,$BOX] ~16 ~ ~21"]]
   :expect [{:event {:source :action :kind :done :data {:name "attack" :status "hit"}} :within-s 30}
            {:no-event {:source :job :kind :hostile.decided :data {:decision :flee}} :for-s 40}
            {:no-event {:source :body :kind :died} :for-s 40}]
   :after [[:entities "type=zombie,tag=wt" [[0 0 0] [31 6 31]] 0]]
   :limit-s 70}
  {:name "zombie-killed-mid-fight-ends-the-reflex"
   :act [[:summon "zombie" [16.5 0 15.5] "{equipment:{head:{id:\"minecraft:iron_helmet\",count:1}}}"]
         [:await {:source :reflex :kind :fired :context {:reflex-id :hostile-near}} 20]
         [:rcon "kill @e[type=zombie,$BOX]"]]
   :expect [{:event {:source :reflex :kind :ended :context {:reflex-id :hostile-near}} :within-s 30}
            {:no-event {:source :job :kind :hostile.decided :data {:decision :flee}} :for-s 15}]
   :limit-s 50}
  {:name "unarmed-body-still-flees-the-zombie"
   :body {:inventory []}
   :act [[:summon "zombie" [16.5 0 16.5] "{equipment:{head:{id:\"minecraft:iron_helmet\",count:1}}}"]]
   :expect [{:event {:source :job :kind :hostile.decided :data {:mob "zombie" :decision :flee}} :within-s 20}]
   :limit-s 40}]}
