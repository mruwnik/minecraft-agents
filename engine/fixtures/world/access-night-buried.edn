;; Cards d6a489cf (the night fact is silent when sealed in a lit corridor; owner Q345: an open tunnel or stair is not shelter), 820b2869 (dig-in walls run out of
;; blocks -> pit).
;; Night: run with --allow-time --time-log <shared time log>. Stone mass x 2..30, z 8..24, y 0..9 (cases that need a taller
;; mass say so). The register holds :night -> a notify job (the night job would log the body out when
;; another player sleeps; here only whether the trigger fires is judged).
{:defaults
 {:tags [:night :survival :access]
  :time :night
  :plot {:height 24}
  :register [{:trigger :night :persistence :cooldown :cooldown-s 2
              :job (jobs.debug.notify {:text "night fired"})}]
  :blocks [[:fill [2 0 8] [30 9 24] "stone"]]
  :body {:at [16.5 10 16.5] :effects [["resistance" 600 4]]}}
 :cases
 [{:name "buried-corridor-silent"
   ;; a sealed 1x2 corridor in the rock east along z 16 from x 26 to 28 (short enough to be read whole), torch-lit
   ;; (a body sees no block in the dark): no way in for a mob.
   :blocks [[:fill [26 4 16] [28 5 16] "air"] [:set [27 4 16] "torch"]]
   :body {:at [28.5 4 16.5] :inventory [["cobblestone" 16]]}
   :register []
   :act [[:job (jobs.survival.night {})]]
   :expect [{:event {:source :job :kind :completed :data {:name "jobs.survival.night"}} :within-s 60}
            {:no-event {:source :action :kind :started :data {:name "place"}} :for-s 30 :until {:source :job :kind :completed :data {:name "jobs.survival.night"}}}
            {:no-event {:source :job :kind :log-out} :for-s 25}]
   :after [[:body-near [28.5 4 16.5] 1.5]]}
  {:name "buried-corridor-far-bed-silent"
   :time :night :time-why :sleep
   ;; a bed remembered 130 blocks off (beyond the bed radius, too far to walk to) is no reason to call a miner in a sealed lit corridor out to look round
   :blocks [[:fill [26 4 16] [28 5 16] "air"] [:set [27 4 16] "torch"]]
   :memory [{:kind :bed :data {:pos #xyz [130 70 12]} :policy {:cap 1 :ttl :forever}}]
   :body {:at [28.5 4 16.5] :inventory [["cobblestone" 16]]}
   :expect [{:no-event {:source :reflex :kind :fired :context {:reflex-id :night}} :for-s 40}]
   :after [[:body-near [28.5 4 16.5] 1.5]]}
  {:name "deep-diagonal-stair-open-to-the-surface-shelters"
   ;; a 1-wide stair of 12 steps down from the top of a 29-high mass (the shape jobs.access.stair cuts): the body at its
   ;; bottom has sky light 0 but a mob can walk down the stair, so it is no shelter
   :plot {:height 31}
   :blocks [[:fill [2 0 8] [30 28 24] "stone"] [:fill [5 28 16] [5 30 16] "air"] [:fill [6 27 16] [6 29 16] "air"] [:fill [7 26 16] [7 28 16] "air"] [:fill [8 25 16] [8 27 16] "air"] [:fill [9 24 16] [9 26 16] "air"] [:fill [10 23 16] [10 25 16] "air"] [:fill [11 22 16] [11 24 16] "air"] [:fill [12 21 16] [12 23 16] "air"] [:fill [13 20 16] [13 22 16] "air"] [:fill [14 19 16] [14 21 16] "air"] [:fill [15 18 16] [15 20 16] "air"] [:fill [16 17 16] [16 19 16] "air"]]
   :body {:at [16.5 17 16.5] :inventory [["cobblestone" 16]]}
   :expect [{:event {:source :reflex :kind :fired :context {:reflex-id :night}} :within-s 20}]}
  {:name "surface-with-a-bed-shelters"
   :blocks [[:set [24 10 12] "red_bed[facing=east,part=foot]"] [:set [25 10 12] "red_bed[facing=east,part=head]"]]
   :memory [{:kind :bed :data {:pos #xyz [24 10 12]} :policy {:cap 1 :ttl :forever}}]
   :body {:inventory [["cobblestone" 16]]}
   :expect [{:event {:source :reflex :kind :fired :context {:reflex-id :night}} :within-s 20}]}
  {:name "shallow-diagonal-stair-shelters"
   :plot {:height 31}
   :blocks [[:fill [2 0 8] [30 28 24] "stone"] [:fill [5 28 16] [5 30 16] "air"] [:fill [6 27 16] [6 29 16] "air"] [:fill [7 26 16] [7 28 16] "air"]]
   :body {:at [7.5 26 16.5] :inventory [["cobblestone" 16]]}
   :expect [{:event {:source :reflex :kind :fired :context {:reflex-id :night}} :within-s 20}]}
  {:name "surface-shelters"
   :body {:inventory [["cobblestone" 16]]}
   :expect [{:event {:source :reflex :kind :fired :context {:reflex-id :night}} :within-s 20}]}
  {:name "under-high-slab-shelters"
   ;; a 7x7 slab 6 above the floor (over the roof height 4, light leaks in from the sides): not buried, so it shelters
   :blocks [[:fill [2 0 8] [30 9 24] "air"] [:fill [2 -1 8] [30 -1 24] "stone"]
            [:fill [13 7 13] [19 7 19] "stone"] [:fill [13 0 13] [13 6 13] "stone"] [:fill [19 0 13] [19 6 13] "stone"]
            [:fill [13 0 19] [13 6 19] "stone"] [:fill [19 0 19] [19 6 19] "stone"]]
   :body {:at [16.5 0 16.5] :inventory [["cobblestone" 16]]}
   :expect [{:event {:source :reflex :kind :fired :context {:reflex-id :night}} :within-s 20}]}
  {:name "ravine-bottom-shelters"
   ;; a 3-wide cut 9 deep open to the sky: sky light runs straight down, so the bottom is not buried
   :blocks [[:fill [15 0 8] [17 9 24] "air"]]
   :body {:at [16.5 0 16.5] :inventory [["cobblestone" 16]]}
   :expect [{:event {:source :reflex :kind :fired :context {:reflex-id :night}} :within-s 20}]}
  {:name "cave-mouth-shelters"
   ;; a 1-wide, 6-high passage 8 long into the mass from its west face (ceiling above the roof height 4, light from the
   ;; mouth), the body 5 cells in; a 1x2 passage would count as roofed (solid within 4 above) whatever the light
   :blocks [[:fill [2 0 16] [10 5 16] "air"]]
   :body {:at [7.5 0 16.5] :inventory [["cobblestone" 16]]}
   :expect [{:event {:source :reflex :kind :fired :context {:reflex-id :night}} :within-s 20}]}
  {:name "shut-in-walls-run-out-falls-back-to-pit"
   :time :any
   :plot {:light :dark}
   :register []
   ;; on the open mass top the walls need 18 blocks (4 sides x 2, 4 corners x 2, the roof support, the roof): fewer and the pit is chosen at once;
   ;; the pit (3 s of digging) quotes under 14+ walls, so the placing is priced down to make the walls the cheaper way
   ;; dirt, not cobblestone: the pit digs stone and roofs with its drops, which the clear must not take
   :body {:inventory [["dirt" 20] ["stone_pickaxe" 1]]}
   :act [[:job (jobs.survival.shut-in {:ways #{:room :walls :pit} :for :night :settings {:jobs.survival.wall-placer/max-places 2 :jobs.survival.plug-way/night-place-s 0.1}})]
         [:await {:source :action :kind :done :data {:name "place"}} 30]
         [:rcon "clear $BODY dirt"]]
   :expect [{:event {:source :job :kind :shut-in.sealed} :within-s 90 :of-job true}
            {:no-event {:source :job :kind :stopped :data {:reason :no-way}} :for-s 90 :until {:source :job :kind :shut-in.sealed}}]
   :limit-s 120}]}
