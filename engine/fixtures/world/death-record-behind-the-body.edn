;; A remembered death behind the body prices no walk away from it: the craft's walk to the table, 4 blocks off the other way, is not a trip towards where the body died.
;; Lit plot, an enderman death 5 blocks west of the body 1 minute ago. Should-succeed: the pickaxe is crafted at once, no :risky wait.
;; Should-succeed too: a death spot in plain sight (an empty spot beyond the table) is no threat.
;; Should-succeed too: a sealed, never seen (so dark) skeleton spot, 10 s or 10 min old, the body respawned 200 blocks from 5 s ago: the skeleton despawned,
;; as its drops (cobblestone, recovery skipped) held no armour or sword it would pick up and keep, and only those 5 s spawn there.
;; Should-succeed too: a sealed, never seen enderman spot whose way out to the table is some 30 steps round its stone, so the walk grazes its field's far edge.
;; The waits cases pass a finite :worth (20 s; 0.5 s for the fresh spot), below the risk of the walk: priced, the walk is declined (:not-worth) and nothing is crafted (5 planks: a table of its own would leave too few, so the walk is the only way); the twin with :worth 100000 goes.
;; Should-fail: a :risky wait for a death near the table, or crafting at once (worth ##Inf aside) with an unseen death spot 60 s or 10 s old: a zombie's behind a wall along the
;; walk to a table 15 blocks off, 3 steps round the wall's end from the way, roofed from the sun; or a skeleton's sealed in stone the body never saw into (its way out is some steps round the cell; the walk to a table 7 blocks off it, 6 planks carried).
{:defaults
 {:tags [:items :craft :go-to :survival]
  :time :any
  :plot {:height 8 :floor "stone"}
  :body {:at [16.5 0 16.5] :settle-s 2 :effects [["resistance" 600 4]]}
  :limit-s 90}
 :cases
 [{:name "craft-walk-away-from-a-recent-death-is-free"
   :blocks [[:set [20 0 16] "crafting_table"] [:set [16 3 16] "glowstone"]]
   :body {:inventory [["oak_planks" 6]]}
   :memory [{:kind :deaths :age-s 60 :policy {:cap 10 :ttl :forever} :data {:pos #xyz [11 0 16] :cause "enderman"}}]
   :act [[:job (jobs.items.craft {:item "wooden_pickaxe"})]]
   :expect [{:event {:source :job :kind :completed} :within-s 60 :of-job true}
            {:no-event {:source :job :data {:reason :risky}} :for-s 5 :of-job true}]
   :after [[:item "wooden_pickaxe" 1]]},
  {:name "craft-towards-a-death-spot-in-plain-sight-is-free"
   :blocks [[:set [20 0 16] "crafting_table"] [:set [16 3 16] "glowstone"]]
   :body {:inventory [["oak_planks" 6]]}
   :memory [{:kind :deaths :age-s 60 :policy {:cap 10 :ttl :forever} :data {:pos #xyz [27 0 16] :cause "enderman"}}]
   :act [[:job (jobs.items.craft {:item "wooden_pickaxe"})]]
   :expect [{:event {:source :job :kind :completed} :within-s 60 :of-job true}
            {:no-event {:source :job :data {:reason :risky}} :for-s 5 :of-job true}]
   :after [[:item "wooden_pickaxe" 1]]}
  {:name "craft-towards-an-unseen-death-spot-is-declined-when-the-goal-is-worth-less"
   :blocks [[:set [31 0 16] "crafting_table"] [:set [16 3 16] "glowstone"] [:set [28 3 16] "glowstone"] [:fill [17 0 17] [25 1 17] "stone"] [:set [24 2 18] "stone"]]
   :body {:inventory [["oak_planks" 5]]}
   :memory [{:kind :deaths :age-s 60 :policy {:cap 10 :ttl :forever} :data {:pos #xyz [24 0 18] :cause "zombie"}}]
   :act [[:job (jobs.items.craft {:item "wooden_pickaxe" :worth 20})]]
   :expect [{:event {:source :job :kind :stopped :data {:because {:cause {:reason :not-worth}}}} :within-s 30 :of-job true}]
   :after [[:item "wooden_pickaxe" 0]]}
  {:name "craft-past-the-far-edge-of-a-death-spot-goes"
   :blocks [[:set [20 0 16] "crafting_table"] [:set [16 3 16] "glowstone"]
            [:fill [26 -1 15] [28 1 17] "stone"] [:set [27 0 16] "air"]]
   :body {:inventory [["oak_planks" 6]]}
   :memory [{:kind :deaths :age-s 60 :policy {:cap 10 :ttl :forever} :data {:pos #xyz [27 0 16] :cause "enderman"}}]
   :act [[:job (jobs.items.craft {:item "wooden_pickaxe"})]]
   :expect [{:event {:source :job :kind :completed} :within-s 60 :of-job true}]
   :after [[:item "wooden_pickaxe" 1]]}
  {:name "craft-towards-a-fresh-unseen-death-spot-is-declined-when-the-goal-is-worth-less"
   :blocks [[:set [20 0 16] "crafting_table"] [:set [16 3 16] "glowstone"]
            [:fill [26 -1 15] [28 1 17] "stone"] [:set [27 0 16] "air"]]
   :body {:inventory [["oak_planks" 5]]}
   :memory [{:kind :deaths :age-s 10 :policy {:cap 10 :ttl :forever} :data {:pos #xyz [27 0 16] :cause "skeleton"}}]
   :act [[:job (jobs.items.craft {:item "wooden_pickaxe" :worth 0.5})]]
   :expect [{:event {:source :job :kind :stopped :data {:because {:cause {:reason :not-worth}}}} :within-s 30 :of-job true}]
   :after [[:item "wooden_pickaxe" 0]]}
  {:name "craft-towards-a-fresh-unseen-death-spot-goes-when-the-goal-is-worth-the-risk"
   :blocks [[:set [20 0 16] "crafting_table"] [:set [16 3 16] "glowstone"]
            [:fill [26 -1 15] [28 1 17] "stone"] [:set [27 0 16] "air"]]
   :body {:inventory [["oak_planks" 5]]}
   :memory [{:kind :deaths :age-s 10 :policy {:cap 10 :ttl :forever} :data {:pos #xyz [27 0 16] :cause "skeleton"}}]
   :act [[:job (jobs.items.craft {:item "wooden_pickaxe" :worth 100000})]]
   :expect [{:event {:source :job :kind :completed} :within-s 60 :of-job true}]
   :after [[:item "wooden_pickaxe" 1]]}
  {:name "craft-towards-an-unseen-death-spot-the-body-respawned-far-from-is-free"
   :alone true :alone-why "a player within 128 of the death spot keeps the killer; plots lie 96 apart"
   :blocks [[:set [20 0 16] "crafting_table"] [:set [16 3 16] "glowstone"]
            [:fill [26 -1 15] [28 1 17] "stone"] [:set [27 0 16] "air"]]
   :body {:inventory [["oak_planks" 6]]}
   :memory [{:kind :deaths :age-s 10 :policy {:cap 10 :ttl :forever} :data {:pos #xyz [27 0 16] :cause "skeleton"}}
            {:kind :died :age-s 10 :data {:pos #xyz [27 0 16] :dimension "overworld" :inventory [{:name "cobblestone" :count 20 :slot 36}] :experience {:level 0 :points 0}}}
            {:kind :recovered :age-s 4 :data {:decision :skip}}
            {:kind :respawned :age-s 5 :data {:pos #xyz [227 0 16]}}]
   :act [[:job (jobs.items.craft {:item "wooden_pickaxe"})]]
   :expect [{:event {:source :job :kind :completed} :within-s 60 :of-job true}
            {:no-event {:source :job :data {:reason :risky}} :for-s 5 :of-job true}]
   :after [[:item "wooden_pickaxe" 1]]}
  {:name "craft-towards-an-old-dark-death-spot-the-body-respawned-far-from-is-free"
   :alone true :alone-why "a player within 128 of the death spot keeps the killer; plots lie 96 apart"
   :blocks [[:set [20 0 16] "crafting_table"] [:set [16 3 16] "glowstone"]
            [:fill [26 -1 15] [28 1 17] "stone"] [:set [27 0 16] "air"]]
   :body {:inventory [["oak_planks" 6]]}
   :memory [{:kind :deaths :age-s 600 :policy {:cap 10 :ttl :forever} :data {:pos #xyz [27 0 16] :cause "skeleton"}}
            {:kind :died :age-s 600 :data {:pos #xyz [27 0 16] :dimension "overworld" :inventory [{:name "cobblestone" :count 20 :slot 36}] :experience {:level 0 :points 0}}}
            {:kind :recovered :age-s 4 :data {:decision :skip}}
            {:kind :respawned :age-s 5 :data {:pos #xyz [227 0 16]}}]
   :act [[:job (jobs.items.craft {:item "wooden_pickaxe"})]]
   :expect [{:event {:source :job :kind :completed} :within-s 60 :of-job true}
            {:no-event {:source :job :data {:reason :risky}} :for-s 5 :of-job true}]
   :after [[:item "wooden_pickaxe" 1]]}]}
