;; Cards 38a9927d, 4b0a28f4: harvest-wood :count ends :stopped :no-tree (with :got) when no tree is left to reach, instead of
;; restarting the fell for ever, and the replant debts of the trees it felled are still reported (harvest-wood.replant-owed).
;; The unreachable tree stands on a stone island (x 14..22, z 12..20) inside a lava moat 6 wide (x 8..28, z 4..28), no blocks carried.
;; Mangrove leaves drop no sapling, so a felled tree without a carried sapling leaves its replant owed.
;; Should-succeed: :count 2 with a reachable tree ends :completed with logs. Should-fail: only the island tree -> :no-tree, no debt
;; event; a felled tree plus the island one -> :no-tree with the replant-owed warning.
{:defaults
 {:tags [:forestry :harvest-wood :count] :time :day
  :plot {:height 10 :floor "grass_block"}
  :body {:at [3.5 0 16.5] :settle-s 2 :effects [["resistance" 600 4]]}
  :limit-s 130}
 :cases
 [{:name "reachable-tree-count-2-completes"
   :blocks [[:fill [3 0 8] [3 3 8] "oak_log"] [:fill [1 3 6] [5 4 10] "oak_leaves[persistent=true]"] [:set [3 3 8] "oak_log"]]
   :body {:inventory [["iron_axe" 1] ["oak_sapling" 1]]}
   :act [[:job (jobs.forestry.harvest-wood {:radius 32 :count 2})]]
   :expect [{:event {:source :job :kind :completed} :within-s 100 :of-job true}
            {:no-event {:source :job :kind :stopped} :for-s 100 :until {:source :job :kind :completed}}]
   :after [[:item "oak_log" [:>= 2]]]}
  {:name "only-an-island-tree-ends-no-tree"
   :blocks [[:fill [8 -1 4] [28 -1 28] "lava"] [:fill [14 -1 12] [22 -1 20] "stone"]
            [:fill [18 0 16] [18 3 16] "oak_log"] [:fill [16 3 14] [20 4 18] "mangrove_leaves[persistent=true]"] [:set [18 3 16] "oak_log"]]
   :body {:inventory [["iron_axe" 1]]}
   :act [[:job (jobs.forestry.harvest-wood {:radius 32 :count 4})]]
   :expect [{:event {:source :job :kind :stopped :data {:reason :no-tree}} :within-s 100 :of-job true}
            {:no-event {:source :job :kind :harvest-wood.replant-owed} :for-s 100 :until {:source :job :kind :stopped :data {:reason :no-tree}}}
            {:no-event {:source :job :kind :harvest-wood.debts-owed} :for-s 100 :until {:source :job :kind :stopped :data {:reason :no-tree}}}]
   :after [[:block [18 0 16] "oak_log"] [:body-far [18.5 0 16.5] 6]]}
  {:name "felled-tree-then-island-only-ends-no-tree-with-replant-owed"
   :blocks [[:fill [8 -1 4] [28 -1 28] "lava"] [:fill [14 -1 12] [22 -1 20] "stone"]
            [:fill [18 0 16] [18 3 16] "oak_log"] [:fill [16 3 14] [20 4 18] "mangrove_leaves[persistent=true]"] [:set [18 3 16] "oak_log"]
            [:fill [3 0 8] [3 3 8] "oak_log"] [:fill [1 3 6] [5 4 10] "mangrove_leaves[persistent=true]"] [:set [3 3 8] "oak_log"]]
   :body {:inventory [["iron_axe" 1]]}
   :act [[:job (jobs.forestry.harvest-wood {:radius 32 :count 8})]]
   :expect [{:event {:source :job :kind :harvest-wood.replant-owed :data {:reason :no-sapling}} :within-s 110 :of-job true}
            {:event {:source :job :kind :stopped :data {:reason :no-tree :got [:>= 3]}} :within-s 110 :of-job true}]
   :after [[:not-block [3 0 8] "oak_log"] [:block [18 0 16] "oak_log"] [:item "oak_log" [:>= 3]]]}]}
