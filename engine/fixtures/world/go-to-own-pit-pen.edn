;; Cards b500ec08, bc302253: go-to's escalation breaks out of the body's own pen that holds animals and puts the wall back. Pit pen: stone x 10..22, z 10..22, y 0..1 with a
;; 5x5 hole x 14..18, z 14..18 (open top, 2 deep), the body inside; the hole's cells are in a plan of the body (its own area), the walls are not.
;; Should-succeed: with no animals in the pit go-to digs out (arrives); with two cows in the pit it digs out too, puts back every cell it dug
;; (go-to.restored) and the cows stay.
{:defaults
 {:tags [:movement :access :animals]
  :time :any
  :plot {:height 8 :floor "grass_block"}
  :blocks [[:fill [10 0 10] [22 1 22] "stone"] [:fill [14 0 14] [18 1 18] "air"]]
  :plans [{:id "pit" :metadata {:by "$body"} :parts [{:id "inside" :box [#at [14 0 14] #at [18 1 18]] :want [:any "air"]}]}]
  :body {:at [16.5 0 16.5] :inventory [["stone_pickaxe" 1]] :effects [["resistance" 600 4]]}
  :limit-s 150}
 :cases
 [{:name "cows-in-the-pit-dug-out-of-and-mended"
   :act [[:summon "cow" [15.5 0 15.5]]
         [:summon "cow" [17.5 0 17.5]]
         [:until [:cli "entities" ["$body" "--world" "$world" "--type" "cow"] {:total 2}] 10]
         [:job (jobs.movement.go-to {:pos #at [26 0 16] :range 1})]]
   :expect [{:event {:source :job :kind :go-to.restored} :within-s 120 :of-job true}
            {:event {:source :job :kind :completed :context {:chain [[:any]]} :data {:arrived true}} :within-s 120 :of-job true}]
   :after [[:body-near [26.5 0 16.5] 2] [:entities "type=cow,tag=wt" [[14 0 14] [18 2 18]] 2]]}
  {:name "empty-pit-dug-out-of"
   :act [[:job (jobs.movement.go-to {:pos #at [26 0 16] :range 1})]]
   :expect [{:event {:source :job :kind :completed :context {:chain [[:any]]} :data {:arrived true}} :within-s 120 :of-job true}]
   :after [[:body-near [26.5 0 16.5] 2]]
   :limit-s 150}]}
