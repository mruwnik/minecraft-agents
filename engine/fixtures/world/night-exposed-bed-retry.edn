;; Night job (cards 6d6c329b, 1bfbe323): the night never holds an exposed body; it logs out for a stint and ends nothing-possible :exposed, and the
;; trigger fires it again after its cooldown. A failed sleep is governed only by the 5-minute :sleep-failed body-memory entry.
;; jobs.survival.night is submitted in :act (the runner starts the body with its register before plot and time are set).
;; Open ground: stone floor, no torches (light at the feet is safe), no roof and no blocks to build one.
;; The monsters-near case uses a NoAI zombie next to the bed: the round ends nothing-possible :monsters-near, the zombie is killed and
;; the next firing sleeps. The bed is set where the body looks (:yaw 90, west): one set behind it is not seen.
;; Needs night: run with --allow-time --time-log <the shared time log>, one case per call (--match).
{:defaults
 {:tags [:night :survival :sleep]
  :time :night-exclusive
  :body {:at [16.5 0 16.5] :effects [["resistance" 600 4]] :settle-s 3}}
 :cases
 ;; Cards ecf33d85, 4ae26dbd: the ways through the night are priced against each other (bed-down/answers). The sleep count is
 ;; seeded (:sleep-status, 0 of 2: the body's sleep does not end the night) and a log-out is seeded unsupported, so who else is
 ;; online changes nothing; no :respawn is known, so a bed's respawn point is worth its walk back from world spawn.
 ;; Should-fail of the first two: a bed lain in unsealed (old code put it down in the open and slept).
 [{:name "carried-bed-in-the-dark-open-is-shut-in-then-slept-in"
   :time :night-exclusive
   :time-why :sleep
   :memory [{:kind :sleep-status :data {:sleeping 0 :needed 2}} {:kind :log-out :data {:ms 0 :status "unsupported"}}]
   :act [[:rcon "give $BODY red_bed 1"]
         [:rcon "give $BODY dirt 40"]
         [:job (jobs.survival.night {:settings {:jobs.survival.night.sites/flee-radius 0}})]]
   :expect [{:event {:source :action :kind :done :data {:name "place" :status "placed"}} :within-s 60}
            {:event {:source :job :kind :shut-in.sealed} :within-s 120}
            {:event {:source :action :kind :done :data {:name "sleep" :status "sleeping"}} :within-s 150}]
   :after [[:item "red_bed" 0]]
   :limit-s 180}
  {:name "carried-bed-in-the-dark-open-stays-in-the-bag-with-nothing-to-shut-it-in"
   :time :night-exclusive
   :time-why :sleep
   :memory [{:kind :sleep-status :data {:sleeping 0 :needed 2}} {:kind :log-out :data {:ms 0 :status "unsupported"}}]
   :act [[:rcon "give $BODY red_bed 1"]
         [:job (jobs.survival.night {:settings {:jobs.survival.night.sites/flee-radius 0}})]]
   :expect [{:no-event {:source :action :kind :started :data {:name "sleep"}} :for-s 60}]
   :after [[:item "red_bed" 1]]
   :limit-s 90}
  ;; Lit by a glowstone floor: no mob spawns at the bed, so lying there costs no more than any other way, whatever the count,
  ;; and sets the respawn point: slept in, and at day the bed stays as the respawn bed.
  {:name "carried-bed-on-lit-open-ground-is-slept-in-and-kept-at-day"
   :time :night-exclusive
   :time-why :sleep
   :blocks [[:fill [12 -1 12] [20 -1 20] "glowstone"]]
   :memory [{:kind :log-out :data {:ms 0 :status "unsupported"}}]
   :act [[:rcon "give $BODY red_bed 1"]
         [:job (jobs.survival.night {:settings {:jobs.survival.night.sites/flee-radius 0}})]
         [:await {:source :action :kind :done :data {:name "sleep" :status "sleeping"}} 90]
         [:until-rcon "data get entity $BODY SleepTimer" "data: (6[0-9]|[7-9][0-9]|[0-9]{3})s" 10]
         [:time-set 1000]]
   :expect [{:event {:source :action :kind :done :data {:name "place" :status "placed"}} :within-s 70}
            {:event {:source :action :kind :done :data {:name "sleep" :status "sleeping"}} :within-s 90}
            {:no-event {:source :job :kind :night.bed-left} :for-s 60}
            {:event {:source :job :kind :completed :data {:name "jobs.survival.night"}} :within-s 150 :of-job true}]
   :after [[:item "red_bed" 0] [:memory {:entries {:spawn-bed [{:data {:pos [:any]}}]}}]]
   :limit-s 180}
  {:name "no-bed-anywhere-logs-out-and-ends-exposed-then-fires-again"
   :time :night
   :time-why :dawn-decision
   :register [{:trigger :night}]
   :act [[:job (jobs.debug.notify {:text "queued"})]]
   :expect [{:event {:source :job :kind :shelter.exposed} :within-s 40}
            {:event {:source :job :kind :child_started :data {:slot :log-out}} :within-s 60}
            {:event {:source :job :kind :stopped :data {:reason :exposed}} :within-s 120}
            {:no-event {:source :job :kind :holding :data {:reason "exposed"}} :for-s 30}
            {:event {:source :job :kind :job.notify} :within-s 150}
            {:count-event {:source :job :kind :child_started :data {:slot :log-out}} :for-s 200 :at-least 2}]
   :limit-s 240}
  {:name "obstructed-bed-is-named-and-tried-once"
   :time :night
   :time-why :sleep
   :register [{:trigger :night}]
   :body {:at [13.5 0 13.5] :yaw 90}
   :blocks [[:fill [8 0 8] [16 3 16] "stone" :hollow] [:fill [9 0 9] [15 2 15] "air"]
            [:set [10 0 13] "red_bed[facing=east,part=foot]"] [:set [11 0 13] "red_bed[facing=east,part=head]"] [:set [11 1 13] "stone"]]
   :act [[:job (jobs.survival.night {:settings {:jobs.survival.night.sites/flee-radius 0}})]]
   :expect [{:event {:source :action :kind :done :data {:name "sleep" :status "obstructed"}} :within-s 90}
            {:event {:source :job :kind :child_ended :data {:slot :sleep :ending {:cause :bed-obstructed}}} :within-s 30}]
   :limit-s 150}
  {:name "obstructed-bed-in-a-house-ends-with-the-body-inside-door-shut"
   :time :night
   :time-why :sleep
   :plot {:height 10 :length 64 :width 32}
   :body {:at [4.5 0 16.5] :yaw 270 :inventory [["cobblestone" 16]]}
   :blocks [[:fill [18 0 14] [22 2 18] "stone" :hollow] [:fill [19 0 15] [21 1 17] "air"] [:fill [18 0 16] [18 1 16] "air"]
            [:set [18 0 16] "oak_door[facing=west,half=lower,hinge=left,open=true]"] [:set [18 1 16] "oak_door[facing=west,half=upper,hinge=left,open=true]"]
            [:set [19 0 15] "red_bed[facing=east,part=foot]"] [:set [20 0 15] "red_bed[facing=east,part=head]"] [:set [20 1 15] "stone"]]
   :act [[:job (jobs.memory.set-place {:name :home :pos #at [20 0 16]}) [:now]]
         [:job (jobs.survival.night {:settings {:jobs.survival.night.sites/flee-radius 0}})]]
   :expect [{:event {:source :action :kind :done :data {:name "sleep" :status "obstructed"}} :within-s 120}
            {:event {:source :job :kind :completed :data {:name "jobs.survival.night"}} :within-s 150 :of-job true}]
   :after [[:block [18 0 16] "oak_door[half=lower,open=false]"] [:body-near [20.5 0 16.5] 2.5]]
   :limit-s 170}
  {:name "obstructed-bed-in-a-house-in-a-three-high-room-ends-with-the-body-inside-door-shut"
   :time :night
   :time-why :sleep
   :plot {:height 10 :length 64 :width 32}
   :body {:at [4.5 0 16.5] :yaw 270 :inventory [["cobblestone" 16]]}
   :blocks [[:fill [18 0 14] [22 3 18] "stone" :hollow] [:fill [19 0 15] [21 2 17] "air"] [:fill [18 0 16] [18 1 16] "air"]
            [:set [18 0 16] "oak_door[facing=west,half=lower,hinge=left,open=true]"] [:set [18 1 16] "oak_door[facing=west,half=upper,hinge=left,open=true]"]
            [:set [19 0 15] "red_bed[facing=east,part=foot]"] [:set [20 0 15] "red_bed[facing=east,part=head]"] [:set [20 1 15] "stone"]]
   :act [[:job (jobs.memory.set-place {:name :home :pos #at [20 0 16]}) [:now]]
         [:job (jobs.survival.night {:settings {:jobs.survival.night.sites/flee-radius 0}})]]
   :expect [{:event {:source :action :kind :done :data {:name "sleep" :status "obstructed"}} :within-s 120}
            {:event {:source :job :kind :completed :data {:name "jobs.survival.night"}} :within-s 150 :of-job true}]
   :after [[:block [18 0 16] "oak_door[half=lower,open=false]"] [:body-near [20.5 0 16.5] 2.5]]
   :limit-s 170}
  {:name "monster-near-ends-the-round-then-sleeps-once-the-zombie-is-killed"
   :time-why :sleep
   :blocks [[:fill [8 0 8] [16 3 16] "stone" :hollow] [:fill [9 0 9] [15 2 15] "air"]]
   :register [{:trigger :night}]
   :body {:at [13.5 0 13.5] :yaw 90}
   :act [[:summon "zombie" [14.5 0 11.5] "{NoAI:1b,Silent:1b}"]
         [:rcon "execute positioned $X $Y $Z run setblock ~10 ~ ~12 red_bed[facing=east,part=foot]"]
         [:rcon "execute positioned $X $Y $Z run setblock ~11 ~ ~12 red_bed[facing=east,part=head]"]
         [:job (jobs.survival.night)]
         [:await {:source :job :kind :stopped :data {:reason :monsters-near}} 60]
         [:rcon "kill @e[type=zombie,$BOX]"]
         [:wait-s 20]
         [:rcon "kill @e[type=spider,$BOX]"]
         [:rcon "kill @e[type=skeleton,$BOX]"]
         [:rcon "kill @e[type=creeper,$BOX]"]
         [:rcon "kill @e[type=zombie,$BOX]"]]
   :expect [{:event {:source :job :kind :stopped :data {:reason :monsters-near}} :within-s 60}
            {:event {:source :action :kind :done :data {:name "sleep" :status "sleeping"}} :within-s 400}]
   :after [[:body-near [10.5 0 12.5] 6]]
   :limit-s 420}]}
