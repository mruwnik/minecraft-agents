;; Night cases. dig-in walls a carried-block refuge on open ground (hand-tested in 0d350ed0: sealed, every cell solid);
;; wake (card 8c1ed3ad): the body sleeps in a bed, the time is set to day, it gets out of bed and walks off.
;; cut-sleep-at-night (card 8c1ed3ad): the body sleeps at night, a zombie comes, the hostile reflex cuts the sleep
;; (the cleanup calls bot.wake()), the body is out of bed and a go-to completes.
;; Both need night: run them with --allow-time --time-log <the shared time log>. Torches keep the plot lit.
{:defaults
 {:tags [:night :survival]
  :time :night-exclusive
  :blocks [[:set [4 0 4] "torch"] [:set [4 0 28] "torch"] [:set [28 0 4] "torch"] [:set [28 0 28] "torch"]
           [:set [16 0 4] "torch"] [:set [16 0 28] "torch"] [:set [4 0 16] "torch"] [:set [28 0 16] "torch"]]
  :body {:at [16.5 0 16.5] :effects [["resistance" 600 4]]}}
 :cases
 [{:name "dig-in-walls-sealed"
   :time :any
   :plot {:light :sky :height 8 :floor "grass_block" :length 48 :width 48} ; open ground: a sealed cell is already a shelter
   :body {:inventory [["cobblestone" 24]]} ; the 8 cells round the feet 2 high take 16, the roof more
   :act [[:job (jobs.survival.shut-in {:ways #{:walls} :for :night})]]
   :expect [{:event {:source :job :kind :shut-in.sealed} :within-s 60 :of-job true}
            {:no-event {:source :job :kind :shut-in.unsealed} :for-s 60 :until {:source :job :kind :shut-in.sealed}}]
   :after [[:not-block [17 0 16] "air"] [:not-block [15 0 16] "air"] [:not-block [16 0 17] "air"] [:not-block [16 0 15] "air"]
           [:not-block [17 1 16] "air"] [:not-block [15 1 16] "air"] [:not-block [16 1 17] "air"] [:not-block [16 1 15] "air"]
           [:not-block [16 2 16] "air"]]}
  {:name "wake-at-day-and-walk-off"
   :blocks [[:set [20 0 16] "red_bed[facing=east,part=foot]"] [:set [21 0 16] "red_bed[facing=east,part=head]"]]
   :act [[:job (jobs.survival.sleep {:bed #at [20 0 16]})]
         [:await {:source :action :kind :done :data {:name "sleep" :status "sleeping"}} 60]
         [:until-rcon "data get entity $BODY SleepTimer" "data: (6[0-9]|[7-9][0-9]|[0-9]{3})s" 10]
         [:time-set 1000]
         [:until-rcon "data get entity $BODY SleepTimer" "data: 0s" 15]
         [:job (jobs.movement.go-to {:pos #xyz [8 0 16] :range 0})]]
   ;; a top-level go-to (chain of one): the sleep job's own walk to the bed is a go-to child
   :expect [{:event {:source :job :kind :completed :data {:name "jobs.movement.go-to"} :context {:chain [[:any]]}}
             :within-s 120 :of-job true}]
   :after [[:body-near [8.5 0 16.5] 1.5]]}
  {:name "cut-sleep-at-night-and-walk-off"
   :register [{:trigger :hostile-near :args {:radius 8 :ranged-radius 16}
               :job (jobs.survival.respond-to-hostile)}]
   :blocks [[:set [20 0 16] "red_bed[facing=east,part=foot]"] [:set [21 0 16] "red_bed[facing=east,part=head]"]]
   :act [[:job (jobs.survival.sleep {:bed #at [20 0 16]})]
         [:await {:source :action :kind :done :data {:name "sleep" :status "sleeping"}} 60]
         [:until-rcon "data get entity $BODY SleepTimer" "data: (6[0-9]|[7-9][0-9]|[0-9]{3})s" 10]
         [:summon "zombie" [27.5 0 16.5] "{equipment:{head:{id:\"minecraft:iron_helmet\",count:1}}}"]
         [:await {:source :reflex :kind :fired :context {:reflex-id :hostile-near}} 30]
         [:wait-s 8] ; hold: the reflex fights the zombie while the refuge stays up
         [:rcon "kill @e[type=zombie,tag=wt,$BOX]"]
         [:until [:cli "entities" ["$body" "--world" "$world" "--type" "zombie"] {:total 0}] 10]
         [:job (jobs.movement.go-to {:pos #xyz [8 0 16] :range 0})]]
   :expect [{:event {:source :job :kind :completed :data {:name "jobs.movement.go-to"} :context {:chain [[:any]]}}
             :within-s 150 :of-job true}]
   :after [[:body-near [8.5 0 16.5] 1.5]]}]}
