;; Cards 0695fc4e, 9e73802f: a body at 5 hp with a sword hears a zombie it cannot see (NoAI, behind a stone wall x 8..24, z 19,
;; y 0..3). From 5 hp a flight is caught more often than a fight goes bad and two blows kill (cost.caught/prior: 0.63
;; and 0.36, the latter extrapolated: the fight counts hold one fight below 11 hp), so respond prices the fight the cheaper (fake world 991 s against 1168 s); with nothing in sight to swing at it mutes the heard mob and ends, neither fleeing nor looping.
;; A hunger effect first drops food (no regeneration), then `damage` leaves 5 hp; the zombie comes once that hurt is past
;; hostile-fight/::felt-s (an unknown cause may be a mob's blow, priced as one felt lately).
{:defaults
 {:tags [:hostile :survival :sensing]
  :time :any
  :register [{:trigger :hostile-near}]
  :blocks [[:fill [8 0 19] [24 3 19] "stone"]]
  :body {:at [16.5 0 16.5] :inventory [["iron_sword" 1]] :settle-s 2}
  :limit-s 70}
 :cases
 [{:name "five-hp-body-fights-a-heard-zombie-it-cannot-reach-without-fleeing-or-looping"
   :act [[:rcon "effect give $BODY minecraft:hunger 5 255 true"] [:until-effect-gone "hunger" 30] [:rcon "damage $BODY 15 minecraft:generic"] [:wait-s 6]
         [:summon "zombie" [16.5 0 22.5] "{NoAI:1b,equipment:{head:{id:\"minecraft:iron_helmet\",count:1}}}"]]
   :expect [{:event {:source :job :kind :hostile.decided :data {:mob "zombie" :decision :fight}} :within-s 20}
            {:no-event {:source :job :kind :hostile.decided :data {:decision :flee}} :for-s 30}
            {:no-event {:source :job :kind :failed} :for-s 30}
            {:no-event {:source :body :kind :died} :for-s 30}]
   :after [[:body-near [16.5 0 16.5] 3]]}]}
