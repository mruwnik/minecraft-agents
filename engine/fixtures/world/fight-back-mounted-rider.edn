;; card b40854b5 (commit 3ae7712a): a skeleton riding a skeleton horse is tracked with its mount (Mineflayer never moves
;; passengers). The horse is teleported away from the body after the reflex starts; the body must chase and kill the rider.
{:defaults
 {:tags [:hostile :combat] :time :any
  :register [{:trigger :hostile-near :args {:radius 12 :ranged-radius 16}
              :job (jobs.survival.respond-to-hostile {:radius 12 :ranged-radius 16})}]
  :body {:at [16.5 0 16.5] :inventory [["stone_sword" 1]]}}
 :cases
 [{:name "rider-dies-after-horse-moves-east"
   :act [[:summon "skeleton_horse" [19.5 0 16.5] "{NoAI:1b,Passengers:[{id:\"minecraft:skeleton\",NoAI:1b,equipment:{head:{id:\"minecraft:iron_helmet\",count:1}}}]}"]
         [:wait-s 1]
         [:rcon "execute at $BODY run tp @e[type=skeleton_horse,tag=wt,distance=..20] ~8 ~ ~"]
         [:wait-s 20]]
   :expect [{:event {:source :reflex :kind :fired :context {:reflex-id :hostile-near}} :within-s 10}
            {:no-event {:kind :fight_no_damage} :for-s 20}]
   :after [[:entities "type=skeleton" [[0 0 0] [32 4 32]] 0]]
   :limit-s 50}
  {:name "rider-dies-after-horse-moves-south"
   :act [[:summon "skeleton_horse" [16.5 0 19.5] "{NoAI:1b,Passengers:[{id:\"minecraft:skeleton\",NoAI:1b,equipment:{head:{id:\"minecraft:iron_helmet\",count:1}}}]}"]
         [:wait-s 1]
         [:rcon "execute at $BODY run tp @e[type=skeleton_horse,tag=wt,distance=..20] ~ ~ ~-8"]
         [:wait-s 20]]
   :expect [{:event {:source :reflex :kind :fired :context {:reflex-id :hostile-near}} :within-s 10}
            {:no-event {:kind :fight_no_damage} :for-s 20}]
   :after [[:entities "type=skeleton" [[0 0 0] [32 4 32]] 0]]
   :limit-s 50}]}
