;; Card 7889852a: the :threat entry of a creeper last seen 8 blocks east, written 5 s ago, for a creeper no entity has (gone),
;; does not make the flee from a zombie (6 west, NoAI and helmeted: it never hurts) go sideways: it runs east as with no memory.
;; A :threat entry whose mob the client no longer lists (it blew up; card 18fc7cc2) is gone, not lost: it steers nothing (flee-ignores-a-gone-creeper).
;; A creeper the body fled from (so a :threat entry names it), then boxed in out of sight but still listed, is remembered: the next flight turns aside
;; instead of running east past the box (keeps-clear-of-a-creeper-boxed-in-after-it-was-seen); its twin never saw the creeper and runs east.
;; Anchor: every flee step logs retreat.target.
{:defaults
 {:tags [:survival :retreat] :time :day
  :plot {:height 12}
  :blocks [[:set [4 0 4] "torch"] [:set [4 0 28] "torch"] [:set [28 0 4] "torch"] [:set [28 0 28] "torch"]
           [:set [16 0 4] "torch"] [:set [16 0 28] "torch"] [:set [4 0 16] "torch"] [:set [28 0 16] "torch"]]
  :body {:at [16.5 0 16.5] :settle-s 3}}
 :cases
 [{:name "flee-ignores-a-gone-creeper"
   :memory [{:kind :home :data {:pos #xyz [21000 150 20016]}}
            {:kind :threat :data {:mob "creeper" :id 9 :uuid "u9" :key "u9" :pos {:x 24.5 :y 0 :z 16.5} :ended :lost} :policy {:cap 20 :ttl 300000} :age-s 5}]
   :act [[:summon "zombie" [10.5 0 16.5] "{NoAI:1b,equipment:{head:{id:\"minecraft:iron_helmet\",count:1}}}"]
         [:job (jobs.survival.retreat {})]
         [:wait-s 12]] ; hold: the flight takes this long to show its distance
   :expect [{:event {:source :job :kind :retreat.target} :within-s 20}]
   :after [[:body-far [10.5 0 16.5] 18]]
   :limit-s 40}
  {:name "flee-without-the-lost-creeper-may-run-east"
   :memory [{:kind :home :data {:pos #xyz [21000 150 20016]}}]
   :act [[:summon "zombie" [10.5 0 16.5] "{NoAI:1b,equipment:{head:{id:\"minecraft:iron_helmet\",count:1}}}"]
         [:job (jobs.survival.retreat {})]
         [:wait-s 12]] ; hold: the flight takes this long to show its distance
   :expect [{:event {:source :job :kind :retreat.target} :within-s 20}]
   :after [[:body-far [10.5 0 16.5] 8]]
   :limit-s 40}
  {:name "keeps-clear-of-a-creeper-boxed-in-after-it-was-seen"
   :body {:at [16.5 0 16.5] :yaw 270 :settle-s 3}
   :act [[:summon "creeper" [24.5 0 16.5] "{NoAI:1b,Silent:1b,equipment:{head:{id:\"minecraft:iron_helmet\",count:1}}}"]
         [:until-seen {:entity "creeper"} 15]
         [:job (jobs.survival.retreat {})]
         [:await {:source :job :kind :completed :of-job true} 40]
         [:rcon "execute positioned $X $Y $Z run tp $BODY ~16 ~ ~16"]
         [:rcon "execute positioned $X $Y $Z run fill ~23 ~-1 ~15 ~25 ~3 ~17 stone hollow"]
         [:wait-s 2] ; hold: the box reaches the body's world view
         [:summon "zombie" [10.5 0 16.5] "{NoAI:1b,equipment:{head:{id:\"minecraft:iron_helmet\",count:1}}}"]
         [:job (jobs.survival.retreat {})]
         [:wait-s 12]] ; hold: the flight takes this long to show its distance
   :expect [{:event {:source :job :kind :retreat.target} :within-s 20}]
   :after [[:body-near [10.5 0 16.5] 18]]
   :limit-s 90}
  {:name "flee-runs-east-past-a-creeper-boxed-in-unseen"
   :body {:at [16.5 0 16.5] :yaw 270 :settle-s 3}
   :act [[:rcon "execute positioned $X $Y $Z run fill ~23 ~-1 ~15 ~25 ~3 ~17 stone hollow"]
         [:summon "creeper" [24.5 0 16.5] "{NoAI:1b,Silent:1b,equipment:{head:{id:\"minecraft:iron_helmet\",count:1}}}"]
         [:wait-s 2] ; hold: the box and the creeper reach the body's world view
         [:summon "zombie" [10.5 0 16.5] "{NoAI:1b,equipment:{head:{id:\"minecraft:iron_helmet\",count:1}}}"]
         [:job (jobs.survival.retreat {})]
         [:wait-s 12]] ; hold: the flight takes this long to show its distance
   :expect [{:event {:source :job :kind :retreat.target} :within-s 20}]
   :after [[:body-far [10.5 0 16.5] 18]]
   :limit-s 60}]}
