;; Card 6f0cef57: a gather.mine run that cut no tunnel block says why it stopped in its end text ("; tunnel stopped: <why>"); a run
;; that used up its tunnel length has no such suffix. Stone mass x 2..30, z 8..24, y 0..6; body in a 1x2 cell at [16 0 16] facing east,
;; stone pickaxe, no building block (nothing to seal with). Lava in the line at [18 0 16].
{:defaults
 {:tags [:mine :jobs] :time :any
  :plot {:height 12}
  :blocks [[:fill [2 0 8] [30 6 24] "stone"] [:fill [16 0 16] [16 1 16] "air"]]
  :body {:at [16.5 0 16.5] :yaw 270 :inventory [["stone_pickaxe" 1]] :effects [["resistance" 600 4]]}
  :limit-s 150}
 :cases
 [{:name "lava-in-the-line-says-tunnel-stopped"
   :blocks [[:set [18 0 16] "lava"] [:set [18 1 16] "lava"]]
   :act [[:job (jobs.gather.mine {:torches false :block "iron_ore" :level false :count 1 :direction :east :tunnel-length 8 :mend false})]]
   :expect [{:event {:source :job :kind #{:completed :stopped} :data {:text [:contains "tunnel stopped"]}} :within-s 120 :of-job true}]}
  {:name "tunnel-length-used-up-has-no-stopped-suffix"
   :act [[:job (jobs.gather.mine {:torches false :block "iron_ore" :level false :count 1 :direction :east :tunnel-length 3 :mend false})]]
   :expect [{:event {:source :job :kind #{:completed :stopped} :data {:reason :tunnel-length :text [:not [:contains "stopped"]]}} :within-s 120 :of-job true}]}]}
