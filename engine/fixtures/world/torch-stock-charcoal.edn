;; Card 26b09e51: a tunnel down (access.tunnel stocks; a bare stair does not) with logs but no coal and no furnace known stocks torches by charcoal: with stone to mine it makes a
;; table and a furnace (8 cobblestone) and loads the logs; where nothing makes cobblestone it says so (torch.no-stock names the 8
;; cobblestone) and digs on dark. A 17x17 slab 6 high, the body on top of it with a pickaxe and 11 logs.
{:defaults
 {:tags [:items :torch :access :jobs] :time :any
  :plot {:height 14}
  :body {:at [16.5 6 16.5] :inventory [["stone_pickaxe" 1] ["oak_log" 11] ["cooked_beef" 8]] :effects [["resistance" 600 4]]}
  :act [[:job (jobs.access.tunnel {:target #at [22 3 16] :max-length 12 :keep true})]]
  :limit-s 200}
 :cases
 [{:name "logs-and-minable-stone-make-a-furnace-and-load-the-logs"
   :blocks [[:fill [8 0 8] [24 5 24] "stone"]]
   :expect [{:event {:source :job :kind :smelt.furnace} :within-s 150 :of-job true}
            {:event {:source :job :kind :smelt.loaded} :within-s 170 :of-job true}]
   :after [[:item "oak_log" [:< 11]]]}
  {:name "logs-and-no-stone-says-8-cobblestone-and-digs-on"
   :plot {:height 14 :floor "dirt"}
   :blocks [[:fill [8 0 8] [24 5 24] "dirt"]]
   :expect [{:event {:source :job :kind :torch.no-stock :message [:contains "8 cobblestone"]} :within-s 120 :of-job true}
            {:no-event {:source :job :kind :smelt.furnace} :for-s 60}]}
  {:name "coal-2-and-logs-make-8-torches-without-a-smelt"
   ;; card 1aa2b8e3: coal 2 + sticks from the logs make 8 torches at once; no charcoal smelt, furnace or give-up is attempted
   :blocks [[:fill [8 0 8] [24 5 24] "stone"]]
   :body {:inventory [["stone_pickaxe" 1] ["oak_log" 11] ["coal" 2] ["cooked_beef" 8]]}
   :expect [{:event {:source :job :kind :torch.stocked :data {:held [:>= 8]}} :within-s 120 :of-job true}
            {:no-event {:source :job :kind #{:smelt.furnace :smelt.loaded :torch.no-stock}} :for-s 60 :of-job true}]}
  {:name "no-coal-and-no-logs-says-so-once-and-digs-on-dark"
   :blocks [[:fill [8 0 8] [24 5 24] "stone"]]
   :body {:inventory [["stone_pickaxe" 1] ["cooked_beef" 8]]}
   :expect [{:count-event {:source :job :kind :torch.no-stock} :for-s 90 :at-least 1 :at-most 1 :of-job true}
            {:no-event {:source :job :kind :torch.stocked} :for-s 60 :of-job true}]}]}
