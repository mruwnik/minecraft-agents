;; Cards 555ea732 / e4b3ebe2 (a child's wait reason reaches the parent), 64d48391 (stair stops :crop), 901196ce (cheapest
;; pickaxe held, tool.* events), 820b2869 (dig-in walls run out of blocks). Stone mass x 8..24, z 8..24, y 0..9; the body
;; stands on top (feet y 10). Zones: the plot is outside every box.
{:defaults
 {:tags [:access :mining]
  :plot {:height 20}
  :blocks [[:fill [8 0 8] [24 9 24] "stone"]]
  :body {:at [16.5 10 16.5] :effects [["resistance" 600 4]]}}
 :cases
 [{:name "stair-down-with-pickaxe"
   :body {:inventory [["stone_pickaxe" 1]]}
   :act [[:job (jobs.access.stair {:dir :down :heading :east :steps 3})]]
   :expect [{:event {:source :job :kind :stair.done} :within-s 90 :of-job true}]
   :after [[:body-near [19.5 7 16.5] 1.5] [:block [17 9 16] "air"] [:block [19 7 16] "air"]]}
  {:name "stair-down-no-pickaxe-waits"
   :act [[:job (jobs.access.stair {:dir :down :heading :east :steps 3})]]
   :expect [{:event {:source :job :kind :waiting :data {:reason :no-tool}} :within-s 30 :of-job true}
            {:no-event {:source :job :kind :stair.done} :for-s 8}]
   :after [[:not-block [17 9 16] "air"] [:not-block [17 8 16] "air"]]}
  {:name "tunnel-with-pickaxe"
   :body {:inventory [["stone_pickaxe" 1] ["torch" 8] ["cobblestone" 8]]}
   :act [[:job (jobs.access.tunnel {:target #at [16 6 20] :max-length 12 :keep true})]]
   :expect [{:event {:source :job :kind :tunnel.done} :within-s 120 :of-job true}]
   :limit-s 150}
  {:name "tunnel-no-pickaxe-waits-once"
   :body {:inventory [["torch" 8] ["cobblestone" 8]]}
   :act [[:job (jobs.access.tunnel {:target #at [16 6 20] :max-length 12 :keep true})]]
   :expect [{:event {:source :job :kind :waiting :data {:reason :no-tool}} :within-s 40 :of-job true}
            {:no-event {:source :job :kind :tunnel.done} :for-s 10}]
   :after [[:not-block [16 9 16] "air"]]}
  {:name "stair-stops-at-crop"
   :blocks [[:set [17 9 16] "farmland[moisture=7]"] [:set [17 10 16] "wheat[age=7]"]]
   :body {:inventory [["stone_pickaxe" 1]]}
   :act [[:job (jobs.access.stair {:dir :down :heading :east :steps 3})]]
   :expect [{:event {:source :job :kind :stair.stopped :data {:reason :crop}} :within-s 40 :of-job true}]
   :after [[:block [17 10 16] "wheat"] [:block [17 9 16] "farmland"]]}
  {:name "stair-heading-away-digs"
   :blocks [[:set [17 9 16] "farmland[moisture=7]"] [:set [17 10 16] "wheat[age=7]"]]
   :body {:inventory [["stone_pickaxe" 1]]}
   :act [[:job (jobs.access.stair {:dir :down :heading :west :steps 2})]]
   :expect [{:event {:source :job :kind :stair.done} :within-s 60 :of-job true}]
   :after [[:block [17 10 16] "wheat"]]}
  {:name "iron-and-stone-holds-stone"
   :body {:inventory [["iron_pickaxe" 1] ["stone_pickaxe" 1]]}
   :act [[:job (jobs.access.stair {:dir :down :heading :east :steps 2})]
         [:await {:source :job :kind :stair.done} 60]]
   :expect [{:event {:source :job :kind :stair.done} :within-s 60 :of-job true}
            {:event {:source :action :kind :started :data {:args {"item" "stone_pickaxe"}}} :within-s 60}
            {:no-event {:source :action :kind :started :data {:args {"item" "iron_pickaxe"}}} :for-s 3}]}]}
