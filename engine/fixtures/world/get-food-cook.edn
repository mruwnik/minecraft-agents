;; Cards 698d6896 2e4d9b7d 08af40de 1bda3325 (cook gaps).
;; survival.get-food cooks raw meat before eating it (owner: cook whenever it can) and the night hold cooks a furnace-side meal too.
;; Hunger is drained by RCON (food 8 after 5 s, near 0 after 8 s) and damage sets hp 15, so the body is hungry; the mobs are NoAI.
;; Should-succeed: a cook cut after its load is collected by the next get-food; raw chicken beside a seen furnace is smelted first by the hungry reflex; a carried furnace is put down
;; and 2 raw chops cooked; food near 0 with a furnace in sight still cooks; the night hold in a closed hut cooks beef at a furnace
;; inside and then eats it; reserved bait carrots are eaten by neither the hungry reflex nor the night hold.
;; Should-fail: a creeper in sight rushes the body: the raw beef is eaten, no cooking; with carrots reserved as bait the
;; hungry body keeps all of them.
{:defaults
 {:tags [:survival :get-food :cook]
  :plot {:height 6}
  :body {:at [4.5 0 16.5] :settle-s 2}
  :limit-s 100}
 :cases
 [{:name "reflex-cooks-raw-chicken-at-a-seen-furnace"
   :register [{:trigger :hungry :persistence :cooldown :cooldown-s 30 :job (jobs.survival.get-food {:explore false})}]
   :blocks [[:set [8 0 16] "furnace[facing=west]"]]
   :body {:inventory [["chicken" 2] ["coal" 2]]}
   :act [[:rcon "effect give $BODY minecraft:hunger 5 243 true"] [:until-effect-gone "hunger" 30]
         [:rcon "damage $BODY 5 minecraft:generic"]]
   :expect [{:event {:source :reflex :kind :fired :context {:reflex-id :hungry}} :within-s 30}
            {:event {:source :job :kind :child_ended :data {:slot :cook :ending {:kind :done}}} :within-s 80}
            {:event {:source :reflex :kind :ended :context {:reflex-id :hungry} :data {:outcome #{:done :stopped}}} :within-s 90}]
   :after [[:item "chicken" 0]]}
  ;; 427bf185: a cook cut by another job leaves its food in the furnace; the next get-food collects and eats it
  {:name "cook-cut-after-the-load-is-collected-by-the-next-get-food"
   :blocks [[:set [8 0 16] "furnace[facing=west]"]]
   :body {:inventory [["porkchop" 3] ["coal" 2]]}
   :act [[:job (jobs.items.smelt {:furnace #xyz [8 0 16] :item "porkchop" :count 3})]
         [:await {:source :job :kind :smelt.loaded} 60]
         [:http :cancel "$job" {:ok true}]
         [:await {:source :job :kind :cancelled} 10]
         [:rcon "effect give $BODY minecraft:hunger 8 255 true"] [:until-effect-gone "hunger" 30]
         [:rcon "damage $BODY 5 minecraft:generic"]
         [:job (jobs.survival.get-food {:explore false :carry 0})]]
   :expect [{:event {:source :job :kind :completed} :within-s 90 :of-job true}]
   :after [[:item "porkchop" 0] [:item "cooked_porkchop" 0]]
   :limit-s 140}
  {:name "carried-furnace-is-put-down-and-two-chops-cooked"
   :body {:inventory [["furnace" 1] ["porkchop" 2] ["coal" 2]]}
   :act [[:rcon "effect give $BODY minecraft:hunger 5 243 true"] [:until-effect-gone "hunger" 30]
         [:rcon "damage $BODY 5 minecraft:generic"]
         [:job (jobs.survival.get-food {:explore false})]]
   :expect [{:event {:source :job :kind :child_ended :data {:slot :cook :ending {:kind :done}}} :within-s 80}
            {:event {:source :job :kind #{:completed :stopped}} :within-s 90 :of-job true}]
   :after [[:item "porkchop" 0]]}
  {:name "food-near-zero-with-a-furnace-in-sight-still-cooks"
   :blocks [[:set [8 0 16] "furnace[facing=west]"]]
   :body {:inventory [["beef" 2] ["coal" 2]]}
   :act [[:rcon "effect give $BODY minecraft:hunger 8 255 true"] [:until-effect-gone "hunger" 30]
         [:rcon "damage $BODY 5 minecraft:generic"]
         [:job (jobs.survival.get-food {:explore false})]]
   :expect [{:event {:source :job :kind :child_ended :data {:slot :cook :ending {:kind :done}}} :within-s 80}]
   :after [[:item "beef" 0]]}
  ;; 2e4d9b7d: a furnace 36 blocks off, known as the :furnace memory place, still pays for the walk (cook-far-radius 64, not the 16 of a placed one)
  {:name "remembered-furnace-36-blocks-away-is-walked-to-and-used"
   :plot {:height 6 :length 64 :width 32}
   :blocks [[:set [40 0 16] "furnace[facing=west]"]]
   :memory [{:kind :furnace :data {:pos #xyz [40 0 16]} :policy {:cap 1 :ttl :forever}}]
   :body {:inventory [["beef" 2] ["coal" 2]]}
   :act [[:rcon "effect give $BODY minecraft:hunger 5 243 true"] [:until-effect-gone "hunger" 30]
         [:rcon "damage $BODY 5 minecraft:generic"]
         [:job (jobs.survival.get-food {:explore false})]]
   :expect [{:event {:source :job :kind :child_ended :data {:slot :cook :ending {:kind :done}}} :within-s 100}]
   :after [[:item "beef" 0]]
   :limit-s 130}
  ;; 2e4d9b7d: at food 0 with health that will not outlast a 2-item cook (20 s of starvation = 5 hp, plus a margin of 3) the beef is eaten raw
  {:name "starving-at-low-health-eats-the-beef-raw-beside-a-furnace"
   :blocks [[:set [8 0 16] "furnace[facing=west]"]]
   :body {:inventory [["beef" 2] ["coal" 2]]}
   :act [[:rcon "effect give $BODY minecraft:hunger 8 255 true"] [:until-effect-gone "hunger" 30]
         [:rcon "damage $BODY 14 minecraft:generic"]
         [:job (jobs.survival.get-food {:explore false})]]
   :expect [{:event {:source :job :kind #{:completed :stopped}} :within-s 60 :of-job true}
            {:no-event {:source :job :kind :child_ended :data {:slot :cook :ending {:kind :done}}} :for-s 50 :until {:source :job :kind #{:completed :stopped}}}]
   :after [[:item "beef" [:<= 1]]]}
  ;; fixer-meat-value (05563e845): two wild beef pay for making a furnace (replacement cost 1 + 3 with no pen): the table and cobblestone
  ;; in the pack become a furnace and the beef is cooked
  {:name "two-wild-beef-pay-for-making-a-furnace"
   :blocks [[:set [8 0 20] "crafting_table"]]
   :body {:inventory [["beef" 2] ["coal" 2] ["cobblestone" 8]]}
   :act [[:rcon "effect give $BODY minecraft:hunger 5 243 true"] [:until-effect-gone "hunger" 30]
         [:rcon "damage $BODY 5 minecraft:generic"]
         [:job (jobs.survival.get-food {:explore false})]]
   :expect [{:event {:source :job :kind :child_ended :data {:slot :cook :ending {:kind :done}}} :within-s 120}]
   :after [[:item "beef" 0]]
   :limit-s 150}
  {:name "creeper-in-sight-eats-the-beef-raw"
   :blocks [[:set [8 0 16] "furnace[facing=west]"]]
   :body {:inventory [["beef" 2] ["coal" 2]]}
   :act [[:summon "creeper" [14.5 0 16.5] "{NoAI:1b,Silent:1b}"]
         [:rcon "effect give $BODY minecraft:hunger 5 243 true"] [:until-effect-gone "hunger" 30]
         [:rcon "damage $BODY 5 minecraft:generic"]
         [:job (jobs.survival.get-food {:explore false})]]
   :expect [{:event {:source :job :kind #{:completed :stopped}} :within-s 60 :of-job true}
            {:no-event {:source :job :kind :child_ended :data {:slot :cook :ending {:kind :done}}} :for-s 50 :until {:source :job :kind #{:completed :stopped}}}]
   :after [[:item "beef" [:<= 1]]]}
  {:name "reserved-bait-carrots-survive-the-hungry-reflex"
   :register [{:trigger :hungry :persistence :cooldown :cooldown-s 30 :job (jobs.survival.get-food {:explore false})}]
   :body {:inventory [["carrot" 13]]}
   :act [[:rcon "effect give $BODY minecraft:hunger 5 243 true"] [:until-effect-gone "hunger" 30]
         [:rcon "damage $BODY 5 minecraft:generic"]]
   :memory [{:kind :reserve :data {:id "wt-bait" :item "carrot" :count :all :strength 0.8} :policy {:cap 100 :ttl :forever}}]
   :expect [{:event {:source :reflex :kind :fired :context {:reflex-id :hungry}} :within-s 30}
            {:event {:source :reflex :kind :ended :context {:reflex-id :hungry}} :within-s 70}]
   :after [[:item "carrot" 13]]}
  {:name "unreserved-carrots-are-eaten-by-the-hungry-reflex"
   :register [{:trigger :hungry :persistence :cooldown :cooldown-s 30 :job (jobs.survival.get-food {:explore false})}]
   :body {:inventory [["carrot" 13]]}
   :act [[:rcon "effect give $BODY minecraft:hunger 5 243 true"] [:until-effect-gone "hunger" 30]
         [:rcon "damage $BODY 5 minecraft:generic"]]
   :expect [{:event {:source :reflex :kind :ended :context {:reflex-id :hungry} :data {:outcome :done}} :within-s 70}]
   :after [[:item "carrot" [:<= 12]]]}]}
