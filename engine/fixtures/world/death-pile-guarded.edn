;; Cards e77e2cf7, 23ce16b8, 6a5f090e, dd69d2c4, 7a063610, 83546641, 51196f7d: an unarmed respawned body weighs a pile a skeleton guards.
;; The body dies at [22 0 22] (RCON kill), respawns at [4 0 4]; a NoAI skeleton (fire resistant) stands at [18 0 18], in sight of the body, unarmed.
;; The pile sits 9 blocks from the island edge: drops roll 6-8 out and a stack that rolls off the edge falls out of the world (card 6a301f4e).
;; Danger-only skip is not final: decided :skip :retry, no walk; once the skeleton is gone a :retry run fetches. A known chest with a
;; sword and a helmet is emptied first (fetch/stock memory seed) and the trip then goes. A junk pile skips on value alone, no chest trip;
;; asked again (card dd69d2c4) the job waits :no-drops naming the skip.
{:defaults
 {:tags [:survival :death :jobs]
  :body {:at [22.5 0 22.5] :spawnpoint [4 0 4] :effects [["resistance" 600 4]]
         :inventory [["raw_iron" 24] ["cobblestone" 64] ["cobblestone" 36]]}
  :mobs :keep
  :act [[:kill-body]
        [:await {:source :body :kind :respawned} 30]
        [:until [:memory {:entries {:deaths [{:data {:pos [:any]}}]}}] 15]
        [:summon "skeleton" [18.5 0 18.5] "{NoAI:1b,Silent:1b,active_effects:[{id:\"minecraft:fire_resistance\",duration:99999}],ArmorItems:[{},{},{},{id:\"minecraft:iron_helmet\",count:1}]}"]
        [:wait-s 2]] ; settle: nothing the body reports to poll
  :limit-s 200}
 :cases
 [{:name "unarmed-skips-guarded-pile-then-retries-when-killer-gone"
   :act [[:job (jobs.survival.recover-drops)]
         [:await {:source :job :kind :recover-drops.decided :data {:decision :skip :retry true}} 60]
         [:rcon "kill @e[type=skeleton,tag=wt,$BOX]"]
         [:wait-s 2] ; settle: nothing the body reports to poll
         [:job (jobs.survival.recover-drops {:retry true})]]
   :expect [{:event {:source :job :kind :recover-drops.decided :data {:decision :skip :retry true}} :within-s 60}
            {:no-event {:source :job :kind :recover-drops.fetching} :for-s 60 :until {:source :job :kind :recover-drops.decided}}
            {:event {:source :job :kind :recover-drops.decided :data {:decision :collected}} :within-s 190}]
   :after [[:item "raw_iron" 24]]}
  {:name "known-chest-kit-fetched-before-the-guarded-trip"
   :blocks [[:set [6 0 6] "chest{Items:[{Slot:0b,id:\"minecraft:iron_sword\",count:1},{Slot:1b,id:\"minecraft:iron_helmet\",count:1}]}"]]
   :memory [{:kind :fetch/stock :data {:pos #at [6 0 6] :items {"iron_sword" 1 "iron_helmet" 1}}}]
   :act [[:job (jobs.survival.recover-drops)]]
   :expect [{:event {:source :job :kind :recover-drops.fetching} :within-s 120}
            {:no-event {:source :job :kind :recover-drops.kit-dropped} :for-s 120 :until {:source :job :kind :recover-drops.fetching}}
            {:event {:source :job :kind :recover-drops.decided :data {:decision :collected}} :within-s 190}]
   :after [[:item "iron_sword" 1] [:item "raw_iron" 24]]}
  {:name "junk-pile-skipped-on-value-without-a-chest-trip"
   :body {:inventory [["dirt" 3]]}
   :blocks [[:set [6 0 6] "chest{Items:[{Slot:0b,id:\"minecraft:iron_sword\",count:1},{Slot:1b,id:\"minecraft:iron_helmet\",count:1}]}"]]
   :memory [{:kind :fetch/stock :data {:pos #at [6 0 6] :items {"iron_sword" 1 "iron_helmet" 1}}}]
   :act [[:job (jobs.survival.recover-drops)]
         [:await {:source :job :kind :recover-drops.decided :data {:decision :skip}} 40]
         [:job (jobs.survival.recover-drops)]]
   :expect [{:event {:source :job :kind :recover-drops.decided :data {:decision :skip}} :within-s 40 :of-job true}
            {:no-event {:source :job :kind :recover-drops.fetching} :for-s 40 :until {:source :job :kind :recover-drops.decided}}
            {:event {:source :job :kind :waiting :data {:reason :no-drops :decision :skip :text [:contains "already decided"]}} :within-s 80 :of-job true}]
   :after [[:item "iron_sword" 0] [:item "dirt" 0]]}]}
