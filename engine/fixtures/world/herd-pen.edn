;; jobs.animals.herd through a shut gate (card 4f4ab883, hand-tested in 2edefeae / 31cd9b2a), and the same with the
;; pen planned and the pen-gate reflex registered (card aba4e0cf: pen-gate must not shut the gate mid-herd).
;; Pen: oak fence ring x 18..24, z 13..19, inside 19..23 x 14..18, gate on the west side at [18 0 16].
{:defaults
 {:tags [:herd :animals :jobs]
  :plot {:floor "grass_block"}
  :blocks [[:fill [18 0 13] [24 0 19] "oak_fence"]
           [:fill [19 0 14] [23 0 18] "air"]
           [:set [18 0 16] "oak_fence_gate[facing=east,open=false]"]]
  :body {:at [12.5 0 16.5] :yaw 270 :inventory [["lead" 4]]}
  :limit-s 300}
 :cases
 [;; should-fail: a 3x3 box can never give the 5 cells in a line the walk-in needs (impossible from the args, no walk)
  {:name "three-by-three-box-impossible"
   :act [[:summon "cow" [10.5 0 18.5]]
         [:job (jobs.animals.herd {:mob "cow" :box {:min #xyz [19 0 14] :max #xyz [21 0 16]} :target 1})]]
   :expect [{:event {:source :job :kind :stopped :data {:kind :impossible :reason :too-shallow}} :within-s 20 :of-job true}
            {:no-event {:source :job :kind :completed} :for-s 20 :until {:source :job :kind :stopped}}]}
  ;; should-fail: a fence across the pen 2 cells in from the gate, seen at the start: a start condition, so it waits, no walk
  {:name "seen-shallow-pen-refused-at-start"
   :blocks [[:fill [18 0 13] [24 0 19] "oak_fence"]
            [:fill [19 0 14] [23 0 18] "air"]
            [:fill [21 0 14] [21 0 18] "oak_fence"]
            [:set [18 0 16] "oak_fence_gate[facing=east,open=false]"]]
   :act [[:summon "cow" [10.5 0 18.5]]
         [:job (jobs.animals.herd {:mob "cow" :box {:min #xyz [19 0 14] :max #xyz [23 0 18]} :target 1})]]
   :expect [{:event {:source :job :kind :waiting :data {:reason :too-shallow}} :within-s 30 :of-job true}
            {:no-event {:source :job :kind :completed} :for-s 30}]}
  {:name "shut-gate-one-cow-brought"
   :act [[:summon "cow" [10.5 0 18.5]]
         [:job (jobs.animals.herd {:mob "cow" :box {:min #xyz [19 0 14] :max #xyz [23 0 18]} :target 1})]]
   :expect [{:event {:source :job :kind :completed :data {:reason :brought}} :within-s 240 :of-job true}]
   :after [[:entities "type=cow,tag=wt" [[19 0 14] [23 1 18]] 1]
           [:block [18 0 16] "oak_fence_gate[open=false]"]]}
  ;; card 4f377f2f: the ground round the pen is one block higher than the pen floor, so the gate stands a step above the inside cells
  {:name "gate-a-step-above-the-pen-floor-cow-brought"
   :blocks [[:fill [0 0 0] [31 0 31] "grass_block"]
            [:fill [19 0 14] [23 0 18] "air"]
            [:fill [18 1 13] [24 1 19] "oak_fence" :outline]
            [:set [18 1 16] "oak_fence_gate[facing=east,open=false]"]]
   :body {:at [12.5 1 16.5] :yaw 270 :inventory [["lead" 4]]}
   :act [[:summon "cow" [10.5 1 18.5]]
         [:job (jobs.animals.herd {:mob "cow" :box {:min #xyz [19 0 14] :max #xyz [23 0 18]} :target 1})]]
   :expect [{:event {:source :job :kind :completed :data {:reason :brought}} :within-s 240 :of-job true}]
   :after [[:entities "type=cow,tag=wt" [[19 0 14] [23 1 18]] 1]
           [:block [18 1 16] "oak_fence_gate[open=false]"]]}
  ;; card 46490387: a second gate east; the west gate, straight nearest the body, opens into a walled lane closed at its far end,
  ;; (fence, so no perch over the pen's fence) so its walk goes through the pen: herd picks the gate by go-to's quote, leads round to the east one and brings the cow
  {:name "nearest-gate-walled-off-the-other-gate-used"
   :blocks [[:fill [18 0 13] [24 0 19] "oak_fence"]
            [:fill [19 0 14] [23 0 18] "air"]
            [:set [18 0 16] "oak_fence_gate[facing=east,open=false]"]
            [:set [24 0 16] "oak_fence_gate[facing=west,open=false]"]
            [:fill [13 0 15] [17 0 15] "oak_fence"]
            [:fill [13 0 17] [17 0 17] "oak_fence"]
            [:set [13 0 16] "oak_fence"]]
   :act [[:summon "cow" [10.5 0 18.5]]
         [:job (jobs.animals.herd {:mob "cow" :box {:min #xyz [19 0 14] :max #xyz [23 0 18]} :target 1})]]
   :expect [{:event {:source :job :kind :completed :data {:reason :brought}} :within-s 280 :of-job true}]
   :after [[:entities "type=cow,tag=wt" [[19 0 14] [23 1 18]] 1]
           [:block [24 0 16] "oak_fence_gate[open=false]"] [:block [18 0 16] "oak_fence_gate[open=false]"]]}
  ;; the pen and the cell outside its gate are behind the body (yaw 90, facing west), so they start unseen: herd looks, then brings the cow
  {:name "pen-behind-the-body-is-looked-at-then-cow-brought"
   :body {:at [12.5 0 16.5] :yaw 90 :inventory [["lead" 4]]}
   :act [[:summon "cow" [6.5 0 18.5]]
         [:job (jobs.animals.herd {:mob "cow" :box {:min #xyz [19 0 14] :max #xyz [23 0 18]} :target 1})]]
   :expect [{:event {:source :job :kind :completed :data {:reason :brought}} :within-s 240 :of-job true}
            {:no-event {:source :job :kind #{:waiting :stopped} :data {:reason :no-gate}} :for-s 240 :until {:source :job :kind :completed}}]
   :after [[:entities "type=cow,tag=wt" [[19 0 14] [23 1 18]] 1]
           [:block [18 0 16] "oak_fence_gate[open=false]"]]}
  {:name "planned-pen-gate-left-alone"
   :tags [:herd :animals :triggers]
   :register [{:trigger :pen-gate}]
   :plans [{:id "pen" :metadata {:by "$body"}
            :parts [{:id "fence" :outline [#at [18 0 13] #at [24 0 19]] :want [:any "oak_fence"]}
                    {:id "gate" :cells [#at [18 0 16]] :want [:any "oak_fence_gate"]}]}]
   :act [[:summon "cow" [10.5 0 18.5]]
         [:job (jobs.animals.herd {:mob "cow" :box {:min #xyz [19 0 14] :max #xyz [23 0 18]} :target 1})]]
   :expect [{:event {:source :job :kind :completed :data {:reason :brought}} :within-s 240 :of-job true}
            {:no-event {:source :reflex :kind :fired :context {:reflex-id :pen-gate}} :for-s 240 :until {:source :job :kind :completed}}]
   :after [[:entities "type=cow,tag=wt" [[19 0 14] [23 1 18]] 1]
           [:block [18 0 16] "oak_fence_gate[open=false]"]]}
  ;; the control for the case above: the same planned pen with its gate left open and no herd, so pen-gate does fire
  ;; and shuts it (proves the plan and the trigger are live, so the quiet case is not quiet by accident)
  {:name "planned-pen-open-gate-shut-by-reflex"
   :tags [:animals :triggers]
   :register [{:trigger :pen-gate}]
   :blocks [[:set [18 0 16] "oak_fence_gate[facing=east,open=true]"]]
   :plans [{:id "pen" :metadata {:by "$body"}
            :parts [{:id "fence" :outline [#at [18 0 13] #at [24 0 19]] :want [:any "oak_fence"]}
                    {:id "gate" :cells [#at [18 0 16]] :want [:any "oak_fence_gate"]}]}]
   :expect [{:event {:source :reflex :kind :fired :context {:reflex-id :pen-gate}} :within-s 30}
            {:event {:source :reflex :kind :ended :context {:reflex-id :pen-gate} :data {:outcome :done}} :within-s 45}]
   :after [[:block [18 0 16] "oak_fence_gate[open=false]"]]
   :limit-s 60}]}
