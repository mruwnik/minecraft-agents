;; Breathe over a 10x10 pond, 4 deep (card 94ae4756): the body is put in the water, its air runs out, the breathe reflex fires.
;; Walled all round (wall 2 above the water, ground outside level with the water): it never reaches a shore and the pond is narrower than a swim leg,
;; so, with no pillar block carried, the reflex ends stopped :no_blocks (no :afloat warning, no hold) and the body stays in the pond; it never drowns. With a ledge cut into one wall
;; (the ground outside is level with the water) it climbs out and the reflex ends :cleared once, also when the ledge's top is a slab, a path block or farmland.
;; ledge-east-hostile-cuts-then-refire-lands: a zombie summoned once suffocating has fired, hostile-near above suffocating, drops the breathe run; the body flees the zombie onto dry ground (no refire).
{:defaults
 {:tags [:survival :water] :time :any
  :plot {:height 10}
  :register [{:trigger :suffocating :persistence :cooldown :cooldown-s 2 :args {:min-oxygen 12}
              :job (jobs.survival.breathe {:min-oxygen 12})}]
  :blocks [[:fill [0 0 0] [31 3 31] "stone"]
           [:fill [10 4 10] [21 5 21] "stone"]
           [:fill [11 4 11] [20 5 20] "air"]
           [:fill [11 0 11] [20 3 20] "water"]]
  :body {:at [15.5 2 15.5] :settle-s 1}
  :limit-s 100}
 :cases
 [{:name "walled-stops-no-land-1"
   :expect [{:event {:source :reflex :kind :fired} :within-s 30}
            {:event {:source :reflex :kind :ended :data {:outcome :stopped :reason :no_blocks}} :within-s 80}
            {:no-event {:source :job :kind :afloat} :for-s 80 :until {:source :reflex :kind :ended :data {:outcome :stopped :reason :no_blocks}}}
            {:no-event {:source :job :kind :holding :data {:reason :afloat}} :for-s 80 :until {:source :reflex :kind :ended :data {:outcome :stopped :reason :no_blocks}}}
            {:no-event {:source :job :level :warn :kind #{:unreachable :refused}} :for-s 80 :until {:source :reflex :kind :ended :data {:outcome :stopped :reason :no_blocks}}}]
   :after [[:body-near [15.5 3.5 15.5] 6]]}
  {:name "walled-stops-no-land-2"
   :body {:at [13.5 2 17.5]}
   :expect [{:event {:source :reflex :kind :fired} :within-s 30}
            {:event {:source :reflex :kind :ended :data {:outcome :stopped :reason :no_blocks}} :within-s 80}
            {:no-event {:source :job :kind :afloat} :for-s 80 :until {:source :reflex :kind :ended :data {:outcome :stopped :reason :no_blocks}}}
            {:no-event {:source :job :kind :holding :data {:reason :afloat}} :for-s 80 :until {:source :reflex :kind :ended :data {:outcome :stopped :reason :no_blocks}}}
            {:no-event {:source :job :level :warn :kind #{:unreachable :refused}} :for-s 80 :until {:source :reflex :kind :ended :data {:outcome :stopped :reason :no_blocks}}}]
   :after [[:body-near [13.5 3.5 17.5] 6]]}
  {:name "ledge-east-lands-1"
   :blocks [[:fill [21 4 11] [21 5 20] "air"]]
   :body {:at [18.5 2 15.5]}
   :expect [{:event {:source :reflex :kind :fired} :within-s 30}
            {:event {:source :reflex :kind :ended :data {:how :cleared}} :within-s 60}
            {:no-event {:source :job :kind :no_shore} :for-s 60 :until {:source :reflex :kind :ended :data {:how :cleared}}}]
   :after [[:body-near [22.5 4 15.5] 4]]}
  {:name "equal-shores-walled-first-ledge-east"
   :blocks [[:fill [21 4 11] [21 5 20] "air"]]
   :body {:at [15.5 2 15.5]}
   :expect [{:event {:source :reflex :kind :fired} :within-s 30}
            {:event {:source :reflex :kind :ended :data {:how :cleared}} :within-s 80}]
   :after [[:body-near [22.5 4 15.5] 4]]}
  {:name "equal-shores-walled-first-ledge-west"
   :blocks [[:fill [10 4 11] [10 5 20] "air"]]
   :body {:at [15.5 2 15.5]}
   :expect [{:event {:source :reflex :kind :fired} :within-s 30}
            {:event {:source :reflex :kind :ended :data {:how :cleared}} :within-s 80}]
   :after [[:body-near [8.5 4 15.5] 4]]}
  {:name "ledge-west-lands-2"
   :blocks [[:fill [10 4 11] [10 5 20] "air"]]
   :body {:at [12.5 2 13.5]}
   :expect [{:event {:source :reflex :kind :fired} :within-s 30}
            {:event {:source :reflex :kind :ended :data {:how :cleared}} :within-s 60}
            {:no-event {:source :job :kind :no_shore} :for-s 60 :until {:source :reflex :kind :ended :data {:how :cleared}}}]
   :after [[:body-near [8.5 4 13.5] 4]]}
  {:name "ledge-east-slab-lands"
   :blocks [[:fill [21 4 11] [21 5 20] "air"] [:fill [21 3 11] [21 3 20] "stone_slab[type=bottom]"]]
   :body {:at [18.5 2 15.5]}
   :expect [{:event {:source :reflex :kind :fired} :within-s 30}
            {:event {:source :reflex :kind :ended :data {:how :cleared}} :within-s 60}
            {:no-event {:source :job :kind :afloat} :for-s 60 :until {:source :reflex :kind :ended :data {:how :cleared}}}]
   :after [[:body-near [22.5 4 15.5] 4]]}
  {:name "ledge-east-path-lands"
   :blocks [[:fill [21 4 11] [21 5 20] "air"] [:fill [21 3 11] [21 3 20] "dirt_path"]]
   :body {:at [18.5 2 15.5]}
   :expect [{:event {:source :reflex :kind :fired} :within-s 30}
            {:event {:source :reflex :kind :ended :data {:how :cleared}} :within-s 60}
            {:no-event {:source :job :kind :afloat} :for-s 60 :until {:source :reflex :kind :ended :data {:how :cleared}}}]
   :after [[:body-near [22.5 4 15.5] 4]]}
  {:name "ledge-east-hostile-cuts-then-refire-lands"
   :blocks [[:fill [21 4 11] [21 5 20] "air"]]
   :register [{:trigger :hostile-near :persistence :retry :backoff false :job (jobs.survival.respond-to-hostile)}
              {:trigger :suffocating :persistence :cooldown :cooldown-s 2 :args {:min-oxygen 12} :job (jobs.survival.breathe {:min-oxygen 12})}]
   :body {:at [18.5 2 15.5]}
   :act [[:await {:source :reflex :kind :fired :context {:reflex-id :suffocating}} 40]
         [:summon "zombie" [22.5 4 15.5] "{NoAI:1b,equipment:{head:{id:\"minecraft:iron_helmet\",count:1}}}"]
         [:wait-s 12]
         [:rcon "kill @e[type=zombie,tag=wt,$BOX]"]]
   :expect [{:event {:source :reflex :kind :ended :context {:reflex-id :suffocating} :data {:outcome :dropped :by :hostile-near}} :within-s 40}
            {:event {:source :reflex :kind :ended :context {:reflex-id :hostile-near}} :within-s 90}
            {:no-event {:source :job :kind :afloat} :for-s 90 :until {:source :reflex :kind :ended :context {:reflex-id :hostile-near}}}]
   ;; the flight from the zombie leads far off the ledge onto dry ground, so breathe never fires again
   :after [[:body-far [15.5 3.5 15.5] 6]]}
  {:name "ledge-east-farmland-lands"
   :blocks [[:fill [21 4 11] [21 5 20] "air"] [:fill [21 3 11] [21 3 20] "farmland"]]
   :body {:at [18.5 2 15.5]}
   :expect [{:event {:source :reflex :kind :fired} :within-s 30}
            {:event {:source :reflex :kind :ended :data {:how :cleared}} :within-s 60}
            {:no-event {:source :job :kind :afloat} :for-s 60 :until {:source :reflex :kind :ended :data {:how :cleared}}}]
   :after [[:body-near [22.5 4 15.5] 4]]}]}
