;; A wall between the body and the target cell: the pour must not land beside the wall and report placed; the body
;; moves until the eye ray reaches the cell, and the target ends as a lava source.
{:defaults
 {:tags [:blocks :jobs]
  :body {:at [16.5 0 16.5] :inventory [["lava_bucket" 1]]}
  :blocks [[:fill [18 0 14] [18 1 18] "stone"]]
  :limit-s 60}
 :cases
 [{:name "wall-in-the-line"
   :act [[:wait-s 2] [:job (jobs.blocks.place {:pos #at [19 0 16] :item "lava_bucket"})]]
   :expect [{:event {:source :job :kind :completed :data {:placed true :reason :placed}} :within-s 50 :of-job true}]
   :after [[:block [19 0 16] "lava[level=0]"] [:item "lava_bucket" 0] [:item "bucket" 1]]}]}
