;; Card 77da0ee5: plans.mjs check judges a plan against what the body has seen (its seen memory file, saved every :engine.perception/save-ms: 1000 here, polled until the face shows), not the world's chunks.
;; A stone mass x 10..22, y 0..3, z 12..20 with the body outside it to the west: its west face is in sight, its inside never is.
;; The body faces east (:yaw 270): sight is a view cone, so a body left facing another way (a pool body keeps its last rotation) never sees the face.
;; seen-face-cell-matches: a plan cell on the west face, wanted stone, is seen and matches. hidden-cell-is-unseen-not-matching: a plan cell deep inside the mass counts :unseen/unknown, never matching.
;; built-cells-count-as-seen (card 335f6f3c): cells the body has just placed in plain view are seen at once, so the check reports them as matches, never :unknown.
;; check-without-body-refused: no --body, no answer from the world (:body-required).
{:defaults
 {:tags [:build :tool :memory] :time :any
  :plot {:height 8}
  :blocks [[:fill [10 0 12] [22 3 20] "stone"]]
  :body {:at [4.5 0 16.5] :yaw 270 :settle-s 2}
  :settings {:engine.perception/save-ms 1000}
  :limit-s 120}
 :cases
 [{:name "seen-face-cell-matches"
   :plans [{:id "face" :metadata {:by "tester"} :parts [{:id "face" :cells [#at [10 1 16]] :want [:any "stone"]}]}]
   :act [[:until [:cli "plans" ["--world" "$world" "check" "$plan:face" "--body" "$body"]
          {:evidence :seen-memory :score {:counts {:match 1} :checked {:seen 1 :unseen 0}}}] 60]]
   :expect [{:no-event {:level :error} :for-s 3}]
   :after [[:body-near [4.5 0 16.5] 4]]}
  {:name "hidden-cell-is-unseen-not-matching"
   :plans [{:id "face" :metadata {:by "tester"} :parts [{:id "face" :cells [#at [10 1 16]] :want [:any "stone"]}]}
           {:id "deep" :metadata {:by "tester"} :parts [{:id "deep" :cells [#at [16 1 16]] :want [:any "stone"]}]}]
   :act [[:until [:cli "plans" ["--world" "$world" "check" "$plan:face" "--body" "$body"]
          {:evidence :seen-memory :score {:counts {:match 1} :checked {:seen 1 :unseen 0}}}] 60]
         [:cli "plans" ["--world" "$world" "check" "$plan:deep" "--body" "$body"]
          {:evidence :seen-memory :score {:counts {:unknown 1} :checked {:seen 0 :unseen 1}}}]]
   :expect [{:no-event {:level :error} :for-s 3}]
   :after [[:body-near [4.5 0 16.5] 4]]}
  {:name "built-cells-count-as-seen"
   :body {:inventory [["dirt" 4]]}
   :plans [{:id "mine" :metadata {:by "$body"} :parts [{:id "row" :cells [#at [6 0 15] #at [6 0 16] #at [6 0 17]] :want "dirt"}]}]
   :act [[:job (jobs.build.from-plan {:plan "$plan:mine"})]
         [:await {:source :job :kind :completed :data {:missing []}} 60]
         [:until [:cli "plans" ["--world" "$world" "check" "$plan:mine" "--body" "$body"]
                  {:evidence :seen-memory :score {:counts {:match 3} :checked {:seen 3 :unseen 0}}}] 30]]
   :expect [{:no-event {:level :error} :for-s 3}]
   :after [[:block [6 0 16] "dirt"]]
   :limit-s 120}
  {:name "wrong-cell-is-listed-with-wanted-and-found"
   ;; card 21dffd57: a seen cell of the wrong block is named in :wrong-cells with the part, wanted block and found block
   :plans [{:id "wrong" :metadata {:by "tester"} :parts [{:id "face" :cells [#at [10 1 16]] :want [:any "dirt"]}]}]
   :act [[:until [:cli "plans" ["--world" "$world" "check" "$plan:wrong" "--body" "$body"]
          {:evidence :seen-memory :score {:counts {:wrong 1} :wrong-total 1 :wrong-cells [{:part "face" :found "stone"}]}}] 30]]
   :expect [{:no-event {:level :error} :for-s 3}]
   :after [[:body-near [4.5 0 16.5] 4]]}
  {:name "check-without-body-refused"
   :plans [{:id "face" :metadata {:by "tester"} :parts [{:id "face" :cells [#at [10 1 16]] :want [:any "stone"]}]}]
   :act [[:cli "plans" ["--world" "$world" "check" "$plan:face"] {:ok false :reason :body-required}]]
   :expect [{:no-event {:level :error} :for-s 3}]
   :after [[:body-near [4.5 0 16.5] 4]]}]}
