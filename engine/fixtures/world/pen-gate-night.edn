;; Gates and a body shut in for the night. Card 4bf8de7b: (B) a by-hand use-on on a gate in a night shelter is not held silently: it
;; waits :exposed when the dark walk is too risky (Q380 prices a short one and goes; the case sets a risk share of 0), and with a :checks {:safe? (not (threatened))} override it walks out and clicks; (C) the pen-gate
;; reflex, with the body shut in a room for the night, does not start for an own-pen gate left open 6 blocks away (shut-gate's safe? is
;; exposed there); a gate inside the room is shut.
;; Night room: stone x 14..18, z 14..18, roof y 2, torch inside, a door in the east wall at [18 0 16]. Gate in a fence line at [24 0 16].
;; Should-succeed: use-on with the :checks override walks out and opens the gate; the reflex shuts the gate inside the room. Should-fail: the default
;; use-on waits :exposed with the gate shut; the reflex does not start shut-gate for the far gate, gate open.
;; The reflex reads only gates in the body's view cone (default yaw faces south): the gate case faces north, toward the gate.
{:defaults
 {:tags [:animals :pen-gate :night]
  :time :night
  :plot {:floor "grass_block" :height 8}
  :blocks [[:fill [14 0 14] [18 2 18] "stone"] [:fill [15 0 15] [17 1 17] "air"] [:set [15 0 15] "torch"]
           [:set [18 0 16] "oak_door[facing=east,half=lower,open=false]"] [:set [18 1 16] "oak_door[facing=east,half=upper,open=false]"]
           [:fill [24 0 10] [24 0 22] "oak_fence"] [:set [24 0 16] "oak_fence_gate[facing=east,open=false]"]]
  :body {:at [16.5 0 16.5] :settle-s 2 :effects [["resistance" 900 4]]}
  :limit-s 90}
 :cases
 [{:name "by-hand-use-on-in-the-shelter-waits-naming-the-reason"
   :settings {:jobs.lib.price/risk-share 0}
   :act [[:job (jobs.items.use {:on #at [24 0 16]})]]
   :expect [{:event {:source :job :kind :waiting :data {:reason :exposed}} :within-s 20 :of-job true}]
   :after [[:block [24 0 16] "oak_fence_gate[open=false]"] [:body-near [16.5 0 16.5] 2]]}
  {:name "use-on-with-a-checks-override-walks-out-and-opens-the-gate"
   :act [[:job (jobs.items.use {:on #at [24 0 16] :checks {:safe? (not (threatened))}})]]
   :expect [{:event {:source :job :kind :completed :data {:name "jobs.items.use"}} :within-s 70 :of-job true}]
   :after [[:block [24 0 16] "oak_fence_gate[open=true]"]]}
  {:name "reflex-does-not-leave-the-room-at-night-for-an-open-gate"
   :register [{:trigger :pen-gate}]
   :blocks [[:set [24 0 16] "oak_fence_gate[facing=east,open=true]"]]
   :plans [{:id "pen" :parts [{:id "gate" :cells [#at [24 0 16]] :want [:any "oak_fence_gate"]}]}]
   :expect [{:no-event {:source :job :kind :shut.gave-up} :for-s 30}]
   :after [[:block [24 0 16] "oak_fence_gate[open=true]"] [:body-near [16.5 0 16.5] 2]]}
  {:name "reflex-shuts-an-open-gate-inside-the-room-at-night"
   :register [{:trigger :pen-gate}]
   :blocks [[:set [17 0 15] "oak_fence_gate[facing=east,open=true]"]]
   :body {:at [16.5 0 17.5] :yaw 180 :settle-s 2 :effects [["resistance" 900 4]]}
   :plans [{:id "pen" :parts [{:id "gate" :cells [#at [17 0 15]] :want [:any "oak_fence_gate"]}]}]
   :expect [{:event {:source :reflex :kind :fired :context {:reflex-id :pen-gate}} :within-s 30}
            {:event {:source :reflex :kind :ended :context {:reflex-id :pen-gate} :data {:kind :done}} :within-s 60}]
   :after [[:block [17 0 15] "oak_fence_gate[open=false]"]]}]}
