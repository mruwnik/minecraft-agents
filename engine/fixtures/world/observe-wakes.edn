;; What a waiting `observe` and the jobs tool tell about events that happen after the wait started (cards 60587ace 9eee05c3 abe33c66
;; 2207d01a 0d8303ba 999ed566 a2972022 4f3c0f82). The runner runs tool steps one after another, so every event the wait must catch is
;; started by a job submitted before the wait and delayed by a walk.
;; Should-succeed: a notice wakes the wait, a finished job answers after 1000+ later events, body.idle names the waiting job.
;; Should-fail (control): a job that is really running wakes no idle notice.
{:defaults
 {:tags [:agent-tools :observe :tool]
  :time :any
  :plot {:height 8}
  :body {:at [4.5 0 16.5] :spawnpoint [4 0 4]}
  :limit-s 120}
 :cases
 [{:name "attention-notice-wakes-a-waiting-observe"
   :act [[:http :submit (seq (jobs.movement.go-to {:pos #at [26 0 16] :range 1}) (jobs.debug.notify {:text "owed"}) (jobs.movement.go-to {:pos #at [4 0 16] :range 1})) [] {:ok true}]
         [:cli "observe" ["$body" "--world" "$world" "status" "--wait" "--timeout" "40s"] {:wake :notice :event :job.notify}]]
   :expect [{:event {:source :job :kind :job.notify :attention :notice} :within-s 40 :of-job true}]}
  {:name "finished-job-is-answered-after-more-than-1000-later-events"
   :limit-s 200
