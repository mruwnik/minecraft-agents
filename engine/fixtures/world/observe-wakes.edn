         [:http :submit (jobs.items.get-tool {:item "stone_pickaxe" :explore false}) [] {:ok true}]
         [:cli "observe" ["$body" "--world" "$world" "status" "--wait" "--timeout" "40s"] {:wake :idle}]]
   :expect [{:event {:source :body :kind :idle} :within-s 40}]}
  {:name "a-running-job-raises-no-idle-notice"
   :plot {:height 8 :length 128}
   :limit-s 60
   :act [[:job (jobs.movement.go-to {:pos #at [110 0 16] :range 1})]]
   :expect [{:event {:source :job :kind :result :data {:arrived true}} :within-s 50 :of-job true}
            {:no-event {:source :body :kind :idle} :for-s 40 :until {:source :job :kind :result}}]}]}
