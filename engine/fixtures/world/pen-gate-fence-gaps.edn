;; pen-gate with a fence line between the body and the planned gate: fence at y 1 in every cell of z=12 (a second
;; fence at y 0 on even x only, so odd-x cells are 1-high gaps the body cannot walk through), body boxed in by
;; stone x 13..22, z 12..17. At eye height there is no gap, so the click is blocked as in vanilla: gave-up :unreachable,
;; gate left open. (Isolated-post gaps at eye height are not covered: the body would walk through them.)
{:name "gate-behind-fence-line-gives-up"
 :tags [:animals :triggers :pen-gate]
 :time :any
 :plot {:floor "grass_block"}
 :register [{:trigger :pen-gate}]
 :plans [{:id "pen" :parts [{:id "gate" :cells [#at [16 0 8]] :want [:any "oak_fence_gate"]}]}]
 :blocks [[:fill [13 0 12] [13 3 17] "stone"] [:fill [22 0 12] [22 3 17] "stone"] [:fill [13 0 17] [22 3 17] "stone"]
          [:fill [13 1 12] [22 1 12] "oak_fence"]
          [:fill [14 0 12] [22 0 12] "oak_fence"]
          [:fill [15 0 12] [15 0 12] "air"] [:fill [17 0 12] [17 0 12] "air"] [:fill [19 0 12] [19 0 12] "air"] [:fill [21 0 12] [21 0 12] "air"]
          [:set [16 0 8] "oak_fence_gate[facing=south,open=true]"]]
 :body {:at [17.5 0 14.5]}
 :expect [{:event {:source :job :kind :shut-gate.gave-up :data {:cell #at [16 0 8]}} :within-s 60}]
 :after [[:block [16 0 8] "oak_fence_gate[open=true]"]]
 :limit-s 90}
