;; Leo #82: a remembered bed sealed in a stone box, a dead-end passage beside the body. A walk that finds no way ends bed_unreachable in the same
;; call after one quote (go-to's three tries are not repeated), says "on foot" (not "shut in").
;; Room A (x 8..16, z 8..16, lit, roofed) with a closed 1-wide passage at z 17..22 off its south wall; room B (x 18..24) a sealed box with the bed.
;; Should-succeed (sleep-unreachable-bed-not-walked-to): bed_unreachable after one short walk.
;; Needs night: run with --allow-time --time-log <the shared time log>, one case per call (--match-id).
{:defaults
 {:tags [:night :survival :sleep]
  :time :night-exclusive
  :time-why :sleep
  :plot {:light :sky}
  :blocks [[:fill [8 0 8] [17 3 16] "stone" :hollow] [:fill [9 0 9] [16 2 15] "air"]
           [:fill [17 0 8] [25 3 16] "stone" :hollow] [:fill [18 0 9] [24 2 15] "air"]
           [:fill [11 0 16] [13 3 23] "stone" :hollow] [:fill [12 0 16] [12 2 22] "air"]
           [:set [9 1 9] "torch"] [:set [15 1 15] "torch"] [:set [20 1 9] "torch"]
           [:set [20 0 12] "red_bed[facing=east,part=foot]"] [:set [21 0 12] "red_bed[facing=east,part=head]"]]
  :body {:at [10.5 0 10.5] :yaw 270 :settle-s 2}}
 :cases
 [{:name "sleep-unreachable-bed-not-walked-to"
   :act [[:job (jobs.survival.sleep {:bed #at [20 0 12]})]]
   :expect [{:event {:source :job :kind :bed_unreachable :message [:contains "cannot reach the bed on foot"]} :within-s 30 :of-job true}
            {:no-event {:source :job :kind :bed_unreachable :message [:contains "shut in"]} :for-s 5 :of-job true}]
   :limit-s 60}]}
