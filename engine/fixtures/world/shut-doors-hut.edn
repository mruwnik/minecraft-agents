;; jobs.maintenance.shut-doors on a hut door (cards 4acd8c53, 927dcb2f). Door at [16 0 16] (oak, open), body 4 south looking north.
;; Should-succeed: :unrecorded? shuts an open door of the body's own plan footprint that no walk recorded; a recorded door held by a cow is
;; not given up: the door-left reflex shuts it on a later run once the cow is gone.
;; Should-fail (left open): the default run never touches a door no walk of this body opened; a door outside any own plan stays open even
;; with :unrecorded?.
{:defaults
 {:tags [:doors :jobs]
  :time :any
  :plot {:floor "grass_block"}
  :blocks [[:fill [14 0 16] [18 1 16] "oak_planks"]
           [:set [16 0 16] "oak_door[facing=south,half=lower,hinge=left,open=true]"]
           [:set [16 1 16] "oak_door[facing=south,half=upper,hinge=left,open=true]"]]
  :body {:at [16.5 0 20.5] :yaw 180 :effects [["resistance" 600 4]]}
  :limit-s 90}
 :cases
 [{:name "unrecorded-own-door-shut"
   :plans [{:id "hut" :metadata {:by "$body"} :parts [{:id "wall" :cells [#at [14 0 16] #at [15 0 16] #at [17 0 16] #at [18 0 16]] :want [:any "oak_planks"]}
                                                       {:id "door" :cells [#at [16 0 16]] :want [:any "oak_door"]}]}]
   :act [[:job (jobs.maintenance.shut-doors {:unrecorded? true})]]
   :expect [{:event {:source :job :kind :completed :data {:shut 1 :left []}} :within-s 70 :of-job true}]
   :after [[:block [16 0 16] "oak_door[half=lower,open=false]"]]}
  {:name "default-run-leaves-an-unrecorded-door"
   :plans [{:id "hut" :metadata {:by "$body"} :parts [{:id "door" :cells [#at [16 0 16]] :want [:any "oak_door"]}]}]
   :act [[:job (jobs.maintenance.shut-doors)]]
   :expect [{:event {:source :job :kind :completed :data {:shut 0 :left []}} :within-s 40 :of-job true}]
   :after [[:block [16 0 16] "oak_door[half=lower,open=true]"]]
   :limit-s 60}
  {:name "unrecorded-door-outside-own-plans-left-open"
   :act [[:job (jobs.maintenance.shut-doors {:unrecorded? true})]]
   :expect [{:event {:source :job :kind :completed :data {:shut 0 :left []}} :within-s 40 :of-job true}]
   :after [[:block [16 0 16] "oak_door[half=lower,open=true]"]]
   :limit-s 60}
  ;; a recorded open door with a cow stuck in its cell: the run stops (animal in the way) but keeps the entry; once the cow is gone the
  ;; reflex's next run shuts the door
  {:name "door-held-by-a-cow-shut-once-it-is-gone"
   :register [{:trigger :door-left :persistence :cooldown :cooldown-s 5 :job (jobs.maintenance.shut-doors)}]
   :memory [{:kind :opened :data {:cell #xyz [16 0 16] :by "j0" :shut? true}}]
   :act [[:summon "cow" [16.5 0 16.5] "{NoAI:1b}"]
         [:await {:source :job :kind :shut-doors.stopped} 60]
         [:rcon "kill @e[type=cow,tag=wt,$BOX]"]]
   :expect [{:event {:source :job :kind :shut-doors.stopped} :within-s 60}
            {:event {:source :reflex :kind :ended :context {:reflex-id :door-left} :data {:outcome :done}} :within-s 120}]
   :after [[:block [16 0 16] "oak_door[half=lower,open=false]"]]
   :limit-s 140}]}
