;; Card 21402928: go-to leaves a 5x5, 3-deep pit it may not dig (another's zone that allows placing) by a pillar of 2
;; beside a wall and a step onto the rim; a pillar waits for a cow standing in its cell, and ends :mob-in-cell when
;; the cow stays.
{:defaults
 {:tags [:movement :access]
  :time :any
  :plot {:height 12}
  :limit-s 120}
 :cases
 [{:name "wide-pit-no-dig-pillars-out"
   :blocks [[:fill [8 0 8] [24 3 24] "dirt"] [:fill [14 1 14] [18 3 18] "air"]]
   :zones [{:name "pen" :min [13 0 13] :max [19 4 19] :owner "Other" :allow #{:place}}]
   :body {:at [16.5 1 16.5] :inventory [["dirt" 8]]}
   :act [[:job (jobs.movement.go-to {:pos #at [22 4 16] :range 1})]]
   :expect [{:event {:source :job :kind :go-to.escalated :data {:step :pillar}} :within-s 60 :of-job true}
            {:event {:source :job :kind :completed :data {:arrived true}} :within-s 100 :of-job true}
            {:no-event {:source :action :kind :done :data {:name "dig"}} :for-s 100 :until {:source :job :kind :completed :data {:arrived true}}}]
   :after [[:body-near [22.5 4 16.5] 2]]}
  {:name "pillar-waits-out-a-cow-in-its-cell"
   :blocks [[:fill [12 0 12] [20 0 20] "stone"]]
   :body {:at [16.5 1 16.5] :inventory [["dirt" 8]]}
   :act [[:summon "cow" [16.9 1 16.5] "{NoAI:1b}"]
         [:job (jobs.access.pillar {:height 2 :here true})]
         [:wait-s 4]
         [:rcon "kill @e[type=cow,$BOX]"]]
   :expect [{:event {:source :job :kind :completed} :within-s 40}
            {:no-event {:source :job :kind :stopped} :for-s 40 :until {:source :job :kind :completed}}]
   :after [[:block [16 1 16] "dirt"] [:block [16 2 16] "dirt"]]}
  {:name "pillar-cow-stays-mob-in-cell"
   :blocks [[:fill [12 0 12] [20 0 20] "stone"]]
   :body {:at [16.5 1 16.5] :inventory [["dirt" 8]]}
   :act [[:summon "cow" [16.9 1 16.5] "{NoAI:1b}"]
         [:job (jobs.access.pillar {:height 2 :here true})]]
   :expect [{:event {:source :job :kind :stopped :data {:reason :mob-in-cell :mob "cow"}} :within-s 40}]
   :after [[:block [16 1 16] "air"]]}
  {:name "night-pit-pillar-climbs-under-a-caller-safe-form"
   ;; card 02b795f1: at night, go-to under a caller :checks {:safe? (not (threatened))} pillars out of the pit at once; the
   ;; escalation pillar used to force (not (exposed)) over the caller's form and waited :dark for dawn
   :time :night
   :blocks [[:fill [8 0 8] [24 3 24] "dirt"] [:fill [14 1 14] [18 3 18] "air"]]
   :zones [{:name "pen" :min [13 0 13] :max [19 4 19] :owner "Other" :allow #{:place}}]
   :body {:at [16.5 1 16.5] :inventory [["dirt" 8]]}
   :act [[:job (jobs.movement.go-to {:pos #at [22 4 16] :range 1 :checks {:safe? (not (threatened))}})]]
   :expect [{:event {:source :job :kind :go-to.escalated :data {:step :pillar}} :within-s 60 :of-job true}
            {:event {:source :job :kind :completed :data {:arrived true}} :within-s 100 :of-job true}
            {:no-event {:source :job :kind :waiting :data {:reason :dark}} :for-s 100 :until {:source :job :kind :completed :data {:arrived true}}}]
   :after [[:body-near [22.5 4 16.5] 2]]}]}
