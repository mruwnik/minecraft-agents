;; Wedged reflex + jobs.survival.unwedge (card ab70e479). The body stands in a full block (sand) at its feet cell [16 0 16].
;; S: steps to a free side cell, else digs the feet block (shovel carried; water beside is allowed). N: slab, farmland, snow layer,
;; soul sand at the feet never fire :wedged. F: lava beside / above the feet cell, bedrock at the feet: no dig, no step into lava,
;; exactly one :unwedge.blocked warning and no refire within the quiet period.
;; Note: the runner starts the body BEFORE it clears the plot, so a body saved inside the previous case's wedge fires once before
;; t0 (job j1, and an :unwedge-blocked entry for that cell). F cases therefore tp the body out at the end, and the no-refire
;; check names jobs j2..j6 (the case's own job is j1 when the body starts clean, as it does after a previous F case).
{:defaults
 {:tags [:survival :unwedge] :time :any
  :plot {:height 8}
  :register [{:trigger :wedged :persistence :cooldown :cooldown-s 0 :job (jobs.survival.unwedge)}]
  :body {:at [16.5 0 16.5] :settle-s 1}
  :limit-s 60}
 :cases
 [{:name "s1-steps-to-free-side-1"
   :act [[:summon "falling_block" [16.5 4 16.5] "{BlockState:{Name:\"minecraft:sand\"},Time:1}"]]
   :expect [{:event {:source :reflex :kind :fired} :within-s 15}
            {:event {:source :reflex :kind :ended} :within-s 30}
            {:no-event {:source :job :kind :unwedge.blocked} :for-s 10}]
   :after [[:block [16 0 16] "sand"]]}
  {:name "s1-steps-to-free-side-2"
   :blocks [[:set [17 -1 16] "stone"] [:set [15 0 16] "stone"] [:set [15 1 16] "stone"] [:set [16 0 17] "stone"] [:set [16 1 17] "stone"] [:set [16 0 15] "stone"] [:set [16 1 15] "stone"]]
   :act [[:summon "falling_block" [16.5 4 16.5] "{BlockState:{Name:\"minecraft:sand\"},Time:1}"]]
   :expect [{:event {:source :reflex :kind :fired} :within-s 15}
            {:event {:source :reflex :kind :ended} :within-s 30}
            {:no-event {:source :job :kind :unwedge.blocked} :for-s 10}]
   :after [[:block [16 0 16] "sand"]]}
  {:name "s2-digs-out-no-side-1"
   :blocks [[:fill [15 0 15] [17 1 17] "stone"] [:fill [16 0 16] [16 1 16] "air"]]
   :act [[:rcon "execute positioned $X $Y $Z run setblock ~16 ~ ~16 sand"]]
   :body {:inventory [["iron_shovel" 1]]}
   :expect [{:event {:source :reflex :kind :ended} :within-s 40}]
   :after [[:not-block [16 0 16] "sand"] [:body-near [16.5 0 16.5] 1]]}
  {:name "s2-digs-out-no-side-2"
   :blocks [[:fill [15 0 15] [17 1 17] "stone"] [:fill [16 0 16] [16 1 16] "air"]]
   :act [[:summon "falling_block" [16.5 4 16.5] "{BlockState:{Name:\"minecraft:sand\"},Time:1}"]]
   :body {:inventory [["iron_shovel" 1]]}
   :expect [{:event {:source :reflex :kind :ended} :within-s 40}]
   :after [[:not-block [16 0 16] "sand"] [:body-near [16.5 0 16.5] 1]]}
  {:name "s3-digs-with-water-side-1"
   :blocks [[:fill [15 0 15] [17 1 17] "stone"] [:fill [16 0 16] [16 1 16] "air"] [:set [17 0 16] "water"]] 
   :act [[:rcon "execute positioned $X $Y $Z run setblock ~16 ~ ~16 sand"]]
   :body {:inventory [["iron_shovel" 1]]}
   :expect [{:event {:source :reflex :kind :ended} :within-s 40}]
   :after [[:not-block [16 0 16] "sand"] [:body-near [16.5 0 16.5] 1.5]]}
  {:name "s3-digs-with-water-side-2"
   :blocks [[:fill [15 0 15] [17 1 17] "stone"] [:fill [16 0 16] [16 1 16] "air"] [:set [15 0 16] "water"]] 
   :act [[:rcon "execute positioned $X $Y $Z run setblock ~16 ~ ~16 sand"]]
   :body {:inventory [["iron_shovel" 1]]}
   :expect [{:event {:source :reflex :kind :ended} :within-s 40}]
   :after [[:not-block [16 0 16] "sand"] [:body-near [16.5 0 16.5] 1.5]]}
  {:name "n1-slab"
   :blocks [[:set [16 0 16] "stone_slab[type=bottom]"]]
   :act [[:wait-s 13] [:rcon "tp $BODY $X $Y $Z"]]
   :expect [{:no-event {:source :reflex :kind :fired} :for-s 12}]}
  {:name "n1-farmland"
   :blocks [[:set [16 -1 16] "farmland"]]
   :act [[:wait-s 13] [:rcon "tp $BODY $X $Y $Z"]]
   :expect [{:no-event {:source :reflex :kind :fired} :for-s 12}]}
  {:name "n1-snow-layer"
   :blocks [[:set [16 0 16] "snow[layers=1]"]]
   :act [[:wait-s 13] [:rcon "tp $BODY $X $Y $Z"]]
   :expect [{:no-event {:source :reflex :kind :fired} :for-s 12}]}
  {:name "n1-soul-sand"
   :blocks [[:set [16 -1 16] "soul_sand"]]
   :act [[:wait-s 13] [:rcon "tp $BODY $X $Y $Z"]]
   :expect [{:no-event {:source :reflex :kind :fired} :for-s 12}]}
 {:name "n2-pillar-up-no-false-wedge-1"
   :body {:inventory [["dirt" 8]]}
   :act [[:job (jobs.access.pillar {:height 4})] [:await {:source :job :kind :pillar.done} 60] [:wait-s 4]]
   :expect [{:no-event {:source :reflex :kind :fired} :for-s 20}]
   :after [[:not-block [16 2 16] "air"]]
   :limit-s 90}
  {:name "n2-pillar-up-no-false-wedge-2"
   :body {:inventory [["cobblestone" 8]]}
   :act [[:job (jobs.access.pillar {:height 3})] [:await {:source :job :kind :pillar.done} 60] [:wait-s 4]]
   :expect [{:no-event {:source :reflex :kind :fired} :for-s 20}]
   :after [[:not-block [16 1 16] "air"]]
   :limit-s 90}
  {:name "n2-place-next-to-feet-1"
   :body {:inventory [["cobblestone" 8]]}
   :act [[:job (jobs.blocks.place {:pos #at [17 0 16] :item "cobblestone"})] [:await {:source :job :kind :blocks.place.done} 40] [:wait-s 3]]
   :expect [{:no-event {:source :reflex :kind :fired} :for-s 15}]
   :after [[:block [17 0 16] "cobblestone"]]
   :limit-s 60}
  {:name "n2-place-next-to-feet-2"
   :body {:inventory [["cobblestone" 8]]}
   :act [[:job (jobs.blocks.place {:pos #at [16 0 17] :item "cobblestone"})] [:await {:source :job :kind :blocks.place.done} 40] [:wait-s 3]]
   :expect [{:no-event {:source :reflex :kind :fired} :for-s 15}]
   :after [[:block [16 0 17] "cobblestone"]]
   :limit-s 60}
  {:name "f1-lava-only-free-side-1"
   :blocks [[:fill [15 0 15] [17 1 17] "stone"] [:fill [16 0 16] [16 1 16] "air"]]
   :act [[:rcon "execute positioned $X $Y $Z run setblock ~16 ~ ~16 sand"] [:rcon "execute positioned $X $Y $Z run setblock ~17 ~ ~16 lava"] [:await {:source :job :kind :unwedge.blocked} 40] [:wait-s 15] [:rcon "tp $BODY $X $Y $Z"]]
   :body {:inventory [["iron_shovel" 1]] :effects [["fire_resistance" 600 0]]}
   :expect [{:event {:source :job :kind :unwedge.blocked} :within-s 45}
            {:no-event {:source :reflex :kind :fired :context {:job-id #{"j2" "j3" "j4" "j5" "j6"}}} :for-s 18}]
   :after [[:block [16 0 16] "sand"] [:block [17 0 16] "lava"]]}
  {:name "f2-lava-above-1"
   :blocks [[:fill [15 0 15] [17 1 17] "stone"] [:fill [16 0 16] [16 1 16] "air"]]
   :act [[:rcon "execute positioned $X $Y $Z run setblock ~16 ~ ~16 sand"] [:rcon "execute positioned $X $Y $Z run setblock ~16 ~1 ~16 lava"] [:await {:source :job :kind :unwedge.blocked} 40] [:wait-s 15] [:rcon "tp $BODY $X $Y $Z"]]
   :body {:inventory [["iron_shovel" 1]] :effects [["fire_resistance" 600 0]]}
   :expect [{:event {:source :job :kind :unwedge.blocked} :within-s 45}]
   :after [[:block [16 0 16] "sand"] [:block [16 1 16] "lava"]]}
  {:name "f3-bedrock-1"
   :blocks [[:fill [15 0 15] [17 1 17] "stone"] [:fill [16 0 16] [16 1 16] "air"]]
   :act [[:rcon "execute positioned $X $Y $Z run setblock ~16 ~ ~16 bedrock"] [:await {:source :job :kind :unwedge.blocked} 40] [:wait-s 15] [:rcon "tp $BODY $X $Y $Z"]]
   :body {:inventory [["iron_pickaxe" 1]]}
   :expect [{:event {:source :job :kind :unwedge.blocked} :within-s 45}]
   :after [[:block [16 0 16] "bedrock"]]}]}
