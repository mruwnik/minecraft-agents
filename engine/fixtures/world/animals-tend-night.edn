;; Readiness sweep G (card 218a15fd): animals.tend binds safe? at the middle of its pen, so a pen across open ground waits for dawn
;; with the reason, and by day the same call runs. Body at x 2, pen box x 20..24, z 10..14, two adult cows inside, :target 2.
;; Should-succeed: by day tend walks over and waits :nothing-to-do with the census. Should-fail: at night it waits :exposed and never reaches the pen.
{:defaults
 {:tags [:animals :night]
  :plot {:floor "grass_block"}
  :blocks [[:fill [19 0 9] [25 0 15] "oak_fence" :hollow]]
  :body {:at [2.5 0 12.5] :yaw 0 :settle-s 2 :inventory [["wheat" 4]] :effects [["resistance" 900 4]]}
  :limit-s 60}
 :cases
 [{:name "tend-at-night-across-open-ground-waits-exposed"
   :time :night
   :act [[:summon "cow" [21.5 0 11.5]]
         [:summon "cow" [23.5 0 13.5]]
         [:job (jobs.animals.tend {:mob "cow" :target 3 :box {:min #xyz [20 0 10] :max #xyz [24 0 14]}})]]
   :expect [{:event {:source :job :kind :waiting :data {:reason :exposed}} :within-s 30 :of-job true}
            {:no-event {:source :job :kind :completed} :for-s 15 :of-job true}]
   :after [[:body-near [2.5 0 12.5] 2]]}
  {:name "tend-by-day-walks-to-the-pen-and-counts"
   :time :day
   :act [[:summon "cow" [21.5 0 11.5]]
         [:summon "cow" [23.5 0 13.5]]
         [:job (jobs.animals.tend {:mob "cow" :target 2 :box {:min #xyz [20 0 10] :max #xyz [24 0 14]}})]]
   :expect [{:event {:source :job :kind :waiting :data {:reason :nothing-to-do :adults 2 :babies 0 :target 2 :skipped [:any]}} :within-s 50 :of-job true}]}]}
