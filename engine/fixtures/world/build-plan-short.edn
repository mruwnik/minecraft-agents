;; Cards 4df74238, 922e408e, 618c0e16: jobs.build.from-plan fetches what the plan lacks, names what it is short of, and fetches a tool
;; even while another item's fetch has failed.
;; tool-fetched-while-a-short-item-has-no-source: the plan wants dirt where stone stands ([20 0 16]; dirt carried, no pickaxe, a seen chest
;; holds one) and a gold_block nobody has; the gold fetch fails (:explore false) and the pickaxe is still fetched, the stone replaced.
;; default-fetch-gathers-logs-and-crafts-planks: oak_planks wanted, none carried, a log column in sight; the default :fetch obtains them.
;; fetch-false-names-the-short-item: the same plan with :fetch false stops short, naming the item. grass-under-the-floor-says-short:
;; a cobblestone cell holds grass, no cobblestone carried, :fetch false: build.wrong says "needs cobblestone (short)", the grass stays;
;; with a seen chest of cobblestone the default fetch brings it, the grass is dug and cobblestone placed.
{:defaults
 {:tags [:build :fetch] :time :any
  :plot {:height 8}
  :body {:at [16.5 0 16.5] :settle-s 2 :effects [["resistance" 600 4]]}
  :limit-s 150}
 :cases
 [{:name "tool-fetched-while-a-short-item-has-no-source"
   :blocks [[:set [20 0 16] "stone"]
            [:set [14 0 19] "chest{Items:[{Slot:0b,id:\"minecraft:stone_pickaxe\",count:1}]}"]]
   :body {:inventory [["dirt" 4]]}
   :plans [{:id "mixed" :metadata {:by "$body"}
            :parts [{:id "gold" :cells [#at [22 0 16]] :want "gold_block"}
                    {:id "cell" :cells [#at [20 0 16]] :want "dirt"}]}]
   :act [[:rcon "execute as $BODY at @s run tp @s ~ ~ ~ 0 20"] [:wait-s 2]
         [:job (jobs.build.from-plan {:plan "$plan:mixed" :fetch {:explore false}})]]
   :expect [{:event {:source :job :kind :fetch.done} :within-s 100 :of-job true}
            {:event {:source :job :kind :stopped} :within-s 130 :of-job true}]
   :after [[:block [20 0 16] "dirt"] [:item "stone_pickaxe" 1] [:not-block [22 0 16] "gold_block"]]}
  {:name "default-fetch-gathers-logs-and-crafts-planks"
   :blocks [[:fill [24 0 14] [24 3 14] "oak_log"] [:set [24 4 14] "oak_leaves[persistent=true]"]]
   :plans [{:id "floor" :metadata {:by "$body"} :parts [{:id "p" :cells [#at [14 0 14] #at [15 0 14]] :want "oak_planks"}]}]
   :act [[:job (jobs.build.from-plan {:plan "$plan:floor"})]]
   :expect [{:event {:source :job :kind :fetch.started} :within-s 30 :of-job true}
            {:event {:source :job :kind :completed :data {:missing []}} :within-s 140 :of-job true}]
   :after [[:block [14 0 14] "oak_planks"] [:block [15 0 14] "oak_planks"]]}
  {:name "fetch-false-names-the-short-item"
   :blocks [[:fill [24 0 14] [24 3 14] "oak_log"] [:set [24 4 14] "oak_leaves[persistent=true]"]]
   :plans [{:id "floor" :metadata {:by "$body"} :parts [{:id "p" :cells [#at [14 0 14] #at [15 0 14]] :want "oak_planks"}]}]
   :act [[:job (jobs.build.from-plan {:plan "$plan:floor" :fetch false})]]
   :expect [{:event {:source :job :kind :build.short :message [:contains "oak_planks"]} :within-s 40 :of-job true}
            {:no-event {:source :job :kind :fetch.started} :for-s 30}]
   :after [[:not-block [14 0 14] "oak_planks"]]
   :limit-s 60}
  {:name "grass-under-the-floor-says-short"
   :blocks [[:set [18 -1 16] "grass_block"]]
   :body {:inventory [["iron_pickaxe" 1]]}
   :plans [{:id "ring" :metadata {:by "$body"} :parts [{:id "cell" :cells [#at [18 -1 16]] :want "cobblestone"}]}]
   :act [[:job (jobs.build.from-plan {:plan "$plan:ring" :fetch false})]]
   :expect [{:event {:source :job :kind :build.wrong :message [:contains "needs cobblestone (short)"]} :within-s 40 :of-job true}]
   :after [[:block [18 -1 16] "grass_block"]]
   :limit-s 60}
  {:name "grass-under-the-floor-fetches-cobblestone-and-replaces"
   :blocks [[:set [18 -1 16] "grass_block"]
            [:set [14 0 19] "chest{Items:[{Slot:0b,id:\"minecraft:cobblestone\",count:8}]}"]]
   :body {:inventory [["iron_pickaxe" 1]]}
   :plans [{:id "ring" :metadata {:by "$body"} :parts [{:id "cell" :cells [#at [18 -1 16]] :want "cobblestone"}]}]
   :act [[:rcon "execute as $BODY at @s run tp @s ~ ~ ~ 0 20"] [:wait-s 2]
         [:job (jobs.build.from-plan {:plan "$plan:ring"})]]
   :expect [{:event {:source :job :kind :fetch.done} :within-s 80 :of-job true}
            {:event {:source :job :kind :completed :data {:missing []}} :within-s 130 :of-job true}]
   :after [[:block [18 -1 16] "cobblestone"]]}]}
