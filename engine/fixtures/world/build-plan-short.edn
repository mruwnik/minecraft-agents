;; Cards 4df74238, 922e408e, 618c0e16: jobs.build.from-plan fetches what the plan lacks, names what it is short of, and fetches a tool
;; even while another item's fetch has failed.
;; tool-fetched-while-a-short-item-has-no-source: the plan wants dirt where stone stands ([20 0 16]; dirt carried, no pickaxe, a seen chest
;; holds one) and a gold_block nobody has; the gold fetch fails (:explore false) and the pickaxe is still fetched, the stone replaced.
;; default-fetch-gathers-logs-and-crafts-planks: oak_planks wanted, none carried, a log column in sight; the default :fetch obtains them.
;; fetch-false-names-the-short-item: the same plan with :ways #{:carried} names the item: the job waits :no-items. grass-under-the-floor-says-short:
;; a cobblestone cell holds grass, no cobblestone carried, :ways #{:carried}: the job waits :no-items needing cobblestone, the grass stays.
;; Both turn the body to face the cells first and wait: a cell not yet in view is looked at, and the job then ends stopped short instead
;; (unit: an-unseen-floor-with-nothing-carried-is-looked-at-then-ends-short-never-waits);
;; with a seen chest of cobblestone the default fetch brings it, the grass is dug and cobblestone placed.
;; air-want-clears-the-cell (cards 8a7774d1): a cell wanted "air" holding stone is dug, "air" is never fetched; the job completes with nothing missing.
;; any-want-uses-what-is-carried (93b3dba5): a part wanting [:any cobblestone granite dirt] is built from granite carried, never fetching cobblestone;
;; with none of them carried the first listed is fetched. in-a-pit-walks-out-and-places (8a7774d1, cd5a0d81): a body 3 deep in a pit (as after a dirt dig) escalates out of it to reach its stands, instead of idling.
{:defaults
 {:tags [:build :fetch]
  :plot {:height 8}
  :body {:at [16.5 0 16.5] :settle-s 2 :effects [["resistance" 600 4]]}
  :limit-s 150}
 :cases
 [{:name "tool-fetched-while-a-short-item-has-no-source"
   :blocks [[:set [20 0 16] "stone"]
            [:set [14 0 19] "chest{Items:[{Slot:0b,id:\"minecraft:stone_pickaxe\",count:1}]}"]]
   :body {:inventory [["dirt" 4]]}
   :plans [{:id "mixed" :metadata {:by "$body"}
            :parts [{:id "gold" :cells [#at [22 0 16]] :want "gold_block"}
                    {:id "cell" :cells [#at [20 0 16]] :want "dirt"}]}]
   :act [[:rcon "execute as $BODY at @s run tp @s ~ ~ ~ 0 20"] [:until-seen {:block "chest"} 10]
         [:job (jobs.build.from-plan {:plan "$plan:mixed" :explore false})]]
   :expect [{:event {:source :job :kind :child_ended :data {:slot :need :ending {:kind :done}}} :within-s 100 :of-job true}
            {:event {:source :job :kind :stopped} :within-s 130 :of-job true}]
   :after [[:block [20 0 16] "dirt"] [:item "stone_pickaxe" 1] [:not-block [22 0 16] "gold_block"]]}
  {:name "default-fetch-gathers-logs-and-crafts-planks"
   :blocks [[:fill [24 0 14] [24 3 14] "oak_log"] [:set [24 4 14] "oak_leaves[persistent=true]"]]
   :plans [{:id "floor" :metadata {:by "$body"} :parts [{:id "p" :cells [#at [14 0 14] #at [15 0 14]] :want "oak_planks"}]}]
   :act [[:job (jobs.build.from-plan {:plan "$plan:floor"})]]
   :expect [{:event {:source :job :kind :child_started :data {:slot :need}} :within-s 30 :of-job true}
            {:event {:source :job :kind :completed :data {:missing []}} :within-s 140 :of-job true}]
   :after [[:block [14 0 14] "oak_planks"] [:block [15 0 14] "oak_planks"]]}
  {:name "fetch-false-names-the-short-item"
   :blocks [[:fill [24 0 14] [24 3 14] "oak_log"] [:set [24 4 14] "oak_leaves[persistent=true]"]]
   :plans [{:id "floor" :metadata {:by "$body"} :parts [{:id "p" :cells [#at [14 0 14] #at [15 0 14]] :want "oak_planks"}]}]
   :act [[:rcon "execute as $BODY at @s run tp @s ~ ~ ~ 135 40"] [:until-facing {:yaw 135 :pitch 40} 10]
         [:job (jobs.build.from-plan {:plan "$plan:floor" :ways #{:carried}})]]
   :expect [{:event {:source :job :kind :waiting :data {:reason :no-items :needs {"oak_planks" 2}}} :within-s 40 :of-job true}
            {:no-event {:source :job :kind :child_started :data {:slot :need}} :for-s 30}]
   :after [[:not-block [14 0 14] "oak_planks"]]
   :limit-s 60}
  {:name "grass-under-the-floor-says-short"
   :blocks [[:set [18 -1 16] "grass_block"]]
   :body {:inventory [["iron_pickaxe" 1]]}
   :plans [{:id "ring" :metadata {:by "$body"} :parts [{:id "cell" :cells [#at [18 -1 16]] :want "cobblestone"}]}]
   :act [[:rcon "execute as $BODY at @s run tp @s ~ ~ ~ -90 60"] [:until-facing {:yaw -90 :pitch 60} 10]
         [:job (jobs.build.from-plan {:plan "$plan:ring" :ways #{:carried}})]]
   :expect [{:event {:source :job :kind :waiting :data {:reason :no-items :needs #{{"cobblestone" 1} {:cobblestone 1}}}} :within-s 40 :of-job true}]
   :after [[:block [18 -1 16] "grass_block"]]
   :limit-s 60}
  {:name "grass-under-the-floor-fetches-cobblestone-and-replaces"
   :blocks [[:set [18 -1 16] "grass_block"]
            [:set [14 0 19] "chest{Items:[{Slot:0b,id:\"minecraft:cobblestone\",count:8}]}"]]
   :body {:inventory [["iron_pickaxe" 1]]}
   :plans [{:id "ring" :metadata {:by "$body"} :parts [{:id "cell" :cells [#at [18 -1 16]] :want "cobblestone"}]}]
   :act [[:rcon "execute as $BODY at @s run tp @s ~ ~ ~ 0 20"] [:until-seen {:block "chest"} 10]
         [:job (jobs.build.from-plan {:plan "$plan:ring"})]]
   :expect [{:event {:source :job :kind :child_ended :data {:slot :need :ending {:kind :done}}} :within-s 80 :of-job true}
            {:event {:source :job :kind :completed :data {:missing []}} :within-s 130 :of-job true}]
   :after [[:block [18 -1 16] "cobblestone"]]}
  {:name "air-want-clears-the-cell"
   :blocks [[:set [20 0 16] "stone"] [:set [20 0 17] "stone"]]
   :body {:inventory [["iron_pickaxe" 1] ["dirt" 4]]}
   :plans [{:id "door" :metadata {:by "$body"}
            :parts [{:id "gap" :cells [#at [20 0 16] #at [20 0 17]] :want "air"}
                    {:id "wall" :cells [#at [20 0 15]] :want "dirt"}]}]
   :act [[:job (jobs.build.from-plan {:plan "$plan:door"})]]
   :expect [{:event {:source :job :kind :completed :data {:missing []}} :within-s 100 :of-job true}
            {:no-event {:source :job :kind :child_started :data {:slot :need}} :for-s 20}]
   :after [[:not-block [20 0 16] "stone"] [:not-block [20 0 17] "stone"] [:block [20 0 15] "dirt"]]
   :limit-s 120}
  {:name "in-a-pit-walks-out-and-places"
   :plot {:height 8 :floor "stone"}
   :blocks [[:fill [0 0 0] [31 2 31] "stone"] [:fill [16 0 16] [16 2 16] "air"] [:fill [0 4 0] [31 4 31] "light"]]
   :body {:at [16.5 0 16.5] :inventory [["iron_pickaxe" 1] ["dirt" 4]]}
   :plans [{:id "floor" :metadata {:by "$body"} :parts [{:id "p" :cells [#at [10 3 10] #at [11 3 10]] :want "dirt"}]}]
   :act [[:job (jobs.build.from-plan {:plan "$plan:floor"})]]
   :expect [{:event {:source :job :kind :completed :data {:missing []}} :within-s 120 :of-job true}]
   :after [[:block [10 3 10] "dirt"] [:block [11 3 10] "dirt"]]
   :limit-s 150}
  {:name "any-want-uses-what-is-carried"
   :body {:inventory [["cobblestone" 2] ["granite" 20] ["dirt" 20]]}
   :plans [{:id "ramp" :metadata {:by "$body"} :parts [{:id "r" :cells [#at [20 0 14] #at [21 0 14] #at [22 0 14] #at [23 0 14] #at [24 0 14]] :want [:any "cobblestone" "granite" "dirt"]}]}]
   :act [[:job (jobs.build.from-plan {:plan "$plan:ramp"})]]
   :expect [{:event {:source :job :kind :completed :data {:missing []}} :within-s 100 :of-job true}
            {:no-event {:source :job :kind :child_started :data {:slot :need}} :for-s 20}]
   :after [[:not-block [20 0 14] "air"] [:not-block [24 0 14] "air"]]
   :limit-s 120}
  {:name "any-want-with-none-carried-fetches-the-first-listed"
   :blocks [[:set [14 0 19] "chest{Items:[{Slot:0b,id:\"minecraft:cobblestone\",count:8}]}"]]
   :plans [{:id "ramp" :metadata {:by "$body"} :parts [{:id "r" :cells [#at [20 0 14] #at [21 0 14]] :want [:any "cobblestone" "granite" "dirt"]}]}]
   :act [[:rcon "execute as $BODY at @s run tp @s ~ ~ ~ 0 20"] [:until-seen {:block "chest"} 10]
         [:job (jobs.build.from-plan {:plan "$plan:ramp"})]]
   :expect [{:event {:source :job :kind :child_started :data {:slot :need}} :within-s 40 :of-job true}
            {:event {:source :job :kind :completed :data {:missing []}} :within-s 130 :of-job true}]
   :after [[:block [20 0 14] "cobblestone"]]}
  ;; card a8b2455b: a from-plan check that cannot pass waits with its reason, a few events at most, not a warning each tick (farm.tend: farm-tend-zones.edn keeps tend waiting :nothing-to-do)
  {:name "unmet-need-waits-without-warning-each-tick"
   :plans [{:id "gold" :metadata {:by "$body"} :parts [{:id "g" :cells [#at [22 0 16]] :want "gold_block"}]}]
   :act [[:job (jobs.build.from-plan {:plan "$plan:gold" :ways #{:carried}})]]
   :expect [{:event {:source :job :kind #{:waiting :stopped}} :within-s 30 :of-job true}
            {:count-event {:source :job :level :warn} :for-s 25 :at-most 3}]
   :limit-s 40}]}
