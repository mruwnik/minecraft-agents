;; Extinguish with no water (card 0fd16298): the body stands on a burning netherrack cell (fire above it), the burning reflex
;; fires jobs.survival.extinguish. With no water within 6 it steps off the fire, then stands still (no
;; walking while burning, the job stays alive) and the interrupted go-to resumes only once the fire is out. With a cover block
;; carried it places it on an adjacent lava source; with water in reach it walks into the water instead of standing.
{:defaults
 {:tags [:survival :fire] :time :any
  :plot {:height 6}
  :register [{:trigger :burning :persistence :cooldown :cooldown-s 0 :job (jobs.survival.extinguish {:water-radius 6})}]
  :blocks [[:set [10 -1 16] "netherrack"] [:set [10 0 16] "fire"]]
  :body {:at [10.5 0 16.5] :settle-s 1}
  :limit-s 90}
 :cases
 [{:name "stands-still-then-go-to-arrives-1"
   :act [[:job (jobs.movement.go-to {:pos #at [26 0 16] :range 1})]]
   :expect [{:no-event {:source :action :kind :started :data {:name "steer"}} :for-s 20 :until {:source :reflex :kind :ended}}
            {:event {:source :job :kind :completed :data {:arrived true}} :within-s 80 :of-job true}]
   :after [[:body-near [26.5 0 16.5] 2]]}
  {:name "burning-in-rain-is-still-handled"
   :weather :rain :time :day :time-why :weather
   :act [[:job (jobs.movement.go-to {:pos #at [26 0 16] :range 1})]]
   :expect [{:event {:source :reflex :kind :fired :context {:reflex-id :burning}} :within-s 20}
            {:event {:source :job :kind :completed :data {:arrived true}} :within-s 80 :of-job true}]
   :after [[:body-near [26.5 0 16.5] 2]]}
  {:name "water-within-6-walks-into-it"
   :blocks [[:set [14 -2 16] "stone"] [:set [14 -1 16] "water"]]
   :expect [{:event {:source :reflex :kind :ended :context {:reflex-id :burning}} :within-s 20}]
   :after [[:body-near [14.5 -1 16.5] 1.5]]
   :limit-s 30}]}
