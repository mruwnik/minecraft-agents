;; Hostile reflex choices with a melee mob close and a ranged one or low health. Cards db6d0ab0 (armed body fights an adjacent
;; zombie, no seal first), 72b423bf (zombie near and skeleton with a line of fire: cover, not a swing at the zombie),
;; fabdb0ed (low health beside a creeper walks, no take-cover seal), e0dbcd37 (armed body turns on the zombie; a creeper is
;; still backed off from). Mobs are helmeted (no sun burn). NoAI
;; ones never hurt; the fight cases judge by the zombie dying. The 72b423bf skeleton has AI (its arrows are the "under
;; fire" the cover rule reads; resistance 1 lets the hits count) and the zombie walks in slowed, after the first arrow. Open flat ground, torches for light.
{:defaults
 {:tags [:hostile :survival :cornered]
  :time :any
  :mobs :keep
  :register [{:trigger :hostile-near}]
  :body {:at [16.5 0 16.5] :effects [["resistance" 600 4]]}
  :limit-s 70}
 :cases
 [{:name "armed-body-kills-the-adjacent-zombie-without-sealing"
   :body {:inventory [["iron_sword" 1] ["cobblestone" 20]]}
   :act [[:summon "zombie" [18.5 0 16.5] "{NoAI:1b,equipment:{head:{id:\"minecraft:iron_helmet\",count:1}}}"]]
   :expect [{:event {:source :reflex :kind :fired :context {:reflex-id :hostile-near}} :within-s 15}
            {:no-event {:source :job :kind #{:retreat_sealed}} :for-s 40}]
   :after [[:entities "type=zombie,tag=wt" [[0 0 0] [31 6 31]] 0]]}
  ;; Card 96596333 (design rule 4: a lone creeper is fought hit-and-back, so this is the e0dbcd37 scene): the zombie is fought,
  ;; the creeper in sight across the plot (too far to reach the fight before it ends) is never the target; no resistance, so a blast would show.
  {:name "armed-body-kills-the-zombie-and-leaves-a-creeper-across-the-plot-alone"
   :body {:yaw 270 :inventory [["iron_sword" 1] ["cobblestone" 20]] :effects []}
   :act [[:summon "zombie" [18.5 0 16.5] "{NoAI:1b,equipment:{head:{id:\"minecraft:iron_helmet\",count:1}}}"]
         [:summon "creeper" [30.5 0 28.5] "{NoAI:1b,equipment:{head:{id:\"minecraft:iron_helmet\",count:1}}}"]]
   :expect [{:event {:source :job :kind :hostile.decided :data {:mob "zombie" :decision :fight}} :within-s 15}
            {:no-event {:source :body :kind :hurt} :for-s 30}]
   :after [[:entities "type=zombie,tag=wt" [[0 0 0] [31 6 31]] 0]
           [:entities "type=creeper,tag=wt" [[0 0 0] [31 6 31]] 1]]}
  {:name "zombie-near-and-skeleton-in-line-takes-cover-not-a-swing"
   :body {:inventory [["iron_sword" 1] ["cobblestone" 20]] :effects [["resistance" 600 1]]}
   :act [[:summon "skeleton" [25.5 0 16.5] "{equipment:{head:{id:\"minecraft:iron_helmet\",count:1}}}"]
         [:summon "zombie" [16.5 0 21.5] "{equipment:{head:{id:\"minecraft:iron_helmet\",count:1}},active_effects:[{id:\"minecraft:slowness\",amplifier:2b,duration:2400}]}"]]
   :expect [{:event {:source :job :kind :retreat.choice} :within-s 20}
            {:no-event {:source :job :kind :child_started :data {:slot :fight}} :for-s 60}
            {:no-event {:source :body :kind :died} :for-s 60}]
   :limit-s 70}
  {:name "low-health-creeper-and-skeleton-walks-away"
   :body {:inventory [["cobblestone" 20]] :effects []}
   :act [[:rcon "damage $BODY 12 minecraft:generic"]
         [:summon "skeleton" [22.5 0 16.5] "{NoAI:1b,equipment:{head:{id:\"minecraft:iron_helmet\",count:1}}}"]
         [:summon "creeper" [16.5 0 13.5] "{NoAI:1b,equipment:{head:{id:\"minecraft:iron_helmet\",count:1}}}"]]
   :expect [{:event {:source :job :kind :retreat.target} :within-s 15}
            {:no-event {:source :job :kind :retreat_sealed} :for-s 15}]
   :limit-s 40}
  {:name "low-health-skeleton-alone-seals-in"
   :plot {:light :sky}
   :body {:inventory [["cobblestone" 20]] :effects []}
   :act [[:rcon "damage $BODY 12 minecraft:generic"]
         [:summon "skeleton" [22.5 0 16.5] "{NoAI:1b,equipment:{head:{id:\"minecraft:iron_helmet\",count:1}}}"]]
   :expect [{:event {:source :job :kind :retreat_sealed} :within-s 30}]
   :after [[:body-near [16.5 0 16.5] 2.5]]}
  ;; Card 93b49dda: a spider outruns the body and a fist fight hardly survives it, so the body digs in (a dirt patch under it:
  ;; stone needs a pick) and hides; the spider has its AI and the body no resistance.
  {:name "unarmed-full-health-body-digs-in-from-a-spider-never-fights"
   :blocks [[:fill [12 -4 12] [21 -1 21] "dirt"]]
   :body {:effects []}
   :act [[:summon "spider" [22.5 0 16.5] "{equipment:{head:{id:\"minecraft:iron_helmet\",count:1}}}"]]
   :expect [{:event {:source :job :kind :retreat_sealed} :within-s 30}
            {:no-event {:source :job :kind :child_started :data {:slot :fight}} :for-s 30}
            {:no-event {:source :body :kind :hurt :data {:health [:<= 12]}} :for-s 40}]
   :limit-s 60}]}
