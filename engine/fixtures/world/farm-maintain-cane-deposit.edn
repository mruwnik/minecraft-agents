;; farm.maintain deposits the sugar cane it carries into its chest (cane is a farm good).
;; Chest [9 0 16], farmland [10 -1 16] with water beside; the body carries 40 sugar cane.
;; Should-succeed: the cane ends in the chest, none carried.
;; Should-fail: none (old code left the cane carried: no stalk items in the farm goods).
{:defaults
 {:tags [:farm :stalks :jobs]
  :time :any
  :body {:at [10.5 0 14.5] :effects [["resistance" 600 4]]}
  :limit-s 90}
 :cases
 [{:name "carried-sugar-cane-is-deposited-in-the-chest"
   :blocks [[:set [10 -1 16] "farmland[moisture=7]"] [:set [10 -2 17] "stone"] [:set [10 -1 17] "water"]
            [:set [9 0 16] "chest"] [:set [11 0 16] "composter"]]
   :body {:inventory [["sugar_cane" 40]]}
   :act [[:job (jobs.farm.maintain {:worth 1200 :area {:min #xyz [10 -1 16] :max #xyz [10 0 16]} :chest #xyz [9 0 16] :composter #xyz [11 0 16]})]]
   :expect [{:event {:source :job :kind #{:completed :stopped} :data {:steps {:deposit {:gave-up false}}}} :within-s 80 :of-job true}]
   :after [[:item "sugar_cane" 0] [:block [9 0 16] "chest{Items:[{id:\"minecraft:sugar_cane\",count:40}]}"]]}]}
