;; Card 4c6a91f3: a body shut in its own shelter does not fail search legs against its own walls (three blocked walks ended the search :stuck).
;; Card 94c0f053: the search holds for no dark sky; each leg is a go-to that prices its own route, so the body leaves the lit shelter, walks the torch-lit way and finds the target.
;; Stone room x 14..18, z 14..18, roof y 2, :shelter memory at the body's cell, a glass east wall and torch pairs along the way;
;; a pickaxe carried for the way out; an emerald block 24 east, beyond the scan radius.
;; Should-succeed: the job completes :found. Should-fail: the job stops :stuck.
{:defaults
 {:tags [:explore :search :shelter]
  :time :any
  :plot {:height 8 :floor "grass_block" :light :sky :length 48}
  :blocks [[:set [40 0 16] "emerald_block"]
           [:fill [14 0 14] [18 2 18] "stone"] [:fill [15 0 15] [17 1 17] "air"] [:fill [18 0 15] [18 1 17] "glass"]
           [:set [24 0 15] "torch"] [:set [24 0 17] "torch"] [:set [32 0 15] "torch"] [:set [32 0 17] "torch"] [:set [40 0 15] "torch"] [:set [40 0 17] "torch"]]
  :memory [{:kind :shelter :data {:pos #xyz [16 0 16] :roof #xyz [16 2 16] :state :built}
            :policy {:cap 10 :ttl 1200000}}]
  :register []
  :body {:at [16.5 0 16.5] :settle-s 2 :inventory [["stone_pickaxe" 1] ["dirt" 8]] :effects [["resistance" 600 4]]}
  :limit-s 200}
 :cases
 [{:name "sealed-in-its-shelter-leaves-and-finds-the-target"
   :act [[:job (jobs.explore.search {:target "emerald_block" :pattern :outward :heading :east :scan-radius 8 :use-notes false
                                     :settings {:jobs.explore.search/max-distance 60 :jobs.lib.cost.find/leg-spacing 8 :jobs.explore.search/max-legs 16}})]]
   :expect [{:event {:source :job :kind :completed :data {:reason :found}} :within-s 150 :of-job true}]
   :limit-s 190}]}
