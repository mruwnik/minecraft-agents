;; jobs.gather.dig-for (card fb51965f): the dig of jobs.gather.mine from where the body stands, with what it carries: no fetch, no mend,
;; no walk home. It ends at the ore (:completed), or :stopped with a text that says what is missing: no usable pickaxe (:no-tool, absent or
;; nearly spent), no torch to hang (:no-torches). The last case is the trip, jobs.gather.mine, getting a pickaxe first and coming home.
;; Open floor (plot stone floor y -1); body at [16.5 0 16.5]; ore in the open 8 blocks east (cases 1-3); a stone mass with the ore at the end of the line (case 4).
{:defaults
 {:tags [:mine :jobs] :time :any
  :plot {:height 12}
  :blocks [[:set [24 0 16] "iron_ore"]]
  :body {:at [16.5 0 16.5] :inventory [["stone_pickaxe" 1] ["torch" 8]] :effects [["resistance" 600 4]]}
  :limit-s 120}
 :cases
 [{:name "dig-for-stays-where-the-dig-ends"
   :act [[:job (jobs.gather.dig-for {:torch-interval 0 :block "iron_ore" :level false :count 1 :tunnel-length 0 :descend-limit 0 :radius 10})]]
   :expect [{:event {:source :job :kind #{:completed :stopped} :data {:got 1 :reason :count}} :within-s 100 :of-job true}]
   :after [[:item "raw_iron" 1] [:not-block [24 0 16] "iron_ore"] [:body-far [16.5 0 16.5] 2]]}
  {:name "dig-for-without-a-pickaxe-ends-no-tool-and-stays"
   :body {:inventory [["torch" 8]]}
   :act [[:job (jobs.gather.dig-for {:block "iron_ore" :level false :count 1 :tunnel-length 0 :descend-limit 0 :radius 10})]]
   :expect [{:event {:source :job :kind :stopped :data {:got 0 :reason :no-tool :kind :condition-failed :text [:contains "jobs.gather.mine"]}} :within-s 60 :of-job true}]
   :after [[:block [24 0 16] "iron_ore"] [:item "raw_iron" 0] [:body-near [16.5 0 16.5] 1]]}
  {:name "dig-for-with-a-spent-last-pickaxe-ends-no-tool"
   :body {:inventory [["stone_pickaxe[damage=129]" 1] ["torch" 8]]}
   :act [[:job (jobs.gather.dig-for {:block "iron_ore" :level false :count 1 :tunnel-length 0 :descend-limit 0 :radius 10})]]
   :expect [{:event {:source :job :kind :stopped :data {:got 0 :reason :no-tool :text [:contains "nearly spent"]}} :within-s 60 :of-job true}]
   :after [[:block [24 0 16] "iron_ore"] [:item "raw_iron" 0] [:body-near [16.5 0 16.5] 1]]}
  {:name "dig-for-with-no-torch-to-hang-ends-no-torches"
   :blocks [[:fill [2 0 8] [30 6 30] "stone"] [:fill [16 0 16] [16 1 16] "air"] [:set [24 0 16] "iron_ore"]]
   :body {:inventory [["stone_pickaxe" 1]]}
   :act [[:job (jobs.gather.dig-for {:block "iron_ore" :level false :count 1 :direction :east :tunnel-length 12 :radius 10})]]
   :expect [{:event {:source :job :kind :stopped :data {:got 0 :reason :no-torches :text [:contains "no torches left"]}} :within-s 90 :of-job true}]
   :after [[:block [24 0 16] "iron_ore"] [:item "raw_iron" 0]]}
  {:name "dig-for-with-no-torch-in-a-lit-cut-digs-on-hanging-none"
   :blocks [[:fill [17 0 15] [23 1 17] "stone"] [:fill [17 0 16] [17 1 16] "air"]]
   :body {:inventory [["stone_pickaxe" 1]]}
   :act [[:job (jobs.gather.dig-for {:block "iron_ore" :level false :count 1 :direction :east :tunnel-length 12 :radius 10})]]
   :expect [{:event {:source :job :kind #{:completed :stopped} :data {:got 1}} :within-s 100 :of-job true}]
   :after [[:item "raw_iron" 1] [:not-block [18 0 16] "wall_torch"]]}
  {:name "mine-trip-crafts-a-pickaxe-digs-and-comes-home"
   :blocks [[:fill [20 0 14] [26 2 18] "stone"]]
   :body {:inventory [["oak_planks" 4] ["stick" 2] ["crafting_table" 1]]}
   :act [[:job (jobs.gather.mine {:torch-interval 0 :block "stone" :count 1 :tunnel-length 0 :descend-limit 0 :radius 10})]]
   :expect [{:event {:source :job :kind #{:completed :stopped} :data {:got [:>= 1] :reason :count}} :within-s 110 :of-job true}
            {:no-event {:source :job :kind :mine.not-home} :for-s 110 :until {:source :job :kind #{:completed :stopped}}}]
   :after [[:item "cobblestone" [:>= 1]] [:body-near [16.5 0 16.5] 2]]
   :limit-s 130}]}
