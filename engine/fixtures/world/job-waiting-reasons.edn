;; Card b7fe85d4: a job whose condition fails waits with its own reason (job.waiting :reason ...) instead of a plain false (:not-ready).
;; Calm day world, the job submitted with no args. A job whose goal already holds ends done :already (leave-vehicle, breathe, extinguish,
;; unwedge, respond-to-hostile, get-food, restore-broken); mine with no block is impossible. The last three cases provoke the condition (water, fire, a zombie)
;; before the submit and expect a round.
{:defaults
 {:tags [:jobs :survival]
  :time :any
  :plot {:height 16}
  :body {:at [16.5 0 16.5] :effects [["resistance" 600 4]] :settle-s 2}
  :limit-s 40}
 :cases
 [  {:name "clear-box-bad-args-is-impossible"
   :act [[:job (jobs.build.clear-box {})]]
   :expect [{:event {:source :job :kind :stopped :data {:reason :bad-args}} :within-s 20 :of-job true}
            {:no-event {:source :job :kind :waiting} :for-s 3 :until {:source :job :kind :stopped} :of-job true}]}
  {:name "mine-no-block-is-impossible"
   :act [[:job (jobs.gather.mine {:torch-interval 0 })]]
   :expect [{:event {:source :job :kind :stopped :data {:reason :no-block}} :within-s 20 :of-job true}
            {:no-event {:source :job :kind :waiting} :for-s 3 :until {:source :job :kind :stopped} :of-job true}]}
  {:name "leave-vehicle-not-mounted-is-done-already"
   :act [[:job (jobs.movement.leave-vehicle {})]]
   :expect [{:event {:source :job :kind :completed :data {:kind :done :cause :already}} :within-s 20 :of-job true}]}
  {:name "breathe-not-underwater-is-done-already"
   :act [[:job (jobs.survival.breathe {})]]
   :expect [{:event {:source :job :kind :completed :data {:kind :done :cause :already}} :within-s 20 :of-job true}]}
  {:name "extinguish-not-burning-is-done-already"
   :act [[:job (jobs.survival.extinguish {})]]
   :expect [{:event {:source :job :kind :completed :data {:kind :done :cause :already}} :within-s 20 :of-job true}]}
  {:name "get-food-not-hungry-is-done-already"
   :act [[:job (jobs.survival.get-food {})]]
   :expect [{:event {:source :job :kind :completed :data {:kind :done :cause :already}} :within-s 20 :of-job true}]}
  {:name "night-waits-not-night"
   :time :day :time-why :dawn-decision
   :act [[:job (jobs.survival.night {})]]
   :expect [{:event {:source :job :kind :waiting :data {:reason :not-night}} :within-s 20 :of-job true}
            {:no-event {:source :job :kind :waiting :data {:reason :not-ready}} :for-s 20 :until {:source :job :kind :waiting :data {:reason :not-night}} :of-job true}
            {:no-event {:source :job :kind :round_started} :for-s 20 :until {:source :job :kind :waiting :data {:reason :not-night}} :of-job true}]}
  {:name "recover-drops-waits-no-drops"
   :act [[:job (jobs.survival.recover-drops {})]]
   :expect [{:event {:source :job :kind :waiting :data {:reason :no-drops}} :within-s 20 :of-job true}
            {:no-event {:source :job :kind :waiting :data {:reason :not-ready}} :for-s 20 :until {:source :job :kind :waiting :data {:reason :no-drops}} :of-job true}
            {:no-event {:source :job :kind :round_started} :for-s 20 :until {:source :job :kind :waiting :data {:reason :no-drops}} :of-job true}]}
  {:name "respond-to-hostile-no-hostile-is-done-already"
   :act [[:job (jobs.survival.respond-to-hostile {})]]
   :expect [{:event {:source :job :kind :completed :data {:kind :done :cause :already}} :within-s 20 :of-job true}]}
  {:name "restore-broken-nothing-to-restore-is-done-already"
   :act [[:job (jobs.survival.restore-broken {})]]
   :expect [{:event {:source :job :kind :completed :data {:kind :done :cause :already}} :within-s 20 :of-job true}]}
  {:name "unwedge-not-wedged-is-done-already"
   :act [[:job (jobs.survival.unwedge {})]]
   :expect [{:event {:source :job :kind :completed :data {:kind :done :cause :already}} :within-s 20 :of-job true}]}
  {:name "breathe-runs-when-the-body-is-in-water"
   :act [[:rcon "execute positioned $X $Y $Z run fill ~13 ~-1 ~13 ~19 ~6 ~19 water"]
         [:job (jobs.survival.breathe {})]]
   :expect [{:event {:source :job :kind :round_started} :within-s 40 :of-job true}]}
  {:name "extinguish-runs-when-the-body-burns"
   :act [[:rcon "execute positioned $X $Y $Z run setblock ~16 ~-1 ~16 netherrack"]
         [:rcon "execute positioned $X $Y $Z run setblock ~16 ~ ~16 fire"]
         [:job (jobs.survival.extinguish {})]]
   :expect [{:event {:source :job :kind :round_started} :within-s 40 :of-job true}]}
  {:name "respond-to-hostile-runs-when-a-zombie-is-near"
   :mobs :keep
   :act [[:summon "zombie" [20.5 0 16.5] "{NoAI:1b,equipment:{head:{id:\"minecraft:iron_helmet\",count:1}}}"] [:until-seen {:entity "zombie"} 10]
         [:job (jobs.survival.respond-to-hostile {:radius 8 :ranged-radius 16})]]
   :expect [{:event {:source :job :kind :round_started} :within-s 40 :of-job true}]}
  ;; card 1a708c35: the state goals that already hold end done, not condition-failed or waiting (eat, block-arrow-gap, night)
  {:name "eat-fed-with-food-carried-is-done-already-and-eats-nothing"
   :body {:inventory [["bread" 3]]}
   :act [[:job (jobs.survival.eat {})]]
   :expect [{:event {:source :job :kind :completed :data {:kind :done}} :within-s 20 :of-job true}
            {:no-event {:source :job :kind #{:stopped :waiting}} :for-s 5 :until {:source :job :kind :completed} :of-job true}]
   :after [[:item "bread" 3]]}
  {:name "block-arrow-gap-no-ranged-danger-is-done-already"
   :act [[:job (jobs.survival.block-arrow-gap {})]]
   :expect [{:event {:source :job :kind :completed :data {:kind :done :cause :already}} :within-s 20 :of-job true}]}
  {:name "night-in-a-closed-roofed-room-is-done-at-once"
   :time :night
   :blocks [[:fill [8 0 8] [16 3 16] "stone" :hollow] [:fill [9 0 9] [15 2 15] "air"] [:set [9 1 9] "torch"] [:set [15 1 15] "torch"]]
   :body {:at [13.5 0 13.5]}
   :act [[:job (jobs.survival.night {})]]
   :expect [{:event {:source :job :kind :completed :data {:kind :done}} :within-s 25 :of-job true}
            {:no-event {:source :job :kind #{:stopped :waiting}} :for-s 5 :until {:source :job :kind :completed} :of-job true}]}]}
