;; Card a9790bb6: jobs.time.noop is an intentional pause: it holds the body still for :seconds, reflexes still cut it and it
;; waits only what is left, its time counts against the budget of the job that calls it.
;; Should-succeed: a 5 s pause completes with the waited seconds; a hungry reflex fires mid-pause and the pause still completes.
;; Should-fail: a 30 s pause under :spend {:wall-time 5} ends limit_reached :wall-time (a pause accrues no job-time).
{:defaults
 {:tags [:scheduler :time :noop]
  :plot {:height 6}
  :body {:at [16.5 0 16.5] :settle-s 2 :effects [["resistance" 600 4]]}
  :limit-s 60}
 :cases
 [{:name "short-pause-completes"
   :act [[:job (jobs.time.noop {:seconds 5})]]
   :expect [{:event {:source :job :kind :completed :data {:status :completed}} :within-s 30 :of-job true}]
   :after [[:body-near [16.5 0 16.5] 1.5]]}
  {:name "pause-over-its-budget-is-limit-reached"
   :act [[:job (jobs.time.noop {:seconds 30 :spend {:wall-time 5}})]]
   :expect [{:event {:source :job :kind :limit_reached :data {:cause {:line :wall-time}}} :within-s 25 :of-job true}
            {:no-event {:source :job :kind :completed} :for-s 20 :until {:source :job :kind :limit_reached} :of-job true}]}
  {:name "hungry-reflex-cuts-the-pause-which-then-completes"
   :register [{:trigger :hungry}]
   :body {:inventory [["bread" 6]] :effects []}
   :act [[:job (jobs.time.noop {:seconds 30})]
         [:rcon "effect give $BODY minecraft:hunger 5 243 true"] [:until-effect-gone "hunger" 30]
         [:rcon "damage $BODY 15 minecraft:generic"]]
   :expect [{:event {:source :reflex :kind :fired :context {:reflex-id :hungry}} :within-s 30}
            {:event {:source :job :kind :completed :data {:status :completed}} :within-s 60 :of-job true}]
   :limit-s 80}]}
