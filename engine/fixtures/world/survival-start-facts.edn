;; Root jobs whose start fact fails wait listed with a reason instead of acting (card cf947198): sleep {:open-bed false} beside an open bed
;; waits :bed-open, an enclosed bed sleeps; go-home :too-far is in dusk-home-far.edn, food.fish :no-rod in fish-cases.edn, hunt :too-few in hunt-sheep-colour.edn.
;; Night cases: run with --allow-time --time-log <the shared time log>.
{:defaults
 {:tags [:survival :conditions :jobs]
  :time :day :time-why :sleep
  :plot {:height 8}
  :body {:at [16.5 0 16.5] :effects [["resistance" 600 4]] :settle-s 2}
  :limit-s 60}
 :cases
 [{:name "sleep-open-bed-false-beside-an-open-bed-waits"
   :time :night
   :blocks [[:set [4 0 4] "torch"] [:set [4 0 28] "torch"] [:set [28 0 4] "torch"] [:set [28 0 28] "torch"]
            [:set [18 0 16] "red_bed[facing=east,part=foot]"] [:set [19 0 16] "red_bed[facing=east,part=head]"]]
   :act [[:job (jobs.survival.sleep {:bed #at [18 0 16] :open-bed false})]]
   :expect [{:event {:source :job :kind #{:waiting :stopped} :data {:reason :bed-open}} :within-s 40 :of-job true}
            {:no-event {:source :action :kind :done :data {:name "sleep" :status "sleeping"}} :for-s 20 :until {:source :job :data {:reason :bed-open}}}]}
  {:name "sleep-open-bed-false-in-a-closed-room-sleeps"
   :time :night-exclusive
   :sleep-skip true
   :blocks [[:set [4 0 4] "torch"] [:set [4 0 28] "torch"] [:set [28 0 4] "torch"] [:set [28 0 28] "torch"]
            [:fill [8 0 8] [16 3 16] "stone" :hollow] [:fill [9 0 9] [15 2 15] "air"] [:set [9 1 9] "torch"] [:set [15 1 15] "torch"]
            [:set [10 0 12] "red_bed[facing=east,part=foot]"] [:set [11 0 12] "red_bed[facing=east,part=head]"]]
   :body {:at [13.5 0 13.5]}
   :act [[:job (jobs.survival.sleep {:bed #at [10 0 12] :open-bed false})]]
   :expect [{:event {:source :action :kind :done :data {:name "sleep" :status "sleeping"}} :within-s 40}]}]}
