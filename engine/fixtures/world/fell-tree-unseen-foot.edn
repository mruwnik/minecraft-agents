;; Card cda71500: fell-tree's pillar plan looks at the unseen floor cells round the trunk foot before it marks the tree unreachable
;; (:no-base / :no-stand). A 12-log trunk at x 16, z 16 whose foot floor lies behind a 2-high stone wall (z 20) from the body at z 22.5:
;; the job looks, pillars and fells it, with no fell-tree.declined. (A floor that stays unseen declining :no-base once is not built here.)
{:defaults
 {:tags [:forestry :fell-tree :pillar :sensing] :time :any
  :plot {:height 24 :floor "stone"}
  :blocks [[:fill [16 0 16] [16 11 16] "oak_log"]
           [:fill [14 10 14] [18 12 18] "oak_leaves[persistent=true]"]
           [:fill [16 10 16] [16 11 16] "oak_log"]
           [:fill [12 0 20] [20 1 20] "stone"]]
  :body {:at [16.5 0 22.5] :yaw 180 :settle-s 2 :inventory [["iron_axe" 1] ["dirt" 20]] :effects [["resistance" 600 4]]}
  :limit-s 200}
 :cases
 [{:name "tall-tree-with-its-foot-floor-behind-a-wall-is-looked-at-and-felled"
   :act [[:job (jobs.forestry.fell-tree {:at #xyz [16 0 16]})]]
   :expect [{:event {:source :job :kind :completed} :within-s 180 :of-job true}
            {:no-event {:source :job :kind :fell-tree.declined} :for-s 180 :until {:source :job :kind :completed}}]
   :after [[:not-block [16 11 16] "oak_log"] [:not-block [16 0 16] "oak_log"]]}]}
