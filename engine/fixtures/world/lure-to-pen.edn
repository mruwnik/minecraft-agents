;; jobs.animals.lure-to: an animal follows the breeding food in hand to :pos / into :box. Cards 063f438c (the job), cba0c4ab (the gate
;; is not shut in front of the animal), a0ac6368 (:arrived only when the led animal is at the spot), 3ba1a9ef (an animal already in a closed
;; pen is skipped), 2c2b2654 (no seeds carried: get-seeds), 7889852a not covered (needs a seeded threat memory).
;; Pen: oak fence ring x 18..24, z 13..19, inside 19..23 x 14..18, shut gate on the west side at [18 0 16] (as herd-pen.edn).
;; Should-succeed: cow led through the shut gate into the pen; with a cow already penned the outside cow is led; chicken led with
;; seeds fetched from grass. Should-fail: a cow that never follows ends :stopped with a reason other than :arrived.
{:defaults
 {:tags [:lure-to :animals :jobs]
  :time :any
  :plot {:floor "grass_block"}
  :blocks [[:fill [18 0 13] [24 0 19] "oak_fence"]
           [:fill [19 0 14] [23 0 18] "air"]
           [:set [18 0 16] "oak_fence_gate[facing=east,open=false]"]]
  :body {:at [12.5 0 16.5] :yaw 270 :inventory [["wheat" 4]] :effects [["resistance" 900 4]]}
  :limit-s 200}
 :cases
 [{:name "cow-led-through-gate-into-pen"
   :act [[:summon "cow" [10.5 0 18.5]]
         [:job (jobs.animals.lure-to {:mob "cow" :pos #xyz [21 0 16] :box {:min #xyz [19 0 14] :max #xyz [23 0 18]}})]]
   :expect [{:event {:source :job :kind :completed :data {:reason :arrived :in-box true}} :within-s 150 :of-job true}]
   ;; card 8d02af07: the cleanup (run before the ending is seen) shuts the gate the legs opened
   :after [[:entities "type=cow,tag=wt" [[19 0 14] [23 1 18]] 1]
           [:block [18 0 16] "oak_fence_gate[open=false]"]
           [:item "wheat" [:>= 4]]]}
  ;; card 55f8b368: the bait is put away on arrival even with a full inventory (35 other items, so unequip finds no free slot: another item is
  ;; taken in hand), so the penned cow does not follow the body back out through the gate
  {:name "penned-cow-stays-when-the-body-walks-out"
   :body {:at [12.5 0 16.5] :yaw 270 :inventory [["wheat" 4] ["stick" 1] ["coal" 1] ["iron_ingot" 1] ["gold_ingot" 1] ["diamond" 1] ["emerald" 1] ["bone" 1] ["string" 1] ["feather" 1] ["flint" 1] ["leather" 1] ["paper" 1] ["clay_ball" 1] ["brick" 1] ["apple" 1] ["bread" 1] ["carrot" 1] ["potato" 1] ["beetroot" 1] ["sugar" 1] ["egg" 1] ["gunpowder" 1] ["redstone" 1] ["lapis_lazuli" 1] ["quartz" 1] ["slime_ball" 1] ["ink_sac" 1] ["glowstone_dust" 1] ["blaze_rod" 1] ["ender_pearl" 1] ["cooked_beef" 1] ["cooked_porkchop" 1] ["melon_slice" 1] ["spider_eye" 1] ["rotten_flesh" 1]] :effects [["resistance" 900 4]]}
   :act [[:summon "cow" [10.5 0 18.5]]
         [:job (jobs.animals.lure-to {:mob "cow" :pos #xyz [21 0 16] :box {:min #xyz [19 0 14] :max #xyz [23 0 18]}})]
         [:await {:source :job :kind :completed :data {:reason :arrived :in-box true}} 150]
         [:job (jobs.movement.go-to {:pos #at [10 0 16] :range 1})]
         [:until-pos {:x-max 14} 60]
         [:wait-s 6]] ; hold: time must pass here, nothing to poll
   :expect [{:event {:source :job :kind :completed :data {:reason :arrived :in-box true}} :within-s 150 :of-job true}]
   :after [[:entities "type=cow,tag=wt" [[19 0 14] [23 1 18]] 1]]}
  {:name "penned-cow-skipped-outside-cow-led"
   :body {:at [14.5 0 16.5] :yaw 315 :inventory [["wheat" 4]] :effects [["resistance" 900 4]]}
   :act [[:summon "cow" [20.5 0 16.5]]
         [:summon "cow" [16.5 0 24.5]]
         [:job (jobs.animals.lure-to {:mob "cow" :pos #xyz [22 0 16] :box {:min #xyz [19 0 14] :max #xyz [23 0 18]} :radius 12})]]
   :expect [{:event {:source :job :kind :completed :data {:reason :arrived :in-box true}} :within-s 150 :of-job true}]
   :after [[:entities "type=cow,tag=wt" [[19 0 14] [23 1 18]] 2]]}
  ;; should fail: a cow that does not move never follows; the run ends with a reason, never :arrived, and the cow stays out
  {:name "cow-that-never-follows-is-not-arrived"
   :act [[:summon "cow" [10.5 0 18.5] "{NoAI:1b}"]
         [:job (jobs.animals.lure-to {:mob "cow" :pos #xyz [21 0 16] :box {:min #xyz [19 0 14] :max #xyz [23 0 18]}})]]
   :expect [{:event {:source :job :kind :stopped :data {:reason #{:animal-stalled :animal-outside :lost :unreachable}}} :within-s 150 :of-job true}
            {:no-event {:source :job :kind :completed :data {:reason :arrived}} :for-s 150 :until {:source :job :kind :stopped}}]
   :after [[:entities "type=cow,tag=wt" [[19 0 14] [23 1 18]] 0]]}
  {:name "chicken-with-no-seeds-gets-seeds-from-grass"
   :blocks [[:fill [4 0 4] [11 0 13] "short_grass"]]
   :body {:at [12.5 0 16.5] :yaw 270 :inventory [] :effects [["resistance" 900 4]]}
   :act [[:summon "chicken" [10.5 0 18.5]]
         [:job (jobs.animals.lure-to {:mob "chicken" :pos #xyz [21 0 16] :box {:min #xyz [19 0 14] :max #xyz [23 0 18]}})]]
   :expect [{:event {:source :job :kind :completed :data {:reason :arrived}} :within-s 190 :of-job true}]
   :after [[:entities "type=chicken,tag=wt" [[19 0 14] [23 1 18]] 1]]
   :limit-s 220}
  ;; cards 3057aeb9, 3356285f: two chickens lured with seeds past each other: the tracked one may change, the lead is not lost
  {:name "two-chickens-led-without-losing-the-lead"
   :blocks [[:fill [4 0 4] [11 0 13] "short_grass"]]
   :body {:at [12.5 0 16.5] :yaw 270 :inventory [["wheat_seeds" 8]] :effects [["resistance" 900 4]]}
   :act [[:summon "chicken" [10.5 0 18.5]] [:summon "chicken" [9.5 0 15.5]]
         [:job (jobs.animals.lure-to {:mob "chicken" :pos #xyz [21 0 16] :box {:min #xyz [19 0 14] :max #xyz [23 0 18]}})]]
   :expect [{:event {:source :job :kind :completed :data {:reason :arrived}} :within-s 190 :of-job true}
            {:no-event {:source :job :kind :stopped :data {:reason #{:lost :no-hold}}} :for-s 190 :until {:source :job :kind :completed}}]
   :after [[:item "wheat_seeds" [:>= 7]]]
   :limit-s 220}
  ;; card 8d02af07: an empty :uuid would match every animal, and a start that two animals share names none of them: it waits, leading nobody
  ;; card c6817a46: the named animal already in the box ends the lure at once, without fetching food
  {:name "named-animal-already-in-the-box-ends-at-once"
   :act [[:summon "cow" [21.5 0 16.5] "{NoAI:1b,UUID:[I;20381,9,1,3]}"]
         [:job (jobs.animals.lure-to {:mob "cow" :uuid "00004f9d" :pos #xyz [21 0 16] :box {:min #xyz [19 0 14] :max #xyz [23 0 18]}})]]
   :expect [{:event {:source :job :kind :completed :data {:kind :done :cause :already}} :within-s 30 :of-job true}]
   :after [[:item "wheat" 4] [:entities "type=cow,tag=wt" [[19 0 14] [23 1 18]] 1]]
   :limit-s 50}
  {:name "empty-uuid-never-starts"
   :act [[:summon "cow" [10.5 0 18.5] "{NoAI:1b}"]
         [:job (jobs.animals.lure-to {:mob "cow" :uuid "" :pos #xyz [21 0 16] :box {:min #xyz [19 0 14] :max #xyz [23 0 18]}})]]
   :expect [{:event {:source :job :kind :stopped :data {:kind :impossible :reason :empty-uuid}} :within-s 30 :of-job true}]
   :after [[:item "wheat" 4]]
   :limit-s 50}
  {:name "uuid-start-two-cows-share-waits-and-leads-none"
   :act [[:summon "cow" [10.5 0 18.5] "{NoAI:1b,UUID:[I;20381,9,1,1]}"]
         [:summon "cow" [12.5 0 18.5] "{NoAI:1b,UUID:[I;20381,9,1,2]}"]
         [:job (jobs.animals.lure-to {:mob "cow" :uuid "00004f9d-0000-0009" :pos #xyz [21 0 16] :box {:min #xyz [19 0 14] :max #xyz [23 0 18]}})]]
   :expect [{:no-event {:source :job :kind #{:completed :stopped}} :for-s 30 :of-job true}]
   :after [[:item "wheat" 4] [:entities "type=cow,tag=wt" [[19 0 14] [23 1 18]] 0]]
   :limit-s 50}]}
