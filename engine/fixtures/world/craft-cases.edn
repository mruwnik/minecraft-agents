;; jobs.items.craft / obtain crafting cases: cards ea1311d1 (white_bed from wool + planks at a table not handed, not the re-dye
;; recipe), e45ef991 (bread with a table made from planks), 48c93752 (a table placed in a 1-wide tunnel with no pickaxe),
;; f16fb3bc (a seen table out of reach is walked to before the craft acts).
;; Open plot, body at [16.5 0 16.5] looking east (yaw 270).
;; Should-succeed: bed crafted at a table 8 off, bread, a stone pickaxe in the tunnel, a wooden pickaxe at a table 12 off with table-radius 20.
;; Should-fail: one plank and no table leaves the bed uncrafted.
{:defaults
 {:tags [:items :craft :jobs]
  :time :any
  :plot {:height 8}
  :body {:at [16.5 0 16.5] :yaw 270 :settle-s 2 :effects [["resistance" 600 4]]}
  :limit-s 90}
 :cases
 [{:name "white-bed-from-wool-and-planks-at-a-table-8-off"
   :blocks [[:set [24 0 16] "crafting_table"]]
   :body {:inventory [["white_wool" 3] ["oak_planks" 3]]}
   :act [[:job (jobs.items.craft {:item "white_bed"})]]
   :expect [{:event {:source :job :kind :completed} :within-s 80 :of-job true}]
   :after [[:item "white_bed" 1]]}
  ;; card 689bca47: the craft act times out (bound shrunk by :prim/craft-max-s) although the item arrived: the job reads the inventory and is done
  {:name "craft-act-timing-out-after-the-item-arrived-is-done"
   :settings {:prim/craft-max-s 0.25}
   :body {:inventory [["oak_planks" 2]]}
   :act [[:job (jobs.items.craft {:item "stick"})]]
   :expect [{:event {:source :job :kind :completed} :within-s 60 :of-job true}]
   :after [[:item "stick" 4]]}
  ;; card 0ef3fbfc: an item already carried ends done with text that says so, not "crafted 0"
  {:name "craft-of-an-item-already-carried-says-already-carried"
   :body {:inventory [["stone_pickaxe" 1]]}
   :act [[:job (jobs.items.craft {:item "stone_pickaxe"})]]
   :expect [{:event {:source :job :kind :completed :data {:text [:contains "already carried 1 stone_pickaxe"]}} :within-s 40 :of-job true}]
   :after [[:item "stone_pickaxe" 1]]
   :limit-s 60}
  ;; card ea827c9b: a tag recipe takes any mix of woods (vanilla), not 8 of one species
  {:name "chest-from-seven-cherry-and-one-oak-planks-at-a-table"
   :blocks [[:set [24 0 16] "crafting_table"]]
   :body {:inventory [["cherry_planks" 7] ["oak_planks" 1]]}
   :act [[:job (jobs.items.craft {:item "chest" :ways #{:carried}})]]
   :expect [{:event {:source :job :kind :completed} :within-s 80 :of-job true}]
   :after [[:item "chest" 1]]}
  ;; card c1f63e7f: planks take a stripped log of their own species; a log of another species does not stand in
  {:name "cherry-planks-from-a-stripped-cherry-log"
   :body {:inventory [["stripped_cherry_log" 1]]}
   :act [[:job (jobs.items.craft {:item "cherry_planks" :count 4})]]
   :expect [{:event {:source :job :kind :completed} :within-s 60 :of-job true}]
   :after [[:item "cherry_planks" 4] [:item "stripped_cherry_log" 0]]}
  {:name "cherry-planks-from-an-oak-log-are-not-crafted"
   :body {:inventory [["oak_log" 1]]}
   :act [[:job (jobs.items.craft {:item "cherry_planks" :count 4 :ways #{:carried}})]]
   :expect [{:event {:source :job :kind :stopped} :within-s 60 :of-job true}]
   :after [[:item "cherry_planks" 0] [:item "oak_planks" 0] [:item "oak_log" 1]]}
  {:name "white-bed-short-of-planks-and-no-table-is-not-crafted"
   :body {:inventory [["white_wool" 3] ["oak_planks" 1]]}
   :act [[:job (jobs.items.craft {:item "white_bed" :ways #{:carried}})]]
   :expect [{:event {:source :job :kind :stopped} :within-s 40 :of-job true}
            {:no-event {:source :job :kind :completed} :for-s 15 :of-job true :until {:source :job :kind :stopped}}]
   :after [[:item "white_bed" 0]]
   :limit-s 60}
  {:name "bread-with-a-table-made-from-planks"
   :body {:inventory [["wheat" 3] ["oak_planks" 8]]}
   :act [[:job (jobs.items.obtain {:item "bread" :count 1})]]
   :expect [{:event {:source :job :kind :completed} :within-s 80 :of-job true}]
   :after [[:item "bread" 1]]}
  ;; card bc9b6511: the count is carried at the start plus crafted, so the second bread is crafted once (the eat between steps is the unit test's)
  {:name "two-breads-from-six-wheat-at-a-table"
   :blocks [[:set [18 0 16] "crafting_table"]]
   :body {:inventory [["wheat" 6]]}
   :act [[:job (jobs.items.craft {:item "bread" :count 2})]]
   :expect [{:event {:source :job :kind :completed :data {:text [:contains "crafted 2 bread"]}} :within-s 60 :of-job true}]
   :after [[:item "bread" 2]]
   :limit-s 80}
  {:name "stone-pickaxe-in-a-one-wide-tunnel-places-the-table"
   :blocks [[:fill [8 -1 8] [24 5 24] "stone"] [:fill [16 0 16] [22 1 16] "air"]]
   :body {:at [18.5 0 16.5] :inventory [["birch_log" 6] ["cobblestone" 20]]}
   :act [[:job (jobs.items.craft {:item "stone_pickaxe"})]]
   :expect [{:event {:source :job :kind :completed} :within-s 80 :of-job true}
            {:no-event {:source :job :kind :stopped :data {:reason :no-table-spot}} :for-s 70 :of-job true :until {:source :job :kind :completed}}]
   :after [[:item "stone_pickaxe" 1]]}
  {:name "seen-table-12-off-is-walked-to-before-crafting"
   :blocks [[:set [28 0 16] "crafting_table"]]
   :body {:inventory [["oak_planks" 3] ["stick" 2]]}
   :act [[:job (jobs.items.craft {:item "wooden_pickaxe" :settings {:jobs.items.craft/table-radius 20}})]]
   :expect [{:event {:source :job :kind :completed} :within-s 80 :of-job true}]
   :after [[:item "wooden_pickaxe" 1]]}
  ;; card 3177e78a (b): a carried table is placed in a 1-wide shaft, not "out-of-reach (too-far)" after 3 rounds
  {:name "stone-sword-in-a-one-wide-pit-places-the-carried-table"
   :blocks [[:fill [8 -1 8] [24 5 24] "stone"] [:fill [16 0 16] [16 5 16] "air"]]
   :body {:at [16.5 0 16.5] :inventory [["cobblestone" 3] ["stick" 2] ["crafting_table" 1]]}
   :act [[:job (jobs.items.craft {:item "stone_sword"})]]
   :expect [{:event {:source :job :kind :completed} :within-s 80 :of-job true}]
   :after [[:item "stone_sword" 1]]}
  ;; card 1d7cd1e0: a seen table within the table-radius setting (default 64) is walked to; beyond it the stop names the nearest known one
  ;; (the body sees 48 blocks: the table stands 44 off)
  {:name "seen-table-44-off-is-walked-to-and-the-pickaxe-crafted"
   :plot {:length 80 :width 16 :height 8}
   :blocks [[:set [22 0 8] "crafting_table"]]
   :body {:at [66.5 0 8.5] :yaw 90 :inventory [["cobblestone" 3] ["stick" 2]]}
   :act [[:job (jobs.items.craft {:item "stone_pickaxe" :ways #{:carried}})]]
   :expect [{:event {:source :job :kind :completed} :within-s 85 :of-job true}
            {:no-event {:source :job :kind :stopped} :for-s 80 :of-job true :until {:source :job :kind :completed}}]
   :after [[:item "stone_pickaxe" 1]]
   :limit-s 100}
  {:name "seen-table-beyond-far-says-no-table-naming-the-nearest-known"
   :plot {:length 80 :width 16 :height 8}
   :blocks [[:set [22 0 8] "crafting_table"]]
   :body {:at [66.5 0 8.5] :yaw 90 :settle-s 8 :inventory [["cobblestone" 3] ["stick" 2]]}
   :act [[:job (jobs.items.craft {:item "stone_pickaxe" :ways #{:carried} :settings {:jobs.items.craft/table-radius 40}})]]
   :expect [{:event {:source :job :kind :stopped :data {:kind :condition-failed :reason :no-table :text [:contains "the nearest known is at"]}} :within-s 40 :of-job true}]
   :after [[:item "stone_pickaxe" 0]]
   :limit-s 60}
  ;; card 6a6c0263: a count over one batch crafts on, planks made from the logs for each batch; a gate short of sticks and planks refetches both
  {:name "twelve-fences-from-logs-in-several-batches"
   :blocks [[:set [20 0 16] "crafting_table"]]
   :body {:inventory [["oak_log" 8]]}
   :act [[:job (jobs.items.craft {:item "oak_fence" :count 12})]]
   :expect [{:event {:source :job :kind :completed} :within-s 100 :of-job true}]
   :after [[:item "oak_fence" [:>= 12]]]
   :limit-s 120}
  {:name "fence-gate-from-logs-and-two-planks-no-sticks"
   :blocks [[:set [20 0 16] "crafting_table"]]
   :body {:inventory [["oak_log" 4] ["oak_planks" 2]]}
   :act [[:job (jobs.items.craft {:item "oak_fence_gate"})]]
   :expect [{:event {:source :job :kind :completed} :within-s 80 :of-job true}]
   :after [[:item "oak_fence_gate" 1]]}
  ;; card 804c451d: a full bag of junk is made room in (make-room tosses), then the craft goes on; a bag of tools cannot be freed: stopped :full
  {:name "full-bag-of-junk-is-made-room-in-then-the-pickaxe-crafted"
   :blocks [[:set [20 0 16] "crafting_table"]]
   :body {:inventory [["diamond" 4] ["stick" 64] ["gravel" 256] ["gravel" 1] ["sand" 1] ["tuff" 1] ["andesite" 1] ["diorite" 1] ["granite" 1] ["netherrack" 1] ["deepslate" 1] ["calcite" 1] ["coarse_dirt" 1] ["red_sand" 1] ["clay_ball" 1] ["flint" 1] ["feather" 1] ["bone" 1] ["string" 1] ["gunpowder" 1] ["rotten_flesh" 1] ["spider_eye" 1] ["leather" 1] ["paper" 1] ["sugar" 1] ["slime_ball" 1] ["ink_sac" 1] ["egg" 1] ["snowball" 1] ["glowstone_dust" 1] ["redstone" 1] ["lapis_lazuli" 1] ["dirt" 1]]}
   :act [[:job (jobs.items.craft {:item "diamond_pickaxe"})]]
   :expect [{:event {:source :job :kind :child_ended :data {:slot :room :ending {:kind :done}}} :within-s 60 :of-job true}
            {:event {:source :job :kind :completed} :within-s 90 :of-job true}]
   :after [[:item "diamond_pickaxe" 1]]
   :limit-s 110}
  ;; card 5dd014bb: the only pickaxe is nearly spent and no cobblestone is carried: the spare fetch may dig with it (it makes the spare)
  {:name "spent-iron-pickaxe-digs-the-cobblestone-for-the-stone-pickaxe"
   :blocks [[:fill [8 -1 8] [24 5 24] "stone"] [:fill [16 0 16] [22 1 16] "air"] [:set [19 0 16] "crafting_table"]]
   :body {:at [18.5 0 16.5] :inventory [["iron_pickaxe" 1] ["oak_planks" 11] ["torch" 6]]}
   :act [[:rcon "item replace entity $BODY container.0 with minecraft:iron_pickaxe[minecraft:damage=248]"]
         [:job (jobs.gather.mine {:torches false :block "stone" :count 2 :ways #{:seen} :radius 8})]]
   :expect [{:event {:source :job :kind :completed} :within-s 100 :of-job true}]
   :after [[:item "stone_pickaxe" 1]]
   :limit-s 120}
  ;; card 5dd014bb: a full bag in a dead-end stub, a table beside the body: the stub has one free cell ahead, so the tossed junk lands in reach and is picked up again; the craft must still have room
  {:name "full-bag-in-a-dead-end-stub-is-made-room-in-and-the-pickaxe-crafted"
   :blocks [[:fill [8 -1 8] [24 5 24] "stone"] [:fill [18 0 15] [18 1 16] "air"] [:set [19 0 16] "crafting_table"]]
   :body {:at [18.5 0 16.5] :yaw 180 :inventory [["oak_planks" 11] ["cobblestone" 8] ["stick" 2] ["torch" 6] ["andesite" 320] ["granite" 440] ["gravel" 200] ["diorite" 960]]}
   :act [[:job (jobs.items.craft {:item "stone_pickaxe"})]]
   :expect [{:event {:source :job :kind :completed} :within-s 100 :of-job true}]
   :after [[:item "stone_pickaxe" 1]]
   :limit-s 120}
  ;; card 5dd014bb: end to end, a kit asked for a stone pickaxe with only a nearly spent iron one, a table beside, a bag of junk and no cobblestone
  {:name "get-kit-stone-pickaxe-with-a-spent-iron-pickaxe-and-a-full-bag"
   :blocks [[:fill [8 -1 8] [24 5 24] "stone"] [:fill [16 0 16] [22 1 16] "air"] [:set [19 0 17] "crafting_table"]]
   :body {:at [18.5 0 16.5] :inventory [["iron_pickaxe" 1] ["oak_planks" 11] ["torch" 6] ["andesite" 320] ["granite" 440] ["gravel" 200] ["diorite" 960]]}
   :act [[:rcon "item replace entity $BODY container.0 with minecraft:iron_pickaxe[minecraft:damage=248]"]
         [:job (jobs.items.get-kit {:items ["stone_pickaxe"] :wear false :food false})]]
   :expect [{:event {:source :job :kind :completed} :within-s 150 :of-job true}]
   :after [[:item "stone_pickaxe" 1]]
   :limit-s 170}
  {:name "full-bag-of-tools-stops-full"
   :blocks [[:set [20 0 16] "crafting_table"]]
   :body {:inventory [["diamond" 4] ["stick" 64] ["iron_boots" 1] ["iron_leggings" 1] ["wooden_pickaxe" 1] ["wooden_axe" 1] ["wooden_shovel" 1] ["wooden_hoe" 1] ["wooden_sword" 1] ["stone_pickaxe" 1] ["stone_axe" 1] ["stone_shovel" 1] ["stone_hoe" 1] ["stone_sword" 1] ["iron_pickaxe" 1] ["iron_axe" 1] ["iron_shovel" 1] ["iron_hoe" 1] ["iron_sword" 1] ["golden_pickaxe" 1] ["golden_axe" 1] ["golden_shovel" 1] ["golden_hoe" 1] ["golden_sword" 1] ["diamond_pickaxe" 1] ["diamond_axe" 1] ["diamond_shovel" 1] ["diamond_hoe" 1] ["shears" 1] ["bow" 1] ["crossbow" 1] ["fishing_rod" 1] ["flint_and_steel" 1] ["shield" 1] ["iron_helmet" 1] ["iron_chestplate" 1]]}
   :act [[:job (jobs.items.craft {:item "diamond_sword"})]]
   :expect [{:event {:source :job :kind :stopped :data {:kind :condition-failed :reason :full}} :within-s 60 :of-job true}
            {:no-event {:source :job :kind :completed} :for-s 20 :of-job true :until {:source :job :kind :stopped}}]
   :after [[:item "diamond_sword" 0]]
   :limit-s 80}
  ;; card fd3d48a9: in a 1-wide tunnel the table and the furnace stand in a side niche, never in the line ahead or behind the body
  {:name "table-in-a-tunnel-never-lands-in-the-line"
   :blocks [[:fill [8 -1 8] [24 5 24] "stone"] [:fill [16 0 16] [22 1 16] "air"]]
   :body {:at [18.5 0 16.5] :inventory [["stick" 2] ["cobblestone" 8] ["crafting_table" 1]]}
   :act [[:job (jobs.items.craft {:item "stone_pickaxe"})]]
   :expect [{:event {:source :job :kind :completed} :within-s 80 :of-job true}
            {:event {:source :job :kind :child_ended :data {:ending {:data {:item "crafting_table"}}}} :within-s 80}
            {:no-event {:source :job :kind :child_ended :data {:ending {:data {:item "crafting_table" :pos #{[:near #xyz [16 0 16] 0.5] [:near #xyz [17 0 16] 0.5] [:near #xyz [19 0 16] 0.5] [:near #xyz [20 0 16] 0.5] [:near #xyz [21 0 16] 0.5] [:near #xyz [22 0 16] 0.5] [:near #xyz [16 1 16] 0.5] [:near #xyz [17 1 16] 0.5] [:near #xyz [19 1 16] 0.5] [:near #xyz [20 1 16] 0.5] [:near #xyz [21 1 16] 0.5] [:near #xyz [22 1 16] 0.5]}}}}} :for-s 80 :until {:source :job :kind :completed :context {:chain [[:any]]}}}]
   :after [[:item "stone_pickaxe" 1]]}
  {:name "furnace-in-a-tunnel-never-lands-in-the-line"
   :blocks [[:fill [8 -1 8] [24 5 24] "stone"] [:fill [16 0 16] [22 1 16] "air"]]
   :body {:at [18.5 0 16.5] :inventory [["furnace" 1] ["raw_iron" 1] ["coal" 1] ["stone_pickaxe" 1]]}
   :act [[:job (jobs.items.smelt {:item "raw_iron" :count 1})]]
   :expect [{:event {:source :job :kind :completed} :within-s 80 :of-job true}
            {:event {:source :job :kind :child_ended :data {:ending {:data {:item "furnace"}}}} :within-s 60}
            {:no-event {:source :job :kind :child_ended :data {:ending {:data {:item "furnace" :pos #{[:near #xyz [16 0 16] 0.5] [:near #xyz [17 0 16] 0.5] [:near #xyz [19 0 16] 0.5] [:near #xyz [20 0 16] 0.5] [:near #xyz [21 0 16] 0.5] [:near #xyz [22 0 16] 0.5] [:near #xyz [16 1 16] 0.5] [:near #xyz [17 1 16] 0.5] [:near #xyz [19 1 16] 0.5] [:near #xyz [20 1 16] 0.5] [:near #xyz [21 1 16] 0.5] [:near #xyz [22 1 16] 0.5]}}}}} :for-s 80 :until {:source :job :kind :completed :context {:chain [[:any]]}}}]
   :after [[:item "iron_ingot" 1]]}
  ;; card 27f9ef18: a table 8 behind the body is not in its first sight; craft's start check answers :look, the body looks round,
  ;; finds the table and uses it, so the planks that would make a second table stay in the bag.
  {:name "table-behind-the-body-is-looked-for-and-used-not-made-anew"
   :blocks [[:set [8 0 16] "crafting_table"]]
   :body {:inventory [["oak_planks" 8] ["stick" 2]]}
   :act [[:job (jobs.items.craft {:item "wooden_pickaxe" :settings {:jobs.items.craft/table-radius 10}})]]
   :expect [{:event {:source :job :kind :completed} :within-s 80 :of-job true}]
   :after [[:item "wooden_pickaxe" 1] [:item "oak_planks" 5] [:item "crafting_table" 0]]}]}
