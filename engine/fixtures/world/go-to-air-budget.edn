;; Cards c6fa5c5e, bd595db8, a21bbe8c (go-to's air budget). Water is sprint-swum at about 0.26 s a cell with the head under it; vanilla air lasts 15 s under water, comes back 4 s a second with the head out. The planner may plan 12 s of it.
;; surface-*: glass-roofed 40 cell dives (10 s each, x 5..24 and after the middle), start in the west shaft, goal the east shaft (head in air).
;;   Should-succeed: a 14 cell surface stretch between them (7 s with the head out = a full breath back). Should-fail: the dives joined by one cell with air over it (about 2 s of air back, 10 s + 8 s > 12 s), :why :air.
;; replan-*: a 6 deep water shaft S (x 4), a 2 high sealed tunnel from S's bottom to the shaft F (x 5+T), land over all (feet y 6), a bedrock ridge at x 11 (y 6..9) across the plot, with a gap at z 59..63 (the walk round, 100+ blocks) or none.
;;   The body starts at S's bottom and waits under water (/data cannot set a player's air) before go-to to the land beside F; no reflex is registered.
;;   Should-succeed: full air takes the sealed tunnel (T 24); with air half spent it surfaces (and walks round or dives again) (no :hurt). Should-fail: air half spent, T 64 sealed, only a lethal drowning way: :why :air (the goal's head is on land the body has not seen, so it is no way to air).
;; drowning-*: a 2 high water tunnel with a stone roof and an air pocket (air at y 2 over the water, lit by a sea lantern over it: the sealed tunnel is dark and sight sees dark cells only within 4 blocks); the body waits ~10 s under water (air ~4 of 20 bubbles, vanilla 15 s) then go-to the pocket.
;;   Should-succeed: pocket 6 cells away in line of sight (3 s): arrives, the drowning is priced not refused (go-to looks at the pocket; a cell of it seen edge-on is enough).
;;   Should-fail: the same seen pocket, the body at 2 hp (hunger stops regeneration) after ~14 s under water: any drowning kills, :why :air-lethal. A pocket round a bend (30 cells, never in sight): no way to air, :why :air. Resistance keeps the body alive after.
;; Live risks: the wait gives an oxygen of about 4..10, not exact.
{:defaults
 {:tags [:movement :water :air] :time :any
  :plot {:height 8 :length 110 :width 16}
  :body {:at [4.5 1 8.5] :yaw 270 :settle-s 1}
  :limit-s 150}
 :cases
 [  ;; dive 10 s, 14 cells with the head out (the air comes back), dive 10 s
  {:name "surface-stretch-arrives"
   :blocks [[:fill [3 0 7] [101 4 9] "stone"]
            [:fill [4 0 8] [99 1 8] "water"]
            [:fill [4 2 8] [4 3 8] "air"] [:fill [99 2 8] [99 3 8] "air"]
            [:fill [45 2 8] [58 2 8] "air"]
            [:fill [5 2 8] [44 2 8] "glass"] [:fill [59 2 8] [98 2 8] "glass"]]
   :act [[:job (jobs.movement.go-to {:pos #at [99 1 8] :range 1 :ways #{:walk :clear-seal}})]]
   :expect [{:event {:source :job :kind :completed :data {:arrived true}} :within-s 150 :of-job true}
            {:no-event {:source :body :kind :hurt} :for-s 150 :until {:source :job :kind #{:completed :stopped}}}]
   :after [[:body-near [99.5 1 8.5] 3]]}
  ;; night, open sky: the dark wait must not be taken under water; the body swims up first and walks (no drowning)
  {:name "submerged-at-night-surfaces-and-walks"
   :time :night
   :plot {:height 10 :length 40 :width 16}
   :blocks [[:fill [3 0 7] [30 3 9] "stone"]
            [:fill [4 0 8] [4 3 8] "water"]]
   :body {:at [4.5 0 8.5]}
   :act [[:job (jobs.movement.go-to {:pos #at [12 4 8] :range 1})]]
   :expect [{:event {:source :job :kind :completed :data {:arrived true}} :within-s 90 :of-job true}
            {:no-event {:source :body :kind :hurt} :for-s 90 :until {:source :job :kind #{:completed :stopped}}}]
   :after [[:body-near [12.5 4 8.5] 3]]}
  ;; should fail: two 10 s dives joined by one cell with air over it: the touch gives back about 2 s
  {:name "shaft-joined-dives-refused"
   :blocks [[:fill [3 0 7] [88 4 9] "stone"]
            [:fill [4 0 8] [86 1 8] "water"]
            [:fill [4 2 8] [4 3 8] "air"] [:fill [86 2 8] [86 3 8] "air"]
            [:fill [45 2 8] [45 2 8] "air"]
            [:fill [5 2 8] [44 2 8] "glass"] [:fill [46 2 8] [85 2 8] "glass"]]
   :act [[:job (jobs.movement.go-to {:pos #at [86 1 8] :range 1 :ways #{:walk :clear-seal}})]]
   :expect [{:event {:source :job :kind :stopped :data {:arrived false :reason :unreachable :why :air}} :within-s 60 :of-job true}]
   :after [[:body-near [4.5 1 8.5] 3]]}
  ;; full air, no walk round (ridge has no gap): the 12 cell tunnel is the way and fits in the air
  {:name "replan-full-air-takes-the-tunnel"
   :plot {:height 12 :length 44 :width 64}
   :blocks [[:fill [0 0 0] [43 5 63] "stone"]
            [:fill [4 0 8] [4 5 8] "water"] [:fill [5 0 8] [28 1 8] "water"] [:fill [29 0 8] [29 5 8] "water"]
            [:fill [11 6 0] [11 9 63] "bedrock"]]
   :body {:at [4.5 0 8.5]}
   :act [[:job (jobs.movement.go-to {:pos #at [30 6 8] :range 1 :ways #{:walk :clear-seal}})]]
   :expect [{:event {:source :job :kind :completed :data {:arrived true}} :within-s 120 :of-job true}
            {:no-event {:source :body :kind :hurt} :for-s 120 :until {:source :job :kind #{:completed :stopped}}}]
   :after [[:body-near [30.5 6 8.5] 3]]}
  ;; air about half spent: the tunnel does not fit, so swim up the shaft (about 1.5 s) and walk round the ridge; no drowning
  {:name "replan-low-air-surfaces-and-walks-round"
   :plot {:height 12 :length 44 :width 64}
   :blocks [[:fill [0 0 0] [43 5 63] "stone"]
            [:fill [4 0 8] [4 5 8] "water"] [:fill [5 0 8] [28 1 8] "water"] [:fill [29 0 8] [29 5 8] "water"]
            [:fill [11 6 0] [11 9 58] "bedrock"]]
   :body {:at [4.5 0 8.5]}
   :act [[:until-rcon "data get entity $BODY Air" "data: (-?[0-9]{1,2}|1[0-5][0-9]|16[0-5])s" 25] [:job (jobs.movement.go-to {:pos #at [30 6 8] :range 1 :ways #{:walk :clear-seal}})]]
   :expect [{:event {:source :job :kind :completed :data {:arrived true}} :within-s 150 :of-job true}
            {:no-event {:source :body :kind :hurt} :for-s 150 :until {:source :job :kind #{:completed :stopped}}}]
   :after [[:body-near [30.5 6 8.5] 3]]}
  ;; should fail: air half spent, only a 64 cell tunnel (16.6 s) with no way round: refused for air (the land goal is no way to air)
  {:name "replan-low-air-lethal-tunnel-refused"
   :plot {:height 12 :length 80 :width 64}
   :blocks [[:fill [0 0 0] [79 5 63] "stone"]
            [:fill [4 0 8] [4 5 8] "water"] [:fill [5 0 8] [68 1 8] "water"] [:fill [69 0 8] [69 5 8] "water"]
            [:fill [11 6 0] [11 9 63] "bedrock"]]
   :body {:at [4.5 0 8.5] :effects [["resistance" 600 4]]}
   :act [[:until-rcon "data get entity $BODY Air" "data: (-?[0-9]{1,2}|1[0-3][0-9]|14[0-5])s" 25] [:job (jobs.movement.go-to {:pos #at [70 6 8] :range 1 :ways #{:walk :clear-seal}})]]
   :expect [{:event {:source :job :kind :stopped :data {:arrived false :reason :unreachable :why :air}} :within-s 60 :of-job true}]
   :after [[:body-near [4.5 0 8.5] 8]]}
  ;; air half spent, the 64 cell tunnel (16.6 s) would drown lethally but the ridge gap gives a safe walk: it surfaces and walks, no drowning
  {:name "replan-lethal-shortcut-loses-to-the-walk"
   :plot {:height 12 :length 80 :width 64}
   :blocks [[:fill [0 0 0] [79 5 63] "stone"]
            [:fill [4 0 8] [4 5 8] "water"] [:fill [5 0 8] [68 1 8] "water"] [:fill [69 0 8] [69 5 8] "water"]
            [:fill [11 6 0] [11 9 58] "bedrock"]]
   :body {:at [4.5 0 8.5]}
   :act [[:until-rcon "data get entity $BODY Air" "data: (-?[0-9]{1,2}|1[0-3][0-9]|14[0-5])s" 25] [:job (jobs.movement.go-to {:pos #at [70 6 8] :range 1 :ways #{:walk :clear-seal}})]]
   :expect [{:event {:source :job :kind :completed :data {:arrived true}} :within-s 180 :of-job true}
            {:no-event {:source :body :kind :hurt} :for-s 180 :until {:source :job :kind #{:completed :stopped}}}]
   :after [[:body-near [70.5 6 8.5] 3]]}
  ;; oxygen about 4: the seen pocket 6 cells away is gone to (a few hp of drowning is fine)
  {:name "drowning-body-swims-to-seen-air"
   :plot {:height 8 :length 24 :width 16}
   :blocks [[:fill [3 0 7] [22 4 9] "stone"]
            [:fill [4 0 8] [20 1 8] "water"]
            [:fill [11 2 8] [13 2 8] "air"] [:set [12 3 8] "sea_lantern"]]
   :body {:at [5.5 0 8.5] :yaw 270}
   :act [[:until-rcon "data get entity $BODY Air" "data: (-?[0-9]{1,2}|100)s" 25] [:job (jobs.movement.go-to {:pos #at [12 1 8] :range 1 :ways #{:walk :clear-seal}})]]
   :expect [{:event {:source :job :kind :completed :data {:arrived true}} :within-s 60 :of-job true}]
   :after [[:body-near [12.5 1 8.5] 4]]}
  ;; should fail: the goal cell is under water with stone over it (its head cell is no air): not a way to air, so a body that has used its 12 s may not swim to it
  {:name "drowning-body-goal-under-stone-is-not-air"
   :plot {:height 8 :length 28 :width 16}
   :blocks [[:fill [3 0 7] [24 4 9] "stone"]
            [:fill [4 0 8] [20 1 8] "water"]]
   :body {:at [5.5 0 8.5] :yaw 270 :effects [["resistance" 600 4]]}
   :act [[:until-rcon "data get entity $BODY Air" "data: (-?[0-9]|-?[1-7][0-9]|80)s" 25] [:job (jobs.movement.go-to {:pos #at [12 1 8] :range 1 :ways #{:walk :clear-seal}})]]
   :expect [{:event {:source :job :kind :stopped :data {:arrived false :reason :unreachable :why :air}} :within-s 60 :of-job true}]
   :after [[:body-near [5.5 0 8.5] 3]]}
  ;; should fail: the seen pocket 6 cells away, at 2 hp with the air all but spent the first drowning hit kills: refused, never swum (:why :air-lethal; a pocket the water hides is :air, the case below)
  {:name "drowning-body-at-2-hp-seen-air-lethal-refused"
   :plot {:height 8 :length 24 :width 16}
   :blocks [[:fill [3 0 7] [22 4 9] "stone"]
            [:fill [4 0 8] [20 1 8] "water"]
            [:fill [11 2 8] [13 2 8] "air"] [:set [12 3 8] "sea_lantern"]]
   :body {:at [5.5 0 8.5] :yaw 270}
   :act [[:rcon "effect give $BODY minecraft:hunger 5 243 true"] [:until-rcon "data get entity $BODY Air" "data: (-?[0-9]{1,2}|1[0-5][0-9]|16[0-5])s" 25]
         [:rcon "damage $BODY 18 minecraft:magic"] [:until-rcon "data get entity $BODY Health" "data: [0-3]\\." 5]
         [:rcon "effect give $BODY minecraft:resistance 600 4 true"] [:until-rcon "data get entity $BODY Air" "data: (-?[0-9]|-?1[0-9]|-20)s" 25]
         [:job (jobs.movement.go-to {:pos #at [12 1 8] :range 1 :ways #{:walk :clear-seal}})]]
   :expect [{:event {:source :job :kind :stopped :data {:arrived false :reason :unreachable :why :air-lethal}} :within-s 60 :of-job true}]
   :after [[:body-near [5.5 0 8.5] 3]]}
  ;; should fail: the pocket is round a bend (25 cells east, 5 north), never in sight: no way to air, refused for air
  {:name "drowning-body-unseen-air-round-a-bend-refused"
   :plot {:height 8 :length 40 :width 16}
   :blocks [[:fill [3 0 6] [33 4 15] "stone"]
            [:fill [4 0 8] [30 1 8] "water"] [:fill [30 0 9] [30 1 14] "water"]
            [:fill [30 2 12] [30 2 14] "air"]]
   :body {:at [5.5 0 8.5] :yaw 270 :effects [["resistance" 600 4]]}
   :act [[:until-rcon "data get entity $BODY Air" "data: (-?[0-9]{1,2}|100)s" 25] [:job (jobs.movement.go-to {:pos #at [30 1 13] :range 1 :ways #{:walk :clear-seal}})]]
   :expect [{:event {:source :job :kind :stopped :data {:arrived false :reason :unreachable :why :air}} :within-s 60 :of-job true}]
   :after [[:body-near [5.5 0 8.5] 3]]}]}
