;; Card 0ce522a9: retreat's pillar step (refuge/pillar!, after the seal fails) places jobs.access.pillar blocks and hides on them.
;; A stone yard x 14..18, z 14..18, y 0..2 (open top, interior 3x3) with the body in the middle and four zombies on its four sides
;; (NoAI, helmeted): too many to fight, no way out, and the seal is refused because a hostile stands in a side cell, so the cornered
;; order goes to pillar. With no block to pillar with, nothing is placed and no refuge starts.
{:defaults
 {:tags [:hostile :survival :cornered]
  :time :any
  :plot {:height 16}
  :register [{:trigger :hostile-near :args {:radius 8 :ranged-radius 16}
              :job (jobs.survival.respond-to-hostile {:radius 8 :ranged-radius 16})}]
  :blocks [[:fill [14 0 14] [18 2 18] "stone" :hollow]]
  :body {:at [16.5 0 16.5] :effects [["resistance" 600 4]]}
  :act [[:summon "zombie" [15.5 0 16.5] "{NoAI:1b,equipment:{head:{id:\"minecraft:iron_helmet\",count:1}}}"]
        [:summon "zombie" [17.5 0 16.5] "{NoAI:1b,equipment:{head:{id:\"minecraft:iron_helmet\",count:1}}}"]
        [:summon "zombie" [16.5 0 15.5] "{NoAI:1b,equipment:{head:{id:\"minecraft:iron_helmet\",count:1}}}"]
        [:summon "zombie" [16.5 0 17.5] "{NoAI:1b,equipment:{head:{id:\"minecraft:iron_helmet\",count:1}}}"]]
  :limit-s 90}
 :cases
 [{:name "cornered-with-dirt-pillars-up-and-hides"
   :body {:inventory [["dirt" 12]]}
   :expect [{:event {:source :job :kind :pillar.done} :within-s 60}
            {:event {:source :job :kind :retreat_sealed :data {:text [:contains "pillared up"]}} :within-s 60}]
   :after [[:block [16 0 16] "dirt"] [:body-near [16.5 3 16.5] 2]]}
  {:name "cornered-without-blocks-places-no-pillar"
   :expect [{:event {:source :reflex :kind :fired :context {:reflex-id :hostile-near}} :within-s 15}
            {:no-event {:source :job :kind :retreat_sealed} :for-s 40}
            {:no-event {:source :job :kind :pillar.done} :for-s 40}]
   :after [[:not-block [16 0 16] "dirt"]]}]}
