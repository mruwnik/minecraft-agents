;; A calm enderman is no danger (jobs.lib.danger), and looking around near one never provokes it. Cards 57f49df1 (gaze rule),
;; b74a043c (calm enderman fires no retreat), ebac9484 (enderman near a night build), 85a9b3cb (no fight swings at one). The angry duck (water, roof, seal)
;; is in hostile-reflex-gates.edn (provoked by /damage ... by the body). NoAI enderman 5 east.
{:defaults
 {:tags [:hostile :survival :enderman]
  :time :any
  :mobs :keep
  :register [{:trigger :hostile-near}]
  :body {:at [16.5 0 16.5]}
  :limit-s 90}
 :cases
 [{:name "calm-enderman-fires-no-reflex"
   :act [[:summon "enderman" [21.5 0 16.5] "{NoAI:1b}"]
         [:until-seen {:entity "enderman"} 10]
         [:job (jobs.movement.look-around {:worth 1200})]]
   :expect [{:event {:source :job :kind :completed} :within-s 80 :of-job true}
            {:no-event {:source :reflex :kind :fired :context {:reflex-id :hostile-near}} :for-s 40}]
   :after [[:entities "type=enderman,tag=wt" [[0 0 0] [31 6 31]] 1]]}
  ;; Card 85a9b3cb: the hostile-near fight kills the zombie and never swings at the calm enderman, though it stands nearer.
  ;; Should-fail: the enderman's health under 40 (a swing provokes it).
  {:name "fight-leaves-a-calm-enderman-alone"
   :body {:inventory [["iron_sword" 1]] :effects [["resistance" 900 4]]}
   :act [[:summon "enderman" [19.5 0 19.5] "{NoAI:1b}"]
         [:summon "zombie" [21.5 0 16.5] "{equipment:{head:{id:\"minecraft:iron_helmet\",count:1}}}"]]
   :expect [{:event {:source :reflex :kind :fired :context {:reflex-id :hostile-near}} :within-s 20}
            {:event {:source :reflex :kind :ended :context {:reflex-id :hostile-near}} :within-s 60}]
   :after [[:entities "type=zombie,tag=wt" [[0 0 0] [31 6 31]] 0]
           [:entities "type=enderman,tag=wt,nbt={Health:40.0f}" [[0 0 0] [31 6 31]] 1]]}
  ;; Card e340bc3e: a calm enderman 2 blocks off, and the zombie's blows, do not make it angry: the armed body fights the zombie
  ;; and does not wall itself in. Should-fail: a :retreat_sealed or a place (the enderman's cornered order), or the enderman hit.
  {:name "calm-enderman-beside-the-body-zombie-is-fought-not-sealed-against"
   :body {:inventory [["iron_sword" 1] ["dirt" 20]] :effects [["resistance" 900 4]]}
   :act [[:summon "enderman" [18.5 0 16.5] "{NoAI:1b}"]
         [:until-seen {:entity "enderman"} 10]
         [:summon "zombie" [16.5 0 21.5] "{equipment:{head:{id:\"minecraft:iron_helmet\",count:1}}}"]]
   :expect [{:event {:source :reflex :kind :fired :context {:reflex-id :hostile-near}} :within-s 20}
            {:event {:source :reflex :kind :ended :context {:reflex-id :hostile-near}} :within-s 60}
            {:no-event {:source :job :kind :retreat_sealed} :for-s 40}
            {:no-event {:source :action :kind :started :data {:name "place"}} :for-s 40}]
   :after [[:entities "type=zombie,tag=wt" [[0 0 0] [31 6 31]] 0]
           [:entities "type=enderman,tag=wt,nbt={Health:40.0f}" [[0 0 0] [31 6 31]] 1]]}
  ;; Card 3508ad2b: a calm enderman 9 blocks off, within the way radius of the walk to the zombie, is no mob the fight meets:
  ;; the armed body fights the zombie. Should-fail: a :flee decision (the old fight price counted the enderman).
  {:name "calm-enderman-by-the-way-zombie-is-fought-not-fled"
   :body {:inventory [["iron_sword" 1]] :effects [["resistance" 900 4]]}
   :act [[:rcon "item replace entity $BODY armor.chest with minecraft:iron_chestplate"]
         [:summon "enderman" [25.5 0 19.5] "{NoAI:1b}"]
         [:until-seen {:entity "enderman"} 10]
         [:summon "zombie" [16.5 0 21.5] "{equipment:{head:{id:\"minecraft:iron_helmet\",count:1}}}"]]
   :expect [{:event {:source :reflex :kind :fired :context {:reflex-id :hostile-near}} :within-s 20}
            {:event {:source :reflex :kind :ended :context {:reflex-id :hostile-near}} :within-s 60}
            {:no-event {:source :job :kind :hostile.decided :data {:decision :flee}} :for-s 60 :until {:source :reflex :kind :ended :context {:reflex-id :hostile-near}}}]
   :after [[:entities "type=zombie,tag=wt" [[0 0 0] [31 6 31]] 0]
           [:entities "type=enderman,tag=wt,nbt={Health:40.0f}" [[0 0 0] [31 6 31]] 1]]}]}
