;; The jobs tool marks every submitted job survive-death: a player keeps their to-do list through a death; --drop-on-death
;; lets the dead body take it (job.cancelled). The jobs are submitted through jobs.mjs (the agent tool).
;; Should-succeed: after the respawn the repeat job is still listed; a plain go-to resumes from the respawn and arrives.
;; Should-fail: the go-to submitted --drop-on-death is cancelled by the death.
{:defaults
 {:tags [:scheduler :survival :death :tool] :time :any
  :plot {:height 8}
  :body {:at [10.5 0 10.5] :spawnpoint [4 0 4]}
  :limit-s 90}
 :cases
 [{:name "repeat-job-survives-a-death"
   :act [[:http :submit (repeat (jobs.time.noop {:seconds 0.5 :why :idle})) [] {:ok true}]
         [:kill-body] [:await {:source :body :kind :respawned} 30]
         [:cli "jobs" ["$body" "--world" "$world" "list"] {:total 1}]]
   :expect [{:event {:source :body :kind :respawned} :within-s 40}
            {:no-event {:source :job :kind :cancelled} :for-s 10 :of-job true}]}
  {:name "dropped-job-is-cancelled-by-a-death"
   :act [[:http :submit (jobs.movement.go-to {:pos #at [28 0 28] :range 1}) [:drop-on-death] {:ok true}]
         [:kill-body]]
   :expect [{:event {:source :job :kind :cancelled} :within-s 40 :of-job true}]}
  ;; a plain job stays listed through the death (the died event names it), is run again after the respawn, and arrives
  {:name "go-to-survives-the-death-and-arrives"
   :act [[:http :submit (jobs.movement.go-to {:pos #at [28 0 28] :range 1}) [] {:ok true}]
         [:wait-s 2] [:kill-body]]
   :expect [{:event {:source :body :kind :died :data {:survived [:any]}} :within-s 30}
            {:event {:source :body :kind :respawned} :within-s 40}
            {:event {:source :job :kind :completed :data {:arrived true}} :within-s 100 :of-job true}
            {:no-event {:source :job :kind :cancelled} :for-s 20 :of-job true}]
   :after [[:body-near [28.5 0 28.5] 3]]
   :limit-s 120}]}
