;; An exclusive go-to (no reflexes, so no breathe) from the bottom of a pond with a hostile beside it, to a goal past the
;; pond's 2-high wall ring. go-to has no hostile gate (the walk's price decides; a plain go-to is worth arrival), so it may
;; swim on; however the call ends (walled goal, a child held on the hostile) it must not leave the head under water.
;; Should-succeed: the call stops with the stop's own position at the surface (a body idle in water sinks, so an :after check races it).
;; Should-fail (old code): the call ended with the body still on the bottom (y 1).
{:defaults
 {:tags [:movement :hostile :water]
  :time :any
  :plot {:light :lit :height 10}
  :blocks [[:fill [0 0 0] [31 3 31] "stone"]
           [:fill [10 4 10] [21 5 21] "stone"]
           [:fill [11 4 11] [20 5 20] "air"]
           [:fill [11 0 11] [20 3 20] "water"]]
  :body {:at [15.5 1 15.5] :settle-s 1}
  :limit-s 60}
 :cases
 [{:name "exclusive-go-to-ends-with-the-head-out-of-the-water"
   :act [[:summon "drowned" [16.5 1 15.5] "{NoAI:1b}"]
         [:http :submit (jobs.movement.go-to {:worth 1200 :pos #at [3.5 4 15.5]}) [:exclusive] {:ok true}]]
   :expect [{:event {:source :job :kind :stopped :data {:pos {:y [:>= #y 3]}}} :within-s 40}]}]}
