;; survival.get-food's :pen way: the surplus of the body's own pens (a zone it owns or a plan it made) is food, keeping 2 adults.
;; Another's pen stays spared. Hunger is drained by RCON (food 9-10), hp 15; no food carried, only a sword.
;; Should-succeed: 3 cows on the footprint of the body's own plan: one is killed, 2 stay.
;; Should-fail: the same cows on another body's plan: none is killed (food.none), all 3 stay.
{:defaults
 {:tags [:survival :get-food :animals]
  :time :day
  :plot {:height 6}
  :body {:at [4.5 0 16.5] :inventory [["iron_sword" 1]] :settle-s 2}
  :act [[:rcon "effect give $BODY minecraft:hunger 5 243 true"] [:wait-s 7]
        [:rcon "damage $BODY 5 minecraft:generic"]
        [:summon "cow" [24.5 0 24.5] "{NoAI:1b}"] [:summon "cow" [25.5 0 24.5] "{NoAI:1b}"] [:summon "cow" [24.5 0 25.5] "{NoAI:1b}"]
        [:job (jobs.survival.get-food {})]]
  :limit-s 100}
 :cases
 [{:name "own-plan-pen-surplus-is-hunted-keeping-two"
   :plans [{:id "pen" :metadata {:by "$body"}
            :parts [{:id "pen" :cells [#at [22 0 22] #at [27 0 27]] :want [:any "dirt"]}]}]
   :expect [{:event {:source :job :kind #{:completed :stopped}} :within-s 90 :of-job true}]
   :after [[:entities "type=cow,tag=wt" [[0 0 0] [31 3 31]] 2]]}
  {:name "other-plan-pen-is-spared"
   :plans [{:id "pen" :metadata {:by "SomeoneElse"}
            :parts [{:id "pen" :cells [#at [22 0 22] #at [27 0 27]] :want [:any "dirt"]}]}]
   :expect [{:event {:source :job :kind :food.none :level :warn} :within-s 90}]
   :after [[:entities "type=cow,tag=wt" [[0 0 0] [31 3 31]] 3]]}]}
