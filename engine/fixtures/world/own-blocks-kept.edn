;; Card 77b8ed40 (Wicken #139: a dirt hut's walls vanished). A hut of dirt is terrain to the rules (no plan covers it), so
;; nothing else keeps the body's own jobs from cutting it but the seal: a body its own shelter seal keeps in for a known
;; hostile leaves that seal and prices another way out (card 1824f7b1: giving up there left a body shut in for ever). (The take-back's no-dig-through rule is pinned by cleanup-test only: a block
;; seen and then walled off before the job starts did not stay sensed live.)
;; Lit plot: the body sees the zombie; the room is torch-lit so its seal opens onto no dark (no :night keep).
{:defaults
 {:tags [:access :go-to :hostile] :time :any
  :body {:inventory [["iron_pickaxe" 1] ["iron_sword" 1]] :effects [["resistance" 600 4]]}
  :limit-s 90}
 :cases
 [{:name "shut-in-by-its-seal-for-a-hostile-keeps-the-seal-and-cuts-another-way"
   ;; a dirt hut (inside x 4..6 z 10..12, roof y 2) whose north wall cells [5 0 13] [5 1 13] are its :shelter seal; a NoAI
   ;; zombie outside in sight through the glass [7 1 12] could come in by it; the walk east to [14 0 11] keeps the seal
   ;; and the glass and goes out by another wall
   :plot {:height 12 :light :lit}
   :blocks [[:fill [3 0 9] [7 2 13] "dirt"] [:fill [4 0 10] [6 1 12] "air"] [:set [4 0 10] "torch"] [:set [7 1 12] "glass"]]
   :memory [{:kind :scaffold :data {:entries [{:cell #at [5 0 13] :item "dirt" :before "air" :job "j1" :purpose :shelter :state :placed}
                                              {:cell #at [5 1 13] :item "dirt" :before "air" :job "j1" :purpose :shelter :state :placed}]}}]
   :body {:at [5.5 0 12.5]}
   :act [[:summon "zombie" [10.5 0 12.5] "{NoAI:1b,PersistenceRequired:1b}"] [:until-seen {:entity "zombie"} 10]
         [:job (jobs.movement.go-to {:pos #at [14 0 11] :range 1 :checks {:safe? (always)}})]]
   :expect [{:event {:source :job :kind :completed :data {:arrived true}} :within-s 80 :of-job true}]
   :after [[:block [5 0 13] "dirt"] [:block [5 1 13] "dirt"] [:block [7 1 12] "glass"]]}
  {:name "shut-in-by-its-seal-with-no-hostile-takes-the-seal-back"
   ;; control: no zombie, the seal is taken back and the walk goes out through it; the hut walls stay
   :plot {:height 12 :light :lit}
   :blocks [[:fill [3 0 9] [7 2 13] "dirt"] [:fill [4 0 10] [6 1 12] "air"] [:set [4 0 10] "torch"] [:set [7 1 12] "glass"]]
   :memory [{:kind :scaffold :data {:entries [{:cell #at [5 0 13] :item "dirt" :before "air" :job "j1" :purpose :shelter :state :placed}
                                              {:cell #at [5 1 13] :item "dirt" :before "air" :job "j1" :purpose :shelter :state :placed}]}}]
   :body {:at [5.5 0 12.5]}
   :act [[:job (jobs.movement.go-to {:pos #at [14 0 11] :range 1 :checks {:safe? (always)}})]]
   :expect [{:event {:source :job :kind :completed :data {:arrived true}} :within-s 80 :of-job true}]
   :after [[:block [3 0 10] "dirt"] [:block [7 0 10] "dirt"] [:block [3 0 11] "dirt"] [:block [7 0 11] "dirt"] [:block [3 0 12] "dirt"] [:block [7 0 12] "dirt"] [:block [4 0 9] "dirt"] [:block [4 0 13] "dirt"] [:block [5 0 9] "dirt"] [:block [6 0 9] "dirt"] [:block [6 0 13] "dirt"] [:block [3 1 10] "dirt"] [:block [7 1 10] "dirt"] [:block [3 1 11] "dirt"] [:block [7 1 11] "dirt"] [:block [3 1 12] "dirt"] [:block [4 1 9] "dirt"] [:block [4 1 13] "dirt"] [:block [5 1 9] "dirt"] [:block [6 1 9] "dirt"] [:block [6 1 13] "dirt"] [:not-block [5 0 13] "dirt"] [:not-block [5 1 13] "dirt"]]}]}
