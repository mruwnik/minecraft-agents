;; Card cd74fd83: jobs.gather.mine asks the same harvest question as get-tool: a block the bare hand harvests (sapling, flower) needs
;; no pickaxe, so there is no fetch spin (a fetch child that ends done while the wait persists is booked failed, not re-run 400 times
;; a round); a block that needs a sword (cobweb) says so in mine.no-tool. Body at [16.5 0 16.5] with nothing carried, the block 4 east.
{:defaults
 {:tags [:mine :jobs :fetch] :time :any
  :plot {:height 8}
  :body {:at [16.5 0 16.5] :yaw 270 :effects [["resistance" 600 4]] :settle-s 3}
  :limit-s 90}
 :cases
 [{:name "sapling-is-mined-by-hand-no-fetch-spin"
   :blocks [[:set [20 -1 16] "grass_block"] [:set [20 0 16] "oak_sapling"]]
   :act [[:job (jobs.gather.mine {:block "oak_sapling" :count 1 :direction :east :tunnel-length 4 :radius 8 :mend false})]]
   :expect [{:event {:source :job :kind :mine.done :data {:got 1}} :within-s 60 :of-job true}
            {:no-event {:source :job :kind :fetch.started} :for-s 60 :until {:source :job :kind :mine.done}}
            {:no-event {:source :job :kind :mine.no-tool} :for-s 60 :until {:source :job :kind :mine.done}}]
   :after [[:item "oak_sapling" 1] [:not-block [20 0 16] "oak_sapling"]]}
  {:name "flower-is-mined-by-hand-no-fetch-spin"
   :blocks [[:set [20 -1 16] "grass_block"] [:set [20 0 16] "dandelion"]]
   :act [[:job (jobs.gather.mine {:block "dandelion" :count 1 :direction :east :tunnel-length 4 :radius 8 :mend false})]]
   :expect [{:event {:source :job :kind :mine.done :data {:got 1}} :within-s 60 :of-job true}
            {:no-event {:source :job :kind :fetch.started} :for-s 60 :until {:source :job :kind :mine.done}}]
   :after [[:item "dandelion" 1]]}
  {:name "stone-with-no-pickaxe-and-nothing-to-fetch-ends-no-tool-pickaxe"
   :blocks [[:fill [20 0 15] [22 1 17] "stone"]]
   :act [[:job (jobs.gather.mine {:block "stone" :count 1 :direction :east :tunnel-length 4 :radius 8 :fetch false :mend false})]]
   :expect [{:event {:source :job :kind :mine.no-tool :data {:tool "pickaxe"}} :within-s 40 :of-job true}
            {:event {:source :job :kind :mine.done :data {:got 0 :reason :no-tool}} :within-s 40 :of-job true}]
   :after [[:block [20 0 16] "stone"]]}
  {:name "cobweb-with-no-sword-ends-no-tool-sword"
   :blocks [[:set [20 0 16] "cobweb"]]
   :act [[:job (jobs.gather.mine {:block "cobweb" :count 1 :direction :east :tunnel-length 4 :radius 8 :fetch false :mend false})]]
   :expect [{:event {:source :job :kind :mine.no-tool :data {:tool "sword"}} :within-s 40 :of-job true}
            {:event {:source :job :kind :mine.done :data {:got 0 :reason :no-tool :tool "sword"}} :within-s 40 :of-job true}]
   :after [[:block [20 0 16] "cobweb"]]}]}
