;; Card 53d05972 (D19): jobs.movement.reach builds a stair down or a bridge, chosen by price, where go-to finds no walk.
;; Tunnel (wall torches light it and the pit): stone mass x 2..30, y -5..3, z 14..18, a 1x2 tunnel along z 16 from x 4 to x 28 cut by a chasm x 12..16 (3 deep, lava at the bottom, lit by it). Should-succeed: dirt carried: a 5-block bridge (go-to.escalated :bridge) and the far end is reached; a side tunnel round
;; the pit is walked, nothing placed. Should-fail: reach :ways #{:walk} stops at the pit edge, the pit stays open.
;; Cave: stone mass x 2..30, y 0..16, z 2..30, the body on top; a pocket 15 below and 6 across (the stair runs 15 on, the rest is dug back) is too far for a dug route (16 cells at
;; most), so a stair down is cut (:stair). Should-fail: :ways without :stair cut no stair down.
;; Mine: the same mass hollowed into a dark room 25 x 25, 3 high, wider than a room; the body on its floor, the goal on top 16 up: a stair up is cut and the top reached.
{:defaults
 {:tags [:movement :go-to :access]
  :time :any
  :plot {:height 12}
  :limit-s 200}
 :cases
 [{:name "pit-in-the-tunnel-is-bridged"
   :blocks [[:fill [2 -5 14] [30 3 18] "stone"] [:fill [4 0 16] [28 1 16] "air"] [:fill [12 -3 16] [16 -1 16] "air"] [:fill [12 -4 16] [16 -4 16] "lava"] [:set [8 1 15] "wall_torch[facing=south]"] [:set [14 1 15] "wall_torch[facing=south]"] [:set [20 1 15] "wall_torch[facing=south]"] [:set [26 1 15] "wall_torch[facing=south]"]]
   :body {:at [5.5 0 16.5] :settle-s 2 :effects [["resistance" 600 4] ["fire_resistance" 600 0]] :inventory [["dirt" 9]]}
   :act [[:job (jobs.movement.reach {:pos #at [27 0 16] :range 0})]]
   :expect [{:event {:source :job :kind :reach.span :data {:step :bridge}} :within-s 60 :of-job true}
            {:event {:source :job :kind :completed :context {:chain [[:any]]} :data {:arrived true}} :within-s 160 :of-job true}]
   :after [[:block [14 -1 16] "dirt"] [:body-near [27.5 0 16.5] 2]]}
  {:name "move-to-tool-bridges-the-pit"
   :blocks [[:fill [2 -5 14] [30 3 18] "stone"] [:fill [4 0 16] [28 1 16] "air"] [:fill [12 -3 16] [16 -1 16] "air"] [:fill [12 -4 16] [16 -4 16] "lava"] [:set [8 1 15] "wall_torch[facing=south]"] [:set [14 1 15] "wall_torch[facing=south]"] [:set [20 1 15] "wall_torch[facing=south]"] [:set [26 1 15] "wall_torch[facing=south]"]]
   :body {:at [5.5 0 16.5] :settle-s 2 :effects [["resistance" 600 4] ["fire_resistance" 600 0]] :inventory [["dirt" 9]]}
   :act [[:cli "world" ["$body" "submit" "move-to" #at [27 0 16] "--range" "0" "--who" "wt" "--world" "$world"] {:ok true}]]
   :expect [{:event {:source :job :kind :reach.span :data {:step :bridge}} :within-s 60}
            {:event {:source :job :kind :completed :data {:arrived true}} :within-s 160}]
   :after [[:block [14 -1 16] "dirt"] [:body-near [27.5 0 16.5] 2]]}
  {:name "walk-round-the-pit-is-taken-before-a-bridge"
   :blocks [[:fill [2 -5 14] [30 3 20] "stone"] [:fill [4 0 16] [28 1 16] "air"] [:fill [12 -3 16] [16 -1 16] "air"] [:fill [12 -4 16] [16 -4 16] "lava"] [:set [8 1 15] "wall_torch[facing=south]"] [:set [14 1 15] "wall_torch[facing=south]"] [:set [20 1 15] "wall_torch[facing=south]"] [:set [26 1 15] "wall_torch[facing=south]"]
            [:fill [4 0 17] [4 1 17] "air"] [:fill [4 0 18] [28 1 18] "air"] [:fill [28 0 17] [28 1 17] "air"]]
   :body {:at [5.5 0 16.5] :settle-s 2 :effects [["resistance" 600 4] ["fire_resistance" 600 0]] :inventory [["dirt" 9]]}
   :act [[:job (jobs.movement.reach {:pos #at [27 0 16] :range 0})]]
   :expect [{:event {:source :job :kind :completed :context {:chain [[:any]]} :data {:arrived true}} :within-s 120 :of-job true}
            {:no-event {:source :job :kind :reach.span} :for-s 120 :until {:source :job :kind :completed :data {:arrived true}}}]
   :after [[:block [14 -1 16] "air"] [:body-near [27.5 0 16.5] 2]]}
  {:name "move-to-tool-column-goal-walks-round-the-pit"
   :blocks [[:fill [2 -5 14] [30 3 20] "stone"] [:fill [4 0 16] [28 1 16] "air"] [:fill [12 -3 16] [16 -1 16] "air"] [:fill [12 -4 16] [16 -4 16] "lava"] [:set [8 1 15] "wall_torch[facing=south]"] [:set [14 1 15] "wall_torch[facing=south]"] [:set [20 1 15] "wall_torch[facing=south]"] [:set [26 1 15] "wall_torch[facing=south]"]
            [:fill [4 0 17] [4 1 17] "air"] [:fill [4 0 18] [28 1 18] "air"] [:fill [28 0 17] [28 1 17] "air"]]
   :body {:at [5.5 0 16.5] :settle-s 2 :effects [["resistance" 600 4] ["fire_resistance" 600 0]] :inventory [["dirt" 9]]}
   :act [[:cli "world" ["$body" "submit" "move-to" #at [27 16] "--range" "0" "--who" "wt" "--world" "$world"] {:ok true}]]
   :expect [{:event {:source :job :kind :completed :data {:arrived true}} :within-s 120}
            {:no-event {:source :job :kind :reach.span} :for-s 120 :until {:source :job :kind :completed :data {:arrived true}}}]
   :after [[:block [14 -1 16] "air"] [:body-near [27.5 0 16.5] 2]]}
  {:name "walk-only-does-not-bridge"
   :blocks [[:fill [2 -5 14] [30 3 18] "stone"] [:fill [4 0 16] [28 1 16] "air"] [:fill [12 -3 16] [16 -1 16] "air"] [:fill [12 -4 16] [16 -4 16] "lava"] [:set [8 1 15] "wall_torch[facing=south]"] [:set [14 1 15] "wall_torch[facing=south]"] [:set [20 1 15] "wall_torch[facing=south]"] [:set [26 1 15] "wall_torch[facing=south]"]]
   :body {:at [5.5 0 16.5] :settle-s 2 :effects [["resistance" 600 4] ["fire_resistance" 600 0]] :inventory [["dirt" 9]]}
   :act [[:job (jobs.movement.reach {:pos #at [27 0 16] :range 0 :ways #{:walk}})]]
   :expect [{:event {:source :job :kind :stopped :data {:arrived false}} :within-s 90 :of-job true}
            {:no-event {:source :job :kind :reach.span} :for-s 90 :until {:source :job :kind :stopped :data {:arrived false}}}]
   :after [[:block [14 -1 16] "air"] [:body-far [27.5 0 16.5] 8]]
   :limit-s 100}
  {:name "dark-drop-is-lit-with-made-torches-not-spanned"
   ;; Dark unlit tunnel with a 2 drop to a lower tunnel; the body carries coal and sticks, no torch: it makes torches and lights the way, as a player would, and builds no stair.
   :blocks [[:fill [2 -6 14] [30 3 18] "stone"] [:fill [4 0 16] [15 1 16] "air"] [:fill [15 -2 16] [28 -1 16] "air"]]
   :body {:at [5.5 0 16.5] :settle-s 2 :effects [["resistance" 600 4]] :inventory [["coal" 2] ["stick" 2] ["stone_pickaxe" 1]]}
   :act [[:job (jobs.movement.reach {:pos #at [27 -2 16] :range 0})]]
   :expect [{:event {:source :job :kind :completed :context {:chain [[:any]]} :data {:arrived true}} :within-s 200 :of-job true}
            {:no-event {:source :job :kind :reach.span} :for-s 200 :until {:source :job :kind :completed :data {:arrived true}}}]
   :after [[:body-near [27.5 -2 16.5] 2]]
   :limit-s 220}
  {:name "cave-far-below-is-reached-by-a-stair-down"
   :blocks [[:fill [2 0 2] [30 16 30] "stone"] [:fill [10 2 16] [10 3 16] "air"] [:fill [2 19 2] [30 19 30] "light"]]
   :plot {:height 22}
   :body {:at [4.5 17 16.5] :settle-s 2 :effects [["resistance" 600 4] ["fire_resistance" 600 0]] :inventory [["stone_pickaxe" 1] ["cobblestone" 24]]}
   :act [[:job (jobs.movement.reach {:pos #at [10 2 16] :range 0})]]
   :expect [{:event {:source :job :kind :reach.span :data {:step :stair}} :within-s 150 :of-job true}
            {:event {:source :job :kind :completed :context {:chain [[:any]]} :data {:arrived true}} :within-s 380 :of-job true}]
   :after [[:body-near [10.5 2 16.5] 2]]
   :limit-s 400}
 {:name "hurt-body-stair-down-waits-low-health"
   ;; Q328: a reach is a chosen way to a goal, not an escape: a hurt body (3 hp, hunger stops regeneration) cuts nothing.
   :blocks [[:fill [2 0 2] [30 16 30] "stone"] [:fill [10 2 16] [10 3 16] "air"] [:fill [2 19 2] [30 19 30] "light"]]
   :plot {:height 22}
   :body {:at [4.5 17 16.5] :settle-s 2 :effects [["hunger" 120 255]] :inventory [["stone_pickaxe" 1] ["cobblestone" 24]]}
   :act [[:rcon "damage $BODY 17 minecraft:generic"]
         [:job (jobs.movement.reach {:pos #at [10 2 16] :range 0})]]
   :expect [{:event {:source :job :kind :waiting :data {:reason :low-health}} :within-s 150 :of-job true}
            {:no-event {:source :action :kind :done :data {:name "dig"}} :for-s 30 :until {:source :job :kind :waiting :data {:reason :low-health}}}]
   :after [[:body-far [10.5 2 16.5] 8]]
   :limit-s 220}
  {:name "mine-room-wider-than-a-room-stairs-up-to-the-top"
   :blocks [[:fill [2 0 2] [30 16 30] "stone"] [:fill [4 1 4] [28 3 28] "air"] [:fill [2 19 2] [30 19 30] "light"]]
   :plot {:height 22}
   :body {:at [5.5 1 16.5] :settle-s 2 :effects [["resistance" 600 4] ["fire_resistance" 600 0]] :inventory [["stone_pickaxe" 1] ["cobblestone" 24]]}
   :act [[:job (jobs.movement.reach {:pos #at [26 17 16] :range 1})]]
   :expect [{:event {:source :job :kind :completed :context {:chain [[:any]]} :data {:arrived true}} :within-s 380 :of-job true}]
   :after [[:body-near [26.5 17 16.5] 2]]
   :limit-s 400}
  {:name "ways-without-stair-cut-no-stair-down"
   :blocks [[:fill [2 0 2] [30 16 30] "stone"] [:fill [10 2 16] [10 3 16] "air"] [:fill [2 19 2] [30 19 30] "light"]]
   :plot {:height 22}
   :body {:at [4.5 17 16.5] :settle-s 2 :effects [["resistance" 600 4]] :inventory [["stone_pickaxe" 1] ["cobblestone" 24]]}
   :act [[:job (jobs.movement.reach {:pos #at [10 2 16] :range 0 :ways #{:walk :bridge}})]]
   :expect [{:event {:source :job :kind :stopped :data {:arrived false}} :within-s 200 :of-job true}
            {:no-event {:source :action :kind :done :data {:name "dig"}} :for-s 200 :until {:source :job :kind :stopped :data {:arrived false}}}]
   :after [[:body-far [10.5 2 16.5] 8]]
   :limit-s 250}]}
