;; A dig of the ore beside the body in a wide dark hall stays a click (10 s), priced like any exposure (jobs.lib.price/priced); priced over
;; what the body may risk (risk-share 0), it goes ahead only with one torch for its cell (ready/dark-near-ok, cost/dark-or-lit) and hangs it.
;; Hall x 5..40, z 4..28, y 0..1, unlit; the body in a 1-cell alcove at [4 0 16] facing west at iron ore in the wall [3 1 16].
;; Stone mass x 2..44, z 2..30, y 0..6.
{:defaults
 {:tags [:mine :torch :jobs] :time :any
  :plot {:light :dark :height 12 :length 48 :width 34}
  :blocks [[:fill [2 0 2] [44 6 30] "stone"] [:fill [5 0 4] [40 1 28] "air"] [:fill [4 0 16] [4 1 16] "air"]
           [:set [3 1 16] "iron_ore"]]
  :body {:at [4.5 0 16.5] :yaw 90 :inventory [["stone_pickaxe" 1] ["cobblestone" 16] ["torch" 8]] :effects [["resistance" 600 4]]}
  :act [[:job (jobs.gather.mine {:block "iron_ore" :level false :count 1 :radius 4 :mend false :ways #{:seen :carried}})]]
  :limit-s 120}
 :cases
 [{:name "torches-carried-dig-the-ore-beside-the-body"
   :expect [{:event {:source :job :kind :completed} :within-s 60 :of-job true}]
   :after [[:block [3 1 16] "air"] [:item "raw_iron" [:= 1]]]}
  {:name "no-risk-allowed-torches-carried-dig-the-ore-and-hang-one-torch"
   :settings {:jobs.lib.cost.risk/risk-share 0}
   :expect [{:event {:source :job :kind :completed} :within-s 60 :of-job true}]
   :after [[:block [3 1 16] "air"] [:item "raw_iron" [:= 1]] [:item "torch" [:= 7]]]}
  {:name "no-risk-allowed-no-torches-no-gather-is-refused-the-dark"
   :settings {:jobs.lib.cost.risk/risk-share 0}
   :body {:inventory [["stone_pickaxe" 1] ["cobblestone" 16]]}
   :expect [{:event {:source :job :data {:reason :exposed}} :within-s 60 :of-job true}]
   :after [[:block [3 1 16] "iron_ore"] [:item "raw_iron" [:= 0]]]}]}
