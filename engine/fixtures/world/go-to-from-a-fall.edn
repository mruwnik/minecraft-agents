;; Card 7003da1a: go-to starts with the body still falling (settle-s 0, the job runs at once) and waits for the landing before it plans. A lit
;; open plot, a 6 block fall onto the stone floor; the goal 10 blocks east. Should-succeed: dry floor landing; landing in a 3 deep pool (the body is in water, which counts as settled: no endless wait).
{:defaults
 {:tags [:movement] :time :any
  :plot {:height 12 :light :sky}
  :body {:at [4.5 6 8.5] :yaw 270 :settle-s 0}
  :limit-s 60}
 :cases
 [{:name "fall-onto-floor-then-arrives"
   :blocks [[:fill [2 10 2] [24 10 14] "light"]]
   :act [[:job (jobs.movement.go-to {:pos #at [14 0 8] :range 1 :ways #{:walk :clear-seal}})]]
   :expect [{:event {:source :job :kind :completed :data {:arrived true}} :within-s 45 :of-job true}]
   :after [[:body-near [14.5 0 8.5] 3]]}
  {:name "fall-into-pool-then-arrives"
   :blocks [[:fill [2 10 2] [24 10 14] "light"]
            [:fill [3 -3 7] [5 -1 9] "water"]]
   :act [[:job (jobs.movement.go-to {:pos #at [14 0 8] :range 1 :ways #{:walk :clear-seal}})]]
   :expect [{:event {:source :job :kind :completed :data {:arrived true}} :within-s 45 :of-job true}]
   :after [[:body-near [14.5 0 8.5] 3]]}]}
