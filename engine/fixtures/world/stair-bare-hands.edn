;; Card 66fa119b: a stair cut with no pickaxe and no way to get one digs stone by hand and
;; reaches the surface; bedrock in the line stops it with a reason and nothing is dug. Stone mass x 8..24, z 8..24, y 0..9 (surface y 10),
;; the body in a pocket at feet y 6, the stair goes up east 4 steps to feet y 10.
{:defaults
 {:tags [:access :mining :no-tool] :time :any
  :plot {:height 16}
  :blocks [[:fill [8 0 8] [24 9 24] "stone"] [:fill [10 6 16] [10 7 16] "air"]]
  :body {:at [10.5 6 16.5] :yaw 270 :effects [["resistance" 600 4]]}
  :limit-s 220}
 :cases
 [{:name "no-pickaxe-stair-up-digs-stone-by-hand-to-the-surface"
   :act [[:job (jobs.access.stair {:dir :up :heading :east :steps 4})]]
   :expect [{:event {:source :job :kind :stair.done} :within-s 210 :of-job true}
            {:no-event {:source :job :kind :stair.stopped :data {:reason :no-tool}} :for-s 200 :until {:source :job :kind :stair.done}}]
   :after [[:body-near [14.5 10 16.5] 3]]}
  {:name "bedrock-in-the-line-stops-with-a-reason-and-digs-nothing"
   :blocks [[:fill [11 6 16] [14 9 16] "bedrock"]]
   :act [[:job (jobs.access.stair {:dir :up :heading :east :steps 4})]]
   :expect [{:event {:source :job :kind :stair.stopped} :within-s 210 :of-job true}
            {:no-event {:source :job :kind :stair.done} :for-s 30 :of-job true}]
   :after [[:block [11 6 16] "bedrock"] [:body-near [10.5 6 16.5] 2]]}]}
