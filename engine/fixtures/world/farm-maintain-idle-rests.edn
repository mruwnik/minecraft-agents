;; Card 5305bc20: a listed farm.maintain over a field with nothing to do (young wheat, no seed, no tools) rests (waiting :resting, :recheck-after-ms)
;; instead of re-running its start check every tick (that check once held a body at 100% CPU). Field x 60..62, z 16..19: farmland y -1 (water row z 17), wheat age 0 y 0.
;; Should-succeed: the job's waiting event carries the farm recheck (:recheck-after-ms 25000, jobs.farm.tend/::recheck-s), which the scheduler rests on; before, the wait had none and was re-checked every tick.
;; Should-fail (control): none.
{:defaults
 {:tags [:farm :maintain :jobs]
  :time :day :time-why :sunlit-ground
  :plot {:floor "grass_block" :length 80 :width 32 :light :sky}
  :blocks [[:fill [60 -1 16] [62 -1 19] "farmland[moisture=7]"] [:fill [60 -2 17] [62 -2 17] "stone"] [:fill [60 -1 17] [62 -1 17] "water"]
           [:fill [60 0 16] [62 0 16] "wheat[age=0]"] [:fill [60 0 18] [62 0 19] "wheat[age=0]"]]
  :body {:at [61.5 0 14.5] :effects [["resistance" 600 4]]}
  :limit-s 90}
 :cases
 [{:name "listed-maintain-with-nothing-to-do-rests-between-checks"
   :act [[:job (jobs.farm.maintain {:area {:min #xyz [60 -1 16] :max #xyz [62 0 19]}})]]
   :expect [{:event {:source :job :kind :waiting :data {:recheck-after-ms 25000}} :within-s 60 :of-job true}]}]}
