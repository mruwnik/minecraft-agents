;; Card 8517fe2c: go-to (and its dry run, jobs.movement.path-preview) costs darkness: a seen dark cell costs twice a lit one,
;; so a lit route up to about 2x longer is taken; :dark false plans dark cells like lit ones. Roofed stone block, rooms at
;; x 1..3 and x 27..29, two corridors between them: a direct one along z 16 (25 long, never lit, in the body's line of
;; sight so its cells are seen dark) and a detour along z 24 (about 42 long, torches at x 10..19 only, far enough from
;; the rooms that no torch light reaches the direct corridor). The body looks east down the direct corridor. The preview
;; reports the route's :length in blocks and never walks: with :dark true the detour, with :dark false the direct one.
;; Card ea376fb0: the same at night (--allow-time): the night heuristic scale must not hide the lit detour, and a route that is dark
;; all the way (torches removed) is still found, the shorter direct corridor.
{:defaults
 {:tags [:movement :planner :dark]
  :time :any
  :plot {:height 8}
  :blocks [[:fill [0 0 0] [31 2 31] "stone"]
           [:fill [1 0 15] [3 1 17] "air"] [:fill [27 0 15] [29 1 17] "air"]
           [:fill [4 0 16] [26 1 16] "air"]
           [:fill [2 0 18] [2 1 24] "air"] [:fill [2 0 24] [28 1 24] "air"] [:fill [28 0 18] [28 1 24] "air"]
           [:set [10 0 24] "torch"] [:set [13 0 24] "torch"] [:set [16 0 24] "torch"] [:set [19 0 24] "torch"]]
  :body {:at [2.5 0 16.5] :yaw 270 :settle-s 4}
  :limit-s 40}
 :cases
 [{:name "dark-direct-corridor-takes-the-lit-detour"
   :act [[:job (jobs.movement.path-preview {:pos #at [28 0 16] :range 1})]]
   :expect [{:event {:source :job :kind :path-preview :data {:found true :length [:> 35]}} :within-s 30 :of-job true}]
   :after [[:body-near [2.5 0 16.5] 1]]}
  {:name "dark-false-takes-the-direct-corridor"
   :act [[:job (jobs.movement.path-preview {:pos #at [28 0 16] :range 1 :dark false})]]
   :expect [{:event {:source :job :kind :path-preview :data {:found true :length [:< 30]}} :within-s 30 :of-job true}]
   :after [[:body-near [2.5 0 16.5] 1]]}
  {:name "night-dark-direct-corridor-takes-the-lit-detour"
   :time :night
   :act [[:job (jobs.movement.path-preview {:pos #at [28 0 16] :range 1})]]
   :expect [{:event {:source :job :kind :path-preview :data {:found true :length [:> 35]}} :within-s 30 :of-job true}]
   :after [[:body-near [2.5 0 16.5] 1]]}
  {:name "night-all-dark-route-is-still-found"
   :time :night
   :blocks [[:set [10 0 24] "air"] [:set [13 0 24] "air"] [:set [16 0 24] "air"] [:set [19 0 24] "air"]]
   :act [[:job (jobs.movement.path-preview {:pos #at [28 0 16] :range 1})]]
   :expect [{:event {:source :job :kind :path-preview :data {:found true :length [:< 30]}} :within-s 30 :of-job true}]
   :after [[:body-near [2.5 0 16.5] 1]]}]}
