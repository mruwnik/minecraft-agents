;; Card 8517fe2c: go-to (and its quote, a dry run) costs darkness by the chance a mob spawns there (Q334/Q345: a small dark tunnel
;; costs little), so of two routes about as long the lit one is taken; :dark false (the walk.world setting) plans dark cells like lit ones. Roofed stone block, rooms at
;; x 1..3 and x 27..29, two corridors between them: a direct one along z 16 (25 long, never lit; each case walks it there and
;; back first so its cells are seen dark: sight makes out a dark cell only within 4 blocks, and the rock guess reads one never
;; seen 3 past that as stone) and a detour along z 24 (about 42 long, torches at x 10..19 only, far enough from
;; the rooms that no torch light reaches the direct corridor). The body looks east down the direct corridor. The quote's route
;; reports the route's :length in blocks and its :dark cells, and never walks.
;; Cards ea376fb0, c1f4e3be, 53c112a5: the block is roofed, so the body is underground at any hour and a cell never seen counts dark
;; (look/dark-fn; a player cannot know a corridor round a corner is lit): a lit lane beside the direct corridor (opened mid-case along
;; z 18, as long from z 17) wins once the body has walked it, and still once its torches are broken while the body is back in
;; the room, out of sight of them (card b3052e66: the lane keeps the light the body saw), a detour never seen takes the
;; direct corridor, and a route dark all the way (torches removed) is still found, the shorter direct corridor.
{:defaults
 {:tags [:movement :planner :dark]
  :time :any
  :plot {:light :dark :height 8}
  :blocks [[:fill [0 0 0] [31 2 31] "stone"]
           [:fill [1 0 15] [3 1 17] "air"] [:fill [27 0 15] [29 1 17] "air"]
           [:fill [4 0 16] [26 1 16] "air"]
           [:fill [2 0 18] [2 1 24] "air"] [:fill [2 0 24] [28 1 24] "air"] [:fill [28 0 18] [28 1 24] "air"]
           [:set [10 0 24] "torch"] [:set [13 0 24] "torch"] [:set [16 0 24] "torch"] [:set [19 0 24] "torch"]]
  :body {:at [2.5 0 16.5] :yaw 270 :settle-s 4}
  :limit-s 40}
 :cases
 [{:name "dark-false-takes-the-direct-corridor"
   :settings {:jobs.lib.walk.world/dark false}
   :limit-s 120
   :act [[:job (jobs.movement.go-to {:pos #at [26 0 16] :range 0})]
         [:until-pos {:x-min 25} 40]
         [:job (jobs.movement.go-to {:pos #at [2 0 16] :range 0}) [:alongside]]
         [:until-pos {:x-max 3} 40]
         [:until [:cli "quote" ["$body" "--world" "$world" "jobs.movement.go-to" {:pos #at [28 0 16] :range 1}] {:ok true :quote {:route {:found true :length [:< 30]}}}] 30]]
   :expect [{:count-event {:source :job :kind :completed :data {:arrived true}} :for-s 90 :at-least 2 :at-most 2 :of-job true}
            {:no-event {:level :error} :for-s 2}]
   :after [[:body-near [2.5 0 16.5] 1]]}
  {:name "walked-lit-lane-beats-the-dark-direct-corridor"
   :limit-s 150
   :act [[:job (jobs.movement.go-to {:pos #at [26 0 16] :range 0})]
         [:until-pos {:x-min 25} 40]
         [:job (jobs.movement.go-to {:pos #at [2 0 16] :range 0}) [:alongside]]
         [:until-pos {:x-max 3} 40]
         [:rcon "execute positioned $X $Y $Z run fill ~3 ~ ~18 ~27 ~1 ~18 air"]
         [:rcon "execute positioned $X $Y $Z run setblock ~10 ~ ~18 torch"] [:rcon "execute positioned $X $Y $Z run setblock ~13 ~ ~18 torch"]
         [:rcon "execute positioned $X $Y $Z run setblock ~16 ~ ~18 torch"] [:rcon "execute positioned $X $Y $Z run setblock ~19 ~ ~18 torch"]
         [:job (jobs.movement.go-to {:pos #at [26 0 18] :range 0}) [:alongside]]
         [:until-pos {:x-min 25 :z-min 18} 40]
         [:job (jobs.movement.go-to {:pos #at [2 0 17] :range 0}) [:alongside]]
         [:until-pos {:x-max 3} 40]
         [:until [:cli "quote" ["$body" "--world" "$world" "jobs.movement.go-to" {:pos #at [28 0 17] :range 0}] {:ok true :quote {:route {:found true :length [:< 30] :dark [:< 5]}}}] 30]]
   :expect [{:count-event {:source :job :kind :completed :data {:arrived true}} :for-s 120 :at-least 4 :at-most 4 :of-job true}
            {:no-event {:level :error} :for-s 2}]
   :after [[:body-near [2.5 0 17.5] 1]]}
  {:name "lane-torches-broken-out-of-sight-still-light-it"
   :limit-s 150
   :act [[:job (jobs.movement.go-to {:pos #at [26 0 16] :range 0})]
         [:until-pos {:x-min 25} 40]
         [:job (jobs.movement.go-to {:pos #at [2 0 16] :range 0}) [:alongside]]
         [:until-pos {:x-max 3} 40]
         [:rcon "execute positioned $X $Y $Z run fill ~3 ~ ~18 ~27 ~1 ~18 air"]
         [:rcon "execute positioned $X $Y $Z run setblock ~10 ~ ~18 torch"] [:rcon "execute positioned $X $Y $Z run setblock ~13 ~ ~18 torch"]
         [:rcon "execute positioned $X $Y $Z run setblock ~16 ~ ~18 torch"] [:rcon "execute positioned $X $Y $Z run setblock ~19 ~ ~18 torch"]
         [:job (jobs.movement.go-to {:pos #at [26 0 18] :range 0}) [:alongside]]
         [:until-pos {:x-min 25 :z-min 18} 40]
         [:job (jobs.movement.go-to {:pos #at [2 0 17] :range 0}) [:alongside]]
         [:until-pos {:x-max 3} 40]
         [:rcon "execute positioned $X $Y $Z run fill ~10 ~ ~18 ~19 ~ ~18 air"]
         [:until [:cli "quote" ["$body" "--world" "$world" "jobs.movement.go-to" {:pos #at [28 0 17] :range 0}] {:ok true :quote {:route {:found true :length [:< 30] :dark [:< 5]}}}] 30]]
   :expect [{:count-event {:source :job :kind :completed :data {:arrived true}} :for-s 120 :at-least 4 :at-most 4 :of-job true}
            {:no-event {:level :error} :for-s 2}]
   :after [[:body-near [2.5 0 17.5] 1]]}
  {:name "unseen-lit-detour-counts-dark-takes-the-direct-corridor"
   :limit-s 120
   :act [[:job (jobs.movement.go-to {:pos #at [26 0 16] :range 0})]
         [:until-pos {:x-min 25} 40]
         [:job (jobs.movement.go-to {:pos #at [2 0 16] :range 0}) [:alongside]]
         [:until-pos {:x-max 3} 40]
         [:until [:cli "quote" ["$body" "--world" "$world" "jobs.movement.go-to" {:pos #at [28 0 16] :range 1}] {:ok true :quote {:route {:found true :length [:< 30]}}}] 30]]
   :expect [{:count-event {:source :job :kind :completed :data {:arrived true}} :for-s 90 :at-least 2 :at-most 2 :of-job true}
            {:no-event {:level :error} :for-s 2}]
   :after [[:body-near [2.5 0 16.5] 1]]}
  {:name "all-dark-route-is-still-found"
   :blocks [[:set [10 0 24] "air"] [:set [13 0 24] "air"] [:set [16 0 24] "air"] [:set [19 0 24] "air"]]
   :limit-s 120
   :act [[:job (jobs.movement.go-to {:pos #at [26 0 16] :range 0})]
         [:until-pos {:x-min 25} 40]
         [:job (jobs.movement.go-to {:pos #at [2 0 16] :range 0}) [:alongside]]
         [:until-pos {:x-max 3} 40]
         [:until [:cli "quote" ["$body" "--world" "$world" "jobs.movement.go-to" {:pos #at [28 0 16] :range 1}] {:ok true :quote {:route {:found true :length [:< 30]}}}] 30]]
   :expect [{:count-event {:source :job :kind :completed :data {:arrived true}} :for-s 90 :at-least 2 :at-most 2 :of-job true}
            {:no-event {:level :error} :for-s 2}]
   :after [[:body-near [2.5 0 16.5] 1]]}]}
