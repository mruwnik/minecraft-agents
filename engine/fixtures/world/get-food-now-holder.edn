;; A get-food submitted with --now that ends with no food does not hold the body: the next job runs (card 6b628210).
;; Hunger by RCON (food 8, hp 15). Should-succeed: the go-to submitted after it arrives. Should-fail: none.
{:defaults
 {:tags [:survival :get-food :scheduler]
  :time :day
  :plot {:height 6}
  :body {:at [4.5 0 16.5] :settle-s 2}
  :limit-s 90}
 :cases
 [{:name "unfed-now-get-food-lets-the-go-to-run"
   :act [[:rcon "effect give $BODY minecraft:hunger 5 243 true"] [:until-effect-gone "hunger" 30]
         [:rcon "damage $BODY 5 minecraft:generic"]
         [:job (jobs.survival.get-food {:explore false}) [:now]]
         [:job (jobs.movement.go-to {:pos #at [20 0 16] :range 1})]]
   :expect [{:event {:source :job :kind :completed :data {:name "jobs.movement.go-to"}} :within-s 40}]
   :after [[:body-near [20.5 0 16.5] 3]]}]}
