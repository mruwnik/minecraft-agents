;; jobs.gather.mine and a drop it cannot get (card 79be43a4; the left-behind case not ported in card 8aa80fca). README: drops
;; still lying 0.4 s after the collect are reported once (info mine.left-behind) and listed in :left; then the body
;; walks back to the start cell (otherwise warn mine.not-home, job :stopped :not-home). It must never end stranded: the checks are
;; mine.left-behind, the job ending, no mine.not-home, the body at the start cell. Case 1: the ore hangs over a 1-deep pit
;; (reachable drop: collected, nothing left). Case 2 (collect-drops :dig cuts to the drop, card dd4e8bf6): the ore stands across a 1-wide 5-deep trench in the line, is dug from
;; the cut's end (3 away) and its drop lies in plain view on the far ledge, out of reach: the ledge cell has stone above it
;; (no standing there, so the 1-wide gap cannot be jumped for it) and the ore is a cell back from the trench edge, so
;; the drop's hop cannot carry it into the trench, out of sight (919b3113: it did, or was picked up). (Seen in the probe runs: ore across a
;; 2-wide trench is never dug, and a drop down a 1-wide shaft is out of sight and not reported: sensing is like a
;; player's.) Stone mass x 2..30, z 8..24, y -6..6; body in a 1x2 cell at [16 0 16] facing east, stone pickaxe; the cut
;; [16..19] is open already so ore further east is in view.
{:defaults
 {:tags [:mine :jobs] :time :any
  :plot {:height 12}
  :blocks [[:fill [2 -6 8] [30 6 24] "stone"] [:fill [16 0 16] [19 1 16] "air"]]
  :body {:at [16.5 0 16.5] :inventory [["stone_pickaxe" 1] ["cobblestone" 16]] :effects [["resistance" 600 4]]}}
 :cases
 [{:name "shallow-pit-drop-collected"
   :blocks [[:set [20 0 16] "iron_ore"] [:set [20 -1 16] "air"]]
   :act [[:job (jobs.gather.mine {:torch-interval 0 :block "iron_ore" :level false :count 1 :direction :east :tunnel-length 8 :radius 8})]]
   :expect [{:event {:source :job :kind #{:completed :stopped} :data {:got 1}} :within-s 120 :of-job true}
            {:no-event {:source :job :kind :mine.left-behind} :for-s 120 :until {:source :job :kind #{:completed :stopped} :data {:got 1}}}]
   :after [[:item "raw_iron" 1] [:body-near [16.5 0 16.5] 1.5]]
   :limit-s 140}
  {:name "drop-across-a-trench-is-dug-to-and-body-goes-home"
   ;; the ore stands across a 1-wide, 5-deep trench and a 1-high ledge cell in the line: seen from the start, dug from
   ;; the cut's end (3 away), its drop lies on the ledge in plain view and cannot be walked to; collect-drops :dig (card
   ;; dd4e8bf6) cuts to it and the body ends home with it, nothing left behind, never mine.not-home.
   :blocks [[:fill [20 -4 16] [20 1 16] "air"] [:set [21 0 16] "air"] [:set [22 0 16] "iron_ore"]]
   :act [[:job (jobs.gather.mine {:torch-interval 0 :block "iron_ore" :level false :count 1 :direction :east :tunnel-length 8 :radius 8})]]
   :expect [{:event {:source :job :kind #{:completed :stopped} :data {:got 1}} :within-s 150 :of-job true}
            {:no-event {:source :job :kind #{:mine.left-behind :mine.not-home}} :for-s 150 :until {:source :job :kind #{:completed :stopped}}}]
   :after [[:item "raw_iron" 1] [:body-near [16.5 0 16.5] 1.5]]
   :limit-s 170}
  {:name "drop-in-a-3-deep-pit-is-dug-to"
   ;; the ore hangs over a 3x3 pit 3 deep (wide, so its drop is seen): too deep to walk down for, so the drop is dug to
   ;; with a stair and collected (card dd4e8bf6); nothing is left behind
   :blocks [[:fill [20 -3 15] [22 -1 17] "air"] [:set [20 0 16] "iron_ore"]]
   :act [[:job (jobs.gather.mine {:torch-interval 0 :block "iron_ore" :level false :count 1 :direction :east :tunnel-length 8 :radius 8})]]
   :expect [{:event {:source :job :kind #{:completed :stopped} :data {:got 1}} :within-s 150 :of-job true}
            {:no-event {:source :job :kind :mine.left-behind} :for-s 150 :until {:source :job :kind #{:completed :stopped}}}]
   :after [[:item "raw_iron" 1] [:body-near [16.5 0 16.5] 1.5]]
   :limit-s 170}]}
