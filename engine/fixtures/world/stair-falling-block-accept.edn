;; Card eb4febf9: jobs.access.stair :down with :accept [:falling-block] under gravel digs through it and finishes; it does not sit
;; silent between steps. Gravel is stacked over the cells of steps 3 and 4 (the cut cells of step k: x 10+k, feet y 10-k). Stone mass x 8..24, z 8..24, y 0..9.
{:defaults
 {:tags [:access :mining] :time :any
  :plot {:height 24}
  :blocks [[:fill [8 0 8] [24 9 24] "stone"] [:fill [13 6 16] [13 9 16] "gravel"] [:fill [14 5 16] [14 9 16] "gravel"]]
  :body {:at [10.5 10 16.5] :yaw 270 :inventory [["iron_pickaxe" 1] ["torch" 8]] :effects [["resistance" 600 4]]}
  :limit-s 200}
 :cases
 [{:name "gravel-in-the-line-with-accept-is-dug-through"
   :act [[:job (jobs.access.stair {:dir :down :heading :east :steps 8 :accept #{:falling-block}})]]
   :expect [{:event {:source :job :kind :completed :data {:steps 8}} :within-s 190 :of-job true}]
   :after [[:not-block [13 7 16] "gravel"] [:not-block [14 6 16] "gravel"]]}
  {:name "gravel-in-the-line-without-accept-stops-naming-the-hazard"
   :act [[:job (jobs.access.stair {:dir :down :heading :east :steps 8})]]
   :expect [{:event {:source :job :kind :stopped :data {:reason :hazard}} :within-s 120 :of-job true}]}
  ;; in the dark the stair's own step walks must not wait for light (job.waiting :exposed) or sit silent
  {:name "gravel-in-the-line-with-accept-is-dug-through-in-the-dark"
   :plot {:light :dark}
   :act [[:job (jobs.access.stair {:dir :down :heading :east :steps 8 :accept #{:falling-block}})]]
   :expect [{:event {:source :job :kind :completed :data {:steps 8}} :within-s 190 :of-job true}
            {:no-event {:source :job :kind :waiting :data {:reason :exposed}} :for-s 150 :until {:source :job :kind :completed} :of-job true}]
   :after [[:not-block [13 7 16] "gravel"] [:not-block [14 6 16] "gravel"]]}
  ;; Card fda17d97: a stair up out of a 1x1 pocket with gravel over its first headroom cell takes the landing on the body and digs it out
  {:name "stair-up-under-gravel-with-accept-digs-it-out"
   :blocks [[:fill [10 3 16] [10 4 16] "air"] [:fill [10 6 16] [10 7 16] "gravel"]]
   :body {:at [10.5 3 16.5] :yaw 270}
   :act [[:job (jobs.access.stair {:dir :up :heading :east :steps 4 :accept #{:falling-block}})]]
   :expect [{:event {:source :job :kind :completed :data {:steps 4}} :within-s 190 :of-job true}]
   :after [[:body-near [14.5 7 16.5] 1.5] [:not-block [10 6 16] "gravel"]]}
  ;; Card a9dae429 (Hollin #85): at 7 hp, with a cell behind to stand in, the body cuts the headroom cell (the gravel over it
  ;; is hidden by it) from there, so the gravel drops into the empty column, not onto the body; it digs what fell and
  ;; climbs on with no suffocation (no resistance; a hunger first empties the bar so health stays low: a fed body heals to 12+ in 2 s,
  ;; where the side cut is not worth its 2.5 s, stair/undermine-worth?)
  {:name "stair-up-under-gravel-with-room-behind-cuts-it-from-beside"
   :blocks [[:fill [9 3 16] [10 4 16] "air"] [:fill [10 6 16] [10 7 16] "gravel"]]
   :body {:at [10.5 3 16.5] :yaw 270 :effects []}
   :act [[:rcon "effect give $BODY minecraft:hunger 5 255 true"] [:until-effect-gone "hunger" 30]
         [:rcon "damage $BODY 13 minecraft:generic"]
         [:job (jobs.access.stair {:dir :up :heading :east :steps 4 :accept #{:falling-block}})]]
   :expect [{:event {:source :job :kind :stair.undermine :data {:cell #at [10 5 16]}} :within-s 60 :of-job true}
            {:event {:source :job :kind :completed :data {:steps 4}} :within-s 190 :of-job true}
            {:no-event {:source :body :kind :hurt :data {:causes ["suffocation"]}} :for-s 190 :until {:source :job :kind #{:completed :stopped}}}]
   :after [[:body-near [14.5 7 16.5] 1.5] [:not-block [10 6 16] "gravel"] [:not-block [10 3 16] "gravel"]]}
  {:name "stair-up-under-gravel-without-accept-stops-naming-the-hazard"
   :blocks [[:fill [10 3 16] [10 4 16] "air"] [:fill [10 6 16] [10 7 16] "gravel"]]
   :body {:at [10.5 3 16.5] :yaw 270}
   :act [[:job (jobs.access.stair {:dir :up :heading :east :steps 4})]]
   :expect [{:event {:source :job :kind :stopped :data {:reason :hazard}} :within-s 120 :of-job true}]}]}
