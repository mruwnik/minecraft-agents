;; Card f9455918: the part-cut-tree and replant-owed triggers. A trunk whose lowest logs were cut hangs over air with leaves on
;; top: the trigger fells it with fell-tree :part-cut? (its logs are picked up). A replant debt whose sapling is carried is planted
;; by the replant-owed trigger (plant-sapling, carried saplings only).
{:defaults
 {:tags [:forestry :triggers :part-cut-tree :replant-owed] :time :any
  :plot {:height 24 :floor "grass_block"}
  :body {:at [14.5 0 22.5] :yaw 180 :settle-s 2 :inventory [["iron_axe" 1] ["oak_sapling" 1]] :effects [["resistance" 600 4]]}
  :limit-s 150}
 :cases
 [{:name "part-cut-tree-trigger-fells-the-hanging-trunk"
   :register [{:trigger :part-cut-tree}]
   :memory [{:kind :forestry/part-cut :data {:column #at [16 16]} :policy {:cap 20 :ttl :forever}}]
   :blocks [[:fill [16 0 16] [16 9 16] "air"] [:fill [14 6 14] [18 10 18] "air"]
            [:fill [16 1 16] [16 6 16] "oak_log"] [:fill [14 5 14] [18 7 18] "oak_leaves[persistent=true]"] [:fill [16 5 16] [16 6 16] "oak_log"]]
   :expect [{:event {:source :reflex :kind :fired :context {:reflex-id :part-cut-tree}} :within-s 40}
            {:event {:source :reflex :kind :ended :context {:reflex-id :part-cut-tree} :data {:kind :done}} :within-s 140}]
   :after [[:not-block [16 1 16] "oak_log"] [:not-block [16 6 16] "oak_log"] [:item "oak_log" [:>= 5]]]}
  {:name "part-cut-tree-trigger-leaves-a-hanging-trunk-the-body-did-not-cut"
   :register [{:trigger :part-cut-tree}]
   :blocks [[:fill [16 0 16] [16 9 16] "air"] [:fill [14 6 14] [18 10 18] "air"]
            [:fill [16 1 16] [16 6 16] "oak_log"] [:fill [14 5 14] [18 7 18] "oak_leaves[persistent=true]"] [:fill [16 5 16] [16 6 16] "oak_log"]]
   :expect [{:no-event {:source :reflex :kind :fired :context {:reflex-id :part-cut-tree}} :for-s 40}]
   :after [[:block [16 6 16] "oak_log"]]
   :limit-s 60}
  {:name "part-cut-tree-trigger-fells-a-trunk-hanging-three-blocks-up"
   :register [{:trigger :part-cut-tree}]
   :memory [{:kind :forestry/part-cut :data {:column #at [16 16]} :policy {:cap 20 :ttl :forever}}]
   :blocks [[:fill [16 0 16] [16 11 16] "air"] [:fill [14 6 14] [18 10 18] "air"]
            [:fill [16 4 16] [16 6 16] "oak_log"] [:fill [14 6 14] [18 8 18] "oak_leaves[persistent=true]"] [:fill [16 6 16] [16 6 16] "oak_log"]]
   :expect [{:event {:source :reflex :kind :fired :context {:reflex-id :part-cut-tree}} :within-s 40}
            {:event {:source :reflex :kind :ended :context {:reflex-id :part-cut-tree} :data {:kind :done}} :within-s 140}]
   :after [[:not-block [16 4 16] "oak_log"] [:not-block [16 6 16] "oak_log"] [:item "oak_log" [:>= 1]]]}
  ;; Card a48235d8: standing trees 4 and 5 blocks from a hanging trunk, canopies joined to its crown, must not make it read as standing.
  {:name "part-cut-tree-trigger-fells-a-hanging-trunk-between-standing-trees"
   :register [{:trigger :part-cut-tree}]
   :memory [{:kind :forestry/part-cut :data {:column #at [16 16]} :policy {:cap 20 :ttl :forever}}]
   :blocks [[:fill [10 0 12] [23 11 20] "air"]
            [:fill [16 4 16] [16 6 16] "oak_log"] [:fill [14 6 14] [18 8 18] "oak_leaves[persistent=true]"] [:fill [16 6 16] [16 6 16] "oak_log"]
            [:fill [21 0 16] [21 8 16] "oak_log"] [:fill [19 7 14] [23 9 18] "oak_leaves[persistent=true]"] [:fill [21 7 16] [21 8 16] "oak_log"]
            [:fill [12 0 16] [12 8 16] "oak_log"] [:fill [10 7 14] [14 9 18] "oak_leaves[persistent=true]"] [:fill [12 7 16] [12 8 16] "oak_log"]]
   :expect [{:event {:source :reflex :kind :fired :context {:reflex-id :part-cut-tree}} :within-s 40}
            {:event {:source :reflex :kind :ended :context {:reflex-id :part-cut-tree} :data {:kind :done}} :within-s 140}]
   :after [[:not-block [16 4 16] "oak_log"] [:not-block [16 6 16] "oak_log"] [:item "oak_log" [:>= 1]]]}
  {:name "part-cut-tree-trigger-ignores-standing-trees-alone"
   :register [{:trigger :part-cut-tree}]
   :blocks [[:fill [10 0 12] [23 11 20] "air"]
            [:fill [21 0 16] [21 8 16] "oak_log"] [:fill [19 7 14] [23 9 18] "oak_leaves[persistent=true]"] [:fill [21 7 16] [21 8 16] "oak_log"]
            [:fill [12 0 16] [12 8 16] "oak_log"] [:fill [10 7 14] [14 9 18] "oak_leaves[persistent=true]"] [:fill [12 7 16] [12 8 16] "oak_log"]]
   :expect [{:no-event {:source :reflex :kind :fired :context {:reflex-id :part-cut-tree}} :for-s 45}]
   :after [[:block [21 0 16] "oak_log"] [:block [12 0 16] "oak_log"]]
   :limit-s 55}
  {:name "part-cut-tree-trigger-waits-for-a-cow-lure"
   :register [{:trigger :part-cut-tree}]
   :memory [{:kind :forestry/part-cut :data {:column #at [16 16]} :policy {:cap 20 :ttl :forever}}]
   :body {:inventory [["iron_axe" 1] ["wheat" 4]]}
   :act [[:summon "cow" [13.5 0 21.5]]
         [:job (jobs.animals.lure-to {:worth 1200 :mob "cow" :pos #xyz [12 0 6]})]
         [:rcon "execute at $BODY run fill ~2 ~0 ~-6 ~2 ~9 ~-6 air"]
         [:rcon "execute at $BODY run fill ~2 ~1 ~-6 ~2 ~6 ~-6 oak_log"]
         [:rcon "execute at $BODY run fill ~0 ~5 ~-8 ~4 ~7 ~-4 oak_leaves[persistent=true]"]
         [:rcon "execute at $BODY run fill ~2 ~5 ~-6 ~2 ~6 ~-6 oak_log"]]
   :expect [{:event {:source :job :kind :completed} :within-s 110 :of-job true}
            {:no-event {:source :reflex :kind :fired :context {:reflex-id :part-cut-tree}} :for-s 110 :until {:source :job :kind :completed}}]
   :limit-s 150}
  ;; Card a6143307: a body shut in a closed room at night, a hanging trunk in sight through a glass wall: the night trigger has
  ;; nothing to do and part-cut-tree does not walk the body out (it ping-ponged with the night job at the door, a job per 2 s).
  ;; Needs night (the :night trigger reads the clock): run with --allow-time --time-log <the shared time log>.
  {:name "part-cut-tree-does-not-walk-a-sheltered-body-out-at-night"
   :time :night-exclusive :time-why :dawn-decision
   :register [{:trigger :night}
   :memory [{:kind :forestry/part-cut :data {:column #at [19 22]} :policy {:cap 20 :ttl :forever}}]
              {:trigger :part-cut-tree}]
   :blocks [[:fill [12 0 20] [16 3 24] "stone" :hollow] [:fill [13 0 21] [15 2 23] "air"]
            [:fill [16 1 22] [16 3 22] "glass"]
            [:fill [19 0 22] [19 11 22] "air"] [:fill [17 5 20] [21 8 24] "oak_leaves[persistent=true]"]
            [:fill [19 3 22] [19 5 22] "oak_log"]]
   :body {:at [14.5 0 22.5] :yaw 270 :inventory [["iron_axe" 1]]}
   :expect [{:no-event {:source :reflex :kind :fired :context {:reflex-id :part-cut-tree}} :for-s 60}
            {:no-event {:source :reflex :kind :fired :context {:reflex-id :night}} :for-s 60}]
   :after [[:body-near [14.5 0 22.5] 2.5] [:block [19 3 22] "oak_log"]]
   :limit-s 80}
  ;; Card 24c53a1a: in the dark (here a dark cell, at any hour) the trigger does not hold: a felling walk would leave the night's shelter.
  {:name "part-cut-tree-trigger-waits-in-the-dark"
   :plot {:height 24 :floor "grass_block" :light :dark}
   :register [{:trigger :part-cut-tree}]
   :memory [{:kind :forestry/part-cut :data {:column #at [16 16]} :policy {:cap 20 :ttl :forever}}]
   :blocks [[:fill [16 0 16] [16 9 16] "air"] [:fill [14 6 14] [18 10 18] "air"]
            [:fill [16 1 16] [16 6 16] "oak_log"] [:fill [14 5 14] [18 7 18] "oak_leaves[persistent=true]"] [:fill [16 5 16] [16 6 16] "oak_log"]]
   :expect [{:no-event {:source :reflex :kind :fired :context {:reflex-id :part-cut-tree}} :for-s 30}]
   :after [[:block [16 6 16] "oak_log"]]
   :limit-s 40}
  ;; Card 446e0517: a body in a lit closed room, a replant debt outside in the dark: replant-owed prices the debt's cell, not the
  ;; body's feet, so it does not fire (it refired every 120 s all night while plant-sapling's place child stopped on the dark).
  {:name "replant-owed-waits-for-a-dark-debt-outside-a-lit-room"
   :plot {:height 24 :floor "grass_block" :light :dark}
   :register [{:trigger :replant-owed}]
   :blocks [[:fill [12 0 20] [16 3 24] "stone" :hollow] [:fill [13 0 21] [15 2 23] "air"]
            [:set [14 0 22] "torch"]]
   :memory [{:kind :forestry/replant :data {:pos #xyz [20 0 22] :species "oak"}}]
   :body {:at [14.5 0 22.5] :inventory [["oak_sapling" 1]]}
   :expect [{:no-event {:source :reflex :kind :fired :context {:reflex-id :replant-owed}} :for-s 40}]
   :after [[:not-block [20 0 22] "oak_sapling"]]
   :limit-s 50}
;; Card 6bd1f67e: a standing oak's branch log over air, the trunk cells beside it unseen (here walled in planks; in the
  ;; wild leaves, sparse rays or the branch itself hide them) over the trunk's seen foot: a branch, not a part-cut trunk. The old
  ;; reading joined only seen logs, so the branch's column read as part-cut and the trigger fired.
  {:name "part-cut-tree-trigger-leaves-a-branch-by-a-hidden-trunk"
   :plot {:height 24 :floor "grass_block" :light :lit}
   :register [{:trigger :part-cut-tree}]
   :blocks [[:fill [14 0 14] [18 12 18] "air"] [:fill [16 0 16] [16 10 16] "oak_log"]
            [:fill [15 4 15] [17 7 17] "oak_planks"] [:fill [16 4 16] [16 7 16] "oak_log"] [:set [17 5 17] "air"] [:set [17 6 17] "oak_log"]
            [:fill [14 8 14] [18 11 18] "oak_leaves[persistent=true]"] [:fill [16 8 16] [16 10 16] "oak_log"]]
   :expect [{:no-event {:source :reflex :kind :fired :context {:reflex-id :part-cut-tree}} :for-s 30}]
   :after [[:block [17 6 17] "oak_log"]]
   :limit-s 40}
  ;; Card 6bd1f67e: a trunk cut at its second log, the stump left on the ground and the logs over the gap: the old reading took the
  ;; stump for the base (not over air) and never fired.
  {:name "part-cut-tree-trigger-fells-a-trunk-cut-above-its-stump"
   :register [{:trigger :part-cut-tree}]
   :memory [{:kind :forestry/part-cut :data {:column #at [16 16]} :policy {:cap 20 :ttl :forever}}]
   :blocks [[:fill [16 0 16] [16 9 16] "air"] [:fill [14 6 14] [18 10 18] "air"]
            [:set [16 0 16] "oak_log"] [:fill [16 2 16] [16 6 16] "oak_log"] [:fill [14 5 14] [18 7 18] "oak_leaves[persistent=true]"] [:fill [16 5 16] [16 6 16] "oak_log"]]
   :expect [{:event {:source :reflex :kind :fired :context {:reflex-id :part-cut-tree}} :within-s 40}
            {:event {:source :reflex :kind :ended :context {:reflex-id :part-cut-tree} :data {:kind :done}} :within-s 140}]
   :after [[:not-block [16 0 16] "oak_log"] [:not-block [16 6 16] "oak_log"] [:item "oak_log" [:>= 6]]]}
  ;; Card df85ef66: a column fell-tree gave up on lately (:forestry/tree-unreachable, 10 min) is not a part-cut tree to finish: the trigger does not refire
  ;; on it, and fell-tree :part-cut? does not pick it again. Same trunk as part-cut-tree-trigger-fells-the-hanging-trunk, which fires without the entry.
  {:name "part-cut-tree-trigger-leaves-a-column-fell-tree-gave-up-on"
   :register [{:trigger :part-cut-tree}]
   :memory [{:kind :forestry/part-cut :data {:column #at [16 16]} :policy {:cap 20 :ttl :forever}} {:kind :forestry/tree-unreachable :data {:column #at [16 16]} :policy {:cap 20 :ttl 600000}}]
   :blocks [[:fill [16 0 16] [16 9 16] "air"] [:fill [14 6 14] [18 10 18] "air"]
            [:fill [16 1 16] [16 6 16] "oak_log"] [:fill [14 5 14] [18 7 18] "oak_leaves[persistent=true]"] [:fill [16 5 16] [16 6 16] "oak_log"]]
   :expect [{:no-event {:source :reflex :kind :fired :context {:reflex-id :part-cut-tree}} :for-s 30}]
   :after [[:block [16 6 16] "oak_log"]]
   :limit-s 40}
  ;; The only tree is a column it gave up on: no tree is left to fell, so fell-tree waits :no-tree (a later start, never ends) and digs nothing.
  {:name "fell-tree-part-cut-leaves-a-column-it-gave-up-on-lately"
   :register []
   :memory [{:kind :forestry/part-cut :data {:column #at [16 16]} :policy {:cap 20 :ttl :forever}} {:kind :forestry/tree-unreachable :data {:column #at [16 16]} :policy {:cap 20 :ttl 600000}}]
   :blocks [[:fill [16 0 16] [16 9 16] "air"] [:fill [14 6 14] [18 10 18] "air"]
            [:fill [16 1 16] [16 6 16] "oak_log"] [:fill [14 5 14] [18 7 18] "oak_leaves[persistent=true]"] [:fill [16 5 16] [16 6 16] "oak_log"]]
   :act [[:job (jobs.forestry.fell-tree {:worth 1200 :part-cut? true :radius 24})]]
   :expect [{:event {:source :job :kind :waiting :data {:reason :no-tree}} :within-s 40 :of-job true}
            {:no-event {:source :job :kind #{:stopped :completed}} :of-job true :for-s 20 :until {:source :job :kind :waiting :data {:reason :no-tree}}}]
   :after [[:block [16 6 16] "oak_log"] [:block [16 1 16] "oak_log"]]
   :limit-s 70}
  {:name "part-cut-tree-trigger-leaves-a-whole-tree"
   :register [{:trigger :part-cut-tree}]
   :memory [{:kind :forestry/part-cut :data {:column #at [16 16]} :policy {:cap 20 :ttl :forever}}]
   :blocks [[:fill [16 0 16] [16 9 16] "air"] [:fill [14 6 14] [18 10 18] "air"]
            [:fill [16 0 16] [16 5 16] "oak_log"] [:fill [14 5 14] [18 7 18] "oak_leaves[persistent=true]"] [:fill [16 5 16] [16 5 16] "oak_log"]]
   :expect [{:no-event {:source :reflex :kind :fired :context {:reflex-id :part-cut-tree}} :for-s 30}]
   :after [[:block [16 0 16] "oak_log"]]
   :limit-s 40}
  {:name "part-cut-tree-trigger-leaves-a-trunk-in-another-players-zone"
   :register [{:trigger :part-cut-tree}]
   :memory [{:kind :forestry/part-cut :data {:column #at [16 16]} :policy {:cap 20 :ttl :forever}}]
   :zones [{:name "apiary" :min [15 0 15] :max [17 12 17] :owner "Other" :allow #{}}]
   :blocks [[:fill [16 0 16] [16 9 16] "air"] [:fill [14 6 14] [18 10 18] "air"]
            [:fill [16 1 16] [16 6 16] "oak_log"] [:fill [14 5 14] [18 7 18] "oak_leaves[persistent=true]"] [:fill [16 5 16] [16 6 16] "oak_log"]]
   :expect [{:no-event {:source :reflex :kind :fired :context {:reflex-id :part-cut-tree}} :for-s 30}]
   :after [[:block [16 6 16] "oak_log"]]
   :limit-s 40}
  ;; The trigger is a bounded chore: a trunk far from the remembered home, or a body already carrying a stack of logs, is left.
  {:name "part-cut-tree-trigger-leaves-a-trunk-far-from-home"
   :register [{:trigger :part-cut-tree}]
   :memory [{:kind :forestry/part-cut :data {:column #at [16 16]} :policy {:cap 20 :ttl :forever}} {:kind :home :data {:pos #xyz [300 0 16]}}]
   :blocks [[:fill [16 0 16] [16 9 16] "air"] [:fill [14 6 14] [18 10 18] "air"]
            [:fill [16 1 16] [16 6 16] "oak_log"] [:fill [14 5 14] [18 7 18] "oak_leaves[persistent=true]"] [:fill [16 5 16] [16 6 16] "oak_log"]]
   :expect [{:no-event {:source :reflex :kind :fired :context {:reflex-id :part-cut-tree}} :for-s 30}]
   :after [[:block [16 6 16] "oak_log"]]
   :limit-s 40}
  {:name "part-cut-tree-trigger-leaves-a-trunk-while-a-stack-of-logs-is-carried"
   :register [{:trigger :part-cut-tree}]
   :memory [{:kind :forestry/part-cut :data {:column #at [16 16]} :policy {:cap 20 :ttl :forever}}]
   :body {:inventory [["iron_axe" 1] ["oak_log" 64]]}
   :blocks [[:fill [16 0 16] [16 9 16] "air"] [:fill [14 6 14] [18 10 18] "air"]
            [:fill [16 1 16] [16 6 16] "oak_log"] [:fill [14 5 14] [18 7 18] "oak_leaves[persistent=true]"] [:fill [16 5 16] [16 6 16] "oak_log"]]
   :expect [{:no-event {:source :reflex :kind :fired :context {:reflex-id :part-cut-tree}} :for-s 30}]
   :after [[:block [16 6 16] "oak_log"]]
   :limit-s 40}
  {:name "replant-owed-trigger-plants-the-carried-sapling"
   :register [{:trigger :replant-owed}]
   :memory [{:kind :forestry/replant :data {:pos #xyz [16 0 16] :species "oak"}}]
   :expect [{:event {:source :reflex :kind :ended :context {:reflex-id :replant-owed} :data {:kind :done}} :within-s 90}]
   :after [[:block [16 0 16] "oak_sapling"]]
   :limit-s 100}
  {:name "replant-owed-trigger-plants-the-loaded-debt-past-an-older-far-one"
   :register [{:trigger :replant-owed}]
   :memory [{:kind :forestry/replant :data {:pos #xyz [1000 0 1000] :species "oak"}}
            {:kind :forestry/replant :data {:pos #xyz [16 0 16] :species "oak"}}]
   :expect [{:event {:source :reflex :kind :ended :context {:reflex-id :replant-owed}} :within-s 90}]
   :after [[:block [16 0 16] "oak_sapling"]]
   :limit-s 100}
  {:name "replant-owed-trigger-leaves-a-debt-cell-another-block-fills"
   :register [{:trigger :replant-owed}]
   :memory [{:kind :forestry/replant :data {:pos #xyz [16 0 16] :species "oak"}}]
   :blocks [[:fill [16 0 16] [16 0 16] "furnace"]]
   :expect [{:no-event {:source :reflex :kind :fired :context {:reflex-id :replant-owed}} :for-s 30}]
   :after [[:block [16 0 16] "furnace"]]
   :limit-s 40}
  {:name "replant-owed-trigger-does-not-fetch-a-missing-sapling"
   :register [{:trigger :replant-owed}]
   :memory [{:kind :forestry/replant :data {:pos #xyz [16 0 16] :species "oak"}}]
   :body {:inventory []}
   :expect [{:no-event {:source :reflex :kind :fired :context {:reflex-id :replant-owed}} :for-s 30}]
   :after [[:not-block [16 0 16] "oak_sapling"]]
   :limit-s 40}]}
