;; Cards 5036e6fc and 5224d292: breed, shear, leash and lead-to fetch what they need (wheat, shears, a lead) when the body
;; carries none, instead of ending :no-food / :no-shears / :no-lead at once. The item sits in a chest the body has seen (it
;; looks at the chest first, as in blocks-place-fetch.edn). leash/shear/breed fetch through jobs.lib.fetch (fetch.started,
;; fetch.done, fetch.failed); lead-to calls a jobs.items.obtain child (a seen chest, or a lead crafted from 4 string and a
;; slime ball at a seen table) and ends :no-lead when that fails. :fetch false ends at once without a fetch.
{:defaults
 {:tags [:animals :fetch :jobs]
  :time :any
  :plot {:floor "grass_block" :height 12}
  :body {:at [16.5 0 16.5] :effects [["resistance" 600 4]]}
  :limit-s 120}
 :cases
 [{:name "breed-fetches-wheat"
   :blocks [[:set [14 0 19] "chest{Items:[{Slot:0b,id:\"minecraft:wheat\",count:8}]}"]]
   :act [[:summon "cow" [20.5 0 12.5]] [:summon "cow" [21.5 0 12.5]]
         [:rcon "execute as $BODY at @s run tp @s ~ ~ ~ 0 20"] [:wait-s 2]
         [:job (jobs.animals.breed {:mob "cow" :count 2})]]
   :expect [{:event {:source :job :kind :fetch.started} :within-s 30 :of-job true}
            {:event {:source :job :kind :fetch.done} :within-s 70 :of-job true}
            {:event {:source :job :kind :breed.done :data {:reason :fed}} :within-s 110 :of-job true}]}
  {:name "breed-nothing-fetchable-ends-no-food"
   :act [[:summon "cow" [20.5 0 12.5]] [:summon "cow" [21.5 0 12.5]] [:wait-s 2]
         [:job (jobs.animals.breed {:mob "cow" :count 2})]]
   :expect [{:event {:source :job :kind :fetch.failed} :within-s 60 :of-job true}
            {:event {:source :job :kind :breed.done :data {:reason :no-food}} :within-s 80 :of-job true}]}
  {:name "breed-fetch-false-ends-at-once"
   :blocks [[:set [14 0 19] "chest{Items:[{Slot:0b,id:\"minecraft:wheat\",count:8}]}"]]
   :act [[:summon "cow" [20.5 0 12.5]] [:summon "cow" [21.5 0 12.5]]
         [:rcon "execute as $BODY at @s run tp @s ~ ~ ~ 0 20"] [:wait-s 2]
         [:job (jobs.animals.breed {:mob "cow" :count 2 :fetch false})]]
   :expect [{:event {:source :job :kind :breed.done :data {:reason :no-food}} :within-s 40 :of-job true}
            {:no-event {:source :job :kind :fetch.started} :for-s 30 :until {:source :job :kind :breed.done}}]
   :limit-s 60}
  {:name "shear-fetches-shears"
   :blocks [[:set [14 0 19] "chest{Items:[{Slot:0b,id:\"minecraft:shears\",count:1}]}"]]
   :act [[:summon "sheep" [20.5 0 12.5]]
         [:rcon "execute as $BODY at @s run tp @s ~ ~ ~ 0 20"] [:wait-s 2]
         [:job (jobs.animals.shear {:count 1})]]
   :expect [{:event {:source :job :kind :fetch.started} :within-s 30 :of-job true}
            {:event {:source :job :kind :fetch.done} :within-s 70 :of-job true}
            {:event {:source :job :kind :shear.done :data {:reason :shorn}} :within-s 110 :of-job true}]}
  {:name "shear-nothing-fetchable-ends-no-shears"
   :act [[:summon "sheep" [20.5 0 12.5]] [:wait-s 2]
         [:job (jobs.animals.shear {:count 1})]]
   :expect [{:event {:source :job :kind :fetch.failed} :within-s 60 :of-job true}
            {:event {:source :job :kind :shear.done :data {:reason :no-shears}} :within-s 80 :of-job true}]}
  {:name "shear-fetch-false-ends-at-once"
   :blocks [[:set [14 0 19] "chest{Items:[{Slot:0b,id:\"minecraft:shears\",count:1}]}"]]
   :act [[:summon "sheep" [20.5 0 12.5]]
         [:rcon "execute as $BODY at @s run tp @s ~ ~ ~ 0 20"] [:wait-s 2]
         [:job (jobs.animals.shear {:count 1 :fetch false})]]
   :expect [{:event {:source :job :kind :shear.done :data {:reason :no-shears}} :within-s 40 :of-job true}
            {:no-event {:source :job :kind :fetch.started} :for-s 30 :until {:source :job :kind :shear.done}}]
   :limit-s 60}
  {:name "leash-fetches-a-lead"
   :blocks [[:set [14 0 19] "chest{Items:[{Slot:0b,id:\"minecraft:lead\",count:2}]}"]]
   :act [[:summon "cow" [20.5 0 12.5]]
         [:rcon "execute as $BODY at @s run tp @s ~ ~ ~ 0 20"] [:wait-s 2]
         [:job (jobs.animals.leash {:mob "cow"})]]
   :expect [{:event {:source :job :kind :fetch.started} :within-s 30 :of-job true}
            {:event {:source :job :kind :fetch.done} :within-s 70 :of-job true}
            {:event {:source :job :kind :leash.done :data {:reason :leashed}} :within-s 110 :of-job true}]}
  {:name "leash-nothing-fetchable-ends-no-lead"
   :act [[:summon "cow" [20.5 0 12.5]] [:wait-s 2]
         [:job (jobs.animals.leash {:mob "cow"})]]
   :expect [{:event {:source :job :kind :fetch.failed} :within-s 60 :of-job true}
            {:event {:source :job :kind :leash.done :data {:reason :no-lead}} :within-s 80 :of-job true}]}
  {:name "leash-fetch-false-ends-at-once"
   :blocks [[:set [14 0 19] "chest{Items:[{Slot:0b,id:\"minecraft:lead\",count:2}]}"]]
   :act [[:summon "cow" [20.5 0 12.5]]
         [:rcon "execute as $BODY at @s run tp @s ~ ~ ~ 0 20"] [:wait-s 2]
         [:job (jobs.animals.leash {:mob "cow" :fetch false})]]
   :expect [{:event {:source :job :kind :leash.done :data {:reason :no-lead}} :within-s 40 :of-job true}
            {:no-event {:source :job :kind :fetch.started} :for-s 30 :until {:source :job :kind :leash.done}}]
   :limit-s 60}
  {:name "lead-to-withdraws-a-lead"
   :blocks [[:set [4 0 19] "chest{Items:[{Slot:0b,id:\"minecraft:lead\",count:2}]}"]]
   :body {:at [4.5 0 16.5]}
   :act [[:summon "cow" [6.5 0 18.5]]
         [:rcon "execute as $BODY at @s run tp @s ~ ~ ~ 0 20"] [:wait-s 2]
         [:job (jobs.animals.lead-to {:mob "cow" :pos #xyz [26 0 16]})]]
   :expect [{:event {:source :job :kind :lead-to.done :data {:reason :unleashed :gathered true}} :within-s 170 :of-job true}]
   :after [[:entities "type=cow,tag=wt" [[19 0 9] [31 2 23]] 1]]
   :limit-s 190}
  {:name "lead-to-crafts-a-lead"
   :blocks [[:set [7 0 16] "crafting_table"]]
   :body {:at [4.5 0 16.5] :inventory [["string" 4] ["slime_ball" 1]]}
   :act [[:summon "cow" [6.5 0 18.5]]
         [:rcon "execute as $BODY at @s run tp @s ~ ~ ~ 270 0"] [:wait-s 2]
         [:job (jobs.animals.lead-to {:mob "cow" :pos #xyz [26 0 16]})]]
   :expect [{:event {:source :job :kind :lead-to.done :data {:reason :unleashed :gathered true}} :within-s 170 :of-job true}]
   :after [[:entities "type=cow,tag=wt" [[19 0 9] [31 2 23]] 1]]
   :limit-s 190}
  {:name "lead-to-nothing-to-get-ends-no-lead"
   :body {:at [4.5 0 16.5]}
   :act [[:summon "cow" [6.5 0 18.5]] [:wait-s 2]
         [:job (jobs.animals.lead-to {:mob "cow" :pos #xyz [26 0 16]})]]
   :expect [{:event {:source :job :kind :lead-to.done :data {:reason :no-lead}} :within-s 80 :of-job true}
            {:event {:source :job :kind :lead-to.gave-up :data {:reason :no-lead}} :within-s 80 :of-job true}]
   :limit-s 100}
  {:name "lead-to-no-mob-still-waits"
   :act [[:job (jobs.animals.lead-to {:pos #xyz [26 0 16]})]]
   :expect [{:event {:source :job :kind :waiting :data {:reason :no-mob}} :within-s 30 :of-job true}
            {:no-event {:source :job :kind :lead-to.done} :for-s 20}]
   :limit-s 40}]}
