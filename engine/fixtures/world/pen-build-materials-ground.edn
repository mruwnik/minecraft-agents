;; jobs.build.pen: which fences it uses and where it puts them. Cards 04ac01e3 (an :any want is met by the other wood carried), a9b3a6f8 (fences
;; are crafted from logs it fetches, exploring for more trees), 24cde5af (:fetch false waits for materials), 8c74eba0 (the ring follows rising
;; ground), d943725f (a leaf canopy above the ring is not ground). Ring plan: outline x 10..17, z 10..17 at y 0 (28 cells).
;; The ring has a gate at 13 0 10 (the body builds from inside and leaves by it; without a gate it would end :inside).
;; Should-succeed: ring closed in each case. Should-fail: no fences and :fetch false waits :no-items, nothing placed.
{:defaults
 {:tags [:build :pen :animals]
  :time :any
  :plot {:height 8 :floor "grass_block"}
  :plans [{:id "ring" :surface true :metadata {:by "$body"} :parts [{:id "fence" :outline [#at [10 0 10] #at [17 0 17]] :want [:any "oak_fence" "birch_fence"]}
                                                                  {:id "gate" :cells [#at [13 0 10]] :want [:any "oak_fence_gate" "birch_fence_gate"]}]}]
  :body {:at [13.5 0 13.5] :settle-s 2 :effects [["resistance" 600 4]]}
  :limit-s 150}
 :cases
 [{:name "birch-fences-carried-meet-an-any-want"
   :body {:at [13.5 0 13.5] :settle-s 2 :inventory [["birch_fence" 28] ["birch_fence_gate" 1]] :effects [["resistance" 600 4]]}
   :act [[:job (jobs.build.pen {:plan "$plan:ring" :fetch false})]]
   :expect [{:event {:source :job :kind :completed} :within-s 120 :of-job true}]
   :after [[:block [10 0 10] "birch_fence"] [:block [17 0 14] "birch_fence"]]}
  {:name "no-fences-and-no-fetch-ends-no-items"
   :act [[:job (jobs.build.pen {:plan "$plan:ring" :fetch false})]]
   :expect [{:event {:source :job :kind :waiting :data {:reason :no-items}} :within-s 40 :of-job true}
            {:no-event {:source :job :kind :completed} :for-s 40 :until {:source :job :kind :waiting}}]
   :after [[:not-block [10 0 10] "oak_fence"]]
   :limit-s 60}
  {:name "ring-on-rising-ground-follows-the-surface"
   :body {:at [6.5 0 13.5] :settle-s 2 :inventory [["oak_fence" 40] ["oak_fence_gate" 1]] :effects [["resistance" 600 4]]}
   :blocks [[:fill [14 0 0] [31 0 31] "dirt"]]
   :act [[:job (jobs.build.pen {:plan "$plan:ring" :fetch false})]]
   :expect [{:event {:source :job :kind :completed} :within-s 140 :of-job true}
            {:no-event {:source :job :kind :pen-build.declined} :for-s 140 :until {:source :job :kind :completed}}]
   :after [[:block [10 0 10] "oak_fence"] [:block [17 1 14] "oak_fence"] [:not-block [17 0 14] "oak_fence"]]
   :limit-s 170}
  {:name "leaf-canopy-above-the-ring-is-not-ground"
   :body {:at [6.5 0 13.5] :settle-s 2 :inventory [["oak_fence" 40] ["oak_fence_gate" 1]] :effects [["resistance" 600 4]]}
   :blocks [[:fill [8 4 8] [19 4 19] "oak_leaves[persistent=true]"]]
   :act [[:job (jobs.build.pen {:plan "$plan:ring" :fetch false})]]
   :expect [{:event {:source :job :kind :completed} :within-s 120 :of-job true}]
   :after [[:block [10 0 10] "oak_fence"] [:not-block [10 5 10] "oak_fence"] [:block [17 0 14] "oak_fence"]]}
  {:name "fences-crafted-from-logs-fetched-from-trees"
   :body {:at [6.5 0 13.5] :settle-s 2 :inventory [["oak_log" 6] ["oak_fence_gate" 1]] :effects [["resistance" 600 4]]}
   :blocks [[:fill [4 0 4] [4 4 4] "oak_log"] [:fill [3 4 3] [5 5 5] "oak_leaves[persistent=true]"] [:set [4 4 4] "oak_log"]
            [:fill [4 0 8] [4 4 8] "oak_log"] [:fill [3 4 7] [5 5 9] "oak_leaves[persistent=true]"] [:set [4 4 8] "oak_log"]
            [:fill [4 0 20] [4 4 20] "oak_log"] [:fill [3 4 19] [5 5 21] "oak_leaves[persistent=true]"] [:set [4 4 20] "oak_log"]
            [:fill [4 0 24] [4 4 24] "oak_log"] [:fill [3 4 23] [5 5 25] "oak_leaves[persistent=true]"] [:set [4 4 24] "oak_log"]
            [:fill [24 0 6] [24 4 6] "oak_log"] [:fill [23 4 5] [25 5 7] "oak_leaves[persistent=true]"] [:set [24 4 6] "oak_log"]
            [:fill [24 0 24] [24 4 24] "oak_log"] [:fill [23 4 23] [25 5 25] "oak_leaves[persistent=true]"] [:set [24 4 24] "oak_log"]]
   :act [[:job (jobs.build.pen {:plan "$plan:ring"})]]
   :expect [{:event {:source :job :kind :completed} :within-s 340 :of-job true}
            {:no-event {:source :job :kind :stopped} :for-s 340 :until {:source :job :kind :completed}}]
   :after [[:block [10 0 10] "oak_fence"] [:block [17 0 14] "oak_fence"]]
   :limit-s 380}]}
