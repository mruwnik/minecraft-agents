;; Storage and bag-room cases: cards 8fe09a52 (make-room keeps :keep-blocks of cobblestone, not of dirt), 35ce59b1 (a toss at a
;; tunnel end walks away without a "gave up walking"), 67255d82 (junk the body tossed is not picked up again), fdc3ba90 (a gathering
;; job deposits first when the bag is fullish and a chest is known, and goes on without one), 981c253a (deposit into a full chest
;; places a carried chest beside it; :make-chests? false stops), 44e15ac3 (withdraw's short text names what the chest held),
;; 68095477 (pick-up-loose names the radius when nothing in it is worth taking).
;; Open plot, body at [16.5 0 16.5] looking east (yaw 270); the chest at [20 0 16].
;; Should-succeed: make-room done with cobblestone kept, deposit done into a new chest, trip.deposited before the mine.
;; Should-fail: deposit :make-chests? false into a full chest does not complete, no chest known gives trip.no-chest, withdraw of shears from a feather chest.
{:defaults
 {:tags [:items :storage :make-room :jobs]
  :time :any
  :plot {:height 8}
  :body {:at [16.5 0 16.5] :yaw 270 :settle-s 2 :effects [["resistance" 600 4]]}
  :limit-s 100}
 :cases
 [{:name "make-room-keeps-cobblestone-and-tosses-the-rest"
   :body {:inventory [["cobblestone" 640] ["dirt" 128] ["sand" 64] ["gravel" 64] ["tuff" 64] ["andesite" 64] ["diorite" 64] ["granite" 64] ["netherrack" 64] ["deepslate" 64] ["calcite" 64]]}
   :act [[:job (jobs.storage.make-room {:free 20 :toss-below 5 :keep-blocks 64})]]
   :expect [{:event {:source :job :kind :completed} :within-s 80 :of-job true}]
   :after [[:item "cobblestone" [:>= 64]]]}
  {:name "make-room-at-a-tunnel-end-walks-away-quietly"
   :blocks [[:fill [8 -1 8] [24 5 24] "stone"] [:fill [10 0 16] [16 1 16] "air"]]
   :body {:at [10.5 0 16.5] :inventory [["gravel" 64] ["sand" 64] ["tuff" 64] ["andesite" 64] ["diorite" 64] ["granite" 64] ["cobblestone" 64]]}
   :act [[:job (jobs.storage.make-room {:free 33})]]
   :expect [{:event {:source :job :kind :completed} :within-s 80 :of-job true}
            {:no-event {:source :job :level :warn :message [:contains "gave up walking"]} :for-s 80 :until {:source :job :kind :completed}}]}
  {:name "tossed-junk-is-not-picked-up-again"
   :register [{:trigger :loose-items}]
   :body {:inventory [["gravel" 64] ["sand" 64] ["tuff" 64] ["andesite" 64] ["diorite" 64] ["granite" 64]]}
   :act [[:job (jobs.storage.make-room {:free 33})]]
   :expect [{:event {:source :job :kind :completed} :within-s 60 :of-job true}
            {:no-event {:source :job :kind :loose-items.picked} :for-s 40}]
   :after [[:item "gravel" 0] [:item "sand" 0]]
   :limit-s 80}
  {:name "mine-deposits-first-when-the-bag-is-fullish"
   :blocks [[:set [20 0 12] "chest[facing=west]"] [:fill [22 0 18] [28 2 22] "stone"]]
   :memory [{:kind :chest :data {:pos #xyz [20 0 12]} :policy {:cap 1 :ttl :forever}}]
   :body {:inventory [["stone_pickaxe" 1] ["dirt" 1] ["sand" 1] ["gravel" 1] ["tuff" 1] ["andesite" 1] ["diorite" 1] ["granite" 1] ["netherrack" 1] ["deepslate" 1] ["calcite" 1] ["coarse_dirt" 1] ["red_sand" 1] ["clay_ball" 1] ["flint" 1] ["feather" 1] ["bone" 1] ["string" 1] ["gunpowder" 1] ["rotten_flesh" 1] ["spider_eye" 1] ["leather" 1] ["paper" 1] ["sugar" 1] ["slime_ball" 1] ["ink_sac" 1] ["egg" 1] ["snowball" 1] ["glowstone_dust" 1] ["redstone" 1] ["lapis_lazuli" 1]]}
   :act [[:job (jobs.gather.mine {:block "stone" :count 2 :direction :east :tunnel-length 8 :radius 8})]]
   :expect [{:event {:source :job :kind :trip.deposited} :within-s 60 :of-job true}
            {:event {:source :job :kind #{:completed :stopped}} :within-s 95 :of-job true}]}
  {:name "mine-with-no-chest-known-goes-on"
   :blocks [[:fill [22 0 18] [28 2 22] "stone"]]
   :body {:inventory [["stone_pickaxe" 1] ["dirt" 1] ["sand" 1] ["gravel" 1] ["tuff" 1] ["andesite" 1] ["diorite" 1] ["granite" 1] ["netherrack" 1] ["deepslate" 1] ["calcite" 1] ["coarse_dirt" 1] ["red_sand" 1] ["clay_ball" 1] ["flint" 1] ["feather" 1] ["bone" 1] ["string" 1] ["gunpowder" 1] ["rotten_flesh" 1] ["spider_eye" 1] ["leather" 1] ["paper" 1] ["sugar" 1] ["slime_ball" 1] ["ink_sac" 1] ["egg" 1] ["snowball" 1] ["glowstone_dust" 1] ["redstone" 1] ["lapis_lazuli" 1]]}
   :act [[:job (jobs.gather.mine {:block "stone" :count 2 :direction :east :tunnel-length 8 :radius 8})]]
   :expect [{:event {:source :job :kind :trip.no-chest} :within-s 60 :of-job true}
            {:event {:source :job :kind #{:completed :stopped}} :within-s 95 :of-job true}]}
  {:name "deposit-into-a-full-chest-places-the-carried-chest"
   :blocks [[:set [20 0 16] "chest[facing=west]{Items:[{Slot:0b,id:\"minecraft:stone\",count:64},{Slot:1b,id:\"minecraft:stone\",count:64},{Slot:2b,id:\"minecraft:stone\",count:64},{Slot:3b,id:\"minecraft:stone\",count:64},{Slot:4b,id:\"minecraft:stone\",count:64},{Slot:5b,id:\"minecraft:stone\",count:64},{Slot:6b,id:\"minecraft:stone\",count:64},{Slot:7b,id:\"minecraft:stone\",count:64},{Slot:8b,id:\"minecraft:stone\",count:64},{Slot:9b,id:\"minecraft:stone\",count:64},{Slot:10b,id:\"minecraft:stone\",count:64},{Slot:11b,id:\"minecraft:stone\",count:64},{Slot:12b,id:\"minecraft:stone\",count:64},{Slot:13b,id:\"minecraft:stone\",count:64},{Slot:14b,id:\"minecraft:stone\",count:64},{Slot:15b,id:\"minecraft:stone\",count:64},{Slot:16b,id:\"minecraft:stone\",count:64},{Slot:17b,id:\"minecraft:stone\",count:64},{Slot:18b,id:\"minecraft:stone\",count:64},{Slot:19b,id:\"minecraft:stone\",count:64},{Slot:20b,id:\"minecraft:stone\",count:64},{Slot:21b,id:\"minecraft:stone\",count:64},{Slot:22b,id:\"minecraft:stone\",count:64},{Slot:23b,id:\"minecraft:stone\",count:64},{Slot:24b,id:\"minecraft:stone\",count:64},{Slot:25b,id:\"minecraft:stone\",count:64},{Slot:26b,id:\"minecraft:stone\",count:64}]}"]]
   :memory [{:kind :chest :data {:pos #xyz [20 0 16]} :policy {:cap 1 :ttl :forever}}]
   :body {:inventory [["dirt" 20] ["chest" 1]]}
   :act [[:job (jobs.storage.deposit {:chest #xyz [20 0 16]})]]
   :expect [{:event {:source :job :kind :completed} :within-s 90 :of-job true}]
   :after [[:item "dirt" 0] [:item "chest" 0]]}
  {:name "deposit-make-chests-false-into-a-full-chest-stops"
   :blocks [[:set [20 0 16] "chest[facing=west]{Items:[{Slot:0b,id:\"minecraft:stone\",count:64},{Slot:1b,id:\"minecraft:stone\",count:64},{Slot:2b,id:\"minecraft:stone\",count:64},{Slot:3b,id:\"minecraft:stone\",count:64},{Slot:4b,id:\"minecraft:stone\",count:64},{Slot:5b,id:\"minecraft:stone\",count:64},{Slot:6b,id:\"minecraft:stone\",count:64},{Slot:7b,id:\"minecraft:stone\",count:64},{Slot:8b,id:\"minecraft:stone\",count:64},{Slot:9b,id:\"minecraft:stone\",count:64},{Slot:10b,id:\"minecraft:stone\",count:64},{Slot:11b,id:\"minecraft:stone\",count:64},{Slot:12b,id:\"minecraft:stone\",count:64},{Slot:13b,id:\"minecraft:stone\",count:64},{Slot:14b,id:\"minecraft:stone\",count:64},{Slot:15b,id:\"minecraft:stone\",count:64},{Slot:16b,id:\"minecraft:stone\",count:64},{Slot:17b,id:\"minecraft:stone\",count:64},{Slot:18b,id:\"minecraft:stone\",count:64},{Slot:19b,id:\"minecraft:stone\",count:64},{Slot:20b,id:\"minecraft:stone\",count:64},{Slot:21b,id:\"minecraft:stone\",count:64},{Slot:22b,id:\"minecraft:stone\",count:64},{Slot:23b,id:\"minecraft:stone\",count:64},{Slot:24b,id:\"minecraft:stone\",count:64},{Slot:25b,id:\"minecraft:stone\",count:64},{Slot:26b,id:\"minecraft:stone\",count:64}]}"]]
   :memory [{:kind :chest :data {:pos #xyz [20 0 16]} :policy {:cap 1 :ttl :forever}}]
   :body {:inventory [["dirt" 20] ["chest" 1]]}
   :act [[:job (jobs.storage.deposit {:chest #xyz [20 0 16] :make-chests? false})]]
   :expect [{:event {:source :job :kind :stopped} :within-s 60 :of-job true}
            {:no-event {:source :job :kind :completed} :for-s 20 :until {:source :job :kind :stopped}}]
   :after [[:item "dirt" 20] [:item "chest" 1]]
   :limit-s 80}
  {:name "withdraw-short-names-what-the-chest-held"
   :blocks [[:set [20 0 16] "chest[facing=west]{Items:[{Slot:0b,id:\"minecraft:feather\",count:3}]}"]]
   :act [[:job (jobs.storage.withdraw {:chest #xyz [20 0 16] :items {"shears" 1}})]]
   :expect [{:event {:source :job :kind :withdraw.short :message [:contains "feather"]} :within-s 40 :of-job true}]
   :after [[:item "shears" 0]]
   :limit-s 60}
  {:name "pick-up-loose-out-of-radius-names-the-radius"
   :act [[:summon "item" [16.5 0 28.5] "{Item:{id:\"minecraft:wheat_seeds\",count:16}}"]
         [:job (jobs.items.pick-up-loose {:radius 8})]]
   :expect [{:event {:source :job :kind :waiting :data {:reason :nothing-worth-it} :message [:contains "radius"]} :within-s 30 :of-job true}]
   :after [[:item "wheat_seeds" 0]]
   :limit-s 50}
  ;; card 911d6b54: sealed in a 1x2 pocket the tossed junk lies at the feet and is picked up at once; the trigger rests, no toss loop
  {:name "sealed-in-nearly-full-bag-tosses-once-not-in-a-loop"
   :register [{:trigger :inventory-nearly-full}]
   :blocks [[:fill [14 -1 14] [18 3 18] "stone"] [:fill [16 0 16] [16 1 16] "air"]]
   :body {:at [16.5 0 16.5] :inventory [["gravel" 320] ["sand" 1] ["tuff" 1] ["andesite" 1] ["diorite" 1] ["granite" 1] ["netherrack" 1] ["deepslate" 1] ["calcite" 1] ["coarse_dirt" 1] ["red_sand" 1] ["clay_ball" 1] ["flint" 1] ["feather" 1] ["bone" 1] ["string" 1] ["gunpowder" 1] ["rotten_flesh" 1] ["spider_eye" 1] ["leather" 1] ["paper" 1] ["sugar" 1] ["slime_ball" 1] ["ink_sac" 1] ["egg" 1] ["snowball" 1] ["glowstone_dust" 1] ["redstone" 1] ["lapis_lazuli" 1] ["dirt" 1]]}
   :expect [{:count-event {:source :reflex :kind :ended :context {:reflex-id :inventory-nearly-full} :data {:outcome :done}} :for-s 70 :at-least 1 :at-most 1}]
   :limit-s 90}
  ;; card 558b7b4b: a trip's deposit keeps ores and metal: the raw iron and coal stay in the bag, the junk goes into the chest
  {:name "mine-trip-deposit-keeps-the-iron-and-coal"
   :blocks [[:set [20 0 12] "chest[facing=west]"] [:fill [22 0 18] [28 2 22] "stone"]]
   :memory [{:kind :chest :data {:pos #xyz [20 0 12]} :policy {:cap 1 :ttl :forever}}]
   :body {:inventory [["stone_pickaxe" 1] ["raw_iron" 5] ["coal" 3] ["dirt" 1] ["sand" 1] ["gravel" 1] ["tuff" 1] ["andesite" 1] ["diorite" 1] ["granite" 1] ["netherrack" 1] ["deepslate" 1] ["calcite" 1] ["coarse_dirt" 1] ["red_sand" 1] ["clay_ball" 1] ["flint" 1] ["feather" 1] ["bone" 1] ["string" 1] ["gunpowder" 1] ["rotten_flesh" 1] ["spider_eye" 1] ["leather" 1] ["paper" 1] ["sugar" 1] ["slime_ball" 1] ["ink_sac" 1] ["egg" 1] ["snowball" 1] ["glowstone_dust" 1]]}
   :act [[:job (jobs.gather.mine {:block "stone" :count 2 :direction :east :tunnel-length 8 :radius 8})]]
   :expect [{:event {:source :job :kind :trip.deposited :data {:free [:>= 5]}} :within-s 60 :of-job true}
            {:event {:source :job :kind #{:completed :stopped}} :within-s 95 :of-job true}]
   :after [[:item "raw_iron" 5] [:item "coal" 3]]}]}
