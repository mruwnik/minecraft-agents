;; Card 4da7f458: a drop on top of a 6-high cobblestone column on lit floor is looked up at, climbed to (go-to :pillar/:stair) and collected.
;; Should-succeed: the diamond is collected.
{:defaults
 {:tags [:forestry :collect-drops :jobs] :time :any
  :plot {:height 14}
  :body {:at [16.5 0 16.5] :inventory [["cobblestone" 16] ["stone_pickaxe" 1]] :effects [["resistance" 600 4]]}
  :limit-s 150}
 :cases
 [{:name "drop-on-column-top-is-climbed-to"
   :blocks [[:fill [19 0 16] [19 5 16] "cobblestone"] [:set [18 8 16] "glowstone"]]
   :act [[:summon "item" [19.5 6 16.5] "{Item:{id:\"minecraft:diamond\",count:1}}"]
         [:job (jobs.items.collect-drops {:radius 10 :near #at [19 6 16] :dig true})]]
   :expect [{:event {:source :job :kind :completed :data {:status :completed}} :within-s 120 :of-job true}]
   :after [[:item "diamond" 1]]}]}
