;; jobs.survival.enter-room with no :place and no remembered home (cards 06559aeb, 7a442197): it walks to the nearest closed room behind a door it has seen
;; and shuts the door. Hut: planks x 12..18, z 12..18, y 0..3 (hollow), room 13..17, open oak door at [15 0..1 18]; body 2 south of it looking north.
;; Should-succeed: the open door is walked to, the body ends inside and the door is shut.
;; Should-succeed 2: a hut inside a glass ring 3 blocks off beats a hut 50 blocks round (go-to's quote with its digging ways prices both): the body digs in, door shut on A, B's door at [65 0 14] still open. Old code quoted walking only: A had no walk, so B was walked to.
;; Should-fail: the same hut with a cell of another's plan inside it (a bed spot beside the door) is not walked into (a fill there would trespass): no-room, the body stays outside.
{:defaults
 {:tags [:night :survival]
  :time :any
  :plot {:floor "grass_block"}
  :blocks [[:fill [12 0 12] [18 3 18] "oak_planks" :hollow]
           [:fill [13 0 13] [17 2 17] "air"]
           [:fill [15 0 18] [15 1 18] "air"]
           [:set [15 0 18] "oak_door[facing=south,half=lower,hinge=left,open=true]"]
           [:set [15 1 18] "oak_door[facing=south,half=upper,hinge=left,open=true]"]]
  :body {:at [15.5 0 20.5] :yaw 180 :effects [["resistance" 600 4]] :settle-s 3}
  :limit-s 90}
 :cases
 [{:name "nearest-seen-closed-room-is-entered-and-its-door-shut"
   :act [[:job (jobs.survival.enter-room)]]
   :expect [{:event {:source :job :kind :completed :data {:name "jobs.survival.enter-room"}} :within-s 70 :of-job true}]
   :after [[:block [15 0 18] "oak_door[half=lower,open=false]"] [:body-near [15.5 0 15.5] 2.5]]}
  {:name "a-room-in-anothers-plan-is-not-entered"
   :plans [{:id "hut" :metadata {:by "Miles"} :parts [{:id "wall" :cells [#at [12 0 12] #at [13 0 12] #at [14 0 12]] :want [:any "oak_planks"]}
                                                       {:id "door" :cells [#at [15 0 18]] :want [:any "oak_door"]}
                                                       {:id "bed" :cells [#at [15 0 17]] :want [:any "red_bed"]}]}]
   :act [[:job (jobs.survival.enter-room)]]
   :expect [{:event {:source :job :kind :waiting :data {:reason :no-room}} :within-s 40 :of-job true}]
   :after [[:body-far [15.5 0 15.5] 5] [:block [15 0 18] "oak_door[half=lower,open=true]"]]
   :limit-s 60}
  {:name "the-room-behind-glass-ring-is-dug-to-not-the-one-far-around"
   :plot {:floor "grass_block" :length 80 :width 48}
   :body {:at [15.5 0 24.5] :yaw 180 :effects [["resistance" 600 4]] :settle-s 3}
   :blocks [[:fill [12 0 12] [18 3 18] "oak_planks" :hollow]
            [:fill [13 0 13] [17 2 17] "air"]
            [:fill [15 0 18] [15 1 18] "air"]
            [:set [15 0 18] "oak_door[facing=south,half=lower,hinge=left,open=true]"]
            [:set [15 1 18] "oak_door[facing=south,half=upper,hinge=left,open=true]"]
            [:fill [10 0 10] [20 3 10] "glass"]
            [:fill [10 0 21] [20 3 21] "glass"]
            [:fill [10 0 10] [10 3 21] "glass"]
            [:fill [20 0 10] [20 3 21] "glass"]
            [:fill [10 4 10] [20 4 21] "glass"]
            [:fill [62 0 8] [68 3 14] "oak_planks" :hollow]
            [:fill [63 0 9] [67 2 13] "air"]
            [:fill [65 0 14] [65 1 14] "air"]
            [:set [65 0 14] "oak_door[facing=south,half=lower,hinge=left,open=true]"]
            [:set [65 1 14] "oak_door[facing=south,half=upper,hinge=left,open=true]"]]
   :act [[:job (jobs.survival.enter-room)]]
   :expect [{:event {:source :job :kind :completed :data {:name "jobs.survival.enter-room"}} :within-s 70 :of-job true}]
   :after [[:block [15 0 18] "oak_door[half=lower,open=false]"] [:body-near [15.5 0 15.5] 2.5] [:block [65 0 14] "oak_door[half=lower,open=true]"]]}]}
