;; Card 233e81bd: a librarian training row is the blueprints training-row-start, training-cell repeated n times
;; ({:repeat {:n n :step [2 0 0]}}, walls shared) and training-row-end, built by build.from-plan; village.roll then rolls a
;; cell from the corridor (the roll case stands the n = 1 row by hand, as the blueprints place it). Row floor = the plot floor (y -1, grass counts as the dirt choice of the wall want), corridor
;; z 12 at y 0..1 entered from the west at x 10, lecterns at [12 0 11] and [14 0 11], roof y 2.
;; The last case digs the row out of a stone mass instead (the Leo row was dug into rock).
;; training-cell-roll-keeps-the-lectern-over-ten-breaks: ten breaks of the Leo cell with only the one lectern (:ways #{:carried}); a drop that
;; slides into the villager's cell is out of reach from the corridor and the back passage, and is taken crouched in the emptied lectern cell.
;; training-cell-roll-ends-no-job-when-the-villager-takes-none: a villager without AI never claims the lectern: one more break, then no-job.
;; training-cell-roll-cut-while-crouched-in-the-cell-lets-the-body-out: the roll is cut while the body is crouched in the emptied cell (it must stay crouched under the slab); a go-to then walks it out.
;; Should-succeed: every case.
{:defaults
 {:tags [:build :village] :time :day :time-why :villager-schedule
  :plot {:height 12}
  :limit-s 900
  :body {:at [5.5 0 12.5] :yaw -90 :settle-s 3 :effects [["resistance" 900 4]]
         :inventory [["iron_pickaxe" 2] ["torch" 16] ["cobblestone" 192] ["lectern" 2] ["oak_slab" 2] ["oak_fence_gate" 1]]}}
 :cases
 [{:name "training-row-of-two-cells-is-built"
   :plans [{:id "row" :metadata {:by "$body"}
            :parts [{:id "start" :blueprint "training-row-start" :at #at [10 -1 6]}
                    {:id "cell" :blueprint "training-cell" :at #at [11 -1 6] :repeat {:n 2 :step [2 0 0]}}
                    {:id "end" :blueprint "training-row-end" :at #at [16 -1 6]}]}]
   :act [[:job (jobs.build.from-plan {:plan "$plan:row"})]]
   :expect [{:event {:source :job :kind :completed :data {:kind :done}} :within-s 800 :of-job true}]
   :after [[:block [12 0 11] "lectern"] [:block [14 0 11] "lectern"] [:block [12 1 11] "oak_slab"] [:block [14 1 11] "oak_slab"]
           [:block [12 0 10] "air"] [:block [12 1 10] "air"] [:block [12 1 9] "air"] [:block [12 0 9] "cobblestone"]
           [:block [13 0 10] "cobblestone"] [:block [12 2 10] "cobblestone"] [:block [13 0 7] "air"] [:block [13 0 8] "air"]
           [:block [16 0 10] "oak_fence_gate"] [:block [16 0 12] "air"] [:block [10 0 7] "cobblestone"] [:block [17 0 12] "cobblestone"]]}
  {:name "villager-in-a-training-cell-is-rolled-from-the-corridor"
   :blocks [[:fill [10 0 6] [15 2 13] "cobblestone"] [:fill [10 0 12] [14 1 12] "air"] [:fill [11 0 7] [14 1 8] "air"]
            [:set [12 1 9] "air"] [:fill [14 0 9] [14 1 9] "air"] [:fill [12 0 10] [12 1 10] "air"]
            [:set [14 0 10] "oak_fence_gate[facing=south]"] [:set [14 1 10] "air"] [:fill [14 0 11] [14 1 11] "air"]
            [:set [12 0 11] "lectern"] [:set [12 1 11] "oak_slab[type=top]"]]
   :body {:at [12.5 0 12.5] :yaw 0}
   :act [[:summon "villager" [12.5 0 10.5] "{UUID:[I;20261,1,3,1],VillagerData:{profession:\"minecraft:librarian\",level:1,type:\"minecraft:plains\"}}"]
         [:wait-s 2]
         [:job (jobs.village.roll {:villager "00004f25-0000-0001-0000-000300000001" :pos #at [12 0 11] :profession "librarian" :want "netherite_ingot" :settings {:jobs.village.roll/max-rolls 2}})]]
   :expect [{:event {:source :job :kind :roll.offers} :within-s 60 :of-job true}
            {:event {:source :job :kind :stopped :data {:reason :no-match}} :within-s 200 :of-job true}]
   :after [[:block [12 0 11] "lectern"] [:block [12 1 11] "oak_slab"]]}
  {:name "training-cell-roll-keeps-the-lectern-over-ten-breaks"
   :blocks [[:fill [10 0 10] [15 2 16] "cobblestone"] [:fill [10 0 15] [14 1 15] "air"] [:fill [11 0 11] [14 1 11] "air"]
            [:set [12 1 12] "air"] [:fill [14 0 12] [14 1 12] "air"] [:fill [12 0 13] [12 1 13] "air"]
            [:set [14 0 13] "oak_fence_gate[facing=south]"] [:set [14 1 13] "air"] [:fill [14 0 14] [14 1 14] "air"]
            [:set [12 0 14] "lectern"] [:set [12 1 14] "oak_slab[type=top]"]]
   :body {:at [12.5 0 15.5] :yaw 0 :inventory [["iron_pickaxe" 1]]}
   :limit-s 600
   :act [[:summon "villager" [12.5 0 13.5] "{UUID:[I;20261,1,3,2],VillagerData:{profession:\"minecraft:librarian\",level:1,type:\"minecraft:plains\"}}"]
         [:wait-s 2]
         [:job (jobs.village.roll {:villager "00004f25-0000-0001-0000-000300000002" :pos #at [12 0 14] :profession "librarian" :want "netherite_ingot" :ways #{:carried} :settings {:jobs.village.roll/max-rolls 10}})]]
   :expect [{:event {:source :job :kind :stopped :data {:reason :no-match}} :within-s 560 :of-job true}]
   :after [[:block [12 0 14] "lectern"] [:block [12 1 14] "oak_slab"] [:entities "type=villager" [[12 0 13] [12 2 13]] 1]]}
  {:name "training-cell-roll-ends-no-job-when-the-villager-takes-none"
   :blocks [[:fill [10 0 10] [15 2 16] "cobblestone"] [:fill [10 0 15] [14 1 15] "air"] [:fill [11 0 11] [14 1 11] "air"]
            [:set [12 1 12] "air"] [:fill [14 0 12] [14 1 12] "air"] [:fill [12 0 13] [12 1 13] "air"]
            [:set [14 0 13] "oak_fence_gate[facing=south]"] [:set [14 1 13] "air"] [:fill [14 0 14] [14 1 14] "air"]
            [:set [12 0 14] "lectern"] [:set [12 1 14] "oak_slab[type=top]"]]
   :body {:at [12.5 0 15.5] :yaw 0 :inventory [["iron_pickaxe" 1]]}
   :limit-s 300
   :act [[:summon "villager" [12.5 0 13.5] "{NoAI:1b,UUID:[I;20261,1,3,4],VillagerData:{profession:\"minecraft:none\",level:1,type:\"minecraft:plains\"}}"]
         [:wait-s 2]
         [:job (jobs.village.roll {:villager "00004f25-0000-0001-0000-000300000004" :pos #at [12 0 14] :profession "librarian" :want "netherite_ingot" :ways #{:carried} :settings {:jobs.village.roll/take-job-s 20}})]]
   :expect [{:event {:source :job :kind :stopped :data {:reason :no-job}} :within-s 240 :of-job true}]
   :after [[:block [12 0 14] "lectern"] [:block [12 1 14] "oak_slab"]]}
  {:name "training-cell-roll-cut-while-crouched-in-the-cell-lets-the-body-out"
   :blocks [[:fill [10 0 10] [15 2 16] "cobblestone"] [:fill [10 0 15] [14 1 15] "air"] [:fill [11 0 11] [14 1 11] "air"]
            [:set [12 1 12] "air"] [:fill [14 0 12] [14 1 12] "air"] [:fill [12 0 13] [12 1 13] "air"]
            [:set [14 0 13] "oak_fence_gate[facing=south]"] [:set [14 1 13] "air"] [:fill [14 0 14] [14 1 14] "air"]
            [:set [12 0 14] "lectern"] [:set [12 1 14] "oak_slab[type=top]"]]
   :body {:at [12.5 0 15.5] :yaw 0 :inventory [["iron_pickaxe" 1]]}
   :limit-s 700
   :act [[:summon "villager" [12.5 0 13.5] "{UUID:[I;20261,1,3,3],VillagerData:{profession:\"minecraft:librarian\",level:1,type:\"minecraft:plains\"}}"]
         [:wait-s 2]
         [:job (jobs.village.roll {:villager "00004f25-0000-0001-0000-000300000003" :pos #at [12 0 14] :profession "librarian" :want "netherite_ingot" :ways #{:carried} :settings {:jobs.village.roll/max-rolls 10}})]
         [:await {:source :job :kind :roll.crouch-in :of-job true} 600]
         [:http :cancel "$job" {:ok true}]
         [:wait-s 2]
         [:job (jobs.movement.go-to {:pos #at [12.5 0 15.5] :range 1})]]
   :expect [{:event {:source :job :kind :completed :data {:kind :done}} :within-s 650 :of-job true}]}
  {:name "training-row-is-dug-out-of-rock"
   :blocks [[:fill [9 0 4] [20 4 15] "stone"] [:fill [9 1 12] [9 2 12] "air"] [:set [8 0 12] "stone"]]
   :body {:at [8.5 1 12.5]}
   :plans [{:id "row" :metadata {:by "$body"}
            :parts [{:id "start" :blueprint "training-row-start" :at #at [10 0 6]}
                    {:id "cell" :blueprint "training-cell" :at #at [11 0 6] :repeat {:n 2 :step [2 0 0]}}
                    {:id "end" :blueprint "training-row-end" :at #at [16 0 6]}]}]
   :act [[:job (jobs.build.from-plan {:plan "$plan:row"})]]
   :expect [{:event {:source :job :kind :completed :data {:kind :done}} :within-s 800 :of-job true}]
   :after [[:block [12 1 11] "lectern"] [:block [14 1 11] "lectern"] [:block [12 2 11] "oak_slab"] [:block [14 2 11] "oak_slab"]
           [:block [12 1 10] "air"] [:block [12 2 10] "air"] [:block [12 2 9] "air"] [:not-block [12 1 9] "air"]
           [:not-block [13 1 10] "air"] [:block [13 1 7] "air"] [:block [13 1 8] "air"] [:block [16 1 10] "oak_fence_gate"] [:block [16 1 12] "air"]
           [:not-block [10 1 7] "air"] [:not-block [17 1 12] "air"] [:not-block [14 3 6] "air"]]}
  {:name "training-row-tunnel-keeps-a-cell-already-built"
   :blocks [[:fill [9 0 4] [20 4 15] "stone"] [:fill [9 1 12] [9 2 12] "air"] [:set [8 0 12] "stone"] [:set [12 1 11] "lectern"] [:set [12 2 11] "oak_slab[type=top]"]]
   :body {:at [8.5 1 12.5]}
   :plans [{:id "row" :metadata {:by "$body"}
            :parts [{:id "start" :blueprint "training-row-start" :at #at [10 0 6]}
                    {:id "cell" :blueprint "training-cell" :at #at [11 0 6] :repeat {:n 2 :step [2 0 0]}}
                    {:id "end" :blueprint "training-row-end" :at #at [16 0 6]}]}]
   :act [[:job (jobs.build.from-plan {:plan "$plan:row"})]]
   :expect [{:event {:source :job :kind :tunnel.plan} :within-s 800 :of-job true}
            {:no-event {:source :job :kind :stalled} :of-job true :for-s 800 :until {:source :job :kind #{:completed :stopped}}}]
   :after [[:block [12 1 11] "lectern"] [:block [12 2 11] "oak_slab"] [:block [14 1 11] "lectern"] [:block [14 2 11] "oak_slab"]
           [:block [12 1 10] "air"] [:block [12 2 10] "air"] [:block [12 2 9] "air"] [:not-block [12 1 9] "air"]
           [:not-block [13 1 10] "air"] [:block [13 1 7] "air"] [:block [13 1 8] "air"] [:block [16 1 10] "oak_fence_gate"] [:block [16 1 12] "air"]
           [:not-block [10 1 7] "air"] [:not-block [17 1 12] "air"] [:not-block [14 3 6] "air"]]}]}
