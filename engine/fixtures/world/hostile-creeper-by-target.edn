;; Card ce634b35 (Bramble #39): the hostile reflex fought a skeleton 10 blocks off with a creeper standing by it, beyond
;; the 8-block melee radius; the fight walked into the blast (17). A creeper within swell-range of the mob the fight would
;; walk to makes the answer a flight, named after the creeper (a creeper is silent: it is summoned first, where the body
;; faces, so it is seen when the skeleton comes). Both mobs are NoAI (no shots, no blast), the skeleton helmeted.
;; Sealed stone box x 2..28, y 0..4, z 10..22, lit by a sea lantern floor.
{:defaults
 {:tags [:hostile :survival :combat]
  :time :any
  :register [{:trigger :hostile-near}]
  :blocks [[:fill [1 -1 9] [29 5 23] "stone" :hollow] [:fill [2 -1 10] [28 -1 22] "sea_lantern"]]
  :body {:spawnpoint :far :at [5.5 0 16.5] :yaw 270 :inventory [["iron_sword" 1]]}}
 :cases
 [{:name "a-skeleton-with-a-creeper-beside-it-is-fled-not-fought"
   :act [[:summon "creeper" [16.5 0 18.5] "{NoAI:1b}"] [:wait-s 3]
         [:summon "skeleton" [15.5 0 16.5] "{NoAI:1b,equipment:{mainhand:{id:\"minecraft:bow\",count:1},head:{id:\"minecraft:iron_helmet\",count:1}}}"]]
   :expect [{:event {:source :job :kind :hostile.decided :data {:decision :flee :mob "creeper"}} :within-s 20}
            {:no-event {:source :job :kind :hostile.decided :data {:decision :fight}} :for-s 20}]
   :limit-s 40}
  ;; Card a45ce0db: a creeper 3 off by a zombie 4 off, the zombie fought there takes the blast (~15 at 1.4 blocks) and its blows
  ;; land on what the blast leaves: fled, not fought (one Poisson count of blast-sized blows priced the fight at ~0.36 death).
  ;; Both are there before the reflex is registered (a lone creeper is fought hit-and-back, a zombie alone fought, and one decision
  ;; is taken per encounter), and the body stands mid-room: against the west wall every way was shut and the answer was the cornered step.
  {:name "a-zombie-with-a-creeper-beside-it-close-by-is-fled-not-fought"
   :register []
   :body {:at [14.5 0 16.5] :yaw 270 :inventory [["iron_sword" 1]]}
   :act [[:summon "zombie" [18.5 0 16.5] "{NoAI:1b,equipment:{head:{id:\"minecraft:iron_helmet\",count:1}}}"]
         [:summon "creeper" [17.5 0 17.5] "{NoAI:1b}"]
         [:cli "triggers" ["$body" "--world" "$world" "put" "hostile-near" "--trigger" "hostile-near" "--by" "world-test"]]]
   :expect [{:event {:source :job :kind :hostile.decided :data {:decision :flee}} :within-s 20}
            {:no-event {:source :job :kind :hostile.decided :data {:decision :fight}} :for-s 20}]
   :limit-s 40}
  ;; Card 6c727565: the zombie (100 health, so it outlasts the creeper's arrival) is fought first; the creeper comes 2 s after the reflex starts and the next call weighs it: fled, named after it.
  {:name "a-creeper-that-joins-a-zombie-fight-is-fled"
   :register []
   :body {:at [14.5 0 16.5] :yaw 270 :inventory [["iron_sword" 1]]}
   :act [[:summon "zombie" [18.5 0 16.5] "{NoAI:1b,Health:100f,attributes:[{id:\"minecraft:max_health\",base:100}],equipment:{head:{id:\"minecraft:iron_helmet\",count:1}}}"]
         [:cli "triggers" ["$body" "--world" "$world" "put" "hostile-near" "--trigger" "hostile-near" "--by" "world-test"]]
         [:wait-s 2]
         [:summon "creeper" [12.5 0 17.5] "{NoAI:1b}"]]
   :expect [{:event {:source :job :kind :hostile.decided :data {:decision :fight :mob "zombie"}} :within-s 20}
            {:event {:source :job :kind :hostile.decided :data {:decision :flee :mob "creeper"}} :within-s 30}]
   :limit-s 50}
  ;; Card 6c727565 (Brindle S20): a creeper that lights its fuse beside a running zombie fight is stepped away from at once, not left to
  ;; blow during a swing gap nor first weighed by the parent (that re-weigh outlasts the 1.5 s fuse): no flight is decided and the blast
  ;; (about 20 at 2 blocks, about 3 at 5) leaves the body above 10. The creeper is NoAI and ignited, 2 blocks north; south is open.
  {:name "a-creeper-lighting-its-fuse-by-a-zombie-fight-is-stepped-away-from"
   :register []
   :body {:at [14.5 0 16.5] :yaw 270 :inventory [["iron_sword" 1]]}
   :act [[:summon "zombie" [16.5 0 16.5] "{NoAI:1b,Health:100f,attributes:[{id:\"minecraft:max_health\",base:100}],equipment:{head:{id:\"minecraft:iron_helmet\",count:1}}}"]
         [:cli "triggers" ["$body" "--world" "$world" "put" "hostile-near" "--trigger" "hostile-near" "--by" "world-test"]]
         [:wait-s 5]
         [:summon "creeper" [14.5 0 14.5] "{NoAI:1b,ignited:1b}"]]
   :expect [{:event {:source :job :kind :hostile.decided :data {:decision :fight :mob "zombie"}} :within-s 20}
            {:no-event {:source :job :kind :hostile.decided :data {:decision :flee}} :for-s 15}
            {:no-event {:source :body :kind :hurt :data {:health [:<= 10]}} :for-s 15}]
   :limit-s 40}
  ;; Card fc7d2edb: a lone creeper 6 off at 7 hp with a sword: the flight is caught at the creepers' own measured chance (about 1 in 3)
  ;; and a catch's blast is a measured one, so it is fled (priced 1516 against the fight's 524 when it borrowed the zombies' counts).
  {:name "a-lone-creeper-six-off-at-7-hp-is-fled"
   :body {:at [10.5 0 16.5] :yaw 270 :inventory [["iron_sword" 1]] :effects [["hunger" 120 255]]}
   :act [[:rcon "damage $BODY 13 minecraft:generic"]
         [:summon "creeper" [16.5 0 16.5] "{NoAI:1b}"]]
   :expect [{:event {:source :job :kind :hostile.decided :data {:decision :flee :mob "creeper"}} :within-s 20}
            {:no-event {:source :job :kind :hostile.decided :data {:decision :fight}} :for-s 10}]
   :limit-s 40}
  {:name "a-lone-skeleton-is-fought"
   :act [[:summon "skeleton" [15.5 0 16.5] "{NoAI:1b,equipment:{mainhand:{id:\"minecraft:bow\",count:1},head:{id:\"minecraft:iron_helmet\",count:1}}}"]]
   :expect [{:event {:source :job :kind :hostile.decided :data {:decision :fight :mob "skeleton"}} :within-s 20}]
   :limit-s 40}]}
