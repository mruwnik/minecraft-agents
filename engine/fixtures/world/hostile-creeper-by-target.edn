;; Card ce634b35 (Bramble #39): the hostile reflex fought a skeleton 10 blocks off with a creeper standing by it, beyond
;; the 8-block melee radius; the fight walked into the blast (17). A creeper within swell-range of the mob the fight would
;; walk to makes the answer a flight, named after the creeper (a creeper is silent: it is summoned first, where the body
;; faces, so it is seen when the skeleton comes). Both mobs are NoAI (no shots, no blast), the skeleton helmeted.
;; Sealed stone box x 2..28, y 0..4, z 10..22, lit by a sea lantern floor.
{:defaults
 {:tags [:hostile :survival :combat]
  :time :any
  :register [{:trigger :hostile-near :args {:radius 8 :ranged-radius 16}
              :job (jobs.survival.respond-to-hostile)}]
  :blocks [[:fill [1 -1 9] [29 5 23] "stone" :hollow] [:fill [2 -1 10] [28 -1 22] "sea_lantern"]]
  :body {:at [5.5 0 16.5] :yaw 270 :inventory [["iron_sword" 1]]}}
 :cases
 [{:name "a-skeleton-with-a-creeper-beside-it-is-fled-not-fought"
   :act [[:summon "creeper" [16.5 0 18.5] "{NoAI:1b}"] [:wait-s 3]
         [:summon "skeleton" [15.5 0 16.5] "{NoAI:1b,equipment:{head:{id:\"minecraft:iron_helmet\",count:1}}}"]]
   :expect [{:event {:source :job :kind :hostile.decided :data {:decision :flee :mob "creeper"}} :within-s 20}
            {:no-event {:source :job :kind :hostile.decided :data {:decision :fight}} :for-s 20}]
   :limit-s 40}
  {:name "a-lone-skeleton-is-fought"
   :act [[:summon "skeleton" [15.5 0 16.5] "{NoAI:1b,equipment:{head:{id:\"minecraft:iron_helmet\",count:1}}}"]]
   :expect [{:event {:source :job :kind :hostile.decided :data {:decision :fight :mob "skeleton"}} :within-s 20}]
   :limit-s 40}]}
