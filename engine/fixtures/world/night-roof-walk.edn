;; Cards dcedd0f5, a9ae340d: at night a body without a bed walks to a close remembered roofed place (:roofed-places [:home])
;; when go-to's planned route (a cell seen dark or unseen at night costs twice a lit one) is no dearer than the walls' quote (the :room way of survival.shut-in, survival.enter-room),
;; else it digs in where it stands (dig-in.sealed; cobblestone carried). Open ground (64x32 plot,
;; body at x 4.5, z 16.5); home = a stone hut (5x5, hollow, an open oak door in its west wall the job shuts) or, in the open-roof case, a bare stone slab at y 2 over 3x3 cells (roofed within the default roof height 4), torches beside the line at z 15, the first 13+ cells from the body: a torch lights 13 cells, and a body in light is safe from the night.
;; The walk's success is the body in the hut, its door shut; failure is the body near its start. A roof with open sides is no shelter (Q345) and no walk is quoted to it: the body builds on the spot.
;; The wall case: a 1-thick stone wall at x 9, a gap at z 0..9, torches behind it light cells the body never saw: the short route round
;; through the gap costs under the dig-in and is walked. The failed-walk fallback (home behind a wall: walk fails,
;; :roof-walk-failed, no second walk) is a unit test only (night-test): a walk that cannot arrive is not a stable fixture (go-to escalates).
;; The three dig-in cases lay 3 stone layers under the one-layer floor, so the pit has ground to dig.
;; Needs night: run with --allow-time --time-log <the shared time log>.
{:defaults
 {:tags [:night :survival]
  :time :night
  :plot {:height 10 :length 64 :width 32}
  :body {:at [4.5 0 16.5] :effects [["resistance" 600 4]] :inventory [["cobblestone" 16]] :settle-s 4}}
 :cases
 [  {:name "lit-route-15-blocks-walks-home"
   :blocks [[:fill [18 0 14] [22 3 18] "stone" :hollow] [:fill [19 0 15] [21 2 17] "air"] [:fill [18 0 16] [18 1 16] "air"] [:set [18 0 16] "oak_door[facing=west,half=lower,hinge=left,open=true]"] [:set [18 1 16] "oak_door[facing=west,half=upper,hinge=left,open=true]"] [:set [17 0 15] "torch"]]
   :act [[:job (jobs.memory.set-place {:name :home :pos #at [20 0 16]}) [:now]]
         [:job (jobs.survival.night)]]
   :expect [{:event {:source :job :kind :completed :data {:name "jobs.survival.night"}} :within-s 100 :of-job true}]
   :after [[:block [18 0 16] "oak_door[half=lower,open=false]"] [:body-near [20.5 0 16.5] 2.5]]
   :limit-s 110}
  {:name "slab-roof-with-open-sides-digs-in-where-it-stands"
   :time :night :time-why :night-light
   :blocks [[:fill [0 -4 0] [63 -2 31] "stone"] [:fill [18 2 15] [20 2 17] "stone"] [:set [17 0 15] "torch"]]
   :act [[:job (jobs.memory.set-place {:name :home :pos #at [19 0 16]}) [:now]]
         [:job (jobs.survival.night)]]
   :expect [{:event {:source :job :kind :shut-in.sealed} :within-s 90 :of-job true}]
   :after [[:body-near [4.5 0 16.5] 4] [:body-far [19.5 0 16.5] 8]]
   :limit-s 100}
  {:name "lit-route-16-blocks-torches-walks-home"
   :blocks [[:fill [19 0 14] [23 3 18] "stone" :hollow] [:fill [20 0 15] [22 2 17] "air"] [:fill [19 0 16] [19 1 16] "air"] [:set [19 0 16] "oak_door[facing=west,half=lower,hinge=left,open=true]"] [:set [19 1 16] "oak_door[facing=west,half=upper,hinge=left,open=true]"] [:set [17 0 15] "torch"] [:set [20 0 15] "torch"]]
   :act [[:job (jobs.memory.set-place {:name :home :pos #at [21 0 16]}) [:now]]
         [:job (jobs.survival.night)]]
   :expect [{:event {:source :job :kind :completed :data {:name "jobs.survival.night"}} :within-s 100 :of-job true}]
   :after [[:block [19 0 16] "oak_door[half=lower,open=false]"] [:body-near [21.5 0 16.5] 2.5]]
   :limit-s 110}
  {:name "long-dark-route-digs-in-where-it-stands"
   :blocks [[:fill [0 -4 0] [63 -2 31] "stone"] [:fill [33 2 15] [35 2 17] "stone"]]
   :act [[:job (jobs.memory.set-place {:name :home :pos #at [34 0 16]}) [:now]]
         [:job (jobs.survival.night)]]
   :expect [{:event {:source :job :kind :shut-in.sealed} :within-s 90 :of-job true}]
   :after [[:body-near [4.5 0 16.5] 4] [:body-far [34.5 0 16.5] 8]]
   :limit-s 100}
  ;; c4ca97c3: a home beyond the walk radius is walked to while the lit route fits the time left before the dark plus the margin
  {:name "lit-route-45-blocks-torches-walks-home"
   :time :night :time-why :night-light
   :blocks [[:fill [48 0 14] [52 3 18] "stone" :hollow] [:fill [49 0 15] [51 2 17] "air"] [:fill [48 0 16] [48 1 16] "air"] [:set [48 0 16] "oak_door[facing=west,half=lower,hinge=left,open=true]"] [:set [48 1 16] "oak_door[facing=west,half=upper,hinge=left,open=true]"] [:set [17 0 15] "torch"] [:set [23 0 15] "torch"] [:set [29 0 15] "torch"] [:set [35 0 15] "torch"] [:set [41 0 15] "torch"] [:set [47 0 15] "torch"]]
   :act [[:job (jobs.memory.set-place {:name :home :pos #at [50 0 16]}) [:now]]
         [:job (jobs.survival.night)]]
   :expect [{:event {:source :job :kind :completed :data {:name "jobs.survival.night"}} :within-s 120 :of-job true}]
   :after [[:block [48 0 16] "oak_door[half=lower,open=false]"] [:body-near [50.5 0 16.5] 2.5]]
   :limit-s 130}
  {:name "short-route-behind-a-wall-never-seen-is-walked"
   :blocks [[:fill [9 0 10] [9 5 31] "stone"] [:fill [18 0 14] [22 3 18] "stone" :hollow] [:fill [19 0 15] [21 2 17] "air"] [:fill [18 0 16] [18 1 16] "air"] [:set [18 0 16] "oak_door[facing=west,half=lower,hinge=left,open=true]"] [:set [18 1 16] "oak_door[facing=west,half=upper,hinge=left,open=true]"] [:set [12 0 15] "torch"] [:set [17 0 15] "torch"]]
   :act [[:job (jobs.memory.set-place {:name :home :pos #at [20 0 16]}) [:now]]
         [:job (jobs.survival.night)]]
   :expect [{:event {:source :job :kind :completed :data {:name "jobs.survival.night"}} :within-s 100 :of-job true}]
   :after [[:block [18 0 16] "oak_door[half=lower,open=false]"] [:body-near [20.5 0 16.5] 2.5]]
   :limit-s 110}]}
