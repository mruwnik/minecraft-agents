;; Card 86035c28: a plan whose cells only a stand inside a sealed stone cavity sees. Every walk searches the loaded land and ends
;; :unreachable :budget; the build stops :unreachable after a few such walks instead of trying every cell in turn.
;; Should-fail: the build ends nothing-possible, not completed, with nothing placed.
{:defaults
 {:tags [:build] :time :any
  :plot {:height 8 :floor "stone"}
  :plans [{:id "cavity" :metadata {:by "$body"}
           :parts [{:id "cells" :cells [#at [12 1 12] #at [12 2 12] #at [12 3 12] #at [13 1 12] #at [13 2 12] #at [13 3 12]] :want "cobblestone"}]}]
  :body {:at [4.5 0 12.5] :settle-s 2 :effects [["resistance" 600 4]] :inventory [["cobblestone" 40]]}
  :limit-s 240}
 :cases
 [{:name "cells-only-a-sealed-cavity-reaches-stop-the-build"
   :blocks [[:fill [10 0 10] [15 4 14] "stone"]
            [:fill [12 1 12] [13 3 12] "air"]]
   :act [[:job (jobs.build.from-plan {:plan "$plan:cavity"})]]
   :expect [{:event {:source :job :kind :stopped} :within-s 200 :of-job true}]
   :after [[:not-block [12 3 12] "cobblestone"]]}]}
