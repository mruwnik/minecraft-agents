;; Babies are told from adults where an animal job decides on a headcount. Cards 02d41a3f (breed names adults and babies, entities marks
;; the baby), 0bd338eb (lure-to with only a baby in range says babies are not lured), af65abd7 (breed out of food after one feed ends
;; :food-out, the feed kept). Open ground, wheat in hand; NoAI cows stay where they are summoned, the body faces east.
;; Should-succeed: entities lists :baby true on the calf only; breed with one adult and one calf ends too-few and the text counts
;; "adults 1, babies 1". Should-fail: lure-to a lone calf ends :no-animal naming babies; breed of 4 cows with 1 wheat feeds one, then :food-out.
{:defaults
 {:tags [:animals :jobs :breed]
  :time :any
  :plot {:floor "grass_block"}
  :body {:at [10.5 0 16.5] :yaw 270 :inventory [["wheat" 4]] :effects [["resistance" 900 4]]}
  :limit-s 90}
 :cases
 [{:name "breed-too-few-counts-adult-and-baby"
   :act [[:summon "cow" [15.5 0 15.5] "{NoAI:1b}"]
         [:summon "cow" [15.5 0 17.5] "{NoAI:1b,Age:-24000}"]
         [:wait-s 2]
         [:until [:cli "entities" ["$body" "--world" "$world" "--type" "cow"] {:total 2 :items [:has {:baby true}]}] 20]
         [:job (jobs.animals.breed {:mob "cow" :count 2 :radius 20 :fetch false})]]
   :expect [{:event {:source :job :kind :stopped :data {:reason :too-few :text [:contains "adults 1, babies 1"]}} :within-s 40 :of-job true}]
   :after [[:item "wheat" 4]]}
  {:name "lure-to-a-lone-calf-says-babies-are-not-lured"
   :act [[:summon "cow" [15.5 0 16.5] "{NoAI:1b,Age:-24000}"]
         [:wait-s 2]
         [:until [:cli "entities" ["$body" "--world" "$world" "--type" "cow"] {:total 1 :items [:has {:baby true}]}] 20]
         [:job (jobs.animals.lure-to {:mob "cow" :pos #xyz [24 0 16] :radius 25})]]
   :expect [{:event {:source :job :kind :stopped :data {:reason :no-animal :text [:contains "babies are not lured"]}} :within-s 40 :of-job true}]
   :after [[:item "wheat" 4]]}
  {:name "breed-with-one-wheat-for-four-cows-ends-food-out"
   :body {:inventory [["wheat" 1]]}
   :act [[:summon "cow" [15.5 0 14.5] "{NoAI:1b}"] [:summon "cow" [15.5 0 16.5] "{NoAI:1b}"]
         [:summon "cow" [15.5 0 18.5] "{NoAI:1b}"] [:summon "cow" [17.5 0 16.5] "{NoAI:1b}"]
         [:wait-s 2]
         [:job (jobs.animals.breed {:mob "cow" :count 4 :radius 20 :fetch false})]]
   :expect [{:event {:source :job :kind :stopped :data {:reason :food-out :fed [:any]}} :within-s 60 :of-job true}
            {:no-event {:source :job :kind :completed} :for-s 20}]
   :after [[:item "wheat" 0]]}]}
