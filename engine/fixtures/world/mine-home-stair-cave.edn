;; jobs.gather.mine's walk home never plans a way round through a cave under the start (card 6a7beee5, Alder death 21).
;; Stone y -14..-2 under the plot; an old 1-wide stair runs down west from the mouth at [14 -1 16] (feet y -1 .. -9) into a cave
;; (x 2..6, y -12..-9). The body (wooden pickaxe, nothing to mend with) starts at [16 0 16] beside the mouth and mines stone.
;; Whatever it digs, it ends back near its start, never in the stair or the cave, and never :not-home.
{:defaults
 {:tags [:mine :jobs] :time :any
  :plot {:height 12}
  :blocks [[:fill [0 -14 8] [31 -2 24] "stone"]]
  :body {:at [16.5 0 16.5] :inventory [["wooden_pickaxe" 2]] :effects [["resistance" 600 4]]}
  :limit-s 200}
 :cases
 [{:name "stone-run-at-an-old-stair-mouth-ends-at-the-start"
   :blocks [[:fill [2 -12 12] [6 -9 20] "air"]
            [:fill [14 -1 16] [14 1 16] "air"] [:fill [13 -2 16] [13 0 16] "air"] [:fill [12 -3 16] [12 -1 16] "air"]
            [:fill [11 -4 16] [11 -2 16] "air"] [:fill [10 -5 16] [10 -3 16] "air"] [:fill [9 -6 16] [9 -4 16] "air"]
            [:fill [8 -7 16] [8 -5 16] "air"] [:fill [7 -8 16] [7 -6 16] "air"] [:fill [6 -9 16] [6 -7 16] "air"]]
   :act [[:job (jobs.gather.mine {:torch-interval 0 :block "stone" :count 9 :mend false})]]
   :expect [{:event {:source :job :kind #{:completed :stopped} :data {:got [:>= 1]}} :within-s 180 :of-job true}
            {:no-event {:source :job :kind :mine.not-home} :for-s 180 :until {:source :job :kind #{:completed :stopped}}}]
   :after [[:body-near [16.5 0 16.5] 4] [:body-far [4.5 -9 16.5] 8]]}
  {:name "stone-run-on-flat-ground-ends-at-the-start"
   :act [[:job (jobs.gather.mine {:torch-interval 0 :block "stone" :count 9 :mend false})]]
   :expect [{:event {:source :job :kind #{:completed :stopped} :data {:got [:>= 1]}} :within-s 180 :of-job true}
            {:no-event {:source :job :kind :mine.not-home} :for-s 180 :until {:source :job :kind #{:completed :stopped}}}]
   :after [[:body-near [16.5 0 16.5] 4]]}]}
