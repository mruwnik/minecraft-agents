;; Wool from sheep: combat.hunt with a :color takes only unsheared sheep of that colour and keeps the last 2; obtain of wool
;; shears or hunts per the same rule (cards 2b9dbe3f, 12c7d689, fc812a12, 07995c6a). Sheep are NoAI; Color 0 = white, 12 = brown.
;; Should-succeed: hunt brown among 4 brown + 2 white kills a brown and no white; hunt white among 3 unsheared + 1 sheared kills an
;; unsheared one and spares the sheared; obtain 2 white wool from 4 white sheep kills 2 and keeps 2; with only brown sheep it
;; takes brown (obtain.wool-colour); a pig 8 blocks off is hunted with keep 0.
;; Should-fail: all white sheep sheared: the hunt stops :no-color; a pig 30 blocks off with radius 24 waits :too-few naming the
;; nearest.
{:defaults
 {:tags [:animals :hunt :wool]
  :plot {:height 6}
  :body {:at [4.5 0 16.5] :inventory [["iron_sword" 1]] :settle-s 2}
  :limit-s 100}
 :cases
 [{:name "hunt-brown-leaves-the-white-sheep"
   :act [[:summon "sheep" [20.5 0 16.5] "{NoAI:1b,Color:12b}"] [:summon "sheep" [21.5 0 16.5] "{NoAI:1b,Color:12b}"] [:summon "sheep" [20.5 0 18.5] "{NoAI:1b,Color:12b}"] [:summon "sheep" [21.5 0 18.5] "{NoAI:1b,Color:12b}"]
         [:summon "sheep" [24.5 0 16.5] "{NoAI:1b,Color:0b}"] [:summon "sheep" [25.5 0 16.5] "{NoAI:1b,Color:0b}"]
         [:job (jobs.combat.hunt {:mob "sheep" :color "brown" :count 1})]]
   :expect [{:event {:source :job :kind :completed :data {:name "jobs.combat.hunt"}} :within-s 80}]
   :after [[:entities "type=sheep,tag=wt,nbt={Color:12b}" [[0 0 0] [31 3 31]] 3]
           [:entities "type=sheep,tag=wt,nbt={Color:0b}" [[0 0 0] [31 3 31]] 2]]}
  {:name "hunt-white-skips-the-sheared-sheep"
   :act [[:summon "sheep" [20.5 0 16.5] "{NoAI:1b,Color:0b}"] [:summon "sheep" [21.5 0 16.5] "{NoAI:1b,Color:0b}"] [:summon "sheep" [20.5 0 18.5] "{NoAI:1b,Color:0b}"] [:summon "sheep" [21.5 0 18.5] "{NoAI:1b,Color:0b,Sheared:1b}"]
         [:job (jobs.combat.hunt {:mob "sheep" :color "white" :count 1})]]
   :expect [{:event {:source :job :kind :completed :data {:name "jobs.combat.hunt"}} :within-s 80}]
   :after [[:entities "type=sheep,tag=wt,nbt={Sheared:1b}" [[0 0 0] [31 3 31]] 1]
           [:entities "type=sheep,tag=wt" [[0 0 0] [31 3 31]] 3]]}
  {:name "hunt-white-all-sheared-stops-no-color"
   :act [[:summon "sheep" [20.5 0 16.5] "{NoAI:1b,Color:0b,Sheared:1b}"] [:summon "sheep" [21.5 0 16.5] "{NoAI:1b,Color:0b,Sheared:1b}"] [:summon "sheep" [20.5 0 18.5] "{NoAI:1b,Color:0b,Sheared:1b}"]
         [:job (jobs.combat.hunt {:mob "sheep" :color "white" :count 1})]]
   :expect [{:event {:source :job :kind :waiting :data {:reason :no-color}} :within-s 40 :of-job true}]
   :after [[:entities "type=sheep,tag=wt" [[0 0 0] [31 3 31]] 3]]}
  {:name "obtain-white-wool-from-four-white-sheep-takes-two"
   :act [[:summon "sheep" [20.5 0 16.5] "{NoAI:1b,Color:0b}"] [:summon "sheep" [21.5 0 16.5] "{NoAI:1b,Color:0b}"] [:summon "sheep" [20.5 0 18.5] "{NoAI:1b,Color:0b}"] [:summon "sheep" [21.5 0 18.5] "{NoAI:1b,Color:0b}"]
         [:job (jobs.items.obtain {:item "white_wool" :count 2 :explore false})]]
   :expect [{:event {:source :job :kind :obtain.wool-source} :within-s 60}
            {:count-event {:source :job :kind :animal.killed :data {:animal "sheep" :rule :surplus}} :for-s 45 :at-least 2 :at-most 2}
            {:event {:source :job :kind :completed :data {:name "jobs.items.obtain"}} :within-s 100 :of-job true}]
   :after [[:item "white_wool" [:>= 2]] [:entities "type=sheep,tag=wt" [[0 0 0] [31 3 31]] 2]]}
  ;; the colour fallback needs several wanted names: a single wool item has one plan, so the wanted set is the two beds
  {:name "obtain-a-white-or-brown-bed-with-only-brown-sheep-takes-brown"
   :blocks [[:set [8 0 16] "crafting_table"]]
   :body {:inventory [["iron_sword" 1] ["oak_planks" 3]]}
   :act [[:summon "sheep" [20.5 0 16.5] "{NoAI:1b,Color:12b}"] [:summon "sheep" [21.5 0 16.5] "{NoAI:1b,Color:12b}"] [:summon "sheep" [20.5 0 18.5] "{NoAI:1b,Color:12b}"] [:summon "sheep" [21.5 0 18.5] "{NoAI:1b,Color:12b}"]
         [:wait-s 2] [:job (jobs.items.obtain {:any-of ["white_bed" "brown_bed"] :count 1 :explore false})]]
   :expect [{:event {:source :job :kind :obtain.wool-colour} :within-s 60}]}
  ;; fc812a12: a bed (any colour) is made from the wool already carried most: 2 brown carried, 3 brown + 3 white sheep: one brown is hunted
  {:name "obtain-bed-takes-the-colour-carried-most"
   :blocks [[:set [8 0 16] "crafting_table"]]
   :body {:inventory [["iron_sword" 1] ["brown_wool" 2] ["oak_planks" 3]]}
   :act [[:summon "sheep" [20.5 0 14.5] "{NoAI:1b,Color:12b}"] [:summon "sheep" [21.5 0 14.5] "{NoAI:1b,Color:12b}"] [:summon "sheep" [22.5 0 14.5] "{NoAI:1b,Color:12b}"]
         [:summon "sheep" [20.5 0 18.5] "{NoAI:1b,Color:0b}"] [:summon "sheep" [21.5 0 18.5] "{NoAI:1b,Color:0b}"] [:summon "sheep" [22.5 0 18.5] "{NoAI:1b,Color:0b}"]
         [:job (jobs.items.obtain {:any-of ["white_bed" "brown_bed"] :count 1 :explore false})]]
   :expect [{:event {:source :job :kind :completed :data {:name "jobs.items.obtain"}} :within-s 100 :of-job true}]
   :after [[:item "brown_bed" [:>= 1]]
           [:entities "type=sheep,tag=wt,nbt={Color:0b}" [[0 0 0] [31 3 31]] 3]]}
  ;; fc812a12: animals.cull takes :color; :keep counts every adult
  {:name "cull-white-leaves-the-brown-sheep"
   :act [[:summon "sheep" [20.5 0 14.5] "{NoAI:1b,Color:12b}"] [:summon "sheep" [21.5 0 14.5] "{NoAI:1b,Color:12b}"]
         [:summon "sheep" [20.5 0 18.5] "{NoAI:1b,Color:0b}"] [:summon "sheep" [21.5 0 18.5] "{NoAI:1b,Color:0b}"]
         [:summon "sheep" [22.5 0 18.5] "{NoAI:1b,Color:0b}"] [:summon "sheep" [23.5 0 18.5] "{NoAI:1b,Color:0b}"]
         [:job (jobs.animals.cull {:mob "sheep" :color "white" :keep 3 :count 2 :radius 24})]]
   :expect [{:event {:source :job :kind :completed :data {:name "jobs.animals.cull"}} :within-s 90 :of-job true}
            {:count-event {:source :job :kind :animal.killed :data {:rule :cull}} :for-s 90 :at-least 2}]
   :after [[:entities "type=sheep,tag=wt,nbt={Color:12b}" [[0 0 0] [31 3 31]] 2]
           [:entities "type=sheep,tag=wt,nbt={Color:0b}" [[0 0 0] [31 3 31]] 2]]}
  {:name "hunt-pig-8-blocks-off-with-keep-0"
   :act [[:summon "pig" [12.5 0 16.5] "{NoAI:1b}"]
         [:job (jobs.combat.hunt {:mob "pig" :keep 0 :radius 24})]]
   :expect [{:event {:source :job :kind :completed :data {:name "jobs.combat.hunt"}} :within-s 60}]
   :after [[:item "porkchop" [:>= 1]]]}
  {:name "hunt-pig-30-blocks-off-waits-too-few-with-the-distance"
   :plot {:height 6 :length 64 :width 32}
   :act [[:summon "pig" [34.5 0 16.5] "{NoAI:1b}"]
         [:job (jobs.combat.hunt {:mob "pig" :keep 0 :radius 24}) [:now]]]
   :expect [{:event {:source :job :kind :waiting :data {:reason :too-few :in-range 0 :nearest [:>= 25]}} :within-s 40 :of-job true}]
   :after [[:entities "type=pig,tag=wt" [[0 0 0] [63 3 31]] 1]]}]}
