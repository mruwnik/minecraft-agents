;; Card 5e09e8d7: gather.get-seeds cuts short grass that lies inside a plan the body made itself; a plan another body made refuses it.
;; Six short-grass cells in a row on a grass floor (the default floor is not one the grass stands on), x 17..22 at z 16, all cells of one plan (want short_grass); the count asked is more than they can give, so every cell is cut.
;; Should-succeed: own plan, every cell is cut and the job ends :none (not :refused). Should-fail: another body's plan, the job ends :refused and the grass stays.
{:defaults
 {:tags [:gather :farm :jobs :zones]
  :time :any
  :plot {:floor "grass_block"}
  :blocks [[:fill [17 0 16] [22 0 16] "short_grass"]]
  :body {:at [16.5 0 14.5] :effects [["resistance" 600 4]] :inventory []}
  :limit-s 150}
 :cases
 [{:name "grass-in-the-bodys-own-plan-is-cut"
   :plans [{:id "pad" :metadata {:by "$body"}
            :parts [{:id "grass" :cells [#at [17 0 16] #at [18 0 16] #at [19 0 16] #at [20 0 16] #at [21 0 16] #at [22 0 16]] :want "short_grass"}]}]
   :act [[:job (jobs.gather.get-seeds {:worth 1200 :item "wheat_seeds" :count 400 :radius 8})]]
   :expect [{:event {:source :job :kind :stopped :data {:reason :none}} :within-s 140 :of-job true}
            {:no-event {:source :job :kind :stopped :data {:reason :refused}} :for-s 140 :of-job true :until {:source :job :kind :stopped}}]
   :after [[:block [17 0 16] "air"] [:block [22 0 16] "air"]]}
  {:name "grass-in-another-bodys-plan-is-refused"
   :plans [{:id "pad" :metadata {:by "Other"}
            :parts [{:id "grass" :cells [#at [17 0 16] #at [18 0 16] #at [19 0 16] #at [20 0 16] #at [21 0 16] #at [22 0 16]] :want "short_grass"}]}]
   :act [[:job (jobs.gather.get-seeds {:worth 1200 :item "wheat_seeds" :count 400 :radius 8})]]
   :expect [{:event {:source :job :kind :stopped :data {:reason :refused}} :within-s 140 :of-job true}]
   :after [[:block [17 0 16] "short_grass"] [:block [22 0 16] "short_grass"]]}]}
