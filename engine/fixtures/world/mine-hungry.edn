;; gather.mine has no hunger stop (design D12): a hungry body is fed by the hungry trigger, and a hungry body with nothing to eat digs on.
;; A stone mass x 2..30, z 8..30 with a 1x2 tunnel cell at the body (as mine-branch-torch); iron ore at the east end of a 12-cell line.
{:defaults
 {:tags [:mine :hungry :jobs] :time :any
  :plot {:height 12}
  :blocks [[:fill [2 0 8] [30 6 30] "stone"] [:fill [16 0 16] [19 1 16] "air"] [:set [28 0 16] "iron_ore"]]
  :body {:at [16.5 0 16.5] :yaw 0 :inventory [["stone_pickaxe" 1] ["cobblestone" 16] ["torch" 8] ["bread" 4]] :effects [["resistance" 600 4]]}
  :limit-s 150}
 :cases
 [{:name "hungry-mid-mine-feeds-through-the-trigger"
   :register [{:trigger :hungry :persistence :cooldown :cooldown-s 30 :job (jobs.survival.get-food {:explore false})}]
   :act [[:job (jobs.gather.mine {:block "iron_ore" :level false :count 1 :direction :east :tunnel-length 14 :radius 16 :mend false})]
         [:wait-s 4] ; settle: nothing the body reports to poll
         [:rcon "effect give $BODY minecraft:hunger 8 243 true"]]
   :expect [{:event {:source :reflex :kind :fired :context {:reflex-id :hungry}} :within-s 90}
            {:event {:source :reflex :kind :ended :context {:reflex-id :hungry}} :within-s 120}
            {:event {:source :job :kind :completed :data {:name "jobs.gather.mine"}} :within-s 140 :of-job true}]
   :after [[:item "raw_iron" 1] [:item "bread" [:<= 3]]]}
  {:name "hungry-with-no-food-carried-the-mine-goes-on"
   :body {:inventory [["stone_pickaxe" 1] ["cobblestone" 16] ["torch" 8]]}
   :memory [{:kind :hungry :data {:food 2} :age-s 5 :policy {:cap 10 :ttl 3600000}}]
   :act [[:rcon "effect give $BODY minecraft:hunger 8 255 true"] [:until-rcon "data get entity $BODY foodLevel" "data: [0-3]$" 30]
         [:job (jobs.gather.mine {:block "iron_ore" :level false :count 1 :direction :east :tunnel-length 14 :radius 16 :mend false})]]
   :expect [{:event {:source :job :kind :completed :data {:name "jobs.gather.mine"}} :within-s 140 :of-job true}]
   :after [[:item "raw_iron" 1]]}
  {:name "last-pickaxe-worn-out-ends-condition-failed-no-tool"
   :blocks [[:set [21 0 16] "iron_ore"] [:set [22 0 16] "iron_ore"]]
   :body {:inventory [["cobblestone" 16] ["torch" 8] ["bread" 4]]}
   :act [[:rcon "item replace entity $BODY hotbar.0 with minecraft:stone_pickaxe[minecraft:damage=130]"]
         [:job (jobs.gather.mine {:block "iron_ore" :level false :count 3 :direction :east :tunnel-length 8 :radius 16 :mend false :fetch false})]]
   :expect [{:event {:source :job :kind :stopped :data {:kind :condition-failed}} :within-s 100 :of-job true}
            {:no-event {:source :job :kind :stopped :data {:kind :limit-reached}} :for-s 30 :of-job true}]}]}
