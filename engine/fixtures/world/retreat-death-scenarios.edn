;; Flights that killed a body. Card abea4cb7: ea529aed (a flight from a creeper at a dead end backed into its cell: the body
;; backs off to the end and never steps towards it), 9db4afdb (a body that keeps placing seal blocks while a melee mob hits it:
;; the armed body turns on the zombie). A closed, torch-lit stone corridor, 1 wide, dead end at x 20. Mobs wear helmets;
;; NoAI creepers never fuse, so the case judges by where the body goes.
{:defaults
 {:tags [:hostile :survival :flee :underground]
  :time :any
  :mobs :keep
  :plot {:height 16}
  :register [{:trigger :hostile-near :args {:radius 8 :ranged-radius 16}
              :job (jobs.survival.respond-to-hostile)}]
  :blocks [[:fill [0 0 0] [31 11 31] "stone"] [:fill [3 0 16] [20 2 16] "air"]
           [:set [3 0 16] "torch"] [:set [20 0 16] "torch"] [:set [11 0 16] "torch"]]
  :limit-s 60}
 :cases
 [{:name "creeper-behind-the-body-in-a-dead-end-is-never-stepped-towards"
   :body {:at [17.5 0 16.5] :yaw 90 :effects [["resistance" 600 4]]}
   :act [[:summon "creeper" [12.5 0 16.5] "{NoAI:1b,equipment:{head:{id:\"minecraft:iron_helmet\",count:1}}}"]]
   :expect [{:event {:source :reflex :kind :fired :context {:reflex-id :hostile-near}} :within-s 15}
            {:no-event {:source :job :kind :retreat.target :data {:target [:near #at [12 0 16] 4]}} :for-s 30}
            {:no-event {:source :body :kind :died} :for-s 30}]
   :after [[:body-near [19 0 16.5] 3.5]]}
  {:name "armed-body-with-blocks-turns-on-a-zombie-that-hits-it-in-a-dead-end"
   :body {:at [18.5 0 16.5] :inventory [["iron_sword" 1] ["cobblestone" 128]] :effects [["resistance" 600 2]]}
   :act [[:summon "zombie" [8.5 0 16.5] "{equipment:{head:{id:\"minecraft:iron_helmet\",count:1}}}"]]
   :expect [{:no-event {:source :body :kind :died} :for-s 45}]
   :after [[:entities "type=zombie,tag=wt" [[0 0 0] [31 6 31]] 0]]}]}
