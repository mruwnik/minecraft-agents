;; jobs.gather.mine in a stone mass (cards 2c41db90 / 7c9378bc, hand-tested in 7c9378bc): a strip tunnel east finds an
;; ore in line and the drop is collected (no false mine.left-behind, :got matches the inventory); ore with no face to
;; the tunnel is never dug. (The left-behind case, a drop the body cannot reach, was not ported: see card 8aa80fca.)
;; Stone mass x 2..30, z 8..24, y 0..6; body in a 1x2 cell at [16 0 16] facing east, stone pickaxe.
{:defaults
 {:tags [:mine :jobs] :time :any
  :plot {:height 12}
  :blocks [[:fill [2 0 8] [30 6 24] "stone"] [:fill [16 0 16] [16 1 16] "air"]]
  :body {:at [16.5 0 16.5] :inventory [["stone_pickaxe" 1] ["cobblestone" 16]] :effects [["resistance" 600 4]]}}
 :cases
 [{:name "in-line-ore-collected"
   :blocks [[:set [20 0 16] "iron_ore"]]
   :act [[:job (jobs.gather.mine {:torches false :block "iron_ore" :level false :count 1 :direction :east :tunnel-length 8 :radius 8})]]
   :expect [{:event {:source :job :kind #{:completed :stopped} :data {:got 1}} :within-s 100 :of-job true}
            {:no-event {:source :job :kind :mine.left-behind} :for-s 100 :until {:source :job :kind #{:completed :stopped} :data {:got 1}}}]
   :after [[:item "raw_iron" 1] [:not-block [20 0 16] "iron_ore"]]
   :limit-s 120}
  {:name "ore-in-line-twice"
   :blocks [[:set [19 0 16] "iron_ore"] [:set [22 0 16] "iron_ore"]]
   :act [[:job (jobs.gather.mine {:torches false :block "iron_ore" :level false :count 2 :direction :east :tunnel-length 10 :radius 8})]]
   :expect [{:event {:source :job :kind #{:completed :stopped} :data {:got 2}} :within-s 120 :of-job true}
            {:no-event {:source :job :kind :mine.left-behind} :for-s 120 :until {:source :job :kind #{:completed :stopped} :data {:got 2}}}]
   :after [[:item "raw_iron" 2]]
   :limit-s 140}
  {:name "buried-ore-off-the-line-is-never-dug"
   ;; ores not in the tunnel's line and with no face to the tunnel (never seen): the run ends at the tunnel length with
   ;; nothing, and the ores stand
   :blocks [[:set [18 0 14] "iron_ore"] [:set [19 3 16] "iron_ore"] [:set [20 0 18] "iron_ore"]]
   :act [[:job (jobs.gather.mine {:torches false :block "iron_ore" :level false :count 1 :direction :east :tunnel-length 5 :radius 8})]]
   :expect [{:event {:source :job :kind #{:completed :stopped} :data {:got 0 :reason :tunnel-length}} :within-s 100 :of-job true}]
   :after [[:block [18 0 14] "iron_ore"] [:block [19 3 16] "iron_ore"] [:block [20 0 18] "iron_ore"]]
   :limit-s 120}
  ;; Card ca6fc91f: a block behind an intact one is no longer dug with its drop hidden (dry :no-drops). A 6-granite row
  ;; in open air (the mass is cleared first; granite, as the plot floor is stone and its exposed cells are fair "stone"
  ;; targets; no cobblestone carried, so the item count is the dug cells); perception shows a random subset of the row,
  ;; so each direction is its own case and the sweep repeats them. Should-fail (drops hidden for good, ends :no-drops) is not a fixture: no way to
  ;; hide a drop for good without inventory-full set-ups the job would mend.
  {:name "stone-row-mined-to-the-count-east"
   :blocks [[:fill [2 0 8] [30 6 24] "air"] [:fill [4 0 16] [9 0 16] "granite"]]
   :body {:at [3.5 0 16.5] :yaw 270 :inventory [["stone_pickaxe" 1]]}
   :act [[:job (jobs.gather.mine {:torches false :block "granite" :count 6 :direction :east :tunnel-length 8 :radius 8 :mend false})]]
   :expect [{:event {:source :job :kind #{:completed :stopped} :data {:got 6 :reason :count}} :within-s 100 :of-job true}]
   :after [[:item "granite" 6] [:not-block [4 0 16] "granite"] [:not-block [9 0 16] "granite"]]
   :limit-s 120}
  ;; Card a8447323: :stay-level mines ore seen within :ore-reach (2) off the tunnel, not only in the line: a side cut, the mouth shut with a carried block
  ;; (mine.side). The ore is seen through a glass block at eye height in the wall (no x-ray; a pane at the feet is out of the eye's line); :settings {:jobs.gather.mine-stay/ore-reach 0} leaves it.
  {:name "stay-level-takes-seen-ore-two-off-the-tunnel"
   :blocks [[:set [18 1 15] "glass"] [:set [18 1 14] "diamond_ore"]]
   :body {:inventory [["iron_pickaxe" 1] ["cobblestone" 16]]}
   :act [[:job (jobs.gather.mine {:torches false :block "diamond_ore" :count 1 :direction :east :stay-level true :tunnel-length 8 :mend false})]]
   :expect [{:event {:source :job :kind :mine.side} :within-s 100 :of-job true}
            {:event {:source :job :kind #{:completed :stopped}} :within-s 120 :of-job true}]
   :after [[:item "diamond" [:>= 1]] [:not-block [18 1 14] "diamond_ore"]]
   :limit-s 130}
  {:name "ore-reach-0-leaves-the-side-ore"
   :blocks [[:set [18 1 15] "glass"] [:set [18 1 14] "diamond_ore"]]
   :body {:inventory [["iron_pickaxe" 1] ["cobblestone" 16]]}
   :act [[:job (jobs.gather.mine {:torches false :block "diamond_ore" :count 1 :direction :east :stay-level true :tunnel-length 8 :mend false :settings {:jobs.gather.mine-stay/ore-reach 0}})]]
   :expect [{:event {:source :job :kind #{:completed :stopped}} :within-s 120 :of-job true}
            {:no-event {:source :job :kind :mine.side} :for-s 60}]
   :after [[:block [18 1 14] "diamond_ore"] [:item "diamond" 0]]
   :limit-s 130}
  ;; Card b83469be: the side cut's child mine is not held to the parent's :from, so an ore more than 6 blocks from the submit cell is taken too (mine.side info "took", no "did not take")
  {:name "stay-level-takes-seen-side-ore-eight-blocks-from-the-start"
   :blocks [[:set [24 1 15] "glass"] [:set [24 1 14] "diamond_ore"]]
   :body {:inventory [["iron_pickaxe" 1] ["cobblestone" 16]]}
   :act [[:job (jobs.gather.mine {:torches false :block "diamond_ore" :count 1 :direction :east :stay-level true :tunnel-length 12 :mend false})]]
   :expect [{:event {:source :job :kind :mine.side :level :info :data {:shut true}} :within-s 120 :of-job true}
            {:no-event {:source :job :kind :mine.side :level :warn} :for-s 120 :until {:source :job :kind #{:completed :stopped}}}]
   :after [[:item "diamond" [:>= 1]] [:not-block [24 1 14] "diamond_ore"]]
   :limit-s 150}]}
