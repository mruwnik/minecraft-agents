;; Cards b5ad3b11 (and 8bf24e33's "left, not silently skipped" half): collect-drops with :holes leaves a drop that sits in the cave
;; a dug shaft opened, one column over from the shaft, at the rim: it is booked left (debug collect-drops.left :too-deep or
;; :unreachable) and the body does not go down. Stone mass x 8..24, z 8..24, y 0..9; the shaft [16 9..7 16] opens into a
;; cave cell row [17 6 16]; the body stands on the rim at [16.5 10 16.5].
;; Should-succeed: a drop one down in the open shaft floor (seen solid under it) is collected; with :dig the cave drop is dug to and collected
;; (card 8bf24e33; the collect action's own unreachable answer cannot be forced here, unsure 55% this route is taken). Should-fail: the drop in the cave without :dig.
{:defaults
 {:tags [:forestry :collect-drops :mining :survival]
  :time :any
  :plot {:height 20}
  :blocks [[:fill [8 0 8] [24 9 24] "stone"]]
  :body {:at [16.5 10 16.5] :effects [["resistance" 600 4]]}
  :limit-s 90}
 :cases
 [{:name "drop-one-down-in-the-hole-collected"
   :blocks [[:set [16 9 16] "air"]]
   :act [[:summon "item" [16.5 9.2 16.5] "{Item:{id:\"minecraft:cobblestone\",count:1}}"]
         [:job (jobs.items.collect-drops {:radius 6 :holes [#at [16 9 16]]})]]
   :expect [{:event {:source :job :kind :completed} :within-s 60 :of-job true}]
   :after [[:item "cobblestone" 1]]}
  {:name "drop-in-the-cave-a-column-over-is-left"
   ;; column 17 is open to the rim so the drop is in sight (an unseen drop ends done? at once and the :holes rule would not run)
   :blocks [[:fill [16 7 16] [16 9 16] "air"] [:fill [17 6 16] [17 9 16] "air"] [:set [16 6 16] "air"]]
   :act [[:summon "item" [17.5 6.2 16.5] "{Item:{id:\"minecraft:cobblestone\",count:1}}"]
         [:wait-s 2]
         [:job (jobs.items.collect-drops {:radius 6 :holes [#at [16 9 16]]})]]
   :expect [{:event {:source :job :level :debug :kind :collect-drops.left :data {:reason :too-deep}} :within-s 60 :of-job true}
            {:no-event {:source :action :kind :started :data {:name "collect"}} :for-s 50 :until {:source :job :kind :completed}}]
   :after [[:item "cobblestone" 0] [:body-far [17.5 6.2 16.5] 2]]}
  {:name "drop-in-the-cave-a-column-over-is-dug-to-with-dig"
   :blocks [[:fill [16 7 16] [16 9 16] "air"] [:fill [17 6 16] [17 7 16] "air"] [:set [16 6 16] "air"]]
   :act [[:summon "item" [17.5 6.2 16.5] "{Item:{id:\"minecraft:cobblestone\",count:1}}"]
         [:job (jobs.items.collect-drops {:radius 6 :holes [#at [16 9 16]] :dig true})]]
   :expect [{:event {:source :job :kind :completed} :within-s 80 :of-job true}]
   :after [[:item "cobblestone" [:>= 1]]]
   :limit-s 100} ;; gravel on the rim over the cell nearest the cave: the dig route must not open a cell under it (the body would be buried)
  {:name "drop-in-the-cave-dug-to-without-opening-under-gravel"
   :blocks [[:fill [16 7 16] [16 9 16] "air"] [:fill [17 6 16] [17 7 16] "air"] [:set [16 6 16] "air"] [:set [17 10 16] "gravel"] [:set [17 10 15] "gravel"] [:set [17 10 17] "gravel"]]
   :act [[:summon "item" [17.5 6.2 16.5] "{Item:{id:\"minecraft:cobblestone\",count:1}}"]
         [:job (jobs.items.collect-drops {:radius 6 :holes [#at [16 9 16]] :dig true})]]
   :expect [{:event {:source :job :kind :completed} :within-s 80 :of-job true}
            {:no-event {:source :body :kind :hurt} :for-s 60 :until {:source :job :kind :completed}}]
   :after [[:item "cobblestone" [:>= 1]]]
   :limit-s 100}]}
