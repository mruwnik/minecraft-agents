;; Card 115846a3 / 01c8dd05: leaving another's zone is never refused by it, but another zone round it still refuses.
;; Stone mass x 10..22, z 10..22, y 0..2 with a 1x1x2 open cell at x 16, z 16 (y 0..1) under a 1-thick roof (y 2); the top feet y is 3.
;; roofed-pit-in-foreign-zone-names-the-zone: the zones cover the whole mass except the cell the body stands in, so the stair is refused
;;   (:escalation {:step :none :why :zone}, nothing dug).
;; inside-foreign-zone-stairs-out-without-ignore-zones: one zone covers the whole mass, the body stands in it and stairs out without :ignore-zones?.
{:defaults
 {:tags [:movement :access :zones]
  :time :any
  :plot {:height 12}
  :blocks [[:fill [10 0 10] [22 2 22] "stone"] [:fill [16 0 16] [16 1 16] "air"]]
  :body {:at [16.5 0 16.5] :inventory [["stone_pickaxe" 1]] :effects [["resistance" 600 4]]}
  :limit-s 150}
 :cases
 [{:name "roofed-pit-in-foreign-zone-names-the-zone"
   :zones [{:name "w" :min [10 0 10] :max [15 2 22] :owner "SomeoneElse"} {:name "e" :min [17 0 10] :max [22 2 22] :owner "SomeoneElse"}
          {:name "n" :min [16 0 10] :max [16 2 15] :owner "SomeoneElse"} {:name "s" :min [16 0 17] :max [16 2 22] :owner "SomeoneElse"}
          {:name "roof" :min [16 2 16] :max [16 2 16] :owner "SomeoneElse"}]
   :act [[:job (jobs.movement.go-to {:pos #at [20 3 16] :range 1})]]
   :expect [{:event {:source :job :kind :stopped :context {:chain [[:any]]} :data {:arrived false :escalation {:step :none :why :zone}}} :within-s 90 :of-job true}
            {:no-event {:source :action :kind :done :data {:name "dig"}} :for-s 90 :until {:source :job :kind :stopped :data {:arrived false :escalation {:step :none :why :zone}}}}]
   :after [[:block [16 2 16] "stone"] [:body-near [16.5 0 16.5] 1.5]]}
  {:name "inside-foreign-zone-stairs-out-without-ignore-zones"
   :zones [{:name "mass" :min [10 0 10] :max [22 2 22] :owner "SomeoneElse"}]
   :act [[:job (jobs.movement.go-to {:pos #at [20 3 16] :range 1})]]
   :expect [{:event {:source :job :kind :go-to.escalated :data {:step :stair}} :within-s 90 :of-job true}
            {:event {:source :job :kind :completed :context {:chain [[:any]]} :data {:arrived true}} :within-s 140 :of-job true}]
   :after [[:body-near [20.5 3 16.5] 2]]}
  {:name "roofed-pit-ignore-zones-stairs-out"
   :zones [{:name "w" :min [10 0 10] :max [15 2 22] :owner "SomeoneElse"} {:name "e" :min [17 0 10] :max [22 2 22] :owner "SomeoneElse"}
          {:name "n" :min [16 0 10] :max [16 2 15] :owner "SomeoneElse"} {:name "s" :min [16 0 17] :max [16 2 22] :owner "SomeoneElse"}
          {:name "roof" :min [16 2 16] :max [16 2 16] :owner "SomeoneElse"}]
   :act [[:job (jobs.movement.go-to {:pos #at [20 3 16] :range 1 :ignore-zones? true})]]
   :expect [{:event {:source :job :kind :go-to.escalated :data {:step :stair}} :within-s 90 :of-job true}
            {:event {:source :job :kind :completed :context {:chain [[:any]]} :data {:arrived true}} :within-s 140 :of-job true}]
   :after [[:body-near [20.5 3 16.5] 2]]}]}
