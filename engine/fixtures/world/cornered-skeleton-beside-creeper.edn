;; A body in a dead-end tunnel with a skeleton 4 blocks off and a creeper 3 blocks behind the skeleton never walks to the skeleton
;; (the walk would end in the creeper's blast). Mobs are NoAI, helmeted (no sun burn). Should-succeed: the body stays near its end.
;; Stone mass x 2..30, z 10..22, y 0..4; tunnel 1x2 along z 16 from x 5 (closed end, body) to x 30.
{:defaults
 {:tags [:hostile :survival :cornered :creeper]
  :time :any
  :mobs :keep
  :register [{:trigger :hostile-near}]
  :blocks [[:fill [2 0 10] [30 4 22] "stone"] [:fill [5 0 16] [29 1 16] "air"]
           [:set [8 1 16] "torch"] [:set [14 1 16] "torch"]]
  :body {:at [5.5 0 16.5] :inventory [["stone_sword" 1]]}}
 :cases
 [{:name "cornered-body-never-walks-to-a-skeleton-beside-a-creeper"
   :act [[:summon "skeleton" [9.5 0 16.5] "{NoAI:1b,equipment:{head:{id:\"minecraft:iron_helmet\",count:1}}}"]
         [:summon "creeper" [12.5 0 16.5] "{NoAI:1b}"]]
   :expect [{:no-event {:source :body :kind :died} :for-s 30}]
   :after [[:body-far [12.5 0 16.5] 5]]
   :limit-s 40}]}
