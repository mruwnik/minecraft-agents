;; Cards f116ef59, 5dba17dd, 48ce8855: go-to :gait :sneak (and :walk) on the shapes a sneaking body must handle. Drops are refused
;; (:max-damage 0) and :escalate is off, so the only way to the goal is the shape under test. Every walk arrives and no fall hurts.
;; Should-succeed: down 1-block hill steps; down a 5-high ladder (sneak released on the climb); along a 1-wide ledge beside a 4-deep
;; drop; over a 1-cell gap in that ledge; down a 4-high scaffolding tower under :sneak, :walk and :auto. Should-fail: a :gait that
;; is not :auto/:walk/:sneak is refused :bad-gait before any walk.
{:defaults
 {:tags [:movement]
  :time :any
  :plot {:height 12}
  :body {:at [4.5 5 16.5] :effects [["resistance" 600 4]]}
  :limit-s 90}
 :cases
 [{:name "sneak-hill-steps-arrive"
   :blocks [[:fill [4 0 14] [5 4 18] "stone"] [:fill [6 0 14] [7 3 18] "stone"] [:fill [8 0 14] [9 2 18] "stone"]
            [:fill [10 0 14] [11 1 18] "stone"] [:fill [12 0 14] [13 0 18] "stone"]]
   :act [[:job (jobs.movement.go-to {:pos #at [20 0 16] :range 1 :gait :sneak :escalate false :max-damage 0})]]
   :expect [{:event {:source :job :kind :result :data {:arrived true}} :within-s 60 :of-job true}
            {:no-event {:source :body :kind :hurt} :for-s 60 :until {:source :job :kind :result}}]
   :after [[:body-near [20.5 0 16.5] 3]]}
  {:name "sneak-ladder-down-arrives"
   :blocks [[:fill [10 0 14] [12 4 18] "stone"]
            [:fill [13 0 16] [13 4 16] "ladder[facing=east]"]]
   :body {:at [11.5 5 16.5]}
   :act [[:job (jobs.movement.go-to {:pos #at [18 0 16] :range 1 :gait :sneak :escalate false :max-damage 0})]]
   :expect [{:event {:source :job :kind :result :data {:arrived true}} :within-s 60 :of-job true}
            {:no-event {:source :body :kind :hurt} :for-s 60 :until {:source :job :kind :result}}]
   :after [[:body-near [18.5 0 16.5] 3]]}
  {:name "sneak-ledge-over-drop-arrives"
   :blocks [[:fill [6 0 16] [24 3 16] "stone"]]
   :body {:at [6.5 4 16.5]}
   :act [[:job (jobs.movement.go-to {:pos #at [24 4 16] :range 1 :gait :sneak :escalate false :max-damage 0})]]
   :expect [{:event {:source :job :kind :result :data {:arrived true}} :within-s 80 :of-job true}
            {:no-event {:source :body :kind :hurt} :for-s 80 :until {:source :job :kind :result}}]
   :after [[:body-near [24.5 4 16.5] 3]]}
  {:name "sneak-ledge-one-cell-gap-arrives"
   :blocks [[:fill [6 0 16] [24 3 16] "stone"] [:fill [15 0 16] [15 3 16] "air"]]
   :body {:at [6.5 4 16.5]}
   :act [[:job (jobs.movement.go-to {:pos #at [24 4 16] :range 1 :gait :sneak :escalate false :max-damage 0})]]
   :expect [{:event {:source :job :kind :result :data {:arrived true}} :within-s 80 :of-job true}
            {:no-event {:source :body :kind :hurt} :for-s 80 :until {:source :job :kind :result}}]
   :after [[:body-near [24.5 4 16.5] 3]]}
  {:name "sneak-scaffolding-tower-down-arrives"
   :blocks [[:fill [13 0 16] [13 3 16] "scaffolding"]]
   :body {:at [13.5 4 16.5]}
   :act [[:job (jobs.movement.go-to {:pos #at [18 0 16] :range 1 :gait :sneak :escalate false :max-damage 0})]]
   :expect [{:event {:source :job :kind :result :data {:arrived true}} :within-s 60 :of-job true}
            {:no-event {:source :body :kind :hurt} :for-s 60 :until {:source :job :kind :result}}]
   :after [[:body-near [18.5 0 16.5] 3]]}
  {:name "walk-scaffolding-tower-down-arrives"
   :blocks [[:fill [13 0 16] [13 3 16] "scaffolding"]]
   :body {:at [13.5 4 16.5]}
   :act [[:job (jobs.movement.go-to {:pos #at [18 0 16] :range 1 :gait :walk :escalate false :max-damage 0})]]
   :expect [{:event {:source :job :kind :result :data {:arrived true}} :within-s 60 :of-job true}
            {:no-event {:source :body :kind :hurt} :for-s 60 :until {:source :job :kind :result}}]
   :after [[:body-near [18.5 0 16.5] 3]]}
  {:name "auto-scaffolding-tower-down-arrives"
   :blocks [[:fill [13 0 16] [13 3 16] "scaffolding"]]
   :body {:at [13.5 4 16.5]}
   :act [[:job (jobs.movement.go-to {:pos #at [18 0 16] :range 1 :escalate false :max-damage 0})]]
   :expect [{:event {:source :job :kind :result :data {:arrived true}} :within-s 60 :of-job true}
            {:no-event {:source :body :kind :hurt} :for-s 60 :until {:source :job :kind :result}}]
   :after [[:body-near [18.5 0 16.5] 3]]}
  {:name "unknown-gait-refused-no-walk"
   :body {:at [4.5 0 16.5]}
   :act [[:job (jobs.movement.go-to {:pos #at [20 0 16] :range 1 :gait :crawl :escalate false})]]
   :expect [{:event {:source :job :kind :result :data {:arrived false :reason :bad-gait}} :within-s 15 :of-job true}
            {:no-event {:source :action :kind :started :data {:name "steer"}} :for-s 8 :until {:source :job :kind :result} :of-job true}]
   :after [[:body-near [4.5 0 16.5] 1.5]]}]}
