;; Card 6558d218 (fix 388739808): at night a body roofed in a lit tunnel whose far end bends out of sight judges the tunnel without a priced edge walk
;; (look-edge/look! bought from night/look-worth, the cheapest way left): it ends roofed and stays near the start (the first case: the bend makes no
;; pending side). With an unseen lit side (the tunnel runs on to x 66) the walk is bought and made; the same tunnel with lava glowing behind a glass wall
;; makes staying cost nothing, the walk is not bought. night never writes :walk-looked (walk-look does).
;; Sky grid (y -6..-1 is stone over void): tunnel along x 4..29 at z 16, y -5..-4, torches; at x 29 it turns north to z 12 (a bend hides the rest).
;; Needs night: --allow-time --time-log <the shared time log>.
{:defaults
 {:tags [:night :survival :look]
  :time :night :time-why :night-light
  :blocks [[:fill [0 -6 8] [31 -1 20] "stone"]
           [:fill [4 -5 16] [29 -4 16] "air"] [:fill [29 -5 12] [29 -4 15] "air"]
           [:set [8 -5 16] "torch"] [:set [18 -5 16] "torch"] [:set [27 -5 16] "torch"] [:set [29 -5 13] "torch"]]
  :body {:at [24.5 -5 16.5] :effects [["resistance" 600 4]] :settle-s 3 :inventory [["cobblestone" 8]]}
  :limit-s 80}
 :cases
 [{:name "no-pending-side-control-ends-roofed-without-an-edge-walk"
   :act [[:job (jobs.survival.night)]
         [:await {:source :job :kind #{:completed :stopped} :data {:name "jobs.survival.night"}} 60]]
   :expect [{:event {:source :job :kind :completed :data {:name "jobs.survival.night" :night :roofed}} :within-s 60 :of-job true}
            {:no-event {:source :job :data {:pos [:not #{nil [:near #at [24.5 -5 16.5] 14]}]}} :of-job true :for-s 40}]
   :after [[:body-near [24.5 -5 16.5] 14]]}
  {:name "unseen-lit-side-edge-walk-is-bought-and-walked" :plot {:length 72 :width 32}
   :blocks [[:fill [32 -6 8] [70 -1 20] "stone"] [:fill [30 -5 16] [66 -4 16] "air"]
            [:set [36 -5 16] "torch"] [:set [45 -5 16] "torch"] [:set [54 -5 16] "torch"] [:set [63 -5 16] "torch"]]
   :act [[:job (jobs.survival.night)]
         [:await {:source :job :kind #{:completed :stopped} :data {:name "jobs.survival.night"}} 60]]
   :expect [{:event {:source :job :kind :child_started :data {:slot :edge-walk}} :within-s 60 :of-job true}
            {:event {:source :job :kind :completed :data {:name "jobs.survival.night" :night :roofed}} :within-s 60 :of-job true}]}
  {:name "unseen-side-walk-is-declined-when-staying-costs-nothing" :plot {:length 72 :width 32}
   :blocks [[:fill [32 -6 8] [70 -1 20] "stone"] [:fill [30 -5 16] [66 -4 16] "air"]
            [:set [36 -5 16] "torch"] [:set [45 -5 16] "torch"] [:set [54 -5 16] "torch"] [:set [63 -5 16] "torch"]
            [:fill [30 -5 14] [66 -4 14] "lava"] [:fill [30 -5 15] [66 -4 15] "glass"]]
   :act [[:job (jobs.survival.night)]
         [:await {:source :job :kind #{:completed :stopped} :data {:name "jobs.survival.night"}} 60]]
   :expect [{:event {:source :job :kind #{:completed :stopped} :data {:name "jobs.survival.night"}} :within-s 60 :of-job true}
            {:no-event {:source :job :kind :child_started :data {:slot :edge-walk}} :of-job true :for-s 40}]}]}
