;; farm.maintain's :repair step mends a planned torch [8 0 14] that is missing, at the spawns it averts by night
;; (diff/light-loss), the rest of the plan sound. Old code priced it at its placing only (about 1 s), under the mend's walk
;; and place, so the repair ended :not-worth and the torch stayed out (S19).
;; Should-succeed: torch carried; torch crafted from coal and a stick. Control: farm-maintain-repair/a-sound-plan-skips-the-repair.
{:defaults
 {:tags [:farm :jobs]
  :time :any
  :plot {:height 8}
  :blocks [[:fill [10 -1 16] [11 -1 16] "farmland"] [:set [12 -1 16] "water"]]
  :plans [{:id "farm" :metadata {:by "$body"}
           :parts [{:id "wheat" :cells [#at [10 0 16] #at [11 0 16]] :want {:crop "wheat"}}
                   {:id "water" :cells [#at [12 -1 16]] :want "water"}
                   {:id "torch" :cells [#at [8 0 14]] :want "torch"}]}]
  :body {:at [10.5 0 14.5] :settle-s 2}
  :act [[:job (jobs.farm.maintain {:worth 1200 :area {:plan "$plan:farm" :part "wheat"}})]]
  :expect [{:event {:source :job :kind :completed} :within-s 130 :of-job true}]
  :after [[:block [8 0 14] "torch"]]
  :limit-s 150}
 :cases
 [{:name "a-missing-plan-torch-is-mended"
   :body {:inventory [["torch" 2] ["wheat_seeds" 4]]}}
  {:name "a-missing-plan-torch-is-crafted-and-mended"
   :body {:inventory [["coal" 1] ["stick" 1] ["wheat_seeds" 4]]}}]}
