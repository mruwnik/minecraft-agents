;; Owner Q345 (work exposure): a dark spawnable cell counts only farther than 24 blocks from the body and reachable on foot.
;; A hungry body cooks in a walled yard in a dark cell (no torch): stone x 12..20, z 12..20, walls y 0..5, air x/z 13..19 (7x7,
;; no dark cell beyond 24 blocks, no way in).
{:defaults
 {:tags [:light :survival]
  :time :any
  :plot {:light :dark :height 8}
  :blocks [[:fill [12 0 12] [20 5 20] "stone"] [:fill [13 0 13] [19 5 19] "air"]]
  :body {:at [16.5 0 16.5] :inventory [["furnace" 1] ["porkchop" 4] ["coal" 2]] :effects [] :settle-s 2}
  :limit-s 170}
 :cases
 [{:name "cooks-in-a-walled-dark-yard"
   :act [[:job (jobs.movement.look-around)] [:await {:source :job :kind :completed} 30]
         [:rcon "effect give $BODY minecraft:hunger 5 243 true"] [:until-effect-gone "hunger" 30]
         [:rcon "damage $BODY 5 minecraft:generic"]
         [:job (jobs.survival.get-food {:explore false :carry 8})]]
   :expect [{:event {:source :job :kind :child_ended :data {:slot :cook}} :within-s 120 :of-job true}
            {:event {:source :job :kind :completed :data {:name "jobs.survival.get-food"}} :within-s 150}]
   :after [[:item "porkchop" 0]]}
  ;; 20x20 = 400 cells: past the old 100-cell yard cap, still no dark cell beyond 24 blocks.
  {:name "cooks-in-a-large-walled-dark-yard"
   :plot {:height 8 :length 40 :width 40}
   :blocks [[:fill [12 0 12] [33 5 33] "stone"] [:fill [13 0 13] [32 5 32] "air"]]
   :body {:at [22.5 0 22.5] :inventory [["furnace" 1] ["porkchop" 4] ["coal" 2]] :effects [] :settle-s 2}
   :act [[:job (jobs.movement.look-around)] [:await {:source :job :kind :completed} 30]
         [:rcon "effect give $BODY minecraft:hunger 5 243 true"] [:until-effect-gone "hunger" 30]
         [:rcon "damage $BODY 5 minecraft:generic"]
         [:job (jobs.survival.get-food {:explore false :carry 8})]]
   :expect [{:event {:source :job :kind :child_ended :data {:slot :cook}} :within-s 120 :of-job true}
            {:event {:source :job :kind :completed :data {:name "jobs.survival.get-food"}} :within-s 150}]
   :after [[:item "porkchop" 0]]}
  ;; Card 148371ab: the same rule under the night sky. A 7x7 yard walled 6 high and open above: no dark cell beyond 24 blocks,
  ;; so readiness lets the probe start at a dark yard cell; with a 2-wide gap in the wall the dark ground outside reaches it.
  {:name "probe-starts-in-a-walled-yard-under-the-night-sky"
   :time :night :time-why :night-light
   :plot {:light :sky :height 8}
   :body {:at [16.5 0 16.5] :settle-s 2 :effects [["resistance" 900 4]]}
   :act [[:job (jobs.movement.look-around)] [:await {:source :job :kind :completed} 30]
         [:job (jobs.debug.ready-probe {:at #at [14 0 14]})]]
   :expect [{:event {:source :job :kind :job.ready-probe} :within-s 40 :of-job true}]
   :limit-s 90}
  {:name "probe-waits-in-a-yard-with-a-gap-under-the-night-sky"
   :time :night :time-why :night-light
   :plot {:light :sky :height 8}
   :blocks [[:fill [12 0 12] [20 5 20] "stone"] [:fill [13 0 13] [19 5 19] "air"] [:fill [16 0 12] [17 1 12] "air"]]
   :body {:at [16.5 0 16.5] :settle-s 2 :effects [["resistance" 900 4]]}
   :act [[:job (jobs.movement.look-around)] [:await {:source :job :kind :completed} 30]
         [:job (jobs.debug.ready-probe {:at #at [14 0 14]})]]
   :expect [{:event {:source :job :kind :waiting :data {:reason :exposed}} :within-s 40 :of-job true}
            {:no-event {:source :job :kind :job.ready-probe} :for-s 30 :of-job true}]
   :limit-s 110}]}
