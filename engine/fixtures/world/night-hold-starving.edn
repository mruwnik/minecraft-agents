;; Card 8139d2dd: a night hold (exposed, nothing to dig in or build with) at food 0 or hurt and hungry, nothing edible carried, runs a
;; get-food child when no danger is near, instead of starving in the hold (the hungry reflex sits below night and cannot reach a held
;; body). Open flat plot at night, sword only, hungry and hurt by RCON, two NoAI cows 5 blocks east. Needs night (--allow-time).
;; Should-succeed: a cow is killed (food.killed). Should-fail: with a NoAI zombie 3 blocks away the body stays and hunts nothing.
{:defaults
 {:tags [:night :survival :get-food]
  :time :night
  :plot {:height 6}
  :body {:at [10.5 0 16.5] :settle-s 2 :inventory [["iron_sword" 1]]}
  :act [[:rcon "effect give $BODY minecraft:hunger 8 243 true"] [:until-effect-gone "hunger" 30]
        [:rcon "damage $BODY 3 minecraft:generic"]
        [:summon "cow" [15.5 0 16.5] "{NoAI:1b}"] [:summon "cow" [15.5 0 18.5] "{NoAI:1b}"] [:summon "cow" [16.5 0 17.5] "{NoAI:1b}"]]
  :limit-s 120}
 :cases
 [{:name "held-starving-body-hunts-a-cow"
   :act [[:job (jobs.survival.night {})]]
   :expect [{:event {:source :job :kind :food.killed} :within-s 100}]}
  {:name "held-starving-body-with-a-zombie-near-hunts-nothing"
   :act [[:summon "zombie" [10.5 0 19.5] "{NoAI:1b,equipment:{head:{id:\"minecraft:iron_helmet\",count:1}}}"]
         [:job (jobs.survival.night {})]]
   :expect [{:event {:source :job :kind :holding} :within-s 60 :of-job true}
            {:no-event {:source :job :kind :food.killed} :for-s 50}]}]}
