;; jobs.gather.mine, dark ore 6 blocks from the cut end (mine-wide-trench trench, ore at x 25; 7 away is marginal: eye-to-cell distance is over 7): unseen in the dark (:near 4),
;; seen from the cut end with a torch or soul torch in the OFF hand (engine.perception :near-torch 7, card 50602363/c0a17cad);
{:defaults
 {:tags [:mine :jobs] :time :any
  :plot {:height 12}
  :blocks [[:fill [2 -6 8] [30 6 24] "stone"] [:fill [16 0 16] [19 1 16] "air"]
           [:fill [20 -4 16] [24 1 16] "air"] [:set [25 0 16] "iron_ore"]]
  :body {:at [19.5 0 16.5] :inventory [["stone_pickaxe" 1] ["cobblestone" 16]] :effects [["resistance" 600 4]]}
  :limit-s 110}
 :cases
 [{:name "offhand-torch-sees-and-digs-ore-6-away"
   :act [[:rcon "item replace entity $BODY weapon.offhand with torch"] [:wait-s 2]
         [:job (jobs.gather.mine {:block "iron_ore" :count 1 :direction :east :tunnel-length 8})]]
   :expect [{:event {:source :job :kind :mine.done} :within-s 100 :of-job true}]
   :after [[:not-block [25 0 16] "iron_ore"]]}
  {:name "offhand-soul-torch-sees-and-digs-ore-6-away"
   :act [[:rcon "item replace entity $BODY weapon.offhand with soul_torch"] [:wait-s 2]
         [:job (jobs.gather.mine {:block "iron_ore" :count 1 :direction :east :tunnel-length 8})]]
   :expect [{:event {:source :job :kind :mine.done} :within-s 100 :of-job true}]
   :after [[:not-block [25 0 16] "iron_ore"]]}]}
