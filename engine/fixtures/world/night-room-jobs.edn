;; Card f0629ba4: a job with no :at judges its readiness where it will work, so a body shut in a torch-lit room at night is not
;; walked out into the dark by a search or a dig whose place lies outside. A 3x3 stone room at x 12..16, z 20..24 with a torch: its
;; feet cell is lit, so a check that judged only the body's own cell would let the job walk out.
;; Should-fail (wait, body stays in): explore.search roams; mine works at a :center outside.
;; Should-succeed: shear a sheep that stands inside the room.
;; The body looks round first (a hut is closed only as far as it has seen its walls).
;; Night: the sky must be dark for the room to be the shelter; run with --allow-time --time-log <the shared time log>.
{:defaults
 {:tags [:night :readiness :jobs]
  :plot {:floor "grass_block"}
  :time :night :time-why :dawn-decision
  :blocks [[:fill [12 0 20] [16 3 24] "stone" :hollow] [:fill [13 0 21] [15 2 23] "air"] [:set [13 0 21] "torch"]]
  :body {:at [14.5 0 22.5] :yaw 270 :settle-s 2 :inventory [["shears" 1] ["iron_pickaxe" 1]] :effects [["resistance" 900 4]]}
  :limit-s 60}
 :cases
 [{:name "search-waits-in-the-room-instead-of-roaming-out"
   :act [[:job (jobs.movement.look-around)] [:await {:source :job :kind :completed} 30]
         [:job (jobs.explore.search {:target "oak_log"})]]
   :expect [{:event {:source :job :kind :waiting :data {:reason :dark}} :within-s 30 :of-job true}
            {:no-event {:source :job :kind :completed :data {:name "jobs.explore.search"}} :for-s 15}]
   :after [[:body-near [14.5 0 22.5] 2]]}
  {:name "mine-waits-in-the-room-for-a-center-outside"
   :act [[:job (jobs.movement.look-around)] [:await {:source :job :kind :completed} 30]
         [:job (jobs.gather.mine {:block "stone" :count 1 :center #at [26 0 22] :radius 8})]]
   :expect [{:event {:source :job :kind :waiting} :within-s 30 :of-job true}
            {:no-event {:source :job :kind :completed :data {:name "jobs.gather.mine"}} :for-s 15}]
   :after [[:body-near [14.5 0 22.5] 2]]}
  {:name "shear-shears-a-sheep-inside-the-room"
   :act [[:job (jobs.movement.look-around)] [:await {:source :job :kind :completed} 30]
         [:summon "sheep" [14.5 0 21.5] "{NoAI:1b}"]
         [:until-seen {:entity "sheep"} 10]
         [:job (jobs.animals.shear {:radius 16})]]
   :expect [{:event {:source :job :kind :completed} :within-s 40 :of-job true}]}]}
