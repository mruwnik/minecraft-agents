;; The pen-gate reflex and jobs.animals.shut-gate: it shuts a PLANNED fence gate that stands open with the body away
;; (4 s, more than 2 and at most 64 blocks off), and leaves every other gate alone. Fence line z=12, x 10..22, gates at
;; [13 0 12] and [19 0 12], both open; the body at [16.5 0 16.5], 5 blocks from each, facing north (:yaw 180): the
;; reflex reads only gates it has seen, and the default view faces south.
;; Should-succeed: both planned gates shut; with one planned, only that one; a gate seen open 24 blocks away.
;; Should-fail (left alone): no plan, body standing in the gate, gate walled into glass (seen, never
;; reached: gave up; a stone wall hides the gate and the reflex never sees it).
{:defaults
 {:tags [:animals :triggers :pen-gate]
  :time :any
  :plot {:floor "grass_block"}
  :register [{:trigger :pen-gate}]
  :blocks [[:fill [10 0 12] [22 0 12] "oak_fence"]
           [:set [13 0 12] "oak_fence_gate[facing=south,open=true]"]
           [:set [19 0 12] "oak_fence_gate[facing=south,open=true]"]]
  :body {:at [16.5 0 16.5] :yaw 180}
  :limit-s 60}
 :cases
 [{:name "both-planned-gates-shut"
   :plans [{:id "pen" :parts [{:id "gates" :cells [#at [13 0 12] #at [19 0 12]] :want [:any "oak_fence_gate"]}]}]
   :expect [{:event {:source :reflex :kind :fired :context {:reflex-id :pen-gate}} :within-s 30}
            {:event {:source :reflex :kind :ended :context {:reflex-id :pen-gate} :data {:kind :done}} :within-s 50}]
   :after [[:block [13 0 12] "oak_fence_gate[open=false]"]
           [:block [19 0 12] "oak_fence_gate[open=false]"]]}
  {:name "only-the-planned-gate-shut"
   :plans [{:id "pen" :parts [{:id "gate" :cells [#at [13 0 12]] :want [:any "oak_fence_gate"]}]}]
   :expect [{:event {:source :reflex :kind :ended :context {:reflex-id :pen-gate} :data {:kind :done}} :within-s 50}]
   :after [[:block [13 0 12] "oak_fence_gate[open=false]"]
           [:block [19 0 12] "oak_fence_gate[open=true]"]]}
  {:name "unplanned-gates-left-open"
   :expect [{:no-event {:source :reflex :kind :fired :context {:reflex-id :pen-gate}} :for-s 20}]
   :after [[:block [13 0 12] "oak_fence_gate[open=true]"]
           [:block [19 0 12] "oak_fence_gate[open=true]"]]}
  {:name "body-in-the-gate-left-open"
   :plans [{:id "pen" :parts [{:id "gate" :cells [#at [13 0 12]] :want [:any "oak_fence_gate"]}]}]
   :blocks [[:fill [19 0 12] [19 0 12] "oak_fence"]]
   :body {:at [13.5 0 12.5]}
   :expect [{:no-event {:source :reflex :kind :fired :context {:reflex-id :pen-gate}} :for-s 20}]
   :after [[:block [13 0 12] "oak_fence_gate[open=true]"]]}
  ;; card 9a1d3b27: the reflex radius is 64, so a gate left open far behind the body (here ~24 away, in view) is walked back to and shut
  {:name "far-gate-in-view-walked-back-and-shut"
   :plans [{:id "pen" :parts [{:id "gate" :cells [#at [2 0 28]] :want [:any "oak_fence_gate"]}]}]
   :blocks [[:fill [13 0 12] [13 0 12] "oak_fence"] [:fill [19 0 12] [19 0 12] "oak_fence"]
            [:set [2 0 28] "oak_fence_gate[facing=south,open=true]"]]
   :body {:at [16.5 0 8.5] :yaw 0}
   :expect [{:event {:source :reflex :kind :fired :context {:reflex-id :pen-gate}} :within-s 30}
            {:event {:source :reflex :kind :ended :context {:reflex-id :pen-gate} :data {:kind :done}} :within-s 80}]
   :after [[:block [2 0 28] "oak_fence_gate[open=false]"]]
   :limit-s 100}
  {:name "gate-walled-into-stone-gives-up"
   :plans [{:id "pen" :parts [{:id "gate" :cells [#at [16 0 4]] :want [:any "oak_fence_gate"]}]}]
   :blocks [[:fill [13 0 12] [13 0 12] "oak_fence"] [:fill [19 0 12] [19 0 12] "oak_fence"]
            [:fill [14 0 2] [18 3 9] "glass"]
            [:set [16 0 4] "oak_fence_gate[facing=south,open=true]"]]
   :body {:at [16.5 0 10.5]}
   :expect [{:event {:source :job :kind :shut-gate.gave-up :data {:cell #at [16 0 4]}} :within-s 50}]
   :after [[:block [16 0 4] "oak_fence_gate[open=true]"]]}
  {:name "gate-out-of-reach-of-a-sealed-body-names-the-blocker"
   :plans [{:id "pen" :parts [{:id "gate" :cells [#at [16 0 3]] :want [:any "oak_fence_gate"]}]}]
   :blocks [[:fill [14 0 8] [18 3 12] "glass"] [:fill [15 0 9] [17 2 11] "air"]
            [:set [16 0 3] "oak_fence_gate[facing=south,open=true]"]]
   :body {:at [16.5 0 10.5]}
   :expect [{:event {:source :job :kind :shut-gate.gave-up :message [:contains "stays open: unreachable ("] :data {:cell #at [16 0 3] :blocker [:any]}} :within-s 50}]
   :after [[:block [16 0 3] "oak_fence_gate[open=true]"]]}]}
