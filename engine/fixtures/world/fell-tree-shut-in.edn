;; Cards c1d4d2b2 (harvest-wood waits for day while the body is shut in for the night, no :no-tree ending), 5b9f0652 (a body shut in
;; by its own fences ends with a reason, not a bare "no reachable tree"). An oak at x 26, z 16 (5 logs, persistent leaves).
;; Night case: a stone room x 14..18, z 14..18, roof at y 2, a torch inside; the body is in it, above ground at night.
;; A glass east wall puts the tree in sight (else its own :no-tree wait comes before the safe? reason). Should-succeed: harvest-wood in the room parks with waiting :dark (its safe? is safe-if-lit). Should-fail: it never ends :no-tree/tree_blocked.
;; Pen case (day): oak_fence ring x 12..20, z 12..20; fell-tree ends (or walks out and fells); a tree_blocked it warns carries :why.
;; Unsure (65%): whether go-to digs the fences with the carried axe; if so the body walks out and fells the tree.
{:defaults
 {:tags [:forestry :fell-tree :harvest-wood :night] :time :day
  :plot {:height 8 :floor "grass_block"}
  :blocks [[:fill [26 0 16] [26 4 16] "oak_log"] [:fill [25 4 15] [27 5 17] "oak_leaves[persistent=true]"] [:set [26 4 16] "oak_log"]]
  :body {:at [16.5 0 16.5] :settle-s 2 :inventory [["iron_axe" 1]] :effects [["resistance" 600 4]]}
  :limit-s 90}
 :cases
 [{:name "shut-in-room-at-night-waits-for-day"
   :time :night
   :register []
   :blocks [[:fill [14 0 14] [18 2 18] "stone"] [:fill [15 0 15] [17 1 17] "air"] [:set [15 0 15] "torch"] [:fill [18 0 15] [18 1 17] "glass"]]
   :act [[:job (jobs.forestry.harvest-wood {:radius 24})]]
   :expect [{:event {:source :job :kind :waiting :data {:reason :dark}} :within-s 40 :of-job true}
            {:no-event {:source :job :kind #{:stopped :tree_blocked}} :for-s 40}]
   :after [[:block [26 0 16] "oak_log"] [:body-near [16.5 0 16.5] 2]]}
  {:name "fenced-in-body-ends-with-a-reason-not-a-bare-no-reachable-tree"
   :blocks [[:fill [12 0 12] [20 1 12] "oak_fence"] [:fill [12 0 20] [20 1 20] "oak_fence"]
            [:fill [12 0 13] [12 1 19] "oak_fence"] [:fill [20 0 13] [20 1 19] "oak_fence"]]
   :act [[:job (jobs.forestry.fell-tree {:radius 24})]]
   :expect [{:event {:source :job :kind #{:stopped :completed}} :within-s 80 :of-job true}
            {:no-event {:source :job :kind :tree_blocked :data {:why [:not [:any]]}} :for-s 60 :until {:source :job :kind #{:stopped :completed}}}]
   :limit-s 90}]}
