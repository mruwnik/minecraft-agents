;; Card 815bc47b: a listed enter-room or dig-pit at night waits when its go-to says :later (a hostile near), it does not end no-walk /
;; walk-failed (owner Q330: a root job waits, a called child reports). Under night/shut-in the calls pass :checks (always) and never wait.
;; The enter-room wait is pinned by enter-room-test (go-to's walk is priced, so no fixture makes it say :later on a NoAI zombie).
;; Case 1: dig-pit :for :night standing on thick open stone completes its pit (the standalone night path).
;; Case 2: the same with a NoAI zombie 5 off on the dig side: the pit is still dug and roofed (it never ends :lays-open).
;; Both run by day: dig-pit reads the job's :for arg, and the helmeted NoAI zombie does not burn.
{:defaults
 {:tags [:night :survival]
  :time :any
  :mobs :keep
  :plot {:height 10 :length 64 :width 32}
  :body {:at [4.5 0 16.5] :effects [["resistance" 600 4]] :inventory [["cobblestone" 16] ["stone_pickaxe" 1]] :settle-s 4}}
 :cases
 [{:name "dig-pit-for-night-completes-on-open-stone"
   :blocks [[:fill [0 -6 0] [63 -1 31] "stone"]]
   :act [[:job (jobs.survival.dig-pit {:for :night})]]
   :expect [{:event {:source :job :kind :completed} :within-s 60 :of-job true}]
   :limit-s 80}
  {:name "dig-pit-for-night-with-a-zombie-five-off-completes-roofed"
   :blocks [[:fill [0 -6 0] [63 -1 31] "stone"]]
   :act [[:summon "zombie" [9.5 0 16.5] "{NoAI:1b,equipment:{head:{id:\"minecraft:iron_helmet\",count:1}}}"]
         [:job (jobs.survival.dig-pit {:for :night})]]
   :expect [{:event {:source :job :kind :completed} :within-s 60 :of-job true}
            {:no-event {:source :job :kind :stopped :data {:reason :lays-open}} :for-s 60 :until {:source :job :kind :completed} :of-job true}]
   :limit-s 80}]}
