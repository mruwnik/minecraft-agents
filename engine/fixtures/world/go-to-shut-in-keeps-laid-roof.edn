;; A body at the bottom of a 2x1 shaft whose top is a 2-block dirt roof laid flush with the stone top, carrying dirt and a pickaxe, go-to a goal
;; 17 east on the top. A 6-block stone wall at the shaft's foot opens to a stair trench that climbs to the top. Dirt over open air is a laid roof,
;; priced as a build (cost/placed-roof?), not free natural dirt. The go-to leaves by the door and the trench; a pillar called with a small :worth stops :ceiling at the roof.
;; Plot lit roofed, stone x 10..38, y -4..1; shaft x 16..17 z 16, feet y -3; roof dirt [16 1 16] [17 1 16]; door stone x 18..23 y -3; trench stairs x 24..28.
;; Should-succeed: go-to arrives with both roof blocks still dirt; the pillar ends :stopped :ceiling with them still dirt.
;; Should-fail: a roof block dug, no arrival, or the pillar done.
{:defaults
 {:tags [:movement :go-to]
  :time :any
  :plot {:height 14 :length 40}
  :blocks [[:fill [10 -4 10] [38 1 22] "stone"]
           [:fill [16 -3 16] [17 0 16] "air"]
           [:fill [16 1 16] [17 1 16] "dirt"]
           [:set [17 -1 16] "light[level=15]"]
           [:fill [18 -3 16] [23 -3 16] "stone"]
           [:fill [24 -3 16] [24 1 16] "air"]
           [:fill [25 -2 16] [25 1 16] "air"]
           [:fill [26 -1 16] [26 1 16] "air"]
           [:fill [27 0 16] [27 1 16] "air"]
           [:fill [28 1 16] [28 1 16] "air"]]
  :body {:at [16.5 -3 16.5] :settle-s 3 :inventory [["dirt" 8] ["iron_pickaxe" 1]]}
  :limit-s 150}
 :cases
 [{:name "shut-in-body-leaves-by-the-door-and-keeps-the-dirt-roof"
   :act [[:job (jobs.movement.go-to {:pos #at [33 2 16] :range 1})]]
   :expect [{:event {:source :job :kind :completed :data {:arrived true}} :within-s 140 :of-job true}]
   :after [[:block [16 1 16] "dirt"] [:block [17 1 16] "dirt"] [:body-near [33.5 2 16.5] 3]]}
  {:name "pillar-under-a-laid-dirt-roof-stops-at-it-when-its-put-back-costs-more-than-the-call-is-worth"
   :act [[:job (jobs.access.pillar {:height 5 :here true :worth 0.5})]]
   :expect [{:event {:source :job :kind :stopped :data {:reason :ceiling}} :within-s 60 :of-job true}]
   :after [[:block [16 1 16] "dirt"] [:block [17 1 16] "dirt"]]}]}
