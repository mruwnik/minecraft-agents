;; Cards f9d9aaba (8fca53030), 7e4c33b0: a body killed by a skeleton it no longer sees is unarmed and weighs its pile with the killer
;; remembered there (walk-risk on go-to's quote: a death spot not seen clear): the reflex stops condition-failed :danger, no walk; the died
;; reflex rests meanwhile (no refire on its 30 s cooldown). The pile (24 raw_iron) lies at [26 0 26], where an arrow-damage kill by a NoAI skeleton
;; (removed at once) takes the body (no resistance: the damage must kill); it respawns at [4 0 4]. An empty-handed death has no pile:
;; a skip, no walk. A pile cheapened by :value-overrides with a zombie by it: a danger skip, no walk. A whole iron kit
;; with six skeletons on the way back: a danger skip, no walk.
{:defaults
 {:tags [:survival :death :jobs]
  :time :any
  :mobs :keep
  :register [{:trigger :died}]
  :body {:at [26.5 0 26.5] :spawnpoint [4 0 4] :inventory [["raw_iron" 24] ["cobblestone" 64]]}
  :limit-s 200}
 :cases
 [{:name "unseen-killer-at-the-pile-skips-and-rests"
   :act [[:summon "skeleton" [27.5 0 26.5] "{NoAI:1b,Silent:1b,active_effects:[{id:\"minecraft:fire_resistance\",duration:99999}]}"]
         [:until-seen {:entity "skeleton"} 10]
         [:rcon "damage $BODY 100 minecraft:arrow by @e[type=skeleton,tag=wt,$BOX,limit=1]"]
         [:rcon "kill @e[type=skeleton,tag=wt,$BOX]"]
         [:await {:source :body :kind :respawned} 30]]
   :expect [{:event {:source :job :kind :stopped :data {:reason :danger}} :within-s 60}
            {:no-event {:source :job :kind :child_started :data {:slot :go}} :for-s 40 :until {:source :job :kind :stopped :data {:reason :danger}}}
            {:count-event {:source :reflex :kind :fired :context {:reflex-id :died}} :for-s 50 :at-least 1 :at-most 1}]
   :limit-s 80}
  {:name "empty-handed-death-is-a-skip-with-no-walk"
   :body {:inventory []}
   :act [[:kill-body]
         [:await {:source :body :kind :respawned} 30]]
   :expect [{:event {:source :job :kind :stopped :data {:decision :skip}} :within-s 60}
            {:no-event {:source :job :kind :child_started :data {:slot :go}} :for-s 30}]
   :after [[:body-near [4.5 0 4.5] 4]]
   :limit-s 80}
  {:name "guarded-pile-is-left-when-its-danger-costs-more-than-it-is-worth"
   :register [{:trigger :died :why "value-overrides cheapen the pile below the walk past the zombie" :job (jobs.survival.recover-drops {:value-overrides {"raw_iron" 1 "cobblestone" 0.05}})}]
   :act [[:summon "zombie" [31.5 0 26.5] "{NoAI:1b,Silent:1b,active_effects:[{id:\"minecraft:fire_resistance\",duration:99999}]}"]
         [:until-seen {:entity "zombie"} 10]
         [:kill-body]
         [:await {:source :body :kind :respawned} 30]]
   :expect [{:event {:source :job :kind :stopped :data {:reason :danger}} :within-s 60}
            {:event {:source :reflex :kind :ended :data {:decision :skip}} :within-s 300}
            {:no-event {:source :job :kind :child_started :data {:slot :go}} :for-s 30}]
   :after [[:body-near [4.5 0 4.5] 4]]
   :limit-s 320}
  {:name "pile-with-an-adjacent-zombie-is-left-when-the-danger-costs-more"
   :register [{:trigger :died :why "value-overrides cheapen the pile below the walk past the zombie" :job (jobs.survival.recover-drops {:value-overrides {"raw_iron" 1 "cobblestone" 0.05}})}]
   :act [[:summon "zombie" [27.5 0 26.5] "{NoAI:1b,Silent:1b,active_effects:[{id:\"minecraft:fire_resistance\",duration:99999}]}"]
         [:until-seen {:entity "zombie"} 10]
         [:kill-body]
         [:await {:source :body :kind :respawned} 30]]
   :expect [{:event {:source :job :kind :stopped :data {:reason :danger}} :within-s 60}
            {:event {:source :reflex :kind :ended :data {:decision :skip}} :within-s 300}
            {:no-event {:source :job :kind :child_started :data {:slot :go}} :for-s 30}]
   :after [[:body-near [4.5 0 4.5] 4]]
   :limit-s 320}
  {:name "kit-pile-left-to-a-skeleton-pack-that-would-kill-an-unarmed-body"
   :register []
   :body {:inventory [["iron_pickaxe" 1] ["iron_sword" 1] ["iron_axe" 1] ["iron_shovel" 1] ["iron_helmet" 1] ["iron_chestplate" 1]
                      ["iron_leggings" 1] ["iron_boots" 1] ["raw_iron" 24]]}
   :act [[:kill-body]
         [:await {:source :body :kind :respawned} 30]
         [:until [:memory {:entries {:deaths [{:data {:pos [:any]}}]}}] 15]
         [:summon "skeleton" [14.5 0 16.5] "{NoAI:1b,Silent:1b,active_effects:[{id:\"minecraft:fire_resistance\",duration:99999}]}"]
         [:summon "skeleton" [15.5 0 16.5] "{NoAI:1b,Silent:1b,active_effects:[{id:\"minecraft:fire_resistance\",duration:99999}]}"]
         [:summon "skeleton" [16.5 0 16.5] "{NoAI:1b,Silent:1b,active_effects:[{id:\"minecraft:fire_resistance\",duration:99999}]}"]
         [:summon "skeleton" [17.5 0 16.5] "{NoAI:1b,Silent:1b,active_effects:[{id:\"minecraft:fire_resistance\",duration:99999}]}"]
         [:summon "skeleton" [18.5 0 16.5] "{NoAI:1b,Silent:1b,active_effects:[{id:\"minecraft:fire_resistance\",duration:99999}]}"]
         [:summon "skeleton" [19.5 0 16.5] "{NoAI:1b,Silent:1b,active_effects:[{id:\"minecraft:fire_resistance\",duration:99999}]}"]
         [:until-seen {:entity "skeleton"} 10]
         [:job (jobs.survival.recover-drops)]]
   :expect [{:event {:source :job :kind :waiting :data {:reason :danger}} :within-s 60}
            {:no-event {:source :job :kind :child_started :data {:slot :go}} :for-s 40}]
   :limit-s 120}]}
