;; An unarmed body on a long serpentine walk meets a NoAI zombie it can only get past by the corridor it stands in. The
;; reflex flees it; the walk then goes on again. Fleeing the same still mob from the same place with nothing new seen must
;; not repeat for ever: the body decides again (fight it or get past) and arrives.
{:tags [:movement :go-to :danger]
 :name "unarmed-body-meets-still-zombie-mid-route-arrives"
 :time :any
 :mobs :keep
 :register [{:trigger :hostile-near}]
 :plot {:height 8 :length 96 :width 32}
 :blocks [[:fill [12 0 0] [12 2 25] "stone"] [:fill [24 0 6] [24 2 31] "stone"] [:fill [36 0 0] [36 2 25] "stone"]
          [:fill [48 0 6] [48 2 31] "stone"] [:fill [60 0 0] [60 2 25] "stone"] [:fill [72 0 6] [72 2 31] "stone"]
          [:fill [84 0 0] [84 2 25] "stone"]]
 :body {:at [4.5 0 4.5] :effects [["resistance" 900 4]]}
 :act [[:summon "zombie" [44.5 0 16.5] "{NoAI:1b,Tags:[\"wt\"],equipment:{head:{id:\"minecraft:iron_helmet\",count:1}}}"]
       [:job (jobs.movement.go-to {:pos #at [92 0 4] :range 1})]]
 :expect [{:event {:source :job :kind :completed :data {:arrived true}} :within-s 260 :of-job true}]
 :after [[:body-near [92.5 0 4.5] 2]]
 :limit-s 270}
