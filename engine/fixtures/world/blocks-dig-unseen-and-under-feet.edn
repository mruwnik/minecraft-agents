;; Cards ec7aaf35 (an unseen target is not the stone guess), bdf979bd / 3b38404c / f6578081 (the block under the feet is dug from beside).
;; unseen-dirt-needs-no-tool: the body faces north, a dirt cell lies behind it; blocks.dig :ways #{:carried} and no tool digs it (an unseen cell
;; is not read as stone, which would wait :no-tool). A stone cell in the same place waits :no-tool (blocks-dig-place.edn).
;; Slab x 12..20, z 12..20, y 0..2, the body on top (feet y 3). dig-under-feet-steps-aside: blocks.dig of the cell under the feet steps off its
;; column to a side cell first (result :stepped-aside) and digs; the body stays up. from-plan-clear-cell-under-feet: a plan cell wanted
;; :clear under the feet is dug the same way (done, not refused). Should-fail/control: :accept [:under-feet] digs from on top and the body drops one block.
{:defaults
 {:tags [:blocks :build] :time :any
  :plot {:height 8}
  :body {:at [16.5 0 16.5] :settle-s 2 :effects [["resistance" 600 4]]}
  :limit-s 90}
 :cases
 [{:name "unseen-dirt-needs-no-tool"
   :blocks [[:set [16 0 19] "dirt"]]
   :body {:yaw 180}
   :act [[:job (jobs.blocks.dig {:pos #at [16 0 19] :ways #{:carried}})]]
   :expect [{:event {:source :job :kind :completed :data {:dug true :reason :dug}} :within-s 60 :of-job true}
            {:no-event {:source :job :kind :waiting :data {:reason :no-tool}} :for-s 60 :until {:source :job :kind #{:completed :stopped} :data {:dug [:any]}}}]
   :after [[:block [16 0 19] "air"] [:item "dirt" [:>= 1]]]}
  {:name "dig-under-feet-steps-aside"
   :blocks [[:fill [12 0 12] [20 2 20] "stone"]]
   :body {:at [16.5 3 16.5] :inventory [["iron_pickaxe" 1]]}
   :act [[:job (jobs.blocks.dig {:pos #at [16 2 16]})]]
   :expect [{:event {:source :job :kind :completed :data {:dug true :stepped-aside [:any]}} :within-s 80 :of-job true}]
   :after [[:block [16 2 16] "air"] [:body-near [16.5 3 16.5] 2.5]]}
  {:name "from-plan-clear-cell-under-feet"
   :blocks [[:fill [12 0 12] [20 2 20] "stone"]]
   :body {:at [16.5 3 16.5] :inventory [["iron_pickaxe" 1]]}
   :plans [{:id "hole" :metadata {:by "$body"} :parts [{:id "cell" :cells [#at [16 2 16]] :want :clear}]}]
   :act [[:job (jobs.build.from-plan {:plan "$plan:hole"})]]
   :expect [{:event {:source :job :kind :completed :data {:missing []}} :within-s 80 :of-job true}
            {:no-event {:source :job :kind :stopped} :for-s 80 :until {:source :job :kind :completed}}]
   :after [[:block [16 2 16] "air"] [:body-near [16.5 3 16.5] 2.5]]}
  {:name "accept-under-feet-digs-from-on-top"
   :blocks [[:fill [12 0 12] [20 2 20] "stone"]]
   :body {:at [16.5 3 16.5] :inventory [["iron_pickaxe" 1]]}
   :act [[:job (jobs.blocks.dig {:pos #at [16 2 16] :accept [:under-feet]})]]
   :expect [{:event {:source :job :kind :completed :data {:dug true}} :within-s 80 :of-job true}]
   :after [[:block [16 2 16] "air"] [:body-near [16.5 2 16.5] 0.8]]}
  {:name "dig-of-a-block-no-stand-sees-digs-through"
   ;; card afc91332: no stand in range sees a block buried in rock, so the planner refuses before any search (not a flood to its node budget).
   ;; card 82c4902e: the refused walk is followed by digging the seen blocks in the line, as a player does, then the block.
   :blocks [[:fill [12 0 12] [20 2 20] "stone"]]
   :body {:at [16.5 3 16.5] :inventory [["iron_pickaxe" 1]]}
   :act [[:job (jobs.blocks.dig {:pos #at [16 0 16]})]]
   :expect [{:event {:source :job :kind :completed :data {:dug true :reason :dug}} :within-s 110 :of-job true}
            {:no-event {:source :job :kind :planned :data {:why "budget"}} :for-s 110 :until {:source :job :kind #{:completed :stopped}}}]
   :after [[:block [16 0 16] "air"]]
   :limit-s 120}
  {:name "dig-through-when-the-pocket-beside-it-is-unconnected"
   ;; a closed air pocket beside the buried block has a stone floor, so a stand looks possible; no walk reaches it, so the walk fails and the stone in the line is dug.
   :blocks [[:fill [12 0 12] [20 2 20] "stone"] [:set [17 1 16] "air"]]
   :body {:at [16.5 3 16.5] :inventory [["iron_pickaxe" 1]]}
   :act [[:job (jobs.blocks.dig {:pos #at [16 1 16]})]]
   :expect [{:event {:source :job :kind :completed :data {:dug true :reason :dug}} :within-s 110 :of-job true}
            {:no-event {:source :job :kind :planned :data {:why "budget"}} :for-s 110 :until {:source :job :kind #{:completed :stopped}}}]
   :after [[:block [16 1 16] "air"]]
   :limit-s 120},
  {:name "ore-overhead-in-a-shut-room-is-reached-by-pillaring"
   ;; the ore is 5 above the floor in the wall of a sealed stone room: no walk gets within reach, so the body stacks cobble under itself and digs it.
   :plot {:height 14}
   :blocks [[:fill [13 3 13] [19 12 19] "stone"] [:fill [14 3 14] [18 11 18] "air"] [:set [19 8 16] "iron_ore"]]
   :body {:at [16.5 3 16.5] :inventory [["iron_pickaxe" 1] ["cobblestone" 8]]}
   :act [[:job (jobs.blocks.dig {:pos #at [19 8 16]})]]
   :expect [{:event {:source :job :kind :completed :data {:dug true :reason :dug}} :within-s 110 :of-job true}]
   :after [[:block [19 8 16] "air"] [:item "raw_iron" [:>= 1]]]
   :limit-s 120}]}
