{:facts engine.triggers.fact-table/table

 ;; The default trigger set: id -> trigger fn, default job, args and persistence. Order means nothing;
 ;; a body's register (its config) orders its triggers.
 :triggers
 [{:id :suffocating :when engine.triggers.suffocating/suffocating :job (jobs.survival.breathe) :args engine.triggers.suffocating/defaults :persistence :cooldown :cooldown-s 0}
  {:id :burning :when engine.triggers.burning/burning :job (jobs.survival.extinguish) :args {} :persistence :cooldown :cooldown-s 0}
  {:id :wedged :when engine.triggers.wedged/wedged :job (jobs.survival.unwedge) :args {} :persistence :cooldown :cooldown-s 0}
  {:id :hostile-near :when engine.triggers.hostile-near/hostile-near :job (jobs.survival.respond-to-hostile) :args engine.triggers.hostile-near/defaults :persistence :retry}
  {:id :hungry :when engine.triggers.hungry/hungry :job (jobs.survival.get-food) :args engine.triggers.hungry/defaults :persistence :cooldown :cooldown-s 90}
  {:id :night :when engine.triggers.night/night :job (jobs.survival.night) :args engine.triggers.night/defaults :persistence :cooldown :cooldown-s 10}
  {:id :stuck :when engine.triggers.stuck/stuck :job (jobs.maintenance.unstick) :args engine.triggers.stuck/defaults :persistence :cooldown :cooldown-s 60}
  {:id :died :when engine.triggers.died/died :job (jobs.survival.recover-drops) :args {} :persistence :cooldown :cooldown-s 30}
  {:id :pen-gate :when engine.triggers.pen-gate/pen-gate :job (jobs.animals.shut-gate) :args engine.triggers.pen-gate/defaults :persistence :cooldown :cooldown-s 5}
  {:id :door-left :when engine.triggers.door-left/door-left :job (jobs.maintenance.shut-doors) :args engine.triggers.door-left/defaults :persistence :cooldown :cooldown-s 5}
  {:id :inventory-nearly-full :when engine.triggers.inventory-nearly-full/inventory-nearly-full :job (jobs.storage.make-room) :args engine.triggers.inventory-nearly-full/defaults :persistence :cooldown :cooldown-s 120}
  {:id :scaffold-left :when engine.triggers.scaffold-left/scaffold-left :job (jobs.access.cleanup) :args {} :persistence :stop}
  {:id :tidy-pending :when engine.triggers.tidy-pending/tidy-pending :job (jobs.survival.restore-broken) :args engine.triggers.tidy-pending/defaults :persistence :cooldown :cooldown-s 10}
  {:id :mounted :when engine.triggers.mounted/mounted :job (jobs.movement.leave-vehicle) :args {} :persistence :stop :cooldown-s 0}
  {:id :player-joined :when engine.triggers.player-joined/player-joined :job (jobs.debug.notify {:text "player joined"}) :args engine.triggers.player-joined/defaults :persistence :cooldown :cooldown-s engine.triggers.player-joined/default-window-s}]}
