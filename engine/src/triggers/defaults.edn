{:library jobs.lib.cond/library

 ;; The default trigger set: id -> trigger fn, default job, args and persistence. The order here is the default
 ;; register's priority (most urgent first), used when a scenario has no :register; an explicit :register orders its own.
 ;; :level: the interrupt level, :danger (never waits), :urgent or :comfort (waits for a running job's section at or
 ;; above it, up to the level's cap; see engine.core.schedule). A :when may return a level instead of true.
 ;; :backoff (engine.backoff): the entry's default. Off for danger reflexes (no backoff while the danger lasts), for night
 ;; (time-critical, bounds itself). {:after 9} where one firing may take several fruitless runs (two unreachable doors or gates).
 ;; A job ending impossible stops its entry until the trigger lets go (engine.core.settle/judge-end!).
 :triggers
 [{:id :suffocating :level :danger :when triggers.survival.suffocating/suffocating :job (jobs.survival.breathe) :args triggers.survival.suffocating/defaults :persistence :cooldown :cooldown-s 0 :backoff false}
  {:id :burning :level :danger :when triggers.survival.burning/burning :job (jobs.survival.extinguish) :args {} :persistence :cooldown :cooldown-s 0 :backoff false}
  {:id :wedged :level :danger :when triggers.survival.wedged/wedged :job (jobs.survival.unwedge) :args {} :persistence :cooldown :cooldown-s 0}
  {:id :died :level :danger :when triggers.survival.died/died :job (jobs.survival.recover-drops) :args {} :persistence :cooldown :cooldown-s 30}
  {:id :hostile-near :level :danger :when triggers.survival.hostile-near/hostile-near :job (jobs.survival.respond-to-hostile) :args triggers.survival.hostile-near/defaults :persistence :retry :backoff false}
  {:id :poisoned :level :urgent :when triggers.survival.poisoned/poisoned :job (jobs.survival.cure) :args {} :persistence :cooldown :cooldown-s 10}
  {:id :night :level :urgent :when triggers.survival.night/night :job (jobs.survival.night) :args triggers.survival.night/defaults :persistence :cooldown :cooldown-s 10 :backoff false}
  {:id :low-health :level :urgent :when triggers.survival.low-health/low-health :job (jobs.survival.rest) :args {} :persistence :cooldown :cooldown-s 30}
  {:id :dawn :level :urgent :when triggers.survival.dawn/dawn :job (jobs.survival.leave-shelter) :args {} :persistence :cooldown :cooldown-s 10 :backoff false}
  {:id :dusk-home :level :urgent :when triggers.survival.dusk-home/dusk-home :job (jobs.survival.go-home) :args {:commute? true} :persistence :cooldown :cooldown-s 60}
  {:id :hungry :level :comfort :when triggers.survival.hungry/hungry :job (jobs.survival.get-food {:carry 0}) :args triggers.survival.hungry/defaults :persistence :cooldown :cooldown-s 90 :backoff {:first-s 120 :max-s 1800}}
  {:id :stuck-underground :level :comfort :when triggers.survival.stuck-underground/stuck-underground :job (jobs.survival.go-home {:limit 1000}) :args triggers.survival.stuck-underground/defaults :persistence :cooldown :cooldown-s 300 :backoff {:first-s 120 :max-s 1800}}
  {:id :needs-bed :level :comfort :when triggers.survival.needs-bed/needs-bed :job (jobs.items.obtain {:any-of ["white_bed" "orange_bed" "magenta_bed" "light_blue_bed" "yellow_bed" "lime_bed" "pink_bed" "gray_bed" "light_gray_bed" "cyan_bed" "purple_bed" "blue_bed" "brown_bed" "green_bed" "red_bed" "black_bed"] :count 1 :explore true}) :args triggers.survival.needs-bed/defaults :persistence :cooldown :cooldown-s 600 :backoff {:after 1 :first-s 300 :max-s 1800}}
  {:id :needs-weapon :level :comfort :when triggers.survival.needs-weapon/needs-weapon :job (jobs.items.obtain {:any-of ["iron_sword" "stone_sword" "wooden_sword"] :count 1 :explore true}) :args {} :persistence :cooldown :cooldown-s 600}
  {:id :door-left :level :comfort :when triggers.maintenance.door-left/door-left :job (jobs.maintenance.shut) :args triggers.maintenance.door-left/defaults :persistence :cooldown :cooldown-s 5 :backoff {:after 9}}
  {:id :inventory-nearly-full :level :comfort :when triggers.storage.inventory-nearly-full/inventory-nearly-full :job (jobs.storage.make-room) :args triggers.storage.inventory-nearly-full/defaults :persistence :cooldown :cooldown-s 120}
  {:id :scaffold-left :level :comfort :when triggers.access.scaffold-left/scaffold-left :job (jobs.access.cleanup) :args triggers.access.scaffold-left/defaults :persistence :stop}
  {:id :tidy-pending :level :comfort :when triggers.survival.tidy-pending/tidy-pending :job (jobs.survival.restore-broken) :args triggers.survival.tidy-pending/defaults :persistence :cooldown :cooldown-s 10}
  {:id :pen-gate :level :comfort :when triggers.animals.pen-gate/pen-gate :job (jobs.maintenance.shut {:openings :gates}) :args triggers.animals.pen-gate/defaults :persistence :cooldown :cooldown-s 5 :backoff {:after 9}}
  {:id :mounted :level :comfort :when triggers.movement.mounted/mounted :job (jobs.movement.leave-vehicle) :args {} :persistence :cooldown :cooldown-s 30}
  {:id :part-cut-tree :level :comfort :when triggers.forestry.part-cut-tree/part-cut-tree :job (jobs.forestry.fell-tree {:part-cut? true :ways #{:carried :pillar}}) :args triggers.forestry.part-cut-tree/defaults :persistence :cooldown :cooldown-s 300}
  {:id :replant-owed :level :comfort :when triggers.forestry.replant-owed/replant-owed :job (jobs.forestry.plant-sapling {:ways #{:carried}}) :args {} :persistence :cooldown :cooldown-s 60}
  {:id :dark-work :level :comfort :when triggers.survival.dark-work/dark-work :job (jobs.build.light-area {:near 3}) :args triggers.survival.dark-work/defaults :persistence :cooldown :cooldown-s 10 :backoff {:after 9}}
  {:id :ore-seen :level :comfort :when triggers.gather.ore-seen/ore-seen :job (jobs.gather.pick-ores) :args triggers.gather.ore-seen/defaults :persistence :cooldown :cooldown-s 5 :backoff {:after 9}}
  {:id :loose-items :level :comfort :when triggers.items.loose-items/loose-items :job (jobs.items.pick-up-loose) :args triggers.items.loose-items/defaults :persistence :cooldown :cooldown-s 30}]}
