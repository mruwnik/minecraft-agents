;; Cut and replant oak, then put the wood in a known chest. Deposit declines
;; until body memory has a :chest entry, and sleep needs a :bed entry.
{:register [{:trigger :hostile-near}
            {:trigger :health-low}
            {:trigger :night-and-bed-known}]
 :queue [{:job :harvest-wood :args {:species "oak" :radius 16}}
         {:job :deposit :args {}}]}
