;; Stay alive and otherwise idle. The reflexes are registered in priority
;; order, most urgent first: air, fire, a block at the feet, hostiles, night (the shelter, and getting out of it by day), food (which heals),
;; logging out when another player sleeps, a door a walk left open, then a death's drops, then a full
;; inventory, then the safety nets: scaffold a job left (taken back only once its job is no longer live, so it
;; never cuts the job that built it) and trespass digs to restore. Between reflexes the body looks around, one look per round, so it visibly idles. A reflex job that
;; declines or is done is dropped, and the trigger fires it again once its cooldown (counted from the job ending)
;; has passed; the dangers (air, fire) have none. A reflex job cut by a higher one is fired again by its trigger,
;; whose condition holds until the work is done. Hostiles sit above food: respond-to-hostile already flees when
;; hurt and fights only when healthy (or cornered). The night sits above food: the shelter eats while it holds, and
;; get-food must not walk off at night.
{:register [{:trigger :suffocating :persistence :cooldown :cooldown-s 0 :args {:min-oxygen 12}
             :job (jobs.survival.breathe {:min-oxygen 12})}
            {:trigger :burning :persistence :cooldown :cooldown-s 0
             :job (jobs.survival.extinguish {:water-radius 6})}
            {:trigger :wedged :persistence :cooldown :cooldown-s 0
             :job (jobs.survival.unwedge)}
            {:trigger :hostile-near :args {:radius 8 :ranged-radius 16}
             :job (jobs.survival.respond-to-hostile {:radius 8 :ranged-radius 16})}
            {:trigger :night :persistence :cooldown :cooldown-s 10 :args {:roof-height 4}
             :job (jobs.survival.night {:roof-height 4})}
            {:trigger :hungry :persistence :cooldown :cooldown-s 90 :args {:food 6}
             :job (jobs.survival.get-food {:food 6})}
            {:trigger :door-left :persistence :cooldown :cooldown-s 5 :job (jobs.maintenance.shut-doors)}
            {:trigger :died :persistence :cooldown :cooldown-s 30
             :job (jobs.survival.recover-drops {:collect-radius 6})}
            {:trigger :inventory-nearly-full :persistence :cooldown :cooldown-s 120 :args {:free 2}
             :job (jobs.storage.make-room {:free 4 :chest-range 32})}
            {:trigger :scaffold-left :persistence :stop}
            {:trigger :tidy-pending :persistence :cooldown :cooldown-s 10}]
 :queue [(repeat (jobs.movement.look-around))]}
