;; Stay alive and otherwise idle. The reflexes are registered in priority
;; order, most urgent first: air, fire, health, hostiles, food, night, being
;; stuck, then a death's drops. Between reflexes the body looks around, one
;; look per round, so it visibly idles.
{:register [{:trigger :suffocating :args {:min-oxygen 12}
             :job (jobs.survival.breathe {:min-oxygen 12})}
            {:trigger :burning
             :job (jobs.survival.extinguish {:water-radius 6})}
            {:trigger :health-low :args {:health 7}
             :job (jobs.survival.recover {:health 7 :healed 16 :sight 16})}
            {:trigger :hostile-near :args {:radius 8}
             :job (jobs.survival.respond-to-hostile {:radius 8 :fight-health 12 :min-health 8})}
            {:trigger :hungry :args {:food 6 :food-when-hurt 14}
             :job (jobs.survival.get-food {:food 6 :food-when-hurt 14})}
            {:trigger :night-unsafe :args {:roof-height 4}
             :job (jobs.survival.shelter {:roof-height 4})}
            {:trigger :stuck
             :job (jobs.maintenance.unstick)}
            {:trigger :died
             :job (jobs.survival.recover-drops {:collect-radius 6})}
            {:trigger :inventory-nearly-full}]
 :queue [(repeat (jobs.movement.look-around))]}
