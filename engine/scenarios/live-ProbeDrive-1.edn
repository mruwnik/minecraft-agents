;; ProbeDrive live test: the survival register, pacing on the test platform at -3500 64 3500.
;; Stay alive and otherwise idle. The reflexes are registered in priority
;; order, most urgent first: air, fire, hostiles, health, food, night (shelter, then logging out when another player sleeps), being
;; stuck, then a death's drops, then a full inventory. Between reflexes the
;; body looks around, one look per round, so it visibly idles. A reflex job gets one chance: when its
;; round declines or is done it is dropped, and the trigger fires it again once
;; its cooldown (counted from the job ending) has passed. Hostiles sit above
;; health: respond-to-hostile already flees when hurt and fights only when
;; healthy (or cornered), so get-food eats once no visible hostile is near.
{:register [{:trigger :suffocating :persistence :cooldown :cooldown-s 2 :args {:min-oxygen 12}
             :job (jobs.survival.breathe {:min-oxygen 12})}
            {:trigger :burning :persistence :cooldown :cooldown-s 2
             :job (jobs.survival.extinguish {:water-radius 6})}
            {:trigger :hostile-near :persistence :cooldown :cooldown-s 5 :args {:radius 8 :ranged-radius 16}
             :job (jobs.survival.respond-to-hostile {:radius 8 :ranged-radius 16})}
            {:trigger :hungry :persistence :cooldown :cooldown-s 90 :args {:food 6}
             :job (jobs.survival.get-food {:food 6})}
            {:trigger :night-unsafe :persistence :cooldown :cooldown-s 10 :args {:roof-height 4}
             :job (jobs.survival.shelter {:roof-height 4})}
            {:trigger :player-sleeping-nearby :persistence :cooldown :cooldown-s 30 :job (jobs.survival.log-out)}
            {:trigger :stuck :persistence :cooldown :cooldown-s 60
             :job (jobs.maintenance.unstick)}
            {:trigger :died :persistence :cooldown :cooldown-s 30
             :job (jobs.survival.recover-drops {:collect-radius 6})}
            {:trigger :inventory-nearly-full :persistence :cooldown :cooldown-s 120 :args {:free 2}
             :job (jobs.storage.make-room {:free 4 :chest-range 32})}]
 :queue [(jobs.movement.pace {:a {:x -3505 :y 64 :z 3495} :b {:x -3495 :y 64 :z 3495} :laps 3 :rounds 1000})]}
