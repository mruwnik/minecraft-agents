;; batch-craft live: get-food's bread rung cut every 5 s by a look-around reflex while it walks to the table and bakes
{:register [{:trigger :every-interval :args {:seconds 5} :job (jobs.movement.look-around {:every-ms 300})}]
 :queue [(hold (seq (jobs.movement.look-around {:every-ms 4500}) (jobs.survival.get-food)))]}
