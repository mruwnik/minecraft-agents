;; ProbeShelterC live cases for the night shelter hold and dig-in tool (cards f3e41d66, 0392fef7): the engine's survival reflexes (night shelter, hostile reflex), no queue; jobs submitted with tools/jobs.mjs
{:register [{:trigger :suffocating :persistence :cooldown :cooldown-s 2 :args {}
             :job (jobs.survival.breathe)}
            {:trigger :burning :persistence :cooldown :cooldown-s 2
             :job (jobs.survival.extinguish {:water-radius 6})}
            {:trigger :died :persistence :cooldown :cooldown-s 30
             :job (jobs.survival.recover-drops {:settings {:jobs.survival.recover-drops/collect-radius 6}})}
            {:trigger :hostile-near :persistence :cooldown :cooldown-s 5 :args {:radius 8 :ranged-radius 16}
             :job (jobs.survival.respond-to-hostile)}
            {:trigger :hungry :persistence :cooldown :cooldown-s 90 :args {:food 6}
             :job (jobs.survival.get-food {:food 6})}
            {:trigger :night :persistence :cooldown :cooldown-s 10
             :job (jobs.survival.night)}
            {:trigger :door-left :persistence :cooldown :cooldown-s 5 :job (jobs.maintenance.shut)}
            {:trigger :inventory-nearly-full :persistence :cooldown :cooldown-s 120 :args {:free 2}
             :job (jobs.storage.make-room {:free 4})}
            {:trigger :tidy-pending :persistence :cooldown :cooldown-s 10}]
 :queue [(repeat (jobs.time.noop {:seconds 2 :why :idle}))]}
