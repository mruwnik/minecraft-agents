;; jobs.items.smelt live: blast furnace at 9002,70,9502, raw iron and planks in the chest (planks are the only fuel carried)
{:register []
 :queue [(seq (jobs.storage.withdraw {:chest {:x 8999 :y 70 :z 9503} :items {"raw_iron" 4 "oak_planks" 6}})
              (jobs.items.smelt {:furnace {:x 9002 :y 70 :z 9502} :item "raw_iron" :count 4}))
         (repeat (jobs.movement.look-around {:every-ms 3000}))]}
