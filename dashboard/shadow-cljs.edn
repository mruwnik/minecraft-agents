;; shadow-cljs builds for the dashboard. See README.md.
;; Idle servers return heap and malloc memory (measured 1.75 GB -> ~0.6-0.8 GB); compile times unchanged. Not TieredStopAtLevel=1 (2.5x slower).
{:jvm-opts ["-Xmx1G" "-XX:G1PeriodicGCInterval=20000" "-XX:MinHeapFreeRatio=10" "-XX:MaxHeapFreeRatio=30" "-XX:TrimNativeHeapInterval=10000"]
 :source-paths ["src" "test" "bench-src" "../engine/src" "../engine/test-support"]
 :dependencies [[reagent "1.3.0"]
                [re-frame "1.4.3"]]
 :builds
 {:server {:target :node-script
           :main dashboard.server/main
           :output-to "out/server.cjs"
           :output-dir "out/server-js"
           :compiler-options {:infer-externs false}}
  :migrate-data {:target :node-script
                 :main dashboard.migrate-data/main
                 :output-to "out/migrate-data.cjs"
                 :output-dir "out/migrate-data-js"
                 :compiler-options {:infer-externs true}}
  :agent-tools {:target :node-library
                     :exports {:workspaceGenerate agent-tools.workspace/generate!
                               :workspaceRoute agent-tools.workspace/route-js
                               :workspaceUsage agent-tools.workspace/usage
                               :workspacePlayerUsage agent-tools.workspace/player-usage
                               :workspacePlayerError agent-tools.workspace/player-error
                               :storage agent-tools.storage-compat/api
                               :mapFilters agent-tools.api/map-filters
                               :mapSummary agent-tools.api/map-summary
                               :mapValidateZone agent-tools.api/map-validate-zone
                               :planUsage agent-tools.api/plan-usage
                               :planOneForm agent-tools.api/plan-one-form
                               :blueprintForm agent-tools.api/blueprint-form
                               :planRequestFor agent-tools.api/plan-request-for
                               :mapOptions agent-tools.api/map-options
                               :mapExecute agent-tools.api/map-execute
                               :mapMain agent-tools.api/map-main
                               :mapTtl agent-tools.map/ttl
                               :mapUsage agent-tools.map/usage
                               :timeUsage agent-tools.time/usage
                               :timeOptions agent-tools.api/time-options
                               :timeClock agent-tools.api/time-clock
                               :timeExecute agent-tools.api/time-execute
                               :timeMain agent-tools.api/time-main
                               :snapshotUsage agent-tools.snapshot/usage
                               :snapshotMain agent-tools.snapshot/main!
                               :jobsUsage agent-tools.api/jobs-usage
                               :jobsRequestFor agent-tools.api/jobs-request-for
                               :jobsMain agent-tools.api/jobs-main
                               :observeUsage agent-tools.api/observe-usage
                               :observeRequestFor agent-tools.api/observe-request-for
                               :observeMain agent-tools.api/observe-main
                               :ednWrite agent-tools.api/edn-write
                               :ednRead agent-tools.api/edn-read
                               :triggersUsage agent-tools.api/triggers-usage
                               :triggersRequestFor agent-tools.api/triggers-request-for
                               :triggersMain agent-tools.api/triggers-main
                               :sayUsage agent-tools.say/usage
                               :sayRequestFor agent-tools.api/say-request-for
                               :sayMain agent-tools.api/say-main
                               :driveUsage agent-tools.api/drive-usage
                               :driveDefaultStateDir agent-tools.api/drive-default-state-dir
                               :driveMain agent-tools.api/drive-main
                               :driveRequestFor agent-tools.api/drive-request-for
                               :driveSocketPathFor agent-tools.api/drive-socket-path-for
                               :worldUsage agent-tools.api/world-usage
                               :worldMain agent-tools.api/world-main
                               :worldRequestFor agent-tools.api/world-request-for
                               :changesOptions agent-tools.api/changes-options
                               :changesExecute agent-tools.api/changes-execute
                               :changesMain agent-tools.api/changes-main
                               :changesUsage agent-tools.changes/usage
                               :entitiesUsage agent-tools.api/entities-usage
                               :entitiesOptions agent-tools.api/entities-options
                               :entitiesMain agent-tools.api/entities-main
                               :jobResultProject agent-tools.job-results/js-project
                               :jobResultRead agent-tools.job-results/js-read
                               :jobResultHistory agent-tools.job-results/js-history
                               :inventorySummary agent-tools.api/inventory-summary
                               :planExecute agent-tools.plans/execute
                               :prepare dashboard.agent-plan-tools/prepare
                               :score dashboard.agent-plan-tools/score
                               :validatePlan dashboard.agent-plan-tools/validate-plan
                               :validateBlueprint dashboard.agent-plan-tools/validate-blueprint}
                     :output-to "out/agent-tools.cjs"
                     :output-dir "out/agent-tools-js"
                     :compiler-options {:infer-externs true}}
  :rcon-tools {:target :node-library
               :exports {:whitelistMain dashboard.rcon-tools/whitelist-main
                         :rawMain dashboard.rcon-tools/raw-main
                         :testMain dashboard.rcon-tools/test-main
                         :cartSampleMain dashboard.rcon-cart/main}
               :output-to "out/rcon-tools.cjs"
               :output-dir "out/rcon-tools-js"
               ;; :simple keeps property names, so the node API calls need no externs
               :compiler-options {:optimizations :simple :infer-externs false}}
  ;; tools/world-test.mjs: the world-fixture runner (world-test.runner), one ahead-of-time compiled file.
  :world-test {:target :node-library
               :exports {:main world-test.runner/main :timeSet world-test.runner/time-set-main}
               :output-to "out/world-test.cjs"
               :output-dir "out/world-test-js"
               :compiler-options {:optimizations :simple :infer-externs false}}
  ;; Its unit tests alone (the dashboard :test build compiles every dashboard test): node out/world-test-unit.cjs
  :world-test-unit {:target :node-test
                    :output-to "out/world-test-unit.cjs"
                    :output-dir "out/world-test-unit"
                    :ns-regexp "^world-test\\..*-test$"
                    :compiler-options {:infer-externs false}}
  ;; The browser viewer's cljs (tools/view/web imports cljs/viewer.mjs): built with `shadow-cljs release viewer`, one file.
  :viewer {:target :esm
           :output-dir "../tools/view/web/cljs"
           :modules {:viewer {:output-name "viewer.mjs" ; .mjs: the repo package is commonjs, Node tests import it too
                              :exports {poseInterpolator view.interp/pose-interpolator
                                        viewHub view.hub/view-hub
                                        createSceneCore view.scene/create-scene
                                        decodePriority view.scene/decode-priority
                                        controlFor view.drive/control-for
                                        lookStepFor view.drive/look-step-for
                                        mouseLook view.drive/mouse-look
                                        mergeLook view.drive/merge-look
                                        bannerText view.drive/banner-text
                                        serialQueue view.drive/serial-queue
                                        whoFrom view.drive/who-from
                                        shouldTakeOnClick view.drive/should-take-on-click
                                        shouldReleaseOnEscape view.drive/should-release-on-escape
                                        leaveAction view.drive/leave-action
                                        withTimeout view.drive/with-timeout
                                        isStale view.drive/is-stale
                                        shouldDrop view.drive/should-drop
                                        createDriver view.takeover/create-driver
                                        isAgentKey view.takeover/agent-key?}}}
           :compiler-options {:infer-externs :auto}}
  ;; The same viewer namespaces plus the hot functions the :viewer build does not export, release-optimized, for
  ;; tools/view/bench-cljs-vs-js.mjs: `shadow-cljs release viewer-bench`. Not shipped.
  :viewer-bench {:target :esm
                 :output-dir "out/viewer-bench"
                 :modules {:viewer-bench {:output-name "viewer-bench.mjs"
                                          :exports {poseInterpolator view.interp/pose-interpolator
                                                    createSceneCore view.scene/create-scene
                                                    dueScenes view.schedule/due-scenes
                                                    nextDueAt view.schedule/next-due-at
                                                    planFrame view.schedule/plan-frame
                                                    streamKey view.schedule/stream-key
                                                    eventCache view.bench/event-cache
                                                    moveWindow view.window/move-window
                                                    slotKey view.window/slot-key
                                                    controlFor view.drive/control-for
                                                    lookStepFor view.drive/look-step-for
                                                    mouseLook view.drive/mouse-look
                                                    mergeLook view.drive/merge-look
                                                    bannerText view.drive/banner-text
                                                    shouldDrop view.drive/should-drop}}}
                 :compiler-options {:infer-externs :auto}}
  :ui {:target :browser
       :output-dir "out/public/js"
       :asset-path "/js"
       :modules {:main {:entries [dashboard.ui]
                        :init-fn dashboard.ui/init}}
       :compiler-options {:infer-externs false}}
  :test {:target :node-test
         :output-to "out/test.cjs"
         :output-dir "out/test"
         :ns-regexp "-test$"
         :autorun false
         :compiler-options {:infer-externs false}}}}
