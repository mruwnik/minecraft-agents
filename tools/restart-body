#!/bin/bash
# cleanly restarts a running body: finds the supervisor that owns it (see start-body), TERMs it and waits for the
# supervisor's own trap to take body.pid down with it, then runs start-body again so the start gate, lock and log
# rotation all apply. The body_down event comes from that trap - this script never writes one of its own.
#   tools/restart-body <agentdir> [start args...]
dir="$1"
[ -n "$dir" ] || { echo "usage: restart-body <agentdir> [start args...]" >&2; exit 2; }
shift
here="$(dirname "$(readlink -f "$0")")"

pid=$(cat "$dir/body.pid" 2>/dev/null)
if [ -z "$pid" ] || ! kill -0 "$pid" 2>/dev/null; then
  echo "no body is running; use ./start" >&2
  exit 1
fi

# a body reparented to init (pid 1, or anything else that isn't running start-body) has already outlived its
# supervisor, so there is nothing to TERM but the body itself
ppid=$(ps -o ppid= -p "$pid" 2>/dev/null | tr -d ' ')
pcmd=$(ps -ww -o command= -p "$ppid" 2>/dev/null)
if [ -n "$ppid" ] && [ "$ppid" != "1" ] && [[ "$pcmd" == *start-body* ]]; then
  echo "stopping supervisor (pid $ppid) for body $pid"
  kill -TERM "$ppid" 2>/dev/null
else
  echo "no supervisor found for body $pid; stopping it directly"
  kill -TERM "$pid" 2>/dev/null
fi

timeout=${RESTART_BODY_TIMEOUT_S:-15}
waited=0
while [ -f "$dir/body.pid" ] && [ "$waited" -lt "$timeout" ]; do
  sleep 1
  waited=$((waited + 1))
done

if [ -f "$dir/body.pid" ]; then
  echo "body.pid did not clear in ${timeout}s; killing pid $pid"
  kill -KILL "$pid" 2>/dev/null
  rm -f "$dir/body.pid"
fi

echo "starting again"
exec "${START_BODY:-$here/start-body}" "$dir" "$@"
