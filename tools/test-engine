#!/usr/bin/env bash
# tools/test-engine <ns>... | --full
# Compiles the engine :test build through tools/compile (it takes the compile lock itself), then runs the tests OUTSIDE the lock.
# tools/test-engine --golden: the opt-in planner pins (the engine.planner-*-golden namespaces, build :test-golden); run when planner code changes. Not part of --full or the default suite.
# tools/test-engine --changed [<git-rev>]: only the tests affected by the changed files (working tree + staged + untracked vs HEAD, or vs <git-rev>; use <sha>^ to test a commit); see tools/changed-tests.mjs.
# <ns>: engine namespaces, e.g. engine.go-to-test: run by tools/test-run.mjs on a private copy of the bundle, one 'tests' slot sized by the namespace count, killed (exit 124) after a timeout from the prior timings. --full [--shards N --slots M --slowest K]: the whole suite sharded over N node processes (default 4), at most M running machine-wide (default from free memory, 1..3, flock under /tmp/mc-res, the res-slot 'tests' kind, floor in tools/res-slot.json), per-test ms in engine/out/test-timings.jsonl (shared-code changes only).
# TEST_EVENTS=1: also prints the live-tests @@test lines (phase, plan, result per test, progress per namespace), see engine.timing-test.
# Why not JS: a thin shell wrapper; runs node with --max-old-space-size=4096.
set -u
repo="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
[ $# -ge 1 ] || { echo "usage: tools/test-engine <ns>... | --full | --changed [<git-rev>]" >&2; exit 2; }
if [ "$1" = "--changed" ]; then
  sel="$(node "$repo/tools/changed-tests.mjs" "${2:-HEAD}")" || exit $?
  if [ "${sel%% *}" = "FULL" ]; then echo "test-engine --changed: running the full suite (${sel#FULL })"; set -- --full
  else
    mapfile -t nss < <(grep '^cljs ' <<<"$sel" | cut -d' ' -f2)
    mapfile -t jss < <(grep '^js ' <<<"$sel" | cut -d' ' -f2)
    echo "test-engine --changed: ${#nss[@]} cljs namespaces, ${#jss[@]} js files"
    printf '  %s\n' "${nss[@]}" "${jss[@]}" | grep -v '^  $'
    rc=0
    if [ ${#jss[@]} -gt 0 ]; then (cd "$repo" && node --test "${jss[@]}") || rc=$?; fi
    [ ${#nss[@]} -gt 0 ] || exit $rc
    "$0" "${nss[@]}" || rc=$?
    exit $rc
  fi
fi
if [ "$1" = "--golden" ]; then
  [ "${TEST_EVENTS:-}" = 1 ] && echo '@@test {"event":"phase","name":"compiling"}'
  "$repo/tools/compile" engine test-golden || exit $?
  # one 'tests' slot with the golden need from res-slot.json (kinds.tests.goldenMb)
  need="$(node -e 'console.log(require(process.argv[1]).kinds.tests.goldenMb)' "$repo/tools/res-slot.json")"
  cd "$repo/engine" && "$repo/tools/res-slot" tests --need "$need" -- sh -c 'node --max-old-space-size=4096 out/test-golden.cjs && exec node --test --test-reporter=../tools/test-events-reporter.mjs js/path/bench.golden.mjs'
  exit $?
fi
if [ "$1" = "--full" ]; then
  # sharded, machine-wide slot limit, per-test timings in engine/out/test-timings.jsonl (see tools/test-shards.mjs); options after --full: --shards N --slots M --slowest K
  shift; exec node "$repo/tools/test-shards.mjs" "$@"
fi
[ "${TEST_EVENTS:-}" = 1 ] && echo '@@test {"event":"phase","name":"compiling"}'
"$repo/tools/compile" engine test || exit $?
[ "${TEST_EVENTS:-}" = 1 ] && echo '@@test {"event":"phase","name":"testing"}'
exec node "$repo/tools/test-run.mjs" "$@"
