#!/usr/bin/env bash
# Commit exactly your own paths in a shared checkout, under a lock, with a ledger row.
# Usage: tools/commit-mine --card <id-or-prefix> -m <msg-file-or-text> --expect-lines L <paths...>
#        tools/commit-mine --card <id> -m <msg> --hunks <patchfile> --expect-hunks N <paths...>
#   Path mode commits whole files and needs --expect-lines L: the added+deleted lines `git diff --numstat <paths>` shows
#   (untracked file = its line count). Lines, not hunks: a foreign edit next to yours merges into one hunk but adds lines.
#   --expect-hunks N is also checked when given.
#   Hunks mode commits only the patch: build it ONLY from hunks you wrote. The paths are required and
#   must cover every file in the patch (else exit 3, listing the others); N must equal the patch's
#   hunk count (else exit 5); the tool prints each hunk's path and first changed line, check them.
#   Optional: --approved-core <card-id> (takes the id of the card holding the owner's approval; needed for engine-core paths).
#   Optional: --owner-said <card-id> (the owner said to commit docs/ or .claude/ paths, which are refused otherwise).
#   Refuses (exit 6) a commit whose .js/.mjs/.cjs blob does not pass node --check.
#   Refuses (exit 3) a hunks-mode commit while the index holds anything staged; refuses (exit 7) when the staged diff
#   is not exactly the patch's changed lines (hunks mode) or the staged hunk count is not the confirmed N (path mode).
#   Refuses (exit 8) a message that lacks "Card <first 8 chars of --card>" (also "card", "(card ...)", "cards").
#   After the commit: the stat goes in the ledger and, best effort, as a note on the card (tools/card note; a failure only warns).
#   Every flag that takes a value refuses one starting with "--" (so a missing value never swallows the next flag).
# See tools/README.md. Never stashes, resets, amends or pushes.
set -euo pipefail
# An unexpected failure always says which command failed (git prints its own message first).
trap 'echo "commit-mine: command failed (exit $?) at line $LINENO: $BASH_COMMAND" >&2' ERR

CORE_RE='^engine/src/engine/'
CORE_EXCLUDE_RE='^engine/src/engine/path/planner'
# Built from pieces so this file does not trip its own owner-name check.
NAME_WORD='d''an'
LOCK_TIMEOUT="${COMMIT_LOCK_TIMEOUT:-600}"
LARGE_JS_LINES=40

die() { echo "commit-mine: $*" >&2; exit "${2:-1}"; }

# A flag's value must exist and must not look like another flag.
val() { case "$2" in ""|--*) die "$1 needs a value, got '${2:-<nothing>}' (a value may not start with --)" ;; esac; REPLY="$2"; }

card=""; msg=""; hunks=""; approved=""; owner_said=""; expect=""; expect_lines=""; paths=()
while [ $# -gt 0 ]; do
  case "$1" in
    --card) val --card "${2-}"; card="$REPLY"; shift 2 ;;
    -m) val -m "${2-}"; msg="$REPLY"; shift 2 ;;
    --hunks) val --hunks "${2-}"; hunks="$REPLY"; shift 2 ;;
    --expect-hunks) val --expect-hunks "${2-}"; expect="$REPLY"; shift 2 ;;
    --expect-lines) val --expect-lines "${2-}"; expect_lines="$REPLY"; shift 2 ;;
    --approved-core) val --approved-core "${2-}"; approved="$REPLY"; shift 2 ;;
    --owner-said) val --owner-said "${2-}"; owner_said="$REPLY"; shift 2 ;;
    --) shift; paths+=("$@"); break ;;
    -*) die "unknown option $1" ;;
    *) paths+=("$1"); shift ;;
  esac
done
[ -n "$card" ] || die "--card is required"
[ -n "$msg" ] || die "-m is required"
[ -z "$hunks" ] || [ -f "$hunks" ] || die "no such patch file: $hunks"
[ ${#paths[@]} -gt 0 ] || die "give paths (in --hunks mode: the paths the patch touches)"

ROOT="$(git rev-parse --show-toplevel)"; cd "$ROOT"
GITDIR="$(cd "$(git rev-parse --git-common-dir)" && pwd)"
LOCK="$GITDIR/commit-lock"
LEDGER="$GITDIR/commit-ledger.jsonl"

# Allowed set: given paths (relative to repo root) plus files touched by the patch.
allowed=()
for p in "${paths[@]}"; do
  p="$(realpath -m --relative-to="$ROOT" -- "$p")"
  allowed+=("${p%/}")
done
[ ${#allowed[@]} -gt 0 ] || die "nothing to commit"

is_allowed() { local f="$1" a; for a in "${allowed[@]}"; do [ "$f" = "$a" ] || [[ "$f" == "$a"/* ]] && return 0; done; return 1; }

# Hunks mode: the patch may touch only the given paths, and the hunk count must be confirmed.
if [ -n "$hunks" ]; then
  patch_files="$(git apply --numstat -z "$hunks" | tr '\0' '\n' | awk -F'\t' 'NF>=3{print $3}')"
  stray=()
  while IFS= read -r f; do
    [ -n "$f" ] || continue
    is_allowed "$f" || stray+=("$f")
  done <<<"$patch_files"
  [ ${#stray[@]} -eq 0 ] || die "patch touches paths not given on the command line: ${stray[*]} (foreign hunks? build the patch only from your own hunks)" 3
  hunk_list="$(awk '
    /^diff --git /{f=$4; sub(/^b\//,"",f); inh=0}
    /^@@/{inh=1; first=1; n++; next}
    inh && first && /^[-+]/ && !/^(---|\+\+\+) /{printf "  hunk %d: %s: %s\n", n, f, $0; first=0}
  ' "$hunks")"
  hunk_total="$(grep -c '^@@' "$hunks" || true)"
  if [ -z "$expect" ] || [ "$expect" != "$hunk_total" ]; then
    {
      echo "commit-mine: hunks mode commits exactly this patch. Hunks in $hunks (path, first changed line):"
      echo "$hunk_list"
      echo "Total: $hunk_total. Every hunk must be one YOU wrote; delete any other agent's hunk from the patch."
      echo "Then rerun with --expect-hunks $hunk_total."
    } >&2
    [ -n "$expect" ] && die "--expect-hunks $expect does not match $hunk_total" 5
    die "--expect-hunks N is required with --hunks" 5
  fi
  echo "commit-mine: committing $hunk_total hunk(s):" >&2; echo "$hunk_list" >&2
fi

flags=()
# Engine-core gate (before locking).
for a in "${allowed[@]}"; do
  [[ "$a" =~ $CORE_RE ]] || continue
  [[ "$a" =~ $CORE_EXCLUDE_RE ]] && continue
  [ -n "$approved" ] || die "engine-core path $a needs --approved-core <card> (owner approval)"
  flags+=("engine-core $a approved-by $approved")
done
# docs/ and .claude/ go in only on the owner's word.
for a in "${allowed[@]}"; do
  [[ "$a" =~ ^(docs|\.claude)(/|$) ]] || continue
  [ -n "$owner_said" ] || die "docs/ and .claude/ are committed only when the owner says so ($a; --owner-said <card-id> if he did)"
  flags+=("owner-said $a by $owner_said")
done
[ -z "$hunks" ] || flags+=("hunks-mode")

# Message.
if [ -f "$msg" ]; then message="$(cat "$msg")"; else message="$msg"; fi
trailer='Co-Authored-By: Claude Sonnet 5.5 <noreply@anthropic.com>'
grep -qiE '^Co-Authored-By:' <<<"$message" || message="$message"$'\n\n'"$trailer"

# The message must name the card: "Card <id8>", "card <id8>", "(card <id8>)" or "cards <id8>" (a longer id also matches).
card_id8="${card:0:8}"
grep -qiE "cards? +$card_id8" <<<"$message" || die "the commit message must name the card, e.g. 'Card $card_id8' (--card $card)" 8

# Lock with backoff. The lock dir holds the owner's pid; a lock whose owner is dead is reclaimed. Reclaimers and the owner's release take turns under a flock guard (the kernel frees it on death), so the owner read, the death check and the removal see one lock: nobody removes a fresh one.
reclaim_dead() {
  (
    flock 8
    owner="$(cat "$LOCK/pid" 2>/dev/null)" || exit 1
    [[ "$owner" =~ ^[0-9]+$ ]] && ! kill -0 "$owner" 2>/dev/null || exit 1
    rm -rf "$LOCK"
  ) 8>"$LOCK.guard"
}
release_lock() { ( flock 8; rm -rf "$LOCK" ) 8>"$LOCK.guard"; }
start=$SECONDS; delay=0.2
until mkdir "$LOCK" 2>/dev/null; do
  reclaim_dead && continue
  [ $((SECONDS - start)) -lt "$LOCK_TIMEOUT" ] || die "could not take $LOCK in ${LOCK_TIMEOUT}s (held by pid $(cat "$LOCK/pid" 2>/dev/null || echo '?'))" 4
  sleep "$delay"
  delay=$(awk -v d="$delay" 'BEGIN{d*=1.5; if(d>5)d=5; print d}')
done
echo $$ > "$LOCK/pid"
staged_by_me=0
cleanup() {
  local rc=$?
  if [ "$staged_by_me" = 1 ] && [ "${committed:-0}" != 1 ]; then unstage; fi
  [ "${lock_released:-0}" = 1 ] || release_lock
  exit $rc
}
unstage() {
  if [ -n "$hunks" ]; then git apply --cached -R "$hunks" 2>/dev/null || true; return; fi
  local p; for p in "${paths[@]}"; do git restore --staged -- "$p" 2>/dev/null || true; done
}
trap cleanup EXIT INT TERM HUP

# Path mode commits whole files, which sweeps in other agents' uncommitted hunks.
# Require the caller to state how many hunks `git diff <paths>` shows (untracked file = 1).
if [ -z "$hunks" ]; then
  count_hunks() { # prints "<hunks> <path>" per changed file
    git diff HEAD -- "${paths[@]}" | awk '/^diff --git /{f=$4; sub(/^b\//,"",f)} /^@@/{n[f]++} /^Binary files/{n[f]++} END{for(k in n)print n[k], k}'
    git ls-files --others --exclude-standard -- "${paths[@]}" | awk '{print 1, $0}'
  }
  numstat_lines() { awk -F'\t' '{ if ($1 == "-") t += 1; else t += $1 + $2 } END{print t+0}'; }
  count_lines() { # added+deleted lines in the working tree for the given paths (untracked files count their lines)
    {
      git diff HEAD --numstat -- "${paths[@]}"
      git ls-files --others --exclude-standard -z -- "${paths[@]}" | while IFS= read -r -d '' f; do
        printf '%s\t0\t%s\n' "$(awk 'END{print NR}' "$f")" "$f"
      done
    } | numstat_lines
  }
  count_staged() { # same line count, from the index: what is about to be committed
    git diff --cached --numstat -- "${allowed[@]}" | numstat_lines
  }
  per="$(count_hunks | sort -k2)"
  total_hunks=$(awk '{t+=$1} END{print t+0}' <<<"$per")
  total=$(count_lines)
  if [ -z "$expect_lines" ] || [ "$expect_lines" != "$total" ] || { [ -n "$expect" ] && [ "$expect" != "$total_hunks" ]; }; then
    {
      echo "commit-mine: path mode commits WHOLE files; other agents may have uncommitted lines in them."
      echo "Hunks in the working tree for the given paths (count path):"
      echo "$per" | sed 's/^/  /'
      echo "Total: $total line(s) added+deleted in $total_hunks hunk(s). Review with 'git diff <path>'. If every line is yours, rerun with --expect-lines $total."
      echo "If any line is not yours: 'git diff <path> > my.patch', delete foreign hunks from the patch, and use --hunks my.patch."
    } >&2
    [ -n "$expect_lines" ] && die "--expect-lines $expect_lines (and --expect-hunks ${expect:-unset}) do not match $total lines / $total_hunks hunks" 5
    die "--expect-lines L is required with paths" 5
  fi
fi

# Hunks mode: the index must equal HEAD, else anything staged by someone else would ride along.
if [ -n "$hunks" ] && ! git diff --cached --quiet; then
  die "index is not clean (staged: $(git diff --cached --name-only | tr '\n' ' ')); someone staged outside the lock. Retry later" 3
fi

# Test-only seam: a command run after the checks and before staging (simulates another agent editing).
[ -z "${COMMIT_MINE_TEST_BEFORE_STAGE:-}" ] || eval "$COMMIT_MINE_TEST_BEFORE_STAGE"

# Stage.
staged_by_me=1
if [ -n "$hunks" ]; then
  git apply --cached "$hunks"
else
  # Only what differs from the index: a pathspec that matches nothing (all deleted and already staged by git rm) makes git add fail.
  git ls-files -m -d -o --exclude-standard -z -- "${paths[@]}" > "$LOCK/todo"
  [ ! -s "$LOCK/todo" ] || git add -A --pathspec-from-file="$LOCK/todo" --pathspec-file-nul
  rm -f "$LOCK/todo"
fi

# The staged diff must be exactly what the caller named; otherwise refuse (cleanup unstages).
patch_sig() { # "<file>\t<+/- line>" for every changed line inside a hunk, from a diff on stdin
  awk '/^diff --git /{f=$4; sub(/^b\//,"",f); inh=0; next} /^@@/{inh=1; next} inh && /^[-+]/{print f "\t" $0}'
}
if [ -n "$hunks" ]; then
  want="$(patch_sig < "$hunks")"
  got="$(git diff --cached -U0 | patch_sig)"
  [ "$want" = "$got" ] || die "staged diff differs from the patch (it must hold exactly the patch's changed lines); nothing committed" 7
else
  staged_total="$(count_staged)"
  [ "$staged_total" = "$total" ] || die "staged $staged_total line(s) but $total were confirmed: a file changed while committing; nothing committed. Recheck 'git diff' and rerun" 7
fi

# Foreign staged paths.
foreign=()
while IFS= read -r f; do is_allowed "$f" || foreign+=("$f"); done < <(git diff --cached --name-only)
if [ ${#foreign[@]} -gt 0 ]; then
  [ -z "$hunks" ] || die "index holds foreign staged paths (${foreign[*]}); someone staged outside the lock. Hunks mode cannot use --only: retry later" 3
  flags+=("foreign-staged: ${foreign[*]} (left out via --only)")
  echo "commit-mine: warning: foreign staged paths left uncommitted: ${foreign[*]}" >&2
fi

git diff --cached --quiet -- "${allowed[@]}" && die "nothing staged for the given paths"

# Check: Why JavaScript.
while IFS=$'\t' read -r add del f; do
  [[ "$f" =~ \.(js|mjs|cjs)$ ]] || continue
  [[ "$add" =~ ^[0-9]+$ ]] || continue
  git cat-file -e ":$f" 2>/dev/null || continue  # deleted: no index copy to check
  total=$(git show ":$f" 2>/dev/null | wc -l)
  new=0; git cat-file -e "HEAD:$f" 2>/dev/null || new=1
  large=0
  [ "$new" = 1 ] && large=1
  [ "$add" -ge "$LARGE_JS_LINES" ] && [ $((add * 2)) -ge "$total" ] && large=1
  [ "$large" = 1 ] || continue
  git show ":$f" | grep -q 'Why JavaScript:' || die "new or largely changed JS file $f needs a '// Why JavaScript:' line"
done < <(git diff --cached --numstat -- "${allowed[@]}")

# Check: every committed JS file parses (a hunk-mode commit can leave HEAD with a file that never existed on disk).
pkg_type() { # $1 = path; "type" of the nearest package.json (staged, else HEAD), default commonjs
  local d="$(dirname "$1")" pj
  while :; do
    [ "$d" = . ] && pj=package.json || pj="$d/package.json"
    pj="$(git show ":$pj" 2>/dev/null || git show "HEAD:$pj" 2>/dev/null)" && {
      [ "$(node -e 'try{process.stdout.write(String(JSON.parse(require("fs").readFileSync(0,"utf8")).type||""))}catch(e){}' <<<"$pj")" = module ] && echo module || echo commonjs
      return
    }
    [ "$d" = . ] && { echo commonjs; return; }
    d="$(dirname "$d")"
  done
}
parses() { # $1 = path, blob on stdin; syntax checked as the file's real module type (.mjs ESM, .cjs CJS, .js by package.json)
  local tmp ext="${1##*.}" rc=0 kind
  case "$ext" in
    mjs) kind=mjs ;;
    cjs) kind=cjs ;;
    *) [ "$(pkg_type "$1")" = module ] && kind=mjs || kind=cjs ;;
  esac
  tmp="$(mktemp -d)"; cat > "$tmp/f.$kind"
  node --check "$tmp/f.$kind" 2>/dev/null || rc=1
  rm -rf "$tmp"; return $rc
}
while IFS= read -r f; do
  [[ "$f" =~ \.(js|mjs|cjs)$ ]] || continue
  git show ":$f" | parses "$f" || die "the committed version of $f does not pass node --check (a partial commit left a file that never existed on disk?); fix it or commit the whole file" 6
done < <(git diff --cached --name-only --diff-filter=AM -- "${allowed[@]}")

# Check: owner name as a whole word in added lines (paths under /home/<user>/ ignored).
if git diff --cached -U0 -- "${allowed[@]}" | grep -E '^\+' | grep -vE '^\+\+\+ ' \
    | sed -E 's#/home/[A-Za-z0-9_.-]+/#/home/USER/#g' | grep -iwq -- "$NAME_WORD"; then
  die "an added line contains the owner's name as a word; use a label or neutral name"
fi
# Commit message gets the same check.
if grep -iwq -- "$NAME_WORD" <<<"$message"; then die "commit message contains the owner's name as a word"; fi

# Commit.
if [ -n "$hunks" ] || [ ${#foreign[@]} -eq 0 ]; then
  git commit -q -m "$message"
else
  git commit -q --only -m "$message" -- "${allowed[@]}"
fi
committed=1

hash="$(git rev-parse HEAD)"
read -r ins del < <(git show --numstat --format= HEAD | awk '{i+=$1; d+=$2} END{print i+0, d+0}')
[ "$del" -lt 500 ] || flags+=("large-deletion $del")
files="$(git show --name-only --format= HEAD)"
stat="$(git show --stat --format= HEAD | tail -1 | sed 's/^ *//')"
jq -nc --arg time "$(date -u +%Y-%m-%dT%H:%M:%SZ)" --arg hash "$hash" --arg card "$card" \
  --arg files "$files" --arg stat "$stat" --argjson ins "$ins" --argjson del "$del" --arg flags "$(printf '%s\n' "${flags[@]:-}")" \
  '{time:$time,hash:$hash,card:$card,paths:($files|split("\n")|map(select(.!=""))),insertions:$ins,deletions:$del,stat:$stat,flags:($flags|split("\n")|map(select(.!="")))}' \
  >> "$LEDGER"
# The lock is not needed past the ledger row: release it before the note, which may take its whole timeout.
release_lock; lock_released=1
# Stat on stdout and, best effort, on the card: the commit exists already, so a board failure only warns.
stat_text="$(git show --stat --format='%h %s' HEAD | sed -n '1,20p')"
printf '%s\n' "$stat_text"
card_tool="$ROOT/tools/card"
[ -x "$card_tool" ] || card_tool="$(dirname "$0")/card"
timeout "${COMMIT_MINE_NOTE_TIMEOUT:-15}" "$card_tool" note "$card" "$stat_text" >/dev/null 2>&1 \
  || echo "commit-mine: warning: could not post the commit stat to card $card (the commit is done)" >&2
exit 0
