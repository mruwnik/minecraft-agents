#!/usr/bin/env bash
# Exit 0 when dashboard/out/agent-tools.cjs is missing or stale against a source it is built from (the list is bundleSources in
# engine/tools/agent-tools-bundle-check.mjs); exit 1 when it is current. A stat scan (plus a hash when a source is newer), no compile.
here=$(cd "$(dirname "$0")/.." && pwd)
repo=${1:-$here}
bundle="$repo/dashboard/out/agent-tools.cjs"
[ -e "$bundle" ] || exit 0
exec node --input-type=module -e "
import { bundleSources, staleSource } from '$here/engine/tools/agent-tools-bundle-check.mjs'
process.exit(staleSource('$bundle', bundleSources('$repo')) ? 0 : 1)"
