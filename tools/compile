#!/usr/bin/env bash
# tools/compile <engine|dashboard> <build>... [--priority] [--release]
# tools/compile <engine|dashboard> --stop
#
# Every cljs compile in this repo goes through here: it queues on /tmp/mc-compile.lock (the machine-wide compile lock, taken
# here, so never wrap this in flock) and runs `npx shadow-cljs compile|release <build>` in the project. The shadow-cljs CLI
# connects to the project's long-lived `shadow-cljs server` when one runs (no JVM per compile, ~2 s instead of ~30 s); this
# script starts that server first, detached, when it is not running and memory allows.
#
#   --priority  jump the queue: ahead of every waiting normal compile (it still waits for the compile now running).
#               For the owner's UI rebuilds (dashboard ui/server) and nothing else.
#   --release   `shadow-cljs release` instead of `compile` (the :viewer build).
#   --stop      stop the project's server (needs the lock; for restarts; no build argument).
#
# Queue: a ticket file <lane>-<ns>-<pid> per waiter in /tmp/mc-compile.queue (lane 0 priority, 1 normal); the first live
# ticket waits on the flock in 2 s blocking slices (so it wakes the moment the lock frees, competing fairly with any plain
# `flock` waiter; a non-blocking poll every 0.2 s would lose to them), so order is priority lane first, then arrival.
# Dead waiters' tickets are pruned. Running under a process that holds the lock (an ancestor with the lock file open, e.g.
# `flock /tmp/mc-compile.lock tools/compile ...`) would wait for itself for ever: it exits 2 at once instead.
# Memory: a missing server starts only with MIN_START_MB (3500) available; the compile itself uses the server's heap.
# A server started outside the main checkout (a git worktree: integration batches, test copies) runs under a `compile` slot of
# tools/res-slot (held for the server's life, so its JVM counts against the memory floor); no free slot in ~2 min exits 75 (retry).
# Env: MC_COMPILE_LOG=1 prints "waited Ns, compiled Ns".
set -u
repo="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
lock=${MC_COMPILE_LOCK:-/tmp/mc-compile.lock}   # env overrides are for tools/compile.test.sh only
queue=${MC_COMPILE_QUEUE:-/tmp/mc-compile.queue}
MIN_START_MB=${MC_COMPILE_MIN_START_MB:-3500}

usage() { echo "usage: tools/compile <engine|dashboard> <build>... [--priority] [--release] | <project> --stop" >&2; exit 2; }

[ $# -ge 2 ] || usage
project=$1; shift
case "$project" in engine|dashboard) ;; *) usage ;; esac
dir="$repo/$project"
lane=1; verb=compile; stop=0; builds=()
for a in "$@"; do
  case "$a" in
    --priority) lane=0 ;;
    --release) verb=release ;;
    --stop) stop=1 ;;
    -*) usage ;;
    *) builds+=("$a") ;;
  esac
done
[ "$stop" = 1 ] || [ ${#builds[@]} -gt 0 ] || usage

available_mb() { awk '/MemAvailable/ {print int($2/1024)}' /proc/meminfo; }
server_pid() { local p; p=$(cat "$dir/.shadow-cljs/server.pid" 2>/dev/null) && [ -n "$p" ] && kill -0 "$p" 2>/dev/null && echo "$p"; }

# Deadlock guard: an ancestor process holding the lock file open (flock(1) wrapping us, or an inherited fd) means we would wait for ourselves.
if [ -e "$lock" ]; then
  want=$(stat -c %i "$lock")
  a=$PPID
  while [ -n "$a" ] && [ "$a" -gt 1 ]; do
    for fd in /proc/$a/fd/*; do
      [ "$(stat -L -c %i "$fd" 2>/dev/null)" = "$want" ] && [ "$(stat -L -c %d "$fd" 2>/dev/null)" = "$(stat -c %d "$lock")" ] || continue
      echo "tools/compile: process $a already holds $lock. tools/compile takes the lock itself; don't wrap it in flock (or run it from a lock holder)." >&2
      exit 2
    done
    a=$(awk '{print $4}' "/proc/$a/stat" 2>/dev/null)
  done
fi

mkdir -p "$queue"
ticket="$queue/$lane-$(date +%s%N)-$$"
: > "$ticket"
exec 9>>"$lock"
trap 'rm -f "$ticket"' EXIT
t0=$(date +%s.%N)
while :; do
  for f in "$queue"/*; do  # prune tickets of dead waiters
    [ -e "$f" ] || continue
    pid=${f##*-}
    kill -0 "$pid" 2>/dev/null || rm -f "$f"
  done
  first=$(ls "$queue" 2>/dev/null | head -n1)
  if [ "$queue/$first" = "$ticket" ]; then
    if flock -w 2 9; then
      first=$(ls "$queue" 2>/dev/null | head -n1)  # a priority ticket may have arrived while we blocked
      [ "$queue/$first" = "$ticket" ] && break
      flock -u 9
    fi
  else
    sleep 0.2
  fi
done
t1=$(date +%s.%N)
rm -f "$ticket"

if [ "$stop" = 1 ]; then
  p=$(server_pid) || { echo "no $project server running" >&2; exit 0; }
  kill "$p"; exit 0
fi

if ! server_pid >/dev/null; then
  mb=$(available_mb)
  if [ "$mb" -lt "$MIN_START_MB" ]; then
    echo "tools/compile: no $project shadow-cljs server and only $mb MB available ($MIN_START_MB needed to start one)" >&2
    exit 1
  fi
  echo "tools/compile: starting the $project shadow-cljs server" >&2
  # the background subshell must drop the lock fd too, or it holds the lock until the server dies
  slot=()
  [ "$(cd "$repo" && git rev-parse --git-dir)" = "$(cd "$repo" && git rev-parse --git-common-dir)" ] || \
    slot=(env RES_SLOT_MAX_WAIT_MS=${RES_SLOT_MAX_WAIT_MS:-120000} "$repo/tools/res-slot" compile --)
  (exec 9>&-; cd "$dir" && exec setsid nohup "${slot[@]}" npx shadow-cljs server >"$dir/.shadow-cljs/server.log" 2>&1 </dev/null) &
  bg=$!
  for _ in $(seq 1 300); do
    p=$(server_pid) && [ -s "$dir/.shadow-cljs/nrepl.port" ] && [ -s "$dir/.shadow-cljs/http.port" ] && break
    if ! kill -0 "$bg" 2>/dev/null && grep -q '^res-slot: busy' "$dir/.shadow-cljs/server.log" 2>/dev/null; then
      echo "tools/compile: no free compile slot for a worktree $project server, retry later ($(grep '^res-slot: busy' "$dir/.shadow-cljs/server.log" | tail -n1))" >&2
      exit 75
    fi
    sleep 0.5
  done
  server_pid >/dev/null || { echo "tools/compile: the $project server did not start (see $dir/.shadow-cljs/server.log)" >&2; exit 1; }
  sleep 3
fi

cd "$dir" || exit 1
# the server (and any detached child) must not inherit the lock fd
npx shadow-cljs "$verb" "${builds[@]}" 9>&-
code=$?
t2=$(date +%s.%N)
[ -z "${MC_COMPILE_LOG:-}" ] || awk -v a="$t0" -v b="$t1" -v c="$t2" 'BEGIN{printf "tools/compile: waited %.1fs, compiled %.1fs\n", b-a, c-b}' >&2
exit $code
