#!/usr/bin/env bash
# tools/compile <engine|dashboard> <build>... [--priority] [--release]
# tools/compile <engine|dashboard> --stop
#   --output-dir DIR  build into DIR instead of the build's :output-dir (shadow-cljs --config-merge; relative to dashboard/).
#   --ns-regexp RE    build only the namespaces matching RE (a Java regex; :ns-regexp of a :node-test build) and their deps.
# Both project words use the one shadow-cljs project in dashboard/ (engine builds write to engine/out); `dashboard test` is the :dashboard-test build.
#
# Every cljs compile in this repo goes through here: it queues for one of MC_COMPILE_SLOTS (default 3) machine-wide compile
# slots (/tmp/mc-compile.lock, then .1, .2: taken here, so never wrap this in flock), one compile per checkout, and runs `npx shadow-cljs compile|release <build>` in dashboard/.
# In the main checkout the shadow-cljs CLI connects to its long-lived `shadow-cljs server` (warm: ~10 s instead of ~20-50 s); this script
# starts that server first, detached, when it is not running and memory allows. A git worktree (fixers, integration, bisect) compiles in a pool slot
# (see Pool below); with no slot it is a one-shot JVM run under a tools/res-slot `server` slot
# (memory floor, max; taken before the compile queue, waits up to RES_SLOT_MAX_WAIT_MS, default 45 min, then exits 75).
#
#   --priority  jump the queue: ahead of every waiting normal compile (it still waits for the compile now running).
#               For the owner's UI rebuilds (dashboard ui/server) and nothing else.
#   --release   `shadow-cljs release` instead of `compile` (the :viewer build); the engine :body-release build always does.
#   A build-time .clj on the build source paths newer than the running server restarts it before the compile (shadow-cljs does not reload macros).
#   --stop      stop the checkout's server (waits for the checkout's compile; for restarts; no build argument).
#
# Queue: a ticket file <lane>-<ns>-<pid> per waiter in /tmp/mc-compile.queue (lane 0 priority, 1 normal; content "<wait|ready> <dir>"),
# polled every 0.2 s, so order is priority lane first, then arrival. A waiter first takes its checkout's lock
# (dashboard/.shadow-cljs/compile.lock) once no earlier ticket is for the same checkout, starts or restarts the main server
# (never while holding a compile slot) and marks the ticket ready; then it takes a free slot once fewer than MC_COMPILE_SLOTS
# ready tickets are ahead of it. Dead waiters' tickets are pruned. Running under a process that holds the lock (an ancestor with the lock file open, e.g.
# `flock /tmp/mc-compile.lock tools/compile ...`) would wait for itself for ever: it exits 2 at once instead.
# Memory: a missing server starts only with MIN_START_MB (3500) available; the compile itself uses the server's heap.
# The main server stops itself after MC_COMPILE_MAIN_IDLE_S (1800) without a compile (tools/compile-idle-watch, started with it: kills only that pid with that start time, never during a compile; the next compile restarts it).
# A waiter holding its checkout writes last-use.compiling, so its server is not stopped while it waits for a slot.
# A build that prints an :undeclared-var, :undeclared-ns or :fn-arity warning exits 1 (shadow-cljs itself exits 0).
# Env: MC_COMPILE_LOG=1 prints "waited Ns, compiled Ns".
set -u
repo="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
lock=${MC_COMPILE_LOCK:-/tmp/mc-compile.lock}   # env overrides are for tools/compile.test.sh only
queue=${MC_COMPILE_QUEUE:-/tmp/mc-compile.queue}
MIN_START_MB=${MC_COMPILE_MIN_START_MB:-3500}
slots=${MC_COMPILE_SLOTS:-3}   # compiles at once machine-wide; each runs in its own checkout's server, whose memory res-slot gates

usage() { echo "usage: tools/compile <engine|dashboard> <build>... [--priority] [--release] [--output-dir DIR] [--ns-regexp RE] | <engine|dashboard> --stop" >&2; exit 2; }

[ $# -ge 2 ] || usage
project=$1; shift
case "$project" in engine|dashboard) ;; *) usage ;; esac
dir="$repo/dashboard"   # one shadow-cljs project (dashboard/shadow-cljs.edn) holds both; one server per checkout
args=("$@"); lane=1; verb=compile; stop=0; builds=(); extra=(); outdir=
while [ $# -gt 0 ]; do
  a=$1; shift
  case "$a" in
    --output-dir) [ $# -gt 0 ] || usage; outdir=$1; extra+=(--config-merge "{:output-dir \"$1\"}"); shift ;;
    --ns-regexp) [ $# -gt 0 ] || usage; extra+=(--config-merge "{:ns-regexp \"${1//\\/\\\\}\"}"); shift ;;
    --priority) lane=0 ;;
    --release) verb=release ;;
    --stop) stop=1 ;;
    -*) usage ;;
    body-release) builds+=("$a"); verb=release ;;   # the body's release build
    *) builds+=("$a") ;;
  esac
done
[ "$stop" = 1 ] || [ ${#builds[@]} -gt 0 ] || usage
# body-release is built beside its target, checked against the job files, then renamed: a running body or a crashed compile never sees a partial or job-less bundle
tmp_bundle=
if [ "$stop" = 0 ] && [ -z "$outdir" ] && [ "${builds[*]}" = body-release ]; then
  tmp_bundle="$repo/engine/out/body-release.new.cjs"
  extra+=(--config-merge '{:output-to "../engine/out/body-release.new.cjs" :output-dir "../engine/out/body-release.new"}')
fi
# the dashboard's own unit-test build is :dashboard-test (:test is the engine's)
[ "$project" = dashboard ] && for i in "${!builds[@]}"; do [ "${builds[$i]}" = test ] && builds[$i]=dashboard-test; done

# a world run calls the agent tools (bin/*): build their bundle in the same compile when it is missing or stale
if [ "$project" = dashboard ] && [ "$stop" = 0 ] && [ -z "$outdir" ] && [ "${builds[*]}" = world-test ] && "$repo/tools/agent-tools-stale" "$repo"; then
  builds+=(agent-tools)
fi

log_builds="${builds[*]}"; restarted=0; fallback=${MC_COMPILE_FALLBACK:-}; pick_wait=${MC_COMPILE_PICK_WAIT_S:-}
available_mb() { awk '/MemAvailable/ {print int($2/1024)}' /proc/meminfo; }
worktree=0; [ -n "${MC_COMPILE_IN_POOL:-}" ] || [ "$(cd "$repo" && git rev-parse --git-dir 2>/dev/null)" = "$(cd "$repo" && git rev-parse --git-common-dir 2>/dev/null)" ] || worktree=1
server_pid() { local p; p=$(cat "$dir/.shadow-cljs/server.pid" 2>/dev/null) && [ -n "$p" ] && kill -0 "$p" 2>/dev/null && echo "$p"; }

# Deadlock guard: an ancestor process holding the lock file open (flock(1) wrapping us, or an inherited fd) means we would wait for ourselves.
if [ -e "$lock" ]; then
  want=$(stat -c %i "$lock")
  a=$PPID
  while [ -n "$a" ] && [ "$a" -gt 1 ]; do
    for fd in /proc/$a/fd/*; do
      [ "$(stat -L -c %i "$fd" 2>/dev/null)" = "$want" ] && [ "$(stat -L -c %d "$fd" 2>/dev/null)" = "$(stat -c %d "$lock")" ] || continue
      echo "tools/compile: process $a already holds $lock. tools/compile takes the lock itself; don't wrap it in flock (or run it from a lock holder)." >&2
      exit 2
    done
    a=$(sed 's/.*) //' "/proc/$a/stat" 2>/dev/null | awk '{print $2}')
  done
fi

# Starts the checkout's server when none runs (callers check server_pid first).
start_server() {
  mb=$(available_mb)
  if [ "$mb" -lt "$MIN_START_MB" ]; then
    echo "tools/compile: no shadow-cljs server and only $mb MB available ($MIN_START_MB needed to start one)" >&2
    exit 1
  fi
  echo "tools/compile: starting the shadow-cljs server" >&2
  # the background subshell must drop the lock fds (7, 9) too, or it holds the lock until the server dies
  # The server is shared by every agent: double fork so it is no descendant of the caller's shell, and drop the agent label
  # (LIVE_TESTS_AGENT_ID), so agent-usage attributes it to no agent (agent_reap of the starter must not kill it). The idle watcher stops it.
  rm -f "$dir/.shadow-cljs/launch.pid"
  ( (exec 7>&- 9>&-; echo "$BASHPID" > "$dir/.shadow-cljs/launch.pid"; cd "$dir" && exec setsid nohup env -u LIVE_TESTS_AGENT_ID COMPILE_SHARED=1 npx shadow-cljs server >"$dir/.shadow-cljs/server.log" 2>&1 </dev/null) & )
  for ((i=0; i < 300; i++)); do
    p=$(server_pid) && [ -s "$dir/.shadow-cljs/nrepl.port" ] && [ -s "$dir/.shadow-cljs/http.port" ] && break
    bg=$(cat "$dir/.shadow-cljs/launch.pid" 2>/dev/null)
    if [ -n "$bg" ] && ! kill -0 "$bg" 2>/dev/null && ! server_pid >/dev/null; then break; fi
    sleep 0.5
  done
  server_pid >/dev/null || { echo "tools/compile: the shadow-cljs server did not start (see $dir/.shadow-cljs/server.log)" >&2; [ -z "${MC_COMPILE_IN_POOL:-}" ] || exit 76; exit 1; }
  # idle watcher: a server must not outlive its use (every JVM holds ~2 GB)
  touch "$dir/.shadow-cljs/last-use"
  sp=$(server_pid)
  ( (exec 7>&- 9>&-; exec setsid nohup env -u LIVE_TESTS_AGENT_ID COMPILE_SHARED=1 "$repo/tools/compile-idle-watch" "$sp" "$(awk '{print $22}' "/proc/$sp/stat")" "$dir/.shadow-cljs/last-use" \
    "${MC_COMPILE_MAIN_IDLE_S:-1800}" "${MC_COMPILE_IDLE_POLL_S:-30}" >/dev/null 2>&1 </dev/null) & )
  sleep 3
}

# shadow-cljs does not reload macro / build-hook .clj files into a running server: one changed since it started means stale
# macros (bogus "undeclared" errors until a restart). Called holding the checkout lock, so no compile of it is running.
restart_if_stale() {
  local p
  p=$(server_pid) && [ -n "$(find "$repo/engine/src" "$repo/engine/test" "$repo/engine/test-support" "$repo/dashboard/src" "$repo/dashboard/test" "$repo/dashboard/bench-src" -name '*.clj' -newer "/proc/$p" -print -quit 2>/dev/null)" ] || return 0
  echo "tools/compile: a build-time .clj file changed since the server started; restarting it" >&2
  restarted=1
  kill "$p"
  for _ in $(seq 1 100); do kill -0 "$p" 2>/dev/null || break; sleep 0.2; done
  kill -0 "$p" 2>/dev/null && { echo "tools/compile: the old server (pid $p) did not stop" >&2; exit 1; }
  return 0
}

# Pool: a worktree compile runs in one of MC_COMPILE_POOL_SIZE (default 4; 0 = off) warm checkout-shaped copies under MC_COMPILE_POOL_DIR
# (default ~/.cache/mc-compile-pool/<i>), each with its own server run by this same script as if it were a main checkout. Under the slot's
# .pool.lock (held for the whole compile, so two compiles never share a slot) the worktree's sources are rsynced in (--delete, by content, changed
# files get a fresh mtime so shadow and the macro-restart check see them), the compile runs there, and the builds' output dirs are rsynced back.
# No free slot within MC_COMPILE_POOL_WAIT_S (180), a slot whose server is down with memory below MIN_START_MB, or a failed sync or a slot server that does not start (exit 76 inside the slot) fall back to the one-shot JVM below.
pool_dir=${MC_COMPILE_POOL_DIR:-$HOME/.cache/mc-compile-pool}
pool_size=${MC_COMPILE_POOL_SIZE:-4}

# build output paths (relative to dashboard/) of the given builds, from dashboard/shadow-cljs.edn
pool_outputs() {
  awk -v want=" $* " '
    /^ *\{?:[A-Za-z0-9-]+ \{:target/ { s=$0; sub(/^ *\{?:/, "", s); sub(/ .*/, "", s); cur=s }
    index(want, " " cur " ") { l=$0; while (match(l, /:output-(dir|to) "[^"]*"/)) { v=substr(l, RSTART, RLENGTH); sub(/^[^"]*"/, "", v); sub(/"$/, "", v); print v; l=substr(l, RSTART+RLENGTH) } }' "$dir/shadow-cljs.edn"
}

# engine/out/build-id.edn: the commit a body bundle was built from (engine.build reads it at start; a hash with -dirty: tracked files differ from it); the pool slot has no .git, so the checkout writes it
write_build_id() {
  local b
  for b in "${builds[@]}"; do
    case "$b" in body|body-release) printf '{:commit "%s"}\n' "$(git -C "$repo" rev-parse --short HEAD)$(git -C "$repo" diff --quiet HEAD -- engine dashboard tools 2>/dev/null || echo -dirty)" > "$repo/engine/out/build-id.edn"; return ;; esac
  done
}

# rsync options shared by the sync into a slot and the dry-run that scores it
pool_sync_opts=(-rl --delete --exclude .git --exclude .claude --exclude .shadow-cljs --exclude docs --exclude worlds --exclude state --exclude textures --exclude viaproxy --exclude blueprints
  --exclude /engine/out --exclude /dashboard/out --exclude /tools/view/web/cljs --exclude .pool.lock --exclude .last)

# files a sync of the worktree into slot $1 would change (dry run by size, ~0.1 s): the fewer, the more of the slot's warm shadow cache stays valid
pool_distance() {
  mkdir -p "$1"
  rsync -n --size-only --stats "${pool_sync_opts[@]}" "$repo/" "$1/" 2>/dev/null |
    awk -F': ' '/^Number of regular files transferred/ {n += $2} /^Number of deleted files/ {gsub(/,/, "", $2); n += $2 + 0} END {print n + 0}'
}

# sets slot to the free slot nearest the worktree's sources and holds its .pool.lock on fd 8; 1 when none frees up in time.
# A busy slot much nearer than the best free one is waited for up to MC_COMPILE_POOL_CLOSE_WAIT_S (5).
pool_pick() {
  local i s d best bestd busyd near=${MC_COMPILE_POOL_CLOSE_GAP:-100} start=$SECONDS deadline=$((SECONDS + ${MC_COMPILE_POOL_WAIT_S:-180}))
  while :; do
    best=; bestd=; busyd=
    for ((i = 0; i < pool_size; i++)); do
      s=$pool_dir/$i
      d=$(pool_distance "$s")
      if ( flock -n 8 ) 8>>"$s/.pool.lock"; then
        [ -n "$bestd" ] && [ "$bestd" -le "$d" ] || { best=$s; bestd=$d; }
      else
        [ -n "$busyd" ] && [ "$busyd" -le "$d" ] || busyd=$d
      fi
    done
    if [ -n "$best" ] && { [ -z "$busyd" ] || [ $((bestd - busyd)) -lt "$near" ] || [ $((SECONDS - start)) -ge "${MC_COMPILE_POOL_CLOSE_WAIT_S:-5}" ]; }; then
      exec 8>>"$best/.pool.lock"
      if flock -n 8; then slot=$best; return 0; fi
      exec 8>&-
      continue
    fi
    [ "$SECONDS" -lt "$deadline" ] || return 1
    sleep 0.5
  done
}

pool_compile() {
  local slot p code out o
  # the worktree's own checkout lock: two compiles of one worktree must not race on the slot sync or the output rsync back
  mkdir -p "$dir/.shadow-cljs"; exec 7>>"$dir/.shadow-cljs/compile.lock"; flock 7
  local t=$SECONDS
  pool_pick || { fallback="no free slot in ${MC_COMPILE_POOL_WAIT_S:-180}s"; exec 7>&-; return 1; }
  pick_wait=$((SECONDS - t))
  p=$(cat "$slot/dashboard/.shadow-cljs/server.pid" 2>/dev/null)
  if { [ -z "$p" ] || ! kill -0 "$p" 2>/dev/null; } && [ "$(available_mb)" -lt "$MIN_START_MB" ]; then
    fallback="slot server down, ${MIN_START_MB} MB not free"; exec 8>&- 7>&-; return 1
  fi
  mkdir -p "$slot/dashboard/.shadow-cljs"
  [ -d "$slot/dashboard/.shadow-cljs/builds" ] || "$repo/tools/seed-shadow-cache.sh" "$slot" >/dev/null 2>&1
  rsync -c -p "${pool_sync_opts[@]}" "$repo/" "$slot/" || { fallback="rsync into slot failed"; exec 8>&- 7>&-; return 1; }
  echo "$repo" > "$slot/.last"
  echo "tools/compile: pool slot $slot" >&2
  # fd 8 is closed for the compile: a server it starts must not inherit the slot lock
  # slot paths in the output (warning "File:" lines, which test-engine checks for edits) are shown as the worktree's
  MC_COMPILE_FROM=$repo MC_COMPILE_PICK_WAIT_S=$pick_wait MC_COMPILE_IN_POOL=1 MC_COMPILE_MAIN_IDLE_S=${MC_COMPILE_POOL_IDLE_S:-300} "$slot/tools/compile" "$project" "${args[@]}" 7>&- 8>&- 2>&1 | sed -u "s|$slot|$repo|g"
  code=${PIPESTATUS[0]}
  if [ "$code" = 0 ]; then
    write_build_id
    out=$(pool_outputs "${builds[@]}")
    [ -z "$outdir" ] || out="$out"$'\n'"$outdir"
    for o in $out; do
      case "$o" in /*) continue ;; esac
      [ -e "$slot/dashboard/$o" ] || continue
      mkdir -p "$(dirname "$dir/$o")"
      if [ -d "$slot/dashboard/$o" ]; then rsync -a --delete "$slot/dashboard/$o/" "$dir/$o/"; else rsync -a "$slot/dashboard/$o" "$dir/$o" && sed -i "s|$slot/dashboard|$dir|g" "$dir/$o"; fi
    done
  fi
  exec 8>&- 7>&-
  [ "$code" = 76 ] && { fallback="slot server did not start"; return 1; }
  exit $code
}
if [ "$worktree" = 1 ] && [ "$stop" = 0 ] && [ "$pool_size" -gt 0 ] && [ -z "${MC_COMPILE_IN_SLOT:-}" ]; then
  pool_compile
  echo "tools/compile: no pool slot ($fallback); compiling one-shot" >&2
  export MC_COMPILE_FALLBACK=$fallback
fi

# a worktree compile holds its JVM's memory slot from before it queues until it ends
if [ "$worktree" = 1 ] && [ "$stop" = 0 ] && [ -z "${MC_COMPILE_IN_SLOT:-}" ]; then
  MC_COMPILE_IN_SLOT=1 RES_SLOT_MAX_WAIT_MS=${RES_SLOT_MAX_WAIT_MS:-2700000} exec "$repo/tools/res-slot" server -- "$0" "$project" "${args[@]}"
fi

mkdir -p "$queue" "$dir/.shadow-cljs"
exec 7>>"$dir/.shadow-cljs/compile.lock"
if [ "$stop" = 1 ]; then
  flock 7
  p=$(server_pid) || { echo "no shadow-cljs server running" >&2; exit 0; }
  kill "$p"; exit 0
fi

ticket="$queue/$lane-$(date +%s%N)-$$"
echo "wait $dir" > "$ticket"
out=
trap 'rm -f "$ticket" "$out"; [ "$(cat "$dir/.shadow-cljs/last-use.compiling" 2>/dev/null)" = "$$" ] && rm -f "$dir/.shadow-cljs/last-use.compiling"' EXIT
t0=$(date +%s.%N)
own=0
while :; do
  same=0; ready=0
  for f in $(ls "$queue" 2>/dev/null); do
    [ "$queue/$f" = "$ticket" ] && break
    kill -0 "${f##*-}" 2>/dev/null || { rm -f "$queue/$f"; continue; }  # a dead waiter's ticket
    read -r st d < "$queue/$f" 2>/dev/null || continue
    [ "$d" = "$dir" ] && same=1
    [ "$st" = ready ] && ready=$((ready + 1))
  done
  if [ "$own" = 0 ] && [ "$same" = 0 ] && flock -n 7; then
    own=1
    echo $$ > "$dir/.shadow-cljs/last-use.compiling"
    [ "$worktree" = 1 ] || { restart_if_stale; server_pid >/dev/null || start_server; }
    touch "$dir/.shadow-cljs/last-use"
    echo "ready $dir" > "$ticket"
    continue
  fi
  if [ "$own" = 1 ] && [ "$ready" -lt "$slots" ]; then
    for ((i = 0; i < slots; i++)); do
      s=$lock; [ "$i" = 0 ] || s=$lock.$i
      exec 9>>"$s"
      flock -n 9 && break 2
      exec 9>&-
    done
  fi
  sleep 0.2
done
t1=$(date +%s.%N)
rm -f "$ticket"

cd "$dir" || exit 1
touch .shadow-cljs/last-use  # last-use.compiling (written when queued) keeps the idle watcher off while compiling, last-use for the idle time after
# the server (and any detached child) must not inherit the lock fds
out=$(mktemp)
npx shadow-cljs "$verb" "${builds[@]}" "${extra[@]}" 7>&- 9>&- 2>&1 | tee "$out"
code=${PIPESTATUS[0]}
# shadow-cljs only warns on a call to a missing var or namespace (a moved function) or with the wrong number of args: the build passes and the job throws or reads nil at run time.
if [ "$code" = 0 ] && grep -qE 'WARNING #[0-9]+ - :(undeclared-(var|ns)|fn-arity)' "$out"; then
  echo "tools/compile: failing the build: undeclared-var/undeclared-ns/fn-arity warning above (a call to a var or namespace that does not exist, or with the wrong number of args)" >&2
  code=1
fi
rm -f "$out"; out=
if [ -n "$tmp_bundle" ]; then
  [ "$code" != 0 ] || "$repo/tools/bundle-jobs-check" "$tmp_bundle" "$repo/engine/src/jobs" || code=1
  if [ "$code" = 0 ]; then mv -f "$tmp_bundle" "$repo/engine/out/body-release.cjs"; else echo "tools/compile: body-release.cjs left as it was" >&2; fi
  rm -rf "$tmp_bundle" "$repo/engine/out/body-release.new"
fi
[ "$code" = 0 ] && [ -z "${MC_COMPILE_IN_POOL:-}" ] && write_build_id
touch .shadow-cljs/last-use; rm -f .shadow-cljs/last-use.compiling
t2=$(date +%s.%N)
[ -z "${MC_COMPILE_LOG:-}" ] || awk -v a="$t0" -v b="$t1" -v c="$t2" 'BEGIN{printf "tools/compile: waited %.1fs, compiled %.1fs\n", b-a, c-b}' >&2
printf '{"t":"%s","kind":"compile","run":"%s","cwd":"%s","build":"%s","from":"%s","pickWaitS":"%s","fallback":"%s","restarted":%s,"waitedS":%.0f,"compiledS":%.0f,"code":%s}\n' "$(date -u +%FT%T.%3NZ)" "${MC_RUN_ID:-}" "$PWD" "$log_builds" "${MC_COMPILE_FROM:-$repo}" "$pick_wait" "$fallback" "$restarted" "$(awk -v a="$t0" -v b="$t1" 'BEGIN{print b-a}')" "$(awk -v b="$t1" -v c="$t2" 'BEGIN{print c-b}')" "$code" 2>/dev/null >> "${RES_SLOT_DIR:-/tmp/mc-res}/log.jsonl"
exit $code
