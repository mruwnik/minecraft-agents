#!/usr/bin/env bash
# tools/compile <engine|dashboard> <build>... [--priority] [--release]
# tools/compile <engine|dashboard> --stop
#   --output-dir DIR  build into DIR instead of the build's :output-dir (shadow-cljs --config-merge; relative to dashboard/).
# Both project words use the one shadow-cljs project in dashboard/ (engine builds write to engine/out); `dashboard test` is the :dashboard-test build.
#
# Every cljs compile in this repo goes through here: it queues for one of MC_COMPILE_SLOTS (default 3) machine-wide compile
# slots (/tmp/mc-compile.lock, then .1, .2: taken here, so never wrap this in flock), one compile per checkout, and runs `npx shadow-cljs compile|release <build>` in dashboard/. The shadow-cljs CLI
# connects to the checkout's long-lived `shadow-cljs server` when one runs (no JVM per compile, ~2 s instead of ~30 s); this
# script starts that server first, detached, when it is not running and memory allows.
#
#   --priority  jump the queue: ahead of every waiting normal compile (it still waits for the compile now running).
#               For the owner's UI rebuilds (dashboard ui/server) and nothing else.
#   --release   `shadow-cljs release` instead of `compile` (the :viewer build); the engine :body-release build always does.
#   A build-time .clj (engine/src, dashboard/src) newer than the running server restarts it before the compile (shadow-cljs does not reload macros).
#   --stop      stop the checkout's server (waits for the checkout's compile; for restarts; no build argument).
#
# Queue: a ticket file <lane>-<ns>-<pid> per waiter in /tmp/mc-compile.queue (lane 0 priority, 1 normal; content "<wait|ready> <dir>"),
# polled every 0.2 s, so order is priority lane first, then arrival. A waiter first takes its checkout's lock
# (dashboard/.shadow-cljs/compile.lock) once no earlier ticket is for the same checkout, starts or restarts the server there
# (never while holding a compile slot) and marks the ticket ready; then it takes a free slot once fewer than MC_COMPILE_SLOTS
# ready tickets are ahead of it. Dead waiters' tickets are pruned. Running under a process that holds the lock (an ancestor with the lock file open, e.g.
# `flock /tmp/mc-compile.lock tools/compile ...`) would wait for itself for ever: it exits 2 at once instead.
# Memory: a missing server starts only with MIN_START_MB (3500) available; the compile itself uses the server's heap.
# A server started outside the main checkout (a git worktree: integration batches, test copies) runs under a `server` slot of
# tools/res-slot (held for the server's life, so its JVM counts against the memory floor; kind apart from compiles, max 4); a start queues for a slot up to RES_SLOT_MAX_WAIT_MS (default 45 min, a status line every MC_COMPILE_WAIT_LINE_S=60 s), then exits 75 (retry).
# Every server stops itself after an idle time without a compile: MC_COMPILE_SERVER_IDLE_S (default 150) for a worktree, MC_COMPILE_MAIN_IDLE_S (1800) for the main checkout (tools/compile-idle-watch, started with it: kills only that pid with that start time, never during a compile; the next compile restarts it).
# A waiter holding its checkout writes last-use.compiling, so its server is not stopped while it waits for a slot.
# A build that prints an :undeclared-var, :undeclared-ns or :fn-arity warning exits 1 (shadow-cljs itself exits 0).
# Env: MC_COMPILE_LOG=1 prints "waited Ns, compiled Ns".
set -u
repo="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
lock=${MC_COMPILE_LOCK:-/tmp/mc-compile.lock}   # env overrides are for tools/compile.test.sh only
queue=${MC_COMPILE_QUEUE:-/tmp/mc-compile.queue}
MIN_START_MB=${MC_COMPILE_MIN_START_MB:-3500}
slots=${MC_COMPILE_SLOTS:-3}   # compiles at once machine-wide; each runs in its own checkout's server, whose memory res-slot gates

usage() { echo "usage: tools/compile <engine|dashboard> <build>... [--priority] [--release] [--output-dir DIR] | <engine|dashboard> --stop" >&2; exit 2; }

[ $# -ge 2 ] || usage
project=$1; shift
case "$project" in engine|dashboard) ;; *) usage ;; esac
dir="$repo/dashboard"   # one shadow-cljs project (dashboard/shadow-cljs.edn) holds both; one server per checkout
lane=1; verb=compile; stop=0; builds=(); extra=()
while [ $# -gt 0 ]; do
  a=$1; shift
  case "$a" in
    --output-dir) [ $# -gt 0 ] || usage; extra=(--config-merge "{:output-dir \"$1\"}"); shift ;;
    --priority) lane=0 ;;
    --release) verb=release ;;
    --stop) stop=1 ;;
    -*) usage ;;
    body-release) builds+=("$a"); verb=release ;;   # the body's release build
    *) builds+=("$a") ;;
  esac
done
[ "$stop" = 1 ] || [ ${#builds[@]} -gt 0 ] || usage
# the dashboard's own unit-test build is :dashboard-test (:test is the engine's)
[ "$project" = dashboard ] && for i in "${!builds[@]}"; do [ "${builds[$i]}" = test ] && builds[$i]=dashboard-test; done

available_mb() { awk '/MemAvailable/ {print int($2/1024)}' /proc/meminfo; }
server_pid() { local p; p=$(cat "$dir/.shadow-cljs/server.pid" 2>/dev/null) && [ -n "$p" ] && kill -0 "$p" 2>/dev/null && echo "$p"; }

# Deadlock guard: an ancestor process holding the lock file open (flock(1) wrapping us, or an inherited fd) means we would wait for ourselves.
if [ -e "$lock" ]; then
  want=$(stat -c %i "$lock")
  a=$PPID
  while [ -n "$a" ] && [ "$a" -gt 1 ]; do
    for fd in /proc/$a/fd/*; do
      [ "$(stat -L -c %i "$fd" 2>/dev/null)" = "$want" ] && [ "$(stat -L -c %d "$fd" 2>/dev/null)" = "$(stat -c %d "$lock")" ] || continue
      echo "tools/compile: process $a already holds $lock. tools/compile takes the lock itself; don't wrap it in flock (or run it from a lock holder)." >&2
      exit 2
    done
    a=$(awk '{print $4}' "/proc/$a/stat" 2>/dev/null)
  done
fi

# Starts the checkout's server when none runs (callers check server_pid first).
start_server() {
  mb=$(available_mb)
  if [ "$mb" -lt "$MIN_START_MB" ]; then
    echo "tools/compile: no shadow-cljs server and only $mb MB available ($MIN_START_MB needed to start one)" >&2
    exit 1
  fi
  echo "tools/compile: starting the shadow-cljs server" >&2
  # the background subshell must drop the lock fds (7, 9) too, or it holds the lock until the server dies
  slot=(); loops=300
  idle=${MC_COMPILE_MAIN_IDLE_S:-1800}
  [ "$(cd "$repo" && git rev-parse --git-dir)" = "$(cd "$repo" && git rev-parse --git-common-dir)" ] || { idle=${MC_COMPILE_SERVER_IDLE_S:-150}
    loops=-1 # waiting for a slot is bounded by res-slot's own max wait, not by this loop
    slot=(env RES_SLOT_MAX_WAIT_MS=${RES_SLOT_MAX_WAIT_MS:-2700000} "$repo/tools/res-slot" server --); }
  # The server is shared by every agent: double fork so it is no descendant of the caller's shell, and drop the agent label
  # (LIVE_TESTS_AGENT_ID), so agent-usage attributes it to no agent (agent_reap of the starter must not kill it). The idle watcher stops it.
  rm -f "$dir/.shadow-cljs/launch.pid"
  ( (exec 7>&- 9>&-; echo "$BASHPID" > "$dir/.shadow-cljs/launch.pid"; cd "$dir" && exec setsid nohup env -u LIVE_TESTS_AGENT_ID COMPILE_SHARED=1 "${slot[@]}" npx shadow-cljs server >"$dir/.shadow-cljs/server.log" 2>&1 </dev/null) & )
  last_line=$SECONDS
  for ((i=0; loops < 0 || i < loops; i++)); do
    p=$(server_pid) && [ -s "$dir/.shadow-cljs/nrepl.port" ] && [ -s "$dir/.shadow-cljs/http.port" ] && break
    bg=$(cat "$dir/.shadow-cljs/launch.pid" 2>/dev/null)
    if [ -n "$bg" ] && ! kill -0 "$bg" 2>/dev/null && grep -q '^res-slot: busy' "$dir/.shadow-cljs/server.log" 2>/dev/null; then
      echo "tools/compile: no free server slot for a worktree server, retry later ($(grep '^res-slot: busy' "$dir/.shadow-cljs/server.log" | tail -n1))" >&2
      exit 75
    fi
    if [ -n "$bg" ] && ! kill -0 "$bg" 2>/dev/null && ! server_pid >/dev/null; then break; fi
    if [ "$loops" -lt 0 ] && [ $((SECONDS - last_line)) -ge "${MC_COMPILE_WAIT_LINE_S:-60}" ] && w=$(grep '^res-slot: waiting' "$dir/.shadow-cljs/server.log" 2>/dev/null | tail -n1) && [ -n "$w" ]; then
      last_line=$SECONDS; echo "tools/compile: queued for a server slot: ${w#res-slot: }" >&2
    fi
    sleep 0.5
  done
  server_pid >/dev/null || { echo "tools/compile: the shadow-cljs server did not start (see $dir/.shadow-cljs/server.log)" >&2; exit 1; }
  # idle watcher: a server must not outlive its use (a worktree's holds a server slot; every JVM holds ~2 GB)
  touch "$dir/.shadow-cljs/last-use"
  sp=$(server_pid)
  ( (exec 7>&- 9>&-; exec setsid nohup env -u LIVE_TESTS_AGENT_ID COMPILE_SHARED=1 "$repo/tools/compile-idle-watch" "$sp" "$(awk '{print $22}' "/proc/$sp/stat")" "$dir/.shadow-cljs/last-use" \
    "$idle" "${MC_COMPILE_IDLE_POLL_S:-30}" >/dev/null 2>&1 </dev/null) & )
  sleep 3
}

# shadow-cljs does not reload macro / build-hook .clj files into a running server: one changed since it started means stale
# macros (bogus "undeclared" errors until a restart). Called holding the checkout lock, so no compile of it is running.
restart_if_stale() {
  local p
  p=$(server_pid) && [ -n "$(find "$repo/engine/src" "$repo/dashboard/src" "$repo/dashboard/bench-src" -name '*.clj' -newer "/proc/$p" -print -quit 2>/dev/null)" ] || return 0
  echo "tools/compile: a build-time .clj file changed since the server started; restarting it" >&2
  kill "$p"
  for _ in $(seq 1 100); do kill -0 "$p" 2>/dev/null || break; sleep 0.2; done
  kill -0 "$p" 2>/dev/null && { echo "tools/compile: the old server (pid $p) did not stop" >&2; exit 1; }
  return 0
}

mkdir -p "$queue" "$dir/.shadow-cljs"
exec 7>>"$dir/.shadow-cljs/compile.lock"
if [ "$stop" = 1 ]; then
  flock 7
  p=$(server_pid) || { echo "no shadow-cljs server running" >&2; exit 0; }
  kill "$p"; exit 0
fi

ticket="$queue/$lane-$(date +%s%N)-$$"
echo "wait $dir" > "$ticket"
out=
trap 'rm -f "$ticket" "$out"; [ "$(cat "$dir/.shadow-cljs/last-use.compiling" 2>/dev/null)" = "$$" ] && rm -f "$dir/.shadow-cljs/last-use.compiling"' EXIT
t0=$(date +%s.%N)
own=0
while :; do
  same=0; ready=0
  for f in $(ls "$queue" 2>/dev/null); do
    [ "$queue/$f" = "$ticket" ] && break
    kill -0 "${f##*-}" 2>/dev/null || { rm -f "$queue/$f"; continue; }  # a dead waiter's ticket
    read -r st d < "$queue/$f" 2>/dev/null || continue
    [ "$d" = "$dir" ] && same=1
    [ "$st" = ready ] && ready=$((ready + 1))
  done
  if [ "$own" = 0 ] && [ "$same" = 0 ] && flock -n 7; then
    own=1
    echo $$ > "$dir/.shadow-cljs/last-use.compiling"
    restart_if_stale
    server_pid >/dev/null || start_server
    touch "$dir/.shadow-cljs/last-use"
    echo "ready $dir" > "$ticket"
    continue
  fi
  if [ "$own" = 1 ] && [ "$ready" -lt "$slots" ]; then
    for ((i = 0; i < slots; i++)); do
      s=$lock; [ "$i" = 0 ] || s=$lock.$i
      exec 9>>"$s"
      flock -n 9 && break 2
      exec 9>&-
    done
  fi
  sleep 0.2
done
t1=$(date +%s.%N)
rm -f "$ticket"

cd "$dir" || exit 1
touch .shadow-cljs/last-use  # last-use.compiling (written when queued) keeps the idle watcher off while compiling, last-use for the idle time after
# the server (and any detached child) must not inherit the lock fds
out=$(mktemp)
npx shadow-cljs "$verb" "${builds[@]}" "${extra[@]}" 7>&- 9>&- 2>&1 | tee "$out"
code=${PIPESTATUS[0]}
# shadow-cljs only warns on a call to a missing var or namespace (a moved function) or with the wrong number of args: the build passes and the job throws or reads nil at run time.
if [ "$code" = 0 ] && grep -qE 'WARNING #[0-9]+ - :(undeclared-(var|ns)|fn-arity)' "$out"; then
  echo "tools/compile: failing the build: undeclared-var/undeclared-ns/fn-arity warning above (a call to a var or namespace that does not exist, or with the wrong number of args)" >&2
  code=1
fi
rm -f "$out"; out=
touch .shadow-cljs/last-use; rm -f .shadow-cljs/last-use.compiling
t2=$(date +%s.%N)
[ -z "${MC_COMPILE_LOG:-}" ] || awk -v a="$t0" -v b="$t1" -v c="$t2" 'BEGIN{printf "tools/compile: waited %.1fs, compiled %.1fs\n", b-a, c-b}' >&2
exit $code
