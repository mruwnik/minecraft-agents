#!/usr/bin/env bash
# Differ board helper (HTTP API; the differ UI has no auth).
# Usage:
#   tools/card id <prefix|title words...>   print the full card id
#   tools/card show <id|prefix>             title, status, worker, last 3 notes
#   tools/card note <id> <text>             add a note
#   tools/card move <id> <status> [note]    set status (optionally with a note)
#   tools/card claim <id> <worker>          status in_progress + "claimed by <worker>" note
#   tools/card create <title words...> [-d <description>] [-p <priority>] [-t tag,tag]
#                                           new pending card (priority default 1) with the checklist
#                                           unit, integration, review, live; prints "<id> <status> <title>"
# Env: DIFFER_URL (default http://localhost:8576), CARD_AUTHOR (default: worker from claim, else "agent"),
#      CARD_REPO (default: this repo's root).
set -euo pipefail

URL="${DIFFER_URL:-http://localhost:8576}"
REPO="${CARD_REPO:-$(cd "$(dirname "$0")/.." && pwd)}"
AUTHOR="${CARD_AUTHOR:-agent}"
UUID_RE='^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$'

die() { echo "card: $*" >&2; exit 1; }
api() { curl -sS -m 10 --fail-with-body "$@" || die "request failed (see body above)"; }

repo_enc() { jq -rn --arg r "$REPO" '$r|@uri'; }

all_tasks() { api "$URL/api/boards/$(repo_enc)/tasks?show_done=true"; }

# Resolve a prefix or title words to a full id. Dies on none/ambiguous.
resolve() {
  local q="$*"
  [[ "$q" =~ $UUID_RE ]] && { echo "$q"; return; }
  local tasks hits
  tasks=$(all_tasks)
  # An id prefix is looked up first; titles are searched only when no id starts with the query.
  hits=$(jq -r --arg q "$q" '
    .tasks[] | select(.id|startswith($q)) | "\(.id)\t\(.status)\t\(.title)"' <<<"$tasks")
  [ -n "$hits" ] || hits=$(jq -r --arg q "$q" '
    .tasks[] | select(.title|ascii_downcase|contains($q|ascii_downcase))
    | "\(.id)\t\(.status)\t\(.title)"' <<<"$tasks")
  local n
  n=$(printf '%s' "$hits" | grep -c . || true)
  [ "$n" -eq 1 ] || { [ "$n" -eq 0 ] && die "no card matches '$q'"; echo "$hits" >&2; die "$n cards match '$q'"; }
  cut -f1 <<<"$hits"
}

patch() { # id json
  api -X PATCH -H 'Content-Type: application/json' -d "$2" "$URL/api/tasks/$1" | jq -r '.task|"\(.id) \(.status) \(.title)"'
}

create_card() { # title desc priority tags-csv
  local req resp
  req=$(jq -n --arg t "$1" --arg d "$2" --argjson p "$3" --arg tags "$4" '
    {title:$t,description:$d,priority:$p,
     tags:($tags|split(",")|map(select(.!=""))),
     checklist:["unit","integration","review","live"]}')
  resp=$(api -X POST -H 'Content-Type: application/json' -d "$req" "$URL/api/boards/$(repo_enc)/tasks")
  jq -r '.task|"\(.id) \(.status) \(.title)"' <<<"$resp"
}

cmd="${1:-}"; shift || true
case "$cmd" in
  id) [ $# -ge 1 ] || die "usage: id <prefix|title words>"; resolve "$*" ;;
  show)
    [ $# -eq 1 ] || die "usage: show <id>"
    id=$(resolve "$1")
    api "$URL/api/tasks/$id" | jq -r '.task as $t |
      "\($t.id)\n\($t.title)\nstatus: \($t.status)  worker: \($t["worker-name"] // "-")",
      ($t.notes|sort_by(.["created-at"])|.[-3:][]|"--- \(.author) \(.["created-at"])\n\(.content|.[0:600])")'
    ;;
  note)
    [ $# -ge 2 ] || die "usage: note <id> <text>"
    id=$(resolve "$1"); shift
    api -X POST -H 'Content-Type: application/json' \
      -d "$(jq -n --arg c "$*" --arg a "$AUTHOR" '{content:$c,author:$a}')" \
      "$URL/api/tasks/$id/notes" | jq -r '.note.id'
    ;;
  move)
    [ $# -ge 2 ] || die "usage: move <id> <status> [note]"
    id=$(resolve "$1"); st="$2"; shift 2
    patch "$id" "$(jq -n --arg s "$st" --arg n "${*:-}" --arg a "$AUTHOR" \
      '{status:$s} + (if $n=="" then {} else {note:$n,author:$a} end)')"
    ;;
  claim)
    [ $# -eq 2 ] || die "usage: claim <id> <worker>"
    id=$(resolve "$1")
    # The HTTP API cannot set worker fields, so a claim is in_progress plus a note naming the worker.
    patch "$id" "$(jq -n --arg w "$2" '{status:"in_progress",note:"claimed by \($w)",author:$w}')"
    ;;
  create)
    desc=""; prio=1; tags=""; words=()
    while [ $# -gt 0 ]; do
      case "$1" in
        -d) [ $# -ge 2 ] || die "usage: create <title> [-d desc] [-p prio] [-t tags]"; desc="$2"; shift 2 ;;
        -p) [ $# -ge 2 ] || die "usage: create <title> [-d desc] [-p prio] [-t tags]"; prio="$2"; shift 2 ;;
        -t) [ $# -ge 2 ] || die "usage: create <title> [-d desc] [-p prio] [-t tags]"; tags="$2"; shift 2 ;;
        *) words+=("$1"); shift ;;
      esac
    done
    [ ${#words[@]} -ge 1 ] || die "usage: create <title words> [-d desc] [-p prio] [-t tag,tag]"
    [[ "$prio" =~ ^-?[0-9]+$ ]] || die "create: priority must be an integer, got '$prio'"
    create_card "${words[*]}" "$desc" "$prio" "$tags"
    ;;
  *) die "usage: card id|show|note|move|claim|create ... (see header of $0)" ;;
esac
