#!/usr/bin/env bash
# tools/test-bisect <ns>... [--good <rev>] [--bad <rev>]
# Finds the first commit where the engine test namespaces fail: one detached worktree (tools/integration-worktree.sh), `git bisect run` there,
# each step compiles and runs tools/test-engine <ns>... of THAT commit (res-slot server and tests slots, as test-engine does).
# Verdicts per step: pass = good, test failure = bad, compile failure / namespace missing / timeout / busy slot / killed (75, 137, 143) = skipped (exit 125).
# Worktree setup waits for a free server slot (retry every TEST_BISECT_RETRY_SLEEP s, default 20, up to TEST_BISECT_SLOT_WAIT s, default 1800), then exits 75.
# A busy step (75) is retried up to TEST_BISECT_BUSY_RETRIES times (default 30, same sleep); a commit that still cannot be run is never named: INCONCLUSIVE, exit 1.
# Steps at commits before ef81c1c6 (retired 2-slot `compile` kind, no idle exit) run under main's res-slot `server` slot and stop their servers at the step's end; later commits are untouched.
# The per-step explicit compile stays: test-engine passes a compile failure on as a plain exit 1, which would score bad.
# Defaults: bad = HEAD, good = HEAD~20. Prints the first bad commit, its failing tests and the step count. TEST_EVENTS=1: @@test plan, phase, result and progress lines per step and a verdict result.
# The worktree (and its shadow servers) is removed on exit, error, INT and TERM.
# Why not JS: a thin shell wrapper around git bisect, like tools/test-engine.
set -u
repo="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
self="$repo/tools/test-bisect"
wt_sh="${TEST_BISECT_WORKTREE_SH:-$repo/tools/integration-worktree.sh}"
jesc() { sed 's/\\/\\\\/g; s/"/\\"/g; s/\t/\\t/g; s/\x1b/\\u001b/g' | awk 'BEGIN{ORS="\\n"}1' | sed 's/\\n$//'; }
emit() { [ "${TEST_EVENTS:-}" = 1 ] && printf '@@test %s\n' "$1"; return 0; }
event() { emit "{\"event\":\"phase\",\"name\":\"$(printf %s "$1" | jesc)\"}"; }
# result <name> <outcome> [message]
result() { emit "{\"event\":\"result\",\"name\":\"$(printf %s "$1" | jesc)\",\"outcome\":\"$2\",\"message\":\"$(printf %s "${3:-}" | jesc)\"}"; }

# One bisect step, run inside the worktree: BISECT_WORK holds the step counter and per-commit logs.
if [ "${1:-}" = --step ]; then
  shift
  wt="$(git rev-parse --show-toplevel)"; rev="$(git rev-parse --short HEAD)"
  n=$(( $(cat "$BISECT_WORK/steps" 2>/dev/null || echo 0) + 1 )); echo "$n" > "$BISECT_WORK/steps"
  log="$BISECT_WORK/log-$rev"
  total="${BISECT_TOTAL:-$n}"; rname="step $n $rev $(git log -1 --format=%s)"
  # A commit from before ef81c1c6 compiles under the retired 2-slot `compile` kind and never stops its servers: its compile and tests run
  # under MAIN's `server` slot (accounting and memory floor from main's res-slot), and its servers are stopped when the step ends.
  legacy=0; grep -q 'res-slot" compile --' "$wt/tools/compile" 2>/dev/null && legacy=1
  # run in the background and wait, so INT/TERM interrupts the wait at once (the trap below kills the command and stops the legacy servers)
  cmd=""
  slotted() { if [ $legacy = 1 ]; then "$repo/tools/res-slot" server -- "$@" & else "$@" & fi; cmd=$!; wait $cmd; local r=$?; cmd=""; return $r; }
  stop_legacy() { [ $legacy = 1 ] || return 0; for p in engine dashboard; do "$wt/tools/compile" $p --stop >/dev/null 2>&1; done; }
  trap '[ -n "$cmd" ] && kill "$cmd" 2>/dev/null; stop_legacy; exit 130' INT TERM
  # done: report the step's result and progress, then exit with its code
  done_step() { stop_legacy; result "$rname" "$1"; emit "{\"event\":\"progress\",\"done\":$n,\"total\":$total,\"unit\":\"steps\"}"; exit "$2"; }
  event "step $n/$total $rev: compiling"
  tries=0
  while true; do
    slotted "$wt/tools/compile" engine test > "$log" 2>&1; rc=$?
    [ $rc -eq 75 ] && [ $tries -lt "${TEST_BISECT_BUSY_RETRIES:-30}" ] || break
    tries=$((tries + 1)); sleep "${TEST_BISECT_RETRY_SLEEP:-20}"
  done
  why="$(tail -n 3 "$log" | tr '\n' ' ' | cut -c1-300)"
  [ $rc -eq 0 ] || { [ $rc -eq 75 ] && echo "step $n $rev: compile busy, skipped ($why)" || echo "step $n $rev: compile failed, skipped ($why)"; done_step skipped 125; }
  event "step $n/$total $rev: testing"
  tries=0
  while true; do
    slotted "$wt/tools/test-engine" "$@" >> "$log" 2>&1; rc=$?
    [ $rc -eq 75 ] && [ $tries -lt "${TEST_BISECT_BUSY_RETRIES:-30}" ] || break
    tries=$((tries + 1)); sleep "${TEST_BISECT_RETRY_SLEEP:-20}"
  done
  echo "$rc" > "$BISECT_WORK/rc-$rev"
  case $rc in
    0) echo "step $n $rev: good"; done_step passed 0;;
    2|124) echo "step $n $rev: skipped (exit $rc: namespace missing or timeout)"; done_step skipped 125;;
    75|137|143) echo "step $n $rev: skipped (exit $rc: busy slot or killed, not a verdict)"; done_step skipped 125;;
    1) echo "step $n $rev: bad"; echo "$rc" > "$BISECT_WORK/bad-$rev"; done_step failed 1;;
    *) echo "step $n $rev: bad (exit $rc)"; echo "$rc" > "$BISECT_WORK/bad-$rev"; done_step failed 1;;
  esac
fi

nss=(); good=""; bad=HEAD
while [ $# -gt 0 ]; do
  case "$1" in
    --good) good="${2:-}"; shift 2;;
    --bad) bad="${2:-}"; shift 2;;
    -*) echo "usage: tools/test-bisect <ns>... [--good <rev>] [--bad <rev>]" >&2; exit 2;;
    *) nss+=("$1"); shift;;
  esac
done
[ ${#nss[@]} -ge 1 ] || { echo "usage: tools/test-bisect <ns>... [--good <rev>] [--bad <rev>]" >&2; exit 2; }
[ -n "$good" ] || good="$bad~20"
bad_sha="$(git -C "$repo" rev-parse --verify -q "$bad^{commit}")" || { echo "test-bisect: unknown rev $bad" >&2; exit 2; }
good_sha="$(git -C "$repo" rev-parse --verify -q "$good^{commit}")" || { echo "test-bisect: unknown rev $good" >&2; exit 2; }

work="$(mktemp -d "${TMPDIR:-/tmp}/mc-bisect-XXXXXX")"
wt="$work/wt"; child=""
cleanup() {
  # TERM the bisect's whole group (own session): each step's trap stops its legacy servers; wait for that before the worktree goes
  # (git bisect may exit before its step scripts do, so wait for the whole group, at most 120 s)
  if [ -n "$child" ]; then
    kill -TERM -- "-$child" 2>/dev/null; wait "$child" 2>/dev/null
    for _ in $(seq 1 1200); do kill -0 -- "-$child" 2>/dev/null || break; sleep 0.1; done
  fi
  [ -d "$wt" ] && "$wt_sh" --remove "$wt" >/dev/null 2>&1
  git -C "$repo" worktree prune
  rm -rf "$work"
}
trap cleanup EXIT
trap 'exit 130' INT TERM

event "worktree"
deadline=$(( $(date +%s) + ${TEST_BISECT_SLOT_WAIT:-1800} ))
while true; do
  "$wt_sh" "$bad_sha" "$wt" >"$work/setup.log" 2>&1 && break
  rc=$?
  [ -d "$wt" ] && "$wt_sh" --remove "$wt" >/dev/null 2>&1
  git -C "$repo" worktree prune
  if [ $rc -eq 75 ]; then
    [ "$(date +%s)" -lt "$deadline" ] || { cat "$work/setup.log" >&2; echo "test-bisect: no free server slot for the worktree after ${TEST_BISECT_SLOT_WAIT:-1800} s, retry later" >&2; exit 75; }
    sleep "${TEST_BISECT_RETRY_SLEEP:-20}"
    continue
  fi
  cat "$work/setup.log" >&2; echo "test-bisect: worktree setup failed" >&2; exit 2
done
cd "$wt" || exit 2
git bisect start "$bad_sha" "$good_sha" >/dev/null || exit 2
count="$(git rev-list --count "$good_sha..$bad_sha")"; BISECT_TOTAL=1; while [ $(( 1 << (BISECT_TOTAL - 1) )) -lt "$count" ]; do BISECT_TOTAL=$((BISECT_TOTAL + 1)); done
export BISECT_TOTAL
emit "{\"event\":\"plan\",\"total\":$BISECT_TOTAL}"
echo "test-bisect: ${nss[*]} between $(git rev-parse --short "$good_sha") (good) and $(git rev-parse --short "$bad_sha") (bad)"
BISECT_WORK="$work" setsid git bisect run "$self" --step "${nss[@]}" > "$work/run.log" 2>&1 &
child=$!
tail -f "$work/run.log" --pid=$child 2>/dev/null | grep --line-buffered -E '^(step |@@test )' &
tailpid=$!
wait $child; child=""; wait $tailpid 2>/dev/null

first="$(git bisect log | sed -n 's/^# first .\{0,1\}bad.\{0,1\} commit: \[\([0-9a-f]*\)\].*/\1/p' | tail -n1)"
if [ -z "$first" ]; then
  cp "$work/run.log" "${BISECT_DEBUG:-/dev/null}"; result "INCONCLUSIVE no first bad commit" error "is the good rev really good, and the bad rev bad?"; echo "test-bisect: no first bad commit found (is the good rev really good, and the bad rev bad?)"; tail -n 8 "$work/run.log"; exit 1
fi
short="$(git rev-parse --short "$first")"
if [ ! -e "$work/bad-$short" ]; then
  git checkout -q --detach "$first" && BISECT_WORK="$work" "$self" --step "${nss[@]}" >/dev/null
  [ -e "$work/bad-$short" ] || { result "INCONCLUSIVE $short" error "no failing verdict (never tested, skipped or passing)"; echo "INCONCLUSIVE: $short has no failing verdict (never tested, skipped or passing), so it is not named"; exit 1; }
fi
echo "FIRST BAD: $(git log -1 --format='%h %s' "$first")"
echo "steps: $(cat "$work/steps" 2>/dev/null || echo 0)"
echo "failing tests at $short (test-engine exit $(cat "$work/bad-$short")):"
failing="$(grep -E '^(FAIL|ERROR) in' "$work/log-$short" | sort -u)"
printf '%s\n' "$failing" | sed 's/^/  /'
result "FIRST BAD $(git log -1 --format='%h %s' "$first")" failed "exit $(cat "$work/bad-$short")
$failing"
exit 0
